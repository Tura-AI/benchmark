{
  "schema": "tura.benchmark.runtime-config.v1",
  "repository": "https://github.com/Tura-AI/benchmark",
  "agentConfig": "config/agents.json",
  "rawRoot": "raw",
  "resultsRoot": "results",
  "defaults": {
    "agents": [],
    "concurrency": 1,
    "replicates": 1,
    "reasoning": "medium",
    "serviceTier": "default",
    "timeoutMs": 7200000
  },
  "deepSwe": {
    "concurrency": 6,
    "expectedTaskCount": 0,
    "monitorMs": 120000,
    "variants": [
      { "agent": "balanced", "replicate": 1, "reasoning": "high" },
      { "agent": "balanced", "replicate": 2, "reasoning": "high" },
      { "agent": "direct", "replicate": 1, "reasoning": "high" },
      { "agent": "direct", "replicate": 2, "reasoning": "high" },
      { "agent": "direct", "replicate": 3, "reasoning": "high" },
      { "agent": "codex-cli", "replicate": 1, "reasoning": "medium" },
      { "agent": "codex-cli", "replicate": 2, "reasoning": "medium" }
    ]
  },
  "rewriteMatrix": {
    "monitorSeconds": 60,
    "model": "gpt-5.6-sol",
    "serviceTier": "default",
    "variants": [
      {
        "agent": "balanced",
        "short": "tb",
        "replicate": 1,
        "reasoning": "high"
      },
      {
        "agent": "balanced",
        "short": "tb",
        "replicate": 2,
        "reasoning": "high"
      },
      { "agent": "direct", "short": "td", "replicate": 1, "reasoning": "high" },
      { "agent": "direct", "short": "td", "replicate": 2, "reasoning": "high" },
      {
        "agent": "codex-cli",
        "short": "cx",
        "replicate": 1,
        "reasoning": "medium"
      },
      {
        "agent": "codex-cli",
        "short": "cx",
        "replicate": 2,
        "reasoning": "medium"
      }
    ]
  }
}
