{
  "schema": "tura.benchmark.agent-cli-config.v1",
  "defaultAgents": ["pi-agent", "codex-cli", "claude-code", "opencode", "balanced"],
  "runtimeAliases": [
    { "id": "pi-agent", "profile": "pi", "aliases": ["pi", "pi-coding-agent"], "kind": "pi", "mode": "direct" },
    { "id": "codex", "profile": "codex-cli", "aliases": ["codex-current", "current"], "kind": "codex", "mode": "current" },
    { "id": "codex-main", "profile": "codex-cli", "aliases": ["main"], "kind": "codex", "mode": "main" },
    { "id": "codex-cli", "profile": "codex-cli", "aliases": [], "kind": "codex", "mode": "cli" },
    { "id": "claude-code", "profile": "claudecode", "aliases": ["claude", "claudecode", "claude-opus"], "kind": "claudecode", "mode": "cli" },
    { "id": "opencode", "profile": "opencode", "aliases": ["open-code"], "kind": "opencode", "mode": "cli" },
    { "id": "codex-documents", "profile": "codex-cli", "aliases": ["codex-docs", "codex-alt"], "kind": "codex", "mode": "documents" },
    { "id": "codex-ponytail", "profile": "codex-cli", "aliases": ["ponytail"], "kind": "codex", "mode": "ponytail" },
    { "id": "balanced", "profile": "tura", "aliases": [], "kind": "tura", "mode": "balanced" },
    { "id": "direct", "profile": "tura", "aliases": [], "kind": "tura", "mode": "direct" },
    { "id": "direct-text-only", "profile": "tura", "aliases": [], "kind": "tura", "mode": "direct-text-only" }
  ],
  "agents": [
    {
      "id": "pi",
      "aliases": ["pi-agent", "pi-coding-agent"],
      "agentName": "Pi",
      "defaultVersion": "0.80.3",
      "githubRepositoryUrl": "https://github.com/earendil-works/pi",
      "releasePageUrl": "https://github.com/earendil-works/pi/releases/tag/v0.80.3",
      "releaseDownloadUrl": "https://github.com/earendil-works/pi/releases/download/v0.80.3/pi-windows-x64.zip",
      "releaseSha256": "ca36266c726214fc351b9a6fcc5093cee8ae73c0ea4cf8ec292b8fa646d334df",
      "commandEnv": "COMMAND_RUN_AGENT_PI_EXE",
      "defaultCommand": "pi",
      "versionEnv": "COMMAND_RUN_AGENT_PI_VERSION",
      "modelEnv": "COMMAND_RUN_AGENT_PI_MODEL",
      "defaultModel": "openai/gpt-5.6-sol",
      "reasoningEnv": "COMMAND_RUN_AGENT_REASONING_EFFORT",
      "defaultReasoning": "medium",
      "defaultArgs": ["--mode", "json", "--print", "--model", "{model}", "--thinking", "{reasoning}"],
      "appendInstruction": true,
      "pluginSkillGithubUrls": []
    },
    {
      "id": "codex-cli",
      "aliases": [],
      "agentName": "Codex CLI",
      "defaultVersion": "0.144.1",
      "githubRepositoryUrl": "https://github.com/openai/codex",
      "releasePageUrl": "https://github.com/openai/codex/releases/tag/rust-v0.144.1",
      "releaseDownloadUrl": "https://github.com/openai/codex/releases/download/rust-v0.144.1/codex-x86_64-pc-windows-msvc.exe.zip",
      "releaseSha256": "976844ab2d3d77187b70a10c93f0952d6a58b2f67219734fc37785e4334b4c4a",
      "commandEnv": "COMMAND_RUN_AGENT_CODEX_EXE",
      "defaultCommand": "codex",
      "versionEnv": "COMMAND_RUN_AGENT_CODEX_VERSION",
      "modelEnv": "COMMAND_RUN_AGENT_CODEX_MODEL",
      "defaultModel": "gpt-5.6-sol",
      "reasoningEnv": "COMMAND_RUN_AGENT_REASONING_EFFORT",
      "defaultReasoning": "medium",
      "defaultArgs": [
        "exec",
        "--json",
        "--skip-git-repo-check",
        "-C",
        "{workspace}",
        "-m",
        "{model}",
        "--dangerously-bypass-approvals-and-sandbox",
        "-c",
        "model_reasoning_effort=\"{reasoning}\""
      ],
      "appendInstruction": true,
      "pluginSkillGithubUrls": []
    },
    {
      "id": "claudecode",
      "aliases": ["claude", "claude-code", "claude-opus"],
      "agentName": "Claude Code",
      "defaultVersion": "2.1.177",
      "githubRepositoryUrl": "https://github.com/anthropics/claude-code",
      "releasePageUrl": "https://github.com/anthropics/claude-code/releases/tag/v2.1.177",
      "releaseDownloadUrl": "https://github.com/anthropics/claude-code/releases/download/v2.1.177/claude-win32-x64.zip",
      "releaseSha256": "6eea73677edf0d6c7894316604c8a20466c0765daaa402aa9b3e0fb845517617",
      "commandEnv": "COMMAND_RUN_AGENT_CLAUDE_EXE",
      "defaultCommand": "claude",
      "versionEnv": "COMMAND_RUN_AGENT_CLAUDE_VERSION",
      "modelEnv": "COMMAND_RUN_AGENT_CLAUDE_MODEL",
      "defaultModel": "gpt-5.6-sol",
      "defaultArgs": [
        "--print",
        "--model",
        "{model}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "appendInstruction": true,
      "pluginSkillGithubUrls": []
    },
    {
      "id": "opencode",
      "aliases": ["open-code"],
      "agentName": "OpenCode",
      "defaultVersion": "1.17.15",
      "githubRepositoryUrl": "https://github.com/anomalyco/opencode",
      "releasePageUrl": "https://github.com/anomalyco/opencode/releases/tag/v1.17.15",
      "releaseDownloadUrl": "https://github.com/anomalyco/opencode/releases/download/v1.17.15/opencode-windows-x64.zip",
      "releaseSha256": "4853d74160d639557db1ebde9d327c38fb95b1db0886afc18d9ef962459d84e2",
      "commandEnv": "COMMAND_RUN_AGENT_OPENCODE_EXE",
      "defaultCommand": "opencode",
      "versionEnv": "COMMAND_RUN_AGENT_OPENCODE_VERSION",
      "modelEnv": "COMMAND_RUN_AGENT_OPENCODE_MODEL",
      "defaultModel": "openai/gpt-5.6-sol",
      "defaultArgs": ["run", "--model", "{model}", "--auto"],
      "appendInstruction": true,
      "pluginSkillGithubUrls": []
    },
    {
      "id": "tura",
      "aliases": [],
      "agentName": "Tura",
      "defaultVersion": "0.1.31",
      "githubRepositoryUrl": "https://github.com/Tura-AI/tura",
      "commandEnv": "COMMAND_RUN_AGENT_TURA_EXE",
      "defaultCommand": "tura",
      "versionEnv": "COMMAND_RUN_AGENT_TURA_VERSION",
      "modelEnv": "COMMAND_RUN_AGENT_TURA_MODEL",
      "defaultModel": "openai/gpt-5.6-sol",
      "reasoningEnv": "COMMAND_RUN_AGENT_REASONING_EFFORT",
      "defaultReasoning": "medium",
      "defaultArgs": [
        "exec",
        "--json",
        "--skip-git-repo-check",
        "--agent-id",
        "{turaAgentId}",
        "-m",
        "{model}",
        "--model-reasoning-effort",
        "{reasoning}",
        "--cwd",
        "{workspace}"
      ],
      "defaultEnv": {
        "OPENAI_LOGIN": "oauth",
        "TURA_COMMAND_RUN_STRICT_JSON": "0"
      },
      "defaultVariables": {
        "turaAgentId": "balanced"
      },
      "appendInstruction": true,
      "pluginSkillGithubUrls": []
    }
  ]
}
