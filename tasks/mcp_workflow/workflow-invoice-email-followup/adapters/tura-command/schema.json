{
  "name": "mcp_workspace",
  "description": "Dispatch one schema-validated tools/call request to the run-scoped mock workflow MCP server.",
  "input_schema": {
    "oneOf": [
      {
        "title": "search_threads",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "search_threads",
            "description": "Search Gmail messages using Gmail query syntax."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "pageSize": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              },
              "pageToken": {
                "type": "string",
                "minLength": 1
              },
              "query": {
                "type": "string",
                "minLength": 1
              },
              "includeTrash": {
                "type": "boolean"
              },
              "view": {
                "type": "string",
                "enum": [
                  "THREAD_VIEW_UNSPECIFIED",
                  "THREAD_VIEW_METADATA_ONLY",
                  "THREAD_VIEW_MINIMAL"
                ]
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "get_thread",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "get_thread",
            "description": "Read one Gmail message and its structured billing request."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "threadId": {
                "type": "string",
                "minLength": 1
              },
              "messageFormat": {
                "type": "string",
                "enum": [
                  "MESSAGE_FORMAT_UNSPECIFIED",
                  "MINIMAL",
                  "FULL_CONTENT",
                  "METADATA_ONLY"
                ]
              }
            },
            "required": ["threadId"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "create_invoice",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "create_invoice",
            "description": "Create a draft Stripe invoice for the customer."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "customer": {
                "type": "string",
                "minLength": 1
              },
              "days_until_due": {
                "type": "integer"
              }
            },
            "required": ["customer"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "create_invoice_item",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "create_invoice_item",
            "description": "Add the requested seat charge as an item on the draft Stripe invoice."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "customer": {
                "type": "string",
                "minLength": 1
              },
              "invoice": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "integer"
              },
              "currency": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["customer", "invoice", "amount", "currency"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "finalize_invoice",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "finalize_invoice",
            "description": "Finalize a draft Stripe invoice and produce a payment URL."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "invoice": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["invoice"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "create_draft",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "create_draft",
            "description": "Create a Gmail reply draft to an existing Gmail message in the same thread."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "to": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "bcc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "subject": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "htmlBody": {
                "type": "string"
              },
              "replyToMessageId": {
                "type": "string",
                "minLength": 1
              },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "filename": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mimeType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "content": {
                      "type": "string",
                      "minLength": 1
                    },
                    "inline": {
                      "type": "boolean"
                    }
                  },
                  "required": ["content"],
                  "additionalProperties": false
                },
                "description": "Published in the tool schema, but Gmail MCP currently documents draft attachments as unsupported."
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    ]
  }
}
