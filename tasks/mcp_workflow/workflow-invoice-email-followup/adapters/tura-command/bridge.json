{
  "schema": "tura.benchmark.tura-command-mcp-bridge.v1",
  "taskId": "workflow-invoice-email-followup",
  "commandId": "mcp_workspace",
  "runtimeBinary": "tura-command-mcp-stdio-bridge",
  "runtimeSource": "tools/tura-command-mcp-stdio-bridge",
  "buildCommand": "npm run mcp:tura-bridge:build",
  "connectionLifecycle": {
    "scope": "benchmark-attempt",
    "broker": "lib/mcp_stdio_broker.mjs",
    "lazyInitialize": true,
    "authentication": "ephemeral-random-token"
  },
  "externalProtocol": {
    "invocation": ["${runtimeBinary}", "--protocol"],
    "request": {
      "kind": "execute",
      "argumentsPath": "payload.arguments",
      "workspacePath": "payload.session_dir",
      "callIdPath": "payload.call_id"
    },
    "response": {
      "required": ["ok", "success", "output", "stderr", "exit_code"]
    }
  },
  "mcpServer": {
    "name": "tura_mock_workflow_invoice_email_followup",
    "transport": "stdio",
    "command": "${python}",
    "args": [
      "${taskDir}/mcp_server.py",
      "--workspace",
      "${workspace}",
      "--trace",
      "${tracePath}",
      "--scenario",
      "${scenarioPath}",
      "--state",
      "${statePath}"
    ],
    "schemaDiscovery": "tools/list",
    "tools": [
      "search_threads",
      "get_thread",
      "create_invoice",
      "create_invoice_item",
      "finalize_invoice",
      "create_draft"
    ],
    "contracts": [
      {
        "tool": "search_threads",
        "provider": "gmail",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/gmail/api/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "get_thread",
        "provider": "gmail",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/gmail/api/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "create_invoice",
        "provider": "stripe",
        "fidelity": "official-mcp",
        "source": "https://docs.stripe.com/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "create_invoice_item",
        "provider": "stripe",
        "fidelity": "official-mcp",
        "source": "https://docs.stripe.com/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "finalize_invoice",
        "provider": "stripe",
        "fidelity": "official-mcp",
        "source": "https://docs.stripe.com/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "create_draft",
        "provider": "gmail",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/gmail/api/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      }
    ]
  },
  "mapping": {
    "payload.arguments.name": "tools/call.params.name",
    "payload.arguments.arguments": "tools/call.params.arguments",
    "payload.session_dir": "server.args.${workspace}"
  },
  "requiredHandshake": [
    "initialize",
    "notifications/initialized",
    "tools/list",
    "tools/call"
  ]
}
