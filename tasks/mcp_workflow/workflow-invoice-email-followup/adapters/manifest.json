{
  "schema": "tura.benchmark.mcp-agent-adapters.v1",
  "taskId": "workflow-invoice-email-followup",
  "server": {
    "name": "tura_mock_workflow_invoice_email_followup",
    "transport": "stdio",
    "command": "${python}",
    "args": [
      "${taskDir}/mcp_server.py",
      "--workspace",
      "${workspace}",
      "--trace",
      "${tracePath}",
      "--scenario",
      "${scenarioPath}",
      "--state",
      "${statePath}"
    ],
    "schemaDiscovery": "tools/list",
    "tools": [
      "search_threads",
      "get_thread",
      "create_invoice",
      "create_invoice_item",
      "finalize_invoice",
      "create_draft"
    ],
    "contracts": [
      {
        "tool": "search_threads",
        "provider": "gmail",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/gmail/api/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "get_thread",
        "provider": "gmail",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/gmail/api/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "create_invoice",
        "provider": "stripe",
        "fidelity": "official-mcp",
        "source": "https://docs.stripe.com/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "create_invoice_item",
        "provider": "stripe",
        "fidelity": "official-mcp",
        "source": "https://docs.stripe.com/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "finalize_invoice",
        "provider": "stripe",
        "fidelity": "official-mcp",
        "source": "https://docs.stripe.com/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "create_draft",
        "provider": "gmail",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/gmail/api/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      }
    ]
  },
  "adapters": {
    "codex": {
      "format": "codex.mcp-stdio.toml.v1",
      "configTemplate": "adapters/codex/config.toml",
      "settings": {
        "required": true,
        "defaultToolsApprovalMode": "approve",
        "startupTimeoutSec": 30,
        "toolTimeoutSec": 120
      }
    },
    "turaCommand": {
      "format": "tura.external-command.v1",
      "commandId": "mcp_workspace",
      "packageDirectory": "adapters/tura-command",
      "bridgeDescriptor": "adapters/tura-command/bridge.json",
      "agentCapability": {
        "capability_name": "mcp_workspace"
      }
    }
  }
}
