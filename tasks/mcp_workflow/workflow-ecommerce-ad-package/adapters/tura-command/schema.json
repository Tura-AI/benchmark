{
  "name": "mcp_workspace",
  "description": "Dispatch one schema-validated tools/call request to the run-scoped mock workflow MCP server.",
  "input_schema": {
    "oneOf": [
      {
        "title": "search_files",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "search_files",
            "description": "Find all media assets for an ecommerce ad."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "description": "Google Drive MCP query syntax, for example: title contains 'brief'"
              },
              "pageToken": {
                "type": "string",
                "minLength": 1
              },
              "pageSize": {
                "type": "integer",
                "minimum": 1
              },
              "excludeContentSnippets": {
                "type": "boolean"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "premiere_create_project",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "premiere_create_project",
            "description": "Create the Premiere ad project."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "premiere_import_media_batch",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "premiere_import_media_batch",
            "description": "Import multiple media assets into Premiere."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "asset_uris": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?:(?:drive|artifact)://[^/].*|https://.+)$",
                  "description": "Asset URI. Use drive://<file-id> for benchmark Drive state, artifact://<path> for local generated artifacts, or the exact HTTPS download URL returned by an official MCP export tool."
                }
              }
            },
            "required": ["project_id", "asset_uris"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "premiere_trim_clip",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "premiere_trim_clip",
            "description": "Trim the ad video to a precise duration."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "clip_id": {
                "type": "string",
                "minLength": 1
              },
              "start_seconds": {
                "type": "number"
              },
              "end_seconds": {
                "type": "number"
              }
            },
            "required": [
              "project_id",
              "clip_id",
              "start_seconds",
              "end_seconds"
            ],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "premiere_add_audio",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "premiere_add_audio",
            "description": "Add an audio clip to a Premiere sequence at a specified gain."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "audio_clip_id": {
                "type": "string",
                "minLength": 1
              },
              "gain_db": {
                "type": "number"
              }
            },
            "required": ["project_id", "audio_clip_id", "gain_db"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "premiere_export_video",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "premiere_export_video",
            "description": "Export the finished ad video."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "output_path": {
                "type": "string",
                "minLength": 1
              },
              "codec": {
                "type": "string",
                "enum": ["h264"]
              },
              "resolution": {
                "type": "string",
                "enum": ["1080p"]
              }
            },
            "required": ["project_id", "output_path", "codec", "resolution"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "photoshop_create_thumbnail",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "photoshop_create_thumbnail",
            "description": "Create a sized thumbnail with a text layer from a source image."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "asset_uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:(?:drive|artifact)://[^/].*|https://.+)$",
                "description": "Asset URI. Use drive://<file-id> for benchmark Drive state, artifact://<path> for local generated artifacts, or the exact HTTPS download URL returned by an official MCP export tool."
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["asset_uri", "width", "height", "text"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "photoshop_export_image",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "photoshop_export_image",
            "description": "Export the ad thumbnail from Photoshop."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "output_path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "type": "string",
                "enum": ["png"]
              }
            },
            "required": ["document_id", "output_path", "format"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "send_message",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "send_message",
            "description": "Post a Slack message containing generated artifact URLs."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "channel_id": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["channel_id", "message"],
            "additionalProperties": false
          }
        }
      }
    ]
  }
}
