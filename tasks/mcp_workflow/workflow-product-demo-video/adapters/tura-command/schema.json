{
  "name": "mcp_workspace",
  "description": "Dispatch one schema-validated tools/call request to the run-scoped mock workflow MCP server.",
  "input_schema": {
    "oneOf": [
      {
        "title": "search_files",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "search_files",
            "description": "Search Google Drive for media assets."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "description": "Google Drive MCP query syntax, for example: title contains 'brief'"
              },
              "pageToken": {
                "type": "string",
                "minLength": 1
              },
              "pageSize": {
                "type": "integer",
                "minimum": 1
              },
              "excludeContentSnippets": {
                "type": "boolean"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "premiere_create_project",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "premiere_create_project",
            "description": "Create a mock Adobe Premiere Pro editing project."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "premiere_import_media",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "premiere_import_media",
            "description": "Import a Drive video into a Premiere project."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "asset_uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:(?:drive|artifact)://[^/].*|https://.+)$",
                "description": "Asset URI. Use drive://<file-id> for benchmark Drive state, artifact://<path> for local generated artifacts, or the exact HTTPS download URL returned by an official MCP export tool."
              }
            },
            "required": ["project_id", "asset_uri"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "premiere_trim_clip",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "premiere_trim_clip",
            "description": "Trim a Premiere clip to exact time boundaries."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "clip_id": {
                "type": "string",
                "minLength": 1
              },
              "start_seconds": {
                "type": "number"
              },
              "end_seconds": {
                "type": "number"
              }
            },
            "required": [
              "project_id",
              "clip_id",
              "start_seconds",
              "end_seconds"
            ],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "premiere_add_caption",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "premiere_add_caption",
            "description": "Add a caption overlay to a Premiere sequence."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["project_id", "text"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "premiere_export_video",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "premiere_export_video",
            "description": "Export a Premiere project to a video artifact."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "output_path": {
                "type": "string",
                "minLength": 1
              },
              "codec": {
                "type": "string",
                "enum": ["h264"]
              },
              "resolution": {
                "type": "string",
                "enum": ["1080p"]
              }
            },
            "required": ["project_id", "output_path", "codec", "resolution"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "create_draft",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "create_draft",
            "description": "Create a Gmail draft that references the generated artifacts by URL; Gmail MCP draft attachments are currently unsupported."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "to": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "bcc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "subject": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "htmlBody": {
                "type": "string"
              },
              "replyToMessageId": {
                "type": "string",
                "minLength": 1
              },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "filename": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mimeType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "content": {
                      "type": "string",
                      "minLength": 1
                    },
                    "inline": {
                      "type": "boolean"
                    }
                  },
                  "required": ["content"],
                  "additionalProperties": false
                },
                "description": "Published in the tool schema, but Gmail MCP currently documents draft attachments as unsupported."
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    ]
  }
}
