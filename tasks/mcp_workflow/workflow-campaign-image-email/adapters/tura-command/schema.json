{
  "name": "mcp_workspace",
  "description": "Dispatch one schema-validated tools/call request to the run-scoped mock workflow MCP server.",
  "input_schema": {
    "oneOf": [
      {
        "title": "search_files",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "search_files",
            "description": "Search the mock Google Drive for campaign assets."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "description": "Google Drive MCP query syntax, for example: title contains 'brief'"
              },
              "pageToken": {
                "type": "string",
                "minLength": 1
              },
              "pageSize": {
                "type": "integer",
                "minimum": 1
              },
              "excludeContentSnippets": {
                "type": "boolean"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "download_file_content",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "download_file_content",
            "description": "Download one Drive file and return its mock contents."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "fileId": {
                "type": "string",
                "minLength": 1
              },
              "exportMimeType": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["fileId"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "photoshop_open_document",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "photoshop_open_document",
            "description": "Open a Drive asset as a Photoshop document."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "asset_uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:(?:drive|artifact)://[^/].*|https://.+)$",
                "description": "Asset URI. Use drive://<file-id> for benchmark Drive state, artifact://<path> for local generated artifacts, or the exact HTTPS download URL returned by an official MCP export tool."
              }
            },
            "required": ["asset_uri"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "photoshop_remove_background",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "photoshop_remove_background",
            "description": "Remove the background from the active Photoshop document."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["document_id"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "photoshop_add_text_layer",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "photoshop_add_text_layer",
            "description": "Add a positioned text layer to a Photoshop document."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["document_id", "text", "position"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "photoshop_export_image",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "photoshop_export_image",
            "description": "Export a Photoshop document as an image artifact."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "output_path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "type": "string",
                "enum": ["png"]
              }
            },
            "required": ["document_id", "output_path", "format"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "create_draft",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "create_draft",
            "description": "Create a Gmail draft that references the generated artifacts by URL; Gmail MCP draft attachments are currently unsupported."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "to": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "bcc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "subject": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "htmlBody": {
                "type": "string"
              },
              "replyToMessageId": {
                "type": "string",
                "minLength": 1
              },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "filename": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mimeType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "content": {
                      "type": "string",
                      "minLength": 1
                    },
                    "inline": {
                      "type": "boolean"
                    }
                  },
                  "required": ["content"],
                  "additionalProperties": false
                },
                "description": "Published in the tool schema, but Gmail MCP currently documents draft attachments as unsupported."
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    ]
  }
}
