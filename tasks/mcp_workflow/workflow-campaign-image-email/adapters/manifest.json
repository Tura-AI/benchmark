{
  "schema": "tura.benchmark.mcp-agent-adapters.v1",
  "taskId": "workflow-campaign-image-email",
  "server": {
    "name": "tura_mock_workflow_campaign_image_email",
    "transport": "stdio",
    "command": "${python}",
    "args": [
      "${taskDir}/mcp_server.py",
      "--workspace",
      "${workspace}",
      "--trace",
      "${tracePath}",
      "--scenario",
      "${scenarioPath}",
      "--state",
      "${statePath}"
    ],
    "schemaDiscovery": "tools/list",
    "tools": [
      "search_files",
      "download_file_content",
      "photoshop_open_document",
      "photoshop_remove_background",
      "photoshop_add_text_layer",
      "photoshop_export_image",
      "create_draft"
    ],
    "contracts": [
      {
        "tool": "search_files",
        "provider": "drive",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/drive/api/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "download_file_content",
        "provider": "drive",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/drive/api/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "photoshop_open_document",
        "provider": "photoshop",
        "fidelity": "vendor-api-adapter",
        "source": "https://developer.adobe.com/photoshop/",
        "revision": "2026-08-09",
        "transport": "stdio-mock",
        "authentication": "mock-run-scope",
        "responseMode": "structured-json"
      },
      {
        "tool": "photoshop_remove_background",
        "provider": "photoshop",
        "fidelity": "vendor-api-adapter",
        "source": "https://developer.adobe.com/photoshop/",
        "revision": "2026-08-09",
        "transport": "stdio-mock",
        "authentication": "mock-run-scope",
        "responseMode": "structured-json"
      },
      {
        "tool": "photoshop_add_text_layer",
        "provider": "photoshop",
        "fidelity": "vendor-api-adapter",
        "source": "https://developer.adobe.com/photoshop/",
        "revision": "2026-08-09",
        "transport": "stdio-mock",
        "authentication": "mock-run-scope",
        "responseMode": "structured-json"
      },
      {
        "tool": "photoshop_export_image",
        "provider": "photoshop",
        "fidelity": "vendor-api-adapter",
        "source": "https://developer.adobe.com/photoshop/",
        "revision": "2026-08-09",
        "transport": "stdio-mock",
        "authentication": "mock-run-scope",
        "responseMode": "structured-json"
      },
      {
        "tool": "create_draft",
        "provider": "gmail",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/gmail/api/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      }
    ]
  },
  "adapters": {
    "codex": {
      "format": "codex.mcp-stdio.toml.v1",
      "configTemplate": "adapters/codex/config.toml",
      "settings": {
        "required": true,
        "defaultToolsApprovalMode": "approve",
        "startupTimeoutSec": 30,
        "toolTimeoutSec": 120
      }
    },
    "turaCommand": {
      "format": "tura.external-command.v1",
      "commandId": "mcp_workspace",
      "packageDirectory": "adapters/tura-command",
      "bridgeDescriptor": "adapters/tura-command/bridge.json",
      "agentCapability": {
        "capability_name": "mcp_workspace"
      }
    }
  }
}
