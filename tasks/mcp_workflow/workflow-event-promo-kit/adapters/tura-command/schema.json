{
  "name": "mcp_workspace",
  "description": "Dispatch one schema-validated tools/call request to the run-scoped mock workflow MCP server.",
  "input_schema": {
    "oneOf": [
      {
        "title": "get_event",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "get_event",
            "description": "Read a Google Calendar event by ID."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "eventId": {
                "type": "string",
                "minLength": 1
              },
              "calendarId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["eventId"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "generate-design",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "generate-design",
            "description": "Generate Canva design candidates from the requested brief."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1
              },
              "design_type": {
                "type": "string",
                "minLength": 1
              },
              "asset_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["query"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "create-design-from-candidate",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "create-design-from-candidate",
            "description": "Create an editable Canva design from the selected generated candidate."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "job_id": {
                "type": "string",
                "minLength": 1
              },
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["job_id", "candidate_id"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "export-design",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "export-design",
            "description": "Export a Canva design to an artifact."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "type": "string",
                "enum": ["png", "jpg", "pdf", "pptx", "mp4", "gif"]
              },
              "quality": {
                "type": "string",
                "minLength": 1
              },
              "size": {
                "type": "number"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "lossless": {
                "type": "boolean"
              }
            },
            "required": ["id", "format"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "photoshop_open_document",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "photoshop_open_document",
            "description": "Open the Canva export in Photoshop."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "asset_uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:(?:drive|artifact)://[^/].*|https://.+)$",
                "description": "Asset URI. Use drive://<file-id> for benchmark Drive state, artifact://<path> for local generated artifacts, or the exact HTTPS download URL returned by an official MCP export tool."
              }
            },
            "required": ["asset_uri"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "photoshop_resize_image",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "photoshop_resize_image",
            "description": "Resize a Photoshop image to exact pixel dimensions."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              }
            },
            "required": ["document_id", "width", "height"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "photoshop_export_image",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "photoshop_export_image",
            "description": "Export the resized Photoshop image."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "output_path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "type": "string",
                "enum": ["png"]
              }
            },
            "required": ["document_id", "output_path", "format"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "create_draft",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "create_draft",
            "description": "Create a Gmail draft that references the generated artifacts by URL; Gmail MCP draft attachments are currently unsupported."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "to": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "bcc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "subject": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "htmlBody": {
                "type": "string"
              },
              "replyToMessageId": {
                "type": "string",
                "minLength": 1
              },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "filename": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mimeType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "content": {
                      "type": "string",
                      "minLength": 1
                    },
                    "inline": {
                      "type": "boolean"
                    }
                  },
                  "required": ["content"],
                  "additionalProperties": false
                },
                "description": "Published in the tool schema, but Gmail MCP currently documents draft attachments as unsupported."
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    ]
  }
}
