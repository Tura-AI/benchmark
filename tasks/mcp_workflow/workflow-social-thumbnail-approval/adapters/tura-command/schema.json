{
  "name": "mcp_workspace",
  "description": "Dispatch one schema-validated tools/call request to the run-scoped mock workflow MCP server.",
  "input_schema": {
    "oneOf": [
      {
        "title": "get_metadata",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "get_metadata",
            "description": "Read Figma file metadata and available frames."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "fileKey": {
                "type": "string",
                "minLength": 1
              },
              "nodeId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["fileKey"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "download_assets",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "download_assets",
            "description": "Export a Figma frame as a raster artifact."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "fileKey": {
                "type": "string",
                "minLength": 1
              },
              "nodeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "defaultFormat": {
                "type": "string",
                "enum": ["PNG", "JPG", "SVG", "PDF"]
              },
              "defaultScale": {
                "type": "number"
              }
            },
            "required": ["fileKey", "nodeIds"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "photoshop_open_document",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "photoshop_open_document",
            "description": "Open an exported design in Photoshop."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "asset_uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:(?:drive|artifact)://[^/].*|https://.+)$",
                "description": "Asset URI. Use drive://<file-id> for benchmark Drive state, artifact://<path> for local generated artifacts, or the exact HTTPS download URL returned by an official MCP export tool."
              }
            },
            "required": ["asset_uri"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "photoshop_apply_adjustment",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "photoshop_apply_adjustment",
            "description": "Apply numeric brightness and contrast adjustments."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "brightness": {
                "type": "number"
              },
              "contrast": {
                "type": "number"
              }
            },
            "required": ["document_id", "brightness", "contrast"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "photoshop_export_image",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "photoshop_export_image",
            "description": "Export the adjusted Photoshop image."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "output_path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "type": "string",
                "enum": ["png"]
              }
            },
            "required": ["document_id", "output_path", "format"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "send_message",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "send_message",
            "description": "Post a Slack message containing generated artifact URLs."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "channel_id": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["channel_id", "message"],
            "additionalProperties": false
          }
        }
      }
    ]
  }
}
