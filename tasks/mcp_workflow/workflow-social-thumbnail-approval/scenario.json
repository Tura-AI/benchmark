              "type": "object",
              "properties": {
                "nodeId": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "format": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["nodeId", "url", "format"],
              "additionalProperties": true
            }
          },
          "rawImagesTruncated": {
            "type": "boolean"
          }
        },
        "required": ["assets"],
        "additionalProperties": true
