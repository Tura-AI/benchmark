      "intent": "figma_get_file",
      "tool": "get_metadata",
      "description": "Read Figma file metadata and available frames.",
      "expectedArguments": {
        "fileKey": "figma-checkout-v2"
      },
      "argumentAssertions": [
        {
          "path": "fileKey",
          "operator": "normalized-equals"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "fileKey": {
            "type": "string",
            "minLength": 1
          },
          "nodeId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["fileKey"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "fileKey": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "string",
            "minLength": 1
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
