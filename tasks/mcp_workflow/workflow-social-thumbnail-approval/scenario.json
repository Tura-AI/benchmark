      "contract": {
        "provider": "figma",
        "fidelity": "official-mcp",
        "source": "https://developers.figma.com/docs/figma-mcp-server/tools-and-prompts/",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      "argumentNormalization": {},
      "result": {
        "fileKey": "figma-checkout-v2",
        "name": "Checkout v2",
        "metadata": "<frame id=\"hero-social\" width=\"1200\" height=\"630\"/>",
        "nodes": [
          {
            "id": "hero-social",
            "width": 1200,
            "height": 630
          }
        ]
      },
      "effects": {},
      "stepId": "step-01",
      "requires": []
