        "revision": "2026-08-09",
        "transport": "stdio-mock",
        "authentication": "mock-run-scope",
        "responseMode": "structured-json"
      },
      "argumentNormalization": {},
      "result": {
        "document_id": "psdoc-003",
        "adjusted": true
