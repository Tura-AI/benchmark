        "asset_uri": "https://mock.invalid/checkout-hero-source.png"
      },
      "argumentAssertions": [
        {
          "path": "asset_uri",
          "operator": "normalized-equals"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "asset_uri": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:(?:drive|artifact)://[^/].*|https://.+)$",
            "description": "Asset URI. Use drive://<file-id> for benchmark Drive state, artifact://<path> for local generated artifacts, or the exact HTTPS download URL returned by an official MCP export tool."
          }
        },
        "required": ["asset_uri"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "document_id": {
