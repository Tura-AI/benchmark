    {
      "intent": "figma_export_frame",
      "tool": "download_assets",
      "description": "Export a Figma frame as a raster artifact.",
      "expectedArguments": {
        "fileKey": "figma-checkout-v2",
        "nodeIds": ["hero-social"],
        "defaultFormat": "PNG",
        "defaultScale": 2
      },
      "argumentAssertions": [
        {
          "path": "fileKey",
          "operator": "normalized-equals"
        },
        {
          "path": "nodeIds",
          "operator": "normalized-equals"
        },
        {
          "path": "defaultFormat",
          "operator": "normalized-equals"
        },
        {
          "path": "defaultScale",
          "operator": "normalized-equals"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "fileKey": {
            "type": "string",
            "minLength": 1
          },
          "nodeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "defaultFormat": {
            "type": "string",
            "enum": ["PNG", "JPG", "SVG", "PDF"]
