{
  "name": "mcp_workspace",
  "description": "Dispatch one schema-validated tools/call request to the run-scoped mock workflow MCP server.",
  "input_schema": {
    "oneOf": [
      {
        "title": "search_files",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "search_files",
            "description": "Find a contract in Google Drive."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "description": "Google Drive MCP query syntax, for example: title contains 'brief'"
              },
              "pageToken": {
                "type": "string",
                "minLength": 1
              },
              "pageSize": {
                "type": "integer",
                "minimum": 1
              },
              "excludeContentSnippets": {
                "type": "boolean"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "download_file_content",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "download_file_content",
            "description": "Download the selected Drive contract."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "fileId": {
                "type": "string",
                "minLength": 1
              },
              "exportMimeType": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["fileId"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "acrobat_open_document",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "acrobat_open_document",
            "description": "Open a PDF in Adobe Acrobat."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "asset_uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:(?:drive|artifact)://[^/].*|https://.+)$",
                "description": "Asset URI. Use drive://<file-id> for benchmark Drive state, artifact://<path> for local generated artifacts, or the exact HTTPS download URL returned by an official MCP export tool."
              }
            },
            "required": ["asset_uri"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "acrobat_add_signature_field",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "acrobat_add_signature_field",
            "description": "Add a required signature field to a PDF page."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "field_name": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "document_id",
              "field_name",
              "page",
              "x",
              "y",
              "width",
              "height",
              "required"
            ],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "acrobat_export_pdf",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "acrobat_export_pdf",
            "description": "Export the prepared Acrobat PDF."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "output_path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["document_id", "output_path"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "create_draft",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "create_draft",
            "description": "Create a Gmail draft that references the generated artifacts by URL; Gmail MCP draft attachments are currently unsupported."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "to": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "bcc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "subject": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "htmlBody": {
                "type": "string"
              },
              "replyToMessageId": {
                "type": "string",
                "minLength": 1
              },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "filename": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mimeType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "content": {
                      "type": "string",
                      "minLength": 1
                    },
                    "inline": {
                      "type": "boolean"
                    }
                  },
                  "required": ["content"],
                  "additionalProperties": false
                },
                "description": "Published in the tool schema, but Gmail MCP currently documents draft attachments as unsupported."
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "create_event",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "create_event",
            "description": "Create a signature follow-up Calendar event."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "startTime": {
                "type": "string",
                "minLength": 1
              },
              "endTime": {
                "type": "string",
                "minLength": 1
              },
              "attendees": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "email": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["email"],
                  "additionalProperties": true
                }
              },
              "calendarId": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "timeZone": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["summary", "startTime", "endTime"],
            "additionalProperties": false
          }
        }
      }
    ]
  }
}
