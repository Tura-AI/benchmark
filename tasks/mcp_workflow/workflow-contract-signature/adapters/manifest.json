{
  "schema": "tura.benchmark.mcp-agent-adapters.v1",
  "taskId": "workflow-contract-signature",
  "server": {
    "name": "tura_mock_workflow_contract_signature",
    "transport": "stdio",
    "command": "${python}",
    "args": [
      "${taskDir}/mcp_server.py",
      "--workspace",
      "${workspace}",
      "--trace",
      "${tracePath}",
      "--scenario",
      "${scenarioPath}",
      "--state",
      "${statePath}"
    ],
    "schemaDiscovery": "tools/list",
    "tools": [
      "search_files",
      "download_file_content",
      "acrobat_open_document",
      "acrobat_add_signature_field",
      "acrobat_export_pdf",
      "create_draft",
      "create_event"
    ],
    "contracts": [
      {
        "tool": "search_files",
        "provider": "drive",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/drive/api/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "download_file_content",
        "provider": "drive",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/drive/api/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "acrobat_open_document",
        "provider": "acrobat",
        "fidelity": "vendor-api-adapter",
        "source": "https://developer.adobe.com/document-services/apis/pdf-services/",
        "revision": "2026-08-09",
        "transport": "stdio-mock",
        "authentication": "mock-run-scope",
        "responseMode": "structured-json"
      },
      {
        "tool": "acrobat_add_signature_field",
        "provider": "acrobat",
        "fidelity": "vendor-api-adapter",
        "source": "https://developer.adobe.com/document-services/apis/pdf-services/",
        "revision": "2026-08-09",
        "transport": "stdio-mock",
        "authentication": "mock-run-scope",
        "responseMode": "structured-json"
      },
      {
        "tool": "acrobat_export_pdf",
        "provider": "acrobat",
        "fidelity": "vendor-api-adapter",
        "source": "https://developer.adobe.com/document-services/apis/pdf-services/",
        "revision": "2026-08-09",
        "transport": "stdio-mock",
        "authentication": "mock-run-scope",
        "responseMode": "structured-json"
      },
      {
        "tool": "create_draft",
        "provider": "gmail",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/gmail/api/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      {
        "tool": "create_event",
        "provider": "calendar",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/calendar/api/v3/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      }
    ]
  },
  "adapters": {
    "codex": {
      "format": "codex.mcp-stdio.toml.v1",
      "configTemplate": "adapters/codex/config.toml",
      "settings": {
        "required": true,
        "defaultToolsApprovalMode": "approve",
        "startupTimeoutSec": 30,
        "toolTimeoutSec": 120
      }
    },
    "turaCommand": {
      "format": "tura.external-command.v1",
      "commandId": "mcp_workspace",
      "packageDirectory": "adapters/tura-command",
      "bridgeDescriptor": "adapters/tura-command/bridge.json",
      "agentCapability": {
        "capability_name": "mcp_workspace"
      }
    }
  }
}
