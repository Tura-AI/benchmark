{
  "name": "mcp_workspace",
  "description": "Dispatch one schema-validated tools/call request to the run-scoped mock workflow MCP server.",
  "input_schema": {
    "oneOf": [
      {
        "title": "search_files",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "search_files",
            "description": "Search Drive for candidate materials."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "description": "Google Drive MCP query syntax, for example: title contains 'brief'"
              },
              "pageToken": {
                "type": "string",
                "minLength": 1
              },
              "pageSize": {
                "type": "integer",
                "minimum": 1
              },
              "excludeContentSnippets": {
                "type": "boolean"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "download_file_content",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "download_file_content",
            "description": "Download the headshot with the official single-file Drive MCP tool."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "fileId": {
                "type": "string",
                "minLength": 1
              },
              "exportMimeType": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["fileId"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "photoshop_crop_image",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "photoshop_crop_image",
            "description": "Crop an image to exact dimensions and export the result."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "asset_uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:(?:drive|artifact)://[^/].*|https://.+)$",
                "description": "Asset URI. Use drive://<file-id> for benchmark Drive state, artifact://<path> for local generated artifacts, or the exact HTTPS download URL returned by an official MCP export tool."
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              },
              "output_path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "asset_uri",
              "width",
              "height",
              "anchor",
              "output_path"
            ],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "create_file",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "create_file",
            "description": "Create a Google Docs document with supplied text."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "mimeType": {
                "type": "string",
                "minLength": 1
              },
              "contentMimeType": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "base64Content": {
                "type": "string",
                "minLength": 1
              },
              "textContent": {
                "type": "string",
                "minLength": 1
              },
              "parentId": {
                "type": "string",
                "minLength": 1
              },
              "disableConversionToGoogleType": {
                "type": "boolean"
              }
            },
            "required": ["title"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "create_event",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "create_event",
            "description": "Create a Google Calendar event with attendees."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "startTime": {
                "type": "string",
                "minLength": 1
              },
              "endTime": {
                "type": "string",
                "minLength": 1
              },
              "attendees": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "email": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["email"],
                  "additionalProperties": true
                }
              },
              "calendarId": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "timeZone": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["summary", "startTime", "endTime"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "create_draft",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "create_draft",
            "description": "Create a Gmail draft that references the generated artifacts by URL; Gmail MCP draft attachments are currently unsupported."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "to": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "bcc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "subject": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "htmlBody": {
                "type": "string"
              },
              "replyToMessageId": {
                "type": "string",
                "minLength": 1
              },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "filename": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mimeType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "content": {
                      "type": "string",
                      "minLength": 1
                    },
                    "inline": {
                      "type": "boolean"
                    }
                  },
                  "required": ["content"],
                  "additionalProperties": false
                },
                "description": "Published in the tool schema, but Gmail MCP currently documents draft attachments as unsupported."
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    ]
  }
}
