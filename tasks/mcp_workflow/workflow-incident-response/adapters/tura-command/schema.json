{
  "name": "mcp_workspace",
  "description": "Dispatch one schema-validated tools/call request to the run-scoped mock workflow MCP server.",
  "input_schema": {
    "oneOf": [
      {
        "title": "get_issue_details",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "get_issue_details",
            "description": "Read a Sentry issue with the official issue-details tool."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "organizationSlug": {
                "type": "string",
                "minLength": 1,
                "description": "The organization's slug."
              },
              "regionUrl": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "issueId": {
                "type": "string",
                "minLength": 1,
                "description": "The Sentry issue short ID, for example PROJECT-123."
              },
              "eventId": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9a-fA-F]{32}$"
              },
              "issueUrl": {
                "type": "string",
                "minLength": 1,
                "format": "uri"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "issue_write",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "issue_write",
            "description": "Create a GitHub issue in a repository."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": ["create"]
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "repo": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["method", "owner", "repo", "title"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "send_message",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "send_message",
            "description": "Post an incident update to Slack."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "channel_id": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["channel_id", "message"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "create_draft",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "create_draft",
            "description": "Create a Gmail draft for the incident stakeholder notification through Gmail."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "to": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "bcc": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "subject": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "htmlBody": {
                "type": "string"
              },
              "replyToMessageId": {
                "type": "string",
                "minLength": 1
              },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "filename": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mimeType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "content": {
                      "type": "string",
                      "minLength": 1
                    },
                    "inline": {
                      "type": "boolean"
                    }
                  },
                  "required": ["content"],
                  "additionalProperties": false
                },
                "description": "Published in the tool schema, but Gmail MCP currently documents draft attachments as unsupported."
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    ]
  }
}
