{
  "schema": "tura.benchmark.mcp-workflow-scenario.v2",
  "id": "workflow-incident-response",
  "serverName": "tura_mock_workflow_incident_response",
  "services": ["Sentry", "GitHub", "Slack", "Gmail"],
  "evaluation": {
    "mode": "deterministic-script",
    "llmJudge": false,
    "humanReview": false,
    "checks": [
      "critical-argument-assertions",
      "dependency-order",
      "recovered-tool-errors-allowed",
      "exact-final-state"
    ]
  },
  "initialState": {
    "sentry": {
      "issues": ["SENTRY-PAY-500"]
    },
    "github": {},
    "slack": {},
    "gmail": {}
  },
  "steps": [
    {
      "intent": "sentry_get_issue",
      "tool": "get_issue_details",
      "description": "Read a Sentry issue with the official issue-details tool.",
      "expectedArguments": {
        "organizationSlug": "acme",
        "issueId": "SENTRY-PAY-500"
      },
      "argumentAssertions": [
        {
          "path": "organizationSlug",
          "operator": "normalized-equals"
        },
        {
          "path": "issueId",
          "operator": "normalized-equals"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "description": "The organization's slug."
          },
          "regionUrl": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "issueId": {
            "type": "string",
            "minLength": 1,
            "description": "The Sentry issue short ID, for example PROJECT-123."
          },
          "eventId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-fA-F]{32}$"
          },
          "issueUrl": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": null,
      "responseMode": "text-only",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": true
      },
      "contract": {
        "provider": "sentry",
        "fidelity": "official-mcp",
        "source": "https://github.com/getsentry/sentry-mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "text-only"
      },
      "argumentNormalization": {},
      "result": "# Checkout 500 errors\n\nIssue: SENTRY-PAY-500\nEvents: 37\nDeploy: 8f21c\nSeverity: fatal",
      "effects": {},
      "stepId": "step-01",
      "requires": []
    },
    {
      "intent": "github_create_issue",
      "tool": "issue_write",
      "description": "Create a GitHub issue in a repository.",
      "expectedArguments": {
        "method": "create",
        "owner": "tura",
        "repo": "payments",
        "title": "[P1] Checkout 500 errors",
        "body": "Sentry SENTRY-PAY-500 reports 37 checkout failures after deploy 8f21c.",
        "labels": ["incident", "P1"]
      },
      "argumentAssertions": [
        {
          "path": "method",
          "operator": "normalized-equals"
        },
        {
          "path": "owner",
          "operator": "normalized-equals"
        },
        {
          "path": "repo",
          "operator": "normalized-equals"
        },
        {
          "path": "title",
          "operator": "normalized-equals"
        },
        {
          "path": "body",
          "operator": "normalized-equals"
        },
        {
          "path": "labels",
          "operator": "normalized-equals"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": ["create"]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["method", "owner", "repo", "title"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer"
          },
          "html_url": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["number", "html_url", "state"],
        "additionalProperties": true
      },
      "responseMode": "structured-json",
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "contract": {
        "provider": "github",
        "fidelity": "official-mcp",
        "source": "https://github.com/github/github-mcp-server",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      "argumentNormalization": {},
      "result": {
        "number": 418,
        "html_url": "https://github.example/tura/payments/issues/418",
        "state": "open"
      },
      "effects": {
        "set": {
          "github.lastIssue": {
            "repository": "tura/payments",
            "number": 418,
            "labels": ["incident", "P1"]
          }
        }
      },
      "stepId": "step-02",
      "requires": ["step-01"]
    },
    {
      "intent": "slack_post_message",
      "tool": "send_message",
      "description": "Post an incident update to Slack.",
      "expectedArguments": {
        "channel_id": "C-INCIDENTS",
        "message": "P1 checkout incident tracked at https://github.example/tura/payments/issues/418"
      },
      "argumentAssertions": [
        {
          "path": "channel_id",
          "operator": "normalized-equals"
        },
        {
          "path": "message",
          "operator": "normalized-equals"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["channel_id", "message"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "message_timestamp": {
            "type": "string",
            "minLength": 1
          },
          "message_link": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["message_timestamp"],
        "additionalProperties": true
      },
      "responseMode": "structured-json",
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "contract": {
        "provider": "slack",
        "fidelity": "official-mcp",
        "source": "https://docs.slack.dev/ai/slack-mcp-server/",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      "argumentNormalization": {},
      "result": {
        "message_timestamp": "slack-msg-007",
        "message_link": "https://mock.slack.invalid/archives/C-INCIDENTS/slack-msg-007"
      },
      "effects": {
        "set": {
          "slack.lastMessage": {
            "channelId": "C-INCIDENTS",
            "text": "P1 checkout incident tracked at https://github.example/tura/payments/issues/418"
          }
        }
      },
      "stepId": "step-03",
      "requires": ["step-02"]
    },
    {
      "intent": "gmail_send_email",
      "tool": "create_draft",
      "description": "Create a Gmail draft for the incident stakeholder notification through Gmail.",
      "expectedArguments": {
        "to": ["stakeholders@example.com"],
        "subject": "P1 checkout incident opened",
        "body": "We opened issue #418 for SENTRY-PAY-500 and notified the incident channel."
      },
      "argumentAssertions": [
        {
          "path": "to",
          "operator": "normalized-equals"
        },
        {
          "path": "subject",
          "operator": "normalized-equals"
        },
        {
          "path": "body",
          "operator": "normalized-equals"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cc": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bcc": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "htmlBody": {
            "type": "string"
          },
          "replyToMessageId": {
            "type": "string",
            "minLength": 1
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "filename": {
                  "type": "string",
                  "minLength": 1
                },
                "mimeType": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                },
                "inline": {
                  "type": "boolean"
                }
              },
              "required": ["content"],
              "additionalProperties": false
            },
            "description": "Published in the tool schema, but Gmail MCP currently documents draft attachments as unsupported."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "threadId": {
            "type": "string",
            "minLength": 1
          },
          "toRecipients": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ccRecipients": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bccRecipients": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "plaintextBody": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "htmlBody": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "subject",
          "threadId",
          "toRecipients",
          "plaintextBody",
          "date"
        ],
        "additionalProperties": true
      },
      "responseMode": "structured-json",
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "contract": {
        "provider": "gmail",
        "fidelity": "official-mcp",
        "source": "https://developers.google.com/workspace/gmail/api/reference/mcp",
        "revision": "2026-08-09",
        "transport": "streamable-http",
        "authentication": "oauth-2.0",
        "responseMode": "structured-json"
      },
      "argumentNormalization": {},
      "result": {
        "id": "gmail-msg-007",
        "subject": "P1 checkout incident opened",
        "threadId": "thread-gmail-msg-007",
        "toRecipients": ["stakeholders@example.com"],
        "plaintextBody": "We opened issue #418 for SENTRY-PAY-500 and notified the incident channel.",
        "date": "2026-08-09"
      },
      "effects": {
        "set": {
          "gmail.lastDraft": {
            "to": ["stakeholders@example.com"],
            "subject": "P1 checkout incident opened",
            "status": "draft"
          }
        },
        "append": {
          "gmail.drafts": {
            "to": ["stakeholders@example.com"],
            "subject": "P1 checkout incident opened",
            "status": "draft"
          }
        }
      },
      "stepId": "step-04",
      "requires": ["step-02", "step-03"]
    }
  ],
  "expectedState": {
    "github.lastIssue": {
      "repository": "tura/payments",
      "number": 418,
      "labels": ["incident", "P1"]
    },
    "slack.lastMessage": {
      "channelId": "C-INCIDENTS"
    },
    "gmail.lastDraft": {
      "to": ["stakeholders@example.com"],
      "status": "draft"
    },
    "gmail.drafts": [
      {
        "to": ["stakeholders@example.com"],
        "subject": "P1 checkout incident opened",
        "status": "draft"
      }
    ]
  },
  "selfTest": {
    "calls": [
      {
        "name": "get_issue_details",
        "arguments": {
          "organizationSlug": "acme",
          "issueId": "SENTRY-PAY-500"
        }
      },
      {
        "name": "issue_write",
        "arguments": {
          "method": "create",
          "owner": "tura",
          "repo": "payments",
          "title": "[P1] Checkout 500 errors",
          "body": "Sentry SENTRY-PAY-500 reports 37 checkout failures after deploy 8f21c.",
          "labels": ["incident", "P1"]
        }
      },
      {
        "name": "send_message",
        "arguments": {
          "channel_id": "C-INCIDENTS",
          "message": "P1 checkout incident tracked at https://github.example/tura/payments/issues/418"
        }
      },
      {
        "name": "create_draft",
        "arguments": {
          "to": ["stakeholders@example.com"],
          "subject": "P1 checkout incident opened",
          "body": "We opened issue #418 for SENTRY-PAY-500 and notified the incident channel."
        }
      }
    ]
  }
}
