{
  "name": "mcp_workspace",
  "description": "Dispatch one schema-validated tools/call request to the task-local filesystem MCP server.",
  "input_schema": {
    "oneOf": [
      {
        "title": "read_file",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "read_file",
            "description": "Read one UTF-8 text file from the isolated task workspace."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["path"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "write_file",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "write_file",
            "description": "Create or replace one UTF-8 text file in the isolated task workspace."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              }
            },
            "required": ["path", "content"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "list_directory",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "list_directory",
            "description": "List files and directories directly below a workspace-relative directory."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "default": "."
              }
            },
            "additionalProperties": false
          }
        }
      },
      {
        "title": "make_directory",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "make_directory",
            "description": "Create a workspace-relative directory and missing parents."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["path"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "move_file",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "move_file",
            "description": "Move or rename a file or directory within the isolated workspace."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "destination": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["source", "destination"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "delete_file",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "delete_file",
            "description": "Delete one file or an empty directory inside the isolated workspace."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["path"],
            "additionalProperties": false
          }
        }
      },
      {
        "title": "search_files",
        "type": "object",
        "required": ["name", "arguments"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "const": "search_files",
            "description": "Search workspace-relative paths and UTF-8 file contents for a text query."
          },
          "arguments": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "default": "."
              },
              "max_results": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200,
                "default": 50
              }
            },
            "required": ["query"],
            "additionalProperties": false
          }
        }
      }
    ]
  }
}
