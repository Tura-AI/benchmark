    "lucide-react": "0.468.0",
    "vite": "7.2.7",
    "vinxi": "0.5.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tanstack/router-plugin": "1.168.19",
    "@types/node": "22.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "playwright": "1.57.0",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  }
}
