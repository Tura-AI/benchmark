{
  "name": "powerprompt-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run tests/db.test.ts --reporter=dot",
    "test:api": "vitest run tests/api.test.ts --reporter=dot",
    "test:e2e": "playwright test",
    "test": "npm run test:db && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "@tanstack/router-plugin": "1.168.19",
    "@vitejs/plugin-react": "6.0.3",
    "lucide-react": "^0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sql.js": "1.14.1",
    "vite": "8.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "1.4.11",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
