{
  "name": "powerprompt-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "vite preview --host 127.0.0.1 --port 3000",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:db && npm run test:api",
    "test:db": "vitest run tests/db.test.ts --reporter=dot",
    "test:api": "vitest run tests/api.test.ts --reporter=dot",
    "test:e2e": "playwright test --reporter=line"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tanstack/router-plugin": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
