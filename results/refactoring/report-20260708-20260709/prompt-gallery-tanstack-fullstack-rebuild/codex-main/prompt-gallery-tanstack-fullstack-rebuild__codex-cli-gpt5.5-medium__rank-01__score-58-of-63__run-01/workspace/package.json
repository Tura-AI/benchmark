{
  "name": "powerprompt-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-start-core.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --experimental-strip-types scripts/serve-start.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:db": "vitest --config vitest.config.ts run tests/db.test.ts",
    "test:api": "vitest --config vitest.config.ts run tests/api.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:db && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "@vitejs/plugin-react": "^5.2.0",
    "sql.js": "^1.13.0",
    "vite": "^8.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "lucide-react": "^0.555.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.4",
    "playwright": "^1.57.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
