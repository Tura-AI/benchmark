 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+
+chmod +x eza_port.py 2>/dev/null || true
+
+printf '@echo off\r\nset PYTHONUTF8=1\r\npython "%%~dp0eza_port.py" %%*\r\n' > executable.cmd
+
+printf '#!/usr/bin/env sh\nexec python3 "$(dirname "$0")/eza_port.py" "$@"\n' > executable
