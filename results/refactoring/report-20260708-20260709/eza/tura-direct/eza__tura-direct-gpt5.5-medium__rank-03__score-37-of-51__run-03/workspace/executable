@dataclass
class Opts:
    mode: str = "lines"
    long: bool = False
    tree: bool = False
    recurse: bool = False
    all_count: int = 0
    treat_dirs_as_files: bool = False
    only_dirs: bool = False
    only_files: bool = False
    show_symlinks: bool = False
    no_symlinks: bool = False
    level: int | None = None
    reverse: bool = False
    sort: str = "name"
    dirs_first: bool = False
    dirs_last: bool = False
    ignore_globs: list[str] | None = None
    classify: str = "never"
    color: str = "auto"
    header: bool = False
    bytes: bool = False
    binary: bool = False
    no_permissions: bool = False
    no_filesize: bool = False
    no_user: bool = False
    no_time: bool = False
    no_group: bool = True
    numeric: bool = False
    stdin: bool = False
    absolute: str = "off"
    follow_symlinks: bool = False
    quote: bool = True

    def __post_init__(self):
        if self.ignore_globs is None:
            self.ignore_globs = []
        if os.name == "nt":
            self.no_user = True


class CliError(Exception):
    def __init__(self, msg: str, code: int = 3):
        super().__init__(msg)
        self.code = code


LONGS_WITH_VALUE = {"classify", "color", "colour", "icons", "width", "absolute", "level", "sort", "ignore-glob", "time", "time-style", "color-scale", "colour-scale", "color-scale-mode", "colour-scale-mode"}
SHORTS_WITH_VALUE = {"F", "w", "L", "s", "I", "t"}
SORT_FIELDS = {"name", "Name", "extension", "Extension", "size", "type", "created", "modified", "accessed", "changed", "inode", "none", "date", "time", "old", "new", "oldest", "newest"}


def parse(argv: list[str]) -> tuple[Opts, list[str]]:
    opts = Opts()
    paths: list[str] = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            paths.extend(argv[i + 1:])
            break
        if not arg.startswith("-") or arg == "-":
            paths.append(arg)
            i += 1
            continue
        if arg.startswith("--"):
            nameval = arg[2:]
            if "=" in nameval:
                name, value = nameval.split("=", 1)
            else:
                name, value = nameval, None
            canonical = {"colour": "color", "colour-scale": "color-scale", "colour-scale-mode": "color-scale-mode"}.get(name, name)
            if canonical in LONGS_WITH_VALUE and value is None:
                if canonical in {"classify", "color", "icons"}:
                    value = "auto"
                else:
                    i += 1
                    if i >= len(argv):
                        raise CliError(f"Option --{name} needs a value")
                    value = argv[i]
            apply_long(opts, canonical, value)
            i += 1
            continue
        shorts = arg[1:]
        j = 0
        while j < len(shorts):
            ch = shorts[j]
            value = None
            if ch in SHORTS_WITH_VALUE:
                if j + 1 < len(shorts):
                    value = shorts[j + 1:]
                    j = len(shorts)
                else:
                    i += 1
                    if i >= len(argv):
                        raise CliError(f"Option -{ch} needs a value")
                    value = argv[i]
            apply_short(opts, ch, value)
            j += 1
        i += 1
    if opts.stdin:
        data = sys.stdin.read()
        sep = os.environ.get("EZA_STDIN_SEPARATOR") or os.environ.get("EXA_STDIN_SEPARATOR") or "\n"
        paths.extend([p for p in data.split(sep) if p])
    if not paths:
        paths = ["."]
    return opts, paths


def apply_long(o: Opts, name: str, value: str | None):
    match name:
        case "help": print(HELP, end=""); raise SystemExit(0)
        case "version": print(VERSION, end=""); raise SystemExit(0)
        case "oneline": o.mode = "lines"
        case "long": o.long = True; o.mode = "long"
        case "grid": o.mode = "lines"
        case "recurse": o.recurse = True
        case "tree": o.tree = True; o.recurse = True
        case "all": o.all_count += 1
        case "almost-all": o.all_count = max(o.all_count, 1)
        case "treat-dirs-as-files" | "list-dirs": o.treat_dirs_as_files = True
        case "only-dirs": o.only_dirs = True
        case "only-files": o.only_files = True
        case "show-symlinks": o.show_symlinks = True
        case "no-symlinks": o.no_symlinks = True
        case "level": o.level = parse_int(value or "", "--level")
        case "reverse": o.reverse = True
        case "sort": set_sort(o, value or "")
        case "group-directories-first": o.dirs_first = True; o.dirs_last = False
        case "group-directories-last": o.dirs_last = True; o.dirs_first = False
        case "ignore-glob": o.ignore_globs.extend((value or "").split("|"))
        case "classify": o.classify = value or "auto"
        case "color": o.color = value or "auto"
        case "header": o.header = True
        case "bytes": o.bytes = True
        case "binary": o.binary = True
        case "group": o.no_group = False
        case "numeric": o.numeric = True
        case "no-permissions": o.no_permissions = True
        case "no-filesize": o.no_filesize = True
        case "no-user": o.no_user = True
        case "no-time": o.no_time = True
        case "stdin": o.stdin = True
        case "absolute": o.absolute = value or "on"
        case "follow-symlinks": o.follow_symlinks = True
        case "no-quotes": o.quote = False
        case "git" | "no-git" | "git-repos" | "git-repos-no-status" | "icons" | "width" | "hyperlink" | "dereference" | "color-scale" | "color-scale-mode" | "links" | "inode" | "blocksize" | "modified" | "accessed" | "created" | "changed" | "time" | "time-style" | "total-size" | "octal-permissions" | "mounts" | "smart-group" | "extended" | "context" | "flags":
            return
        case _:
            raise CliError(f"Unknown argument --{name}")


def apply_short(o: Opts, ch: str, value: str | None):
    match ch:
        case "?": print(HELP, end=""); raise SystemExit(0)
        case "v": print(VERSION, end=""); raise SystemExit(0)
        case "1": o.mode = "lines"
        case "l": o.long = True; o.mode = "long"
        case "G" | "x": o.mode = "lines"
        case "R": o.recurse = True
        case "T": o.tree = True; o.recurse = True
        case "a": o.all_count += 1
        case "A": o.all_count = max(o.all_count, 1)
        case "d": o.treat_dirs_as_files = True
        case "D": o.only_dirs = True
        case "f": o.only_files = True
        case "L": o.level = parse_int(value or "", "-L")
        case "r": o.reverse = True
        case "s": set_sort(o, value or "")
        case "I": o.ignore_globs.extend((value or "").split("|"))
        case "F": o.classify = value or "auto"
        case "b": o.binary = True
        case "B": o.bytes = True
        case "g": o.no_group = False
        case "h": o.header = True
        case "n": o.numeric = True
        case "X" | "w" | "H" | "i" | "S" | "t" | "m" | "u" | "U" | "o" | "M" | "@" | "Z" | "O":
            return
        case _:
            raise CliError(f"Unknown argument -{ch}")


def parse_int(s: str, opt: str) -> int:
    try:
        return int(s)
    except ValueError:
        label = "option --level (-L)" if opt in {"--level", "-L"} else f"option {opt}"
        raise CliError(f"Value \"{s}\" not valid for {label}: invalid digit found in string")


def set_sort(o: Opts, value: str):
    if value not in SORT_FIELDS:
        raise CliError(f"Option --sort (-s) has no \"{value}\" setting (choices: name, Name, size, extension, Extension, modified, changed, accessed, created, inode, type, none)")
    o.sort = {"date": "modified", "time": "modified", "old": "oldest", "new": "newest"}.get(value, value)


@dataclass
class Entry:
    path: Path
    display: str
    st: os.stat_result | None
    lst: os.stat_result | None
    missing: bool = False

    @property
    def name(self) -> str:
        return self.path.name or str(self.path)

    @property
    def is_link(self) -> bool:
        return self.lst is not None and stat.S_ISLNK(self.lst.st_mode)

    @property
    def is_dir(self) -> bool:
        try:
            return self.path.is_dir()
        except OSError:
            return False

    @property
    def is_file(self) -> bool:
        return self.st is not None and stat.S_ISREG(self.st.st_mode)


def make_entry(path: Path, display: str | None = None) -> Entry:
    try:
        lst = path.lstat()
        st = path.stat()
        return Entry(path, display if display is not None else str(path), st, lst)
    except OSError:
        return Entry(path, display if display is not None else str(path), None, None, True)


def visible_name(e: Entry, opts: Opts, link_paths: bool = True) -> str:
    if opts.absolute == "on":
        base = str(e.path.resolve(strict=False))
    else:
        base = e.display
    base = quote_name(base, opts)
    if link_paths and e.is_link:
        try:
            base += " -> " + os.readlink(e.path)
        except OSError:
            pass
    if opts.classify == "always":
        if e.is_dir:
            base += "/"
        elif e.is_link:
            base += "@"
        elif e.st and (e.st.st_mode & stat.S_IXUSR):
            base += "*"
    return base


def quote_name(s: str, opts: Opts) -> str:
    if not opts.quote or not any(ch.isspace() for ch in s):
        return s
    if "'" not in s:
        return "'" + s + "'"
    escaped = s.replace('"', '\\"')
    return '"' + escaped + '"'


def should_skip_name(name: str, opts: Opts) -> bool:
    if opts.all_count == 0 and name.startswith("."):
        return True
    return any(pat and fnmatch.fnmatch(name, pat) for pat in opts.ignore_globs)


def list_dir(path: Path, opts: Opts) -> list[Entry]:
    entries: list[Entry] = []
    if opts.all_count >= 2:
        entries.extend([make_entry(path / ".", "."), make_entry(path / "..", "..")])
    try:
        names = list(os.listdir(path))
    except OSError as exc:
        raise exc
    for name in names:
        if should_skip_name(name, opts):
            continue
        e = make_entry(path / name, name)
        if filtered(e, opts):
            continue
        entries.append(e)
    return sort_entries(entries, opts)


def filtered(e: Entry, opts: Opts) -> bool:
    is_link = e.is_link
    is_dir = e.is_dir
    is_file = e.is_file
    if opts.no_symlinks and is_link:
        return True
    if opts.only_dirs and not is_dir:
        return True
    if opts.only_files and not is_file and not (opts.show_symlinks and is_link):
        return True
    return False


def sort_entries(entries: list[Entry], opts: Opts) -> list[Entry]:
    def key(e: Entry):
        dir_group = 0
        if opts.dirs_first:
            dir_group = 0 if e.is_dir else 1
        elif opts.dirs_last:
            dir_group = 1 if e.is_dir else 0
        sf = opts.sort
        if sf in {"none"}:
            val = 0
        elif sf == "size":
            val = e.st.st_size if e.st else -1
        elif sf in {"modified", "newest"}:
            val = -(e.st.st_mtime if e.st else 0)
        elif sf == "oldest":
            val = e.st.st_mtime if e.st else 0
        elif sf in {"extension", "Extension"}:
            ext = e.name.rsplit(".", 1)[1] if "." in e.name else ""
            val = (ext if sf == "Extension" else ext.lower(), e.name.lower())
        elif sf == "type":
            val = (0 if e.is_dir else 1 if e.is_file else 2, e.name.lower())
        elif sf == "Name":
            val = e.name
        else:
            val = e.name.lower()
        return (dir_group, val, e.name.lower())
    out = sorted(entries, key=key)
    if opts.reverse:
        out.reverse()
    return out


def mode_string(e: Entry) -> str:
    if e.st is None:
        return "?????"
    if os.name == "nt":
        first = "d" if e.is_dir else "l" if e.is_link else "-"
        if first == "d":
            return "d----"
        readonly = bool(e.st.st_file_attributes & getattr(stat, "FILE_ATTRIBUTE_READONLY", 1)) if hasattr(e.st, "st_file_attributes") else False
        return first + ("-" if readonly else "a") + "---"
    m = e.st.st_mode
    first = "d" if stat.S_ISDIR(m) else "l" if stat.S_ISLNK(m) else "-"
    bits = ""
    for r, w, x in [(stat.S_IRUSR, stat.S_IWUSR, stat.S_IXUSR), (stat.S_IRGRP, stat.S_IWGRP, stat.S_IXGRP), (stat.S_IROTH, stat.S_IWOTH, stat.S_IXOTH)]:
        bits += "r" if m & r else "-"
        bits += "w" if m & w else "-"
        bits += "x" if m & x else "-"
    return first + bits


def size_string(e: Entry, opts: Opts) -> str:
    if e.st is None or e.is_dir:
        return "-"
    n = e.st.st_size
    if opts.bytes or n < 1000:
        return str(n)
    units = [(10**12, "T"), (10**9, "G"), (10**6, "M"), (10**3, "k")]
    if opts.binary:
        units = [(1024**4, "T"), (1024**3, "G"), (1024**2, "M"), (1024, "K")]
    for div, suf in units:
        if n >= div:
            v = n / div
            return (f"{v:.1f}" if v < 10 else str(round(v))) + suf
    return str(n)


def time_string(e: Entry) -> str:
    if e.st is None:
        return "-"
    dt = datetime.fromtimestamp(e.st.st_mtime)
    now = datetime.now()
    if abs((now - dt).days) < 180:
        return f"{dt.day:2d} {dt.strftime('%b')} {dt.strftime('%H:%M')}"
    return f"{dt.day:2d} {dt.strftime('%b')} {dt.year:5d}"


def long_rows(entries: list[Entry], opts: Opts) -> list[list[str]]:
    rows: list[list[str]] = []
    if opts.header:
        h = []
        if not opts.no_permissions: h.append("Mode" if os.name == "nt" else "Permissions")
        if not opts.no_filesize: h.append("Size")
        if not opts.no_user: h.append("User")
        if not opts.no_group: h.append("Group")
        if not opts.no_time: h.append("Date Modified")
        h.append("Name")
        rows.append(h)
    for e in entries:
        r = []
        if not opts.no_permissions: r.append(mode_string(e))
        if not opts.no_filesize: r.append(size_string(e, opts))
        if not opts.no_user: r.append(user_string())
        if not opts.no_group: r.append(group_string())
        if not opts.no_time: r.append(time_string(e))
        r.append(visible_name(e, opts, True))
        rows.append(r)
    return rows


def user_string() -> str:
    if os.name == "nt":
        return ""
    try:
        import pwd
        return pwd.getpwuid(os.getuid()).pw_name
    except Exception:
        return str(os.getuid() if hasattr(os, "getuid") else "")


def group_string() -> str:
    if os.name == "nt":
        return ""
    try:
        import grp
        return grp.getgrgid(os.getgid()).gr_name
    except Exception:
        return str(os.getgid() if hasattr(os, "getgid") else "")


def render_long(entries: list[Entry], opts: Opts) -> str:
    rows = long_rows(entries, opts)
    if not rows:
        return ""
    cols = max(len(r) for r in rows)
    widths = [0] * cols
    for r in rows:
        for i, c in enumerate(r):
            widths[i] = max(widths[i], len(c))
    lines = []
    for r in rows:
        line = ""
        for i, c in enumerate(r):
            if i == len(r) - 1:
                line += c
            else:
                cell = c.rjust(widths[i]) if column_is_right(i, opts) else c.ljust(widths[i])
                line += cell + " "
        lines.append(line.rstrip())
    return "\n".join(lines) + ("\n" if lines else "")


def column_is_right(index: int, opts: Opts) -> bool:
    cols = []
    if not opts.no_permissions: cols.append("mode")
    if not opts.no_filesize: cols.append("size")
    if not opts.no_user: cols.append("user")
    if not opts.no_group: cols.append("group")
    if not opts.no_time: cols.append("time")
    return index < len(cols) and cols[index] == "size"


def render_lines(entries: list[Entry], opts: Opts) -> str:
    return "".join(visible_name(e, opts, True) + "\n" for e in entries)


def render_tree(root: Entry, opts: Opts) -> str:
    lines = [visible_name(root, opts, False)]
    def walk(path: Path, prefix: str, depth: int):
        if opts.level is not None and depth > opts.level:
            return
        try:
            children = list_dir(path, opts)
        except OSError:
            return
        for idx, child in enumerate(children):
            last = idx == len(children) - 1
            branch = "└── " if last else "├── "
            lines.append(prefix + branch + visible_name(child, opts, True))
            if child.is_dir and not child.is_link:
                walk(child.path, prefix + ("    " if last else "│   "), depth + 1)
    if root.is_dir:
        walk(root.path, "", 1)
    return "\n".join(lines) + "\n"


def collect_top(paths: list[str], opts: Opts) -> tuple[list[Entry], list[str]]:
    entries: list[Entry] = []
    errors: list[str] = []
    multiple = len(paths) > 1
    blocks: list[Entry] = []
    for p in paths:
        path = Path(p)
        e = make_entry(path, p)
        if e.missing:
            errors.append(file_error(p))
            continue
        if e.is_dir and not opts.treat_dirs_as_files and not opts.tree and not opts.recurse:
            try:
                dir_entries = list_dir(path, opts)
            except OSError as exc:
                errors.append(str(exc))
                continue
            if multiple:
                blocks.append(e)
            entries.extend(dir_entries)
        else:
            if not filtered(e, opts):
                entries.append(e)
    return sort_entries(entries, opts), errors


def file_error(p: str) -> str:
    if os.name == "nt":
        return f'"{p}": 系统找不到指定的文件。 (os error 2)\n'
    return f'"{p}": No such file or directory (os error 2)\n'


def run(argv: list[str]) -> int:
    try:
        opts, paths = parse(argv)
    except CliError as exc:
        sys.stderr.write(f"eza: {exc}\n")
        return exc.code
    status = 0
    if opts.tree:
        for n, p in enumerate(paths):
            e = make_entry(Path(p), p)
            if e.missing:
                sys.stderr.write(file_error(p)); status = 2; continue
            if n and sys.stdout.tell if False else False:
                pass
            sys.stdout.write(render_tree(e, opts))
        return status
    if opts.recurse:
        return run_recurse(paths, opts)
    entries, errors = collect_top(paths, opts)
    if errors:
        status = 2
        for err in errors:
            sys.stderr.write(err)
    if opts.mode == "long":
        sys.stdout.write(render_long(entries, opts))
    else:
        sys.stdout.write(render_lines(entries, opts))
    return status


def run_recurse(paths: list[str], opts: Opts) -> int:
    status = 0
    first = True
    def block(path: Path, depth: int, top: bool = False):
        nonlocal first, status
        if opts.level is not None and depth > opts.level:
            return
        e = make_entry(path, str(path))
        if e.missing:
            sys.stderr.write(file_error(str(path))); status = 2; return
        if not first:
            sys.stdout.write("\n")
        first = False
        if not top:
            sys.stdout.write(str(path) + ":\n")
        try:
            children = list_dir(path, opts)
        except OSError as exc:
            sys.stderr.write(str(exc) + "\n"); status = 2; return
        sys.stdout.write(render_long(children, opts) if opts.mode == "long" else render_lines(children, opts))
        for child in children:
            if child.is_dir and not child.is_link:
                block(child.path, depth + 1)
    for p in paths:
        e = make_entry(Path(p), p)
        if e.is_dir:
            block(Path(p), 1, top=(len(paths) == 1))
        elif e.missing:
            sys.stderr.write(file_error(p)); status = 2
        else:
            sys.stdout.write((render_long([e], opts) if opts.mode == "long" else render_lines([e], opts)))
    return status


if __name__ == "__main__":
    raise SystemExit(run(sys.argv[1:]))
