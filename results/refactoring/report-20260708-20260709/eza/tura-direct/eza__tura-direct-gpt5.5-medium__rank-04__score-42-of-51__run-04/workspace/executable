#!/usr/bin/env python3
import fnmatch
import os
import stat
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path


VERSION_TEXT = "eza - A modern, maintained replacement for ls\nv0.23.3 [+git]\nhttps://github.com/eza-community/eza\n"

HELP_TEXT = """Usage:
  eza [options] [files...]

