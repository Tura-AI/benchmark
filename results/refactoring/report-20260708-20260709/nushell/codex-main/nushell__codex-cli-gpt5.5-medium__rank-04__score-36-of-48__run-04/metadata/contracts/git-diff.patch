@@ -1,3 +1,11 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+rm -f executable executable.exe executable.cmd executable.bat executable.js executable.jar
+if command -v python >/dev/null 2>&1; then
+  PY=python
+else
+  PY=python3
+fi
+cp nushell_port.py executable
+chmod +x executable 2>/dev/null || true
+"$PY" -m py_compile nushell_port.py

# ---- tura-direct model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..08f97fc 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,21 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+
+rm -f executable.exe executable.bat executable.js executable.jar
+
+# The evaluator checks ./executable first. Keep it valid Python source, not a
+# shell wrapper, so it can be run as: python ./executable <args>.
+python -m py_compile nushell_port.py executable
+
+case "$(uname -s 2>/dev/null || printf unknown)" in
+  MINGW*|MSYS*|CYGWIN*)
+    cat > executable.cmd <<'EOF'
+@echo off
+python "%~dp0\nushell_port.py" %*
+EOF
+    ;;
+  *)
+    chmod +x executable || true
+    rm -f executable.cmd
+    ;;
+esac
