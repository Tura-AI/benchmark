# ---- tura-balanced model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..d7b8276 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,10 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+chmod +x executable 2>/dev/null || true
+if [ "$(uname -s 2>/dev/null || printf unknown)" = "MINGW64_NT" ] || [ "$(uname -s 2>/dev/null || printf unknown)" = "MSYS_NT" ] || [ "$(uname -s 2>/dev/null || printf unknown)" = "CYGWIN_NT" ]; then
+  cat > executable.cmd <<'EOF'
+@echo off
+python "%~dp0\nushell_port.py" %*
+EOF
+fi
+python -m py_compile nushell_port.py executable

# ---- tura-direct model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..ad634a1 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,17 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+
+# The evaluator checks ./executable before platform-specific wrappers.
+# Keep it as valid Python source, not a POSIX shell wrapper.
+if [ -f executable ]; then
+  rm -f executable
+fi
+cp nushell_port.py executable
+
+# Windows convenience wrapper, lower priority than ./executable.
+cat > executable.cmd <<'EOF'
+@echo off
+python "%~dp0nushell_port.py" %*
+EOF
+
+python -m py_compile nushell_port.py
