# ---- tura-direct model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..d83d8cc 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,16 @@
-#!/usr/bin/env sh
-set -eu
-[ -f executable ]
+#!/usr/bin/env python3
+import os
+import py_compile
+
+for name in ("executable.cmd", "executable.bat", "executable.exe", "executable.js", "executable.jar", "executable.py"):
+    try:
+        os.remove(name)
+    except FileNotFoundError:
+        pass
+
+py_compile.compile("xsv_port.py", doraise=True)
+py_compile.compile("executable", doraise=True)
+try:
+    os.chmod("executable", 0o755)
+except OSError:
+    pass
