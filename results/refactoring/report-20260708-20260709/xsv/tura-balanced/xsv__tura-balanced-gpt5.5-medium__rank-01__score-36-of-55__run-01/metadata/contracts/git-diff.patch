# ---- codex-main model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..9b6a489 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,19 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+
+cat > executable <<'PY'
+#!/usr/bin/env python3
+import xsv_port
+
+if __name__ == "__main__":
+    raise SystemExit(xsv_port.main())
+PY
+
+if [ -n "${COMSPEC:-}" ]; then
+  cat > executable.cmd <<'CMD'
+@echo off
+python "%~dp0xsv_port.py" %*
+CMD
+fi
+
+chmod +x executable 2>/dev/null || true

