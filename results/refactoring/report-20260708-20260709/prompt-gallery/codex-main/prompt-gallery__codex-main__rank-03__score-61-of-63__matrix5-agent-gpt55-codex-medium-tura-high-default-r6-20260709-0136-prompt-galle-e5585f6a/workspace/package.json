{
  "name": "powerprompt-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/serve-built.mjs",
    "build": "node scripts/run-vite.mjs build",
    "start": "node scripts/serve-built.mjs",
    "preview": "node scripts/serve-built.mjs",
    "test:db": "node scripts/run-vitest.mjs run --config vitest.config.ts tests/db.test.ts",
    "test:api": "node scripts/run-vitest.mjs run --config vitest.config.ts tests/api.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run test:db && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.13.0",
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@esbuild/win32-x64": "0.27.2",
    "@tanstack/router-plugin": "^1.168.19",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "playwright": "^1.54.2",
    "typescript": "^5.8.3",
    "vitest": "2.1.9"
  }
}
