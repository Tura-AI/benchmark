# ---- tura-balanced model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..0aab900 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,9 @@
 #!/usr/bin/env sh
 set -eu
+
+# The evaluator discovers ./executable first. It is valid Python source and can
+# be run as `python ./executable <args>` on every supported platform.
 [ -f executable ]
+if command -v chmod >/dev/null 2>&1; then
+  chmod +x executable || true
+fi

# ---- tura-direct model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..4817447 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,17 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+
+case "$(uname -s 2>/dev/null || echo Windows)" in
+  MINGW*|MSYS*|CYGWIN*|Windows*|*_NT)
+    rm -f executable executable.exe executable.bat executable.js executable.py executable.jar
+    cat > executable.cmd <<'EOF'
+@echo off
+py -3 "%~dp0zip_password_finder_port.py" %*
+EOF
+    ;;
+  *)
+    rm -f executable.exe executable.cmd executable.bat executable.js executable.py executable.jar
+    cp zip_password_finder_port.py executable
+    chmod +x executable
+    ;;
+esac
