# ---- codex-main model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..927331c 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,14 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+
+chmod +x ./executable 2>/dev/null || true
+
+if [ ! -f ./executable.cmd ]; then
+  cat > ./executable.cmd <<'EOF'
+@echo off
+set PYTHONIOENCODING=utf-8
+python "%~dp0nushell_port.py" %*
+EOF
+fi
+
+python -m py_compile ./nushell_port.py

# ---- tura-balanced model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..5d57614 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,18 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+if command -v python3 >/dev/null 2>&1; then
+  PY=python3
+else
+  PY=python
+fi
+$PY -m py_compile nu_port.py
+cat > executable <<'EOF'
+#!/usr/bin/env sh
+if command -v python3 >/dev/null 2>&1; then
+  exec python3 "$(dirname "$0")/nu_port.py" "$@"
+else
+  exec python "$(dirname "$0")/nu_port.py" "$@"
+fi
+EOF
+chmod +x executable
+[ -f executable.cmd ] || [ -f executable ]

# ---- tura-direct model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..6a2c513 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,10 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+chmod +x executable.py 2>/dev/null || true
+if [ ! -f executable.cmd ]; then
+  printf '@echo off\r\npython "%~dp0executable.py" %%*\r\n' > executable.cmd
+fi
+if [ ! -f executable ]; then
+  printf '#!/usr/bin/env sh\nexec python3 "$(dirname "$0")/executable.py" "$@"\n' > executable
+  chmod +x executable 2>/dev/null || true
+fi
