# ---- codex-main model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..1b9719d 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,14 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+
+chmod +x ./nu_port.py
+cat > ./executable <<'EOF'
+#!/usr/bin/env sh
+exec python3 "$(dirname "$0")/nu_port.py" "$@"
+EOF
+chmod +x ./executable
+
+cat > ./executable.cmd <<'EOF'
+@echo off
+python "%~dp0nu_port.py" %*
+EOF

