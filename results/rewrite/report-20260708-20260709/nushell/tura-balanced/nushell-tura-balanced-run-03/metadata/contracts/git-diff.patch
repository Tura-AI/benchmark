# ---- tura-direct model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..e9e2317 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,11 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+if [ -f executable.cmd ]; then
+  exit 0
+fi
