# ---- codex-main model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..cc8ab81 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,18 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+
+case "$(uname -s 2>/dev/null || echo Windows_NT)" in
+  MINGW*|MSYS*|CYGWIN*|Windows_NT*)
+    cat > executable.cmd <<'EOF'
+@echo off
+python "%~dp0xsv_py.py" %*
+EOF
+    ;;
+  *)
+    cat > executable <<'EOF'
+#!/usr/bin/env sh
+exec python3 "$(dirname "$0")/xsv_py.py" "$@"
+EOF
+    chmod +x executable
+    ;;
+esac

