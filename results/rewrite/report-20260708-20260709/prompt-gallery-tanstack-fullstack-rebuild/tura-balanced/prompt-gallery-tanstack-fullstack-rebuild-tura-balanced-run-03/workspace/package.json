{
  "name": "powerprompt-marketplace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run --config vitest.config.ts tests/db.test.ts --reporter=dot",
    "test:api": "vitest run --config vitest.config.ts tests/api.test.ts --reporter=dot",
    "test:e2e": "playwright test --reporter=line",
    "test": "npm run test:db && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "^3.0.260610-beta",
    "playwright": "^1.57.0",
    "typescript": "^6.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.0.15"
  }
}
