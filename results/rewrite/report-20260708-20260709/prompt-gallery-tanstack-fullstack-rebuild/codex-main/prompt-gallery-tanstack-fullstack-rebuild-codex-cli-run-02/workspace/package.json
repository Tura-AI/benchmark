{
  "name": "powerprompt-marketplace",
  "private": true,
  "type": "module",
  "imports": {
    "#tanstack-start-server-fn-resolver": "./node_modules/@tanstack/start-server-core/dist/esm/fake-start-server-fn-resolver.js",
    "#tanstack-start-plugin-adapters": "./node_modules/@tanstack/start-server-core/dist/esm/empty-plugin-adapters.js"
  },
  "scripts": {
    "postinstall": "node scripts/patch-tanstack-start.mjs",
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build --configLoader native",
    "start": "node --experimental-strip-types --no-warnings scripts/serve-built.mjs",
    "preview": "node --experimental-strip-types --no-warnings scripts/serve-built.mjs",
    "test:db": "node --experimental-strip-types --no-warnings --test tests/db.test.ts",
    "test:api": "node --experimental-strip-types --no-warnings --test tests/api.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:db && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.6.0",
    "playwright": "1.54.2",
    "typescript": "5.8.3",
    "vite": "7.0.4",
    "vitest": "3.2.4"
  }
}
