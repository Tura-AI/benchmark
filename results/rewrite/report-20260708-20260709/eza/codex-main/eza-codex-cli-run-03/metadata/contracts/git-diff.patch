# ---- codex-main model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..0d6e950 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,8 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+chmod +x eza_py.py 2>/dev/null || true
+if [ ! -f executable.cmd ]; then
+  printf '%s\n' '@echo off' 'python "%~dp0eza_py.py" %*' > executable.cmd
+fi
+[ -f eza_py.py ]
+[ -f executable.cmd ]

# ---- tura-balanced model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..af88942 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,9 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+chmod +x eza_port.py 2>/dev/null || true
+if [ "${OS:-}" = "Windows_NT" ]; then
+  printf '@echo off\r\nset PYTHONIOENCODING=utf-8\r\npython "%~dp0eza_port.py" %%*\r\n' > executable.cmd
+else
+  printf '#!/usr/bin/env sh\nexec python3 "$(dirname "$0")/eza_port.py" "$@"\n' > executable
+  chmod +x executable
+fi

# ---- tura-direct model.patch ----
diff --git a/compile.sh b/compile.sh
index 5fc76ac..01b9632 100644
--- a/compile.sh
+++ b/compile.sh
@@ -1,3 +1,14 @@
 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+chmod +x eza_port.py 2>/dev/null || true
+cat > executable <<'EOF'
+#!/usr/bin/env sh
+exec python3 "$(dirname "$0")/eza_port.py" "$@"
+EOF
+chmod +x executable 2>/dev/null || true
+cat > executable.cmd <<'EOF'
+@echo off
+set PYTHONUTF8=1
+python "%~dp0eza_port.py" %*
+exit /b %ERRORLEVEL%
+EOF
