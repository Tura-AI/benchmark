{
  "name": "powerprompt-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts --reporter=dot",
    "test:db": "vitest run --config vitest.config.ts tests/db.test.ts --reporter=dot",
    "test:api": "vitest run --config vitest.config.ts tests/api.test.ts --reporter=dot",
    "pretest:e2e": "node -e \"require('node:fs').rmSync('data/e2e.db',{force:true})\"",
    "test:e2e": "playwright test --reporter=line"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "^3.0.260311-beta",
    "playwright": "^1.61.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.14",
    "vitest": "^4.1.10"
  }
}
