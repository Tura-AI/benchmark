/5\",desc:\"Creamy backgrounds, golden-hour warmth, eyes in razor focus. Pure mood.\"},\n  {id:101,title:\"Meeting 鈫?Memo\",model:\"Claude\",cat:\"Productivity\",price:6,sold:5100,rating:4.7,seller:\"Ops Guild\",ar:\"4/3\",desc:\"Turns a messy transcript into a crisp decision memo: owners, dates, the one thing that matters.\"},\n  {id:290,title:\"Concept Car, Studio\",model:\"Midjourney\",cat:\"Image\",price:12,sold:1400,rating:4.8,seller:\"Forme\",ar:\"3/2\",desc:\"Automotive design renders with believable studio reflections and a real sense of scale.\"},\n  {id:77,title:\"The Plot Doctor\",model:\"Claude\",cat:\"Writing\",price:16,sold:1400,rating:4.9,seller:\"H. Mbeki\",ar:\"1/1\",desc:\"Diagnoses why your story stalls and prescribes the fix 鈥?stakes, pacing, the scene you're dodging.\"},\n  {id:221,title:\"Watercolor Cityscape\",model:\"Flux\",cat:\"Image\",price:9,sold:2000,rating:4.9,seller:\"Aquarelle\",ar:\"3/4\",desc:\"Loose, luminous washes with confident linework. Soft skies, busy streets.\"},\n  {id:63,title:\"Inbox Zero Strategist\",model:\"Claude\",cat:\"Productivity\",price:8,sold:3400,rating:4.6,seller:\"Lina P.\",ar:\"4/3\",desc:\"Triage, draft, and schedule a full inbox in one pass 鈥?sorted by what moves your week.\"}\n];\n\nconst CATS = [\"Image\",\"Photography\",\"Design\",\"Writing\",\"Code\",\"Marketing\",\"Productivity\",\"Research\"];\nconst MAP = {}; LOTS.forEach(l=>MAP[l.id]=l);\n\nfunction dim(ar){ const [w,h]=ar.split('/').map(Number); const W=560; return W+'/'+Math.round(W*h/w); }\nconst img = (id,ar)=>`https://picsum.photos/seed/pp${id}/${dim(ar)}`;\n\n/* ---------------- fallback ---------------- */\nfunction ppFallback(el){\n  const m=el.parentNode; const t=el.dataset.t||\"P\"; const i=+(el.dataset.i||0); const alt=i%2===1;\n  m.style.setProperty('--fb-bg', alt?'var(--lime)':'var(--ink)');\n  m.style.setProperty('--fb-fg', alt?'var(--ink)':'var(--lime)');\n  el.remove();\n  const d=document.createElement('div'); d.className='fb';\n  d.innerHTML=`<span class=\"fb-mark\">${(t[0]||'P').toUpperCase()}</span>`;\n  m.prepend(d);\n}\nwindow.ppFallback=ppFallback;\n\n/* ---------------- build categories ---------------- */\ndocument.getElementById('cats').innerHTML = CATS.map(c=>\n  `<div class=\"cat\" data-cat=\"${c}\"><span class=\"dot\"></span>${c}</div>`).join('');\n\n/* ---------------- build tiles ---------------- */\nconst masonry=document.getElementById('masonry');\nconst fmt=n=> n>=1000 ? (n/1000).toFixed(1).replace('.0','')+'k' : n;\n\nmasonry.dataset.built='1';\nconst tilesHTML = LOTS.map((l,i)=>{\n  const free=l.price===0;\n  return `<article class=\"tile\" data-id=\"${l.id}\" data-model=\"${l.model}\" data-cat=\"${l.cat}\"\n    data-search=\"${(l.title+' '+l.model+' '+l.cat+' '+l.desc).toLowerCase()}\" style=\"--ar:${l.ar}\">\n    <div class=\"savedmark\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 4h12v17l-6-4-6 4V4Z\"/></svg></div>\n    <div class=\"media\">\n      <img src=\"${img(l.id,l.ar)}\" alt=\"${l.title}\" loading=\"lazy\" data-t=\"${l.title}\" data-i=\"${i}\" onerror=\"ppFallback(this)\">\n    </div>\n    <div class=\"ov\">\n      <div class=\"ov__top\">\n        <span class=\"model\">${l.model}</span>\n        <button class=\"bm\" aria-label=\"Save\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M6 4h12v17l-6-4-6 4V4Z\"/></svg></button>\n      </div>\n      <div>\n        <h3>${l.title}</h3>\n        <div class=\"ov__row\">\n          <span class=\"price ${free?'free':''}\">${free?'Free':'$'+l.price}</span>\n          <button class=\"add\">Add <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></button>\n        </div>\n      </div>\n    </div>\n  </article>`;\n}).join('');\nmasonry.innerHTML = tilesHTML;\nconst tiles=[...masonry.querySelectorAll('.tile')];\n\n/* ---------------- state + masonry layout ---------------- */\nconst saved=new Set();\nlet state={model:'all',cat:'all',sort:'featured',term:'',favOnly:false};\nlet firstLayout=true; const GAP=14;\nfunction colCount(){ return Math.max(2, Math.min(6, Math.floor((masonry.clientWidth+GAP)/(238+GAP)))); }\nfunction visibleSorted(){\n  let v=tiles.filter(t=>{\n    const okM=state.model==='all'||t.dataset.model===state.model;\n    const okC=state.cat==='all'||t.dataset.cat===state.cat;\n    const okT=!state.term||t.dataset.search.includes(state.term);\n    const okF=!state.favOnly||saved.has(t.dataset.id);\n    return okM&&okC&&okT&&okF;\n  });\n  const by={\n    featured:(a,b)=>MAP[b.dataset.id].sold-MAP[a.dataset.id].sold,\n    newest:(a,b)=>b.dataset.id-a.dataset.id,\n    popular:(a,b)=>MAP[b.dataset.id].rating-MAP[a.dataset.id].rating||MAP[b.dataset.id].sold-MAP[a.dataset.id].sold\n  }[state.sort];\n  return v.sort(by);\n}\nfunction layout(){\n  const v=visibleSorted();\n  masonry.innerHTML='';\n  if(!v.length){\n    const e=document.createElement('div'); e.className='empty';\n    e.innerHTML='<div class=\"big\">Nothing here yet</div><div>'+(state.favOnly?'Tap the bookmark on any prompt to save it.':'Try a different filter or search.')+'</div>';\n    masonry.appendChild(e); return;\n  }\n  const n=colCount(), cols=[];\n  for(let i=0;i<n;i++){ const c=document.createElement('div'); c.className='ms-col'; masonry.appendChild(c); cols.push({el:c,h:0}); }\n  v.forEach((t,idx)=>{\n    let s=cols[0]; for(const c of cols) if(c.h<s.h) s=c;\n    t.style.animationDelay = firstLayout ? (Math.min(idx,24)*0.03)+'s' : '0s';\n    if(!firstLayout) t.style.animation='none';\n    s.el.appendChild(t);\n    s.h += t.getBoundingClientRect().height + GAP;\n  });\n  firstLayout=false;\n}\n\n/* ---------------- toast + cart ---------------- */\nlet cart=0; const cbadge=document.getElementById('cbadge');\nconst toast=document.getElementById('toast'), tmsg=document.getElementById('toastMsg'); let tt;\nfunction showToast(m){ tmsg.textContent=m; toast.classList.add('show'); clearTimeout(tt); tt=setTimeout(()=>toast.classList.remove('show'),2100); }\nfunction bump(){ cart++; cbadge.textContent=cart; cbadge.classList.add('show'); cbadge.style.transform='scale(1.4)'; setTimeout(()=>cbadge.style.transform='scale(1)',160); }\n\n/* ---------------- tile interactions ---------------- */\nmasonry.addEventListener('click',e=>{\n  const bm=e.target.closest('.bm');\n  if(bm){ e.stopPropagation(); const tile=bm.closest('.tile'); const id=tile.dataset.id;\n    if(saved.has(id)){ saved.delete(id); tile.classList.remove('saved'); bm.classList.remove('on'); showToast('Removed from favorites'); }\n    else{ saved.add(id); tile.classList.add('saved'); bm.classList.add('on'); showToast('Saved to favorites'); }\n    if(state.favOnly) layout(); return; }\n  const add=e.target.closest('.add');\n",
