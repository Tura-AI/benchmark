      "exitCode": null,
      "receipt": "import type { Prompt } from '../types'\nimport { Icons } from './icons'\n\ntype Props = {\n  prompt: Prompt\n  onPreview: (prompt: Prompt) => void\n  onFavorite: (prompt: Prompt) => void\n  onCart: (prompt: Prompt) => void\n}\n\nexport function PromptCard({ prompt, onPreview, onFavorite, onCart }: Props) {\n  return (\n    <article className={`tile ${prompt.isFavorite ? 'saved' : ''}`} data-prompt-id={prompt.id}>\n      {prompt.isFavorite && <span className=\"savedmark\"><Icons.Bookmark size={15} fill=\"currentColor\" /></span>}\n      <button className=\"media\" data-action=\"preview\" aria-label={`Preview ${prompt.title}`}>\n        <img src={prompt.imageUrl} alt=\"\" loading=\"lazy\" />\n      </button>\n      <div className=\"ov\">\n        <div className=\"ov__top\">\n          <span className=\"model\">{prompt.model}</span>\n          <button\n            className={`bm ${prompt.isFavorite ? 'on' : ''}`}\n            data-action=\"favorite\"\n            aria-label={prompt.isFavorite ? 'Remove from favorites' : 'Save to favorites'}\n          >\n            <Icons.Bookmark fill={prompt.isFavorite ? 'currentColor' : 'none'} />\n          </button>\n        </div>\n        <button className=\"card-copy\" data-action=\"preview\" aria-label={`Open ${prompt.title}`}>\n          <h3>{prompt.title}</h3>\n          <p>{prompt.category} 路 {prompt.rating.toFixed(1)} 鈽?/p>\n        </button>\n        <div className=\"ov__row\">\n          <span className={`price ${prompt.price === 0 ? 'free' : ''}`}>{prompt.price === 0 ? 'Free' : `$${prompt.price}`}</span>\n          <button className={`add ${prompt.inCart ? 'added' : ''}`} data-action=\"cart\">\n            {prompt.inCart ? 'Added' : 'Add'} <span>鈫?/span>\n          </button>\n        </div>\n      </div>\n    </article>\n  )\n}\n\n",
