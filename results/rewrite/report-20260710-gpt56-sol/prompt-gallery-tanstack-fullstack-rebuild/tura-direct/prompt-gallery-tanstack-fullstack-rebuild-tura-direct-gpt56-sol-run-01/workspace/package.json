{
  "name": "powerprompt-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run tests/db.test.ts --reporter=dot",
    "test:api": "vitest run tests/api.test.ts --reporter=dot",
    "test:e2e": "playwright test",
    "test": "npm run test:db && npm run test:api"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.55.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
