{
  "name": "powerprompt-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "dev:hmr": "vite --port 3000",
    "build": "vite build",
    "start": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "npm run test:db && npm run test:api",
    "test:db": "vitest run tests/db.test.ts",
    "test:api": "vitest run tests/api.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "1.132.0",
    "@tanstack/react-start": "1.132.0",
    "@vitejs/plugin-react": "5.0.4",
    "vite": "7.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "esbuild": "0.25.12",
    "playwright": "1.58.2",
    "typescript": "5.8.3",
    "vitest": "4.0.17"
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}
