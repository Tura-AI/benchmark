{
  "name": "powerprompt-marketplace",
  "private": true,
  "type": "module",
  "imports": {
    "#tanstack-start-server-fn-resolver": "./node_modules/@tanstack/start-server-core/dist/esm/fake-start-server-fn-resolver.js",
    "#tanstack-start-plugin-adapters": "./node_modules/@tanstack/start-server-core/dist/esm/empty-plugin-adapters.js"
  },
  "scripts": {
    "postinstall": "node scripts/patch-tanstack.mjs",
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "start": "node scripts/run.mjs start",
    "preview": "node scripts/run.mjs preview",
    "db:seed": "tsx scripts/seed.ts",
    "test": "npm run test:db && npm run test:api",
    "test:db": "vitest --config vitest.config.ts run tests/db.test.ts",
    "test:api": "vitest --config vitest.config.ts run tests/api.test.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.28",
    "better-sqlite3": "^12.2.0",
    "nitro": "^3.0.1-alpha.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "playwright": "^1.55.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
