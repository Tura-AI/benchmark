{
  "schema": "tura.benchmark.repository-task.v1",
  "id": "fixture-repository-task",
  "repository": {
    "path": "repo",
    "base_revision": "WORKTREE"
  },
  "commands": {
    "setup": ["node", "--version"],
    "baseline": ["node", "run.mjs"],
    "treatment": ["node", "run.mjs"]
  },
  "model": {
    "provider": "fixture",
    "id": "deterministic"
  },
  "output": {
    "format": "text"
  },
  "environment": {
    "required": [],
    "values": {
      "NO_COLOR": "1"
    }
  },
  "acceptance_criteria": ["output.txt is uppercase"],
  "validation": {
    "command": ["node", "validate.mjs"],
    "expected": {
      "exit_code": 0,
      "stdout_includes": "valid"
    }
  },
  "artifact_paths": ["output.txt"],
  "timeout_ms": 10000,
  "cleanup_policy": "preserve"
}
