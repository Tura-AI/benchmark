{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/harness-report.schema.json",
  "title": "Run harness report",
  "description": "One evaluated harness-report.json per run. Rule IDs join this report to task-harness.scoreItems.",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.harness-report.v2", "description": "Contract discriminator." },
    "id": { "type": "string", "minLength": 1, "description": "Report ID, normally derived from runId." },
    "runId": { "type": "string", "minLength": 1, "description": "Canonical run ID." },
    "taskId": { "type": "string", "minLength": 1, "description": "Task ID evaluated by the harness." },
    "agentId": { "type": "string", "minLength": 1, "description": "Public agent ID for the evaluated run." },
    "category": { "type": "string", "enum": ["build", "design", "debug", "rewrite"], "description": "Benchmark category." },
    "report": { "type": "string", "description": "Collection/report directory identifier." },
    "taskContractPath": { "type": "string", "description": "Repository-relative task.json path." },
    "harnessContractPath": { "type": "string", "description": "Repository-relative harness.json path." },
    "status": { "$ref": "common.schema.json#/$defs/runStatus", "description": "pass only when all required score items pass according to the task harness." },
    "score": { "$ref": "common.schema.json#/$defs/harnessScore" },
    "results": {
      "type": "array",
      "description": "One result per declared harness rule, in task contract order.",
      "items": {
        "allOf": [
          { "$ref": "common.schema.json#/$defs/harnessRule" },
          {
            "type": "object",
            "properties": {
              "status": { "$ref": "common.schema.json#/$defs/runStatus", "description": "Assertion-level pass/fail state." },
              "passed": { "type": "boolean", "description": "Boolean equivalent of status for programmatic consumers." },
              "failure": { "$ref": "common.schema.json#/$defs/harnessFailure" }
            },
            "required": ["status", "passed", "failure"]
          }
        ]
      }
    },
    "artifacts": {
      "type": "object",
      "description": "Relative paths to complete harness console evidence.",
      "properties": {
        "stdoutPath": { "type": ["string", "null"], "description": "Harness standard output path." },
        "stderrPath": { "type": ["string", "null"], "description": "Harness standard error path." },
        "harnessDirectory": { "type": ["string", "null"], "description": "Directory containing evaluator-native artifacts." }
      },
      "additionalProperties": true
    },
    "legacy": { "type": ["object", "null"], "description": "Preserved legacy scorer payload for audit only. New consumers use score and results.", "additionalProperties": true }
  },
  "required": ["schema", "id", "runId", "taskId", "agentId", "category", "status", "score", "results", "artifacts"],
  "additionalProperties": true
}
