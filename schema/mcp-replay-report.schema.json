{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/mcp-replay-report.schema.json",
  "title": "Deterministic MCP replay report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture",
    "scenario",
    "events",
    "answer",
    "metrics"
  ],
  "properties": {
    "schema_version": { "const": "tura.mcp-replay.report.v1" },
    "fixture": {
      "type": "object",
      "required": ["family", "seed", "sha256", "record_count", "page_size"],
      "properties": {
        "family": { "enum": ["github", "atlassian", "observability"] },
        "seed": { "type": "integer" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "record_count": { "type": "integer", "minimum": 1 },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "scenario": { "type": "object" },
    "events": { "type": "array", "items": { "type": "object" } },
    "answer": {},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "tool_calls",
        "turns",
        "cached_tokens",
        "uncached_tokens",
        "retries",
        "recovered_failures",
        "final_state"
      ],
      "properties": {
        "success": { "type": "boolean" },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "turns": { "type": "integer", "minimum": 0 },
        "cached_tokens": { "type": "integer", "minimum": 0 },
        "uncached_tokens": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "recovered_failures": { "type": "integer", "minimum": 0 },
        "final_state": { "type": "object" }
      }
    }
  }
}
