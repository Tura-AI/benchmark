{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/run-summary.schema.json",
  "title": "Normalized run summary",
  "description": "Compact metadata/summary.json contract used for run-level accounting and audit.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "tura.benchmark.normalized-summary.v1",
        "tura.business-test.summary.v1"
      ],
      "description": "Contract discriminator for either normalized per-run summary or archived runner suite summary."
    },
    "ok": {
      "type": "boolean",
      "description": "Legacy suite-summary overall completion state."
    },
    "in_progress": {
      "type": "boolean",
      "description": "Legacy suite-summary active-run state."
    },
    "reasoning": {
      "type": "string",
      "description": "Legacy suite-summary reasoning effort."
    },
    "agents": {
      "type": "array",
      "description": "Agent configurations included in the legacy suite execution.",
      "items": { "type": "string" }
    },
    "tasks": {
      "type": "array",
      "description": "Tasks included in the legacy suite execution.",
      "items": { "type": "string" }
    },
    "results": {
      "type": "array",
      "description": "Runner-native suite result records. Normalized per-run consumers should use benchmark-web-run and task-report instead.",
      "items": { "type": "object", "additionalProperties": true }
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical run ID: {task-abbreviation}-{agent-base}-run-{NN}."
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "description": "Task ID matching the task directory and task contract."
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "description": "Public agent ID including model and effort."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Real model used by the source run."
    },
    "effort": {
      "type": "string",
      "minLength": 1,
      "description": "Real reasoning effort used by the source run."
    },
    "sourceBatch": {
      "type": "string",
      "description": "Raw batch identifier used for provenance and deduplication."
    },
    "elapsedMs": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Measured run duration in milliseconds. Null when no reliable duration exists."
    },
    "exitCode": {
      "type": ["integer", "null"],
      "description": "Agent process exit code."
    },
    "usage": {
      "$ref": "common.schema.json#/$defs/tokenUsage",
      "description": "Run-total provider usage after deduplication."
    },
    "events": {
      "type": "object",
      "description": "Counts of normalized source events used to audit extraction completeness.",
      "additionalProperties": { "type": ["integer", "boolean"] }
    },
    "patch": {
      "type": "object",
      "description": "Produced git diff summary.",
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "UTF-8 byte length of git-diff.patch."
        },
        "changedFiles": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of files represented by the patch."
        }
      },
      "required": ["bytes", "changedFiles"],
      "additionalProperties": true
    }
  },
  "anyOf": [
    {
      "required": [
        "schema",
        "runId",
        "taskId",
        "agentId",
        "model",
        "effort",
        "usage"
      ]
    },
    {
      "properties": { "schema": { "const": "tura.business-test.summary.v1" } },
      "required": ["schema", "ok", "agents", "results"]
    }
  ],
  "additionalProperties": true
}
