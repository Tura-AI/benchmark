{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/deepswe-canonical-task-set.schema.json",
  "title": "Tura DeepSWE canonical task set",
  "description": "Pinned 20-task DeepSWE v1.1 comparison cohort shared by every agent and reasoning configuration.",
  "type": "object",
  "required": ["schema", "benchmark", "benchmark_version", "source", "tasks"],
  "properties": {
    "schema": {
      "const": "tura.benchmark.deep-swe-canonical-task-set.v1"
    },
    "benchmark": { "const": "datacurve-ai/deep-swe" },
    "benchmark_version": { "const": "v1.1" },
    "source": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["task_id", "language", "difficulty_band"],
        "properties": {
          "task_id": { "type": "string", "minLength": 1 },
          "language": {
            "enum": ["go", "python", "typescript", "rust", "javascript"]
          },
          "difficulty_band": {
            "enum": ["easy", "medium-easy", "medium-hard", "hard"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
