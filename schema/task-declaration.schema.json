{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/task-declaration.schema.json",
  "title": "Executable benchmark task declaration",
  "description": "benchmark.task.json format used by the benchmark runner to locate variants and executable harness code.",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.task-declaration.v1", "description": "Contract discriminator." },
    "id": { "type": "string", "minLength": 1, "description": "Stable task ID." },
    "type": { "type": "string", "enum": ["build", "design", "debug", "rewrite"], "description": "Execution category." },
    "title": { "type": "string", "minLength": 1, "description": "Human-readable declaration title." },
    "directory": { "type": "string", "description": "Repository-relative task directory." },
    "summary": { "type": "string", "description": "Short explanation of the benchmark objective." },
    "contract": {
      "type": "object",
      "description": "Schema identifiers emitted by this runner.",
      "properties": {
        "cliMetadata": { "type": "string", "description": "CLI metadata schema ID." },
        "round": { "type": "string", "description": "Agent round schema ID." },
        "taskReport": { "type": "string", "description": "Task report schema ID." },
        "harnessReport": { "type": "string", "description": "Harness report schema ID." }
      },
      "required": ["cliMetadata", "round", "taskReport", "harnessReport"],
      "additionalProperties": true
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "description": "Runnable task variants.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "Variant ID." },
          "label": { "type": "string", "description": "Human-readable variant label." },
          "runner": { "type": "string", "description": "Task-directory-relative runner path." },
          "default": { "type": "boolean", "description": "Whether this variant is selected when none is specified." }
        },
        "required": ["id", "label", "runner"],
        "additionalProperties": true
      }
    },
    "legacyScripts": { "type": "array", "description": "Historical runner paths retained only for migration traceability.", "items": { "type": "string" } },
    "duplicatePolicy": { "type": "string", "description": "Policy for duplicate run detection. none means every selected run must be independently sourced." }
  },
  "required": ["schema", "id", "type", "directory", "contract", "variants"],
  "additionalProperties": true
}
