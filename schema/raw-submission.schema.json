{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/raw-submission.schema.json",
  "title": "External raw-result intake manifest",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.raw-submission.v1" },
    "submission_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "state": { "enum": ["raw", "normalized", "verified", "published"] },
    "repository_revision": { "type": "string", "minLength": 1 },
    "commands": { "type": "array", "items": { "type": "string" } },
    "configuration": { "type": "object" },
    "logs": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "licensing_constraints": { "type": "string", "minLength": 1 },
    "contact": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "normalized_at": { "type": "string", "format": "date-time" },
    "verified_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": "string", "format": "date-time" },
    "source_evidence": { "type": "string" },
    "canonical_result_path": { "type": "string" },
    "validation": { "type": "object" }
  },
  "required": [
    "schema",
    "submission_id",
    "state",
    "repository_revision",
    "commands",
    "configuration",
    "logs",
    "artifacts",
    "licensing_constraints",
    "contact",
    "created_at"
  ],
  "additionalProperties": false
}
