{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/website-index.schema.json",
  "title": "Benchmark website index",
  "description": "CI-generated benchmarkCatalog.generated.json and public/benchmark-data/index.json. It contains lightweight task/agent/run summaries; large run and repository payloads remain in per-run files.",
  "type": "object",
  "$defs": {
    "runSummary": {
      "type": "object",
      "description": "Lightweight run row used by benchmark, task, and agent pages.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Canonical run ID and key for the detail file."
        },
        "taskId": { "type": "string", "description": "Task ID." },
        "agentId": { "type": "string", "description": "Public agent ID." },
        "sessionName": {
          "type": "string",
          "description": "Displayed run/session name."
        },
        "status": {
          "enum": ["pass", "fail", "complete"],
          "description": "Harness outcome for evaluated runs, or complete for Design artifacts."
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Rounded harness percentage for this run."
        },
        "harnessPassed": {
          "type": "integer",
          "minimum": 0,
          "description": "Passed harness assertions."
        },
        "harnessTotal": {
          "type": "integer",
          "minimum": 0,
          "description": "Total harness assertions."
        },
        "costUsd": {
          "type": "number",
          "minimum": 0,
          "description": "Run cost in USD."
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Run input token total."
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Run output token total."
        },
        "reasoningTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Reasoning subset of output tokens."
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Input plus output tokens without subset double-counting."
        },
        "turns": {
          "type": "integer",
          "minimum": 0,
          "description": "Normalized agent round count."
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "description": "Source run rank/group number when available."
        },
        "categoryId": {
          "type": "string",
          "description": "build, design, debug, or rewrite."
        },
        "reportId": {
          "type": "string",
          "description": "Source collection/report directory."
        },
        "artifactPath": {
          "type": "string",
          "description": "Benchmark-repository-relative run path."
        },
        "artifactUrl": {
          "type": "string",
          "description": "GitHub URL for the run artifacts."
        },
        "workspaceUrl": {
          "type": "string",
          "description": "GitHub URL for the run workspace."
        },
        "detailPath": {
          "type": "string",
          "description": "Public per-run JSON path loaded when the user opens the run."
        }
      },
      "required": [
        "id",
        "taskId",
        "agentId",
        "status",
        "costUsd",
        "totalTokens",
        "turns"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "categoryId": { "const": "design" } },
            "required": ["categoryId"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["score"] },
                { "required": ["harnessPassed"] },
                { "required": ["harnessTotal"] }
              ]
            }
          },
          "else": { "required": ["score", "harnessPassed", "harnessTotal"] }
        }
      ],
      "additionalProperties": true
    }
  },
  "properties": {
    "schema": {
      "const": "tura.website.benchmark.index.v1",
      "description": "Website index discriminator."
    },
    "source": {
      "type": "object",
      "description": "Benchmark repository/ref synchronized by CI.",
      "properties": {
        "owner": { "type": "string", "description": "GitHub owner." },
        "repo": { "type": "string", "description": "GitHub repository." },
        "ref": {
          "type": "string",
          "description": "Branch, tag, or commit used by this build."
        },
        "url": { "type": "string", "description": "Repository URL." }
      },
      "required": ["owner", "repo", "ref", "url"],
      "additionalProperties": false
    },
    "agents": {
      "type": "array",
      "description": "Agent list dynamically derived from run metadata. CI must not hard-code these entries.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Public agent ID." },
          "name": { "type": "string", "description": "Display name." },
          "modelId": { "type": "string", "description": "Normalized model." },
          "provider": {
            "type": "string",
            "description": "Agent provider family."
          },
          "profile": {
            "type": "string",
            "description": "Mode/effort profile shown by the website."
          },
          "version": {
            "type": "string",
            "description": "Observed agent CLI version."
          },
          "runtime": { "$ref": "common.schema.json#/$defs/agentRuntime" },
          "system": { "$ref": "common.schema.json#/$defs/systemMetadata" },
          "environment": {
            "$ref": "common.schema.json#/$defs/environmentMetadata"
          }
        },
        "required": ["id", "name", "modelId", "provider", "profile", "version"],
        "additionalProperties": true
      }
    },
    "tasks": {
      "type": "array",
      "description": "All synchronized tasks across benchmark categories.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Task ID." },
          "title": { "type": "string", "description": "Task title." },
          "categoryId": {
            "type": "string",
            "enum": ["build", "design", "debug", "rewrite"],
            "description": "Category/tab ID."
          },
          "categoryLabel": {
            "type": "string",
            "description": "Human-readable category."
          },
          "sourceUrl": {
            "type": "string",
            "description": "GitHub task artifact URL."
          },
          "repo": {
            "type": "string",
            "description": "Source repository name."
          },
          "base": { "type": "string", "description": "Source commit/tag/ref." },
          "description": {
            "type": "string",
            "description": "Task summary derived from real metadata."
          },
          "prompt": {
            "type": "string",
            "description": "Complete task-starting prompt."
          },
          "verifierPatch": {
            "type": "string",
            "description": "Verifier artifact status/label."
          },
          "solutionPatch": {
            "type": "string",
            "description": "Available run/solution summary."
          },
          "harnessRules": {
            "type": "array",
            "description": "Task-level harness rules.",
            "items": { "$ref": "common.schema.json#/$defs/harnessRule" }
          },
          "repositories": {
            "type": "array",
            "description": "Source, benchmark artifact, and task-definition repository links.",
            "items": { "type": "object", "additionalProperties": true }
          },
          "metadata": {
            "type": "object",
            "description": "Task provenance and contract paths.",
            "additionalProperties": true
          },
          "results": {
            "type": "array",
            "description": "Per-agent aggregates and the underlying run summaries.",
            "items": {
              "type": "object",
              "properties": {
                "agentId": {
                  "type": "string",
                  "description": "Agent represented by this result row."
                },
                "passed": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of passing runs."
                },
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of runs."
                },
                "score": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Average harness score across this agent's runs for the task."
                },
                "bestRunId": {
                  "type": "string",
                  "description": "Highest-scoring run ID. Task-page Best agent is computed dynamically from run scores."
                },
                "runs": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/runSummary" },
                  "description": "All real runs for the agent/task pair."
                }
              },
              "required": ["agentId", "bestRunId", "runs"],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "runs": {
                        "contains": {
                          "properties": { "categoryId": { "const": "design" } },
                          "required": ["categoryId"]
                        }
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "anyOf": [
                        { "required": ["passed"] },
                        { "required": ["total"] },
                        { "required": ["score"] }
                      ]
                    }
                  },
                  "else": { "required": ["passed", "total", "score"] }
                }
              ],
              "additionalProperties": true
            }
          }
        },
        "required": ["id", "title", "categoryId", "prompt", "results"],
        "allOf": [
          {
            "if": { "properties": { "categoryId": { "const": "design" } } },
            "then": { "not": { "required": ["harnessRules"] } },
            "else": { "required": ["harnessRules"] }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "required": ["schema", "source", "agents", "tasks"],
  "additionalProperties": false
}
