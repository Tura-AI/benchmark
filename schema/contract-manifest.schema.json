{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/contract-manifest.schema.json",
  "title": "Run contract manifest",
  "description": "Manifest of normalized files belonging to one run. Paths are relative to the run directory or benchmark root as documented by the producer.",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.contract-manifest.v1", "description": "Contract discriminator." },
    "runId": { "type": "string", "minLength": 1, "description": "Canonical run ID shared by every file in the manifest." },
    "files": {
      "type": "object",
      "description": "Authoritative artifact paths.",
      "properties": {
        "run": { "type": "string", "description": "benchmark-web-run.json path." },
        "taskReport": { "type": "string", "description": "task-report.json path." },
        "agentRounds": { "type": "string", "description": "agent-rounds.jsonl path." },
        "rounds": { "type": "array", "description": "Ordered per-round JSON paths.", "items": { "type": "string" } },
        "cliMetadata": { "type": "string", "description": "cli-metadata.json path." },
        "harnessReport": { "type": "string", "description": "harness-report.json path." },
        "taskContract": { "type": "string", "description": "Task-level task.json path." },
        "harnessContract": { "type": "string", "description": "Task-level harness.json path." },
        "gitDiff": { "type": "string", "description": "git-diff.patch path when listed separately." }
      },
      "required": ["run", "taskReport", "agentRounds", "rounds", "cliMetadata", "harnessReport"],
      "additionalProperties": true
    },
    "naming": {
      "type": "object",
      "description": "Human-readable naming templates enforced by the normalizer.",
      "properties": {
        "runDirectory": { "type": "string", "description": "Template for run directory names." },
        "roundFile": { "type": "string", "description": "Template for per-round file names." }
      },
      "required": ["runDirectory", "roundFile"],
      "additionalProperties": true
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Published consolidated-manifest form listing normalized contract file names.",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": ["schema", "runId"],
  "oneOf": [
    { "required": ["files", "naming"] },
    { "required": ["contracts"] }
  ],
  "additionalProperties": true
}
