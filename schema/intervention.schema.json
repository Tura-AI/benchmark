{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/intervention.schema.json",
  "title": "Same-agent intervention contract",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.intervention.v1" },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "revision": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "enum": ["context", "skill"] },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 }
        },
        "required": ["kind", "source", "target"],
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "setup_command": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "wrapper": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "required": ["schema", "name", "revision", "files"],
  "additionalProperties": false
}
