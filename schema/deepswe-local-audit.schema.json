{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/deepswe-local-audit.schema.json",
  "title": "Tura DeepSWE local normalization audit",
  "description": "Top-level cardinality and provenance receipt emitted after normalizing the completed 20-task, 3-agent, 2-replicate local matrix.",
  "type": "object",
  "required": [
    "schema",
    "source",
    "taskCount",
    "agentCount",
    "replicateCount",
    "runCount",
    "reports",
    "generatedAt"
  ],
  "properties": {
    "schema": {
      "const": "tura.benchmark.deepswe-local-normalization-audit.v1"
    },
    "source": { "type": "string", "minLength": 1 },
    "taskCount": { "type": "integer", "const": 20 },
    "agentCount": { "type": "integer", "const": 3 },
    "replicateCount": { "type": "integer", "const": 3 },
    "runCount": { "type": "integer", "const": 180 },
    "reports": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["report", "runs"],
        "properties": {
          "report": {
            "type": "string",
            "pattern": "^report-deepswe-v1\\.1-gpt56-sol-local-r[0-9]{2}$"
          },
          "runs": { "type": "integer", "const": 60 }
        },
        "additionalProperties": false
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
