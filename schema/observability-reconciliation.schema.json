{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/observability-reconciliation.schema.json",
  "title": "Observability usage reconciliation report",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "adapter",
    "execution_modified",
    "claims_execution_savings",
    "attempts",
    "coverage",
    "event_quality",
    "overhead",
    "recovery",
    "accounting_accurate"
  ],
  "properties": {
    "schema_version": { "const": "tura.observability-reconciliation.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "adapter": { "type": "string", "minLength": 1 },
    "execution_modified": { "const": false },
    "claims_execution_savings": { "const": false },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "attempt_id",
          "provider",
          "agent",
          "observability",
          "differences",
          "retry",
          "partial_failure"
        ]
      }
    },
    "coverage": { "type": "object" },
    "event_quality": { "type": "object" },
    "overhead": { "type": "object" },
    "recovery": { "type": "object" },
    "accounting_accurate": { "type": "boolean" }
  },
  "additionalProperties": false
}
