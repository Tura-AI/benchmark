{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/result-envelope.schema.json",
  "title": "Versioned result envelope",
  "type": "object",
  "properties": {
    "schema_version": { "enum": ["1.0.0", "2.0.0"] },
    "source_schema_version": { "type": "string", "minLength": 1 },
    "migration_revision": { "const": "result-schema-migration-v1" },
    "migration": {
      "type": "object",
      "properties": {
        "tool_revision": { "const": "result-schema-migration-v1" },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "target_schema_version": { "enum": ["1.0.0", "2.0.0"] }
      },
      "required": ["tool_revision", "source_sha256", "target_schema_version"]
    },
    "field_provenance": {
      "type": "object",
      "additionalProperties": { "enum": ["observed", "normalized"] }
    }
  },
  "required": ["schema_version"],
  "additionalProperties": true
}
