{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/batch-summary.schema.json",
  "title": "Benchmark batch execution summary",
  "type": "object",
  "required": [
    "schema",
    "status",
    "total",
    "completed",
    "passed",
    "failed",
    "not_started",
    "failures_by_stage",
    "fatal_failure",
    "attempts",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "schema": { "const": "tura.benchmark.batch-summary.v1" },
    "status": {
      "enum": ["running", "passed", "completed-with-failures", "fatal"]
    },
    "total": { "type": "integer", "minimum": 0 },
    "completed": { "type": "integer", "minimum": 0 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "not_started": { "type": "integer", "minimum": 0 },
    "failures_by_stage": {
      "type": "object",
      "required": [
        "setup",
        "execution",
        "evaluation",
        "validation",
        "publication"
      ],
      "properties": {
        "setup": { "type": "integer", "minimum": 0 },
        "execution": { "type": "integer", "minimum": 0 },
        "evaluation": { "type": "integer", "minimum": 0 },
        "validation": { "type": "integer", "minimum": 0 },
        "publication": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "fatal_failure": { "type": ["object", "null"] },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "status",
          "fatal",
          "started_at",
          "finished_at",
          "job"
        ],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["passed", "failed"] },
          "failure_class": {
            "type": ["string", "null"],
            "enum": [
              "setup",
              "execution",
              "evaluation",
              "validation",
              "publication",
              null
            ]
          },
          "fatal": { "type": "boolean" },
          "error": { "type": "string" },
          "artifacts": { "type": ["object", "null"] },
          "result": {},
          "started_at": { "type": "string", "format": "date-time" },
          "finished_at": { "type": "string", "format": "date-time" },
          "job": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
