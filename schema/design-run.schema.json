{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/design-run.schema.json",
  "title": "Design benchmark run",
  "description": "Canonical metadata/contracts/design-run.json for one completed interactive Design run. It contains real usage, rounds, commands, HTML entry and grouped metadata; harness fields are forbidden.",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.design-run.v1" },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical {task}-{agent}-design-run-{NN} ID."
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "description": "Owning Design task ID."
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical public agent configuration ID."
    },
    "shortId": {
      "type": "string",
      "pattern": "^r-[0-9]{2,}$",
      "description": "Task/agent-local website label such as r-01."
    },
    "category": { "const": "design" },
    "status": {
      "const": "complete",
      "description": "Artifact completed successfully; this is not a harness pass result."
    },
    "prompt": {
      "type": "object",
      "properties": {
        "role": { "const": "user" },
        "format": { "const": "markdown" },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Complete untruncated starting prompt."
        }
      },
      "required": ["role", "format", "text"],
      "additionalProperties": false
    },
    "htmlEntry": {
      "const": "index.html",
      "description": "Fixed workspace-relative interactive entry point."
    },
    "source": {
      "type": "object",
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "steps": { "type": "integer", "minimum": 0 },
        "commands": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "cachedInputTokens": { "type": "integer", "minimum": 0 },
        "uncachedInputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "reasoningTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "cachedInputCostUsd": { "type": "number", "minimum": 0 },
        "uncachedInputCostUsd": { "type": "number", "minimum": 0 },
        "outputCostUsd": { "type": "number", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 }
      },
      "required": [
        "model",
        "steps",
        "commands",
        "inputTokens",
        "cachedInputTokens",
        "uncachedInputTokens",
        "outputTokens",
        "reasoningTokens",
        "totalTokens",
        "cachedInputCostUsd",
        "uncachedInputCostUsd",
        "outputCostUsd",
        "costUsd"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "const": "complete" },
        "agent": { "type": "string" },
        "provider": { "type": "string" },
        "mode": { "type": "string" },
        "turns": { "type": "integer", "minimum": 0 },
        "commands": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "id",
        "status",
        "agent",
        "provider",
        "mode",
        "turns",
        "commands"
      ],
      "additionalProperties": false
    },
    "rounds": {
      "type": "array",
      "items": { "$ref": "agent-round.schema.json" },
      "description": "All reconstructed rounds in source order. Command-only rounds are valid."
    },
    "metadata": {
      "type": "object",
      "properties": {
        "common": { "type": "object", "additionalProperties": true },
        "agent": { "$ref": "common.schema.json#/$defs/agentMetadata" },
        "system": { "$ref": "common.schema.json#/$defs/systemMetadata" },
        "environment": {
          "$ref": "common.schema.json#/$defs/environmentMetadata"
        },
        "custom": { "type": "object", "additionalProperties": true }
      },
      "required": ["common", "agent", "system", "environment", "custom"],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "workspace": { "const": "workspace" },
        "repoBrowser": { "type": "string", "minLength": 1 }
      },
      "required": ["workspace", "repoBrowser"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "task",
    "agent",
    "shortId",
    "category",
    "status",
    "prompt",
    "htmlEntry",
    "source",
    "run",
    "rounds",
    "metadata",
    "artifacts"
  ],
  "not": {
    "anyOf": [
      { "required": ["harness"] },
      { "required": ["harnessPassed"] },
      { "required": ["harnessTotal"] },
      { "required": ["score"] }
    ]
  },
  "additionalProperties": false
}
