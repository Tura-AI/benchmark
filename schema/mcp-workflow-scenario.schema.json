{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/mcp-workflow-scenario.schema.json",
  "title": "Deterministic stateful MCP workflow scenario",
  "type": "object",
  "required": [
    "schema",
    "id",
    "serverName",
    "services",
    "evaluation",
    "initialState",
    "steps",
    "expectedState",
    "selfTest"
  ],
  "properties": {
    "schema": { "const": "tura.benchmark.mcp-workflow-scenario.v2" },
    "id": { "type": "string", "minLength": 1 },
    "serverName": { "type": "string", "minLength": 1 },
    "services": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evaluation": {
      "type": "object",
      "required": ["mode", "llmJudge", "humanReview", "checks"],
      "properties": {
        "mode": { "const": "deterministic-script" },
        "llmJudge": { "const": false },
        "humanReview": { "const": false },
        "checks": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "critical-argument-assertions",
              "dependency-order",
              "recovered-tool-errors-allowed",
              "exact-final-state"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "initialState": { "type": "object" },
    "steps": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "stepId",
          "intent",
          "tool",
          "description",
          "expectedArguments",
          "argumentAssertions",
          "inputSchema",
          "outputSchema",
          "responseMode",
          "annotations",
          "contract",
          "argumentNormalization",
          "result",
          "effects",
          "requires"
        ],
        "properties": {
          "stepId": { "type": "string", "pattern": "^step-[0-9]{2}$" },
          "intent": { "type": "string", "minLength": 1 },
          "tool": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "expectedArguments": { "type": "object" },
          "argumentAssertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "operator"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "operator": {
                  "enum": [
                    "normalized-equals",
                    "instant-equals",
                    "set-equals",
                    "contains-all"
                  ]
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "operator": { "const": "contains-all" } }
                  },
                  "then": { "required": ["values"] },
                  "else": {
                    "not": { "required": ["values"] }
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "inputSchema": {
            "type": "object",
            "required": ["type", "properties", "required"],
            "properties": { "type": { "const": "object" } },
            "additionalProperties": true
          },
          "outputSchema": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "properties", "required"],
                "properties": { "type": { "const": "object" } },
                "additionalProperties": true
              },
              { "type": "null" }
            ]
          },
          "responseMode": {
            "enum": ["structured-json", "text-only"]
          },
          "annotations": {
            "type": "object",
            "properties": {
              "readOnlyHint": { "type": "boolean" },
              "destructiveHint": { "type": "boolean" },
              "idempotentHint": { "type": "boolean" },
              "openWorldHint": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "contract": {
            "type": "object",
            "required": [
              "provider",
              "fidelity",
              "source",
              "revision",
              "transport",
              "authentication",
              "responseMode"
            ],
            "properties": {
              "provider": { "type": "string", "minLength": 1 },
              "fidelity": {
                "enum": ["official-mcp", "vendor-api-adapter"]
              },
              "source": { "type": "string", "format": "uri" },
              "revision": { "type": "string", "format": "date" },
              "transport": { "type": "string", "minLength": 1 },
              "authentication": { "type": "string", "minLength": 1 },
              "responseMode": {
                "enum": ["structured-json", "text-only"]
              }
            },
            "additionalProperties": false
          },
          "argumentNormalization": {
            "type": "object",
            "additionalProperties": {
              "enum": ["lowercase", "trim"]
            }
          },
          "result": { "type": ["object", "string"] },
          "effects": {
            "type": "object",
            "properties": {
              "set": { "type": "object" },
              "append": { "type": "object" }
            },
            "additionalProperties": false
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "expectedState": {
      "type": "object",
      "minProperties": 2
    },
    "selfTest": {
      "type": "object",
      "required": ["calls"],
      "properties": {
        "calls": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["name", "arguments"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "arguments": { "type": "object" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
