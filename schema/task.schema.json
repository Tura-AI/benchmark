{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/task.schema.json",
  "title": "Benchmark task contract",
  "description": "Canonical task.json format. It describes the immutable task, source, target, harness rules, and contract versions independently from any run.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["tura.benchmark.task.v1", "tura.benchmark.task-contract.v1"],
      "description": "Contract discriminator. task-contract.v1 is the normalized debug form; task.v1 is the full task definition used by rewrite tasks."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable task ID and task directory name."
    },
    "category": {
      "type": "string",
      "enum": ["build", "design", "debug", "mcp", "rewrite"],
      "description": "Benchmark tab/category. A task appears only in its matching tab."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable task title."
    },
    "description": {
      "type": "string",
      "description": "Concrete task objective and scope, not website marketing text."
    },
    "type": {
      "type": "string",
      "enum": ["build", "design", "debug", "mcp", "rewrite"],
      "description": "Category field used by task-contract.v1."
    },
    "name": {
      "type": "string",
      "description": "Stable task name used by task-contract.v1."
    },
    "repository": {
      "type": "object",
      "description": "Source repository URL, commit, and project version in task-contract.v1.",
      "additionalProperties": true
    },
    "sourceLocation": {
      "$ref": "common.schema.json#/$defs/codeLocation",
      "description": "Source workspace location in task-contract.v1."
    },
    "harnessCodeLocation": {
      "$ref": "common.schema.json#/$defs/codeLocation",
      "description": "Evaluator entry point in task-contract.v1."
    },
    "promptLocation": {
      "type": "string",
      "description": "Run-relative location of the task-starting prompt."
    },
    "evaluation": {
      "type": "object",
      "description": "Evaluation policy for the task. Design tasks are reviewed from their artifacts and do not define a harness.",
      "properties": {
        "mode": { "type": "string", "enum": ["design", "harness"] }
      },
      "required": ["mode"],
      "additionalProperties": false
    },
    "model": {
      "type": "string",
      "description": "Model family expected by this normalized collection."
    },
    "effort": {
      "type": "string",
      "description": "Reasoning effort expected by this normalized collection."
    },
    "contract": {
      "type": "object",
      "description": "Output contract IDs used by task-contract.v1.",
      "additionalProperties": { "type": "string" }
    },
    "source": {
      "type": "object",
      "description": "Starting repository/source state supplied to every run.",
      "properties": {
        "language": {
          "type": "string",
          "description": "Primary source language or artifact type."
        },
        "repository": {
          "type": "string",
          "description": "Canonical upstream or benchmark repository URL."
        },
        "commit": {
          "type": ["string", "null"],
          "description": "Exact source commit or stable ref."
        },
        "tag": {
          "type": ["string", "null"],
          "description": "Source tag/report identifier when used."
        },
        "codePath": {
          "type": "string",
          "description": "Repository-relative source path the agent is expected to modify or rebuild."
        }
      },
      "required": ["language", "repository", "codePath"],
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "description": "Expected implementation target.",
      "properties": {
        "language": {
          "type": "string",
          "description": "Target language/framework/toolchain."
        },
        "deliverable": {
          "type": "string",
          "description": "Observable artifact the agent must leave in workspace."
        }
      },
      "required": ["language", "deliverable"],
      "additionalProperties": true
    },
    "taskDeclaration": {
      "type": "object",
      "description": "Pointer to benchmark.task.json, which controls execution variants and runner selection.",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Repository containing the declaration."
        },
        "path": {
          "type": "string",
          "description": "Repository-relative declaration path."
        },
        "localPath": {
          "type": ["string", "null"],
          "description": "Optional developer-local path; never required by CI or the website."
        }
      },
      "required": ["repository", "path"],
      "additionalProperties": true
    },
    "harness": {
      "$ref": "task-harness.schema.json",
      "description": "Embedded task harness contract. A standalone harness.json with the same content is also supported."
    },
    "contracts": {
      "type": "object",
      "description": "Schema IDs expected for run artifacts produced by this task.",
      "properties": {
        "run": { "type": "string", "description": "Run contract ID." },
        "round": { "type": "string", "description": "Per-round contract ID." },
        "taskReport": {
          "type": "string",
          "description": "Task-report contract ID."
        },
        "harnessReport": {
          "type": "string",
          "description": "Harness-report contract ID."
        }
      },
      "additionalProperties": true
    },
    "mcp": {
      "type": "object",
      "description": "MCP transport and schema-discovery contract for MCP-category tasks.",
      "properties": {
        "server": { "type": "string", "minLength": 1 },
        "transport": { "const": "stdio" },
        "entrypoint": { "type": "string", "minLength": 1 },
        "schemaDiscovery": { "const": "tools/list" },
        "traceArtifact": { "type": "string", "minLength": 1 },
        "adapters": {
          "type": "object",
          "description": "Task-local native configuration material for supported MCP agent clients.",
          "properties": {
            "manifest": { "type": "string", "minLength": 1 },
            "codex": { "type": "string", "minLength": 1 },
            "turaCommand": { "type": "string", "minLength": 1 }
          },
          "required": ["manifest", "codex", "turaCommand"],
          "additionalProperties": false
        }
      },
      "required": [
        "server",
        "transport",
        "entrypoint",
        "schemaDiscovery",
        "traceArtifact",
        "adapters"
      ],
      "additionalProperties": true
    }
  },
  "required": ["schema", "id", "title", "description"],
  "allOf": [
    {
      "if": {
        "properties": { "schema": { "const": "tura.benchmark.task.v1" } }
      },
      "then": {
        "required": ["category", "source", "target"],
        "allOf": [
          {
            "if": {
              "required": ["evaluation"],
              "properties": {
                "evaluation": {
                  "properties": { "mode": { "const": "design" } }
                }
              }
            },
            "then": { "not": { "required": ["harness"] } },
            "else": { "required": ["harness"] }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema": { "const": "tura.benchmark.task-contract.v1" }
        }
      },
      "then": {
        "required": [
          "type",
          "name",
          "repository",
          "sourceLocation",
          "harnessCodeLocation",
          "promptLocation",
          "contract"
        ]
      }
    },
    {
      "if": {
        "properties": { "category": { "const": "mcp" } },
        "required": ["category"]
      },
      "then": { "required": ["mcp", "taskDeclaration", "contracts"] }
    }
  ],
  "additionalProperties": true
}
