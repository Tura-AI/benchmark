{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "tura.benchmark.schema-index.v1",
  "description": "Machine-readable index of benchmark data contracts used by Tura benchmark runners and the website CI pipeline.",
  "contracts": [
    {
      "id": "common",
      "file": "common.schema.json",
      "artifact": "shared definitions",
      "layer": "shared"
    },
    {
      "id": "agent-metadata",
      "file": "agent-metadata.schema.json",
      "artifact": "metadata.agent",
      "layer": "normalized"
    },
    {
      "id": "cli-metadata",
      "file": "cli-metadata.schema.json",
      "artifact": "metadata/contracts/cli-metadata.json",
      "layer": "normalized"
    },
    {
      "id": "agent-round",
      "file": "agent-round.schema.json",
      "artifact": "metadata/contracts/agent-rounds.jsonl and metadata/contracts/rounds/*.json",
      "layer": "normalized"
    },
    {
      "id": "run-summary",
      "file": "run-summary.schema.json",
      "artifact": "metadata/summary.json",
      "layer": "normalized"
    },
    {
      "id": "task",
      "file": "task.schema.json",
      "artifact": "tasks/{category}/{task}/task.json",
      "layer": "normalized"
    },
    {
      "id": "design-task",
      "file": "design-task.schema.json",
      "artifact": "results/design/{task}/design-task.json",
      "layer": "normalized"
    },
    {
      "id": "design-run",
      "file": "design-run.schema.json",
      "artifact": "results/design/{task}/{report}/{agent}/metadata/contracts/design-run.json",
      "layer": "normalized"
    },
    {
      "id": "task-declaration",
      "file": "task-declaration.schema.json",
      "artifact": "tasks/{category}/{task}/benchmark.task.json",
      "layer": "execution"
    },
    {
      "id": "task-harness",
      "file": "task-harness.schema.json",
      "artifact": "tasks/{category}/{task}/harness.json",
      "layer": "normalized"
    },
    {
      "id": "harness-report",
      "file": "harness-report.schema.json",
      "artifact": "metadata/contracts/harness-report.json",
      "layer": "normalized"
    },
    {
      "id": "task-report",
      "file": "task-report.schema.json",
      "artifact": "metadata/contracts/task-report.json",
      "layer": "normalized"
    },
    {
      "id": "benchmark-web-run",
      "file": "benchmark-web-run.schema.json",
      "artifact": "metadata/contracts/benchmark-web-run.json",
      "layer": "normalized"
    },
    {
      "id": "contract-manifest",
      "file": "contract-manifest.schema.json",
      "artifact": "metadata/contracts/contract-manifest.json",
      "layer": "normalized"
    },
    {
      "id": "changed-workspace",
      "file": "changed-workspace.schema.json",
      "artifact": "workspace/.benchmark-workspace.json and metadata/workspace-recovery.json",
      "layer": "normalized"
    },
    {
      "id": "deepswe-official-batch",
      "file": "deepswe-official-batch.schema.json",
      "artifact": "results/debug/report-deepswe-v1.1-gpt56-sol-*/manifest.json",
      "layer": "normalized"
    },
    {
      "id": "deepswe-import-audit",
      "file": "deepswe-import-audit.schema.json",
      "artifact": "results/debug/deepswe-v1.1-gpt56-sol-import-audit.json",
      "layer": "normalized"
    },
    {
      "id": "deepswe-local-batch",
      "file": "deepswe-local-batch.schema.json",
      "artifact": "results/debug/report-deepswe-v1.1-gpt56-sol-local-r*/manifest.json",
      "layer": "normalized"
    },
    {
      "id": "deepswe-local-audit",
      "file": "deepswe-local-audit.schema.json",
      "artifact": "results/debug/deepswe-v1.1-gpt56-sol-local-audit.json",
      "layer": "normalized"
    },
    {
      "id": "raw-agent-summary",
      "file": "raw-agent-summary.schema.json",
      "artifact": "raw/**/agent-summary.json",
      "layer": "source"
    },
    {
      "id": "raw-agent-event",
      "file": "raw-agent-event.schema.json",
      "artifact": "agent.stdout.jsonl",
      "layer": "source"
    },
    {
      "id": "provider-call",
      "file": "provider-call.schema.json",
      "artifact": "provider-calls-full.jsonl",
      "layer": "source"
    },
    {
      "id": "website-index",
      "file": "website-index.schema.json",
      "artifact": "benchmarkCatalog.generated.json and public/benchmark-data/index.json",
      "layer": "website"
    },
    {
      "id": "website-run-detail",
      "file": "website-run-detail.schema.json",
      "artifact": "public/benchmark-data/runs/{runId}.json",
      "layer": "website"
    },
    {
      "id": "repo-browser",
      "file": "repo-browser.schema.json",
      "artifact": "public/benchmark-data/repos/{runId}.json",
      "layer": "website"
    }
  ]
}
