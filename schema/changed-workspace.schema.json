{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/changed-workspace.schema.json",
  "title": "Changed-files workspace snapshot",
  "description": "A sparse, patch-derived workspace containing every added or modified output file and an explicit list of deletions.",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.changed-workspace.v1" },
    "layout": { "const": "changed-files" },
    "completeRepository": { "const": false },
    "patchSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "included": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "deleted": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "taskId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "sourceBatch": { "type": "string", "minLength": 1 },
    "sourceRun": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "baseCommit": { "type": "string", "minLength": 1 },
    "baselineTree": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "recoverySource": { "type": "string", "minLength": 1 },
    "diffVerifiedByteForByte": { "type": "boolean" },
    "workspace": { "type": "string", "minLength": 1 },
    "gitDiff": { "type": "string", "minLength": 1 }
  },
  "required": [
    "schema",
    "layout",
    "completeRepository",
    "patchSha256",
    "included",
    "deleted"
  ],
  "additionalProperties": true
}
