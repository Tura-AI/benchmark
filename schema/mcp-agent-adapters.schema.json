{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/mcp-agent-adapters.schema.json",
  "title": "MCP task agent adapters",
  "description": "One task-local MCP server definition rendered into native Codex MCP configuration and Tura external-command registration formats.",
  "type": "object",
  "required": ["schema", "taskId", "server", "adapters"],
  "properties": {
    "schema": { "const": "tura.benchmark.mcp-agent-adapters.v1" },
    "taskId": { "type": "string", "minLength": 1 },
    "server": {
      "type": "object",
      "required": ["name", "transport", "command", "args", "schemaDiscovery"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "transport": { "const": "stdio" },
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "schemaDiscovery": { "const": "tools/list" },
        "tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "contracts": {
          "type": "array",
          "description": "Versioned provenance and fidelity declaration for each exposed tool contract.",
          "items": {
            "type": "object",
            "required": [
              "tool",
              "provider",
              "fidelity",
              "source",
              "revision",
              "transport",
              "authentication",
              "responseMode"
            ],
            "properties": {
              "tool": { "type": "string", "minLength": 1 },
              "provider": { "type": "string", "minLength": 1 },
              "fidelity": {
                "enum": ["official-mcp", "vendor-api-adapter"]
              },
              "source": { "type": "string", "format": "uri" },
              "revision": { "type": "string", "format": "date" },
              "transport": { "type": "string", "minLength": 1 },
              "authentication": { "type": "string", "minLength": 1 },
              "responseMode": {
                "enum": ["structured-json", "text-only"]
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "required": ["codex", "turaCommand"],
      "properties": {
        "codex": {
          "type": "object",
          "required": ["format", "configTemplate", "settings"],
          "properties": {
            "format": { "const": "codex.mcp-stdio.toml.v1" },
            "configTemplate": { "type": "string", "minLength": 1 },
            "settings": {
              "type": "object",
              "required": [
                "required",
                "defaultToolsApprovalMode",
                "startupTimeoutSec",
                "toolTimeoutSec"
              ],
              "properties": {
                "required": { "type": "boolean" },
                "defaultToolsApprovalMode": { "type": "string" },
                "startupTimeoutSec": { "type": "integer", "minimum": 1 },
                "toolTimeoutSec": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "turaCommand": {
          "type": "object",
          "required": [
            "format",
            "commandId",
            "packageDirectory",
            "bridgeDescriptor",
            "agentCapability"
          ],
          "properties": {
            "format": { "const": "tura.external-command.v1" },
            "commandId": { "const": "mcp_workspace" },
            "packageDirectory": { "type": "string", "minLength": 1 },
            "bridgeDescriptor": { "type": "string", "minLength": 1 },
            "agentCapability": {
              "type": "object",
              "required": ["capability_name"],
              "properties": {
                "capability_name": { "const": "mcp_workspace" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
