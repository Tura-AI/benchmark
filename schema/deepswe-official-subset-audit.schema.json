{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/deepswe-official-subset-audit.schema.json",
  "title": "Official DeepSWE subset import audit",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.deepswe-official-subset-audit.v1" },
    "benchmark": { "const": "datacurve-ai/deep-swe" },
    "benchmarkVersion": { "const": "v1.1" },
    "model": { "const": "gpt-5.6-sol" },
    "agent": { "const": "mini-swe-agent" },
    "agentVersion": { "type": ["string", "null"] },
    "taskIds": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "efforts": { "const": ["high", "medium"] },
    "replicates": { "const": 4 },
    "taskCount": { "const": 20 },
    "runCount": { "const": 160 },
    "reportCount": { "const": 8 },
    "trialsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "detailedArtifactImported": { "type": "integer", "minimum": 0 },
    "summaryOnlyRuns": { "type": "integer", "minimum": 0 },
    "aggregates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "effort": { "enum": ["high", "medium"] },
          "runs": { "type": "integer", "minimum": 1 },
          "passes": { "type": "integer", "minimum": 0 },
          "inputTokens": { "type": "integer", "minimum": 0 },
          "cacheInputTokens": { "type": "integer", "minimum": 0 },
          "outputTokens": { "type": "integer", "minimum": 0 },
          "totalTokens": { "type": "integer", "minimum": 0 },
          "costUsd": { "type": "number", "minimum": 0 },
          "agentSteps": { "type": "integer", "minimum": 0 }
        },
        "required": [
          "effort",
          "runs",
          "passes",
          "inputTokens",
          "cacheInputTokens",
          "outputTokens",
          "totalTokens",
          "costUsd",
          "agentSteps"
        ],
        "additionalProperties": false
      }
    },
    "reports": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "report": { "type": "string", "minLength": 1 },
          "effort": { "enum": ["high", "medium"] },
          "replicate": { "type": "integer", "minimum": 1, "maximum": 4 },
          "runs": { "const": 20 }
        },
        "required": ["report", "effort", "replicate", "runs"],
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "note": { "type": "string" }
  },
  "required": [
    "schema",
    "benchmark",
    "benchmarkVersion",
    "model",
    "agent",
    "agentVersion",
    "taskIds",
    "efforts",
    "replicates",
    "taskCount",
    "runCount",
    "reportCount",
    "trialsSha256",
    "detailedArtifactImported",
    "summaryOnlyRuns",
    "aggregates",
    "reports",
    "source",
    "note"
  ],
  "additionalProperties": false
}
