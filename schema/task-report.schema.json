{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/task-report.schema.json",
  "title": "Run task report",
  "description": "Complete task-report.json for one run. It links run totals, patch evidence, repository snapshot, and normalized rounds.",
  "type": "object",
  "$defs": {
    "compactRound": {
      "type": "object",
      "description": "Compact round reference used by older task reports; full content remains in agent-rounds.jsonl.",
      "properties": {
        "id": { "type": "string", "description": "Round ID." },
        "index": {
          "type": "integer",
          "minimum": 1,
          "description": "One-based round index."
        },
        "usage": { "$ref": "common.schema.json#/$defs/nullableTokenUsage" },
        "messageCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Messages in the full round."
        },
        "commandCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Commands in the full round."
        }
      },
      "required": ["id", "index", "messageCount", "commandCount"],
      "additionalProperties": true
    }
  },
  "properties": {
    "schema": {
      "const": "tura.benchmark.task-report.v1",
      "description": "Contract discriminator."
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical run ID."
    },
    "category": {
      "type": "string",
      "enum": ["build", "design", "debug", "mcp", "rewrite"],
      "description": "Legacy/current collection category."
    },
    "report": {
      "type": "string",
      "description": "Collection/report directory ID."
    },
    "task": {
      "type": "string",
      "description": "Task ID field used by the compact rewrite report."
    },
    "agent": {
      "type": "string",
      "description": "Public agent ID field used by the compact rewrite report."
    },
    "taskId": { "type": "string", "minLength": 1, "description": "Task ID." },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "description": "Public agent ID."
    },
    "result": {
      "type": "object",
      "description": "Compact rewrite run status and harness score.",
      "properties": {
        "status": { "$ref": "common.schema.json#/$defs/runStatus" },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Harness percentage."
        },
        "harness": {
          "type": "object",
          "description": "Passed/total display totals.",
          "additionalProperties": true
        }
      },
      "required": ["status", "score", "harness"],
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "description": "Compact run metrics used by the original rewrite report.",
      "additionalProperties": true
    },
    "prompt": {
      "type": "object",
      "description": "Prompt path, format, and complete text in the compact rewrite report.",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "description": "Run boundaries and exact agent launch provenance.",
      "properties": {
        "startedAt": {
          "$ref": "common.schema.json#/$defs/timestamp",
          "description": "Run start timestamp."
        },
        "endedAt": {
          "$ref": "common.schema.json#/$defs/timestamp",
          "description": "Run end timestamp."
        },
        "agentVersion": {
          "type": "string",
          "description": "Actual CLI application version."
        },
        "agentCliCommand": {
          "type": "string",
          "description": "Complete agent launch command with secrets removed."
        }
      },
      "additionalProperties": true
    },
    "usage": {
      "allOf": [{ "$ref": "common.schema.json#/$defs/tokenUsage" }],
      "description": "Deduplicated run-total token accounting. Additional duration/round fields may accompany the token totals.",
      "properties": {
        "providerDurationMs": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of measured provider request durations."
        },
        "llmRoundCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of LLM request/response boundaries observed."
        }
      }
    },
    "harnessScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Run harness ratio in [0,1]. Integer passed/total values remain authoritative in harness-report.json."
    },
    "gitDiff": {
      "type": "string",
      "description": "Complete unified git diff. Large consumers may use gitDiffPath instead."
    },
    "gitDiffPath": {
      "type": "string",
      "description": "Relative path to git-diff.patch."
    },
    "harnessDirectory": {
      "type": ["string", "null"],
      "description": "Evaluator artifact directory."
    },
    "startRepoSnapshot": {
      "type": ["object", "null"],
      "description": "Repository state captured before the agent changed files.",
      "properties": {
        "repoRoot": {
          "type": "string",
          "description": "Workspace repository root at capture time."
        },
        "gitHead": { "type": "string", "description": "Starting commit SHA." },
        "gitStatusShort": {
          "type": "string",
          "description": "Starting git status --short output."
        },
        "capturedAt": {
          "$ref": "common.schema.json#/$defs/timestamp",
          "description": "Snapshot capture time."
        },
        "snapshotPath": {
          "type": "string",
          "description": "Relative archive/manifest path when a snapshot artifact exists."
        }
      },
      "additionalProperties": true
    },
    "cliMetadataPath": {
      "type": "string",
      "description": "Relative cli-metadata.json path."
    },
    "roundsDirectory": {
      "type": "string",
      "description": "Directory containing one JSON file per normalized round."
    },
    "rounds": {
      "type": "array",
      "description": "Complete ordered rounds or compact references for collections whose full rounds are stored in agent-rounds.jsonl.",
      "items": {
        "anyOf": [
          { "$ref": "agent-round.schema.json" },
          {
            "$ref": "https://tura.ai/schemas/benchmark/task-report.schema.json#/$defs/compactRound"
          }
        ]
      }
    },
    "sourceSummaryPath": {
      "type": ["string", "null"],
      "description": "Raw agent-summary.json path used to build this report."
    },
    "mcp": {
      "type": "object",
      "description": "Observed MCP initialization, schema discovery, and tool-call evidence.",
      "properties": {
        "server": { "type": "string", "minLength": 1 },
        "transport": { "const": "stdio" },
        "tracePath": { "type": "string", "minLength": 1 },
        "initialized": { "type": "boolean" },
        "schemaListed": { "type": "boolean" },
        "toolCallCount": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "server",
        "transport",
        "tracePath",
        "initialized",
        "schemaListed",
        "toolCallCount"
      ],
      "additionalProperties": true
    }
  },
  "required": ["schema", "runId", "rounds"],
  "anyOf": [
    {
      "required": [
        "taskId",
        "agentId",
        "metadata",
        "usage",
        "harnessScore",
        "gitDiffPath"
      ]
    },
    {
      "required": [
        "taskId",
        "agentId",
        "status",
        "createdAt",
        "prompt",
        "harness"
      ]
    },
    {
      "required": [
        "category",
        "report",
        "task",
        "agent",
        "result",
        "source",
        "prompt"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": { "category": { "const": "mcp" } },
        "required": ["category"]
      },
      "then": { "required": ["mcp"] }
    }
  ],
  "additionalProperties": true
}
