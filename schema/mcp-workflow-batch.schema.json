{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/mcp-workflow-batch.schema.json",
  "title": "MCP workflow benchmark batch",
  "description": "Published MCP workflow batch manifest with run outcomes, round-level token accounting, pricing, and raw provenance.",
  "type": "object",
  "$defs": {
    "score": {
      "type": "object",
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "label": { "type": "string" }
      },
      "required": ["passed", "failed", "total", "ratio", "label"],
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "properties": {
        "costUsd": { "type": "number", "minimum": 0 },
        "naiveUncachedCostUsd": { "type": "number", "minimum": 0 },
        "cacheSavingsUsd": { "type": "number", "minimum": 0 },
        "currency": { "const": "USD" },
        "source": { "type": "string", "format": "uri" },
        "model": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "minLength": 1 },
        "context": { "enum": ["short", "long", "mixed"] },
        "unit": { "const": "1M tokens" },
        "ratesPer1M": {
          "type": "object",
          "properties": {
            "input": { "type": "number", "minimum": 0 },
            "cachedInput": { "type": "number", "minimum": 0 },
            "cacheWrite": { "type": "number", "minimum": 0 },
            "output": { "type": "number", "minimum": 0 }
          },
          "required": ["input", "cachedInput", "cacheWrite", "output"],
          "additionalProperties": false
        },
        "billableTokens": {
          "type": "object",
          "properties": {
            "input": { "type": "integer", "minimum": 0 },
            "cachedInput": { "type": "integer", "minimum": 0 },
            "cacheWrite": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 },
            "reasoning": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          },
          "required": [
            "input",
            "cachedInput",
            "cacheWrite",
            "output",
            "reasoning",
            "total"
          ],
          "additionalProperties": false
        },
        "requestCount": { "type": "integer", "minimum": 0 },
        "longContextRequestCount": { "type": "integer", "minimum": 0 },
        "peakInputTokens": { "type": "integer", "minimum": 0 },
        "note": { "type": "string", "minLength": 1 }
      },
      "required": [
        "costUsd",
        "naiveUncachedCostUsd",
        "cacheSavingsUsd",
        "currency",
        "source",
        "model",
        "tier",
        "context",
        "unit",
        "ratesPer1M",
        "billableTokens",
        "requestCount",
        "longContextRequestCount",
        "peakInputTokens",
        "note"
      ],
      "additionalProperties": false
    },
    "aggregate": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "runCount": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "requestCount": { "type": "integer", "minimum": 0 },
        "usage": { "$ref": "common.schema.json#/$defs/tokenUsage" },
        "uncachedInputTokens": { "type": "integer", "minimum": 0 },
        "cacheWriteTokens": { "type": "integer", "minimum": 0 },
        "cacheHitRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "averageTotalTokensPerRun": { "type": "number", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 }
      },
      "required": [
        "id",
        "runCount",
        "passed",
        "failed",
        "passRate",
        "requestCount",
        "usage",
        "uncachedInputTokens",
        "cacheWriteTokens",
        "cacheHitRate",
        "averageTotalTokensPerRun",
        "costUsd"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 },
        "agentId": { "type": "string", "minLength": 1 },
        "replicate": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "common.schema.json#/$defs/runStatus" },
        "score": { "$ref": "#/$defs/score" },
        "usage": { "$ref": "common.schema.json#/$defs/tokenUsage" },
        "uncachedInputTokens": { "type": "integer", "minimum": 0 },
        "cacheWriteTokens": { "type": "integer", "minimum": 0 },
        "requestCount": { "type": "integer", "minimum": 0 },
        "longContextRequestCount": { "type": "integer", "minimum": 0 },
        "peakInputTokens": { "type": "integer", "minimum": 0 },
        "rounds": { "type": "integer", "minimum": 0 },
        "commands": { "type": "integer", "minimum": 0 },
        "mcpToolCalls": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "number", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 },
        "artifactPath": {
          "type": "string",
          "pattern": "^results/mcp/report-mcp-workflow-.+/runs/.+"
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "task": { "$ref": "#/$defs/publishedPath" },
            "workspace": { "$ref": "#/$defs/publishedPath" },
            "rounds": { "$ref": "#/$defs/publishedPath" },
            "agentRounds": { "$ref": "#/$defs/publishedPath" },
            "stdout": { "$ref": "#/$defs/publishedPath" },
            "providerCalls": { "$ref": "#/$defs/publishedPath" },
            "contracts": { "$ref": "#/$defs/publishedPath" },
            "mcpTrace": { "$ref": "#/$defs/publishedPath" },
            "mcpState": { "$ref": "#/$defs/publishedPath" },
            "harness": { "$ref": "#/$defs/publishedPath" },
            "gitDiff": { "$ref": "#/$defs/publishedPath" },
            "result": { "$ref": "#/$defs/publishedPath" }
          },
          "required": [
            "task",
            "workspace",
            "rounds",
            "agentRounds",
            "stdout",
            "providerCalls",
            "contracts",
            "mcpTrace",
            "mcpState",
            "harness",
            "gitDiff",
            "result"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "runId",
        "taskId",
        "agentId",
        "replicate",
        "status",
        "score",
        "usage",
        "uncachedInputTokens",
        "cacheWriteTokens",
        "requestCount",
        "longContextRequestCount",
        "peakInputTokens",
        "rounds",
        "commands",
        "mcpToolCalls",
        "durationMs",
        "costUsd",
        "artifactPath",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "publishedPath": {
      "type": "string",
      "pattern": "^results/mcp/report-mcp-workflow-.+"
    }
  },
  "properties": {
    "schema": { "const": "tura.benchmark.mcp-workflow-batch.v1" },
    "schemaVersion": { "const": "1.1.0" },
    "id": { "type": "string", "pattern": "^report-mcp-workflow-" },
    "category": { "const": "mcp" },
    "benchmark": { "const": "tura/mcp-workflow" },
    "model": { "type": "string", "minLength": 1 },
    "reasoning": { "type": "string", "minLength": 1 },
    "serviceTier": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "properties": {
        "rawRoot": { "type": "string", "pattern": "^raw/" },
        "publishedRoot": {
          "type": "string",
          "pattern": "^results/mcp/report-mcp-workflow-"
        },
        "batchSummaries": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^raw/" }
        },
        "cohorts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^raw/" }
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "rawRoot",
        "publishedRoot",
        "batchSummaries",
        "cohorts",
        "startedAt",
        "completedAt"
      ],
      "additionalProperties": false
    },
    "taskCount": { "type": "integer", "minimum": 1 },
    "replicateCount": { "type": "integer", "minimum": 1 },
    "runCount": { "type": "integer", "minimum": 1 },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "outcome": {
      "type": "object",
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["completed", "passed", "failed", "passRate"],
      "additionalProperties": false
    },
    "usage": { "$ref": "common.schema.json#/$defs/tokenUsage" },
    "uncachedInputTokens": { "type": "integer", "minimum": 0 },
    "cacheWriteTokens": { "type": "integer", "minimum": 0 },
    "cacheHitRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "pricing": { "$ref": "#/$defs/pricing" },
    "agentSummaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/aggregate" }
    },
    "taskSummaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/aggregate" }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runId": { "type": "string", "minLength": 1 },
          "taskId": { "type": "string", "minLength": 1 },
          "agentId": { "type": "string", "minLength": 1 },
          "replicate": { "type": "integer", "minimum": 1 },
          "score": { "$ref": "#/$defs/score" },
          "failureClass": { "type": "string", "minLength": 1 },
          "failedChecks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 }
              },
              "required": ["id", "message"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "runId",
          "taskId",
          "agentId",
          "replicate",
          "score",
          "failureClass",
          "failedChecks"
        ],
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "required": [
    "schema",
    "schemaVersion",
    "id",
    "category",
    "benchmark",
    "model",
    "reasoning",
    "serviceTier",
    "generatedAt",
    "source",
    "taskCount",
    "replicateCount",
    "runCount",
    "agents",
    "outcome",
    "usage",
    "uncachedInputTokens",
    "cacheWriteTokens",
    "cacheHitRate",
    "pricing",
    "agentSummaries",
    "taskSummaries",
    "failures",
    "runs",
    "notes"
  ],
  "additionalProperties": false
}
