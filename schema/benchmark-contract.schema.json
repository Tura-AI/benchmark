{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tura-AI/tura-benchmark/schema/benchmark-contract.schema.json",
  "title": "Tura Benchmark Contract",
  "oneOf": [
    { "$ref": "#/$defs/run" },
    { "$ref": "#/$defs/round" },
    { "$ref": "#/$defs/taskReport" },
    { "$ref": "#/$defs/manifest" }
  ],
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "cacheInputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "peakContext": { "type": "integer", "minimum": 0 }
      },
      "required": ["inputTokens", "cacheInputTokens", "outputTokens", "totalTokens"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "steps": { "type": "integer", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 },
        "cost": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "currency": { "type": "string" },
            "pricingSource": { "type": "string" },
            "pricingSourceUrl": { "type": "string" },
            "model": { "type": "string" },
            "usageSource": { "type": "string" },
            "ratesUsdPerMillionTokens": {
              "type": "object",
              "additionalProperties": { "type": "number" }
            },
            "billableInputTokens": { "type": "integer", "minimum": 0 },
            "cachedInputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "inputCostUsd": { "type": "number", "minimum": 0 },
            "cachedInputCostUsd": { "type": "number", "minimum": 0 },
            "outputCostUsd": { "type": "number", "minimum": 0 },
            "totalCostUsd": { "type": "number", "minimum": 0 }
          }
        },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "cacheInputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "reasoningTokens": { "type": "integer", "minimum": 0 },
        "cacheWriteTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "peakContext": { "type": "integer", "minimum": 0 },
        "commands": { "type": "integer", "minimum": 0 }
      },
      "required": ["model", "steps", "costUsd", "inputTokens", "cacheInputTokens", "outputTokens", "totalTokens", "peakContext", "commands"]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "enum": ["assistant", "system", "tool"] },
        "format": { "const": "markdown" },
        "text": { "type": "string" }
      },
      "required": ["role", "format", "text"]
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^batch-[0-9]{4}$" },
        "sourceRoundIds": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "certainty": {
          "enum": [
            "collector-same-round",
            "merged-command-only-zero-usage-after-agent-message"
          ]
        }
      },
      "required": ["id", "sourceRoundIds", "certainty"]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^command-[0-9]{4}$" },
        "toolName": { "type": "string" },
        "type": { "type": "string" },
        "isCommandRun": { "type": "boolean" },
        "step": { "type": "integer", "minimum": 1 },
        "commandRunStep": { "type": ["integer", "null"], "minimum": 1 },
        "commandIndex": { "type": ["integer", "null"], "minimum": 0 },
        "providerToolCallId": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "commandLine": { "type": "string" },
        "preview": { "type": "string" },
        "exitCode": { "type": ["integer", "null"] },
        "receipt": { "type": "string" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" }
      },
      "required": ["id", "toolName", "type", "isCommandRun", "step", "commandRunStep", "commandIndex", "providerToolCallId", "status", "commandLine", "preview", "exitCode", "receipt", "stdout", "stderr"]
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "tura.benchmark.round.v1" },
        "id": { "type": "string", "pattern": "^round-[0-9]{4}$" },
        "index": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "intent": { "type": "string" },
        "batch": { "$ref": "#/$defs/batch" },
        "usage": { "$ref": "#/$defs/usage" },
        "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } }
      },
      "required": ["schema", "id", "index", "title", "intent", "batch", "usage", "messages", "commands"]
    },
    "run": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schema": { "const": "tura.benchmark.run.v1" },
        "id": { "type": "string", "pattern": "^[a-z0-9-]+__[a-z0-9.-]+__rank-[0-9]{2}__score-[0-9]+-of-[0-9]+__run-[0-9]{2}$" },
        "category": { "type": "string" },
        "report": { "type": "string" },
        "task": { "type": "string" },
        "agent": { "type": "string" },
        "rank": { "type": "integer", "minimum": 1 },
        "sessionName": { "type": "string" },
        "title": { "type": "string" },
        "prompt": {
          "type": "object",
          "description": "The task-starting user prompt. It is stored once per run and rendered as user information by consumers.",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "const": "raw-first-round-prompt.txt",
              "description": "Path relative to the run directory."
            },
            "format": { "const": "markdown" },
            "text": { "type": "string" }
          },
          "required": ["path", "format", "text"]
        },
        "source": { "$ref": "#/$defs/source" },
        "result": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "status": { "enum": ["pass", "fail", "unknown"] },
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "harness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "passed": { "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 0 },
                "label": { "type": "string" }
              },
              "required": ["passed", "total", "label"]
            }
          },
          "required": ["status", "score", "harness"]
        },
        "rounds": { "type": "array", "items": { "$ref": "#/$defs/round" } }
      },
      "required": ["schema", "id", "category", "report", "task", "agent", "rank", "sessionName", "title", "prompt", "source", "result", "rounds"],
      "allOf": [
        {
          "if": {
            "properties": {
              "agent": { "pattern": "^tura-" }
            },
            "required": ["agent"]
          },
          "then": {
            "properties": {
              "rounds": {
                "type": "array",
                "items": {
                  "properties": {
                    "commands": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "isCommandRun": { "const": true }
                              },
                              "required": ["isCommandRun"]
                            },
                            "then": {
                              "properties": {
                                "commandRunStep": { "type": "integer", "minimum": 1 }
                              },
                              "required": ["commandRunStep"]
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "taskReport": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schema": { "const": "tura.benchmark.task-report.v1" },
        "runId": { "type": "string" },
        "category": { "type": "string" },
        "report": { "type": "string" },
        "task": { "type": "string" },
        "agent": { "type": "string" },
        "result": { "type": "object" },
        "source": { "type": "object" },
        "prompt": { "type": "object" },
        "rounds": { "type": "array" }
      },
      "required": ["schema", "runId", "category", "report", "task", "agent", "result", "source", "prompt", "rounds"]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schema": { "const": "tura.benchmark.contract-manifest.v1" },
        "runId": { "type": "string" },
        "files": { "type": "object" },
        "naming": { "type": "object" }
      },
      "required": ["schema", "runId", "files", "naming"]
    }
  }
}
