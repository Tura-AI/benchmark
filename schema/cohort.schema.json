{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/cohort.schema.json",
  "title": "Frozen benchmark cohort contract",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.cohort.v1" },
    "selection_plan_revision": { "type": "string", "minLength": 1 },
    "frozen_at": { "type": "string", "format": "date-time" },
    "pilot": { "type": "boolean" },
    "eligible_task_pool": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "selected_tasks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["task", "reason"],
        "additionalProperties": false
      }
    },
    "paired_unit": { "type": ["string", "null"] },
    "task_count": { "type": "integer", "minimum": 1 },
    "replicate_count": { "type": "integer", "minimum": 1 },
    "primary_endpoint": { "type": ["string", "null"] },
    "variance_estimate": { "type": "number", "exclusiveMinimum": 0 },
    "variance_estimates": {
      "type": "object",
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    },
    "alpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
    "target_power": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "minimum_detectable_effect": { "type": "number", "exclusiveMinimum": 0 },
    "power_calculation": {
      "type": "object",
      "properties": {
        "revision": { "const": "paired-normal-v1" },
        "command": { "const": "node scripts/cohort.mjs power" },
        "inputs": { "type": "object" }
      },
      "required": ["revision", "command", "inputs"]
    }
  },
  "required": [
    "schema",
    "selection_plan_revision",
    "frozen_at",
    "pilot",
    "eligible_task_pool",
    "selected_tasks",
    "exclusions",
    "paired_unit",
    "task_count",
    "replicate_count",
    "primary_endpoint"
  ],
  "allOf": [
    {
      "if": { "properties": { "pilot": { "const": false } } },
      "then": {
        "required": [
          "variance_estimate",
          "alpha",
          "target_power",
          "minimum_detectable_effect",
          "power_calculation"
        ]
      }
    }
  ],
  "additionalProperties": false
}
