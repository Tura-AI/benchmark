{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/repository-task.schema.json",
  "title": "Repository-level benchmark task",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.repository-task.v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "repository": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "path": { "type": "string" },
        "base_revision": { "type": "string", "minLength": 1 }
      },
      "required": ["base_revision"],
      "anyOf": [{ "required": ["url"] }, { "required": ["path"] }],
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "properties": {
        "setup": { "$ref": "#/$defs/command" },
        "baseline": { "$ref": "#/$defs/command" },
        "treatment": { "$ref": "#/$defs/command" }
      },
      "required": ["setup", "baseline", "treatment"],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      },
      "required": ["provider", "id"]
    },
    "output": { "type": "object" },
    "environment": {
      "type": "object",
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "values": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "validation": {
      "type": "object",
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "adapter": { "type": "string" },
        "expected": { "type": "object" }
      },
      "anyOf": [{ "required": ["command"] }, { "required": ["adapter"] }]
    },
    "artifact_paths": { "type": "array", "items": { "type": "string" } },
    "timeout_ms": { "type": "integer", "minimum": 1 },
    "cleanup_policy": { "enum": ["preserve", "quarantine", "remove"] },
    "preset": { "type": "string" }
  },
  "required": [
    "schema",
    "id",
    "repository",
    "commands",
    "model",
    "output",
    "environment",
    "acceptance_criteria",
    "validation",
    "artifact_paths",
    "timeout_ms",
    "cleanup_policy"
  ],
  "additionalProperties": false,
  "$defs": {
    "command": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  }
}
