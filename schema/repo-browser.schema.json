{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/repo-browser.schema.json",
  "title": "Interactive repository browser payload",
  "description": "Per-run public/benchmark-data/repos/{runId}.json used by the GitHub-style Repo tab.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "tura.website.repo-browser.v1",
      "description": "Repo browser discriminator."
    },
    "runId": {
      "type": "string",
      "description": "Run whose workspace is represented."
    },
    "root": {
      "type": "string",
      "description": "Workspace root label/path relative to the benchmark run."
    },
    "sourceMode": {
      "type": "string",
      "enum": ["local", "github"],
      "description": "Whether CI read files locally or through GitHub APIs."
    },
    "externalUrl": {
      "type": "string",
      "description": "Real GitHub workspace URL used for files not embedded in the payload."
    },
    "entries": {
      "type": "array",
      "description": "Flat directory tree used for interactive navigation.",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Workspace-relative path."
          },
          "name": {
            "type": "string",
            "description": "Final path segment shown in the file tree."
          },
          "type": {
            "type": "string",
            "enum": ["file", "dir"],
            "description": "Entry kind."
          },
          "language": {
            "type": "string",
            "description": "Detected syntax language for file entries."
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "description": "File size in bytes; omitted for directories."
          }
        },
        "required": ["path", "name", "type"],
        "additionalProperties": true
      }
    },
    "files": {
      "type": "object",
      "description": "Previewable text files keyed by workspace-relative path. Large/binary files remain available through externalUrl.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Workspace-relative file path."
          },
          "language": {
            "type": "string",
            "description": "Syntax highlighting language."
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "description": "Original file size in bytes."
          },
          "text": { "type": "string", "description": "UTF-8 preview text." },
          "truncated": {
            "type": "boolean",
            "description": "True when text was cut at maxFilePreviewBytes."
          }
        },
        "required": ["path", "language", "size", "text", "truncated"],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "description": "Deterministic payload limits used by CI.",
      "properties": {
        "maxEntries": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum tree entries."
        },
        "maxContentFiles": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum files with embedded text."
        },
        "maxFilePreviewBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum preview bytes per file."
        },
        "omittedEntries": {
          "type": "integer",
          "minimum": 0,
          "description": "Entries omitted after applying limits."
        }
      },
      "required": [
        "maxEntries",
        "maxContentFiles",
        "maxFilePreviewBytes",
        "omittedEntries"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "runId",
    "root",
    "sourceMode",
    "externalUrl",
    "entries",
    "files",
    "limits"
  ],
  "additionalProperties": false
}
