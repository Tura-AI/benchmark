{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/deepswe-tura-pair-audit.schema.json",
  "title": "Tura DeepSWE balanced/direct High normalization audit",
  "description": "Cardinality, shared-container scheduling, Harness outcome, recovered LLM-turn, and contract-validation receipt for the completed 20-task balanced/direct High matrix.",
  "type": "object",
  "required": [
    "schema",
    "source",
    "taskCount",
    "agentCount",
    "replicateCount",
    "runCount",
    "taskBatchSize",
    "dockerConcurrency",
    "agentConcurrency",
    "sharedTaskContainers",
    "harnessPassed",
    "harnessFailed",
    "harnessPassRate",
    "llmRounds",
    "messages",
    "inputMessages",
    "outputMessages",
    "commands",
    "toolCalls",
    "usage",
    "costUsd",
    "agents",
    "allRoundContractFieldsPresent",
    "report",
    "schemaValidated",
    "generatedAt"
  ],
  "properties": {
    "schema": {
      "const": "tura.benchmark.deepswe-tura-pair-normalization-audit.v1"
    },
    "source": { "type": "string", "minLength": 1 },
    "taskCount": { "const": 20 },
    "agentCount": { "const": 2 },
    "replicateCount": { "const": 1 },
    "runCount": { "const": 40 },
    "taskBatchSize": { "const": 5 },
    "dockerConcurrency": { "const": 5 },
    "agentConcurrency": { "const": 10 },
    "sharedTaskContainers": { "const": true },
    "harnessPassed": { "type": "integer", "minimum": 0, "maximum": 40 },
    "harnessFailed": { "type": "integer", "minimum": 0, "maximum": 40 },
    "harnessPassRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "llmRounds": { "type": "integer", "minimum": 1 },
    "messages": { "type": "integer", "minimum": 0 },
    "inputMessages": { "type": "integer", "minimum": 0 },
    "outputMessages": { "type": "integer", "minimum": 0 },
    "commands": { "type": "integer", "minimum": 0 },
    "toolCalls": { "type": "integer", "minimum": 0 },
    "usage": { "$ref": "#/$defs/usage" },
    "costUsd": { "type": "number", "minimum": 0 },
    "agents": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/agentSummary" }
    },
    "allRoundContractFieldsPresent": { "const": true },
    "report": {
      "const": "report-deepswe-v1.1-gpt56-sol-tura-pair-high-r01"
    },
    "schemaValidated": { "const": true },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "required": [
        "inputTokens",
        "cacheInputTokens",
        "outputTokens",
        "reasoningTokens",
        "totalTokens"
      ],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "cacheInputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "reasoningTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "agentSummary": {
      "type": "object",
      "required": [
        "agent",
        "runs",
        "harnessPassed",
        "harnessFailed",
        "llmRounds",
        "messages",
        "inputMessages",
        "outputMessages",
        "commands",
        "toolCalls",
        "usage",
        "costUsd"
      ],
      "properties": {
        "agent": { "enum": ["balanced", "direct"] },
        "runs": { "const": 20 },
        "harnessPassed": { "type": "integer", "minimum": 0, "maximum": 20 },
        "harnessFailed": { "type": "integer", "minimum": 0, "maximum": 20 },
        "llmRounds": { "type": "integer", "minimum": 1 },
        "messages": { "type": "integer", "minimum": 0 },
        "inputMessages": { "type": "integer", "minimum": 0 },
        "outputMessages": { "type": "integer", "minimum": 0 },
        "commands": { "type": "integer", "minimum": 0 },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "usage": { "$ref": "#/$defs/usage" },
        "costUsd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
