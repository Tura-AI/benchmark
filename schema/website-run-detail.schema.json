{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/website-run-detail.schema.json",
  "title": "Benchmark website run detail",
  "description": "Per-run public/benchmark-data/runs/{runId}.json loaded on demand by the run page.",
  "type": "object",
  "properties": {
    "schema": {
      "enum": [
        "tura.website.benchmark.run-detail.v1",
        "tura.website.benchmark.design-run-detail.v1"
      ],
      "description": "Website run-detail discriminator."
    },
    "id": { "type": "string", "description": "Canonical run ID." },
    "taskId": { "type": "string", "description": "Task ID." },
    "agentId": { "type": "string", "description": "Public agent ID." },
    "prompt": { "type": "string", "description": "Complete task prompt." },
    "promptInfo": {
      "type": "object",
      "description": "Parsed repository/language/commit fields used by task and repo links.",
      "additionalProperties": { "type": "string" }
    },
    "repoBrowserPath": {
      "type": "string",
      "description": "Public repo browser JSON path."
    },
    "webRun": {
      "anyOf": [
        { "$ref": "benchmark-web-run.schema.json" },
        { "$ref": "design-run.schema.json" },
        { "type": "null" }
      ],
      "description": "Normalized source run with timing fields sanitized for public output."
    },
    "harness": {
      "type": "array",
      "description": "Run-level harness rows rendered by the Harness tab.",
      "items": { "type": "object", "additionalProperties": true }
    },
    "repoDiff": {
      "type": "array",
      "description": "Parsed unified diff retained for evidence views.",
      "items": { "type": "object", "additionalProperties": true }
    },
    "metadata": {
      "type": "object",
      "description": "Grouped common, agent, system, environment, custom, pricing, and source-file metadata.",
      "additionalProperties": true
    },
    "summary": {
      "$ref": "website-index.schema.json#/$defs/runSummary",
      "description": "Same lightweight run summary embedded for direct-page loading."
    }
  },
  "required": [
    "schema",
    "id",
    "taskId",
    "agentId",
    "prompt",
    "repoBrowserPath",
    "metadata",
    "summary"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": { "const": "tura.website.benchmark.run-detail.v1" }
        }
      },
      "then": { "required": ["harness"] },
      "else": { "not": { "required": ["harness"] } }
    }
  ],
  "additionalProperties": true
}
