{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/deepswe-local-batch.schema.json",
  "title": "Tura DeepSWE local batch manifest",
  "description": "One normalized replicate from a completed local DeepSWE matrix. The manifest indexes real local agent runs and does not represent official DeepSWE leaderboard trials.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "category",
    "benchmark",
    "benchmarkVersion",
    "model",
    "replicate",
    "taskCount",
    "runCount",
    "agents",
    "source",
    "runs"
  ],
  "properties": {
    "schema": { "const": "tura.benchmark.deepswe-local-batch.v1" },
    "id": {
      "type": "string",
      "pattern": "^report-deepswe-v1\\.1-gpt56-sol-(local|codex-cli-high|tura-pair-high|mini-pair-high)-r[0-9]{2}$"
    },
    "category": { "const": "debug" },
    "benchmark": { "const": "datacurve-ai/deep-swe" },
    "benchmarkVersion": { "const": "v1.1" },
    "model": { "const": "gpt-5.6-sol" },
    "replicate": { "type": "integer", "minimum": 1 },
    "taskCount": { "type": "integer", "minimum": 1 },
    "runCount": { "type": "integer", "minimum": 1 },
    "agents": {
      "type": "array",
      "description": "Public configuration IDs. Agent identity, model, and effort are encoded once and may not use internal names.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+-gpt5\\.6-sol-(high|medium)$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "description": "Path to the immutable raw batch manifest used as the run index.",
      "required": ["manifest"],
      "properties": { "manifest": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    },
    "runs": {
      "type": "array",
      "description": "Every normalized run in this replicate. runId and path must resolve to the same canonical directory.",
      "items": {
        "type": "object",
        "required": [
          "runId",
          "taskId",
          "agentId",
          "agent",
          "effort",
          "replicate",
          "status",
          "rounds",
          "commands",
          "path"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+-[a-z0-9-]+-run-[0-9]{2}$"
          },
          "taskId": { "type": "string", "minLength": 1 },
          "agentId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+-gpt5\\.6-sol-(high|medium)$"
          },
          "agent": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "effort": { "enum": ["high", "medium"] },
          "replicate": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["pass", "fail"] },
          "rounds": { "type": "integer", "minimum": 0 },
          "commands": { "type": "integer", "minimum": 0 },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
