{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/deepswe-official-subset.schema.json",
  "title": "Official DeepSWE subset batch manifest",
  "description": "One deterministic task subset and replicate imported from the official DeepSWE v1.1 trial publication.",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.deepswe-official-subset.v1" },
    "id": { "type": "string", "minLength": 1 },
    "category": { "const": "debug" },
    "benchmark": { "const": "datacurve-ai/deep-swe" },
    "benchmarkVersion": { "const": "v1.1" },
    "model": { "const": "gpt-5.6-sol" },
    "effort": { "enum": ["high", "medium"] },
    "agent": { "const": "mini-swe-agent" },
    "agentVersion": { "type": ["string", "null"] },
    "replicate": { "type": "integer", "minimum": 1, "maximum": 4 },
    "selection": {
      "type": "object",
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "taskIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["method", "taskIds"],
      "additionalProperties": false
    },
    "taskCount": { "type": "integer", "minimum": 1, "maximum": 20 },
    "runCount": { "type": "integer", "minimum": 1, "maximum": 20 },
    "source": {
      "type": "object",
      "required": ["selection", "trials", "release", "agent", "trialsSha256"],
      "additionalProperties": { "type": ["string", "null"] }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "runId": { "type": "string", "minLength": 1 },
          "taskId": { "type": "string", "minLength": 1 },
          "agentId": { "type": "string", "minLength": 1 },
          "effort": { "enum": ["high", "medium"] },
          "replicate": { "type": "integer", "minimum": 1, "maximum": 4 },
          "trialName": { "type": "string", "minLength": 1 },
          "status": { "$ref": "common.schema.json#/$defs/runStatus" },
          "path": { "type": "string", "minLength": 1 }
        },
        "required": [
          "runId",
          "taskId",
          "agentId",
          "effort",
          "replicate",
          "trialName",
          "status",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "category",
    "benchmark",
    "benchmarkVersion",
    "model",
    "effort",
    "agent",
    "agentVersion",
    "replicate",
    "selection",
    "taskCount",
    "runCount",
    "source",
    "runs"
  ],
  "additionalProperties": false
}
