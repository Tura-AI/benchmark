{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/deepswe-import-audit.schema.json",
  "title": "Official DeepSWE import audit",
  "description": "Completeness and artifact-availability audit for the 20-task, two-effort, four-replicate DeepSWE import.",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.deepswe-official-import-audit.v1" },
    "benchmark": { "const": "datacurve-ai/deep-swe" },
    "benchmarkVersion": { "const": "v1.1" },
    "model": { "const": "gpt-5.6-sol" },
    "efforts": { "const": ["high", "medium"] },
    "replicates": { "const": 4 },
    "taskCount": { "const": 20 },
    "runCount": { "const": 160 },
    "reportCount": { "const": 8 },
    "detailedArtifactAvailable": {
      "type": "integer",
      "minimum": 0,
      "maximum": 160
    },
    "detailedArtifactUnavailable": {
      "type": "integer",
      "minimum": 0,
      "maximum": 160
    },
    "reports": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "report": { "type": "string", "minLength": 1 },
          "runs": { "const": 20 }
        },
        "required": ["report", "runs"],
        "additionalProperties": false
      }
    },
    "note": { "type": "string" }
  },
  "required": [
    "schema",
    "benchmark",
    "benchmarkVersion",
    "model",
    "efforts",
    "replicates",
    "taskCount",
    "runCount",
    "reportCount",
    "detailedArtifactAvailable",
    "detailedArtifactUnavailable",
    "reports"
  ],
  "additionalProperties": false
}
