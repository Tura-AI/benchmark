{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/deepswe-codex-high-audit.schema.json",
  "title": "Tura DeepSWE Codex CLI High normalization audit",
  "description": "Cardinality, batching, schema-validation, and provenance receipt for the completed 20-task x 3-replicate Codex CLI High matrix.",
  "type": "object",
  "required": [
    "schema",
    "source",
    "taskCount",
    "agentCount",
    "replicateCount",
    "runCount",
    "taskBatchSize",
    "workerConcurrency",
    "reports",
    "schemaValidated",
    "generatedAt"
  ],
  "properties": {
    "schema": {
      "const": "tura.benchmark.deepswe-codex-high-normalization-audit.v1"
    },
    "source": { "type": "string", "minLength": 1 },
    "taskCount": { "const": 20 },
    "agentCount": { "const": 1 },
    "replicateCount": { "const": 3 },
    "runCount": { "const": 60 },
    "taskBatchSize": { "const": 5 },
    "workerConcurrency": { "const": 15 },
    "reports": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["report", "runs"],
        "properties": {
          "report": {
            "type": "string",
            "pattern": "^report-deepswe-v1\\.1-gpt56-sol-codex-cli-high-r[0-9]{2}$"
          },
          "runs": { "const": 20 }
        },
        "additionalProperties": false
      }
    },
    "schemaValidated": { "const": true },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
