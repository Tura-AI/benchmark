{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/design-task.schema.json",
  "title": "Design benchmark task",
  "description": "Canonical task-level contract stored once at results/design/{task}/design-task.json. Design tasks publish interactive HTML artifacts and never define harness rules or harness reports.",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.design-task.v1", "description": "Design task contract discriminator." },
    "id": { "type": "string", "minLength": 1, "description": "Stable task ID and directory name." },
    "category": { "const": "design", "description": "Design tasks always belong to the Design benchmark tab." },
    "title": { "type": "string", "minLength": 1, "description": "Human-readable task title." },
    "description": { "type": "string", "minLength": 1, "description": "Concrete requested design outcome." },
    "promptLocation": { "type": "string", "minLength": 1, "description": "Path template for each run's complete starting prompt." },
    "evaluation": {
      "type": "object",
      "properties": { "mode": { "const": "design" } },
      "required": ["mode"],
      "additionalProperties": false
    },
    "source": { "type": "object", "description": "Starting artifact/workspace information.", "additionalProperties": true },
    "target": { "type": "object", "description": "Required observable design deliverable.", "additionalProperties": true },
    "presentation": {
      "type": "object",
      "properties": {
        "kind": { "const": "interactive-html", "description": "Website renders each result as interactive HTML." },
        "htmlEntry": { "const": "index.html", "description": "Fixed workspace-relative HTML entry point." },
        "navigation": { "enum": ["embedded", "standalone"], "description": "Default website presentation mode." }
      },
      "required": ["kind", "htmlEntry", "navigation"],
      "additionalProperties": false
    },
    "contracts": {
      "type": "object",
      "properties": {
        "run": { "const": "tura.benchmark.design-run.v1" },
        "round": { "const": "tura.benchmark.agent-round.v1" },
        "repoBrowser": { "const": "tura.website.repo-browser.v1" }
      },
      "required": ["run", "round", "repoBrowser"],
      "additionalProperties": false
    }
  },
  "required": ["schema", "id", "category", "title", "description", "promptLocation", "evaluation", "source", "target", "presentation", "contracts"],
  "not": { "anyOf": [{ "required": ["harness"] }, { "required": ["harnessRules"] }, { "required": ["harnessReport"] }] },
  "additionalProperties": false
}
