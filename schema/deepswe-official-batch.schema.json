{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tura.ai/schemas/benchmark/deepswe-official-batch.schema.json",
  "title": "Official DeepSWE batch manifest",
  "description": "One complete 20-task replicate imported from the official DeepSWE v1.1 trial publication. A GPT-5.6 SOL high/medium matrix contains four manifests per effort.",
  "type": "object",
  "properties": {
    "schema": { "const": "tura.benchmark.deepswe-official-batch.v1" },
    "id": { "type": "string", "minLength": 1, "description": "Report directory ID." },
    "category": { "const": "debug" },
    "benchmark": { "const": "datacurve-ai/deep-swe" },
    "benchmarkVersion": { "const": "v1.1" },
    "model": { "const": "gpt-5.6-sol" },
    "effort": { "enum": ["high", "medium"] },
    "agent": { "const": "mini-swe-agent" },
    "agentVersion": { "type": "string", "minLength": 1 },
    "replicate": { "type": "integer", "minimum": 1, "maximum": 4 },
    "taskCount": { "const": 20 },
    "runCount": { "const": 20 },
    "source": {
      "type": "object",
      "description": "Official publication and local selection provenance.",
      "required": ["selection", "trials", "release", "agent", "agentVersion"],
      "additionalProperties": { "type": "string" }
    },
    "runs": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "runId": { "type": "string", "minLength": 1 },
          "taskId": { "type": "string", "minLength": 1 },
          "agentId": { "type": "string", "minLength": 1 },
          "effort": { "enum": ["high", "medium"] },
          "replicate": { "type": "integer", "minimum": 1, "maximum": 4 },
          "trialName": { "type": "string", "minLength": 1, "description": "Immutable official DeepSWE trial_name." },
          "status": { "$ref": "common.schema.json#/$defs/runStatus" },
          "path": { "type": "string", "minLength": 1 }
        },
        "required": ["runId", "taskId", "agentId", "effort", "replicate", "trialName", "status", "path"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "id", "category", "benchmark", "benchmarkVersion", "model", "effort", "agent", "agentVersion", "replicate", "taskCount", "runCount", "source", "runs"],
  "additionalProperties": false
}
