{
  "name": "@tura-ai/benchmark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portable benchmark definitions, runners, contracts, and published verification artifacts.",
  "license": "MIT",
  "maintainers": [
    {
      "name": "Yohji Sakamoto",
      "email": "yohji.sakamoto@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tura-AI/benchmark.git"
  },
  "homepage": "https://github.com/Tura-AI/benchmark#readme",
  "bugs": {
    "url": "https://github.com/Tura-AI/benchmark/issues"
  },
  "bin": {
    "tura-benchmark": "scripts/benchmark.mjs"
  },
  "scripts": {
    "build": "tsc",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:benchmark": "node scripts/doctor.mjs --benchmark",
    "benchmark:deep-swe": "node scripts/run_debug_matrix.mjs --agents balanced",
    "benchmark:deep-swe:run": "node scripts/run_debug_matrix.mjs --run --agents balanced",
    "import:deep-swe:official": "node scripts/import_deepswe_official.mjs --task-count 20",
    "recover:debug-workspaces": "node scripts/recover_debug_workspaces.mjs",
    "check:debug-workspaces": "node scripts/recover_debug_workspaces.mjs --check",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run schema:check && npm run links:check && npm run deadcode",
    "deadcode": "knip --no-progress",
    "links:check": "node scripts/audit_benchmark_links.mjs",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "schema:check": "node scripts/python.mjs schema/validate.py --benchmark-data .",
    "test": "npm run build && node --test tests/*.test.mjs dist/tests/*.test.js",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "knip": "6.26.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3"
  }
}
