 #!/usr/bin/env sh
 set -eu
-[ -f executable ]
+
+rm -f executable executable.exe executable.cmd executable.bat executable.js executable.py executable.jar
+
+case "${OS:-}:$(uname -s 2>/dev/null || true)" in
+  Windows_NT:*|*:MINGW*|*:MSYS*|*:CYGWIN*)
+    printf '%s\r\n' '@echo off' 'python "%~dp0eza_port.py" %*' 'exit /b %errorlevel%' > executable.cmd
+    ;;
+  *)
+    cp eza_port.py executable
+    chmod +x executable
+    ;;
+esac
